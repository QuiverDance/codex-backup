m_t>(\\n        static_cast<uintptr_t>(stream_handle));\\n    py::gil_scoped_release no_gil;\\n#ifdef CD3_HAS_CUDA_MEMCPY_BATCH_ASYNC\\n    cudaMemcpyAttributes attributes = {};\\n    attributes.srcAccessOrder = cudaMemcpySrcAccessOrderStream;\\n    std::vector<size_t> attribute_indices(copy_count, 0);\\n#if CUDART_VERSION >= 13000\\n    auto error = cudaMemcpyBatchAsync(\\n        destinations.data(), sources.data(), sizes.data(), copy_count,\\n        &attributes, attribute_indices.data(), 1, stream);\\n#else\\n    size_t fail_index = SIZE_MAX;\\n    auto error = cudaMemcpyBatchAsync(\\n        destinations.data(), sources.data(), sizes.data(), copy_count,\\n        &attributes, attribute_indices.data(), 1, &fail_index, stream);\\n#endif\\n    check_cuda_error(error, \\\"cudaMemcpyBatchAsync(CD3 KV decode prep)\\\");\\n#else\\n    for (size_t index = 0; index < copy_count; ++index) {\\n        check_cuda_error(\\n            cudaMemcpyAsync(\\n                destinations[index], sources[index], sizes[index],\\n                cudaMemcpyHostToDevice, stream),\\n            \\\"cudaMemcpyAsync(CD3 KV decode prep)\\\");\\n    }\\n#endif\\n}\\n\\nvoid decompress_chunk_delta3_batched_csr_pair_stream(\\n    torch::Tensor k_body,\\n    torch::Tensor v_body,\\n    torch::Tensor k_entries20x3,\\n    torch::Tensor v_entries20x3,\\n    torch::Tensor k_entry_word_offsets,\\n    torch::Tensor v_entry_word_offsets,\\n    torch::Tensor slots,\\n    torch::Tensor output_blocks,\\n    torch::Tensor k_output,\\n    torch::Tensor v_output,\\n    int64_t stream_handle)\\n{\\n    TORCH_CHECK(stream_handle != 0, \\\"CUDA stream handle must be nonzero\\\");\\n    TORCH_CHECK(k_output.is_cuda() && k_output.is_contiguous()\\n                    && k_output.dim() == 3\\n                    && k_output.scalar_type() == at::kBFloat16,\\n                \\\"K output must be a contiguous 3-D CUDA BF16 tensor\\\");\\n    TORCH_CHECK(v_output.is_cuda() && v_output.is_contiguous()\\n                    && v_output.sizes() == k_output.sizes()\\n                    && v_output.scalar_type() == at::kBFloat16,\\n                \\\"V output must match K output\\\");\\n\\n    const int64_t num_output_blocks = slots.numel();\\n    const int64_t rows = k_output.size(1);\\n    const int64_t columns = k_output.size(2);\\n    TORCH_CHECK(num_output_blocks > 0 && rows > 0 && columns > 0\\n                    && rows % kTileDim == 0 && columns % kTileDim == 0,\\n                \\\"CSR ChunkDelta3 dimensions must be positive multiples of 64\\\");\\n    const int64_t tiles_per_block =\\n        (rows / kTileDim) * (columns / kTileDim);\\n    const int64_t block_elements = rows * columns;\\n    const int64_t code_bytes = tiles_per_block * kCodeBytesPerTile;\\n    const int64_t base_bytes = tiles_per_block * kBasesPerTile;\\n\\n    TORCH_CHECK(k_body.is_cuda() && k_body.is_contiguous()\\n                    && k_body.scalar_type() == at::kByte\\n                    && k_body.dim() == 2 && k_body.size(0) > 0,\\n                \\\"invalid ChunkDelta3 K CSR body\\\");\\n    TORCH_CHECK(v_body.is_cuda() && v_body.is_contiguous()\\n                    && v_body.scalar_type() == at::kByte\\n                    && v_body.sizes() == k_body.sizes(),\\n                \\\"invalid ChunkDelta3 V CSR body\\\");\\n    const int64_t body_stride = k_body.size(1);\\n    TORCH_CHECK(body_stride % 8 == 0,\\n                \\\"ChunkDelta3 CSR body stride must be 8-byte aligned\\\");\\n\\n    auto check_entries = [](const torch::Tensor& entries, const char* name) {\\n        TORCH_CHECK(entries.is_cuda() && entries.is_contiguous()\\n                        && entries.scalar_type() == at::kLong\\n                        && entries.dim() == 1,\\n                    \\\"invalid ChunkDelta3 \\\", name, \\\" CSR entries\\\");\\n    };\\n    check_entries(k_entries20x3, \\\"K\\\");\\n    check_entries(v_entries20x3, \\\"V\\\");\\n    auto check_entry_offsets = [body_rows = k_body.size(0)](\\n   