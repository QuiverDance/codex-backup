ecode(idx)'s buffer is offload(idx-P).  JIT single buffer (P=1) -> 1.\\n        _off = max(1, _np)\\n        self.kv_compressor.batch_decomp_stream.wait_event(\\n            self.kv_unload_done[(layer_id - _off) % self.n_layers])\\n        ok = self.kv_compressor.start_kv_h2d_persistent(\\n            layer_id,\\n            self.active_kv_buffer_ids,\\n            DualMemoryLoader.primary_k_caches[layer_id],\\n            DualMemoryLoader.primary_v_caches[layer_id])\\n        if not ok:\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()\\n            self._stage_tail_rollovers(\\n                layer_id, self.kv_compressor.batch_decomp_stream)\\n            return False\\n        if self.batch_has_prefill:\\n            self.prefill_kv_comp_load_layers += 1\\n        return True\\n\\n    def finish_kv_decompress(self, layer_id: int):\\n        \\\"\\\"\\\"Phase 2 of split KV decompress: launch decompress kernels.\\\"\\\"\\\"\\n        self.kv_compressor.finish_kv_decompress_persistent(\\n            layer_id,\\n            DualMemoryLoader.primary_k_caches[layer_id],\\n            DualMemoryLoader.primary_v_caches[layer_id])\\n        self._stage_tail_rollovers(\\n            layer_id, self.kv_compressor.batch_decomp_stream)\\n\\n        if self.time_breakdown:\\n            self.end_memcpy_kv_events[layer_id].record(self.load_kv_stream)\\n            self.end_kv_decomp_events[layer_id].record(\\n                self.kv_compressor.batch_decomp_stream)\\n        if _ENV_KV_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_pop()  # decompress_persistent\\n\\n    def unload_kv(self, layer_id: int, non_blocking=True):\\nvoid prepare_chunk_delta3_kv_decode(\\n    torch::Tensor block_ids,\\n    torch::Tensor slot_table,\\n    torch::Tensor sorted_block_ids_host,\\n    torch::Tensor host_k_body,\\n    torch::Tensor host_v_body,\\n    torch::Tensor host_k_offsets,\\n    torch::Tensor host_v_offsets,\\n    torch::Tensor host_k_entries,\\n    torch::Tensor host_v_entries,\\n    torch::Tensor gpu_k_body,\\n    torch::Tensor gpu_v_body,\\n    torch::Tensor gpu_k_offsets,\\n    torch::Tensor gpu_v_offsets,\\n    torch::Tensor gpu_block_ids,\\n    torch::Tensor gpu_k_entries,\\n    torch::Tensor gpu_v_entries,\\n    bool offsets_are_compact,\\n    int64_t active_slots,\\n    int64_t stream_handle)\\n{\\n    TORCH_CHECK(stream_handle != 0, \\\"CUDA stream handle must be nonzero\\\");\\n    TORCH_CHECK(\\n        block_ids.device().is_cpu()\\n            && block_ids.scalar_type() == at::kLong\\n            && block_ids.is_contiguous(),\\n        \\\"block_ids must be contiguous CPU int64\\\");\\n    TORCH_CHECK(\\n        slot_table.device().is_cpu()\\n            && slot_table.scalar_type() == at::kInt\\n            && slot_table.is_contiguous(),\\n        \\\"slot_table must be contiguous CPU int32\\\");\\n    TORCH_CHECK(\\n        sorted_block_ids_host.device().is_cpu()\\n            && sorted_block_ids_host.scalar_type() == at::kLong\\n            && sorted_block_ids_host.is_contiguous()\\n            && sorted_block_ids_host.is_pinned(),\\n        \\\"sorted block-ID staging must be pinned CPU int64\\\");\\n    TORCH_CHECK(active_slots >= 0, \\\"active_slots must be non-negative\\\");\\n\\n    const int64_t n = block_ids.numel();\\n    TORCH_CHECK(\\n        sorted_block_ids_host.numel() >= n,\\n        \\\"sorted block-ID staging is too small\\\");\\n    if (n == 0) {\\n        return;\\n    }\\n\\n    struct Route {\\n        int32_t slot;\\n        int64_t block_id;\\n    };\\n    std::vector<Route> routes(static_cast<size_t>(n));\\n    const auto* ids = block_ids.data_ptr<int64_t>();\\n    const auto* slots = slot_table.data_ptr<int32_t>();\\n    for (int64_t index = 0; index < n; ++index) {\\n        const int64_t block_id = ids[index];\\n        TORCH_CHECK(\\n            block_id >= 0 && block_id < slot_table.numel(),\\n            \\\"block ID out of range: \\\", block_id);\\n        const int32_t slot = slots[block_id];\\n        TORCH_CHECK(\\n            slot >= 0 && slot < active_slots,\\n            \\\"missing or invalid CD3 slot for block \\\", block_id,\\n            \\\" (slot=\\\", slot, \\\", active_slots=\\\", active_slots, \\\")\\\");\\n        routes[static_cast<size_t>(index)] = {slot, block_id};\\n    }\\n    std::sort(\\n        routes.begin(), routes.end(),\\n        [](const Route& lhs, const Route& rhs) {\\n            return lhs.slot < rhs.slot;\\n        });\\n    auto* sorted_ids = sorted_block_ids_host.data_ptr<int64_t>();\\n    for (int64_t index = 0; index < n; ++index) {\\n        if (index > 0) {\\n            TORCH_CHECK(\\n                routes[static_cast<size_t>(index - 1)].slot\\n                    != routes[static_cast<size_t>(index)].slot,\\n                \\\"duplicate persistent CD3 slot \\\",\\n                routes[static_cast<size_t>(index)].slot);\\n        }\\n        sorted_ids[index] = routes[static_cast<size_t>(index)].block_id;\\n    }\\n\\n    struct RowPool {\\n        char* gpu;\\n        char* host;\\n        size_t bytes_per_row;\\n        int64_t host_rows;\\n    };\\n    std::vector<torch::Tensor> gpu_rows = {gpu_k_body, gpu_v_body};\\n    std::vector<torch::Tensor> host_rows = {host_k_body, host_v_body};\\n    if (!offsets_are_compact) {\\n        gpu_rows.push_back(gpu_k_offsets);\\n        gpu_rows.push_back(gpu_v_offsets);\\n        host_rows.push_back(host_k_offsets);\\n        host_rows.push_back(host_v_offsets);\\n    }\\n    std::vector<RowPool> row_pools;\\n    row_pools.reserve(gpu_rows.size());\\n    for (size_t index = 0; index < gpu_rows.size(); ++index) {\\n        const auto& gpu = gpu_rows[index];\\n        const auto& host = host_rows[index];\\n        TORCH_CHECK(\\n            gpu.is_cuda() && host.device().is_cpu() && host.is_pinned(),\\n            \\\"CD3 row copies must be pinned CPU to CUDA\\\");\\n        TORCH_CHECK(\\n            gpu.dim() >= 1 && host.dim() >= 1\\n                && gpu.scalar_type() == host.scalar_type(),\\n            \\\"incompatible CD3 row tensors\\\");\\n        const size_t gpu_row_bytes =\\n            static_cast<size_t>(gpu.stride(0)) * gpu.element_size();\\n        const size_t host_row_bytes =\\n            static_cast<size_t>(host.stride(0)) * host.element_size();\\n        TORCH_CHECK(\\n            gpu_row_bytes == host_row_bytes,\\n            \\\"CD3 row strides differ\\\");\\n        TORCH_CHECK(gpu.size(0) >= n, \\\"GPU CD3 row staging is too small\\\");\\n        row_pools.push_back({\\n            static_cast<char*>(gpu.data_ptr()),\\n            static_cast<char*>(host.data_ptr()),\\n            host_row_bytes,\\n            host.size(0)});\\n    }\\n\\n    struct Span {\\n        int64_t dst_row;\\n        int32_t src_slot;\\n        int64_t count;\\n    };\\n    std::vector<Span> spans;\\n    spans.reserve(static_cast<size_t>(n));\\n    int64_t dst_row = 0;\\n    int32_t src_slot = routes.front().slot;\\n    int64_t count = 1;\\n    for (int64_t index = 1; index < n; ++index) {\\n        if (routes[static_cast<size_t>(index)].slot == src_slot + count) {\\n            ++count;\\n        } else {\\n            spans.push_back({dst_row, src_slot, count});\\n            dst_row = index;\\n            src_slot = routes[static_cast<size_t>(index)].slot;\\n            count = 1;\\n        }\\n    }\\n    spans.push_back({dst_row, src_slot, count});\\n\\n    std::vector<torch::Tensor> gpu_contiguous = {\\n        gpu_block_ids, gpu_k_entries, gpu_v_entries};\\n    std::vector<torch::Tensor> host_contiguous = {\\n        sorted_block_ids_host, host_k_entries, host_v_entries};\\n    if (offsets_are_compact) {\\n        gpu_contiguous.push_back(gpu_k_offsets);\\n        gpu_contiguous.push_back(gpu_v_offsets);\\n        host_contiguous.push_back(host_k_offsets);\\n        host_contiguous.push_back(host_v_offsets);\\n    }\\n    size_t nonempty_contiguous = 0;\\n    for (size_t index = 0; index < gpu