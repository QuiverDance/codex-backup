s_kernel(\\n    const uint8_t*       __restrict__ codes_g,\\n    const uint8_t*       __restrict__ sm_g,\\n    const uint8_t*       __restrict__ bases_g,\\n    const int32_t*       __restrict__ tile_offsets_g,\\n    const uint64_t*      __restrict__ entries20x3_g,\\n    const __nv_bfloat16* __restrict__ B_g,\\n    __nv_bfloat16*       __restrict__ C_g,\\n    float*               __restrict__ Cf32_g,\\n    int M, int N, int K, int split_k)\\n{\\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\\n    using namespace cute;\\n    constexpr int kTileM = 64, kTileK = 64;\\n    using Smem = CD3RSSmem<TileN, Stages>;\\n    extern __shared__ __align__(128) uint8_t raw_smem[];\\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\\n\\n    const int tid = static_cast<int>(threadIdx.x);\\n    const int tile_n = static_cast<int>(blockIdx.x);\\n    const int tile_m = static_cast<int>(blockIdx.y);\\n    const int tiles_k = K >> 6;\\n    const int split_idx = static_cast<int>(blockIdx.z);\\n    const int tk_split = tiles_k / split_k;\\n    const int k0 = split_idx * tk_split;\\n\\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\\n                         make_coord(tile_n, _));\\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\\n    auto tiled_copy = make_tiled_copy(G2S{},\\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\\n    auto thr_copy = tiled_copy.get_slice(tid);\\n    auto tBgB = thr_copy.partition_S(gB);\\n    auto tBsB = thr_copy.partition_D(sB);\\n\\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\\n                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\\n    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\\n                              make_coord(tile_m, tile_n));\\n    auto tiled_mma = make_tiled_mma(MmaOp{});\\n    auto thr_mma = tiled_mma.get_thread_slice(tid);\\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\\n    clear(tCrC);\\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\\n\\n    using SmemLayoutA = decltype(tile_to_shape(\\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\\nstatic cudaError_t LaunchCD3RS48(\\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\\n    const uint8_t* bases, const int32_t* tile_offsets,\\n    const uint64_t* entries20x3,\\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\\n    int M, int N, int K)\\n{\\n    if ((M & 63) || N != 48 || (K & 63)) return cudaErrorNotSupported;\\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\\n        (split_k > 1 && Cf32 == nullptr))\\n        split_k = 1;\\n    using Smem = CD3RS48Smem<Stages>;\\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\\n    dim3 grid(1, M / 64, split_k);\\n    auto kernel = cd3_rs48_kernel<Stages>;\\n    static int cfg = -1;\\n    if (cfg != smem_bytes) {\\n        cudaError_t e = cudaFuncSetAttribute(\\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\\n        if (e != cudaSuccess) return e;\\n        (void)cudaFuncSetAttribute(kernel,\\n            cudaFuncAttributePreferredSharedMemoryCarveout,\\n            cudaSharedmemCarveoutMaxShared);\\n        cfg = smem_bytes;\\n    }\\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\\n        codes, sm, bases, tile_offsets, entries20x3,\\n        B, C, Cf32, M, N, K, split_k);\\n    cudaError_t err = cudaGetLastError();\\n    if (err != cudaSuccess || split_k <= 1) return err;\\n    const int64_t MN = static_cast<int64_t>(M) * N;\\n    const int t = 256;\\n    const int64_t blocks = (MN + t - 1) / t;\\n    splitk_reduce_kernel<<<static_cast<unsigned>(blocks), t, 0, stream>>>(\\n        Cf32, C, MN, split_k);\\n    return cudaGetLastError();\\n}\\n\\ntemplate <int TileN, class MmaOp, int Stages>\\nstatic cudaError_t LaunchCD3RS(\\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\\n    const uint8_t* bases, const int32_t* tile_offsets,\\n    const uint64_t* entries20x3,\\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\\n    int M, int N, int K)\\n{\\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\\n        (split_k > 1 && Cf32 == nullptr))\\n        split_k = 1;\\n    using Smem = CD3RSSmem<TileN, Stages>;\\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\\n    dim3 grid(N / TileN, M / 64, split_k);\\n    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\\n    static int cfg = -1;\\n    if (cfg != smem_bytes) {\\n        cudaError_t e = cudaFuncSetAttribute(\\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\\n        if (e != cudaSuccess) return e;\\n        (void)cudaFuncSetAttribute(kernel,\\n            cudaFuncAttributePreferredSharedMemoryCarveout,\\n            cudaSharedmemCarveoutMaxShared);\\n        cfg = smem_bytes;\\n    }\\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\\n        codes, sm, bases, tile_offsets, entries20x3,\\n        B, C, Cf32, M, N, K, split_k);\\n    cudaError_t err = cudaGetLastError();\\n    if (err != cudaSuccess || split_k <= 1) return err;\\n    const int64_t MN = static_cast<int64_t>(M) * N;\\n    const int t = 256;\\n    const int64_t blocks = (MN + t - 1) / t;\\n    splitk_reduce_kernel<<<static_cast<unsigned>(blocks), t, 0, stream>>>(\\n        Cf32, C, MN, split_k);\\n    return cudaGetLastError();\\n}\\n\\nextern \\\"C\\\" cudaError_t cd3_rs_wgmma_launch(\\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\\n    const uint8_t* bases, const int32