_layers\\n            jit_decode_this = self._jit_current_kv(dm)\\n            decode_tgt = (graph_idx if jit_decode_this else target_kv_idx)\\n            load_kv_stream = dm._kv_load_stream_for(decode_tgt)\\n            if not load_only_kv:\\n                cur_nf = frozen_idx_map[graph_idx]\\n                nxt_nf = (cur_nf + 1) % n_not_frozen\\n                target_decoder_idx = dm.not_frozen_layers[nxt_nf]\\n\\n        # ── 1. Finish split-phase KV decompress ──\\n        if kv_split:\\n            # JIT finishes the current layer; non-JIT finishes the prefetched\\n            # next layer.  In both cases the barrier must be recorded *after*\\n            # finish launches the decode kernels, not after start's H2D only.\\n            target_kv_local = (graph_idx if jit_decode_this\\n                               else (graph_idx + 1) % n_layers)\\n            dm.finish_kv_decompress(target_kv_local)\\n            barrier = dm.exec_attn_barriers[target_kv_local]\\n            barrier.record(dm.kv_compressor.batch_decomp_stream)\\n\\n        # ── Frozen weight lookahead: keep the decomp/H2D pipeline DEPTH\\n        #    graphs ahead of the graph that will read it ──\\n        # Queue as soon as the current graph is submitted, before any KV wait\\n        # for eager attention, to give the decomp stream + copy engine the\\n        # largest possible window.  Prefetching only +1 (the old behaviour)\\n        # left the big gate_up/down weights with a single attention of lead\\n        # In V0, the exec_attn_barriers[graph_idx] wait is baked into the\\n        # captured graph.  In V1, attention runs eagerly on current_stream\\n        # right after this wrapper returns.  So we must wait here.\\n        if include_attn:\\n            # The elapsed between begin/end is the GPU stall attention takes\\n            # while waiting for KV decompress on batch_decomp_stream — the\\n            # only KV-comp critical-path contribution we care about.  But\\n            