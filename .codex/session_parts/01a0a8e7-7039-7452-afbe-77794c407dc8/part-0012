ted_ns) / 1e6\\n\\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\\n                            timeout_sec: float = -1.0, *,\\n                            _join_site: str = \\\"load\\\") -> None:\\n        with self._slot_state_lock:\\n            pending = self._pending_compress.get(layer_id)\\n        profile = pending.get(\\\"profile\\\") if pending is not None else None\\n        if profile is not None:\\n            kv_cpu_profile.begin_join(profile, _join_site)\\n        buffer_ids = []\\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Compact append garbage off the request path in the CPU worker.\\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n        rows = self._kv_slot_allocator[layer_id].high_water\\n        slots = np.arange(rows, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[:rows]\\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        if total_words > max_words:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 persistent CSR exceeds host slot capacity: \\\"\\n                f\\\"layer={layer_id} side={kv} words={total_words} \\\"\\n                f\\\"capacity={max_words}\\\")\\n        previous = self._persistent_csr[layer_id][kv]\\n        previous_capacity = (\\n            previous.entries.numel() if previous is not None else 0)\\n        capacity = max(\\n            1024, total_words,\\n            min(max_words, previous_capacity),\\n        )\\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\\n        offsets = torch.zeros(\\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\\n        if rows:\\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n                pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n                torch.from_numpy(slots), entries[:total_words],\\n                offsets[:rows])\\n        state = _PersistentCSRState(\\n            entries=entries,\\n            offsets=offsets,\\n            word_counts=np.zeros(\\n                self._max_n_blocks + 1, dtype=np.int64),\\n            used_words=total_words,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        state.word_counts[:rows] = word_counts\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _append_persistent_csr(\\n            self, layer_id: int, kv: str, slots: torch.Tensor) -> None:\\n        \\\"\\\"\\\"Append encoded slots using one native count/prefix calculation.\\\"\\\"\\\"\\n        count = slots.numel()\\n        if count == 0:\\n            return\\n        scratch = self._csr_append_scratch.get(layer_id)\\n        if scratch is None or scratch.shape[1] < count:\\n            capacity = max(count, 2 * scratch.shape[1] if scratch is not None else 0)\\n            scratch = torch.empty((2, capacity), dtype=torch.int64)\\n            self._csr_append_scratch[layer_id] = scratch\\n        new_word_counts = scratch[0, :count]\\n        relative_offsets = scratch[1, :count]\\n        pool = self._host_pools[layer_id][kv]\\n        state = self._persistent_csr[layer_id][kv]\\n        if state is None:\\n            state = self._new_persistent_csr(layer_id, kv)\\n        append_words, old_words = _cd3_ext.prepare_host_chunk_delta3_csr_append(\\n            pool[\\\"num_exceptions\\\"], slots, state.word_counts,\\n            new_word_counts, relative_offsets, self._packed_capacity)\\n\\n        required = int(state.used_words) + append_words\\n        # Reuse/re-encode churn can leave unreachable append records.  Only\\n