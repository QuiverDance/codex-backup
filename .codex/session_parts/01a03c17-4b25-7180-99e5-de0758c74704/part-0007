d_blocks\n +        physical_buffer_offset = num_dedicated_blocks + num_tail_slots\n@@ -3878,7 +3911,7 @@ index 1e13650cd..4e64f6645 100644\n          warmup_sizes = []\n  \n          if self.vllm_config.compilation_config.mode == CompilationMode.VLLM_COMPILE:\n-@@ -541,6 +912,9 @@ class Worker(WorkerBase):\n+@@ -541,6 +922,9 @@ class Worker(WorkerBase):\n          # the model initialization and profiling.\n          set_random_seed(self.model_config.seed)\n  \n"},{"type":"input_text","text":"### tree_size\n5.0G\t/root/projects/vllm\n4.1G\t/root/projects/tiered-serve\n/root/projects/vllm/vllm/_C.abi3.so 465025872\n/root/projects/vllm/vllm/vllm_flash_attn/_vllm_fa2_C.abi3.so 314303880\n/root/projects/vllm/vllm/vllm_flash_attn/_vllm_fa3_C.abi3.so 1179201672\n/root/projects/vllm/vllm/_flashmla_extension_C.abi3.so 12683024\n/root/projects/vllm/vllm/_moe_C.abi3.so 67687464\n/root/projects/vllm/vllm/_flashmla_C.abi3.so 27227320\n/root/projects/vllm/vllm/cumem_allocator.abi3.so 142784\ndocs/SERVING_GUIDE.md\ndocs/compressions.png\npatches/vllm.patch\nscripts/serving/run_experiment.sh\nserve_offload_kvweight.py\ntiered_serve/dual_memory_loader/__init__.py\ntiered_serve/model_configs/meta-llama/Llama-3.1-70B-Instruct/flexgen-comp.yaml\n"},{"type":"input_text","text":"### client_script\n#!/bin/bash\n# Usage: bash scripts/serving/client/azure_conv.sh MODEL_ALIAS [TS_CONFIG] [REQUEST_RATE...]\n#   MODEL_ALIAS  : llama70b, llama70b-fp8, qwen72b\n#   TS_CONFIG    : (선택) 실행 중인 ts-config 이름 또는 경로. 결과 저장 디렉토리 키로 사용.\n#                  생략 시 \"manual\". 오케스트레이터가 $cfg를 그대로 넘김.\n#   REQUEST_RATE : (선택) 측정할 request rate. 1개 이상 지정 시 모델별 스윕 대신 그 값들만 측정.\n#                  예: ... llama70b manual 0.8 1.0 1.2\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/../model_map.sh\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS [TS_CONFIG] (e.g. llama70b, llama70b-fp8, qwen72b)}\"\nresolve_model \"$MODEL_ALIAS\"\n\n# ── 결과 저장 키 유도 (서버 로그 명명 규칙과 일치) ────────────────────\n# 서버: ts_config_name = Path(ts_configs[0]).stem,\n#       model_id = model.split('/')[-1].lower().replace('-','_').replace('.','_')\nTS_CONFIG=\"${2:-manual}\"\nTS_NAME=\"$(basename \"$TS_CONFIG\")\"; TS_NAME=\"${TS_NAME%.yaml}\"; TS_NAME=\"${TS_NAME%.yml}\"\nMODEL_ID=\"$(echo \"${MODEL##*/}\" | tr '[:upper:]' '[:lower:]' | tr '.-' '__')\"\nRESULT_DIR=\"${RESULT_DIR:-logs/serving/$MODEL_ID/$TS_NAME/client}\"\nmkdir -p \"$RESULT_DIR\"\necho \"Saving results to: $RESULT_DIR\"\n\n# ── request rate 결정 ────────────────────────────────────────────────\n# 3번째 이후 인자로 rate를 1개 이상 주면 스윕 대신 그 값들만 측정.\nREQUEST_RATE_ARGS=(\"${@:3}\")\nif [ \"${#REQUEST_RATE_ARGS[@]}\" -gt 0 ]; then\n  REQUEST_RATES=\"${REQUEST_RATE_ARGS[*]}\"\nelse\n  case \"$MODEL_ALIAS\" in\n    qwen72b)\n      REQUEST_RATES=$(seq 0.5 0.1 1.2)\n      ;;\n    llama70b)\n      REQUEST_RATES=$(seq 1.6 -0.2 0.6)\n      ;;\n    llama70b-fp8)\n      REQUEST_RATES=$(seq 1.6 0.2 3.0)\n      ;;\n    *)\n      REQUEST_RATES=$(seq 0.4 0.2 2.0)\n      ;;\n  esac\nfi\n\necho \"Running benchmark with MODEL: $MODEL\"\necho \"Request rates to be tested: $REQUEST_RATES\"\n\nfor rate in $REQUEST_RATES\ndo\n  echo \"-----------------------------------------\"\n  echo \"Benchmarking with request-rate: $rate\"\n  echo \"-----------------------------------------\"\n  python -m vllm.entrypoints.cli.main bench serve \\\n    --model \"$MODEL\" \\\n    --dataset-name azure_conv \\\n    --ignore-eos \\\n    --num-prompts 1200 \\\n    --skip-first-n-requests 100 \\\n    --skip-last-n-requests 100 \\\n    --metric-percentiles='90' \\\n    --request-rate \"$rate\" \\\n    --save-result \\\n    --save-detailed \\\n    --result-dir \"$RESULT_DIR\" \\\n    --result-filename \"rate_${rate}.json\" \\\n    --metadata ts_config=\"$TS_NAME\" model=\"$MODEL_ID\"\ndone\n\necho \"Benchmark finished.\"\n  -d '{\n    \"model\": \"meta-llama/Llama-3.1-70B-Instruct\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"What is the capital of France?\"}],\n    \"temperature\": 0,\n    \"max_tokens\": 16\n  }'\n```\n\n8B server에는 request의 `model`도 8B ID로 바꾼다. `--served-model-name`을\n사용했다면 그 alias를 넣는다. `/v1/completions`도 지원한다. `--api-key`를 사용했다면\nOpenAI API 요청에 `Authorization: Bearer <key>` header를 추가한다. 외부\n접속이 필요하지 않으면 `127.0.0.1` bind를 유지한다.\n\n## 5. Server-side logging\n\nLauncher log는 자동으로 다음 위치에 생긴다.\n\n```text\nlogs/serving/<model-id>/<config>/<timestamp>/<max-context-len>.log\n```\n\n요청 구간의 server logging은 다음 endpoint로 제어한다.\n\n```bash\ncurl -fsS -X POST http://127.0.0.1:8000/start_logging\n\n# workload 실행\n\ncurl -fsS -X POST http://127.0.0.1:8000/stop_logging \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"prompt\":\"manual\"}'\n```\n\n`<max-context-len>.log`는 항상 연결된 launcher log다. `/start_logging`은\n응답으로 `engine_id`와 `log_dir`를 반환하고 workload 구간에 같은 directory의\n`server.log` handler를 추가한다. `/stop_logging`의 `prompt` 값은 현재 파일명을\n바꾸지 않는다.\n\n`--collect-time`은 endpoint와 독립적으로 startup부터 CUDA-event timing을 켜고\n`<timestamp>_<engine-id>_collect_time.log`를 쓴다. Normal latency 비교에는\n사용하지 않는다.\n\n## 6. Torch profiler\n\nProfiler endpoint는 `--profiler-config`를 준 server에만 생긴다.\n\n```bash\nmkdir -p /tmp/tiered-serve-profile\ncurl -fsS -X POST http://127.0.0.1:8000/start_profile\n# workload 실행\ncurl -fsS -X POST http://127.0.0.1:8000/stop_profile\n```\n\nServer 명령에는 다음 인자를 추가한다.\n\n```text\n--profiler-config '{\"profiler\":\"torch\",\"torch_profiler_dir\":\"/tmp/tiered-serve-profile\"}'\n```\n\nTrace는 `torch_profiler_dir`에 저장된다. Profiler, `--collect-time`, server\nlogging은 서로 다른 기능이며 profiler와 collect-time에는 계측 overhead가 있다.\n\nAPI key middleware는 `/v1` request만 검사한다. `/health`, `/metrics`, docs,\nlogging/profile endpoint 등 non-`/v1` 경로는 reverse proxy나 firewall에서\n별도로 보호한다. `--host`를 생략하면 외부 interface에 bind될 수 있으므로 local\n실험은 `127.0.0.1`을 명시한다.\n\n## 7. Client 실행\n\n```text\nbash scripts/serving/client/azure_conv.sh <model-id> <config-id> <optinal: request-rate>\n# ex) \nbash scripts/serving/client/azure_conv.sh llama70b cao-p4-kvcomp 1.0\n```\n\n## 8. 종료와 실험 wrapper\n\nForeground server는 `Ctrl-C`로 종료한다. Background 실행은 위 command의\n마지막을 `--port 8000 > /tmp/tiered-serve.out 2>&1 &`로 바꾸고 즉시 PID를\n저장한다.\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03303-29c4-7690-9b74-9ce4189f9a9e","create_time":1787562299.2270217}}}
