  # 스크립트 중단 시 서버 정리\n    trap 'kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null' EXIT\n\n    # health check 대기\n    echo \"[*] Waiting for server (PID=$SERVER_PID)...\"\n    elapsed=0\n    while ! curl -sf \"http://localhost:${PORT}/health\" > /dev/null 2>&1; do\n        if ! kill -0 \"$SERVER_PID\" 2>/dev/null; then\n            echo \"[!] Server died unexpectedly.\"\n            exit 1\n        fi\n        if [ \"$elapsed\" -ge \"$TIMEOUT\" ]; then\n            echo \"[!] Timeout (${TIMEOUT}s) waiting for server.\"\n            kill \"$SERVER_PID\" 2>/dev/null\n            exit 1\n        fi\n        sleep 5\n        elapsed=$((elapsed + 5))\n    done\n    echo \"[*] Server ready after ${elapsed}s.\"\n\n    # 클라이언트 실행 (포그라운드, 끝날 때까지 대기) — 현재 config 전달\n    echo \"[*] Running client...\"\n    bash scripts/serving/client/azure_conv.sh \"$MODEL_ALIAS\" \"$cfg\"\n    echo \"[*] Client finished.\"\n\n    # 서버 종료\n    echo \"[*] Shutting down server...\"\n    kill \"$SERVER_PID\" 2>/dev/null\n    wait \"$SERVER_PID\" 2>/dev/null || true\n    trap - EXIT\n    sleep 5\ndone\n\necho \"\"\necho \"[*] All experiments finished.\"\n#!/bin/bash\n# 호스트에서 실행 (tmux 세션의 pane으로 명령 전송)\n# pane 0: 서버 (컨테이너), pane 1: 클라이언트 (컨테이너), pane 2: 이 스크립트 (호스트)\n#\n# Usage:\n#   bash run_experiment_tmux.sh llama70b azure_conv                          # 기본 CONFIGS\n#   bash run_experiment_tmux.sh llama70b azure_conv baseline-gateup          # 단일 config\n#   bash run_experiment_tmux.sh llama70b azure_conv cfg1 cfg2 cfg3           # 복수 config\n# (둘째 인자는 scripts/serving/client/ 아래의 클라이언트 스크립트 이름, .sh 생략 가능)\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/model_map.sh\"\n\nCONTAINER=\"${CONTAINER:-tiered-serve}\"\nPORT=${PORT:-8000}\nTIMEOUT=${TIMEOUT:-600}\n\n# ── tmux pane 자동 탐지 ──────────────────────────────────────────\n# 이 스크립트를 실행 중인 pane을 찾고, 나머지 pane을 서버/클라이언트에 배정\n# pane_id (%N) 는 절대적이라 pane-base-index 영향 없음\nif [[ -n \"${TMUX:-}\" ]]; then\n    SESSION=\"$(tmux display-message -p '#S')\"\n    MY_PANE=\"$(tmux display-message -p '#{pane_id}')\"\n    # 같은 윈도우의 모든 pane ID를 index 순으로\n    mapfile -t ALL_PANES < <(tmux list-panes -F '#{pane_id}')\n    OTHER_PANES=()\n    for p in \"${ALL_PANES[@]}\"; do\n        [[ \"$p\" != \"$MY_PANE\" ]] && OTHER_PANES+=(\"$p\")\n    done\n    if [[ ${#OTHER_PANES[@]} -lt 2 ]]; then\n        echo \"[!] Error: need at least 3 panes (server, client, this script). Found ${#ALL_PANES[@]}.\"\n        exit 1\n    fi\n    SERVER_PANE=\"${SERVER_PANE:-${OTHER_PANES[0]}}\"\n    CLIENT_PANE=\"${CLIENT_PANE:-${OTHER_PANES[1]}}\"\nelse\n    # tmux 외부에서 실행 시 (예: docker exec) — 환경변수 필수\n    SERVER_PANE=\"${SERVER_PANE:?Not in tmux. Set SERVER_PANE env var (e.g. %0)}\"\n    CLIENT_PANE=\"${CLIENT_PANE:?Not in tmux. Set CLIENT_PANE env var (e.g. %1)}\"\nfi\necho \"[*] Server pane: $SERVER_PANE, Client pane: $CLIENT_PANE, My pane: ${MY_PANE:-N/A}\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS CLIENT_SCRIPT [CONFIG ...]}\"\nshift\nCLIENT_SCRIPT=\"${1:?Usage: $0 MODEL_ALIAS CLIENT_SCRIPT [CONFIG ...]}\"\nshift\nCLIENT_SCRIPT=\"${CLIENT_SCRIPT%.sh}\"   # .sh 붙여 줘도 동작\nresolve_model \"$MODEL_ALIAS\"\n\nif [[ $# -gt 0 ]]; then\n    CONFIGS=(\"$@\")\nelse\n    CONFIGS=(\"flexgen\" \"flexgen-comp\" \"cao-zs\" \"cao-zs-fused\" \\\n             \"cao-p4\" \"cao-p4-fused\" \"cao-p4-kvcomp\" \"cao-zs-kvcomp\")\nfi\n\n# config별 서버 플래그 (weight-comp 백엔드 / --fused-mm / --kv-comp 조합).\n# --weight-comp 백엔드는 config YAML 안에 박힌 per-layer compressor 와 일치해야 한다\n#   cao-zs* → zipserv, cao-p4* → p4flat (cao-*-kvcomp 도 동일 규칙).\ndeclare -A CFG_FLAGS=(\n    [flexgen]=\"--weight-comp zipserv\"\n    [flexgen-comp]=\"--weight-comp zipserv\"\n    [cao-zs]=\"--weight-comp zipserv\"\n    [cao-zs-fused]=\"--weight-comp zipserv --fused-mm\"\n    [cao-zs-kvcomp]=\"--weight-comp zipserv --fused-mm --kv-comp ublb_flat\"\n    [cao-p4]=\"--weight-comp p4flat\"\n    [cao-p4-fused]=\"--weight-comp p4flat --fused-mm\"\n    [cao-p4-kvcomp]=\"--weight-comp p4flat --fused-mm --kv-comp ublb_flat\"\n)\n\nfor cfg in \"${CONFIGS[@]}\"; do\n    # 클라이언트에 현재 config 전달 → 결과가 config별 디렉토리로 저장됨\n    CLIENT_CMD=\"bash scripts/serving/client/${CLIENT_SCRIPT}.sh $MODEL_ALIAS $cfg\"\n\n    # config별 서버 플래그 결정 (미등록 config 는 zipserv weight-comp 기본)\n    EXTRA_FLAGS=\"${CFG_FLAGS[$cfg]:-}\"\n    if [[ -z \"$EXTRA_FLAGS\" ]]; then\n        echo \"[!] '$cfg' 에 대한 플래그 매핑 없음 → 기본 '--weight-comp zipserv' 사용\"\n        EXTRA_FLAGS=\"--weight-comp zipserv\"\n    fi\n\n    echo \"\"\n    echo \"==========================================\"\n    echo \"  Config: $cfg\"\n    echo \"  Model:  $MODEL\"\n    echo \"  Flags:  $EXTRA_FLAGS\"\n    echo \"==========================================\"\n\n    # pane 0: 서버 시작\n    tmux send-keys -t \"$SERVER_PANE\" \\\n      \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True numactl -m 0 ./.venv/bin/python serve_offload_kvweight.py --model $MODEL --no-enable-prefix-caching --chunked-prefill $EXTRA_FLAGS --ts-configs $cfg\" Enter\n\n    # health check 대기 (docker exec로 컨테이너 안에서 curl)\n    echo \"[*] Waiting for server...\"\n    elapsed=0\n    while ! docker exec \"$CONTAINER\" curl -sf \"http://localhost:${PORT}/health\" > /dev/null 2>&1; do\n        if [ \"$elapsed\" -ge \"$TIMEOUT\" ]; then\n            echo \"[!] Timeout (${TIMEOUT}s) waiting for server.\"\n            exit 1\n        fi\n        sleep 5\n        elapsed=$((elapsed + 5))\n        printf \"\\r[*] %ds elapsed...\" \"$elapsed\"\n    done\n    echo -e \"\\n[*] Server ready after ${elapsed}s.\"\n\n    # pane 1: 클라이언트 실행 (완료 시 sentinel 파일 생성)\n    SENTINEL=\"/tmp/.client_done_$$\"\n    docker exec \"$CONTAINER\" rm -f \"$SENTINEL\" 2>/dev/null || true\n    tmux send-keys -t \"$CLIENT_PANE\" \"$CLIENT_CMD; touch $SENTINEL\" Enter\n\n    # 클라이언트 완료 대기: sentinel 파일이 생길 때까지\n    echo \"[*] Waiting for client to finish...\"\n    while ! docker exec \"$CONTAINER\" test -f \"$SENTINEL\" 2>/dev/null; do\n        sleep 10\n    done\n    docker exec \"$CONTAINER\" rm -f \"$SENTINEL\" 2>/dev/null || true\n    sleep 3\n    echo \"[*] Client finished.\"\n\n    # 서버 종료: pkill 기반 (fuser 없음)\n    echo \"[*] Server shutting down...\"\n    docker exec \"$CONTAINER\" bash -c \"ps aux | grep -E 'serve_offload_kvweight' | grep -v grep\" || true\n\n    # 1) SIGINT\n    echo \"[*] Sending SIGINT...\"\n    docker exec \"$CONTAINER\" pkill -INT -f 'serve_offload_kvweight' 2>/dev/null || true\n    sleep 5\n\n    # 2) 프로세스 종료 대기\n    elapsed=0\n    while docker exec \"$CONTAINER\" pgrep -f 'serve_offload_kvweight' > /dev/null 2>&1; do\n        if [ \"$elapsed\" -ge 30 ]; then\n            echo -e \"\\n[!] Server did not exit after 30s, sending SIGKILL...\"\n            docker exec \"$CONTAINER\" pkill -9 -f 'serve_offload_kvweight' 2>/dev/null || true\n            sleep 5\n            break\n        fi\n        sleep 3\n        elapsed=$((elapsed + 3))\n        printf \"\\r[*] Waiting for server to exit... %ds\" \"$elapsed\"\n    done\n\n    # 3) 최종 확인\n    if docker exec \"$CONTAINER\" pgrep -f 'serve_offload_kvweight' > /dev/null 2>&1; then\n        echo \"[!] WARNING: Still alive, killing all python...\"\n        docker exec \"$CONTAINER\" killall -9 python python3 2>/dev/null || true\n        sleep 5\n    fi\n    echo \"[*] Server stopped.\"\n    sleep 2\ndone\n\necho \"\"\necho \"[*] All experiments finished.\"\n"},{"type":"input_text","text":"### patchdiffstat\n patches/vllm.patch                | 61 ++++++++++++++++++++++++++++++---------\n scripts/serving/run_experiment.sh |  4 ++-\n serve_offload_kvweight.py         |  2 +-\n 3 files changed, 51 insertions(+), 16 deletions(-)\n47\t14\tpatches/vllm.patch\n3\t1\tscripts/serving/run_experiment.sh\n1\t1\tserve_offload_kvweight.py\n"},{"type":"input_text","text":"### oldpatch\ndiff --git a/cmake/external_projects/vllm_flash_attn.cmake b/cmake/external_projects/vllm_flash_attn.cmake\ndiff --git a/csrc/cache.h b/csrc/cache.h\ndiff --