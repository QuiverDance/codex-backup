(\n                \"##### KV full-block-only enabled \"\n                \"(partial tails stay in HBM)\")\n    if split_weight or split_kv:\n        logger.info(\n            \"##### Mantissa/Exponent SPLIT enabled (weight_split=%s, \"\n            \"kv_split=%s, weight=%s, kv=%s, kv_codec=%s)\",\n            split_weight, split_kv, args.weight_comp, args.kv_comp,\n            os.environ.get(\"TIERED_SERVE_KV_MANT_CODEC\", \"dietgpu\"))\n    logger.info(\n        \"##########################################################################\"\n    )\n\n    engine_args = AsyncEngineArgs.from_cli_args(args)\n    for name, attr in args.__dict__.items():\n        engine_args.__setattr__(name, attr)\n    engine_args.disable_log_requests = True\n    engine_args.enforce_eager = False\n    engine_args.max_num_seqs = min(args.max_num_seqs, 512) if args.max_num_seqs is not None else 512\n    engine_args.enable_prefix_caching = False\n    engine_args.enable_chunked_prefill = True\n    engine_args.max_num_batched_tokens = 1024\n    engine_args.max_model_len = args.max_context_len\n    engine_args.swap_space = 0\n    engine_args.block_size = 16\nimport os\n\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\n\n\ndef _should_zero_kv_on_alloc() -> bool:\n    value = os.getenv(\"TIERED_SERVE_ZERO_KV_ON_ALLOC\")\n    if value is not None:\n        return value == \"1\"\n    return getattr(DualMemoryLoader, \"use_kv_comp\", False)\n\n\ndef _contiguous_ranges(block_ids):\n    if not block_ids:\n        return []\n\n    sorted_block_ids = sorted(set(block_ids))\n    ranges = []\n    start = sorted_block_ids[0]\n    end = start + 1\n    for block_id in sorted_block_ids[1:]:\n        if block_id == end:\n            end += 1\n        else:\n            ranges.append((start, end))\n            start = block_id\n            end = block_id + 1\n    ranges.append((start, end))\n    return ranges\n\n\ndef _zero_allocated_offloadable_blocks(blocks):\n    if not _should_zero_kv_on_all