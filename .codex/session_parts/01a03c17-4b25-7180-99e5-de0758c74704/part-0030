n\n        EngineCore calls this before the worker prepares its input table.  The\n        feature-disabled path is an intentional no-op so the legacy unload\n        callback can share the same metadata contract.\n        \"\"\"\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is None:\n            raise RuntimeError(\n                \"full-block KV write arrived before tail residency setup\")\n        manager.record_write(\n            request_id=write.request_id,\n            block_id=write.block_id,\n            block_index=write.block_index,\n            pre_valid=write.pre_valid,\n            post_valid=write.post_valid,\n            block_size=write.block_size,\n        )\n\n    @classmethod\n    def free_tail_block(cls, block_id: int) -> None:\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is not None:\n            manager.free_block(block_id)\n\n    def configure_tail_residency(\n        self,\n        canonical_dedicated: int,\n        tail_slots: int,\n        physical_buffer_offset: int,\n    ) -> None:\n\n        Prefill traditionally forced the raw secondary cache. The opt-in\n        mixed-prefill path instead passes the whole active set to the\n        compressor, whose persistent-valid filter reconstructs only historical\n        blocks; fresh prompt blocks are left untouched until the current\n        attention writes them.\n        \"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and layer_id in self.kv_comp_targets\n            and self.kv_decode_load_backend == \"compressed\"\n            and (\n                not self.batch_has_prefill\n                or self.kv_comp_prefill_load\n            )\n        )\n\n    def _prefill_uses_dedicated_raw_kv_stream(self) -> bool:\n        \"\"\"Whether this prefill step has any raw-secondary KV layer.\"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and self.batch_has_prefill\n            and (\n                not self.kv_comp_prefill_load\n                or self.kv_decode_load_backend != \"compressed\"\n                or len(self.kv_comp_targets) != self.n_layers\n            )\n        )\n\n    def _kv_load_stream_for(self, layer_id: int):\n        \"\"\"Return the stream that actually materializes this layer's KV.\n\n        KVCOMP decode may intentionally put compressed-blob H2D on the weight\n        stream. A prefill-bearing batch uses raw secondary KV by default and\n        carries a same-parity unload dependency; keep that dependency on the\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int):\n        started = _time.perf_counter()\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        # Clean up persistent compressed KV metadata\n        if cls.use_kv_comp and hasattr(cls, '_kv_compressor_ref') and cls._kv_compressor_ref is not None:\n            kc = cls._kv_compressor_ref\n            streams = (getattr(kc, 'batch_decomp_stream', None),\n                       getattr(kc, 'load_kv_stream', None),\n                       getattr(kc, 'comp_stream', None))\n            if cls.kv_free_mode == \"sync\":\n                # Historical baseline: drain every stream before returning a\n                # persistent host-pool slot to the allocator. Keep this branch\n                # equivalent in ordering for a clean A/B.\n                for stream in streams:\n                    if stream is not None:\n                        stream.synchronize()\n                        cls._kv_free_stream_syncs += 1\n                for layer_id in range(n_layers):\n                    kc.free_persistent_block(layer_id, block_id)\n            else:\n                retire = getattr(kc, \"retire_persistent_block\", None)\n                if retire is None:\n                    raise RuntimeError(\n                        \"TIERED_SERVE_KV_FREE_MODE=retired is unsupported by \"\n                        f\"{type(kc).__name__}; use sync mode\")\n\n                # Record after all work already submitted to each distinct\n                # stream. The logical block mapping is invalidated immediately,\n                # while its physical host-pool rows remain quarantined until\n                # this gate (and any CPU encoder that captured the row) retires.\n                events = []\n                seen_streams = set()\n                for stream in streams:\n                    if stream is None:\n                        continue\n                    key = (str(stream.device), int(stream.cuda_stream))\n                    if key in seen_streams:\n                        continue\n                    seen_streams.add(key)\n                    event = torch.cuda.Event(\n                        blocking=False, enable_timing=False)\n                    event.record(stream)\n                    events.append(event)\n                gate = _KVRetireGate(events)\n                cls._kv_free_retire_events += len(events)\n                for layer_id in range(n_layers):\n                    retire(layer_id, block_id, gate)\n\n        cls._kv_free_calls += 1\n        cls._kv_free_host_seconds += _time.perf_counter() - started\n        interval = _ENV_KV_FREE_LOG_INTERVAL\n        if interval and cls._kv_free_calls % interval == 0:\n            retired = {}\n            if cls.kv_free_mode == \"retired\":\n                stats_fn = getattr(\n                    getattr(cls, '_kv_compressor_ref', None),\n                    \"get_retired_kv_stats\", None)\n                if stats_fn is not None:\n                    retired = stats_fn()\n            logger.info(\n                \"[kv-free] mode=%s calls=%d host_total=%.3fms \"\n                \"host_avg=%.3fus stream_syncs=%d retire_events=%d \"\n                \"retired_current=%d retired_peak=%d forced_waits=%d \"\n                \"max_age=%.3fms\",\n                cls.kv_free_mode, cls._kv_free_calls,\n                cls._kv_free_host_seconds * 1e3,\n                cls._kv_free_host_seconds * 1e6 / cls._kv_free_calls,\n                cls._kv_free_stream_syncs, cls._kv_free_retire_events,\n                retired.get(\"current\", 0), retired.get(\"peak\", 0),\n                retired.get(\"forced_waits\", 0),\n                retired.get(\"max_age_ms\", 0.0))\n\n    # @log_sparse(stack_depth=5)\n    def load_kv(self, layer_id: int, force=False, non_blocking=True):\n\n        def get_ptr_tensor(tensor_list):\n            \"\"\"\n            텐서 리스트로부터 각 텐서의 데이터 포인터를 담은 텐서를 생성합니다.\n            \"\"\"\n            return torch.tensor([t.data_ptr() for t in tensor_list],\n                                dtype=torch.int64,\n                                device=tensor_list[0].device)\n\n        if self.is_graph_warming_up:\n            return\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n        trip — callers index/scatter with it directly).\"\"\"\n        # Nonblocking common case: make completed retired rows reusable before\n        # growing the high-water mark. This polls CUDA events; it never waits.\n        self._reap_retired_kv_slots(layer_id)\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_np = self._kv_slot_np[layer_id]            # authority (shared\n        # memory with the torch view self._kv_slot[layer_id])\n        prev = slot_np[bid_arr]\n        new_mask = prev < 0\n        n_new = int(new_mask.sum())\n        if n_new == 0:                                  # steady state: all owned\n            return prev\n        slot_blk = self._kv_slot_block[layer_id]\n        cap = len(slot_blk)\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        nb_list = bid_arr[new_mask].tolist()\n        # min-slot-first: refill freed holes (lowest slot first) before growing\n        # the high-water-mark, so the decode H2D range [0:hwm] stays compact.\n        new_slot_list = []\n        for _ in nb_list:\n            slot = -1\n            while heap:\n                cand = heapq.heappop(heap)\n                if cand in free_set:          # skip slots already folded by shrink\n                    free_set.discard(cand)\n                    slot = cand\n                    break\n            if slot < 0:\n                if hwm >= cap:\n                    # Preserve correctness under transient retired-slot\n                    # pressure by waiting for the oldest row only when the\n                    # physical pool is otherwise exhausted.\n                    self._kv_active_count[layer_id] = hwm\n                    if not self._reap_retired_kv_slots(\n                            layer_id, wait_for_one=True):\n                        raise RuntimeError(\n                            f\"P4Flat KV: persistent slot pool full for \"\n                            f\"layer={layer_id}\")\n                    hwm = self._kv_active_count[layer_id]\n                    while heap:\n                        cand = heapq.heappop(heap)\n                        if cand in free_set:\n                            free_set.discard(cand)\n                            slot = cand\n                            break\n                if slot < 0:\n                    if hwm >= cap:\n                        raise RuntimeError(\n                            f\"P4Flat KV: persistent slot pool full for \"\n                            f\"layer={layer_id} after retired-slot wait\")\n                    slot = hwm\n                    hwm += 1\n            new_slot_list.append(slot)\n        new_slots = np.asarray(new_slot_list, dtype=np.int64)\n        slot_np[bid_arr[new_mask]] = new_slots\n        out = prev.copy()\n        out[new_mask] = new_slots\n        for b, s in zip(nb_list, new_slot_list):\n            slot_blk[s] = b\n        self._kv_active_count[layer_id] = hwm\n        return out\n\n    def _release_kv_slot(self, layer_id: int, slot: int) -> None:\n        \"\"\"Return an already-detached physical slot to the reusable pool.\"\"\"\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def _detach_kv_slot(self, layer_id: int, block_id: int) -> int:\n        \"\"\"Detach canonical ownership without making the row reusable.\"\"\"\n        slot_np = self._kv_slot_np.get(layer_id)\n        if slot_np is None or not 0 <= block_id < slot_np.size:\n            return -1\n        slot = int(slot_np[block_id])\n        if slot < 0:\n            return -1\n        slot_np[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        return slot\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Metadata-only free (overrides the base dense swap-with-last).\n\n        No ``_move_host_slot`` host memcpy and no decode-stream sync: the slot\n        is just returned to the free-list and ``_kv_slot``/``_kv_slot_block``\n        cleared.  Decode filters to valid blocks and the multi-chunk path masks\n        by slot range, so a hole left in [0:hwm) is copied-but-never-read.\n        Top-of-range frees shrink hwm to bound the decode over-copy.\n        \"\"\"\n        slot = self._detach_kv_slot(layer_id, block_id)\n        if slot < 0:\n            return\n        self._release_kv_slot(layer_id, slot)\n\n    def _retire_kv_slot(self, layer_id: int, block_id: int, gate,\n                        worker_done=None) -> bool:\n        slot = self._detach_kv_slot(layer_id, block_id)\n        if slot < 0:\n            return False\n        self._retired_kv_slots[layer_id].append(\n            (slot, gate, worker_done, time.perf_counter()))\n        self._retired_kv_current += 1\n        self._retired_kv_total += 1\n        self._retired_kv_peak = max(\n            self._retired_kv_peak, self._retired_kv_current)\n        return True\n\n    def _reap_retired_kv_slots(self, layer_id: int,\n                               wait_for_one: bool = False) -> int:\n        entries = self._retired_kv_slots.get(layer_id)\n        if not entries:\n            return 0\n\n        if wait_for_one:\n            # FIFO is the least disruptive pressure fallback: CUDA stream\n            # events are submitted in retirement order, and the oldest row has\n            # waited longest. The worker Event is per-layer and may lag the GPU.\n            _, gate, worker_done, _ = entries[0]\n            gate.synchronize()\n            if worker_done is not None:\n                worker_done.wait()\n            self._retired_kv_forced_waits += 1\n\n        now = time.perf_counter()\n        keep = []\n        reaped = 0\n        for slot, gate, worker_done, retired_at in entries:\n            ready = gate.query()\n            if ready and worker_done is not None:\n                ready = worker_done.is_set()\n            if not ready:\n                keep.append((slot, gate, worker_done, retired_at))\n                continue\n            self._release_kv_slot(layer_id, slot)\n            reaped += 1\n            self._retired_kv_max_age_ms = max(\n                self._retired_kv_max_age_ms,\n                (now - retired_at) * 1e3)\n        self._retired_kv_slots[layer_id] = keep\n        self._retired_kv_current -= reaped\n        self._retired_kv_reaped += reaped\n        return reaped\n\n    def retire_persistent_block(self, layer_id: int, block_id: int,\n                                gate) -> None:\n        \"\"\"Invalidate now; reuse its physical row only after ``gate``.\"\"\"\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._retire_kv_slot(layer_id, block_id, gate)\n\n    def get_retired_kv_stats(self) -> Dict[str, Any]:\n        oldest = None\n        for entries in self._retired_kv_slots.values():\n            for _, _, _, retired_at in entries:\n                oldest = retired_at if oldest is None else min(\n                    oldest, retired_at)\n        current_age_ms = (\n            (time.perf_counter() - oldest) * 1e3\n            if oldest is not None else 0.0)\n        return {\n            \"current\": self._retired_kv_current,\n            \"peak\": self._retired_kv_peak,\n            \"total\": self._retired_kv_total,\n            \"reaped\": self._retired_kv_reaped,\n            \"forced_waits\": self._retired_kv_forced_waits,\n            \"max_age_ms\": max(\n                self._retired_kv_max_age_ms, current_age_ms),\n        }\n\n    def _valid_tm_for(self, block_ids: list) -> list:\n        \"\"\"Per-block written tile-band count (occupancy).  Returns ``ntm`` (the\n        full block) for every block when occupancy is disabled or the per-step\n        valid-token map is unavailable, which reduces to full-block compress.\"\"\"\n                return\n            state, args = item\n            try:\n                self._encode_chunk(*args)\n                state['error'] = None\n            except BaseException as exc:  # propagate through wait_compress_async\n                state['error'] = exc\n            finally:\n                state['done'].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {'done': done, 'error': None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state['done'].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for p4flat KV CPU worker\")\n        err = state.get('error')\n        if err is not None:\n            raise err\n\n    def _pin_worker_thread(self) -> None:\n        \"\"\"First task on each pool thread: pin to a disjoint core block and cap\n        its OpenMP team size (called at the top of _encode_chunk).\"\"\"\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        n = self._n_workers\n        with self._pin_lock:\n            idx = self._pin_counter[0] % n\n            self._pin_counter[0] += 1\n        # Respect an outer taskset/cgroup cpuset.  CPU IDs need not be dense, so\n        # split the actual allowed-ID list rather than constructing range(ncpu).\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            try:\n                # This ICV is local to the async worker's OpenMP task.  Keep\n                # libgomp from silently shrinking the dedicated encoder team\n                # even if the parent environment exported OMP_DYNAMIC=TRUE.\n                self._omp_lib.omp_set_dynamic(0)\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\n                    \"p4flat compress worker %d: omp_set_dynamic failed %s\",\n                    idx, _e)\n        if not self._pin_workers:\n            # Team sizing is independent of affinity pinning.  This matters\n            # when the production entry point keeps main ATen at OMP=1: an\n            # explicitly unpinned encoder must still receive its dedicated N.\n            nt = min(len(allowed), self._omp_thread_cap)\n            if self._omp_lib is not None:\n                try:\n                    self._omp_lib.omp_set_num_threads(int(nt))\n                except Exception as _e:  # noqa: BLE001\n                    logger.warning(\n                        \"p4flat compress worker %d: omp_set_num_threads \"\n                        \"failed %s\", idx, _e)\n            with self._pin_lock:\n                self._worker_affinities[idx] = tuple(allowed)\n                self._worker_omp_threads[idx] = nt\n            logger.info(\n                \"p4flat compress worker %d unpinned (%d allowed, OMP=%d)\",\n                idx, len(allowed), nt)\n            return\n        compress_cpus = [cpu for cpu in allowed\n                         if cpu >= self._reserve_cores]\n        if len(compress_cpus) < n:\n            logger.warning(\n                \"p4flat compress: only %d CPU(s) remain at/after core %d for \"\n                \"%d worker(s); falling back to the inherited affinity %s\",\n                len(compress_cpus), self._reserve_cores, n, allowed)\n            compress_cpus = allowed\n        # Limit the affinity itself to n*cap CPUs instead of letting a smaller\n        # team roam over every remaining CPU.  The default one-worker case is\n        # therefore exactly cores 8-63 on the measured 64-core host.\n        usable = compress_cpus[:min(\n            len(compress_cpus), n * self._omp_thread_cap)]\n        lo_i = len(usable) * idx // n\n        hi_i = len(usable) * (idx + 1) // n\n        block = set(usable[lo_i:hi_i])\n        if not block:\n            # Only possible with more workers than allowed CPUs.\n            block = {compress_cpus[idx % len(compress_cpus)]}\n        nt = len(block)\n        try:\n            os.sched_setaffinity(0, block)\n        except OSError as _e:\n            logger.warning(\"p4flat compress worker %d: setaffinity failed %s\",\n                           idx, _e)\n        if self._omp_lib is not None:\n            try:\n     