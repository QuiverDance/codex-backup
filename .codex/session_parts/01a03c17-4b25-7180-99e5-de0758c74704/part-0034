behaviour.\n        self._gi_dev_ring = [\n            torch.empty(5 * max_gpu_decomp_blocks, dtype=torch.int32,\n                        device='cuda') for _ in range(2)]\n        self._gu_dev_ring = [\n            torch.empty(2 * max_gpu_decomp_blocks, dtype=torch.uint8,\n                        device='cuda') for _ in range(2)]\n        self._gb_dev_ring = [\n            torch.empty(max_gpu_decomp_blocks, dtype=torch.int64,\n                        device='cuda') for _ in range(2)]\n        # slot-0 aliases retained for any non-decode reader / back-compat.\n        self._gi_dev = self._gi_dev_ring[0]\n        self._gu_dev = self._gu_dev_ring[0]\n        self._gb_dev = self._gb_dev_ring[0]\n        # Zero-copy uint8 views of the persistent-valid bytearrays (the\n        # bytearray object is allocated once here and only mutated in place,\n        # so the view stays valid for the process lifetime).\n        self._valid_t = {\n            lid: torch.from_numpy(np.frombuffer(\n                self._persistent_valid[lid], dtype=np.uint8))\n            for lid in range(n_layers)\n        }\n        self._use_cpp_prep = (\n            _p4f_ext is not None\n            and hasattr(_p4f_ext, \"decode_layer_prep\")\n            and os.getenv(\"TIERED_SERVE_KV_DECODE_CPP\", \"1\") == \"1\")\n        self._kv_pools_ready = True\n        # gpu_direct encode: prefer the single-kernel batched GPU compress\n        # (compress_batched) — per-block blobs written on device in one launch,\n        # no host scatter_fixed.  It emits the row_major_sm=1 / 0xFF-subtile\n        # format, so set the decode flag to match.  Escape hatch:\n        # TIERED_SERVE_KV_P4FLAT_GPU_LEAN=1 keeps the compress_lean path.\n        self._use_gpu_batched = (\n            self._USES_GPU_COMPRESS and _p4f_ext is not None\n            and hasattr(_p4f_ext, \"compress_batched\")\n            and os.getenv(\"TIERED_SERVE_KV_P4FLAT_GPU_LEAN\", \"0\") != \"1\")\n        if self._use_gpu_batched:\n            self._row_major_sm = 1\n            full_fixed = ((self._M_b // 64) * (self._K_b // 64) * 16\n                          + self._M_b * self._K_b // 2 + self._M_b * self._K_b\n                          + (self._M_b // 16) * (self._K_b // 16))\n            self._max_exc_pb = max(8, (self._raw_bytes - full_fixed) // 6 + 8)\n            logger.info(\"P4Flat GPU KV encoder: compress_batched (single kernel)\")\n\n        host_bytes = sum(\n            t.nbytes\n            for layer_pools in self._host_pools.values()\n            for kv_pool in layer_pools.values()\n            for t in kv_pool.values())\n        logger.info(\n            \"P4Flat KV buffers warmed up: block_shape=%s block_numel=%d \"\n            \"(M_b=%d K_b=%d) fixed=%dB raw=%dB blob_stride=%dB max_comp=%dB \"\n            \"max_n_blocks=%d max_gpu_decomp=%d n_layers=%d host=%.1fMB\",\n            block_shape, block_numel, M_b, K_b, fixed_bytes, raw_bytes,\n            blob_stride, max_comp_size, max_n_blocks, max_gpu_decomp_blocks,\n            n_layers, host_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n        trip — callers index/scatter with it directly).\"\"\"\n        # Nonblocking common case: make completed retired rows reusable before\n        # growing the high-water mark. This polls CUDA events; it never waits.\n        self._reap_retired_kv_slots(layer_id)\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_np = self._kv_slot_np[layer_id]            # authority (shared\n        # memory with the torch view self._kv_slot[layer_id])\n        prev = slot_np[bid_arr]\n        new_mask = prev < 0\n        n_new = int(new_mask.sum())\n        if n_new == 0:                                  # steady state: all owned\n            return prev\n        slot_blk = self._kv_slot_block[layer_id]\n        cap = len(slot_blk)\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        nb_list = bid_arr[new_mask].tolist()\n        # min-slot-first: refill freed holes (lowest slot first) before growing\n        # the high-water-mark, so the decode H2D range [0:hwm] stays compact.\n        new_slot_list = []\n        for _ in nb_list:\n            slot = -1\n            while heap:\n                cand = heapq.heappop(heap)\n                if cand in free_set:          # skip slots already folded by shrink\n                    free_set.discard(cand)\n                    slot = cand\n                    break\n            if slot < 0:\n                if hwm >= cap: