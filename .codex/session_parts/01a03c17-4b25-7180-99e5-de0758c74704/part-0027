{"timestamp":"2026-08-26T03:42:52.325Z","ordinal":2653,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c29-dfa5-78f3-8f12-2c2b80ddc39e","call_id":"call_0LOkJjLOBrC9fy7WgAASeyjG","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"P4Flat KV cache compressor.\n\nDrop-in ``kv_compressor`` for ``DualMemoryLoader`` that uses the BF16 P4-flat\ncodec (per-64x64-tile 16-entry exponent palette + 4-bit code + raw\nsign|mantissa byte, with out-of-palette exponents kept as an exception list).\nSelected with ``--kv-comp p4flat`` (``TIERED_SERVE_KV_COMP_BACKEND=p4flat``).\n\nLike :class:`DietGPUKVCompressor` the base :class:`P4FlatKVCompressor` is a\nGPU-kernel backend (no C++ worker threads): ``compress_batch_async`` launches\nthe compress + D2H on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.  It serves the ``gpu_direct`` KV producer mode (the default\nfor ``--kv-comp p4flat``).  The ``cpu_after_raw_swap`` producer is served by\nthe :class:`P4FlatCPUKVCompressor` subclass below (CPU worker-pool encode);\nboth share the same GPU decode kernel and on-host storage layout.\n\nIt subclasses :class:`DietGPUKVCompressor` purely to reuse the codec-agnostic\npersistent-slot bookkeeping (``_assign_kv_slot`` / ``_free_kv_slot`` /\n``has_*`` / ``free_persistent_block`` / ``decompress_batch`` chunking).  The\nstorage layout and the codec are completely different and overridden below.\n\nStorage layout (per layer, per K and V), one dense pool of variable-length\ncompressed blobs indexed by physical slot:\n  - ``blob``       : pinned [host_n, max_comp_size] uint8.  Each row holds a\n    serialised compressed block ``[headers | codes | sm | codec |\n    exc_idx | exc_val]`` (or, on raw fallback, the raw BF16 bytes).\n  - ``total_size`` : pinned [host_n] int32 — used bytes of the blob row.\n  - ``exc_cnt``    : pinned [host_n] int32 — number of exceptions.\n  - ``is_raw``     : pinned [host_n] uint8 — 0 compressed, 1 raw BF16 stored\n    in-row, 2 raw BF16 retained only in secondary KV (tight-stride overflow).\n\nA KV block of shape ``block_shape`` is flattened to ``block_numel`` BF16\nelements and reshaped to a 2-D ``[M_b, K_b]`` matrix with both dims multiples\nof 64 (p4flat requires this).  The reshape is a contiguous view, so the codec\nstays bit-exact; the (M_b, K_b) factoring only affects the compression ratio.\n``block_numel`` must therefore be a multiple of 64*64 = 4096.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ctypes\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nimport time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom typing import Any, Dict, List, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\n\nlogger = logging.getLogger(\"vllm\")  # configured/flushed handler (was __name__\n# = \"tiered_serve.*\" -> root, which suppressed INFO and split ERROR to stderr,\n# hiding [kv-decode]/MAPPING-DESYNC diagnostics from the server log file)\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:  # pragma: no cover - extension build/runtime issue\n    logger.warning(\n        \"P4FlatKVCompressor disabled: failed to load zipserv_p4flat_ext \"\n        \"(%s: %s)\", type(_e).__name__, _e)\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\ndef _align(n: int, a: int) -> int:\n    return (n + a - 1) // a * a\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Factor ``numel`` into ``(M_b, K_b)`` with both multiples of 64,\n    chosen as close to square as possible.  Raises if ``numel`` is not a\n    multiple of 4096 (= 64*64).\"\"\"\n    if numel % 4096 != 0:\n        raise ValueError(\n            f\"P4Flat KV: block_numel={numel} is not a multiple of 4096 \"\n            f\"(64*64); cannot factor into 64-aligned (M_b, K_b). Padding is \"\n            f\"not supported.\")\n    best = None\n    m = 64\n    while m * m <= numel:\n        if numel % m == 0:\n            k = numel // m\n            if k % 64 == 0:\n                best = (m, k)  # largest square-ish m wins as loop advances\n        m += 64\n    if best is None:\n        # Fall back to the most rectangular valid split (M_b=64).\n        if (numel // 64) % 64 == 0:\n            best = (64, numel // 64)\n        else:\n            raise ValueError(\n                f\"P4Flat KV: cannot factor block_numel={numel} into \"\n                f\"64-aligned (M_b, K_b).\")\n    return best\n\n\ndef _factor_64_kv(numel: int, occupancy: bool) -> Tuple[int, int]:\n    \"\"\"Factor a KV block into ``(M_b, K_b)``.\n\n    Occupancy mode (``TIERED_SERVE_KV_P4FLAT_OCCUPANCY``) lays the block out\n    *tall* — ``K_b=64`` so ``M_b=numel//64`` — instead of square.  The KV\n    block is ``[block_size, H, D]`` flattened row-major, so the token axis is\n    the outermost (slowest) dim: written tokens occupy a contiguous *prefix*\n    of rows and the unwritten tail is a contiguous suffix of all-zero rows.\n    A tall layout maximises the number of independent 64-row palette-tile\n    bands (``M_b//64``), making the all-zero suffix fall on whole skippable\n    tile bands at the finest possible granularity (``4096//H/D`` tokens/band).\n    A square factoring would instead pack ~8 tokens into one 64-row band (or\n    a single band for small blocks, ``M_b==64``), defeating partial-block\n    skipping.  Tile count — and thus palette/header overhead — is identical\n    either way (``numel//4096`` tiles), so the ratio impact is marginal.\n\n    Non-occupancy mode keeps the historical square factoring (bit-exact with\n    the validated path).\"\"\"\n    if not occupancy:\n        return _factor_64(numel)\n    if numel % 4096 != 0:\n        raise ValueError(\n            f\"P4Flat KV: block_numel={numel} is not a multiple of 4096; \"\n            f\"cannot use occupancy-aware tall layout.\")\n    return (numel // 64, 64)\n\n\nclass P4FlatKVCompressor(DietGPUKVCompressor):\n    \"\"\"BF16 P4-flat KV cache compressor (GPU-kernel backend).\"\"\"\n\n    # The GPU-encode path uses the batched-compress pinned staging; the\n    # CPU-encode subclass overrides this to skip allocating it.\n    _USES_GPU_COMPRESS = True\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_P4FLAT:\n            raise RuntimeError(\n                \"P4FlatKVCompressor requires tiered-serve's zipserv_p4flat_ext \"\n                \"extension to build successfully.\")\n        # Bypass DietGPUKVCompressor.__init__ (it loads DietGPU and allocates\n        # an ANS workspace we don't need); initialise the shared state directly.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\n        # the compute stream — used as a plain attribute, no per-call resolution.\n        self._kv_decode_on_compute = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_ON_COMPUTE\", \"0\") == \"1\"\n        # KV-load stream separation: run the compressed-blob H2D on the\n        # dedicated load_kv_stream (wired by the loader) instead of\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\n        # pipelines with layer L's decode.  load_kv_stream is gated on\n        # \"QKV weights loaded\" by the graph wrapper, so the blob H2D starts\n        # when the single copy engine is free of weight H2D — otherwise it\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\n        # loader wires one (it aliases it to load_weight_stream), and falls back\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\n        # wired (e.g. a standalone compressor with no loader).\n        self.load_kv_stream = None   # wired by the loader after construction\n        self._dec_blob_ring_idx = 0\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Set by the loader from time_breakdown.  When False, the decode skips\n        # the breakdown-only event records (_kv_h2d_begin) — the per-step CUDA\n        # event record() was ~12% of forward-thread CPU in profiling.\n        self._tb = False\n\n        # Per-decode metadata (slots / valid_rows / exc_cnt / is_raw) H2D.\n        # Default = async ring of pinned buffers, event-gated so a lagging\n        # in-flight H2D is never overwritten on reuse — the exact failure that\n        # forced the old synchronous ``torch.stack(...).cuda()`` (pageable ->\nimport sys\nimport time\nimport torch\nimport torch.nn as nn\nfrom collections import OrderedDict\nimport sysconfig\nimport gc\nimport logging\nimport os\nfrom datetime import datetime\nfrom typing import Dict, List, Optional, Tuple\n\nfrom torch.utils.cpp_extension import load\n\nfrom tiered_serve import utils\nfrom tiered_serve.cpp_exts import unload_worker_ext\nfrom tiered_serve.cpp_exts.unload_worker_ext import SyncPrimitive\nfrom vllm.model_executor.models.llama import LlamaDecoderLayer  # noqa: F401\n\n# from viztracer import log_sparse\n\nfrom tiered_serve.huge_page_allocator import allocator\nfrom tiered_serve.converged_tensor import HugeTensorType\nfrom tiered_serve.kv_cache import vLLMKVCache\n\nfrom tiered_serve.kv_offload_scheduler import KVOffloadScheduler\nfrom tiered_serve.module_block import ModuleBlock\nfrom tiered_serve.tensor_compressor import CompressedZipServTensor, SplitStorageInfo, ZipServCompressor\nfrom tiered_serve.tensor_compressor import CompressedDietGPUTensor, DietGPUCompressor\nfrom tiered_serve.tensor_compressor import (\n    CompressedDietGPUFP8Tensor, DietGPUFP8Compressor,\n    CompressedZipServFP8GpuTensor, ZipServFP8GpuCompressor,\n    CompressedP4FlatTensor, P4FlatCompressor,\n    CompressedP4D16Tensor, P4D16Compressor,\n    CompressedP3FlatFP8Tensor, P3FlatFP8Compressor,\n    _AutoWeightCompressor,\n)\nfrom tiered_serve.compression.core import (\n    CompressedUBLBFlatTensor, UBLBFlatCompressor,\n)\nfrom tiered_serve.torch_hooks import (\n    after_exec_attn,\n    after_exec_decoder,\n    after_exec_mlp_down,\n    after_exec_mlp_up_gate,\n    after_exec_o,\n    after_exec_qkv,\n    after_forward_event,\n    before_exec_attn,\n    before_exec_decoder,\n    before_exec_mlp_up_gate,\n    before_exec_mlp_down,\n    before_exec_o,\n    before_exec_qkv,\n    before_forward_event,\n)\nfrom tiered_serve.torch_model import TorchModel, OFFLOAD_MODES, FROZEN_DECOMP_MODES, COMP_KEYS\n# from tiered_serve.cpp_exts import unload_worker_ext\n\nlogger = logging.getLogger(\"vllm\")\n\n\n_CUDA_DEV = None\n\n\ndef _cuda_dev():\n    global _CUDA_DEV\n    if _CUDA_DEV is None:\n        _CUDA_DEV = torch.device(\"cuda\", torch.cuda.current_device())\n    return _CUDA_DEV\n\n\ndef _patch_torch_current_stream():\n    \"\"\"Make no-arg ``torch.cuda.current_stream()`` shallow process-wide.\n\n    With no device argument it resolves the current device via torch._utils'\n    generic ``_get_device_attr`` lambda chain (~6 frames) — and ``Event.record()``\n    with no stream calls it on every event, so on the per-step decode path\n    (~108 no-arg ``.record()`` sites + the stream contexts) this deep resolution\n    repeatedly pushes the CPython frame data-stack across its 16 KiB chunk\n    boundary.  The worker runs on one fixed GPU, so resolve the device once and\n    pass it explicitly; behaviour is identical, the resolution is shallow.\n    \"\"\"\n    cur = torch.cuda.current_stream\n    if getattr(cur, \"_ts_patched\", False):\n        return\n\n    def _fast(device=None):\n        return cur(_cuda_dev() if device is None else device)\n\n    _fast._ts_patched = True\n    torch.cuda.current_stream = _fast\n\n\n# Read once at import (constant for the process) — was re-parsed per decode step\n# inside decompress_frozen_tensors, another getenv-deep-chain churn source.\n_ENV_DEBUG_FROZEN_DECOMP = os.getenv(\"TIERED_SERVE_DEBUG_FROZEN_DECOMP\")\n# When set, the frozen_split p4flat struct-cache decodes a freshly-rebuilt\n# struct into a temp and compares it byte-for-byte against the cached-struct\n# decode each call (bit-identical guard; off by default — the cache is correct\ntest_feature_matrix_e2e.py\ntest_kv_prefill_load_policy.py\ntest_kv_tail_rollover_cuda.py\ntest_p4flat_cpu_kv_compressor.py\ntest_p4flat_weight_compression.py\ntest_prefill_weight_stream_policy.py\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03c28-7d4c-7d61-806a-b8d2d57cbadb","create_time":1787715772.3252883}}}
