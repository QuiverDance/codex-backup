{"timestamp":"2026-08-26T03:31:04.548Z","ordinal":2392,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c1f-12e4-7842-ba91-c98df8e33585","call_id":"call_Ib1PWAkIqcosVuVIe6Ai12qw","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        \"\"\"\n        Initializes the KV cache buffer with the correct size. The buffer needs\n        to be reshaped to the desired shape before being used by the models.\n\n        Args:\n            kv_cache_config: The KV cache config\n        Returns:\n            dict[str, torch.Tensor]: A map between layer names to their\n            corresponding memory buffer for KV cache.\n        \"\"\"\n        # Tiered-serve KV offloading: allocate dedicated blocks on HBM,\n        # offloadable blocks on LPDDR5 hugepages (set up later in\n        # gpu_worker._maybe_init_tiered_serve).\n        # Determine whether KV offloading is active (hugepage-backed LPDDR5).\n        offload_type = os.getenv(\"TIERED_SERVE_OFFLOAD_TYPE\", \"\")\n        kv_offload = (offload_type and \"kv\" in offload_type.lower()\n                      and os.getenv(\"TIERED_SERVE_REDUCE_KV_FOOTPRINT\",\n                                    \"0\") != \"1\"\n                      and os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\",\n                                    \"0\") != \"1\")\n\n        kv_cache_raw_tensors: dict[str, torch.Tensor] = {}\n        # For the hugepage path, compute the dedicated/offloadable\n        # split BEFORE allocating, so each per-layer raw tensor is sized for\n        # dedicated blocks only (on HBM).  The buffer + secondary are set up\n        # later in gpu_worker._maybe_init_tiered_serve.\n        num_dedicated_hbm = 0\n        num_offloadable_lpddr = 0\n        full_block_only = (\n            kv_offload\n            and os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\"\n            and os.getenv(\"TIERED_SERVE_KV_COMP_BACKEND\", \"\").lower()\n            in (\"p4flat\", \"p4flatcpu\")\n            and os.getenv(\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\"\n        )\n        # One request can own at most one partial tail. These rows are carved\n        # out of the already-budgeted per-layer dedicated HBM allocation, not\n        # added on top of it. The canonical scheduler capacity is reduced by S\n        # because the tail rows are backing storage for offloadable logical\n        # blocks rather than independently allocatable logical blocks.\n        tail_slots = self.max_num_reqs if full_block_only else 0\n        if kv_offload:\n            from tiered_serve.huge_page_allocator import (\n                allocator as hp_allocator,\n            )\n            import math as _math\n            num_blocks_total = kv_cache_config.num_blocks\n            n_kv_layers = len(kv_cache_config.kv_cache_tensors)\n            # Per-block raw bytes for one layer (from the first tensor)\n            first_tensor_size = kv_cache_config.kv_cache_tensors[0].size\n            per_block_bytes_raw = (first_tensor_size // num_blocks_total\n                                   if num_blocks_total > 0 else 0)\n\n            gpu_free, _ = torch.cuda.mem_get_info()\n            # Reserve must cover everything allocated AFTER this planner AND the\n            # runtime transients vLLM's profiling did NOT measure:\n            #   * the HBM decode buffer(s) (gpu_worker allocates these LATER —\n            #     up to ~3.6 GiB for the DOUBLE raw-KV parity buffer),\n            #   * the LARGE eager-prefill activations — vLLM profiles peak\n            #     activations at decode/captured sizes, so an 8192-token prefill\n            #     chunk's MLP intermediates (e.g. inductor's gate_up buf\n            #     N*57344*2 ≈ 0.9 GiB) + the fused-mm decomp output scratch\n            #     (~1.4 GiB) are NOT in gpu_free and must come out of here,\n            #   * CUDA graphs (~0.4-0.7 GiB), cuBLAS workspace, sampler\n            #     topk/topp sort buffers, caching-allocator fragmentation.\n            # 5 GiB was razor-thin for --fused-mm flexgen-comp at batch 128\n            # (OOM at ~1.2 GiB free on the gate_up prefill GEMM); 8 GiB gives\n            # margin.  Lower via TIERED_SERVE_GPU_RESERVE_GIB on tight-KV configs\n            # that don't run large eager prefill.\n            gpu_reserve = int(os.getenv(\n                \"TIERED_SERVE_GPU_RESERVE_GIB\", \"8\")) * (1 << 30)\n            gpu_avail = max(0, gpu_free - gpu_reserve)\n\n            # LPDDR5 capacity from hugepages\n            hp_kv_pages = hp_allocator.pages.get(\"kv\", [])\n            lpddr5_bytes = sum(\n                sum(b[\"size\"] for b in p[\"blocks\"] if b[\"free\"])\n                for p in hp_kv_pages)\n\n            if per_block_bytes_raw > 0 and n_kv_layers > 0:\n                # When KV compression is enabled, LPDDR holds BOTH raw\n                # secondary AND persistent compressed pools.  Size LPDDR\n                # constraints against pb_lpddr = pb_raw + pb_compressed\n                # (HBM constraint still uses pb_raw — GPU stores raw only).\n                per_block_bytes_lpddr = per_block_bytes_raw\n                use_kv_comp_env = (\n                    os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\")\n                if use_kv_comp_env:\n                    kv_backend = os.getenv(\n                        \"TIERED_SERVE_KV_COMP_BACKEND\",\n                        \"zipserv\").lower()\n                    # Resolve the backend's per-side compressed-pool estimator\n                    # so the LPDDR budget accounts for BOTH raw secondary and\n                    # the persistent compressed pool.  Backends not listed\n                    # (dietgpu / mantexp) have a dynamic footprint and fall\n                    # through to the conservative raw-pb-only path.  p4flatcpu\n                    # and ublb_flat/ublb_tbe share p4flat's blob-pool storage\n                    # layout (same inherited static) — all MUST be modelled or\n                    # the unbudgeted compressed pool over-offloads -> host OOM.\n                    try:\n                        _per_side_fn = None\n                        if kv_backend == \"zipserv\":\n                            from tiered_serve.tensor_compressor import (\n                                ZipServCompressor,\n                            )\n                            _per_side_fn = (\n                                ZipServCompressor\n                                .compute_per_block_compressed_bytes)\n                        elif kv_backend in (\"p4flat\", \"p4flatcpu\",\n                                            \"ublb_flat\", \"ublb_tbe\"):\n                            from tiered_serve.p4flat_kv_compressor import (\n                                P4FlatKVCompressor,\n                            )\n                            _per_side_fn = (\n                                P4FlatKVCompressor\n                                .compute_per_block_compressed_bytes)\n                        _spec = None\n                        if kv_cache_config.kv_cache_groups:\n                            _spec = (kv_cache_config.kv_cache_groups[0]\n                                     .kv_cache_spec)\n                        if _per_side_fn is not None and _spec is not None:\n                            _bs = _spec.block_size\n                            _nkv = getattr(_spec, \"num_kv_heads\", 0)\n                            _hd = getattr(_spec, \"head_size\", 0)\n                            _block_elements = _bs * _nkv * _hd\n                            if _block_elements > 0:\n                \"(HBM), offloadable=%d (buffer+LPDDR5), \"\n                \"per_block_raw=%d, per_block_lpddr=%d bytes, \"\n                \"gpu_avail=%.2f GiB, lpddr5=%.2f GiB, \"\n                \"o_max_lpddr=%d, o_max_frag=%d\",\n                num_blocks_total, num_dedicated_hbm, num_offloadable_lpddr,\n                per_block_bytes_raw, per_block_bytes_lpddr,\n                gpu_avail / 1024**3,\n                lpddr5_bytes / 1024**3,\n                o_max_lpddr if per_block_bytes_raw > 0 else 0,\n                o_max_frag if per_block_bytes_raw > 0 else 0)\n\n            if tail_slots:\n                min_general_dedicated = 16\n                if num_dedicated_hbm < tail_slots + min_general_dedicated:\n                    raise RuntimeError(\n                        \"Tiered-serve full-block KV compression needs one \"\n                        \"resident-tail HBM row per max_num_reqs plus at least \"\n                        f\"{min_general_dedicated} normal dedicated rows, but \"\n                        f\"the HBM planner produced {num_dedicated_hbm} rows \"\n                        f\"for max_num_reqs={tail_slots}. Lower --max-num-seqs \"\n                        \"or increase the KV HBM budget.\"\n                    )\n\n            # Store the split for gpu_worker. The raw tensors below retain all\n            # physical HBM rows; only the canonical scheduler boundary excludes\n            # the reserved tail rows.\n            self._ts_num_hbm_kv_rows = num_dedicated_hbm\n            self._ts_num_tail_slots = tail_slots\n            self._ts_num_dedicated_blocks = num_dedicated_hbm - tail_slots\n            self._ts_num_offloadable_blocks = num_offloadable_lpddr\n\n        for kv_cache_tensor in kv_cache_config.kv_cache_tensors:\n            if kv_offload:\n                # Hugepage: allocate only dedicated blocks on HBM.\n                # The offloadable region (buffer + LPDDR5 secondary) is\n                # set up later in gpu_worker._maybe_init_tiered_serve.\n                num_blocks_total = kv_cache_config.num_blocks\n                per_block = (kv_cache_tensor.size // num_blocks_total\n                             if num_blocks_total > 0 else 0)\n                ded_size = num_dedicated_hbm * per_block\n                tensor = torch.zeros(\n                    ded_size, dtype=torch.int8, device=self.device)\n            else:\n                tensor = torch.zeros(\n                    kv_cache_tensor.size, dtype=torch.int8, device=self.device\n                )\n            for layer_name in kv_cache_tensor.shared_by:\n                kv_cache_raw_tensors[layer_name] = tensor\n\n        layer_names = set()\n        for group in kv_cache_config.kv_cache_groups:\n            for layer_name in group.layer_names:\n                if layer_name in self.runner_only_attn_layers:\n                    continue\n                layer_names.add(layer_name)\n        assert layer_names == set(kv_cache_raw_tensors.keys()), (\n            \"Some layers are not correctly initialized\"\n        )\n        # If an explicit (lower) dedicated request shrank the usable split\n        # below the profiled budget, reduce num_blocks so the scheduler /\n        # gpu_worker use only dedicated+offloadable; the leftover blocks stay\n        # unallocated (empty HBM/LPDDR).  Done AFTER the tensor loop so the\n        # per-block sizing above used the original (profiled) num_blocks.\n        if kv_offload:\n            _usable = (\n                num_dedicated_hbm - tail_slots + num_offloadable_lpddr\n            )\n            if 0 < _usable < kv_cache_config.num_blocks:\n                logger.info(\n                    \"Tiered-serve: dedicated request shrank usable blocks \"\n                    \"%d -> %d (D=%d + tail=%d + O=%d physical; \"\n                    \"tail rows are not scheduler blocks); %d blocks left \"\n                    \"unallocated\",\n                    kv_cache_config.num_blocks, _usable,\n                    num_dedicated_hbm - tail_slots, tail_slots,\n                    num_offloadable_lpddr,\n                    kv_cache_config.num_blocks - _usable)\n                kv_cache_config.num_blocks = _usable\n        return kv_cache_raw_tensors\n\n    def _attn_group_iterator(self) -> Iterator[Attent