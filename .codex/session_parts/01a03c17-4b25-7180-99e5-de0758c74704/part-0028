     \"\"\"Invalidate now; reuse its physical row only after ``gate``.\"\"\"\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._retire_kv_slot(layer_id, block_id, gate)\n\n    def get_retired_kv_stats(self) -> Dict[str, Any]:\n        oldest = None\n        for entries in self._retired_kv_slots.values():\n            for _, _, _, retired_at in entries:\n                oldest = retired_at if oldest is None else min(\n                    oldest, retired_at)\n        current_age_ms = (\n            (time.perf_counter() - oldest) * 1e3\n            if oldest is not None else 0.0)\n        return {\n            \"current\": self._retired_kv_current,\n            \"peak\": self._retired_kv_peak,\n            \"total\": self._retired_kv_total,\n            \"reaped\": self._retired_kv_reaped,\n            \"forced_waits\": self._retired_kv_forced_waits,\n            \"max_age_ms\": max(\n                self._retired_kv_max_age_ms, current_age_ms),\n        }\n\n    def _valid_tm_for(self, block_ids: list) -> list:\n        \"\"\"Per-block written tile-band count (occupancy).  Returns ``ntm`` (the\n        full block) for every block when occupancy is disabled or the per-step\n        valid-token map is unavailable, which reduces to full-block compress.\"\"\"\n                return\n            state, args = item\n            try:\n                self._encode_chunk(*args)\n                state['error'] = None\n            except BaseException as exc:  # propagate through wait_compress_async\n                state['error'] = exc\n            finally:\n                state['done'].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {'done': done, 'error': None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state['done'].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for p4flat KV CPU worker\")\n        err = state.get('error')\n        if err is not None:\n            raise err\n\n    def _pin_worker_thread(self) -> None:\n        \"\"\"First task on each pool thread: pin to a disjoint core block and cap\n        its OpenMP team size (called at the top of _encode_chunk).\"\"\"\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        n = self._n_workers\n        with self._pin_lock:\n            idx = self._pin_counter[0] % n\n            self._pin_counter[0] += 1\n        # Respect an outer taskset/cgroup cpuset.  CPU IDs need not be dense, so\n        # split the actual allowed-ID list rather than constructing range(ncpu).\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            try:\n                # This ICV is local to the async worker's OpenMP task.  Keep\n                # libgomp from silently shrinking the dedicated encoder team\n                # even if the parent environment exported OMP_DYNAMIC=TRUE.\n                self._omp_lib.omp_set_dynamic(0)\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\n                    \"p4flat compress worker %d: omp_set_dynamic failed %s\",\n                    idx, _e)\n        if not self._pin_workers:\n            # Team sizing is independent of affinity pinning.  This matters\n            # when the production entry point keeps main ATen at OMP=1: an\n            # explicitly unpinned encoder must still receive its dedicated N.\n            nt = min(len(allowed), self._