{"timestamp":"2026-08-26T03:41:51.040Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c28-f040-7712-a1cc-a73f5b78b08c","call_id":"call_Qgi2yyfJ3DLcWvIG9DaMHibh","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import torch\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\nimport time as _time\n\n\n_ENV_KV_DRAIN_OFFLOAD = os.getenv(\"TIERED_SERVE_KV_DRAIN_OFFLOAD\", \"0\")\n_ENV_KV_CPU_PROFILE = os.getenv(\"TIERED_SERVE_KV_CPU_PROFILE\", \"0\") == \"1\"\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\nclass KVMixin:\n\n    @classmethod\n    def record_tail_write(cls, write) -> None:\n        \"\"\"Record one canonical scheduler block occupancy transition.\n\n        EngineCore calls this before the worker prepares its input table.  The\n        feature-disabled path is an intentional no-op so the legacy unload\n        callback can share the same metadata contract.\n        \"\"\"\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is None:\n            raise RuntimeError(\n                \"full-block KV write arrived before tail residency setup\")\n        manager.record_write(\n            request_id=write.request_id,\n            block_id=write.block_id,\n            block_index=write.block_index,\n            pre_valid=write.pre_valid,\n            post_valid=write.post_valid,\n            block_size=write.block_size,\n        )\n\n    @classmethod\n    def free_tail_block(cls, block_id: int) -> None:\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is not None:\n            manager.free_block(block_id)\n\n    def configure_tail_residency(\n        self,\n        canonical_dedicated: int,\n        tail_slots: int,\n        physical_buffer_offset: int,\n    ) -> None:\n        \"\"\"Install the fixed request-tail pool after KV tensors are allocated.\"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        if tail_slots != self.batch_size:\n            raise RuntimeError(\n                \"tail_slots must equal max_num_reqs: \"\n                f\"slots={tail_slots}, max_num_reqs={self.batch_size}\")\n        if physical_buffer_offset != canonical_dedicated + tail_slots:\n            raise RuntimeError(\n                \"invalid tail physical namespace: \"\n                f\"offset={physical_buffer_offset}, D={canonical_dedicated}, \"\n                f\"S={tail_slots}\")\n        from tiered_serve.kv_tail_residency import KVTailResidencyManager\n\n        manager = KVTailResidencyManager(\n            max_num_reqs=tail_slots, block_size=16)\n        DualMemoryLoader.tail_manager = manager\n        self.tail_manager = manager\n        self.num_tail_slots = int(tail_slots)\n        self.kv_physical_block_offset = int(physical_buffer_offset)\n        self.tail_step_plan = None\n        self.tail_rollover_local_ids = []\n        self.tail_rollover_slots = []\n        self.tail_resident_local_ids = []\n        self.tail_completed_local_ids = []\n        self.tail_lp_skip_local_ids = []\n        self._tail_steps = 0\n        self._tail_resident_block_steps = 0\n        self._tail_completed_full_blocks = 0\n        self._tail_rollover_blocks = 0\n        self._tail_rollover_d2d_l0_blocks = 0\n        self._tail_verified_full_unload_blocks = 0\n        self._tail_partial_d2h_blocks = 0\n        self._tail_logged_first_rollover_plan = False\n        self._tail_logged_first_rollover_d2d = False\n        self._tail_logged_first_rollover_unload = False\n        logger.info(\n            \"[kv-full-block] tail residency configured: max_num_reqs=%d \"\n            \"D=%d S=%d physical_buffer_offset=%d\",\n            self.batch_size, canonical_dedicated, tail_slots,\n            physical_buffer_offset)\n\n    def prepare_tail_step(self, input_batch) -> None:\n        \"\"\"Apply this step's resident routes to the worker CPU block table.\n\n        The table permanently stores physical ids. New canonical offloadable\n        ids are shifted by BlockTable.append_row(); here we only patch the\n        current request tail to D+slot and restore a completing block to its\n        normal shared-buffer route b+S.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        manager = self.tail_manager\n        plan = manager.snapshot_plan()\n        self.tail_step_plan = plan\n\n        table = input_batch.block_table[0]\n        table_np = table.block_table.np\n        d = int(self.num_dedicated_blocks)\n        s = int(self.num_tail_slots)\n        from tiered_serve.kv_tail_residency import (\n            apply_plan_to_physical_block_table,\n            lp_load_skip_local_ids,\n        )\n        apply_plan_to_physical_block_table(\n            plan,\n            table_np,\n            input_batch.req_id_to_index,\n            canonical_dedicated=d,\n            tail_slots=s,\n        )\n\n        # Canonical offload ids become primary/secondary-local by subtracting\n        # D. Rollover source rows are physical tail rows D+slot.\n        self.tail_rollover_local_ids = [\n            rollover.old_block_id - d for rollover in plan.rollovers\n        ]\n        self.tail_rollover_slots = [\n            rollover.slot for rollover in plan.rollovers\n        ]\n        self.tail_resident_local_ids = sorted(\n            block_id - d for block_id in plan.resident_after)\n        self.tail_completed_local_ids = sorted(\n            block_id - d for block_id in plan.completed_full_ids)\n        # Every offloadable block completed by this step is either:\n        #   * a fresh block (pre_valid=0), overwritten in all 16 positions; or\n        #   * a resident rollover, whose prefix is staged tail->shared.\n        # Neither has prior LP data to load. Post-step partials stay in their\n        # request-private tail rows, so they are excluded for the same reason.\n        self.tail_lp_skip_local_ids = list(\n            lp_load_skip_local_ids(plan, d))\n        self._tail_steps += 1\n        self._tail_resident_block_steps += len(plan.resident_after)\n        self._tail_completed_full_blocks += len(plan.completed_full_ids)\n        self._tail_rollover_blocks += len(plan.rollovers)\n        if (\n            plan.rollovers\n            and not self._tail_logged_first_rollover_plan\n        ):\n            self._tail_logged_first_rollover_plan = True\n            logger.info(\n                \"[kv-full-block] first rollover planned: step=%d \"\n                \"rollovers=%d completed=%d resident_after=%d\",\n                self._tail_steps, len(plan.rollovers),\n                len(plan.completed_full_ids), len(plan.resident_after))\n\n    def _stage_tail_rollovers(\n        self,\n        layer_id: int,\n        stream: torch.cuda.Stream,\n    ) -> bool:\n        \"\"\"Copy completing partial prefixes from tail HBM to shared primary.\n\n        The completing block is routed to the normal shared buffer for the\n        current forward, while a new partial (if any) may reuse the same tail\n        slot. Copying the complete row is safe: attention overwrites every\n        position from pre_valid through token 16 before the block is unloaded.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return False\n        dst_ids = self.tail_rollover_local_ids\n        if not dst_ids:\n            return False\n\n        _np = DualMemoryLoader.kv_decode_n_parity or 1\n        stream.wait_event(\n            self.kv_unload_done[(layer_id - max(1, _np)) % self.n_layers])\n\n        d = int(self.num_dedicated_blocks)\n        src_ids = [d + slot for slot in self.tail_rollover_slots]\n        from tiered_serve.kv_cache import _get_zipserv\n        _get_zipserv().batch_kv_memcpy_indexed(\n            DualMemoryLoader.primary_k_caches[layer_id],\n            DualMemoryLoader.primary_v_caches[layer_id],\n            DualMemoryLoader.tail_k_caches[layer_id],\n            DualMemoryLoader.tail_v_caches[layer_id],\n            dst_ids,\n            src_ids,\n            stream.cuda_stream,\n        )\n        if layer_id == 0:\n            self._tail_rollover_d2d_l0_blocks += len(dst_ids)\n            if not self._tail_logged_first_rollover_d2d:\n                self._tail_logged_first_rollover_d2d = True\n                logger.info(\n                    \"[kv-full-block] first rollover D2D submitted: \"\n                    \"step=%d blocks=%d\",\n                    self._tail_steps, len(dst_ids))\n        return True\n\n    @classmethod\n    def _init_kv_caches(cls, n_layers: int):\n        cls.kv_caches = [vLLMKVCache(idx) for idx in range(n_layers)]\n\n    @classmethod\n    def append_unload_target(cls, blk_id: int):\n        cls.unload_targets.add(blk_id)\n\n    @classmethod\n    def clear_unload_targets(cls):\n        cls.unload_targets.clear()\n\n    def _uses_compressed_kv_load(self, layer_id: int) -> bool:\n        \"\"\"Whether this layer reconstructs active KV from compressed storage.\n\n        Prefill traditionally forced the raw secondary cache. The opt-in\n        mixed-prefill path instead passes the whole active set to the\n        compressor, whose persistent-valid filter reconstructs only historical\n        blocks; fresh prompt blocks are left untouched until the current\n        attention writes them.\n        \"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and layer_id in self.kv_comp_targets\n            and self.kv_decode_load_backend == \"compressed\"\n            and (\n                not self.batch_has_prefill\n                or self.kv_comp_prefill_load\n            )\n        )\n\n    def _prefill_uses_dedicated_raw_kv_stream(self) -> bool:\n        \"\"\"Whether this prefill step has any raw-secondary KV layer.\"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and self.batch_has_prefill\n            and (\n                not self.kv_comp_prefill_load\n                or self.kv_decode_load_backend != \"compressed\"\n                or len(self.kv_comp_targets) != self.n_layers\n            )\n        )\n\n    def _kv_load_stream_for(self, layer_id: int):\n        \"\"\"Return the stream that actually materializes this layer's KV.\n\n        KVCOMP decode may intentionally put compressed-blob H2D on the weight\n        stream. A prefill-bearing batch uses raw secondary KV by default and\n        carries a same-parity unload dependency; keep that dependency on the\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int):\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        # Clean up persistent compressed KV metadata\n        if cls.use_kv_comp and hasattr(cls, '_kv_compressor_ref') and cls._kv_compressor_ref is not None:\n            kc = cls._kv_compressor_ref\n            # free_persistent_block compacts the persistent pool via a\n            # swap-with-last that CPU-memcpys host-pool slots (_move_host_slot).\n            # Drain the decode stream first so an in-flight decode H2D isn't\n            # reading those host-pool rows while the compaction moves them\n            # (torn read -> corrupt blob -> decode OOB).  Cheap: by free time the\n            # prior step's decode is essentially done.\n            # NOTE: the serve IMA root cause was the valid/slot desync (fixed in\n            # wait_compress_async).  The previous per-free compress-WORKER join\n            # was removed — it drained the whole single-worker compress backlog\n            # (big per-free latency) and isn't needed for correctness now.\n            # load_kv_stream is drained too: under the KV-H2D split the staging\n            # blob H2D (which READS the host pool) runs there, not on\n            # batch_decomp_stream — without this the compaction races the in-\n            # flight staging copy (torn read -> IMA, seen at larger batches\n            # where frees are frequent).\n            for _s in (getattr(kc, 'batch_decomp_stream', None),\n                       getattr(kc, 'load_kv_stream', None),\n                       getattr(kc, 'comp_stream', None)):\n                if _s is not None:\n                    _s.synchronize()\n            for layer_id in range(n_layers):\n                kc.free_persistent_block(layer_id, block_id)\n\n    # @log_sparse(stack_depth=5)\n    def load_kv(self, layer_id: int, force=False, non_blocking=True):\n\n        def get_ptr_tensor(tensor_list):\n            \"\"\"\n            텐서 리스트로부터 각 텐서의 데이터 포인터를 담은 텐서를 생성합니다.\n            \"\"\"\n            return torch.tensor([t.data_ptr() for t in tensor_list],\n                                dtype=torch.int64,\n                                device=tensor_list[0].device)\n\n        if self.is_graph_warming_up:\n            return\n\n        load_kv_stream = self._kv_load_stream_for(layer_id)\n\n        if DualMemoryLoader.use_kv_comp:\n            kv_sys = DualMemoryLoader.kv_offload_system\n\n            # Legacy prefill route: raw secondary KV. The benchmark's opt-in\n     