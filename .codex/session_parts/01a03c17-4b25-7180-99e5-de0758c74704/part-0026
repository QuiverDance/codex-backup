s opt-in\n            # compressed-prefill mode falls through to the persistent decode\n            # branch below and filters fresh prompt blocks by validity.\n            if (\n                self.batch_has_prefill\n                and not self.kv_comp_prefill_load\n            ):\n                # 1. Waits for previous KV unloading complete\n\n                # 2. Load from Uncomped KV\n                # torch.cuda.nvtx.mark(\n                #     f\"BEGIN load_kv().load_uncompressed() Prefill LayerID: {layer_id} n_buffer_ids: {len(self.np_active_kv_buffer_ids)}\"\n                # )\n                self.begin_memcpy_kv_events[layer_id].record(\n                    load_kv_stream)\n                DualMemoryLoader.kv_offload_scheduler.schedule_load_uncompressed(\n                    kv_sys, layer_id, self.active_kv_buffer_ids,\n                    self.kv_load_done[layer_id].cuda_event,\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\nfrom tiered_serve.dual_memory_loader.init import InitMixin\nfrom tiered_serve.dual_memory_loader.frozen_split import FrozenSplitMixin\nfrom tiered_serve.dual_memory_loader.compressor import CompressorMixin\nfrom tiered_serve.dual_memory_loader.fused_mm import FusedMMMixin\nfrom tiered_serve.dual_memory_loader.weights import WeightLoadMixin\nfrom tiered_serve.dual_memory_loader.kv import KVMixin\nfrom tiered_serve.dual_memory_loader.timing import TimingMixin\n\n\nvmm_allocator_ext = load(\n    name=\"vmm_allocator\",\n    sources=[\n        \"etc/vmm_allocator/vmm_allocator.cpp\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\",\n        \"-O3\",\n        \"-std=gnu++17\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        \"-L/usr/lib/aarch64-linux-gnu\",\n        \"-lcuda\",\n    ],\n)\n\n\nclass DualMemoryLoader(\n    InitMixin,\n    FrozenSplitMixin,\n    CompressorMixin,\n    FusedMMMixin,\n    WeightLoadMixin,\n    KVMixin,\n    TimingMixin,\n):\n    # batch_has_prefill: True whenever the current batch contains ANY prefill\n    # chunk (attn_metadata.max_query_len > 1), independent of cudagraph mode.\n    # Single source of truth for every prefill-vs-decode decision (weight\n    # path, KV path, breakdown labels).  True even for a prefill chunk that\n    # runs under a PIECEWISE graph (which a cudagraph-mode check would miss).\n    batch_has_prefill = False\n    # Current batch's total token count (1 for a single-token decode step).\n    # Set per-forward in torch_hooks.before_model_forward alongside\n    # batch_has_prefill; used to pick the prefill weight codec (large batches\n    # amortise raw_bf16's H2D, small batches prefer a compressed fast-decode\n    # codec).\n    cur_num_tokens = 1\n    # ran_eager: did the last forward run eager (no CUDA graph)?  Used only\n    # for timing-event stream selection in torch_hooks; NOT a prefill signal.\n    ran_eager = False\n    is_profiling = False\n\n    is_graph_capturing = False\n    is_graph_warming_up = False\n\n    kv_caches = []\n    unload_targets: set = set()\n    num_dedicated_blocks = None\n    # P4Flat full-block-only mode: each active request owns one physical HBM\n    # tail row until its 16-token block completes.\n    kv_full_block_only = False\n    num_tail_slots = 0\n    kv_physical_block_offset = None\n    tail_manager = None\n    tail_k_caches = None\n    tail_v_caches = None\n    no_offload_kv = False\n    # Opt-in mixed/prefill route: reconstruct historical offloaded blocks from\n    # the persistent compressed store. Fresh prompt blocks have no persistent\n    # slot and are filtered by the compressor before attention writes them.\n    # Resolved once during loader setup; never read from os.environ per layer.\n    kv_comp_prefill_load = False\n    # Number of parity slots in the HBM decode buffer (set by gpu_worker):\n    # 1 = single shared buffer (legacy), 2 = double-buffer ping-pong by layer\n    # parity.  ==2