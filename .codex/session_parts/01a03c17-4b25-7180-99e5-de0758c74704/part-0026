{"timestamp":"2026-08-26T03:42:04.401Z","ordinal":2637,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c29-2471-70a2-add4-629ade2299a9","call_id":"call_s8NG9UcTVAFfI1zjdoXI2DbO","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n                'cd': torch.empty(max_gpu_blocks * cdb, dtype=torch.uint8).pin_memory(),\n                # Device exception count, D2H'd with the payload (compress_lean\n                # returns it on-device so the call stays sync-free).\n                'ec': torch.empty(1, dtype=torch.int32).pin_memory(),\n            }\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            specs = {\n                'blob':       ((host_n, blob_stride), torch.uint8),\n                'total_size': ((host_n,),               torch.int32),\n                'exc_cnt':    ((host_n,),               torch.int32),\n                'is_raw':     ((host_n,),               torch.uint8),\n                # Occupancy: number of decoded rows for this slot (== M_b for a\n                # full block).  Read by decode to size comp.M / the raw view.\n                'valid_rows': ((host_n,),               torch.int32),\n            }\n            pool = {}\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(*shape, dtype=dtype,\n                                    device='cpu').pin_memory()\n                pool[name] = t\n            # Default to full-height decode; partial encodes overwrite per slot.\n            pool['valid_rows'].fill_(M_b)\n            # Zero the meta so an un-encoded / not-yet-written slot reads as a\n            # bounded empty block instead of torch.empty garbage.  The decode\n            # sizes the exception patch-kernel grid from int(exc_cnt[slots].max())\n            # and the blob length from total_size; garbage there → out-of-bounds\n            # grid → cudaErrorIllegalAddress (manifested on the slower CPU-encode\n            # path which can race the decode of a freshly-(re)assigned slot).\n            pool['exc_cnt'].zero_()\n            pool['is_raw'].zero_()\n            pool['total_size'].zero_()\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            self._host_pools = pre_allocated_host_pools\n            # Externally-sized pools predate the occupancy field — add a\n            # full-height ``valid_rows`` mirror where missing so decode/encode\n            # can read it uniformly.\n            for layer_pools in self._host_pools.values():\n                for kv_pool in layer_pools.values():\n                    if 'valid_rows' not in kv_pool:\n                        vr = torch.empty(host_n, dtype=torch.int32,\n                                         device='cpu').pin_memory()\n                        vr.fill_(M_b)\n                        kv_pool['valid_rows'] = vr\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging blob pools for decode H2D — SEPARATE K and V buffers so\n        # both host-pool reads issue back-to-back and a per-layer event marks\n        # \"host['blob'] fully read\".  The CPU-encode unload WORKER waits on that\n        # event (wait-based, on its own thread) before overwriting the slots, so\n        # the main thread is NOT host-synchronized and per-layer decodes pipeline\n        # (prefetch overlaps compute).  Double-buffering is GPU-HBM only.\n        self._gpu_dec_blob = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        self._gpu_dec_blob_v = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        # 2-slot blob ring for the load_kv_stream split (slot 0 reuses the\n        # buffers above; slot 1 is the extra double-buffer).  The H2D writes a\n        # slot on load_kv_stream and the decode reads it on batch_decomp_stream;\n        # the per-slot ``consumed`` event gates the NEXT reuse so the two\n        # streams overlap (H2D L+1 ∥ decode L) without racing the staging blob.\n        self._dec_blob_ring = [\n            self._gpu_dec_blob,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_v_ring = [\n            self._gpu_dec_blob_v,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for _e in self._dec_blob_consumed:\n            _e.record()\n        # Per-layer \"decode H2D of host['blob'] complete\" events — external=True\n        # so the C++ worker can wait on .cuda_event, enable_timing=True so the\n        # breakdown can elapsed_time() them.  Paired with _kv_h2d_begin (right\n        # before the blob H2D) to isolate the compressed-KV H2D from decode.\n        self._kv_dec_h2d = [torch.cuda.Event(enable_timing=True, external=True)\n                            for _ in range(n_layers)]\n        self._kv_h2d_begin = [torch.cuda.Event(enable_timing=True,\n                                               external=True)\n                              for _ in range(n_layers)]\n        # Tight decode-kernel begin.  _kv_dec_h2d is recorded on the H2D\n        # producer stream, so elapsed_time(_kv_dec_h2d, decode_end) also\n        # includes any older work / WAR wait already queued on\n        # batch_decomp_stream.  Record on the consumer stream after those waits\n        # and immediately before the codec kernels to measure KVDecomp itself.\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Pre-record once so elapsed_time() on a layer that doesn't decode this\n        # step sees a (stale, pre-init) recording instead of raising.\n        for _e in self._kv_dec_h2d:\n            _e.record()\n        for _e in self._kv_h2d_begin:\n            _e.record()\n        for _e in self._kv_decode_begin:\n            _e.record()\n\n        # Async metadata-staging ring (see __init__).  Each decode chunk gathers\n        # its per-block meta into one ring slot's pinned buffers (contiguous\n        # prefixes -> one valid async H2D per group, no stack, no pageable temp)\n        # and records an event; reusing a slot first waits on that event, so the\n        # CPU never overwrites a buffer whose H2D is still in flight (the\n        # documented torn-meta IMA).  ``cap`` = the GPU decomp staging width, so\n        # a chunk's meta count never exceeds it.  R slots absorb the\n        # CPU-races-ahead window without actually blocking; event-gating keeps it\n        # correct for any lag.\n        if not self._meta_sync_fallback:\n            cap = max_gpu_decomp_blocks\n            R = int(os.getenv(\"TIERED_SERVE_META_RING_N\", \"16\"))\n            self._meta_ring_n = R\n            self._meta_ring_pi = [\n                torch.empty(5 * cap, dtype=torch.int32).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_pu = [\n                torch.empty(2 * cap, dtype=torch.uint8).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_b = [\n                torch.empty(cap, dtype=torch.int64).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_ev = [torch.cuda.Event() for _ in range(R)]\n            for _e in self._meta_ring_ev:\n                _e.record()\n            self._meta_ring_idx = 0\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._secondary_fallback_possible = {\n            lid: False for lid in range(n_layers)}\n        # int64 so a decode gather yields index_select-ready indices with no\n        # per-layer .long() cast (the int32 saved nothing — values are slots).\n        # The numpy array is the AUTHORITY and the torch tensor is a\n        # zero-copy ``from_numpy`` view of the SAME memory: the per-step\n        # assign path (compress submit) runs in numpy (~5 µs vs ~26 µs for\n        # the equivalent five torch CPU ops), while the decode path keeps\n        # gathering through the torch view unchanged.\n        self._kv_slot_np = {\n            lid: np.full(host_n, -1, dtype=np.int64)\n            for lid in range(n_layers)\n        }\n        self._kv_slot = {\n            lid: torch.from_numpy(self._kv_slot_np[lid])\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {lid: [-1] * host_n for lid in range(n_layers)}\n        self._kv_active_count = {lid: 0 for lid in range(n_layers)}  # hwm\n        self._kv_free_heap = {lid: [] for lid in range(n_layers)}\n        self._kv_free_slots = {lid: set() for lid in range(n_layers)}\n        # Decode fast-path pre-binding: the per-layer hot references are\n        # resolved ONCE here so the per-layer decode does a single tuple\n        # unpack instead of ~15 dict/attr lookups (every statement on the\n        # forward thread is GPU-idle gap).\n        self._dec_cap = max_gpu_decomp_blocks\n        # (row_major_sm is NOT baked in: gpu_direct warmup may flip it after\n        # this point — the fast path reads the attribute per call.)\n        self._fast_const = (blob_stride, block_numel, K_b, M_b,\n                            (blob_stride - fixed_bytes) // 6)\n        self._dec_fast = {}\n        for lid in range(n_layers):\n            hk = self._host_pools[lid]['k']\n            hv = self._host_pools[lid]['v']\n            self._dec_fast[lid] = (\n                self._kv_slot[lid], hk['blob'], hv['blob'],\n                hk['valid_rows'], hk['exc_cnt'], hk['is_raw'],\n                hv['valid_rows'], hv['exc_cnt'], hv['is_raw'])\n        # C++ decode prep (decode_layer_prep): one ext call replaces the\n        # per-layer Python staging (valid filter + slot/meta gather + meta &\n        # blob H2D + event records); only the two codec kernels stay in Python.\n        #\n        # DEVICE meta buffers are 2-slot RINGED, in lockstep with the blob ring\n        # (``_dec_blob_ring``), and indexed by the SAME ``slot``.  This is\n        # REQUIRED for the load_kv_stream split: there the meta H2D runs on\n        # load_kv_stream while the decode kernel reads the meta on\n        # batch_decomp_stream, so a SINGLE persistent meta buffer would be\n        # overwritten by layer L+1's H2D while layer L's decode still reads it\n        # (an async IMA seen only at high batch / serve concurrency, where the\n        # longer decode lets the next H2D overtake it).  The blob was already\n        # double-buffered + gated by ``_dec_blob_consumed[slot]``; the meta now\n        # rides the SAME slot + consumed gate, so both are protected.  Non-split\n        # always uses slot 0 (everything on batch_decomp_stream → stream order\n        # serialises → safe), so slot-0 == the old single-buffer behaviour.\n        self._gi_dev_ring = [\n            torch.empty(5 * max_gpu_decomp_blocks, dtype=torch.int32,\n                        device='cuda') for _ in range(2)]\n        self._gu_dev_ring = [\n            torch.empty(2 * max_gpu_decomp_blocks, dtype=torch.uint8,\n                        device='cuda') for _ in range(2)]\n        self._gb_dev_ring = [\n            torch.empty(max_gpu_decomp_blocks, dtype=torch.int64,\n                        device='cuda') for _ in range(2)]\n        # slot-0 aliases retained for any non-decode reader / back-compat.\n        self._gi_dev = self._gi_dev_ring[0]\n        self._gu_dev = self._gu_dev_ring[0]\n        self._gb_dev = self._gb_dev_ring[0]\n        # Zero-copy uint8 views of the persistent-valid bytearrays (the\n        # bytearray object is allocated once here and only mutated in place,\n        # so the view stays valid for the process lifetime).\n        self._valid_t = {\n            lid: torch.from_numpy(np.frombuffer(\n                self._persistent_valid[lid], dtype=np.uint8))\n            for lid in range(n_layers)\n        }\n        self._use_cpp_prep = (\n            _p4f_ext is not None\n            and hasattr(_p4f_ext, \"decode_layer_prep\")\n            and os.getenv(\"TIERED_SERVE_KV_DECODE_CPP\", \"1\") == \"1\")\n        self._kv_pools_ready = True\n        # gpu_direct encode: prefer the single-kernel batched GPU compress\n        # (compress_batched) — per-block blobs written on device in one launch,\n        # no host scatter_fixed.  It emits the row_major_sm=1 / 0xFF-subtile\n        # format, so set the decode flag to match.  Escape hatch:\n        # TIERED_SERVE_KV_P4FLAT_GPU_LEAN=1 keeps the compress_lean path.\n        self._use_gpu_batched = (\n            self._USES_GPU_COMPRESS and _p4f_ext is not None\n            and hasattr(_p4f_ext, \"compress_batched\")\n            and os.getenv(\"TIERED_SERVE_KV_P4FLAT_GPU_LEAN\", \"0\") != \"1\")\n        if self._use_gpu_batched:\n            self._row_major_sm = 1\n            full_fixed = ((self._M_b // 64) * (self._K_b // 64) * 16\n                          + self._M_b * self._K_b // 2 + self._M_b * self._K_b\n                          + (self._M_b // 16) * (self._K_b // 16))\n            self._max_exc_pb = max(8, (self._raw_bytes - full_fixed) // 6 + 8)\n            logger.info(\"P4Flat GPU KV encoder: compress_batched (single kernel)\")\n\n        host_bytes = sum(\n            t.nbytes\n            for layer_pools in self._host_pools.values()\n            for kv_pool in layer_pools.values()\n            for t in kv_pool.values())\n        logger.info(\n            \"P4Flat KV buffers warmed up: block_shape=%s block_numel=%d \"\n            \"(M_b=%d K_b=%d) fixed=%dB raw=%dB blob_stride=%dB max_comp=%dB \"\n            \"max_n_blocks=%d max_gpu_decomp=%d n_layers=%d host=%.1fMB\",\n            block_shape, block_numel, M_b, K_b, fixed_bytes, raw_bytes,\n            blob_stride, max_comp_size, max_n_blocks, max_gpu_decomp_blocks,\n            n_layers, host_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n        trip — callers index/scatter with it directly).\"\"\"\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_np = self._kv_slot_np[layer_id]            # authority (shared\n        # memory with the torch view self._kv_slot[layer_id])\n        prev = slot_np[bid_arr]\n        new_mask = prev < 0\n        n_new = int(new_mask.sum())\n        if n_new == 0:                                  # steady state: all owned\n            return prev\n        slot_blk = self._kv_slot_block[layer_id]\n        cap = len(slot_blk)\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        nb_list = bid_arr[new_mask].tolist()\n        # min-slot-first: refill freed holes (lowest slot first) before growing\n        # the high-water-mark, so the decode H2D range [0:hwm] stays compact.\n        new_slot_list = []\n        for _ in nb_list:\n            slot = -1\n            while heap:\n                cand = heapq.heappop(heap)\n                if cand in free_set:          # skip slots already folded by shrink\n                    free_set.discard(cand)\n                    slot = cand\n                    break\n            if slot < 0:\n                if hwm >= cap:\n                    raise RuntimeError(\n                        f\"P4Flat KV: persistent slot pool full for \"\n                        f\"layer={layer_id}\")\n                slot = hwm\n                hwm += 1\n            new_slot_list.append(slot)\n        new_slots = np.asarray(new_slot_list, dtype=np.int64)\n        slot_np[bid_arr[new_mask]] = new_slots\n        out = prev.copy()\n        out[new_mask] = new_slots\n        for b, s in zip(nb_list, new_slot_list):\n            slot_blk[s] = b\n        self._kv_active_count[layer_id] = hwm\n        return out\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Metadata-only free (overrides the base dense swap-with-last).\n\n        No ``_move_host_slot`` host memcpy and no decode-stream sync: the slot\n        is just returned to the free-list and ``_kv_slot``/``_kv_slot_block``\n        cleared.  Decode filters to valid blocks and the multi-chunk path masks\n        by slot range, so a hole left in [0:hwm) is copied-but-never-read.\n        Top-of-range frees shrink hwm to bound the decode over-copy.\n        \"\"\"\n        slot_np = self._kv_slot_np.get(layer_id)\n        if slot_np is None or not 0 <= block_id < slot_np.size:\n            return\n        slot = int(slot_np[block_id])\n        if slot < 0:\n            return\n        slot_np[block_id] = -1      # shared memory with the torch view\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            # Freed the top slot: shrink hwm past it and any trailing holes.\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def _valid_tm_for(self, block_ids: list) -> list:\n        \"\"\"Per-block written tile-band count (occupancy).  Returns ``ntm`` (the\n        full block) for every block when occupancy is disabled or the per-step\n        valid-token map is unavailable, which reduces to full-block compress.\"\"\"\n        ntm = self._M_b // 64\n        bvt = self._block_valid_tokens\n        if (not self._occupancy_enabled or bvt is None\n                or not self._block_size or not self._hd):\n            return [ntm] * len(block_ids)\n        bs, hd = self._block_size, self._hd\n        return [max(1, min((int(bvt.get(bid, bs)) * hd + 4095) // 4096, ntm))\n                for bid in block_ids]\n\n    def _store_stack(self, host_pool: Dict[str, torch.Tensor],\n                     slots: List[int], stack_2d: torch.Tensor, n: int,\n                     valid_tm: int) -> bool:\n        \"\"\"Compress ``n`` stacked blocks (one ``[n*valid_rows, K_b]`` matrix,\n        ``valid_rows = valid_tm*64``) with the lean on-stream GPU batch entry\n        and assemble each block's payload into its physical ``slot``.\n\n        P4Flat palette tiles are independent 64x64 units, so the vertical stack\n        is compressed exactly as if each block were compressed alone: the codec\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        num_primary = gpu_k.shape[0]\n        # Step-level cache: block_ids is identical across all layers of a\n        # step, so np.asarray + in_range filter only need to run once —\n        # not ×80 layers (avoids per-layer numpy allocation churn).\n        if self._wc_bids_list is not block_ids:\n            self._wc_bids_np = np.asarray(block_ids, dtype=np.int64)\n            self._wc_bids_list = block_ids\n        bid_arr = self._wc_bids_np\n        in_range = (bid_arr >= 0) & (bid_arr < num_primary)\n        if not in_range.all():\n            bid_arr = bid_arr[in_range]\n        n = bid_arr.shape[0]\n        if n == 0:\n            return\n\n        physical_slots = self._assign_kv_slots(layer_id, bid_arr)  # numpy\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        ntm = self._M_b // 64\n\n        # Occupancy groups blocks by written tile-band count so partial blocks\n        # compress only their valid prefix.  The common case (occupancy off, or\n        # no per-step valid-token map yet) is ONE full-block group — fast-pathed\n        # here to skip the grouping loop + per-index list comprehensions.\n        secondary_fallback = False\n        with torch.cuda.stream(self.comp_stream):\n            if not self._occupancy_enabled or self._block_valid_tokens is None:\n                secondary_fallback = self._launch_group(\n                    host_k, host_v, gpu_k, gpu_v,\n                    bid_arr, physical_slots, ntm)\n            else:\n                # Cache vtm per step — bid_arr is identical across all\n                # layers, so bid_arr.tolist() + _valid_tm_for + np.asarray\n                # only need to run once (avoids ~12 MiB/step of per-layer\n                # Python list + numpy allocations → mimalloc → mmap/munmap).\n                if self._wc_bids_list is not block_ids or self._wc_vtm is None:\n                    vtm = np.asarray(\n                        self._valid_tm_for(bid_arr.tolist()),\n                        dtype=np.int64)\n                    self._wc_vtm = vtm\n                else:\n                    vtm = self._wc_vtm\n                for vt in np.unique(vtm):\n                    idxs = np.nonzero(vtm == vt)[0]\n                    secondary_fallback |= self._launch_group(\n                        host_k, host_v, gpu_k, gpu_v,\n                        bid_arr[idxs], physical_slots[idxs], int(vt))\n            event = self.comp_stream.record_event()\n        if secondary_fallback:\n            self._secondary_fallback_possible[layer_id] = True\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': bid_arr,\n            'physical_slots': physical_slots,\n        }\n\n    def _launch_group(self, host_k, host_v, gpu_k, gpu_v,\n                      gids_arr, gslots, valid_tm: int) -> bool:\n        \"\"\"Compress one occupancy group: gather its blocks' valid_rows prefix\n        into a stack and store K and V.  ``gids_arr``/``gslots`` are numpy.\"\"\"\n        M_b, K_b = self._M_b, self._K_b\n        valid_rows = valid_tm * 64\n        g = int(gids_arr.shape[0])\n        gids = torch.as_tensor(gids_arr, device=gpu_k.device)   # numpy -> GPU\n        k_stack = (gpu_k[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        v_stack = (gpu_v[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        k_secondary = self._store_stack(\n            host_k, gslots, k_stack, g, valid_tm)\n        v_secondary = self._store_stack(\n            host_v, gslots, v_stack, g, valid_tm)\n        return k_secondary or v_secondary\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        state = self._pending_compress.pop(layer_id, None)\n        if state is not None:\n            state['event'].synchronize()\n            buffer_ids = state['buffer_ids']\n            pv = self._persistent_valid[layer_id]\n            # Vectorized mark-valid (avoids a per-block bytearray write loop).\n            # ONLY mark blocks that still own a slot.  A block freed between when\n            # this compress was scheduled and now had its slot released\n            # (_kv_slot=-1) and valid cleared by free_persistent_block; blindly\n            # re-marking it valid here desyncs valid=1 vs slot=-1 -> the decode\n            # reads host['blob'][-1] (garbage) -> BF16P4Flat_DecompressBatch CUDA\n            # IMA (the serve crash).  Skip freed blocks.\n            if len(buffer_ids):\n                # Step-level cache: buffer_ids is identical across all layers\n                # of a step, so np.asarray + torch.from_numpy only need to run\n                # once — not ×80 layers (avoids ~12 MiB/step of per-layer\n                # numpy/torch allocations that trigger glibc mmap/munmap churn).\n                if self._wc_bids_list is not buffer_ids:\n                    self._wc_bids_np = np.asarray(buffer_ids, dtype=np.int64)\n                    self._wc_bids_t = torch.from_numpy(self._wc_bids_np)\n                    self._wc_bids_list = buffer_ids\n                _bids = self._wc_bids_np\n                _sl = self._kv_slot[layer_id][torch.from_numpy(_bids)].numpy()\n                _va = np.frombuffer(pv, dtype=np.uint8)\n                _idx = _bids[_sl >= 0]\n                _va[_idx] = 1\n        else:\n            buffer_ids = []\n        # Always publish an entry (empty when no blocks were scheduled) so\n        # the shared ``wait_for_layer_pipeline_cpp`` contract holds — mirrors\n        # ZipServ, whose ``wait_compress_async`` always populates it.\n        # Store the numpy array (or []) directly — the p4flat/ublb decode\n        # path pops+discards this entry and never reads buffer_ids as a\n        # Python list.  Avoids a per-layer list() materialization of ~6.5k\n        # np.int64 objects (~208 KB × 80 layers = ~16.6 MiB/step) that\n        # triggers mimalloc → mmap/munmap churn.\n        self._compressed_kv[layer_id] = {\n            'buffer_ids': buffer_ids,\n            'block_shape': block_shape,\n            'n': len(buffer_ids),\n        }\n\n    # ------------------------------------------------------------------\n    #  Decompress\n    # ------------------------------------------------------------------\n\n    def _build_struct(self, gpu_row: torch.Tensor, cnt: int,\n                      valid_rows: int = None):\n        \"\"\"Slice a GPU blob row into codec buffers and build a\n        ``CompressedP4Flat`` struct for decode.\n\n        ``valid_rows`` (occupancy mode) decodes only the first ``valid_rows``\n        rows — the codec buffer sizes scale with the encoded tile bands.  It\n        defaults to the full ``M_b`` (byte-identical to the historical path).\"\"\"\n        K_b = self._K_b\n        if valid_rows is None:\n            valid_rows = self._M_b\n        ntk = K_b // 64\n        valid_tm = valid_rows // 64\n        hb = valid_tm * ntk * 16\n        cb = valid_rows * K_b // 2\n        smb = valid_rows * K_b\n        cdb = (valid_rows // 16) * (K_b // 16)\n        c = _p4f_ext.CompressedP4Flat()\n            return self._ids_np_val\n        ab = (block_ids if isinstance(block_ids, np.ndarray)\n              else np.asarray(block_ids, dtype=np.int64))\n        self._ids_np_key = block_ids\n        self._ids_np_val = ab\n        return ab\n\n    def has_persistent_compressed_kv(self, layer_id: int,\n                                     block_ids: list) -> bool:\n        # Called once per layer per step with the full active set; the old\n        # ``any(valid[bid] for bid in block_ids)`` generator walked every id\n        # in Python (~300 µs at ~4k ids, inside the nsys decompress_persistent\n        # range).  Vectorized: one cached np view + fancy-index + .any().\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(block_ids) == 0:\n            return False\n        va = np.frombuffer(valid, dtype=np.uint8)   # bytearray view, no copy\n        ab = self._ids_np(block_ids)\n        # The in-range filtered set depends only on (block_ids, vlen) — both\n        # are identical across all ~80 layers per step.  Cache the filtered\n        # array so we don't allocate 3 numpy arrays (two bool + one int64)\n        # per layer (was ~240 numpy objects/step).\n        vlen = va.size\n        if (getattr(self, \"_has_pk_ab\", None) is ab\n                and getattr(self, \"_has_pk_vlen\", None) == vlen):\n            sel = self._has_pk_sel\n        else:\n            sel = ab[(ab >= 0) & (ab < vlen)]\n            self._has_pk_ab = ab\n            self._has_pk_vlen = vlen\n            self._has_pk_sel = sel\n        return bool(va[sel].any()) if sel.size else False\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._free_kv_slot(layer_id, block_id)\n\n    def decompress_batch(\n        self, 