{"timestamp":"2026-08-26T03:41:58.402Z","ordinal":2629,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c29-0d01-7123-9e93-dcc3b570cc56","call_id":"call_6rqqdAi2sXH8GPH75kImNlro","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10009)\nTotal output lines: 798\n\n        if _cudart_lib is None:\n            lib = None\n            cands = sorted(glob.glob(os.path.join(\n                os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n            for c in cands:\n                try:\n                    lib = ctypes.CDLL(c)\n                    break\n                except OSError:\n                    continue\n            if lib is None:\n                try:\n                    lib = ctypes.CDLL(\"libcudart.so\")\n                except OSError:\n                    lib = False  # sentinel: fall back to device sync\n            _cudart_lib = lib\n    return _cudart_lib\n\n\ndef _sync_cuda_event(handle: int) -> None:\n    \"\"\"Block until the CUDA event ``handle`` (uintptr_t) completes — the raw\n    KV D2H into secondary_kv that the worker is about to read from host.\"\"\"\n    if not handle:\n        return\n    lib = _get_cudart()\n    if lib:\n        lib.cudaEventSynchronize(ctypes.c_void_p(int(handle)))\n    else:  # pragma: no cover - cudart not loadable\n        torch.cuda.synchronize()\n\n\nclass P4FlatCPUKVCompressor(P4FlatKVCompressor):\n    \"\"\"P4Flat KV compressor whose *encode* runs on CPU worker threads, driven\n    by the ``cpu_after_raw_swap`` producer path (reads raw KV from host\n    secondary_kv after the unload D2H event).  Decode stays on GPU (inherited).\n\n    gpu_direct (``compress_batch_async``) is intentionally unsupported.\n    \"\"\"\n\n    # CPU encode never touches the GPU-compress pinned staging.\n    _USES_GPU_COMPRESS = False\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        super().__init__(comp_stream)\n        # Encode runs in the C++ OpenMP host encoder (zipserv_p4flat_ext.\n        # host_encode_blocks): in-cache per-tile, GIL released, scaling\n        # linearly to all cores (~51 GiB/s @64 on a 64-core host).  OpenMP\n        # does the parallelism, so the whole batch goes in a single call;\n        # the worker pool only provides the async boundary.  OMP_NUM_THREADS\n        # tunes the thread count.\n        if _p4f_ext is None or not hasattr(_p4f_ext, \"host_encode_blocks\"):\n            raise RuntimeError(\n                \"P4FlatCPUKVCompressor requires zipserv_p4flat_ext with the \"\n                \"host_encode_blocks C++ entry point — rebuild the extension.\")\n        # max_workers>1 lets layers compress in PARALLEL.  The worker spends\n        # most of its time blocked on per-layer GPU events (raw-D2H + decode-H2D\n        # in _encode_chunk), not on the ~0.2 ms/layer encode, so a single worker\n        # processing 80 layers FIFO serializes 80 event-waits (~150 ms END-join\n        # at high load).  N workers overlap those waits.  Each worker writes only\n        # its own layer's pool (self._host_pools[layer_id]) so it is race-free.\n        _nw = max(1, int(os.getenv(\"TIERED_SERVE_KV_COMPRESS_WORKERS\", \"1\")))\n        self._n_workers = _nw\n        # Core pinning + OMP cap so the encoder does not compete on the first\n        # cores used by the serving forward/dispatch path.  Pinning also applies\n        # to the normal one-worker configuration: its master is restricted to\n        # a contiguous slice beginning at ``reserve``, capped to the configured\n        # OpenMP team size.  OpenMP threads spawned by that master inherit the\n        # same affinity mask.  Multiple workers split the usable slice into\n        # disjoint blocks.  Disable with TIERED_SERVE_KV_COMPRESS_PIN=0.\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        # Keep CPU 0-7 available to the serving/runtime threads by default;\n        # compression uses the fixed [8, 64) range on the measured 64-core\n        # host.  Keep the existing env name because it describes this prefix.\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        # Use one fixed 56-thread encoder team on the measured 64-core host,\n        # leaving eight CPUs for serving/runtime work.  Keep this dedicated cap\n        # independent of the main process's OMP_NUM_THREADS=1: libgomp maintains\n        # a team per encountering master, so sharing one global N creates\n        # overlapping ATen and encoder pools.  The per-worker cap is clamped to\n        # its affinity-block width and can still be overridden explicitly.\n        _omp_cap = os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", \"56\")\n        # Accept a comma-separated nested-team list for compatibility; this\n        # encoder has one parallel level, so only its first value is relevant.\n        self._omp_thread_cap = max(1, int(_omp_cap.split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as _e:\n            logger.warning(\"p4flat compress: libgomp.so.1 load failed \"\n                           \"(%s); OMP threads will use the process default\", _e)\n        self._pin_tls = threading.local()\n        self._pin_counter = [0]\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, Tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        # Diagnostic: split each compress worker call into GPU-event-wait\n        # (raw-D2H + decode-H2D) vs actual CPU encode, to tell whether the\n        # END-join is bound by waiting on the GPU or by the encode itself.\n        self._wt_wait = 0.0   # total event-wait\n        self._wt_wraw = 0.0   # raw-D2H (unload input) portion of the wait\n        self._wt_comp = 0.0\n        self._wt_n = 0\n        self._work_q = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # A CPU worker captures physical persistent slots before it starts.\n        # If the scheduler frees/reuses the same canonical block id while that\n        # worker is pending, immediately returning the slot lets the old worker\n        # overwrite a new owner's blob (ABA). Quarantine such slots until the\n        # owning layer task retires.\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._workers = []\n        for i in range(_nw):\n            t = threading.Thread(\n                target=self._worker_loop,\n                daemon=True,\n                name=f\"p4flat-kv-cpu-{i}\")\n            t.start()\n            self._workers.append(t)\n        logger.info(\n            \"P4Flat CPU KV encoder: C++ OpenMP (host_encode_blocks), \"\n            \"%d worker(s), pin=%s, core_start=%d, omp_cap=%d, main_omp=%s\",\n            _nw, self._pin_workers, self._reserve_cores,\n            self._omp_thread_cap, os.environ.get(\"OMP_NUM_THREADS\", \"unset\"))\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_q.get()\n            if item is None:\n                return\n            state, args = item\n            try:\n                self._encode_chunk(*args)\n                state['error'] = None\n            except BaseException as exc:  # propagate through wait_compress_async\n                state['error'] = exc\n            finally:\n                state['done'].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {'done': done, 'error': None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state['done'].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for p4flat KV CPU worker\")\n        err = state.get('error')\n        if err is not None:\n            raise err\n\n    def _pin_worker_thread(self) -> None:\n        \"\"\"First task on each pool thread: pin to a disjoint core block and cap\n        its OpenMP team size (called at the top of _encode_chunk).\"\"\"\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        n = self._n_workers\n        with self._pin_lock:\n            idx = self._pin_counter[0] % n\n            self._pin_counter[0] += 1\n        # Respect an outer taskset/cgroup cpuset.  CPU IDs need not be dense, so\n        # split the actual allowed-ID list rather than constructing range(ncpu).\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            try:\n                # This ICV is local to the async worker's OpenMP task.  Keep\n                # libgomp from silently shrinking the dedicated encoder team\n                # even if the parent environment exported OMP_DYNAMIC=TRUE.\n                self._omp_lib.omp_set_dynamic(0)\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\n                    \"p4flat compress worker %d: omp_set_dynamic failed %s\",\n                    idx, _e)\n        if not self._pin_workers:\n            # Team sizing is independent of affinity pinning.  This matters\n            # when the production entry point keeps main ATen at OMP=1: an\n            # explicitly unpinned encoder must still receive its dedicated N.\n            nt = min(len(allowed), self._omp_thread_cap)\n            if self._omp_lib is not None:\n                try:\n                    self._omp_lib.omp_set_num_threads(int(nt))\n                except Exception as _e:  # noqa: BLE001\n                    logger.warning(\n                        \"p4flat compress worker %d: omp_set_num_threads \"\n                        \"failed %s\", idx, _e)\n            with self._pin_lock:\n                self._worker_affinities[idx] = tuple(allowed)\n                self._worker_omp_threads[idx] = nt\n            logger.info(\n                \"p4flat compress worker %d unpinned (%d allowed, OMP=%d)\",\n                idx, len(allowed), nt)\n            return\n        compress_cpus = [cpu for cpu in allowed\n                         if cpu >= self._reserve_cores]\n        if len(compress_cpus) < n:\n            logger.warning(\n                \"p4flat compress: only %d CPU(s) remain at/after core %d for \"\n                \"%d worker(s); falling back to the inherited affinity %s\",\n                len(compress_cpus), self._reserve_cores, n, allowed)\n            compress_cpus = allowed\n        # Limit the affinity itself to n*cap CPUs instead of letting a smaller\n        # team roam over every remaining CPU.  The default one-worker case is\n        # therefore exactly cores 8-63 on the measured 64-core host.\n        usable = compress_cpus[:min(\n            len(compress_cpus), n * self._omp_thread_cap)]\n        lo_i = len(usable) * idx // n\n        hi_i = len(usable) * (idx + 1) // n\n        block = set(usable[lo_i:hi_i])\n        if not block:\n            # Only possible with more workers than allowed CPUs.\n            block = {compress_cpus[idx % len(compress_cpus)]}\n        nt = len(block)\n        try:\n            os.sched_setaffinity(0, block)\n        except OSError as _e:\n            logger.warning(\"p4flat compress worker %d: setaffinity failed %s\",\n                           idx, _e)\n        if self._omp_lib is not None:\n            try:\n                self._omp_lib.omp_set_num_threads(int(nt))\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\"p4flat compress worker %d: omp_set_num_threads \"\n                               \"failed %s\", idx, _e)\n        affinity = tuple(sorted(block))\n        with self._pin_lock:\n            self._worker_affinities[idx] = affinity\n            self._worker_omp_threads[idx] = nt\n        logger.info(\n            \"p4flat compress worker %d -> cores %d-%d (%d allowed, OMP=%d), \"\n            \"cores 0-%d reserved for forward\",\n            idx, affinity[0], affinity[-1], len(affinity), nt,\n            self._reserve_cores - 1)\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Analytic sizes — no GPU.  The CPU encoder stores sm row-major\n        (``row_major_sm=1``) and ``subtile_codec`` all-``0xFF``.\"\"\"\n        num_tiles = (M_b // 64) * (K_b // 64)\n        hb = num_tiles * 16\n        cb = M_b * K_b // 2\n        smb = M_b * K_b\n        cdb = (M_b // 16) * (K_b // 16)\n        self._idx_dtype = torch.int32\n        self._val_dtype = torch.int16\n        self._idx_es = 4\n        self._val_es = 2\n        self._row_major_sm = 1\n        return hb, cb, smb, cdb\n\n    # gpu_direct path is not supported on this subclass — it is the\n    # cpu_after_raw_swap encoder.  For GPU-side p4flat compression use the\n    # base P4FlatKVCompressor (selected by TIERED_SERVE_KV_COMP_PRODUCER=\n    # gpu_direct, which is the default for --kv-comp p4flat).\n    def compress_batch_async(self, layer_id, block_ids, gpu_k, gpu_v):\n        raise NotImplementedError(\n            \"P4FlatCPUKVCompressor is the CPU-encode (cpu_after_raw_swap) \"\n            \"backend; it does not support the gpu_direct producer.  For GPU \"\n            \"compression use TIERED_SERVE_KV_COMP_PRODUCER=gpu_direct (the \"\n            \"default for --kv-comp p4flat), which selects P4FlatKVCompressor.\")\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        # The CPU producer can race scheduler free callbacks while its worker\n        # waits release the GIL. Serialize all slot ownership transitions.\n        with self._slot_state_lock:\n            return super()._assign_kv_slots(layer_id, block_ids)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Clear validity immediately and quarantine an in-flight slot.\n\n        The old CPU task may still write its captured ``slots_arr``. Keeping\n        that physical slot off the free heap until wait_compress_async retires\n        the task prevents it from corrupting a newly assigned block.\n        \"\"\"\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get('buffer_ids', ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64)\n            )\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_np = self._kv_slot_np.get(layer_id)\n                if slot_np is None or not 0 <= block_id < slot_np.size:\n                    return\n                slot = int(slot_np[block_id])\n                if slot < 0:\n                    return\n                slot_np[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n\n            self._free_kv_slot(layer_id, block_id)\n\n    def stop_kv_compress_workers(self) -> None:\n        workers = list(getattr(self, \"_workers\", ()))\n        for _ in workers:\n            self._work_q.put(None)\n        for t in workers:\n            t.join()\n        self._workers = []\n\n    # ------------------------------------------------------------------\n    #  cpu_after_raw_swap producer entry\n    # ------------------------------------------------------------------\n\n    def compress_batch_async_from_host(self, layer_id: int, block_ids: list,\n                                       host_k: torch.Tensor,\n                                       host_v: torch.Tensor,\n                                       wait_event_handle: int = 0) -> None:\n        \"\"\"Enqueue CPU compression from already-unloaded raw secondary KV.\n\n        ``host_k`` / ``host_v`` are the per-layer raw secondary tensors\n        (indexed by buffer id).  Workers wait on ``wait_event_handle`` (the\n        primary->secondary D2H completion) before reading them.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        n_off = host_k.shape[0]\n        # Vectorised in-range filter + slot lookup — no per-block Python loop and\n        # no slots.tolist()/zip on the forward thread.  Both stay int64 numpy\n        # arrays and are handed straight to the worker, which builds the decode\n        # tensors zero-copy (torch.from_numpy) instead of re-zipping per block.\n        #\n        # Step memo: block_ids is the step-stable _valid_ids_cache object passed\n        # unchanged to every layer's offload, and n_off (secondary buffer block\n        # count) is layer-invariant, so the filtered array is identical across\n        # all ~80 layers of a step.  Key on (id(block_ids), n_off) and reuse —\n        # self-validating (a miss just recomputes; never wrong).  The shared\n        # bid_arr is read-only downstream (_assign_kv_slots gathers, the worker\n        # from_numpy-views it), and the memo REPLACES (never mutates) the cached\n        # array, so an in-flight worker from a prior step keeps its own copy.\n        if (block_ids is getattr(self, \"_fh_filter_key\", None)\n                and n_off == getattr(self, \"_fh_filter_noff\", -1)):\n            bid_arr = self._fh_filter_arr\n        else:\n            bid_arr = np.asarray(block_ids, dtype=np.int64)\n            if bid_arr.size:\n                bid_arr = bid_arr[(bid_arr >= 0) & (bid_arr < n_off)]\n            self._fh_filter_key = block_ids\n            self._fh_filter_noff = n_off\n            self._fh_filter_arr = bid_arr\n        if bid_arr.size == 0:\n            return\n        handle = int(wait_event_handle)\n        # WAIT-BASED pool-write ordering: this worker overwrites the same slots\n        # the decode just read via an async H2D.  Instead of host-synchronizing\n        # the decode (which serializes per-layer), the worker waits on this\n        # layer's decode-H2D-done event from its own thread.  Captured now; the\n        # decode→unload order in the layer loop means it holds this step's\n        # recording, and the next step's decode joins this worker before\n        # re-recording, so the worker always observes the correct (this-step)\n        # H2D completion (no main-thread block, no stale-event hazard).\n        dec_h2d = int(self._kv_dec_h2d[layer_id].cuda_event)\n        # Snapshot the per-step occupancy map at schedule time.  The hook\n        # *replaces* (never mutates) this dict each step, so capturing the\n        # reference here keeps a pipelined late encode reading its own step's\n        # counts even after the next step publishes a new map.\n        bvt = self._block_valid_tokens\n        # One task: the C++ encoder parallelises across blocks with OpenMP\n        # internally (splitting across Python workers would nest the pool x\n        # OMP threads and oversubscribe).\n        with self._slot_state_lock:\n            if layer_id in self._pending_compress:\n                raise RuntimeError(\n                    \"P4Flat CPU KV layer still has a pending task after join: \"\n                    f\"layer={layer_id}\")\n            slots_arr = np.asarray(\n                self._assign_kv_slots(layer_id, bid_arr), dtype=np.int64)\n            # A recompress may overwrite an already-valid row. Make it\n            # unavailable before the worker can start; success republishes\n            #…9 tokens truncated…ct captured slots.\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None:\n                valid_np = np.frombuffer(valid, dtype=np.uint8)\n                valid_np[bid_arr] = 0\n\n            state = self._worker_state_for_layer(layer_id)\n            state['error'] = None\n            state['done'].clear()\n            pending = {\n                'state': state,\n                # Keep the int64 ndarray (no per-layer tolist() on the forward\n                # thread). wait_compress_async consumes it via np.asarray.\n                'buffer_ids': bid_arr,\n                # The async worker writes these exact physical rows.\n                'physical_slots': slots_arr,\n            }\n            # Publish ownership before enqueue. SimpleQueue.put can wake a\n            # worker immediately; a concurrent free must already see pending\n            # and quarantine the captured slot.\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_q.put((\n                    state,\n                    (layer_id, host_k, host_v, bid_arr, slots_arr,\n                     handle, bvt, dec_h2d)))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state['done'].set()\n                raise\n\n    def _invoke_host_encode(self, host_i16, bidx, slots_t, pool,\n                            M_b, K_b, valid_tm):\n        \"\"\"Codec-specific C++ host encode of a block group into pool slots.\n        Default = p4flat; ublb subclasses override with their blob encoder.\n        Factored out so the grouping/threading in _encode_chunk stays shared.\"\"\"\n        _p4f_ext.host_encode_blocks(\n            host_i16, bidx, slots_t,\n            pool['blob'], pool['total_size'], pool['exc_cnt'],\n            pool['is_raw'], pool['valid_rows'], M_b, K_b, valid_tm)\n\n    def _encode_chunk(self, layer_id: int, host_k: torch.Tensor,\n                      host_v: torch.Tensor, bid_arr, slots_arr,\n                      wait_handle: int, bvt=None, dec_h2d_handle: int = 0) -> None:\n        # Reads raw secondary KV (gated by the primary->secondary D2H event) and\n        # OVERWRITES the persistent pool slots.  The pool write must follow the\n        # decode's in-flight H2D read of those slots, so wait on the decode-H2D\n        # event too — both waits run here on the worker thread (not the forward\n        # thread), so they never serialize the main decode loop.\n        self._pin_worker_thread()\n        _t0 = time.perf_counter()\n        _sync_cuda_event(wait_handle)      # raw-D2H: unload input ready\n        _ta = time.perf_counter()\n        _sync_cuda_event(dec_h2d_handle)   # decode-H2D: slots free to overwrite\n        _t1 = time.perf_counter()  # GPU event wait done; encode starts\n        M_b, K_b = self._M_b, self._K_b\n        ntm = M_b // 64\n        bs, hd = self._block_size, self._hd\n\n        # Group blocks by valid_tm.  Occupancy OFF (no bvt) => every block is\n        # full (valid_tm == ntm) => a SINGLE group, tensors built zero-copy from\n        # the numpy arrays (torch.from_numpy, no per-block Python loop).\n        # Occupancy ON => one cheap list-comp (dict.get + arithmetic, no .item()).\n        # Each group is one C++ OpenMP call that reads src[block_ids[b]] directly\n        # from the host KV tensor (no gather copy) and writes serialized blobs +\n        # meta into the pool slots, GIL released.  ``host`` is the contiguous\n        # secondary-KV tensor [n_off, *block_shape]; its int16 view is\n        # flat-equivalent to [n_off, M_b, K_b].\n        if bvt is None or not bs or not hd:\n            groups = [(ntm, torch.from_numpy(bid_arr),\n                       torch.from_numpy(slots_arr))]\n        else:\n            from collections import defaultdict\n            gb = defaultdict(list)\n            gs = defaultdict(list)\n            for bid, slot in zip(bid_arr.tolist(), slots_arr.tolist()):\n                vt = max(1, min((int(bvt.get(bid, bs)) * hd + 4095) // 4096,\n                                ntm))\n                gb[vt].append(bid)\n                gs[vt].append(slot)\n            groups = [(vt, torch.from_numpy(np.asarray(gb[vt], dtype=np.int64)),\n                       torch.from_numpy(np.asarray(gs[vt], dtype=np.int64)))\n                      for vt in gb]\n\n        for valid_tm, bidx, slots_t in groups:\n            for host, kv in ((host_k, 'k'), (host_v, 'v')):\n                pool = self._host_pools[layer_id][kv]\n                self._invoke_host_encode(\n                    host.view(torch.int16), bidx, slots_t, pool,\n                    M_b, K_b, valid_tm)\n        if self._blob_stride < self._raw_bytes:\n            pools = self._host_pools[layer_id]\n            slots = np.asarray(slots_arr, dtype=np.int64)\n            if (((pools['k']['is_raw'].numpy()[slots] >= 2)\n                    | (pools['v']['is_raw'].numpy()[slots] >= 2)).any()):\n                self._secondary_fallback_possible[layer_id] = True\n        _t2 = time.perf_counter()  # encode done\n        with self._pin_lock:\n            self._wt_wraw += (_ta - _t0)\n            self._wt_wait += (_t1 - _t0)\n            self._wt_comp += (_t2 - _t1)\n            self._wt_n += 1\n            if self._wt_n >= 2000:\n                _n = self._wt_n\n                logger.warning(\n                    \"[kv-compress] per-call: raw-D2H wait %.2f ms | \"\n                    \"decode-H2D wait %.2f ms | encode %.2f ms | %d calls\",\n                    self._wt_wraw / _n * 1e3,\n                    (self._wt_wait - self._wt_wraw) / _n * 1e3,\n                    self._wt_comp / _n * 1e3, _n)\n                self._wt_wraw = self._wt_wait = self._wt_comp = 0.0\n                self._wt_n = 0\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        # Keep the pending entry visible while Event.wait() releases the GIL.\n        # A scheduler/free callback running on another Python thread must still\n        # quarantine the worker's captured physical slots instead of returning\n        # them to the allocation heap before the old worker retires.\n        with self._slot_state_lock:\n            state = self._pending_compress.get(layer_id)\n        if state is not None:\n            try:\n                if 'state' in state:\n                    self._wait_worker_state(state['state'], timeout_sec)\n                else:\n                    for f in state['futures']:\n                        f.result()   # join + propagate worker exceptions\n            except BaseException:\n                if 'state' in state:\n                    worker_retired = state['state']['done'].is_set()\n                else:\n                    worker_retired = all(\n                        future.done() for future in state['futures'])\n                with self._slot_state_lock:\n                    if (worker_retired\n                            and self._pending_compress.get(layer_id) is state):\n                        self._pending_compress.pop(layer_id, None)\n                        deferred = self._deferred_slot_frees.pop(\n                            layer_id, set())\n                        for slot in deferred:\n                            self._release_quarantined_slot(layer_id, slot)\n                # A timeout leaves pending and quarantined rows intact because\n                # the worker may still write them. A terminal worker error has\n                # retired the task; rows were invalidated before enqueue.\n                raise\n            else:\n                buffer_ids = state['buffer_ids']\n                with self._slot_state_lock:\n                    if self._pending_compress.get(layer_id) is state:\n                        try:\n                            pv = self._persistent_valid[layer_id]\n                            # Publish only canonical ids that still own the\n                            # exact physical rows captured by this worker.\n                            if len(buffer_ids):\n                                _bids = np.asarray(\n                                    buffer_ids, dtype=np.int64)\n                                _captured = np.asarray(\n                                    state['physical_slots'], dtype=np.int64)\n                                if _captured.shape != _bids.shape:\n                                    raise RuntimeError(\n                                        \"P4Flat CPU KV pending id/slot shape \"\n                                        f\"mismatch: ids={_bids.shape}, \"\n                                        f\"slots={_captured.shape}\")\n                                _sl = self._kv_slot[\n                                    layer_id][torch.from_numpy(_bids)].numpy()\n                                _va = np.frombuffer(pv, dtype=np.uint8)\n                                _idx = _bids[\n                                    (_sl >= 0) & (_sl == _captured)]\n                                _va[_idx] = 1\n                        finally:\n                            self._pending_compress.pop(layer_id, None)\n                            deferred = self._deferred_slot_frees.pop(\n                                layer_id, set())\n                            for slot in deferred:\n                                self._release_quarantined_slot(layer_id, slot)\n        else:\n            buffer_ids = []\n        # Always publish an entry (empty when no blocks were scheduled for\n        # this layer this iteration) so the shared\n        # ``wait_for_layer_pipeline_cpp`` contract holds — mirrors ZipServ,\n        # whose ``wait_compress_async`` always populates ``_compressed_kv``.\n        self._compressed_kv[layer_id] = {\n            # int64 ndarray (or [] when nothing was scheduled) — popped+discarded\n            # on the p4flat/ublb decode path (no Python-list reader); avoids a\n            # per-layer list() materialization on the forward thread.\n            'buffer_ids': buffer_ids,\n            'block_shape': block_shape,\n            'n': len(buffer_ids),\n        }\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode this layer's KV.  WAIT-BASED ordering (no host synchronize):\n\n        Two read/write hazards on the host pool, both ordered without blocking\n        the main thread (so per-layer decodes pipeline / prefetch the forward):\n          1. decode reads pool data written by the PREVIOUS step's worker → join\n             that worker's future first (it finished a step ago, so ~0 cost).\n          2. THIS step's unload worker re-compresses + overwrites these same\n             slots → it must not clobber the decode's in-flight async H2D read.\n             Handled on the WORKER thread: it waits on this layer's decode-H2D\n             event (``_kv_dec_h2d[layer_id]``, recorded in _decompress_batched)\n             before writing — see ``_encode_chunk``.  No main-thread barrier, so\n             the KV-decode H2D+kernels overlap the forward.\n        \"\"\"\n        st = self._pending_compress.get(layer_id)\n        if st is not None:\n            if 'state' in st:\n                self._wait_worker_state(st['state'])\n    def _assign_zip_meta_slots(\n            self, layer_id: int, block_ids: torch.Tensor) -> None:\n        \"\"\"Batch-assign compact physical metadata rows.\n\n        The old scalar helper issued one ATen tensor write per block, which\n        cost about 8 ms for a 4096-block first insert.  Keep list/dict book-\n        keeping in Python, then publish all offsets with one tensor scatter.\n        \"\"\"\n        if block_ids.numel() == 0:\n            return\n        bids = block_ids.to(dtype=torch.long, device=\"cpu\").contiguous()\n        pos = self._zip_meta_active_pos.get(layer_id)\n        active = self._zip_meta_active_blocks.get(layer_id)\n        stride = int(self._meta_total_bytes)\n        offsets = self._block_meta_offsets[layer_id]\n        if pos is None or active is None:\n            offsets[bids] = bids * stride\n            return\n\n        slots = []\n        for bid in bids.tolist():\n            bid = int(bid)\n            idx = pos.get(bid)\n            if idx is None:\n                idx = len(active)\n                pos[bid] = idx\n                active.append(bid)\n            slots.append(idx)\n        offsets[bids] = torch.as_tensor(slots, dtype=torch.long) * stride\n\n    def _copy_zip_meta_to_physical(self, layer_id: int, block_id: int) -> None:\n        dst_off = self._assign_zip_meta_slot(layer_id, block_id)\n        src_off = int(block_id) * int(self._meta_total_bytes)\n        nbytes = int(self._meta_total_bytes)\n        if nbytes <= 0:\n            return\n        for kv_idx in (0, 1):\n            host_pool = self._kv_host_pools[layer_id][kv_idx]\n            src = host_pool[\"__meta_backing\"]\n            dst = host_pool[\"__meta_phys_backing\"]\n            dst.narrow(0, dst_off, nbytes).copy_(\n                src.narrow(0, src_off, nbytes))\n\n    def _free_zip_meta_slot(self, layer_id: int, block_id: int) -> None:\n        pos = self._zip_meta_active_pos.get(layer_id)\n        active = self._zip_meta_active_blocks.get(layer_id)\n        if pos is None or active is None:\n            return\n        idx = pos.pop(block_id, None)\n        if idx is None:\n            return\n        tail_bid = active[-1]\n        tail_idx = len(active) - 1\n        meta_bytes = int(self._meta_total_bytes)\n        if idx != tail_idx:\n            dst_off = idx * meta_bytes\n            src_off = tail_idx * meta_bytes\n            for kv_idx in (0, 1):\n                host_pool = self._kv_host_pools[layer_id][kv_idx]\n                self._copy_zipserv_range(\n                    host_pool[\"__meta_phys_backing\"], dst_off, src_off,\n                    meta_bytes)\n            active[idx] = tail_bid\n            pos[tail_bid] = idx\n            self._block_meta_offsets[layer_id][tail_bid] = dst_off\n        active.pop()\n        self._block_meta_offsets[layer_id][block_id] = -1\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Remove persistent compressed metadata for a freed block.\n        Also returns the block's sm/cf/raw reservations to the append\n        pool so the cursor can recycle them, preventing pool exhaustion\n        and keeping coalescing tight.\"\"\"\n        valid = self._persistent_valid.get(layer_id)\n        if (valid is None\n                or not 0 <= block_id < int(self._kv_max_n_blocks)):\n            raise IndexError(\n                f\"ZipServ block id out of range: layer={layer_id}, \"\n                f\"block={block_id}, capacity={self._kv_max_n_blocks}\")\n        valid[block_id] = 0\n\