k_ab = ab\n            self._has_pk_vlen = vlen\n            self._has_pk_sel = sel\n        return bool(va[sel].any()) if sel.size else False\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._free_kv_slot(layer_id, block_id)\n\n    def decompress_batch(\n        self, layer_id: int,\n        active_block_ids: list,\n        output_buffers: \"tuple[torch.Tensor, torch.Tensor]\",\n    ) -> None:\n        \"\"\"KV-path batch decompress.\n\n        ``output_buffers`` is a 2-tuple ``(k_cache, v_cache)`` whose\n        ``[block_id]`` slots receive the decompressed BF16 results.\n\n        This class is KV-only and overrides the abstract\n        ``TensorCompressor.decompress_batch`` with this KV-specific\n        signature — calling with ``(comps, outputs)`` (the weight-path\n        signature) raises :class:`TypeError` from the unpacking below\n        rather than the abstract NotImplementedError stub.\n        \"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None:\n            return\n        num_primary = k_cache.shape[0]\n        vlen = len(valid)\n        filtered = [bid for bid in active_block_ids\n                    if 0 <= bid < num_primary and bid < vlen and valid[bid]]\n        if not filtered:\n            return\n        filtered.sort()\n        slot_tbl[bid] = active\n        self._kv_slot_block[layer_id][active] = bid\n        self._kv_active_count[layer_id] = active + 1\n        return active\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        if not 0 <= bid < slot_tbl.numel():\n            return -1\n        return int(slot_tbl[bid].item())\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, 