\n\ndef test_p4flat_cpu_kv_roundtrip():\n    assert torch.cuda.is_available(), \"CUDA required\"\n\n    num_blocks = 16\n    block_size, num_heads, head_dim = 16, 8, 128   # block_numel = 16384\n    block_shape = (block_size, num_heads, head_dim)\n\n    # Raw secondary KV lives on pinned host memory (as in cpu_after_raw_swap).\n    host_k = torch.randn(num_blocks, *block_shape,\n                         dtype=torch.bfloat16).pin_memory()\n    host_v = torch.randn(num_blocks, *block_shape,\n                         dtype=torch.bfloat16).pin_memory()\n    k_cache = torch.zeros(num_blocks, *block_shape,\n                          dtype=torch.bfloat16, device=\"cuda\")\n    v_cache = torch.zeros_like(k_cache)\n\n    comp = P4FlatCPUKVCompressor(torch.cuda.Stream())\n    _LIVE_COMPRESSORS.append(comp)  # keep alive for module lifetime (see note)\n    comp.warmup_kv_buffers(\n        block_shape=block_shape, max_n_blocks=num_blocks, n_layers=2,\n        max_gpu_blocks=num_blocks, max_gpu_decomp_blocks=num_blocks)\n\n    ids = list(range(num_blocks))\n    # wait_event_handle=0 -> no event to wait on (host data already present).\n    comp.compress_batch_async_from_host(0, ids, host_k, host_v, 0)\n    comp.wait_compress_async(0, block_shape)\n    assert comp.has_persistent_compressed_kv(0, ids)\n    _roundtrip(comp, 0, ids, k_cache, v_cache, host_k, host_v,\n               \"cpu->gpu roundtrip\")\n\n    # free is metadata-only (free-list): slot released, NO swap-with-last,\n    # hwm (_kv_active_count) unchanged, freed slot goes to the free-list.\n    comp.free_persistent_block(0, 0)\n    assert int(comp._kv_slot[0][0].item()) == -1\n    assert int(comp._kv_slot[0][num_blocks - 1].item()) == num_blocks - 1\n    assert comp._kv_active_count[0] == num_blocks\n    assert 0 in comp._kv_free_slots[0]\n    _roundtrip(comp, 0, list(range(1, num_blocks)), k_cache, v_cache,\n               host_k, host_v, \"post-free roundtrip\")\n\n    # second layer, out-of-order subset\n    subset