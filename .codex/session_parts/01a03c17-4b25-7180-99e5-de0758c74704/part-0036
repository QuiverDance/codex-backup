.fake_free_list_head.next_free_block = self.fake_free_list_tail\n            self.fake_free_list_tail.prev_free_block = self.fake_free_list_head\n\n    def popleft(self) -> KVCacheBlock:\n        \"\"\"Pop the first free block and reduce num_free_blocks by 1.\n\n        Returns:\n            The first free block.\n        \"\"\"\n        if (\n            self.fake_free_list_head.next_free_block is self.fake_free_list_tail\n            or self.fake_free_list_head.next_free_block is None\n        ):\n            assert self.num_free_blocks == 0, (\n                f\"num_free_blocks ({self.num_free_blocks}) is out of sync \"\n                \"with the free list.\"\n            )\n            raise ValueError(\"No free blocks available\")\n\n        first_block: KVCacheBlock = self.fake_free_list_head.next_free_block\n\n        if first_block.next_free_block is None:\n            # This should not happen if the block is from the free list.\n            # It indicates a bug in the caller's logic.\n            raise RuntimeError(\n                \"Invalid block found in popleft() \"\n                \"which doesn't have a valid next_free_block\"\n            )\n\n        # Connect fake_head and the next block of first_block (i.e. second block\n        # or fake tail).\n        self.fake_free_list_head.next_free_block = first_block.next_free_block\n        first_block.next_free_block.prev_free_block = self.fake_free_list_head\n\n        # Remove the block from the linked list.\n        first_block.prev_free_block = first_block.next_free_block = None\n\n        self.num_free_blocks -= 1\n        return first_block\n\n    def popleft_n(self, n: int) -> list[KVCacheBlock]:\n        \"\"\"Pop the first n free blocks and reduce num_free_blocks by n.\n\n        Args:\n            n: The number of blocks to pop.\n\n        Returns:\n            A list of n free blocks.\n        \"\"\"\n        if n == 0:\n            return []\n        assert self.num_free_blocks >= n\n        self.num_free_blocks -= n\n\n        curr_block = self.fake_free_list_head.next_free_block\n        # Pop n blocks from the head of the list\n        ret = []\n        for _ in range(n):\n            assert curr_block is not None\n            ret.append(curr_block)\n            last_block = curr_block\n            curr_block = curr_block.next_free_block\n            # Reset prev_free_block and next_free_block of all popped blocks\n            last_block.prev_free_block = None\n            last_block.next_free_block = None\n\n        if curr_block is not None:\n            # The queue is not empty, connect the fake head to\n            # the new first block.\n            self.fake_free_list_head.next_free_block = curr_block\n            curr_block.prev_free_block = self.fake_free_list_head\n        return ret\n\n    def remove(self, block: KVCacheBlock) -> None:\n        \"\"\"Remove a block in the free list and reduce num_free_blocks by 1.\n\n        Args:\n            block: The block to remove.\n        \"\"\"\n        if block.prev_free_block is None or block.next_free_block is None:\n            # This should not happen if the block is from the free list.\n            # It indicates a bug in the caller's logic.\n            raise RuntimeError(f\"remove() called on an invalid block: {block}\")\n\n        # Link the previous block to the next block.\n        block.prev_free_block.next_free_block = block.next_free_block\n        # Link the next block to the previous block.\n        block.next_free_block.prev_free_block = block.prev_free_block\n\n        # Remove the block from the linked list.\n        block.prev_free_block = block.next_free_block = None\n        self.num_free_blocks -= 1\n\n    def _append_after(self, anchor: KVCacheBlock,\n                       block: KVCacheBlock) -> None:\n        \"\"\"Insert *block* immediately after *anchor* in the linked list.\"\"\"\n        next_block = anchor.next_free_block\n        assert next_block is not None\n        anchor.next_free_block = block\n        block.prev_free_block = anchor\n        block.next_free_block = next_block\n        next_block.prev_free_block = block\n\n    def _insert_one_sorted(self, block: \"KVCacheBlock\") -> None:\n        \"\"\"Insert *block* into its block_id-sorted position. Walks from the\n        nearer end to bound the scan; the list is kept fully sorted so the\n        in-use set stays packed at low indices. Used only when _addr_order.\"\"\"\n        bid = block.block_id\n        head = self.fake_free_list_head\n        tail = self.fake_free_list_tail\n        first = head.next_free_block\n        last = tail.prev_free_block\n        if first is tail:                       # empty list\n            self._append_after(head, block)\n            return\n        if bid <= first.block_id:               # new minimum → front\n            self._append_after(head, block)\nENV_CURRENT\nPATCH_DEFAULT\n2181-+        # phases don't fragment LPDDR5 staging for later phases.  Default off;\n2182-+        # the linked list is initialized sorted, so the invariant holds once on.\n2183:+        self._addr_order = (\n2184-+            os.getenv(\"TIERED_SERVE_KV_ADDR_ORDER\", \"0\") == \"1\")\n2185- \n--\n2254--        last_block.next_free_block = block\n2255--        block.prev_free_block = last_block\n2256:+        if self._addr_order:\n2257-+            self._insert_one_sorted(block)\n2258-+            self.num_free_blocks += 1\n--\n2299--            last_block.next_free_block = block\n2300--            last_block = block\n2301:+        if self._addr_order:\n2302-+            # Insert ascending so each insert tends to extend the previous\n2303-+            # one's position (cheap when freeing a packed low-id run).\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d0d-cd82-7261-9c9f-4d0648809a8c","create_time":1787730745.9123423}}}
