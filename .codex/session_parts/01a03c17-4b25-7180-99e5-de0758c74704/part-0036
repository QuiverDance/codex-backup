ntries = self._retired_kv_slots.get(layer_id)\n        if not entries:\n            return 0\n\n        if wait_for_one:\n            # FIFO is the least disruptive pressure fallback: CUDA stream\n            # events are submitted in retirement order, and the oldest row has\n            # waited longest. The worker Event is per-layer and may lag the GPU.\n            _, gate, worker_done, _ = entries[0]\n            gate.synchronize()\n            if worker_done is not None:\n                worker_done.wait()\n            self._retired_kv_forced_waits += 1\n\n        now = time.perf_counter()\n        keep = []\n        reaped = 0\n        for slot, gate, worker_done, retired_at in entries:\n            ready = gate.query()\n            if ready and worker_done is not None:\n                ready = worker_done.is_set()\n            if not ready:\n                keep.append((slot, gate, worker_done, retired_at))\n                continue\n            self._release_kv_slot(layer_id, slot)\n            reaped += 1\n            self._retired_kv_max_age_ms = max(\n                self._retired_kv_max_age_ms,\n                (now - retired_at) * 1e3)\n        self._retired_kv_slots[layer_id] = keep\n        self._retired_kv_current -= reaped\n        self._retired_kv_reaped += reaped\n        return reaped\n\n    def retire_persistent_block(self, layer_id: int, block_id: int,\n                                gate) -> None:\n        \"\"\"Invalidate now; reuse its physical row only after ``gate``.\"\"\"\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._retire_kv_slot(layer_id, block_id, gate)\n\n    def get_retired_kv_stats(self) -> Dict[str, Any]:\n        oldest = None\n        for entries in self._retired_kv_slots.values():\n            for _, _, _, retired_at in entries:\n                oldest = retired_at if oldest is None else min(\n                 