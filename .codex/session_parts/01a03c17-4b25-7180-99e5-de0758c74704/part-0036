\n                else \" (stream-synchronize baseline)\")\n            if DualMemoryLoader.kv_full_block_only:\n                # Every encode target is now structurally complete. Do not\n                # collect per-step occupancy or emit partial-tile blobs.\n                self.kv_compressor._occupancy_enabled = False\n                self.kv_compressor._block_valid_tokens = None\n                logger.info(\n                    \"[kv-full-block] ENABLED backend=%s: partial tails stay \"\n                    \"in HBM; encode targets are always 16-token blocks\",\n                    kv_comp_backend)\n\n            # Wire the KV-load stream into the compressor so the compressed-blob\n            # H2D runs on it (double-buffered with the decode on\n            # batch_decomp_stream).\n            #\n            # H2D-ON-WEIGHT-STREAM (default ON): the single GH200 copy engine is\n            # shared by weight H2D and KV H2D.  With the KV H2D on its OWN stream\nKV_CURRENT_TOP\nimport torch\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\nimport time as _time\n\n\n_ENV_KV_DRAIN_OFFLOAD = os.getenv(\"TIERED_SERVE_KV_DRAIN_OFFLOAD\", \"0\")\n_ENV_KV_CPU_PROFILE = os.getenv(\"TIERED_SERVE_KV_CPU_PROFILE\", \"0\") == \"1\"\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n_ENV_KV_FREE_MODE = os.getenv(\n    \"TIERED_SERVE_KV_FREE_MODE\", \"sync\").strip().lower()\nif _ENV_KV_FREE_MODE not in (\"sync\", \"retired\"):\n    raise ValueError(\n        \"TIERED_SERVE_KV_FREE_MODE must be 'sync' or 'retired', got \"\n        f\"{_ENV_KV_FREE_MODE!r}\")\n_ENV_KV_FREE_LOG_INTERVAL = max(\n    0, int(os.getenv(\"TIERED_SERVE_KV_FREE_LOG_INTERVAL\", \"256\")))\n\n\nclass _KVRetireGate:\n    \"\"\"One shared completion gate for all layer slots of a freed KV block.\"\"\"\n\n    __slots__ = (\"events\", \"_ready\")\n\n    def __init__(self, events) -> None:\n        self.events = tuple(events)\n        self._ready = not self.events\n\n    def query(self) -> bool:\n        if not self._ready:\n            self._ready = all(event.query() for event in self.events)\n        return self._ready\n\n    def synchronize(self) -> None:\n        if not self._ready:\n            for event in self.events:\n                event.synchronize()\n            self._ready = True\n\nclass KVMixin:\n\n    kv_free_mode = _ENV_KV_FREE_MODE\n    _kv_free_calls = 0\n    _kv_free_host_seconds = 0.0\n    _kv_free_stream_syncs = 0\n    _kv_free_retire_events = 0\n\n    @classmethod\n    def record_tail_write(cls, write) -> None:\n        \"\"\"Record one canonical scheduler block occupancy transition.\n\n        EngineCore calls this before the worker prepares its input table.  The\n        feature-disabled path is an intentional no-op so the legacy unload\n        callback can share the same metadata contract.\n        \"\"\"\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is None:\n            raise RuntimeError(\n                \"full-block KV write arrived before tail residency setup\")\n        manager.record_write(\n            request_id=write.request_id,\n            block_id=write.block_id,\n            block_index=write.block_index,\n            pre_valid=write.pre_valid,\n            post_valid=write.post_valid,\n            block_size=write.block_size,\n        )\n\n    @classmethod\n    def free_tail_block(cls, block_id: int) -> None:\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\nKV_CURRENT_FREE\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int):\n        started = _time.perf_counter()\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        # Clean up persistent compressed KV metadata\n        if cls.use_kv_comp and hasattr(cls, '_kv_compressor_ref') and cls._kv_compressor_ref is not None:\n            kc = cls._kv_compressor_ref\n            streams = (getattr(kc, 'batch_decomp_stream', None),\n                       getattr(kc, 'load_kv_stream', None),\n                       getattr(kc, 'comp_stream', None))\n            if cls.kv_free_mode == \"sync\":\n                # Historical baseline: drain every stream before returning a\n                # persistent host-pool slot to the allocator. Keep this branch\n                # equivalent in ordering for a clean A/B.\n                for stream in streams:\n                    if stream is not None:\n                        stream.synchronize()\n                        cls._kv_free_stream_syncs += 1\n                for layer_id in range(n_layers):\n                    kc.free_persistent_block(layer_id, block_id)\n            else:\n                retire = getattr(kc, \"retire_persistent_block\", None)\n                if retire is None:\n                    raise RuntimeError(\n                        \"TIERED_SERVE_KV_FREE_MODE=retired is unsupported by \"\n                        f\"{type(kc).__name__}; use sync mode\")\n\n                # Record after all work already submitted to each distinct\n                # stream. The logical block mapping is invalidated immediately,\n                # while its physical host-pool rows remain quarantined until\n                # this gate (and any CPU encoder that captured the row) retires.\n                events = []\n                seen_streams = set()\n                for stream in streams:\n                    if stream is None:\n                        continue\n                    key = (str(stream.device), int(stream.cuda_stream))\n                    if key in seen_streams:\n                        continue\n                    seen_streams.add(key)\n                    event = torch.cuda.Event(\n                        blocking=False, enable_timing=False)\n                    event.record(stream)\n                    events.append(event)\n                gate = _KVRetireGate(events)\n                cls._kv_free_retire_events += len(events)\n                for layer_id in range(n_layers):\n                    retire(layer_id, block_id, gate)\n\n        cls._kv_free_calls += 1\n        cls._kv_free_host_seconds += _time.perf_counter() - started\n        interval = _ENV_KV_FREE_LOG_INTERVAL\n        if interval and cls._kv_free_calls % interval == 0:\n            retired = {}\n            if cls.kv_free_mode == \"retired\":\n                stats_fn = getattr(\n                    getattr(cls, '_kv_compressor_ref', None),\n                    \"get_retired_kv_stats\", None)\n                if stats_fn is not None:\n                    retired = stats_fn()\n            logger.info(\n                \"[kv-free] mode=%s calls=%d host_total=%.3fms \"\n                \"host_avg=%.3fus stream_syncs=%d retire_events=%d \"\n                \"retired_current=%d retired_peak=%d forced_waits=%d \"\n                \"max_age=%.3fms\",\n                cls.kv_free_mode, cls._kv_free_calls,\n                cls._kv_free_host_seconds * 1e3,\n                cls._kv_free_host_seconds * 1e6 / cls._kv_free_calls,\n                cls._kv_free_stream_syncs, cls._kv_free_retire_events,\n                retired.get(\"current\", 0), retired.get(\"peak\", 0),\n                retired.get(\"forced_waits\", 0),\n                retired.get(\"max_age_ms\", 0.0))\n\n    # @log_sparse(stack_depth=5)\n    def load_kv(self, layer_id: int, force=False, non_blocking=True):\n\n        def get_ptr_tensor(tensor_list):\n            \"\"\"\n            텐서 리스트로부터 각 텐서의 데이터 포인터를 담은 텐서를 생성합니다.\n            \"\"\"\n            return torch.tensor([t.data_ptr() for t in tensor_list],\n                                dtype=torch.int64,\n                                device=tensor_list[0].device)\n\n        if self.is_graph_warming_up:\n            return\n\n        load_kv_stream = self._kv_load_stream_for(layer_id)\n\n        if DualMemoryLoader.use_kv_comp:\n            kv_sys = DualMemoryLoader.kv_offload_system\nP4_CURRENT_ALLOC\n            lid: np.full(host_n, -1, dtype=np.int64)\n            for lid in range(n_layers)\n        }\n        self._kv_slot = {\n            lid: torch.from_numpy(self._kv_slot_np[lid])\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {lid: [-1] * host_n for lid in range(n_layers)}\n        self._kv_active_count = {lid: 0 for lid in range(n_layers)}  # hwm\n        self._kv_free_heap = {lid: [] for lid in range(n_layers)}\n        self._kv_free_slots = {lid: set() for lid in range(n_layers)}\n        # Event-gated free mode detaches a canonical block immediately but\n        # keeps its physical host-pool row out of the free heap until every GPU\n        # reader/writer submitted before the free has completed. CPU encoders\n        # may add their worker completion Event as a second gate.\n        self._retired_kv_slots = {lid: [] for lid in range(n_layers)}\n        self._retired_kv_current = 0\n        self._retired_kv_peak = 0\n        self._retired_kv_total = 0\n        self._retired_kv_reaped = 0\n        self._retired_kv_forced_waits = 0\n        self._retired_kv_max_age_ms = 0.0\n        # Decode fast-path pre-binding: the per-layer hot references are\n        # resolved ONCE here so the per-layer decode does a single tuple\n        # unpack instead of ~15 dict/attr lookups (every statement on the\n        # forward thread is GPU-idle gap).\n        self._dec_cap = max_gpu_decomp_blocks\n        # (row_major_sm is NOT baked in: gpu_direct warmup may flip it after\n        # this point — the fast path reads the attribute per call.)\n        self._fast_const = (blob_stride, block_numel, K_b, M_b,\n                            (blob_stride - fixed_bytes) // 6)\n        self._dec_fast = {}\n        for lid in range(n_layers):\n            hk = self._host_pools[lid]['k']\n            hv = self._host_pools[lid]['v']\n            self._dec_fast[lid] = (\n                self._kv_slot[lid], hk['blob'], hv['blob'],\n                hk['valid_rows'], hk['exc_cnt'], hk['is_raw'],\n                hv['valid_rows'], hv['exc_cnt'], hv['is_raw'])\n        # C++ decode prep (decode_layer_prep): one ext call replaces the\n        # per-layer Python staging (valid filter + slot/meta gather + meta &\n        # blob H2D + event records); only the two codec kernels stay in Python.\n        #\n        # DEVICE meta buffers are 2-slot RINGED, in lockstep with the blob ring\n        # (``_dec_blob_ring``), and indexed by the SAME ``slot``.  This is\n        # REQUIRED for the load_kv_stream split: there the meta H2D runs on\n        # load_kv_stream while the decode kernel reads the meta on\n        # batch_decomp_stream, so a SINGLE persistent meta buffer would be\n        # overwritten by layer L+1's H2D while layer L's decode still reads it\n        # (an async IMA seen only at high batch / serve concurrency, where the\n        # longer decode lets the next H2D overtake it).  The blob was already\n        # double-buffered + gated by ``_dec_blob_consumed[slot]``; the meta now\n        # rides the SAME slot + consumed gate, so both are protected.  Non-split\n        # always uses slot 0 (everything on batch_decomp_stream → stream order\n        # serialises → safe), so slot-0 == the old single-buffer behaviour.\n        self._gi_dev_ring = [\n            torch.empty(5 * max_gpu_decomp_blocks, dtype=torch.int32,\n                        device='cuda') for _ in range(2)]\n        self._gu_dev_ring = [\n            torch.empty(2 * max_gpu_decomp_blocks, dtype=torch.uint8,\n                        device='cuda') for _ in range(2)]\n        self._gb_dev_ring = [\n            torch.empty(max_gpu_decomp_blocks, dtype=torch.int64,\n                        device='cuda') for _ in range(2)]\n        # slot-0 aliases retained for any non-decode reader / back-compat.\n        self._gi_dev = self._gi_dev_ring[0]\n        self._gu_dev = self._gu_dev_ring[0]\n        self._gb_dev = self._gb_dev_ring[0]\n        # Zero-copy uint8 views of the persistent-valid bytearrays (the\n        # bytearray object is allocated once here and only mutated in place,\n        # so the view stays valid for the process lifetime).\n        self._valid_t = {\n            lid: torch.from_numpy(np.frombuffer(\n                self._persistent_valid[lid], dtype=np.uint8))\n            for lid in range(n_layers)\n        }\n        self._use_cpp_prep = (\n            _p4f_ext is not None\n            and hasattr(_p4f_ext, \"decode_layer_prep\")\n            and os.getenv(\"TIERED_SERVE_KV_DECODE_CPP\", \"1\") == \"1\")\n        self._kv_pools_ready = True\n        # gpu_direct encode: prefer the single-kernel batched GPU compress\n        # (compress_batched) — per-block blobs written on device in one launch,\n        # no host scatter_fixed.  It emits the row_major_sm=1 / 0xFF-subtile\n        # format, so set the decode flag to match.  Escape hatch:\n        # TIERED_SERVE_KV_P4FLAT_GPU_LEAN=1 keeps the compress_lean path.\n        self._use_gpu_batched = (\n            self._USES_GPU_COMPRESS and _p4f_ext is not None\n            and hasattr(_p4f_ext, \"compress_batched\")\n            and os.getenv(\"TIERED_SERVE_KV_P4FLAT_GPU_LEAN\", \"0\") != \"1\")\n        if self._use_gpu_batched:\n            self._row_major_sm = 1\n            full_fixed = ((self._M_b // 64) * (self._K_b // 64) * 16\n                          + self._M_b * self._K_b // 2 + self._M_b * self._K_b\n                          + (self._M_b // 16) * (self._K_b // 16))\n            self._max_exc_pb = max(8, (self._raw_bytes - full_fixed) // 6 + 8)\n            logger.info(\"P4Flat GPU KV encoder: compress_batched (single kernel)\")\n\n        host_bytes = sum(\n            t.nbytes\n            for layer_pools in self._host_pools.values()\n            for kv_pool in layer_pools.values()\n            for t in kv_pool.values())\n        logger.info(\n            \"P4Flat KV buffers warmed up: block_shape=%s block_numel=%d \"\n            \"(M_b=%d K_b=%d) fixed=%dB raw=%dB blob_stride=%dB max_comp=%dB \"\n            \"max_n_blocks=%d max_gpu_decomp=%d n_layers=%d host=%.1fMB\",\n            block_shape, block_numel, M_b, K_b, fixed_bytes, raw_bytes,\n            blob_stride, max_comp_size, max_n_blocks, max_gpu_decomp_blocks,\n            n_layers, host_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n        trip — callers index/scatter with it directly).\"\"\"\n        # Nonblocking common case: make completed retired rows reusable before\n        # growing the high-water mark. This polls CUDA events; it never waits.\n        self._reap_retired_kv_slots(layer_id)\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_np = self._kv_slot_np[layer_id]            # authority (shared\n        # memory with the torch view self._kv_slot[layer_id])\n        prev = slot_np[bid_arr]\n        new_mask = prev < 0\n        n_new = int(new_mask.sum())\n        if n_new == 0:                                  # steady state: all owned\n            return prev\n        slot_blk = self._kv_slot_block[layer_id]\n        cap = len(slot_blk)\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        nb_list = bid_arr[new_mask].tolist()\n        # min-slot-first: refill freed holes (lowest slot first) before growing\n        # the high-water-mark, so the decode H2D range [0:hwm] stays compact.\n        new_slot_list = []\n        for _ in nb_list:\n            slot = -1\n            while heap:\n                cand = heapq.heappop(heap)\n                if cand in free_set:          # skip slots already folded by shrink\n                    free_set.discard(cand)\n                    slot = cand\n                    break\n            if slot < 0:\n                if hwm >= cap:\n                    # Preserve correctness under transient retired-slot\n                    # pressure by waiting for the oldest row only when the\n                    # physical pool is otherwise exhausted.\n                    self._kv_active_count[layer_id] = hwm\n                    if not self._reap_retired_kv_slots(\n                            layer_id, wait_for_one=True):\n                        raise RuntimeError(\n                            f\"P4Flat KV: persistent slot pool full for \"\n                            f\"layer={layer_id}\")\n                    hwm = self._kv_active_count[layer_id]\n                    while heap:\n                        cand = heapq.heappop(heap)\n                        if cand in free_set:\n                            free_set.discard(cand)\n                            slot = cand\n                            break\n                if slot < 0:\n                    if hwm >= cap:\n                        raise RuntimeError(\n                            f\"P4Flat KV: persistent slot pool full for \"\n                            f\"layer={layer_id} after retired-slot wait\")\n                    slot = hwm\n                    hwm += 1\n            new_slot_list.append(slot)\n        new_slots = np.asarray(new_slot_list, dtype=np.int64)\n        slot_np[bid_arr[new_mask]] = new_slots\n        out = prev.copy()\n        out[new_mask] = new_slots\n        for b, s in zip(nb_list, new_slot_list):\n            slot_blk[s] = b\n        self._kv_active_count[layer_id] = hwm\n        return out\n\n    def _release_kv_slot(self, layer_id: int, slot: int) -> None:\n        \"\"\"Return an already-detached physical slot to the reusable pool.\"\"\"\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id]