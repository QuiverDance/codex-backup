(M_b // 64) * (K_b // 64)\n        hb = num_tiles * 16\n        cb = M_b * K_b // 2\n        smb = M_b * K_b\n        cdb = (M_b // 16) * (K_b // 16)\n        self._idx_dtype = torch.int32\n        self._val_dtype = torch.int16\n        self._idx_es = 4\n        self._val_es = 2\n        self._row_major_sm = 1\n        return hb, cb, smb, cdb\n\n    # gpu_direct path is not supported on this subclass — it is the\n    # cpu_after_raw_swap encoder.  For GPU-side p4flat compression use the\n    # base P4FlatKVCompressor (selected by TIERED_SERVE_KV_COMP_PRODUCER=\n    # gpu_direct, which is the default for --kv-comp p4flat).\n    def compress_batch_async(self, layer_id, block_ids, gpu_k, gpu_v):\n        raise NotImplementedError(\n            \"P4FlatCPUKVCompressor is the CPU-encode (cpu_after_raw_swap) \"\n            \"backend; it does not support the gpu_direct producer.  For GPU \"\n            \"compression use TIERED_SERVE_KV_COMP_PRODUCER=gpu_direct (the \"\n            \"default for --kv-comp p4flat), which selects P4FlatKVCompressor.\")\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        self._release_kv_slot(layer_id, slot)\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        # The CPU producer can race scheduler free callbacks while its worker\n        # waits release the GIL. Serialize all slot ownership transitions.\n        with self._slot_state_lock:\n            return super()._assign_kv_slots(layer_id, block_ids)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Clear validity immediately and quarantine an in-flight slot.\n\n        The old CPU task may still write its captured ``slots_arr``. Keeping\n        that physical slot off the free heap until wait_compress_async retires\n        the task prevents it from corrupting a newly assigned block.\n        \"\"\"\n        with self._slot_state_lock:\n            valid = self._persistent_va