{"timestamp":"2026-08-26T03:31:04.548Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03c1f-12e4-7842-ba91-c98df8e33585","call_id":"call_Ib1PWAkIqcosVuVIe6Ai12qw","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        \"\"\"\n        Initializes the KV cache buffer with the correct size. The buffer needs\n        to be reshaped to the desired shape before being used by the models.\n\n        Args:\n            kv_cache_config: The KV cache config\n        Returns:\n            dict[str, torch.Tensor]: A map between layer names to their\n            corresponding memory buffer for KV cache.\n        \"\"\"\n        # Tiered-serve KV offloading: allocate dedicated blocks on HBM,\n        # offloadable blocks on LPDDR5 hugepages (set up later in\n        # gpu_worker._maybe_init_tiered_serve).\n        # Determine whether KV offloading is active (hugepage-backed LPDDR5).\n        offload_type = os.getenv(\"TIERED_SERVE_OFFLOAD_TYPE\", \"\")\n        kv_offload = (offload_type and \"kv\" in offload_type.lower()\n                      and os.getenv(\"TIERED_SERVE_REDUCE_KV_FOOTPRINT\",\n                                    \"0\") != \"1\"\n                      and os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\",\n                                    \"0\") != \"1\")\n\n        kv_cache_raw_tensors: dict[str, torch.Tensor] = {}\n        # For the hugepage path, compute the dedicated/offloadable\n        # split BEFORE allocating, so each per-layer raw tensor is sized for\n        # dedicated blocks only (on HBM).  The buffer + secondary are set up\n        # later in gpu_worker._maybe_init_tiered_serve.\n        num_dedicated_hbm = 0\n        num_offloadable_lpddr = 0\n        full_block_only = (\n            kv_offload\n            and os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\"\n            and os.getenv(\"TIERED_SERVE_KV_COMP_BACKEND\", \"\").lower()\n            in (\"p4flat\", \"p4flatcpu\")\n            and os.getenv(\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\"\n        )\n        # One request can own at most one partial tail. These rows are carved\n        # out of the already-budgeted per-layer dedicated HBM allocation, not\n        # added on top of it. The canonical scheduler capacity is reduced by S\n        # because the tail rows are backing storage for offloadable logical\n        # blocks rather than independently allocatable logical blocks.\n        tail_slots = self.max_num_reqs if full_block_only else 0\n        if kv_offload:\n            from tiered_serve.huge_page_allocator import (\n                allocator as hp_allocator,\n            )\n            import math as _math\n            num_blocks_total = kv_cache_config.num_blocks\n            n_kv_layers = len(kv_cache_config.kv_cache_tensors)\n            # Per-block raw bytes for one layer (from the first tensor)\n            first_tensor_size = kv_cache_config.kv_cache_tensors[0].size\n            per_block_bytes_raw = (first_tensor_size // num_blocks_total\n                                   if num_blocks_total > 0 else 0)\n\n            gpu_free, _ = torch.cuda.mem_get_info()\n            # Reserve must cover everything allocated AFTER this planner AND the\n            # runtime transients vLLM's profiling did NOT measure:\n            #   * the HBM decode buffer(s) (gpu_worker allocates these LATER —\n            #     up to ~3.6 GiB for the DOUBLE raw-KV parity buffer),\n            #   * the LARGE eager-prefill activations — vLLM profiles peak\n            #     activations at decode/captured sizes, so an 8192-token prefill\n            #     chunk's MLP intermediates (e.g. inductor's gate_up buf\n            #     N*57344*2 ≈ 0.9 GiB) + the fused-mm decomp output scratch\n            #     (~1.4 GiB) are NOT in gpu_free and must come out of here,\n            #   * CUDA graphs (~0.4-0.7 GiB), cuBLAS workspace, sampler\n            