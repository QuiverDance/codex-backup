stration BEFORE this piecewise graph\\n@@ -1082,6 +1095,7 @@ class TieredServeCUDAGraphWrapper(CUDAGraphWrapper):\\n     # ------------------------------------------------------------------\\n     # After replay\\n     # ------------------------------------------------------------------\\n+    @_nsys_trace.call(\\\"CPU.Graph.Post\\\", \\\"setup\\\", key=(\\\"graph_idx\\\", \\\"idx\\\"), prefix=\\\"G\\\")\\n     def _after_replay(self, dm, idx: int, n_graphs: int,\\n                       n_layers: int, kv_split: bool):\\n         \\\"\\\"\\\"Post-replay orchestration.\\n@@ -1215,7 +1229,10 @@ class TieredServeCUDAGraphWrapper(CUDAGraphWrapper):\\n                 dm._v1_kv_wait_begin_events[graph_idx].record(cur_stream)\\n             if _ENV_KV_DETAILED_NVTX:\\n                 torch.cuda.nvtx.range_push(f\\\"wait_kv G{graph_idx}\\\")\\n-            cur_stream.wait_event(dm.exec_attn_barriers[graph_idx])\\n+            if _nsys_trace.ENABLED:\\n+                _nsys_trace.enqueue_kv_wait(cur_stream, dm.exec_attn_barriers[graph_idx], graph_idx)\\n+            else:\\n+                cur_stream.wait_event(dm.exec_attn_barriers[graph_idx])\\n             if _ENV_KV_DETAILED_NVTX:\\n                 torch.cuda.nvtx.range_pop()\\n             if timing:\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Run the unchanged vLLM workload; signal before yielding request ordinal N.\\\"\\\"\\\"\\nfrom __future__ import annotations\\nimport functools\\nimport hashlib\\nimport inspect\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport time\\n\\n\\ndef wrap_requests(original, target: int, directory: Path):\\n    @functools.wraps(original)\\n    async def generate(*args, **kwargs):\\n        ordinal = 0\\n        shape_digest = hashlib.sha256()\\n        async for item in original(*args, **kwargs):\\n            ordinal += 1\\n            request = item[0] if isinstance(item, (tuple, list)) else item\\n            prompt_len = getattr(request, \\\"prompt_len\\\", None)\\n            output_len = getattr(request, \\\"expected_output_len\\\", getattr(request, \\\"output_len\\\", None))\\n            # Only a lengths digest is stored; no prompt contents or private text.\\n            shape_digest.update(json.dumps([prompt_len, output_len], default=str).encode() + b\\\"\\\\n\\\")\\n            if ordinal == target:\\n                value = dict(\\n                    request_ordinal=ordinal,\\n                    client_monotonic_ns=time.monotonic_ns(),\\n                    prompt_len=prompt_len, output_len=output_len,\\n                    input_lengths_prefix_sha256=shape_digest.hexdigest(),\\n                    definition=\\\"Before yielding Nth offered benchmark request; NOT completion order and NOT server acceptance.\\\")\\n                path = directory / \\\"trigger.json\\\"\\n                temporary = directory / f\\\"trigger.{os.getpid()}.tmp\\\"\\n                temporary.write_text(json.dumps(value, default=str) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n                os.replace(temporary, path)\\n            yield item\\n    return generate\\n\\n\\ndef main():\\n    directory = Path(os.environ[\\\"TIERED_SERVE_NSYS_DIR\\\"])\\n    target = int(os.environ[\\\"TIERED_SERVE_NSYS_START_REQUEST\\\"])\\n    if target < 1 or not directory.is_dir():\\n        raise SystemExit(\\\"Invalid Nsight capture directory / request ordinal\\\")\\n    if (directory / \\\"trigger.json\\\").exists():\\n        raise SystemExit(\\\"Stale trigger exists; use a fresh suite output directory\\\")\\n    import vllm.benchmarks.serve as serve\\n    if not inspect.isasyncgenfunction(getattr(serve, \\\"get_request\\\", None)):\\n        raise SystemExit(\\\"Installed vLLM needs async-generator vllm.benchmarks.serve.get_request\\\")\\n    serve.get_request = wrap_requests(serve.get_request, target, directory)\\n    from vllm.entrypoints.cli.main import main as cli_main\\n    cli_main()\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Fail the suite on a missing/truncated window; do not invent GPU measurements.\\\"\\\"\\\"\\nimport argparse\\nimport json\\nfrom pathlib import Path\\nimport sys\\n\\n\\ndef validate(directory, count):\\n    for name in (\\\"trace.nsys-rep\\\", \\\"capture.json\\\", \\\"capture_forwards.csv\\\", \\\"capture_kv_layers.csv\\\", \\\"trigger.json\\\"):\\n        file = directory / name\\n        if not file.is_file() or file.stat().st_size == 0:\\n            raise ValueError(f\\\"Missing capture artifact: {file}\\\")\\n    value = json.loads((directory / \\\"capture.json\\\").read_text())\\n    rows = value.get(\\\"forwards\\\", [])\\n    selected = [r for r in rows if r.get(\\\"window\\\") == \\\"MEASURE\\\"]\\n    if not value.get(\\\"complete\\\") or len(selected) != count or len(rows) != count + 4:\\n        raise ValueError(\\\"Capture is incomplete or has an incorrect forward count\\\")\\n    if value.get(\\\"performance_metrics_valid\\\") is not False:\\n        raise ValueError(\\\"Profiling output must not be marked as a canonical performance run\\\")\\n    for row in selected:\\n        b = row.get(\\\"kv_bytes\\\", {})\\n        if b.get(\\\"bytes_complete\\\") != 1 or b.get(\\\"kv_h2d_bytes\\\") is None:\\n            raise ValueError(f\\\"Missing/incomplete KV byte accounting at forward {row.get('forward')}\\\")\\n        if b.get(\\\"timing_complete\\\") != 0:\\n            raise ValueError(\\\"Unexpected GPU timing collector was enabled\\\")\\n    warnings = list(value.get(\\\"warnings\\\", []))\\n    if not any(r.get(\\\"phase\\\") == \\\"DECODE\\\" for r in selected):\\n        warnings.append(\\\"No pure decode in the window; capture later for decode comparisons\\\")\\n    if not any(r.get(\\\"history_matches_decode_batch\\\") for r in selected):\\n        warnings.append(\\\"Host context-length metadata is unavailable or does not match a decode batch\\\")\\n    if not any(r[\\\"kv_bytes\\\"].get(\\\"kv_h2d_bytes\\\", 0) > 0 for r in selected):\\n        warnings.append(\\\"No KV H2D in this window; it cannot answer the offloaded-KV question\\\")\\n    for warning in warnings:\\n        print(f\\\"[nsys] WARNING: {warning}\\\", file=sys.stderr)\\n    print(f\\\"[nsys] capture: {directory}; measure={len(selected)} forwards\\\")\\n\\n\\ndef main():\\n    p = argparse.ArgumentParser(description=__doc__)\\n    p.add_argument(\\\"directory\\\", type=Path)\\n    p.add_argument(\\\"--forwards\\\", type=int, required=True)\\n    args = p.parse_args()\\n    try:\\n        validate(args.directory, args.forwards)\\n    except (OSError, ValueError, KeyError) as e:\\n        raise SystemExit(f\\\"[nsys] ERROR: {e}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"1f7d7b\",\"wall_time_seconds\":0.000012833,\"exit_code\":0,\"original_token_count\":2011,\"output\":\"\\\"\\\"\\\"Bounded Nsight/NVTX instrumentation for CD3-weight + RAW/CSR-KV serving.\\n\\nAll ranges describe host code / submissions, NEVER GPU busy time. No timing\\nCUDA events are created. Byte accounting is active only inside the window and\\nis buffered until cudaProfilerStop. Disabled decorators are identity functions.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport atexit\\nimport csv\\nimport ctypes\\nimport ctypes.util\\nimport functools\\nimport inspect\\nimport json\\nimport numbers\\nimport os\\nfrom pathlib import Path\\nimport threading\\nimport time\\n\\nPATCH_VERSION = \\\"csr-nsys-v2-fe133f9\\\"\\nENABLED = os.getenv(\\\"TIERED_SERVE_NSYS_TRACE\\\", \\\"0\\\") == \\\"1\\\"\\n_COUNT = int(os.getenv(\\\"TIERED_SERVE_NSYS_FORWARDS\\\", \\\"32\\\"))\\n_GUARD = 2\\n_DIR = os.getenv(\\\"TIERED_SERVE_NSYS_DIR\\\", \\\"\\\")\\n_EXPECTED_MODE = os.getenv(\\\"TIERED_SERVE_NSYS_KV_MODE\\\", \\\"unknown\\\")\\n_TRIGGER_PATH = os.path.join(_DIR, \\\"trigger.json\\\")\\n_domain = None\\n_attrs = {}\\n_active = False\\n_done = False\\n_capture_started = False\\n