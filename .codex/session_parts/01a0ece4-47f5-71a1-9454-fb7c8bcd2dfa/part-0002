".\\\") if tail else ():\\n                    value = getattr(value, attr, None)\\n            value = _integer(value)\\n            comp = None\\n            if comp_pos is not None:\\n                comp = args[comp_pos] if comp_pos < len(args) else kwargs.get(component)\\n                comp = _component(comp)\\n            title_key = (value, comp)\\n            title = titles.get(title_key)\\n            if title is None:\\n                title = label\\n                if value is not None:\\n                    title += f\\\" {prefix}{value:03d}\\\"\\n                if comp:\\n                    title += \\\" \\\" + comp\\n                titles[title_key] = title\\n            _push(title, category)\\n            try:\\n                return fn(*args, **kwargs)\\n            finally:\\n                _pop()  # balanced even if capture stops on another host thread\\n        return wrapped\\n    return decorate\\n\\n\\ndef note_plan(layer, hit):\\n    if _active:\\n        _mark(f\\\"CPU.KV.Plan.{'REUSE' if hit else 'REBUILD'} L{int(layer):03d}\\\")\\n\\n\\ndef _cpu_list(value, count):\\n    \\\"\\\"\\\"Copy only an already-host-resident vector. No device transfer fallback.\\\"\\\"\\\"\\n    if value is None:\\n        return None\\n    device = getattr(value, \\\"device\\\", None)\\n    if device is not None and str(device) != \\\"cpu\\\":\\n        return None\\n    if isinstance(value, (list, tuple)):\\n        result = value[:count]\\n    elif hasattr(value, \\\"tolist\\\"):\\n        result = value[:count].tolist()\\n    else:\\n        return None\\n    if not isinstance(result, list) or len(result) != count:\\n        return None\\n    if not all(isinstance(v, numbers.Integral) for v in result):\\n        return None\\n    return [int(v) for v in result]\\n\\n\\ndef observe_input_batch(input_batch):\\n    \\\"\\\"\\\"Called before prepare_tail_step's full-block-only early return.\\n\\n    The existing vLLM hook calls prepare_tail_step for raw AN