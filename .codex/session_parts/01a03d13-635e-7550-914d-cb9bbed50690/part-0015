{"timestamp":"2026-08-27T09:23:15.864Z","ordinal":947,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a04287-df18-7340-87fe-552dc418406c","call_id":"call_mbaVNSjdwrTNDsQecn8qYYd8","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\nelse:\n    import logging as _logging\n    _logging.getLogger(\"vllm\").warning(\n        \"nvcomp_ext disabled: nvcomp SDK headers (nvcomp/gdeflate.hpp) not \"\n        \"found under /usr/include/nvcomp_13|12. Install libnvcomp-dev or \"\n        \"the nvcomp CUDA SDK package to enable nvcomp-backed compressors.\")\n\n# Wait for every build; surface the first failure (same behaviour as the old\n# sequential imports, just without serialising the compiles).\n_exts = {_name: _future.result() for _name, _future in _futures.items()}\n_build_pool.shutdown()\n\n# Restore original TORCH_CUDA_ARCH_LIST / MAX_JOBS\nif _old_arch_list is not None:\n    _os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _old_arch_list\nelse:\n    _os.environ.pop(\"TORCH_CUDA_ARCH_LIST\", None)\nif _old_max_jobs is None:\n    _os.environ.pop(\"MAX_JOBS\", None)\n\nhuge_page_allocator_ext = _exts[\"huge_page_allocator\"]\n\nunload_worker_ext = _exts[\"unload_worker_ext\"]\nsys.modules['tiered_serve.cpp_exts.unload_worker_ext'] = unload_worker_ext\n\nzipserv_ext = _exts[\"zipserv_ext\"]\n\nzipserv_p4flat_ext = _exts[\"zipserv_p4flat_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4flat_ext'] = zipserv_p4flat_ext\n\nzipserv_ot_ext = _exts[\"zipserv_ot_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_ot_ext'] = zipserv_ot_ext\n\nzipserv_p4wg_ext = _exts[\"zipserv_p4wg_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4wg_ext'] = zipserv_p4wg_ext\n\nzipserv_p3flat_fp8_ext = _exts[\"zipserv_p3flat_fp8_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p3flat_fp8_ext'] = zipserv_p3flat_fp8_ext\n\nzipserv_p4d16_ext = _exts[\"zipserv_p4d16_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4d16_ext'] = zipserv_p4d16_ext\n\nzipserv_fp8_ext = _exts[\"zipserv_fp8_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_fp8_ext'] = zipserv_fp8_ext\n\ndietgpu_fp8_reconstruct_ext = _exts[\"dietgpu_fp8_reconstruct_ext\"]\n\"\"\"tiered_serve.compression.core — codec-core Python.\n\nHolds one module per codec (``zipserv``, ``dietgpu``, ``ublb``, ...).\nEach module defines its ``Compressed*Tensor`` and ``*Compressor`` class\nwithout depending on KV-cache / serving-side concepts — those live in\n``tiered_serve.compression.adapters``.\n\nThis package exposes the public symbols at the package level so new\ncode can write ``from tiered_serve.compression.core import\nUBLBCompressor``.  Legacy imports through ``tiered_serve.tensor_compressor``\ncontinue to work via that module's facade re-exports.\n\"\"\"\nfrom tiered_serve.compression.core.base import (\n    BaseExpConfig,\n    SplitStorageInfo,\n    _h2d_record_stream,\n)\nfrom tiered_serve.compression.core.ublb import (\n    CompressedUBLBTensor,\n    UBLBCompressor,\n)\nfrom tiered_serve.compression.core.ublb_tbe import (\n    CompressedUBLBTBETensor,\n    UBLBTBECompressor,\n    CompressedUBLBFlatTensor,\n    UBLBFlatCompressor,\n)\nfrom tiered_serve.compression.core.zipserv import (\n    CompressedZipServTensor,\n    ZipServCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu import (\n    _ensure_dietgpu_loaded,\n    CompressedDietGPUTensor,\n    DietGPUCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu_fp8 import (\n    _fp8_kind_of,\n    CompressedDietGPUFP8Tensor,\n    DietGPUFP8Compressor,\n)\nfrom tiered_serve.compression.core.zipserv_fp8 import (\n    CompressedZipServFP8GpuTensor,\n    ZipServFP8GpuCompressor,\n)\nfrom tiered_serve.compression.core.p4flat import (\n    CompressedP4FlatTensor,\n    P4FlatCompressor,\n)\nfrom tiered_serve.compression.core.p3flat_fp8 import (\n    CompressedP3FlatFP8Tensor,\n    P3FlatFP8Compressor,\n)\nfrom tiered_serve.compression.core.p4d16 import (\n    CompressedP4D16Tensor,\n    P4D16Compressor,\n)\nfrom tiered_serve.compression.core.auto import _AutoWeightCompressor\n\n__all__ = [\n    \"BaseExpConfig\",\n    \"SplitStorageInfo\",\n    \"_h2d_record_stream\",\n    \"CompressedUBLBTensor\",\n    \"UBLBCompressor\",\n    \"CompressedUBLBTBETensor\",\n    \"UBLBTBECompressor\",\n    \"CompressedUBLBFlatTensor\",\n    \"UBLBFlatCompressor\",\n    \"CompressedZipServTensor\",\n    \"ZipServCompressor\",\n    \"_ensure_dietgpu_loaded\",\n    \"CompressedDietGPUTensor\",\n    \"DietGPUCompressor\",\n    \"_fp8_kind_of\",\n    \"CompressedDietGPUFP8Tensor\",\n    \"DietGPUFP8Compressor\",\n    \"CompressedZipServFP8GpuTensor\",\n    \"ZipServFP8GpuCompressor\",\n]\n\"\"\"Legacy facade for the codec compressor implementations.\n\nEvery public symbol that used to live here is now exposed by a module\nunder :mod:`tiered_serve.compression.core`.  This file keeps the\nhistorical import path working so external code can continue to write\n``from tiered_serve.tensor_compressor import UBLBCompressor`` (or any\nof the other compressors) without modification.\n\nNew code should prefer the canonical paths under ``compression.core``.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\n\nimport torch  # noqa: F401  — re-exported for callers that imported it transitively\n\nfrom tiered_serve.compressor_base import TensorCompressor  # noqa: F401\n\n# ── Re-exports from compression.core ──\n# Canonical definitions live in tiered_serve.compression.core.* — this\n# module never holds a second copy.\nfrom tiered_serve.compression.core.base import (  # noqa: F401\n    BaseExpConfig,\n    SplitStorageInfo,\n    _h2d_record_stream,\n)\nfrom tiered_serve.compression.core.ublb import (  # noqa: F401\n    CompressedUBLBTensor,\n    UBLBCompressor,\n)\nfrom tiered_serve.compression.core.ublb_tbe import (  # noqa: F401\n    CompressedUBLBTBETensor,\n    UBLBTBECompressor,\n    CompressedUBLBFlatTensor,\n    UBLBFlatCompressor,\n)\nfrom tiered_serve.compression.core.zipserv import (  # noqa: F401\n    CompressedZipServTensor,\n    ZipServCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu import (  # noqa: F401\n    _DIETGPU_WORKSPACE_BYTES,\n    _dietgpu_workspace_bytes,\n    _DIETGPU_LIB_SEARCH_PATHS,\n    _ensure_dietgpu_loaded,\n    CompressedDietGPUTensor,\n    DietGPUCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu_fp8 import (  # noqa: F401\n    _HAS_DIETGPU_FP8_CUDA,\n    _FP8_DTYPE_PARAMS,\n    _pack_raw_to_sm_nibbles,\n    _pack_raw_to_exp_nibbles,\n    _unpack_sm_nibbles_u8,\n    _unpack_exp_nibbles_u8,\n    _fp8_kind_of,\n    CompressedDietGPUFP8Tensor,\n    DietGPUFP8Compressor,\n)\nfrom tiered_serve.compression.core.zipserv_fp8 import (  # noqa: F401\n    _HAS_ZSV_FP8_GPU,\n    CompressedZipServFP8GpuTensor,\n    ZipServFP8GpuCompressor,\n)\nfrom tiered_serve.compression.core.p4flat import (  # noqa: F401\n    _HAS_P4FLAT,\n    CompressedP4FlatTensor,\n    P4FlatCompressor,\n)\nfrom tiered_serve.compression.core.zipserv_ot import (  # noqa: F401\n    _HAS_ZSV_OT,\n    CompressedZipServOTTensor,\n    ZipServOTCompressor,\n)\nfrom tiered_serve.compression.core.p3flat_fp8 import (  # noqa: F401\n    _HAS_P3FLAT_FP8,\n    CompressedP3FlatFP8Tensor,\n    P3FlatFP8Compressor,\n)\nfrom tiered_serve.compression.core.p4d16 import (  # noqa: F401\n    _HAS_P4D16,\n    CompressedP4D16Tensor,\n    P4D16Compressor,\n)\nfrom tiered_serve.compression.core.auto import (  # noqa: F401\n    _AutoWeightCompressor,\n)\n\n\nlogger = logging.getLogger(\"vllm\")\n\"\"\"KV GPU decompress (decode) latency + throughput on the production decode\npath: decompress_batch -> decompress_batched (one batched CUDA kernel over the\nGPU-resident compressed block pool), for p4flat and ublb_flat.\n\nKV is compressed once (host encode) to populate the pool; only the GPU batched\ndecode is timed.  Independent of OMP_NUM_THREADS (pure GPU kernel + the codec's\ninternal staging).  GiB/s is over the decoded raw BF16 bytes (K+V).  This is the\ndecode side of the serving dense \"decomp+attention\" path; the encode side is\nkv_cpu_encode.py.\n\nRun from tiered-serve:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmarks/kv_gpu_decode.py [--limit N]\n\"\"\"\nimport argparse\nimport time\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048]            # decodes N of a 2N pool (scatter test needs 2x slots)\n\n\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns):\n    comp = cls(torch.cuda.Stream())\n    pool = 2 * max(ns)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=pool, n_layers=1,\n                           max_gpu_blocks=pool, max_gpu_decomp_blocks=pool)\n    print(f\"  {name}\")\n    for N in ns:\n        # Compress 2N blocks (slots 0..2N-1), then decode N of them two ways:\n        #   contig  = block ids [0..N-1]      -> slots 0..N-1   (sequential reads)\n        #   scatter = block ids [0,2,..,2N-2] -> slots 0,2,..   (paged/fragmented,\n        #             the production pattern where block_table is non-contiguous)\n        # decompress_batch writes output id-indexed (kc[id]=block id), so kc is\n        # sized 2N and we compare/measure only the decoded subset.\n        M = 2 * N\n        comp._kv_active_count[0] = 0; comp._kv_slot[0].fill_(-1)\n        comp.compress_batch_async_from_host(0, list(range(M)), hk[:M].contiguous(),\n                                            hv[:M].contiguous(), 0)\n        comp.wait_compress_async(0, BS)\n        kc = torch.zeros(M, *BS, dtype=torch.bfloat16, device=\"cuda\")\n        vc = torch.zeros_like(kc)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        for label, dids in [(\"contig\", list(range(N))),\n                            (\"scatter\", list(range(0, M, 2)))]:\n            comp.decompress_batch(0, dids, (kc, vc)); torch.cuda.synchronize()\n            sel = torch.tensor(dids)\n            ke = (kc[sel].cpu() - hk[sel]).abs().max().item()\n            ve = (vc[sel].cpu() - hv[sel]).abs().max().item()\n            best = 1e9\n            for _ in range(20):\n                torch.cuda.synchronize(); t0 = time.perf_counter()\n                comp.decompress_batch(0, dids, (kc, vc))\n                torch.cuda.synchronize(); best = min(best, time.perf_counter() - t0)\n            print(f\"     N={N:>4} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\"\n                  f\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\")\n        del kc, vc; torch.cuda.empty_cache()\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--limit\", type=int, default=max(NS))\n    args = ap.parse_args()\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\n    hk, hv = load(2 * max(ns))\n    for cls, name in [(P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\")]:\n        bench(cls, name, hk, hv, ns)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"CPU encode LATENCY + GiB/s + GPU-decode bit-exactness for the production KV\npath (compress_batch_async_from_host -> C++ CPU encoder -> GPU\ndecompress_batch), for p4flat, ublb_flat, bitcomp, and zipserv.\n\nUse OMP_NUM_THREADS for the OpenMP codecs and\nTIERED_SERVE_KV_COMPRESS_WORKERS for worker-pool codecs.\"\"\"\nimport os\nimport sys\nimport time\n\n# Make the repository package importable during direct script execution.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor, _factor_64\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\nfrom tiered_serve.compression.core.zipserv import ZipServCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048, 4096]\n\n\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv):\n    comp = cls(torch.cuda.Stream())\n    max_blocks = max(NS)\n    host_pool_blocks = max_blocks\n    if issubclass(cls, ZipServCompressor):\n        # ZipServ's size-class slub allocator reserves payloads in chunks.\n        # Keep capacity headroom when this benchmark fills every logical slot.\n        host_pool_blocks += max(64, max_blocks // 4)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=host_pool_blocks,\n                           n_layers=1,\n                           max_gpu_blocks=max_b