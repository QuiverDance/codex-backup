_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\nelse:\n    import logging as _logging\n    _logging.getLogger(\"vllm\").warning(\n        \"nvcomp_ext disabled: nvcomp SDK headers (nvcomp/gdeflate.hpp) not \"\n        \"found under /usr/include/nvcomp_13|12. Install libnvcomp-dev or \"\n        \"the nvcomp CUDA SDK package to enable nvcomp-backed compressors.\")\n\n# Wait for every build; surface the first failure (same behaviour as the old\n# sequential imports, just without serialising the compiles).\n_exts = {_name: _future.result() for _name, _future in _futures.items()}\n_build_pool.shutdown()\n\n# Restore original TORCH_CUDA_ARCH_LIST / MAX_JOBS\nif _old_arch_list is not None:\n    _os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _old_arch_list\nelse:\n    _os.environ.pop(\"TORCH_CUDA_ARCH_LIST\", None)\nif _old_max_jobs is None:\n    _os.environ.pop(\"MAX_JOBS\", None)\n\nhuge_page_allocator_ext = _exts[\"huge_page_allocator\"]\n\nunload_worker_ext = _exts[\"unload_worker_ext\"]\nsys.modules['tiered_serve.cpp_exts.unload_worker_ext'] = unload_worker_ext\n\nzipserv_ext = _exts[\"zipserv_ext\"]\n\nzipserv_p4flat_ext = _exts[\"zipserv_p4flat_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4flat_ext'] = zipserv_p4flat_ext\n\nzipserv_ot_ext = _exts[\"zipserv_ot_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_ot_ext'] = zipserv_ot_ext\n\nzipserv_p4wg_ext = _exts[\"zipserv_p4wg_ext\"]\nsys.modules['tiered_serve.cpp_