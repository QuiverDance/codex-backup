 LPDDR\n# copy; today prefill ALWAYS H2Ds the uncompressed one (no chunk gating). Below\n# this per-codec chunk threshold, prefill instead H2Ds + FULL-decompresses the\n# compressed copy. Same slack model as the frozen_split knob\n# (thr = (T_load_raw - T_decomp)/T_gemm_per_token) but with DISTINCT inputs:\n# offload does the FULL-blob decompress (vs frozen_split's cheap exp-only), so\n# T_decomp is much larger, AND offload configs (e.g. flexgen-comp) typically\n# keep half the layers frozen_uncompressed, so fewer layers load -> smaller\n# T_load_raw. Both shrink the slack -> a MUCH lower threshold than frozen_split.\n#   codec    thr   source\n#   zipserv  384   flexgen-comp slack model: load_raw 182 / full decomp 109 ->\n#                  slack 73 -> 384 (vs cao's 1330 — same codec, different config).\n# Codecs without an entry resolve to 0 (disabled = always-uncompressed prefill,\n# i.e. unchanged behaviour). Per-config; override via\n# TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK (same \"<codec>=<n>,...|<int>\" syntax).\n_OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS = {\n    \"zipserv\": 384,   # flexgen-comp (offload, full decompress -> small slack)\n}\n\n_ENV_FROZEN_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_FROZEN_DETAILED_NVTX\", \"0\") == \"1\")\n_ENV_WLOAD_GRAPH = os.getenv(\"TIERED_SERVE_WLOAD_GRAPH\", \"0\") == \"1\"\n_ENV_WLOAD_GRAPH_SEPARATE = (\n    os.getenv(\"TIERED_SERVE_WLOAD_GRAPH_SEPARATE\", \"0\") == \"1\")\n_ENV_ANY_WLOAD_GRAPH = _ENV_WLOAD_GRAPH or _ENV_WLOAD_GRAPH_SEPARATE\n            dietgpu_attrs = (\n                (\"raw_exp\",)\n                if (os.getenv(\"TIERED_SERVE_FROZEN_RAW_EXP\", \"0\") == \"1\"\n                    and comped.raw_exp is not None)\n                else SplitStorageInfo._DIETGPU_LPDDR_ATTRS)\n            return (\"dietgpu\",\n                    dietgpu_attrs,\n                    {\"exp_compressed_size\": comped.exp_compressed_size,\n                     \"M\": comped.M, \"K\": comped.K})\n        if isinstance(compe