  output3 |= static_cast<uint64_t>(value) << (lane * 16);\n    }\n}\n\n__device__ __forceinline__ void store_output(\n    uint16_t* output,\n    int tile,\n    int thread,\n    int columns,\n    uint64_t output0,\n    uint64_t output1,\n    uint64_t output2,\n    uint64_t output3)\n{\n    const int tiles_per_row = columns / kTileDim;\n    const int tile_row = tile / tiles_per_row;\n    const int tile_column = tile - tile_row * tiles_per_row;\n    const int local_row = thread >> 2;\n    const int local_column = (thread & 3) * kElementsPerThread;\n    uint16_t* destination = output\n        + static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n        + tile_column * kTileDim + local_column;\n    auto* vectors = reinterpret_cast<ulonglong2*>(destination);\n    vectors[0] = make_ulonglong2(output0, output1);\n    vectors[1] = make_ulonglong2(output2, output3);\n}\n\n__device__ __forceinline__ uint32_t unpack_entry17(\n    const uint8_t* entries,\n    int64_t index)\n{\n    const int64_t bit = index * 17;\n    const int64_t byte = bit >> 3;\n    const int shift = static_cast<int>(bit & 7);\n    const uint32_t word = static_cast<uint32_t>(entries[byte])\n        | (static_cast<uint32_t>(entries[byte + 1]) << 8)\n        | (static_cast<uint32_t>(entries[byte + 2]) << 16);\n    return (word >> shift) & 0x1ffffu;\n}\n\n__device__ __forceinline__ int64_t source_base_for_thread(\n    int tile,\n    int thread,\n    int columns)\n{\n    const int tiles_per_row = columns / kTileDim;\n    const int tile_row = tile / tiles_per_row;\n    const int tile_column = tile - tile_row * tiles_per_row;\n    const int local_row = thread >> 2;\n    const int column_group = thread & 3;\n    return static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n        + tile_column * kTileDim\n        + column_group * kElementsPerThread;\n}\n\n__global__ void CompressTilePalette3Pass1Kernel(\n    const uint16_t* __restrict__ source,\n    uint8_t* __restrict__ palettes8,\n    uin