ressed) routes the forward through :meth:`linear_apply`, which\n    fuses decode into the P4-RS register-A WGMMA GEMM (the same RS-mode recipe\n    as ublb-flat, applied to the p4flat codec).  For token counts above the\n    per-shape :meth:`_fused_max_n_for` threshold it falls back to decompress +\n    ``F.linear`` (faster in the prefill / compute-bound regime).  The fused path\n    is bit-exact: the rare out-of-palette exceptions (decoded with a wrong\n    exponent on the RS kernel) are restored by a sparse rank-1 correction\n    (``p4_exc_correct``).\n    \"\"\"\n\n    HAS_FUSED_MM = True\n    _warned_exc = False\n\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\n        super().__init__(comp_stream)\n        if not _HAS_P4FLAT:\n            raise RuntimeError(\n                \"P4FlatCompressor requires tiered-serve's \"\n                \"zipserv_p4flat_ext extension to build successfully.\")\n        # Per-shape fused threshold lives in _fused_max_n_for / _FUSED_MAX_N_TABLE.\n        # tests/benchmarks may set this instance attr directly to force-fuse at\n        # all N.  ``decompress`` runs on the current stream (no comp_stream\n        # switch), CUDA-graph capture-safe, so a captured decode batch above a\n        # shape's threshold can fall back to decompress without breaking capture.\n        self._fused_max_n_override = None\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedP4FlatTensor] = None,\n        _sync: bool = True,\n    ) -> CompressedP4FlatTensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"P4FlatCompressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"P4FlatCompressor expects a 2-D tensor, got {tuple(weight.shape)}\")\n\n        c_struct = _p4f_ext.compress(weight)\n        comp = CompressedP4FlatTensor(c_struct)\n        if decomp_output_tensor is not None:\n            comp.output_tensor = decomp_output_tensor\n        if _sync:\n            ratio = weight.nbytes / max(1, comp.nbytes)\n            logger.info(\n                f\"P4Flat compress [{comp.M}x{comp.K}]: ratio={ratio:.2f}x  \"\n                f\"nbytes={comp.nbytes}  num_exceptions={comp.num_exceptions}\")\n        return comp\n\n    def decompress(\n        self,\n        comp: CompressedP4FlatTensor,\n        output: Optional[torch.Tensor] = None,\n        *,\n        begin_event: Optional[torch.cuda.Event] = None,\n        end_event: Optional[torch.cuda.Event] = None,\n    ) -> torch.Tensor:\n        if not isinstance(comp, CompressedP4FlatTensor):\n            raise TypeError(\n                f\"P4FlatCompressor.decompress expects CompressedP4FlatTensor, \"\n                f\"got {type(comp).__name__}\")\n        if output is None:\n            output = comp.output_tensor\n        # Single (current) stream — no comp_stream switch.  The decompressed\n        # weight is consumed immediately by the caller (F.linear), so running\n        # the decompress on a separate stream buys no overlap; it only (a) broke\n        # CUDA-graph capture (\"operation not permitted when stream is\n        # capturing\", since comp_stream isn't part of the capture) and (b) left\n        # a cross-stream ordering gap vs the consuming GEMM.  Running on the\n        # current stream is capture-safe and keeps decompress -> GEMM correctly\n        # ordered.  Timing events, when provided, record on the current stream.\n        if begin_event is not None:\n            begin_event.record()\n        result = _p4f_ext.decompress(comp._c, output)\n        if end_event is not None:\n            end_event.record()\n        return result\n\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def decompress_batch(self, *args, **kwargs):\n        return super().decompress_batch(*args, **kwargs)\n\n    # Per-(M, K) fused threshold: use the P4-RS fused kernel for N <= value,\n    # else decompress + cuBLAS.  These MUST be tuned in the engine, not in an\n    # isolated GEMM bench: decomp+cuBLAS writes the full reconstructed BF16\n    # weight to HBM (O 134MB, Down 470MB, GateUp 940MB), and in the serving\n    # engine that write contends with the concurrent weight-offload H2D on the\n    # HBM write path.  An isolated sweep (/tmp/thr_sweep.py) has no H2D overlap\n    # so it wrongly favours decomp for O/Down; in-engine batch-128 the fused\n    # path (no HBM write, no contention) is faster for O/GateUp/Down.  Measured\n    # in-engine (vllm_offload_kvweight --batch 128):\n    # In-engine TPOT (vllm_offload_kvweight --batch N), measured 2026-06-05:\n    #   batch 128: O/GU/Down fused, QKV decomp = 189.65ms (all-fused incl QKV\n    #     192.30 -> QKV's RS kernel is too slow even with contention; decomp\n    #     O/Down per isolated-optimal = 194.20 -> WORSE, contention dominates).\n    #   batch 256: GU/Down fused (256) = 321.67 vs GU/Down decomp (192) = 331.11\n    #     -> fusing wins by 9.4ms even at N=256 (isolated bench says decomp here,\n    #     but the engine HBM-write contention flips it).\n    # That measurement supported fusing O/GateUp/Down broadly, but keep the\n    # live table scoped to the batch-128 serving range we are validating now;\n    # N>256 (prefill) decompresses anyway via fallback.\n    # The isolated+H2D benchmark below crossed over to decompress+cuBLAS earlier\n    # for O/Down, but the batch-128 serving trace regressed in exactly that\n    # region: dense materialization pushes the frozen-weight scheduling gap into\n    # every decode graph.  Keep QKV conservative, but restore O/Down to the\n    # in-engine batch-128 fused range.\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused WINS or is a noise-level TIE (<=2%) vs decmp\n        # under H2D -- a tie favours fused anyway (no dense-weight HBM write).\n        #\n        # QKV fuses (=64) like the rest.  The fused path is the RS kernel (approx) + a\n        # SEPARATE p4_exc_correct kernel (one block per out-of-palette exception);\n        # decompress pays no exception cost, so a HIGH-exception layer can flip\n        # fused below decomp.  But a PER-LAYER, real-weight sweep (all 80 Llama-70B\n        # layers @ N=64, H2D) showed fused WINS 78/80 QKV layers (~1.13x); only the\n        # 2 extreme early layers lose (layer0 314k exc -> 0.44x, layer1 39k ->\n        # 0.96x).  O 77/80 (3 are noise-level ~1.0x), GateUp 80/80 (even layer0\n        # 113k exc wins 1.31x -- its 940MB avoided write swamps exceptions), Down\n        # 80/80.  We accept the 1-2 extreme-outlier layers (e.g. QKV layer0)\n        # being slower rather than gate per layer -- aggregate TPOT cost ~0.1%.\n        # (Earlier QKV=0 was a layer-0 sampling artifact: the isolated bench's\n        # real-weight loader only ever sees layer 0, the 314k outlier.  Most QKV\n        # layers have ~1.6k exceptions and fuse-win.)\n        # best-N re-derived by an 8-step N sweep on a representative (median-exc)\n        # real layer (layer 40, N=8..256, H2D).  Cliff is structural: at N>64 the\n        # small-M shapes (QKV/O/Down) remap to the slow Npad=192 WGMMA tile\n        # (_pad_n), so they lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\ngrep: tiered_serve/compression/core/__pycache__/p4d16.cpython-312.pyc: binary file matches\ngrep: tiered_serve