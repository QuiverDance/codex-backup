ra_include_paths.\n_compression_dir = _os.path.join(\n    _os.path.dirname(__file__), \"..\", \"compression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old_arch_list = _os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n_os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _os.environ.get(\n    \"TIERED_SERVE_CUDA_ARCH\", _default_cuda_arch)\n\n# SM_90a-only WGMMA kernels — built only on Hopper hosts. On Blackwell the\n# fused decompress+GEMM path falls back to the SM_120-compatible\n# zipserv_fused_mm_gpu.cu (ldmatrix + mma.m16n8k16) kernel.\n_is_hopper = _default_cuda_arch.startswith(\"9.\")\n_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/