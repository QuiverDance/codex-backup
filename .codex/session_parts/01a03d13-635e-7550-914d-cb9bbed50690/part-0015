rect\n# by construction, this is for one-shot verification).\n_ENV_FROZEN_CACHE_VERIFY = os.getenv(\"TIERED_SERVE_FROZEN_CACHE_VERIFY\") == \"1\"\n\n\nMODEL_TO_LOAD_TARGET = {\n    \"hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4\": {\n        \"qkv\": (0, 5),\n        \"o\": (5, 9),\n        \"gate_up\": (9, 12),\n        \"down\": (12, 15),\n    },\n    \"nvidia/Llama-3.1-70B-Instruct-FP8\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"meta-llama/Llama-3.1-70B-Instruct\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"meta-llama/Llama-3.1-8B-Instruct\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Mistral-Medium-3.5-128B\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Devstral-2-123B-Instruct-2512\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Mixtral-8x22B-Instruct-v0.1\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"Qwen/Qwen1.5-110B-Chat\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\ngrep: tiered_serve/dual_memory_loader/__pycache__/base.cpython-312.pyc: binary file matches\ngrep: tiered_serve/dual_memory_loader/__pycache__/compressor.cpython-312.pyc: binary file matches\ntiered_serve/dual_memory_loader/base.py:33:    CompressedP4FlatTensor, P4FlatCompressor,\ntiered_serve/dual_memory_loader/base.py:244:    'P4FlatCompressor',\ntiered_serve/dual_memory_loader/compressor.py:105:            from tiered_serve.tensor_compressor import P4FlatCompressor\ntiered_serve/dual_memory_loader/compressor.py:106:            comp = P4FlatCompressor(stream)\n        'glo