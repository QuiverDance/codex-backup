{"timestamp":"2026-08-27T09:23:55.529Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a04288-7a09-76e3-a0a5-a5593aac0843","call_id":"call_804LQyDK9k70CEcGSAQiksgg","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"from tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\n\nclass CompressorMixin:\n\n    def _auto_dietgpu_workspace_bytes(self) -> Optional[int]:\n        \"\"\"Compute a workspace size large enough for DietGPU to compress\n        the model's biggest tensor without falling back to ``cudaMalloc``.\n\n        The fallback path triggers HBM ``torch.empty`` at compress time,\n        which races a frozen_split-filled HBM and OOMs (e.g. on Qwen-110B\n        the ``gate_up_proj`` compress needs ~1031 MiB of scratch but the\n        upstream default workspace is only 384 MiB).  Sizing from the\n        actual model avoids the user having to hand-tune\n        ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB`` per model.\n\n        Returns ``None`` to defer to the env-var / module default when\n        the model walk can't find a suitable reference tensor.\n        \"\"\"\n        # User override always wins.\n        if os.getenv(\"TIERED_SERVE_DIETGPU_WORKSPACE_MIB\") is not None:\n            return None\n        ref_blk = self.torch_model.decoder_blocks[0]\n        max_numel = 0\n        for name in self.tensor_names:\n            leaf_name, _, tensor_name = name.rpartition(\".\")\n            try:\n                leaf = ref_blk.module.get_submodule(leaf_name)\n            except AttributeError:\n                continue\n            t = getattr(leaf, tensor_name, None)\n            if t is None:\n                continue\n            if t.numel() > max_numel:\n                max_numel = t.numel()\n        if max_numel == 0:\n            return None\n        # Empirically DietGPU's compress on a BF16 [M, K] tensor peaks at\n        # ~1.22 × (M*K) bytes of stack memory (sm + exp scratch + ANS\n        # state + histograms).  110B observation: M*K=805 MiB requested\n        # 984 MiB.  1.4× gives ~14% headroom for variation across\n        # tensor shapes / vocabularies; round up to MiB.\n        bytes_needed = int(max_numel * 1.4) + 1\n        # Round up to the next MiB to get a clean log line.\n        return ((bytes_needed + (1 << 20) - 1) >> 20) << 20\n\n    def _make_weight_compressor(self, backend: str, *, role: str):\n        \"\"\"Instantiate a single weight compressor for the given backend name.\n\n        ``role`` is \"split\" / \"offload\" / \"default\" and only affects the\n        log line so dual-compressor runs are debuggable.\n\n        ``_AutoWeightCompressor`` lazy-instantiates its BF16/FP8 sub-\n        compressors on first ``compress``/``decompress`` call.  That's\n        unsafe in mixed-backend mode: when the offload compressor is\n        DietGPU and the split compressor is ZipServ, all frozen_split\n        layers compress first and fill HBM with sign_mantissa; by the\n        time the first offload_compressed layer hits DietGPU, the ~1 GB\n        workspace ``torch.empty`` is racing fragmented HBM and OOMs.\n        Eagerly prime BF16 here so both workspaces are allocated up\n        front while HBM is still clean.  Today's targeted models\n        (Qwen/Llama bf16) always hit the BF16 path; FP8 stays lazy.\n\n        DietGPU workspaces are auto-sized from the largest model tensor\n        so users don't need to set ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB``\n        per model (the env var, if set, still wins).\n        \"\"\"\n        stream = self.decomp_weight_stream\n        auto_ws = self._auto_dietgpu_workspace_bytes()\n        if backend in (\"zipserv\", \"dietgpu\"):\n            comp = _AutoWeightCompressor(\n                family=backend, comp_stream=stream,\n                dietgpu_workspace_bytes=auto_ws)\n            comp._bf16()\n            logger.info(\n                \"Weight compressor [%s]: %s (auto BF16/FP8, BF16 primed%s)\",\n                role, backend,\n                \"\" if auto_ws is None\n                else f\", DietGPU ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"zipserv_bf16\":\n            comp = ZipServCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n        elif backend == \"dietgpu_bf16\":\n            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n                \"\" if auto_ws is None\n                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"dietgpu_fp8\":\n            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n                \"\" if auto_ws is None\n                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n        elif backend == \"zipserv_fp8\":\n            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n            # (forked from LLM-bitfield-compressor, built in-tree). No\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n            from tiered_serve.tensor_compressor import UBLBFlatCompressor\n            comp = UBLBFlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: UBLB-flat (BF16)\", role)\n        else:\n            raise ValueError(\n                f\"Unknown weight compressor backend ({role}): \"\n                f\"{backend!r}. Expected one of: \"\n                f\"zipserv, dietgpu, zipserv_bf16, dietgpu_bf16, \"\n                f\"zipserv_fp8, dietgpu_fp8, p4flat, p4d16, p3flat_fp8, \"\n                f\"ublb_flat.\")\n        self._configure_weight_compressor_runtime(comp)\n        return comp\n\n    def _configure_weight_compressor_runtime(self, comp):\n        \"\"\"Attach loader runtime constants to compressor objects.\"\"\"\n        if comp is None or not hasattr(self, \"_cudagraph_ceiling\"):\n            return\n        comp._cudagraph_ceiling = self._cudagraph_ceiling\n        bf16 = getattr(comp, \"_bf16_impl\", None)\n        if bf16 is not None:\n            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n\n    def _compressor_for_mode(self, mode: str):\n        \"\"\"Return the weight compressor instance for a given residency mode.\n\ngrep: tiered_serve/dual_memory_loader/__pycache__/__init__.cpython-312.pyc: binary file matches\ntiered_serve/dual_memory_loader/frozen_split.py:358:        info = SplitStorageInfo(\ntiered_serve/dual_memory_loader/frozen_split.py:1598:        info.alt = SplitStorageInfo(\ntiered_serve/dual_memory_loader/frozen_split.py:1599:            hbm_sm, lpddr_bufs, metadata, backend=\"p4flat\")\ntiered_serve/dual_memory_loader/frozen_split.py:1624:        alt = SplitStorageInfo(\ntiered_serve/dual_memory_loader/init.py:979:                    frozen_split_dict[name] = SplitStorageInfo(\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04287-0fd9-7860-86ed-0dfd530834d8","create_time":1787822635.5299447}}}
