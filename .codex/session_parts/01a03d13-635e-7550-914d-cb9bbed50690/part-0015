e cache is correct\n# by construction, this is for one-shot verification).\n_ENV_FROZEN_CACHE_VERIFY = os.getenv(\"TIERED_SERVE_FROZEN_CACHE_VERIFY\") == \"1\"\n\n\nMODEL_TO_LOAD_TARGET = {\n    \"hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4\": {\n        \"qkv\": (0, 5),\n        \"o\": (5, 9),\n        \"gate_up\": (9, 12),\n        \"down\": (12, 15),\n    },\n    \"nvidia/Llama-3.1-70B-Instruct-FP8\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"meta-llama/Llama-3.1-70B-Instruct\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"meta-llama/Llama-3.1-8B-Instruct\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Mistral-Medium-3.5-128B\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Devstral-2-123B-Instruct-2512\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"mistralai/Mixtral-8x22B-Instruct-v0.1\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\n        \"gate_up\": (2, 3),\n        \"down\": (3, 4),\n    },\n    \"Qwen/Qwen1.5-110B-Chat\": {\n        \"qkv\": (0, 1),\n        \"o\": (1, 2),\ngrep: tiered_serve/dual_memory_loader/__pycache__/base.cpython-312.pyc: binary file matches\ngrep: tiered_serve/dual_memory_loader/__pycache__/compressor.cpython-312.pyc: binary file matches\ntiered_serve/dual_memory_loader/base.py:33:    CompressedP4FlatTensor, P4FlatCompressor,\ntiered_serve/dual_memory_loader/base.py:244:    'P4FlatCompressor',\ntiered_serve/dual_memory_loader/compressor.py:105:            from tiered_serve.tensor_compressor import P4FlatCompressor\ntiered_serve/dual_memory_loader/compressor.py:106:            comp = P4FlatCompressor(stream)\n        'global_palette', 'markers', 'codes',\n        'exc_indices', 'exc_values',\n    )\n    # P3-flat FP8 keeps sm_nibbles on HBM (the e4m3 analog of P4-flat's\n    # sign_mantissa byte, just nibble-packed); the rest of the codec\n    # state lives on LPDDR. (Per-tile exception offsets live inside the\n    # 16-byte header — no separate offsets buffer.)\n    _P3FLAT_FP8_LPDDR_ATTRS = (\n        'headers', 'codes', 'exc_exp_nibbles',\n    )\n    # UBLB-flat: the raw lower byte (lb_raw, M*K bytes = half the BF16) is the\n    # HBM-resident half (the analog of P4-flat's sign_mantissa); the nibble-\n    # packed upper-byte codes + 16-byte palette + (idx, ub) exception list ship\n    # to LPDDR.  Decode = flat_decode(code_stream, lb_raw, palette) + flat_patch.\n    _UBLB_FLAT_LPDDR_ATTRS = (\n        'code_stream', 'palette', 'exc_idx', 'exc_ub',\n    )\n\n    # --- HBM-resident auxiliary buffers (beyond sign_mantissa) ---\n    # These are cloned onto HBM at compress time and NEVER H2D'd in the\n    # decode hot path.  Only ZipServ BF16 has any; other backends keep\n    # everything except sign_mantissa on LPDDR (empty tuple default).\n    _ZIPSERV_HBM_ATTRS = ('tile_offsets_median', 'tile_offsets_global')\n\n    _BACKEND_TO_HBM_ATTRS = {\n        'zipserv': _ZIPSERV_HBM_ATTRS,\n    }\n\n    # Compressor-independent raw-exp split: only the uncompressed exponent\n    # crosses the bus (sign_mantissa stays HBM-resident); decode is a pure\n    # bit-merge, no entropy decode.\n    _RAW_EXP_LPDDR_ATTRS = ('raw_exp',)\n\n    _BACKEND_TO_ATTRS = {\n        'zipserv':     _ZIPSERV_LPDDR_ATTRS,\n        'dietgpu':     _DIETGPU_LPDDR_ATTRS,\n        'dietgpu_fp8': _DIETGPU_FP8_LPDDR_ATTRS,\n        'zipserv_fp8': _ZIPSERV_FP8_LPDDR_ATTRS,\n        'p4flat':      _P4FLAT_LPDDR_ATTRS,\n        'ublb_flat':   _UBLB_FLAT_LPDDR_ATTRS,\n        'p4d16':       _P4D16_LPDDR_ATTRS,\n        'p3flat_fp8':  _P3FLAT_FP8_LPDDR_ATTRS,\n        'raw_exp':     _RAW_EXP_LPDDR_ATTRS,\n    }\n