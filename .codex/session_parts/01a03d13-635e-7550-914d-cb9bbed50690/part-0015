  supply one (and ``None`` on CPU-only hosts).\n* :func:`TensorCompressor._jit_load_ext` — thin wrapper around\n  :func:`torch.utils.cpp_extension.load` that resolves source paths\n  under ``cpp_extensions/csrc`` so subclasses do not have to repeat\n  the same ``os.path.join(__file__, \"..\", ...)`` boilerplate.\n* :func:`TensorCompressor._log_compress_ratio` — uniform info-level log\n  line for compress operations.\n\nThe :class:`CompressedTensor` :class:`typing.Protocol` documents (and,\nunder ``isinstance`` checks, validates) the structural interface every\n``Compressed*Tensor`` class exposes to consumers.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Iterable, Optional, Protocol, runtime_checkable\n\nimport torch\n\n\nlogger = logging.getLogger(__name__)\n\n\n@runtime_checkable\nclass CompressedTensor(Protocol):\n    \"\"\"Structural protocol satisfied by every ``Compressed*Tensor`` class.\n\n    Attributes:\n        output_tensor: Optional pre-allocated decompress destination.\n\n    Properties:\n        total_compressed_size: Total bytes occupied by the compressed\n            payload(s).  Used for ratio logging and slot accounting.\n        nbytes: Alias for total_compressed_size where applicable.\n\n    Methods:\n        to(device): Return a copy of the compressed payload(s) staged on\n            the requested device (or update internal GPU buffers in place\n            for compressors that support it).\n    \"\"\"\n\n    output_tensor: Optional[torch.Tensor]\n\n    @property\n    def total_compressed_size(self) -> int: ...  # pragma: no cover\n\n    def to(self, device: Any) -> \"CompressedTensor\": ...  # pragma: no cover\n\n\nclass TensorCompressor(ABC):\n    \"\"\"Abstract base class for weight tensor compressors.\n\n    Subclasses must implement :meth:`compress` and :meth:`decompress`.\n    They may override :meth:`fused_mm` to provide a fused\n    decompress + GEMM kernel; otherwise the default implementation\n    decompresses then calls :func:`torch.mm`.\n\n    Two CUDA streams are provided so compress and decompress can run\n    concurrently (e.g. compressing layer N+1 while decompressing layer\n    N for matmul):\n\n    * ``self.comp_stream``   — used by :meth:`compress`.\n    * ``self.decomp_stream`` — used by :meth:`decompress` /\n      :meth:`fused_mm`.\n\n    Both default to freshly allocated :class:`torch.cuda.Stream` instances\n    on CUDA hosts and ``None`` on CPU-only hosts.  Either may be passed\n    explicitly by the caller (e.g. to share a stream with an upstream\n    pipeline stage).\n    \"\"\"\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        cuda_available = torch.cuda.is_available()\n        self.comp_stream = comp_stream or (\n            torch.cuda.Stream() if cuda_available else None\n        )\n        self.decomp_stream = decomp_stream or (\n            torch.cuda.Stream() if cuda_available else None\n        )\n\n    # ------------------------------------------------------------------\n    #  Required API\n    # ------------------------------------------------------------------\n\n    @abstractmethod\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedTensor] = None,\n        _sync: bool = True,\n    ) -> CompressedTensor:\n        \"\"\"Compress ``weight`` and return a :class:`CompressedTensor`.\"\"\"\n\n    @abstractmethod\n    def decompress(\n        self,\n        comp: CompressedTensor,\n        output: Optional[torch.Tensor] = None,\n    ) -> torch.Tensor:\n        \"\"\"Decompress ``comp`` into ``output`` (allocated when ``None``).\"\"\"\n\n    # ------------------------------------------------------------------\n    #  Batched API (override for truly-batched kernels)\n    # ------------------------------------------------------------------\n\n    @abstractmethod\n    def compress_batch(\n        self,\n        weights: \"list[torch.Tensor]\",\n        decomp_output_tensors: \"Optional[list[torch.Tensor]]\" = None,\n        comp_output_tensors: \"Optional[list[CompressedTensor]]\" = None,\n        _sync: bool = True,\n    ) -> \"list[CompressedTensor]\":\n        \"\"\"Compress a batch of weights in a single launch.\n\n        Subclasses with a true batched primitive (e.g. nvcomp's\n        ``BatchedXXXCompressAsync``) should override this to avoid the\n        per-tensor host sync incurred by the default fallback.  The base\n        implementation (callable via ``super().compress_batch(...)``)\n        loops over :meth:`compress`.\n        \"\"\"\n        n = len(weights)\n        decomp_outs = decomp_output_tensors or [None] * n\n        comp_outs = comp_output_tensors or [None] * n\n        results: \"list[CompressedTensor]\" = []\n        for w, d_out, c_out in zip(weights, decomp_outs, comp_outs):\n            results.append(self.compress(w, d_out, c_out, _sync=_sync))\n        return results\n\n    @abstractmethod\n    def decompress_batch(\n        self,\n        comps: \"list[CompressedTensor]\",\n        outputs: \"Optional[list[torch.Tensor]]\" = None,\n    ) -> \"list[torch.Tensor]\":\n        \"\"\"Decompress a batch of compressed tensors in a single launch.\n\n        Subclasses with a true batched primitive should override.  The\n        base implementation (callable via\n        ``super().decompress_batch(...)``) loops over :meth:`decompress`.\n        \"\"\"\n        outs = outputs or [None] * len(comps)\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\n\n    # ------------------------------------------------------------------\n    #  Async batch API\n    # ------------------------------------------------------------------\n    #\n    # ``compress_batch_async`` schedules batch compression and returns\n    # immediately; ``wait_compress_async`` blocks until the previously\n    # scheduled work completes.  Used by the KV offload pipeline to\n    # overlap compress with the next layer's GPU compute.\n    #\n    # The default implementation runs ``compress_batch`` on a private\n    # background thread and returns a ``concurrent.futures.Future``.  This\n    # works for any backend whose ``compress_batch`` releases the GIL\n    # (true for the C++ ZipServ ext and for GPU paths that just enqueue\n    # CUDA work).\n    #\n    # Backends with native async (e.g. KV worker pool, GPU CUDA streams)\n    # override BOTH methods with their own signatures — typically a\n    # caller-supplied key (such as ``layer_id``) instead of a Future.\n    # The convention is: ``wait_compress_async`` accepts whatever object\n    # ``compress_batch_async`` returned, OR the same key the caller\n    # passed in.  Signatures are intentionally ``*args, **kwargs`` in\n    # the base because per-backend they vary (KV needs cache-tensor +\n    # block-id args; weight needs a ``list[Tensor]``).\n\n    _async_pool = None  # type: ignore[assignment]\n\n    @classmethod\n    def _get_async_pool(cls):\n        \"\"\"Lazily-allocated single-thread pool for the default async path.\"\"\"\n        if cls._async_pool is None:\n            from concurrent.futures import ThreadPoolExecutor\n            cls._async_pool = ThreadPoolExecutor(\n                max_workers=1, thread_name_prefix=\"TensorCompressor-async\")\n        return cls._async_pool\n\n    def compress_batch_async(\n        self,\n        *args: Any,\n        key: Any = None,\n        output_buffers: Any = None,\n        n_subs_per_block: int = 0,\n        **kwargs: Any,\n    ) -> Any:\n        \"\"\"Schedule a batched compression and return immediately.\n\n        Standard parameters (recognized by both weight and KV backends):\n\n        * ``key``               — opaque identifier the caller will pass\n          to :meth:`wait_compress_async` (KV uses ``layer_id``).  Default\n          backends ignore it and return a Future instead.\n        * ``output_buffers``    — pre-allocated destinations.  Weight: a\n          list of ``CompressedTensor`` slots; KV: a 2-tuple\n          ``(k_cache, v_cache)``.  Default backends ignore it and let the\n          underlying ``compress_batch`` allocate freshly.\n        * ``n_subs_per_block``  — worker-pool fan-out hint.  ``0`` =\n          backend chooses (typically auto: thread-per-block when\n          ``n_blocks ≥ n_workers``, else multi-thread-per-block).  ``1``\n          = thread-per-block.  ``> 1`` = MT-per-block with this fan-out.\n          Default backends ignore it.\n\n        Default behaviour: dispatches ``compress_batch(*args, **kwargs)``\n        on a background thread and returns a\n        :class:`concurrent.futures.Future`.  Backends with a native async\n        pipeline (KV worker manager / GPU CUDA streams) override this\n        with their own positional signature (e.g.\n        ``(layer_id, block_ids, gpu_k, gpu_v)``) and consume the keyword\n        parameters above.\n        \"\"\"\n        del key, output_buffers, n_subs_per_block\n        pool = self._get_async_pool()\n        return pool.submit(self.compress_batch, *args, **kwargs)\n\n    def wait_compress_async(\n        self,\n        handle: Any,\n        *args: Any,\n        timeout: Optional[float] = None,\n        **kwargs: Any,\n    ) -> Any:\n        \"\"\"Block until a previously-scheduled async compress completes.\n\n        Default: ``handle`` is the :class:`concurrent.futures.Future`\n        returned by the default :meth:`compress_batch_async` — calls\n        ``handle.result(timeout)``.  Backends overriding\n        :meth:`compress_batch_async` with a key-based scheme (e.g.\n        ``layer_id``) override this too with their own signature.\n        \"\"\"\n        del args, kwargs\n        from concurrent.futures import Future\n        if isinstance(handle, Future):\n            return handle.result(\n                timeout=timeout if timeout and timeout > 0 else None)\n        raise NotImplementedError(\n            f\"{type(self).__name__}.wait_compress_async: handle of type \"\n            f\"{type(handle).__name__} is not a concurrent.futures.Future. \"\n            \"Subclasses with a key-based async scheme must override \"\n            \"wait_compress_async.\")\n\n\"\"\"BF16 P4-flat weight compressor.\n\nPer-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa byte.\nOut-of-palette exponents are stored as a separate (index, value) list and\nre-injected by a patch kernel during decompress — so the result is\nbit-exact-equivalent to the original BF16 weight.\n\nCompress runs on the GPU (one CTA per 64×64 tile).  Both compress and\ndecompress are delivered by the native PyTorch C++ extension\n``tiered_serve.cpp_exts.zipserv_p4flat_ext``.  No native fused\ndecompress+MM kernel: ``linear_apply`` falls through to the base class\ndefault (``decompress + F.linear``) which empirically beats every fused\nvariant on real LLM weights for decode-N shapes.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4FlatCompressor disabled: failed to load \"\n        f\"zipserv_p4flat_ext ({type(_e).__name__}: {_e})\")\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass CompressedP4FlatTensor:\n    \"\"\"Container around the native :class:`CompressedP4Flat` struct.\n\n    Mirrors GPU/host tensor fields onto Python instance attrs so the loader\n    can iterate ``_BUFFER_ATTRS`` and stage them through a pool, matching\n    the pattern used by :class:`CompressedZipServFP8GpuTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"headers\", \"codes\", \"sign_mantissa\",\n        \"subtile_codec\",\n        \"exc_indices\", \"exc_values\",\n        \"exc_sorted_indices\", \"exc_sorted_values\",\n        \"exc_group_m\", \"exc_group_offsets\",\n    )\n    # Pre-computed (attr, d_attr) pairs — avoids 10 f-string allocations\n    # per .to() / register_temp_d_tensor call (320 calls/step → 3200 fewer\n    # transient str objects per decode step).\n    _BUFFER_ATTR_D_PAIRS = tuple((a, f\"_d_{a}\") for a in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        # Cached narrow views into GPU staging buffers, created once in\n        # register_temp_d_tensor and reused by every .to() call.  Eliminates\n        # 10 view + 10 setattr(self._c, ...) per .to() call (320 calls/step\n        # → 6400 fewer transient Python objects per decode step).\n        self._h2d_views: Optional[tuple] = None\n        self._h2d_srcs: Optional[tuple] = None\n        self._gpu_buf_cache: Optional[tuple] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def num_groups(self) -> int:\n        return int(self._c.num_groups)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n    