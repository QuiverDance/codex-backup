724\t    }\n   725\t#else\n   726\t    return cudaErrorNotSupported;\n   727\t#endif\n   728\t}\n   729\t\n   730\t// ============================================================================\n   731\t// ChunkDelta3 RS-mode fused decode + GEMM.\n   732\t//\n   733\t// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n   734\t// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n   735\t// The matching base exponent is one byte per logical thread and sign/mantissa\n   736\t// is one raw byte per value.  Decode writes the reconstructed BF16 values\n   737\t// directly into the WGMMA register-A fragment, so no dense weight is emitted.\n   738\t//\n   739\t// CD3 exceptions are frequent enough on real weights that a sparse output\n   740\t// correction pass is a poor fit.  Instead each block expands only the current\n   741\t// tile's packed 17-bit exception records into a shared exponent override map\n   742\t// before constructing register A.  The WGMMA therefore consumes the exact\n   743\t// lossless weight, and split-K remains valid.\n   744\t// ============================================================================\n   745\ttemplate <int TileN, int Stages>\n   746\tstruct CD3RSSmem {\n   747\t    using SmemLayoutB = decltype(cute::tile_to_shape(\n   748\t        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n   749\t        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n   750\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n   751\t    alignas(16) uint8_t s_codes[Stages][1536];       // 4096 packed 3-bit codes\n   752\t    alignas(16) uint8_t s_sm[Stages][4096];          // raw sign|mantissa\n   753\t    alignas(16) uint8_t s_bases[Stages][256];        // base per 16-value chunk\n   754\t    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n   755\t    alignas(16) uint32_t s_exc_mask[Stages][128];    // one bit per tile value\n   756\t};\n   757\t\n   758\t__device__ __forceinline__ uint32_t cd3_unpack_entry17(\n   759\t    const uint8_t* entries, int64_t index)\n   760\t{\n   761\t    const int64_t bit = index * 17;\n   762\t    const int64_t byte = bit >> 3;\n   763\t    const int shift = static_cast<int>(bit & 7);\n   764\t    const uint32_t word = static_cast<uint32_t>(entries[byte])\n   765\t        | (static_cast<uint32_t>(entries[byte + 1]) << 8)\n   766\t        | (static_cast<uint32_t>(entries[byte + 2]) << 16);\n   767\t    return (word >> shift) & 0x1ffffu;\n   768\t}\n   769\t\n   770\ttemplate <int TileN, class MmaOp, int Stages>\n   771\t__global__ void cd3_rs_kernel(\n   772\t    const uint8_t*       __restrict__ codes_g,\n   773\t    const uint8_t*       __restrict__ sm_g,\n   774\t    const uint8_t*       __restrict__ bases_g,\n   775\t    const int32_t*       __restrict__ tile_offsets_g,\n   776\t    const uint16_t*      __restrict__ warp_prefixes_g,\n   777\t    const uint8_t*       __restrict__ entries17_g,\n   778\t    const __nv_bfloat16* __restrict__ B_g,\n   779\t    __nv_bfloat16*       __restrict__ C_g,\n   780\t    float*               __restrict__ Cf32_g,\n   781\t    int M, int N, int K, int split_k)\n   782\t{\n   783\t#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n   784\t    using namespace cute;\n   785\t    constexpr int kTileM = 64, kTileK = 64;\n   786\t    using Smem = CD3RSSmem<TileN, Stages>;\n   787\t    extern __shared__ __align__(128) uint8_t raw_smem[];\n   788\t    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n   789\t    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n   790\t\n   791\t    const int tid = static_cast<int>(threadIdx.x);\n   792\t    const int tile_n = static_cast<int>(blockIdx.x);\n   793\t    const int tile_m = static_cast<int>(blockIdx.y);\n   794\t    const int tiles_k = K >> 6;\n   795\t    const int split_idx = static_cast<int>(blockIdx.z);\n   796\t    const int tk_split = tiles_k / split_k;\n   797\t    const int k0 = split_idx * tk_split;\n   798\t\n   799\t    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n   800\t                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n   801\t    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n   802\t                         make_coord(tile_n, _));\n   803\t    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n   804\t    auto tiled_copy = make_tiled_copy(G2S{},\n   805\t        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n   806\t    auto thr_copy = tiled_copy.get_slice(tid);\n   807\t    auto tBgB = thr_copy.partition_S(gB);\n   808\t    auto tBsB = thr_copy.partition_D(sB);\n   809\t\n   810\t    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n   811\t                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n   812\t    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n   813\t                              make_coord(tile_m, tile_n));\n   814\t    auto tiled_mma = make_tiled_mma(MmaOp{});\n   815\t    auto thr_mma = tiled_mma.get_thread_slice(tid);\n   816\t    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n   817\t    clear(tCrC);\n   818\t    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n   819\t\n   820\t    using SmemLayoutA = decltype(tile_to_shape(\n   821\t        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n   822\t        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n   823\t    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n   824\t                                SmemLayoutA{});\n   825\t    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n   826\t    auto cA = make_identity_tensor(make_shape(Int<kTileM>{}, Int<kTileK>{}));\n   827\t    auto tCcA = thr_mma.partition_A(cA);\n   828\t\n   829\t    auto load_b =