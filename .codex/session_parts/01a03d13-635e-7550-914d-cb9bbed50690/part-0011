       }\n        return request.param, classes[request.param]()\n    except (ImportError, OSError, RuntimeError) as error:\n        detail = str(error).splitlines()[0] if str(error) else type(error).__name__\n        pytest.skip(f\"TP3/CD3 extension unavailable: {detail}\")\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact(compressor) -> None:\n    _, codec = compressor\n    weight = _all_bf16_patterns()\n\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.M == weight.shape[0]\n    assert compressed.K == weight.shape[1]\n    _assert_bit_exact(restored, weight)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(compressor, use_gpu_pool) -> None:\n    _, codec = compressor\n    weight = _representative_weight()\n    output = torch.empty_like(weight)\n    compressed = codec.compress(weight)\n    torch.cuda.synchronize()\n    compressed_size = compressed.nbytes\n\n    compressed.to_host()\n    assert compressed.nbytes == compressed_size\n    assert all(\n        getattr(compressed, attr).device.type == \"cpu\"\n        for attr in compressed._BUFFER_ATTRS\n    )\n\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    load_stream = torch.cuda.Stream()\n    decode_stream = torch.cuda.Stream()\n    with torch.cuda.stream(load_stream):\n        compressed.to(\"cuda\", non_blocking=True)\n    decode_stream.wait_stream(load_stream)\n    with torch.cuda.stream(decode_stream):\n        restored = codec.decompress(compressed)\n    decode_stream.synchronize()\n\n    assert restored.data_ptr() == output.data_ptr()\n    assert all(tensor.is_cuda for tensor in compressed.get_gpu_buffers())\n    _assert_bit_exact(restored, weight)\n\n\ndef test_rejects_non_tile_aligned_shape(compressor) -> None:\n    _, codec = compressor\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d31-be09-77d2-ad3c-0869dee8d700","create_time":1787733308.0407803}}}
