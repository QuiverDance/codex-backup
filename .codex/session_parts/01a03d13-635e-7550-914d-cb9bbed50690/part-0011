import torch\n\n\ndef _h2d_record_stream(host_t: torch.Tensor, device: torch.device,\n                       use_stream: torch.cuda.Stream) -> torch.Tensor:\n    \"\"\"H2D copy on `use_stream` and record_stream so PyTorch's caching\n    allocator does not free the GPU tensor while `use_stream` may still\n    be reading it.\"\"\"\n    with torch.cuda.stream(use_stream):\n        gpu_t = host_t.to(device, non_blocking=True)\n    gpu_t.record_stream(use_stream)\n    return gpu_t\n\n\n@dataclass\nclass BaseExpConfig:\n    \"\"\"Configuration for per-head BaseExp in ZipServ TCA-TBE.\n\n    Attributes:\n        mode: BaseExp granularity mode.\n            - \"global\": Original per-block BaseExp (default, backward compatible).\n            - \"per_head_static\": Per-(layer, head) BaseExp from offline calibration.\n            - \"per_head_dynamic\": Per-(layer, head, block) BaseExp computed online.\n        k_base_exp_table: Per-(layer, head) start_exp for K cache.\n            Shape [num_layers, num_kv_heads], uint8 values. Only used when\n            mode == \"per_head_static\".\n        v_base_exp_table: Per-(layer, head) start_exp for V cache.\n            Same shape/semantics as k_base_exp_table.\n        num_kv_heads: Number of KV heads per layer.\n        block_size: Tokens per KV cache block (must be 16 for initial impl).\n    \"\"\"\n    mode: str = \"global\"\n    k_base_exp_table: Optional[torch.Tensor] = None\n    v_base_exp_table: Optional[torch.Tensor] = None\n    num_kv_heads: int = 8\n    block_size: int = 16\n\n    def __post_init__(self):\n        valid_modes = (\"global\", \"per_head_static\", \"per_head_dynamic\")\n        if self.mode not in valid_modes:\n            raise ValueError(\n                f\"BaseExpConfig.mode must be one of {valid_modes}, \"\n                f\"got '{self.mode}'\")\n        if self.mode == \"per_head_static\":\n            if self.k_base_exp_table is None or self.v_base_exp_table is None:\n                raise ValueError(\n                    \"per_head_static mode requires k_base_exp_table and \"\n                    \"v_base_exp_table\")\n\n    @classmethod\n    def from_json(cls, path: str, num_kv_heads: int = 8,\n                  block_size: int = 16) -> 'BaseExpConfig':\n        \"\"\"Load from a calibration JSON file.\"\"\"\n        with open(path, 'r') as f:\n            data = json.load(f)\n        k_table = torch.tensor(data['k_base_exp_table'], dtype=torch.uint8)\n        v_table = torch.tensor(data['v_base_exp_table'], dtype=torch.uint8)\n        return cls(\n            mode=\"per_head_static\",\n            k_base_exp_table=k_table,\n            v_base_exp_table=v_table,\n            num_kv_heads=data.get('num_kv_heads', num_kv_heads),\n            block_size=data.get('block_size', block_size),\n        )\n\n    def get_top_exps_table(self, layer_id: int, kv: str, n: int) -> torch.Tensor:\n        \"\"\"Build [N, num_kv_heads, 7] uint8 top_exps table for compress.\n\n        For static mode, start_exp is stored per (layer, head).\n        top_exps[h] = [start_exp+1, start_exp+2, ..., start_exp+7].\n        The table is broadcast to N blocks (all blocks in the same layer\n        share the same per-head exponent window).\n\n        For dynamic mode, returns an empty tensor (histogram kernel is used).\n        \"\"\"\n        if self.mode == \"per_head_dynamic\":\n            return torch.empty(0, dtype=torch.uint8)\n        table = self.k_base_exp_table if kv == \"k\" else self.v_base_exp_table\n        # table shape: [num_layers, num_kv_heads] — values are start_exp\n        se = table[layer_id]  # [num_kv_heads] uint8\n        # Build 7 consecutive exponents: start_exp+1 .. start_exp+7\n        offsets = torch.arange(1, 8, dtype=torch.uint8)\n        top_exps = se.unsqueeze(-1) + offsets.unsqueeze(0)  # [num_kv_heads, 7]\n        # Broadcast to N blocks\n        return top_exps.unsqueeze(0).expand(n, -1, -1).contiguous()\n\n\nclass SplitStorageInfo:\n    \"\"\"Lightweight container for frozen_split mode per-tensor state.\n\n    Holds references to HBM-resident sign_mantissa, LPDDR-resident auxiliary\n    buffers, and scalar metadata needed to invoke decompress_gpu().\n\n    Backend-aware: ZipServ stores six aux buffers\n    (compressed_full + 3 bitmaps + 2 tile_offsets), DietGPU stores only\n    the ANS-compressed exponent stream.\n    \"\"\"\n\n    # ZipServ BF16: ``tile_offsets_*`` are small prefix-sum arrays\n    # (~1% of the weight) that the decompress kernel touches on every\n    # decode.  Keeping them HBM-resident (see ``_ZIPSERV_HBM_ATTRS``)\n    # removes them from the per-decode LPDDR→GPU H2D entirely, so only\n    # the bulk codec payload crosses the bus.\n    _ZIPSERV_LPDDR_ATTRS = (\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3',\n    )\n    _DIETGPU_LPDDR_ATTRS = ('compressed_exp',)\n    _DIETGPU_FP8_LPDDR_ATTRS = ('compressed_exp',)\n    _ZIPSERV_FP8_LPDDR_ATTRS = (\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3', 'bitmap4',\n        'group_offsets', 'small_in_group_hi',\n    )\n    # P4-flat keeps sign_mantissa on HBM; the rest of the codec state\n    # (palette headers + 4-bit codes + exception list) lives on LPDDR.\n    # The sorted-by-m exception metadata is fused-MM-only — shipping it\n    # to LPDDR enables frozen_split + --fused-mm to find the same data\n    # the standalone fused-MM path expects.  These buffers are tiny\n    # (proportional to num_exceptions, typically ≪0.01% of weight bytes)\n    # so the LPDDR cost is negligible.\n    _P4FLAT_LPDDR_ATTRS = (\n        'headers', 'codes',\n        'subtile_codec',\n        'exc_indices', 'exc_values',\n        'exc_sorted_indices', 'exc_sorted_values',\n        'exc_group_m', 'exc_group_offsets',\n    )\n    # P4-D16 (global palette variant): same HBM/LPDDR split as P4-flat\n    # but the per-tile palette headers collapse to a single global\n    # palette (16 B) shipped on LPDDR with the rest of the codec state.\n    _P4D16_LPDDR_ATTRS = (\n        'global_palette', 'markers', 'codes',\n        'exc_indices', 'exc_values',\n    )\n    # P3-flat FP8 keeps sm_nibbles on HBM (the e4m3 analog of P4-flat's\n    # sign_mantissa byte, just nibble-packed); the rest of the codec\n    # state lives on LPDDR. (Per-tile exception offsets live inside the\n    # 16-byte header — no separate offsets buffer.)\n    _P3FLAT_FP8_LPDDR_ATTRS = (\n        'headers', 'codes', 'exc_exp_nibbles',\n    )\n    # UBLB-flat: the raw lower byte (lb_raw, M*K bytes = half the BF16) is the\n    # HBM-resident half (the analog of P4-flat's sign_mantissa); the nibble-\n    # packed upper-byte codes + 16-byte palette + (idx, ub) exception list ship\n    # to LPDDR.  Decode = flat_decode(code_stream, lb_raw, palette) + flat_patch.\n    _UBLB_FLAT_LPDDR_ATTRS = (\n        'code_stream', 'palette', 'exc_idx', 'exc_ub',\n    )\n\n    # --- HBM-resident auxiliary buffers (beyond sign_mantissa) ---\n    # These are cloned onto HBM at compress time and NEVER H2D'd in the\n    # decode hot path.  Only ZipServ BF16 has any; other backends keep\n    # everything except sign_mantissa on LPDDR (empty tuple default).\n    _ZIPSERV_HBM_ATTRS = ('tile_offsets_median', 'tile_offsets_global')\n\n    _BACKEND_TO_HBM_ATTRS = {\n        'zipserv': _ZIPSERV_HBM_ATTRS,\n    }\n\n    # Compressor-independent raw-exp split: only the uncompressed exponent\n    # crosses the bus (sign_mantissa stays HBM-resident); decode is a pure\n    # bit-merge, no entropy decode.\n    _RAW_EXP_LPDDR_ATTRS = ('raw_exp',)\n\n    _BACKEND_TO_ATTRS = {\n        'zipserv':     _ZIPSERV_LPDDR_ATTRS,\n        'dietgpu':     _DIETGPU_LPDDR_ATTRS,\n        'dietgpu_fp8': _DIETGPU_FP8_LPDDR_ATTRS,\n        'zipserv_fp8': _ZIPSERV_FP8_LPDDR_ATTRS,\n        'p4flat':      _P4FLAT_LPDDR_ATTRS,\n        'ublb_flat':   _UBLB_FLAT_LPDDR_ATTRS,\n        'p4d16':       _P4D16_LPDDR_ATTRS,\n        'p3flat_fp8':  _P3FLAT_FP8_LPDDR_ATTRS,\n        'raw_exp':     _RAW_EXP_LPDDR_ATTRS,\n    }\n\n    def __init__(self, sign_mantissa: torch.Tensor,\n                 lpddr_buffers: Dict[str, torch.Tensor],\n                 metadata: Dict[str, int],\n                 backend: str = 'zipserv',\n                 lpddr_shared: bool = False,\n                 hbm_buffers: Optional[Dict[str, torch.Tensor]] = None):\n        self.sign_mantissa = sign_mantissa          # GPU permanent\n        # Optional phase-adaptive alternate compression of the SAME weight\n        # (e.g. a fast-decode p4flat codec used at prefill while this primary\n        # info is used at decode). It is a full SplitStorageInfo that ALIASES\n        # this one's ``sign_mantissa`` (only its compressed-exp side differs).\n        self.alt: Optional['SplitStorageInfo'] = None\n        self.lpddr_buffers = lpddr_buffers           # {attr_name: LPDDR hugepage tensor}\n        # Auxiliary buffers kept permanently on HBM alongside\n        # sign_mantissa (e.g. ZipServ tile_offsets); never H2D'd in the\n        # decode hot path.  {attr_name: GPU tensor}.\n        self.hbm_buffers: Dict[str, torch.Tensor] = hbm_buffers or {}\n        self.hbm_attrs: tuple = self._BACKEND_TO_HBM_ATTRS.get(backend, ())\n        self.backend = backend\n        # When True, the LPDDR buffer tensors are aliases owned elsewhere.\n        # Teardown must NOT call\n        # huge_page_allocator.free on them — that would invalidate the\n        # other owner's references and break the next reconfigure.\n        self.lpddr_shared = lpddr_shared\n        self.lpddr_attrs: tuple = self._BACKEND_TO_ATTRS.get(\n            backend, self._ZIPSERV_LPDDR_ATTRS)\n        # Pre-cache numel of each LPDDR buffer so the hot decompress path\n        # never has to call tensor.numel() on host (and never risks any\n        # implicit sync that PyTorch could introduce in future versions).\n        self.lpddr_numels: Dict[str, int] = {\n            attr: int(t.numel()) for attr, t in lpddr_buffers.items()\n        }\n        # Expose all metadata fields as attributes (e.g. M, K,\n        # max_high_freq_count for ZipServ; exp_compressed_size for DietGPU).\n        for k, v in metadata.items():\n            setattr(self, k, v)\n\n    @property\n    def hbm_bytes(self) -> int:\n        return self.sign_mantissa.nbytes + sum(\n            t.nbytes for t in self.hbm_buffers.values())\n\n    @property\n    def lpddr_bytes(self) -> int:\n        return sum(t.nbytes for t in self.lpddr_buffers.values())\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d31-be09-77d2-ad3c-0869dee8d700","create_time":1787733291.6913733}}}
