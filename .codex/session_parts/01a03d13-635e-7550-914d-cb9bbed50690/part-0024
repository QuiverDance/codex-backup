{"timestamp":"2026-08-27T10:14:11.764Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042b6-8034-7640-b487-ab401d5a7d0a","call_id":"call_TnDm6fyQhgf8M8SBwuY6wMJt","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t/**\n     2\t * wgmma_lab.cu — staged fusion lab for raw / UBLB-flat WGMMA GEMM (SM90).\n     3\t *\n     4\t * One templated double-buffered WGMMA GEMM whose ONLY difference between\n     5\t * experiments is how the 64x64 A (weight) smem tile is *produced*:\n     6\t *\n     7\t *   MODE_RAW  (E1): A is dense BF16 in GMEM, loaded directly.\n     8\t *   MODE_FLAT (U4): A is UBLB-flat compressed — per-element 4-bit code into a\n     9\t *                   16-entry upper-byte palette + raw lower byte. Decoded in\n    10\t *                   the producer path (branchless, no cumsum, no exceptions).\n    11\t *\n    12\t * This isolates \"is fusion competitive?\" (Step 1: E1 vs cuBLAS) from\n    13\t * \"does decode survive in the producer path?\" (Step 2: U4 vs E1) — the kernel\n    14\t * body (B-load, WGMMA pipeline, epilogue) is byte-identical across modes.\n    15\t *\n    16\t * Convention (matches the proven zipserv fused WGMMA kernel):\n    17\t *   A = weight   [M, K] row-major,  A[m,k] = A[m*K + k]\n    18\t *   B = activate [N, K] row-major,  B[n,k] = B[n*K + k]\n    19\t *   C = output   [M, N] COLUMN-major, C[m,n] = C[m + n*M]\n    20\t *   C[m,n] = sum_k A[m,k] * B[n,k]   (i.e. C = A @ B^T)\n    21\t */\n    22\t#include <cuda_bf16.h>\n    23\t#include <cuda_runtime.h>\n    24\t#include <cstdint>\n    25\t\n    26\t#include <cutlass/bfloat16.h>\n    27\t#include <cutlass/cutlass.h>\n    28\t#include <cute/arch/mma_sm90.hpp>\n    29\t#include <cute/tensor.hpp>\n    30\t\n    31\t// Slim double-buffered smem: just the WGMMA A/B operand tiles. No decode\n    32\t// scratch — the producer writes A elements straight into the swizzled tile.\n    33\t// Shared by the raw_pipe (E1) kernel and its launch helper.\n    34\ttemplate <int TileN, int Stages>\n    35\tstruct LabSmem {\n    36\t    using SmemLayoutA = decltype(\n    37\t        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n    38\t                            cute::make_shape(cute::Int<64>{}, cute::Int<64>{},\n    39\t                                             cute::Int<Stages>{})));\n    40\t    using SmemLayoutB = decltype(\n    41\t        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n    42\t                            cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{},\n    43\t                                             cute::Int<Stages>{})));\n    44\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n    45\t                                   cute::cosize_v<SmemLayoutA>> A;\n    46\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n    47\t                                   cute::cosize_v<SmemLayoutB>> B;\n    48\t};\n    49\t\n    50\t// ============================================================================\n    51\t// B-1: deep multi-stage cp.async pipelined RAW GEMM (E1, cuBLAS-grade attempt).\n    52\t//\n    53\t// Replaces the 2-stage synchronous producer with an S-stage cp.async ring so\n    54\t// many weight loads are in flight (the prior kernel sat at ~14% HBM because\n    55\t// only 2 stages of synchronous loads were ever outstanding). A and B are both\n    56\t// dense BF16 here, so cp.async streams them straight into the swizzled smem\n    57\t// tiles via CuTe copy atoms. Single warpgroup; relies on memory-level\n    58\t// parallelism (deep pipeline) rather than warp specialization for now.\n    59\t// ============================================================================\n    60\ttemplate <int TileN, class MmaOp, int Stages>\n    61\t__global__ void raw_pipe_kernel(\n    62\t    const __nv_bfloat16* __restrict__ A_g,\n    63\t    const __nv_bfloat16* __restrict__ B_g,\n    64\t    __nv_bfloat16*       __restrict__ C_g,\n    65\t    int M, int N, int K)\n    66\t{\n    67\t#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    68\t    using namespace cute;\n    69\t    constexpr int kTileM = 64, kTileK = 64;\n    70\t    using Smem = LabSmem<TileN, Stages>;\n    71\t    using SmemLayoutA = typename Smem::SmemLayoutA;\n    72\t    using SmemLayoutB = typename Smem::SmemLayoutB;\n    73\t\n    74\t    extern __shared__ __align__(128) uint8_t raw_smem[];\n    75\t    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    76\t    auto sA = make_tensor(make_smem_ptr(smem.A.begin()), SmemLayoutA{});\n    77\t    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), SmemLayoutB{});\n    78\t\n    79\t    const int tid     = static_cast<int>(threadIdx.x);\n    80\t    const int tile_n  = static_cast<int>(blockIdx.x);\n    81\t    const int tile_m  = static_cast<int>(blockIdx.y);\n    82\t    const int tiles_k = K >> 6;\n    83\t\n    84\t    // Global operand tensors (row-major), tiled along K.\n    85\t    auto mA = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(A_g)),\n    86\t                          make_layout(make_shape(M, K), make_stride(K, Int<1>{})));\n    87\t    auto gA = local_tile(mA, make_shape(Int<kTileM>{}, Int<kTileK>{}),\n    88\t                         make_coord(tile_m, _));          // (64,64,tiles_k)\n    89\t    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n    90\t                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    91\t    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n    92\t                         make_coord(tile_n, _));          // (TileN,64,tiles_k)\n    93\t\n    94\t    // G->S cp.async tiled copy: 128 threads, 8 bf16 (uint128) per thread along K.\n    95\t    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    96\t    auto tiled_copy = make_til