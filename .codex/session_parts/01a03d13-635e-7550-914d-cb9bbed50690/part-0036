reed via ``cudaFreeHost`` in ``free()`` / ``cleanup()``.\n        \"\"\"\n        try:\n            host_ptr = int(cupy.cuda.runtime.hostAlloc(req_bytes, 0x02))\n        except cupy.cuda.runtime.CUDARuntimeError as e:\n            raise MemoryError(\n                f\"Hugepage pool exhausted and cudaHostAlloc fallback failed \"\n                f\"({req_bytes} bytes for '{page_type}'): {e}\"\n            )\n        try:\n            tensor = huge_page_allocator_ext.allocate(\n                host_ptr, req_bytes, list(shape), list(stride), dtype)\n        except Exception:\n            cupy.cuda.runtime.freeHost(host_ptr)\n            raise\n\n        tensor_ptr = tensor.data_ptr()\n        self._pinned_allocs[tensor_ptr] = {\n            \"host_ptr\": host_ptr,\n            \"size\": req_bytes,\n            \"type\": page_type,\n        }\n        # Keep an entry in self.allocations so free()/info APIs see it,\n        # marked with kind=pinned to take the cudaFreeHost path.\n        self.allocations[tensor_ptr] = {\n            \"path\": None,\n            \"offset\": 0,\n            \"page_size\": req_bytes,\n            \"type\": page_type,\n            \"kind\": \"pinned\",\n        }\n        self._pinned_total_bytes += req_bytes\n        logger.info(\n            \"Pinned fallback: +%.2f MiB (%s); pinned total now %.2f GiB\",\n            req_bytes / (1024**2), page_type,\n            self._pinned_total_bytes / (1024**3))\n        return tensor\n\n    def get_kv_cache_info_list(self) -> list:\n        \"\"\"\n        할당된 모든 텐서 정보 중 page_type이 'kv'인 것들만 필터링하여\n        UnloadWorker가 필요로 하는 형식의 리스트로 만들어 반환합니다.\n        \"\"\"\n        info_list = []\n        for alloc_info in self.allocations.values():\n            # Skip pinned fallback entries: they have no backing file path\n            # and the UnloadWorker layout assumes a hugepage file.\n            if alloc_info.get(\"kind\") == \"pinned\":\n                continue\n            if alloc_info.get(\"type\") == \"kv\":\n                # Worker에 필요한 정보만 추출하여 추가\n                info_list.append({\n                    \"path\": alloc_info[\"path\"],\n                    \"offset\": alloc_info[\"offset\"],\n                    \"page_size\": alloc_info[\"page_size\"],\n                })\n        return info_list\n\n    def free(self, tensor: torch.Tensor) -> None:\n        \"\"\"Hugepage 할당을 해제하고 인접한 free 블록들을 병합합니다.\"\"\"\n        ptr = tensor.data_ptr()\n        alloc_info = self.allocations.pop(ptr, None)\n        if alloc_info is None:\n            return\n\n        if alloc_info.get(\"kind\") == \"pinned\":\n            pinned = self._pinned_allocs.pop(ptr, None)\n            if pinned is not None:\n                try:\n                    cupy.cuda.runtime.freeHost(pinned[\"host_ptr\"])\n                except cupy.cuda.runtime.CUDARuntimeError as e:\n                    logger.warning(\n                        \"cudaFreeHost failed for pinned fallback \"\n                        \"(host_ptr=0x%x, size=%d): %s\",\n                        pinned[\"host_ptr\"], pinned[\"size\"], e)\n                self._pinned_total_bytes -= pinned[\"size\"]\n            return\n\n        page_type = alloc_info[\"type\"]\n        target_offset = alloc_info[\"offset\"]\n\n        for page in self.pages[page_type]:\n            if page[\"path\"] != alloc_info[\"path\"]:\n                continue\n\n            for i, block in enumerate(page[\"blocks\"]):\n                if block[\"offset\"] == target_offset and not block[\"free\"]:\n                    block[\"free\"] = True\n\n                    # 다음 블록과 병합\n                    if (i + 1 < len(page[\"blocks\"])\n                            and page[\"blocks\"][i + 1][\"free\"]):\n                        block[\"size\"] += page[\"blocks\"][i + 1][\"size\"]\n                        page[\"blocks\"].pop(i + 1)\n\n                    # 이전 블록과 병합\n                    if i > 0 and page[\"blocks\"][i - 1][\"free\"]:\n                        page[\"blocks\"][i - 1][\"size\"] += block[\"size\"]\n                        page[\"blocks\"].pop(i)\n\n                    return\n            break\n\n    def get_remaining_capacity_by_type(self, page_type: str) -> int:\n        \"\"\"지정된 페이지 타입의 총 남은 용량(bytes)을 반환합니다.\"\"\"\n        page_list = self.pages.get(page_type, [])\n        # 모든 페이지를 순회하며, 각 페이지의 모든 'free' 블록의 크기를 합산합니다.\n        return sum(block[\"size\"] for page in page_list\n                   for block in page[\"blocks\"] if block[\"free\"])\n\n    def get_usage_summary(self) -> dict:\n        summary = {}\n        for page_type, page_list in self.pages.items():\n            summary[page_type] = []\n            for i, page in enumerate(page_list):\n                used_bytes = sum(b[\"size\"] for b in page[\"blocks\"]\n                                 if not b[\"free\"])\n                num_used_blocks = sum(1 for b in page[\"blocks\"]\n                                      if not b[\"free\"])\n                num_free_blocks = len(page[\"blocks\"]) - num_used_blocks\n\n                usage_percent = used_bytes / self.hp_size if self.hp_size > 0 else 0\n\n                largest_free_block = max(\n                    (b[\"size\"] for b in page[\"blocks\"] if b[\"free\"]),\n                    default=0)\n\n                page_summary = (\n                    f\"Page {i} ({os.path.basename(page['path'])}): \"\n                    f\"{usage_percent:.2%} used ({used_bytes/1024**2:.2f} MiB). \"\n                    f\"Blocks: {num_used_blocks} used, {num_free_blocks} free. \"\n                    f\"Largest free block: {largest_free_block/1024**2:.2f} MiB\"\n                )\n                summary[page_type].append(page_summary)\n        return summary\n\n    def cleanup(self):\n        if not hasattr(self, \"pages\") or not self.pages:\n            return\n\n        logger.info(\n            \"Cleaning up huge pages (Primary Process: %s)...\",\n            self.is_primary_process)\n\n        # Free pinned fallback allocations first.\n        if getattr(self, \"_pinned_allocs\", None):\n            for tensor_ptr, pinned in list(self._pinned_allocs.items()):\n                try:\n                    cupy.cuda.runtime.freeHost(pinned[\"host_ptr\"])\n                except cupy.cuda.runtime.CUDARuntimeError as e:\n                    logger.warning(\n                        \"cudaFreeHost failed during cleanup \"\n                        \"(host_ptr=0x%x, size=%d): %s\",\n                        pinned[\"host_ptr\"], pinned[\"size\"], e)\n                self.allocations.pop(tensor_ptr, None)\n            self._pinned_allocs.clear()\n            self._pinned_total_bytes = 0\n\n        for page_list in self.pages.values():\n            for page in page_list:\n                cupy.cuda.runtime.hostUnregister(page[\"base_ptr\"])\n                page[\"mmap\"].close()\n                if self.is_primary_process and os.path.exists(page[\"path\"]):\n                    os.unlink(page[\"path\"])\n\n        if (self.is_primary_process and os.path.exists(self.dir)\n                and not os.listdir(self.dir)):\n            try:\n                os.rmdir(self.dir)\n                logger.info(\"Removed huge page directory: %s\", self.dir)\n            except OSError as e:\n                logger.error(\"Error removing directory %s: %s\", self.dir, e)\n\n        self.pages = {}\n        self.allocations = {}\n        logger.info(\"Cleaned up resources for this process.\")\n\n\n# 모듈 레벨에서 allocator 인스턴스를 생성합니다.\n# 싱글턴 패턴 덕분에 여러번 import 되어도 HugePageAllocator.__init__은\n# 프로세스당 한번만 호출되고, 내부 로직에 의해 파일 생성은 모든 프로세스 중 한번만 일어납니다.\nallocator = HugePageAllocator(\n    n_weight_pages=int(os.getenv(\"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE\", 14)),\n    total_num_pages=int(os.getenv(\"TIERED_SERVE_NUM_HUGE_PAGE\", 23)))\n# 각 프로세스가 종료될 때 cleanup 함수가 호출되도록 등록합니다.\n# cleanup 내부 로직이 주/보조 프로세스를 구분하여 안전하게 처리합니다.\natexit.register(allocator.cleanup)\n"}],"internal_chat_message_metadata_