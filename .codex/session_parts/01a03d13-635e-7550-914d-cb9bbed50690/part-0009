atency P50/P95\n\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\nfused has no dense write and is contention-immune. An isolated sweep therefore\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\n\nTo characterise the fused KERNEL at every N (so production thresholds can be\ncalibrated), the per-codec production N-thresholds are forced wide open.\n\nUsage:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\n  ... --synthetic --check --n-values 1,64,256\n  ... --csv codec_decision.csv\n  ... --codecs zipserv,p4flat --projs o,gate_up\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\n\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\nlink, adding two iso/h2d column groups:\n\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\n                the SMs, no dense-weight HBM staging at all.\n\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\nalike.  See\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\n\"\"\"\n\nimport argparse\nimport ctypes\nimport glob\nimport logging\nimport os\nimport re\nimport sys\n\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom benchmarks.fused_bench_common import (\n    H2DContender,\n    LatencyStats,\n    add_timing,\n    bench_cuda,\n    runtime_metadata,\n    sha256_file,\n    sha256_tensor,\n    write_csv,\n)\n\n# Silence per-compress codec INFO spam (logged once per timed iteration).\nlogging.getLogger(\"tiered_serve\").setLevel(logging.WARNING)\n\n\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\nHIDDEN_SIZE = 8192\nNUM_Q_HEADS = 64\nNUM_KV_HEADS = 8\nHEAD_DIM = 128\nINTERMEDIATE_SIZE = 28672\nN_LAYERS = 80\n\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\n\n\ndef proj_shapes(tp):\n    \"\"\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\n\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\n    shard the contraction dim.\n    \"\"\"\n    return {\n        \"qkv\":     (QKV_OUT // tp,    HIDDEN_SIZE),\n        \"o\":       (HIDDEN_SIZE,      Q_DIM // tp),\n        \"gate_up\": (GATEUP_OUT // tp, HIDDEN_SIZE),\n        \"down\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\n    }\n\n\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\n_l2_flush_buf = None\n\n\ndef flush_l2_cache():\n    global _l2_flush_buf\n    if _l2_flush_buf is None:\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\n                                    device=\"cuda\")\n    _l2_flush_buf.zero_()\n\n\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\n    \"\"\"P50/P95 per-iteration GPU time in an isolated stream.\"\"\"\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n    )\n\n\ndef bench_gpu(fn, warmup, iters, flush):\n    \"\"\"Backward-compatible P50-only wrapper used by older imports.\"\"\"\n    return bench_gpu_stats(fn, warmup, iters, flush).p50_ms\n\n\ndef bench_compute_stats(fn, warmup, iters, flush, contender=None,\n                        copies_per_iter=8) -> LatencyStats:\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n        contender=contender,\n        copies_per_iter=copies_per_iter,\n    )\n\n\ndef bench_compute(fn, warmup, iters, flush, contender=None, copies_per_iter=8):\n    \"\"\"Backward-compatible P50-only wrapper used by older scripts.\"\"\"\n    return bench_compute_stats(\n        fn, warmup, iters, flush, contender, copies_per_iter).p50_ms\n\n\n# ── Weight sources ───────────────────────────────────────────────────────────\nDEFAULT_WEIGHTS_DIR = (\n    \"/root/.cache/huggingface/hub/models--meta-llama--Llama-3.1-70B-Instruct\"\n    \"/snapshots/1605565b47bb9346c5515c34102e054115b4f98b\"\n)\n\n\ndef _layer_idx(name):\n    m = re.search(r'\\.layers\\.(\\d+)\\.', name)\n    return int(m.group(1)) if m else None\n\n\ndef load_real_projections(weights_dir, want_shapes, max_shards=6, layer=None):\n    \"\"\"Return {proj: bf16 CPU tensor (M,K)} pulled from real Llama-70B weights.\n\n    Fuses q+k+v -> qkv and gate+up -> gate_up per layer, then takes the first\n    tensor whose shape matches each requested projection.  Reads shards until\n    every wanted shape is satisfied.\n\n    ``layer`` (int) restricts the scan to that decoder layer's weights — use it\n    to pin the measurement to a representative layer (e.g. the median-exception\n    layer 40) instead of whatever shard 0 happens to expose first (layer 0, the\n    314k-exception QKV outlier).  All shards are scanned when ``layer`` is set,\n    since a high layer can live past ``max_shards``.\n    \"\"\"\n    from safetensors import safe_open\n    files = sorted(glob.glob(os.path.join(weights_dir, \"*.safetensors\")))\n    if not files:\n        raise FileNotFoundError(f\"No safetensors in {weights_dir}\")\n    if layer is not None:\n        files_to_scan = files          # a specific layer may live past shard 6\n    else:\n        files_to_scan = files[:max_shards]\n\n    want = {proj: tuple(shape) for proj, shape in want_shapes.items()}\n    found = {}\n    # per-layer accumulators for fusion\n    qkv = {}      # layer -> {q,k,v}\n    gateup = {}   # layer -> {gate,up}\n\n    def try_fuse():\n        for li, g in list(qkv.items()):\n            if \"qkv\" not in found and {\"q\", \"k\", \"v\"} <= g.keys():\n                t = torch.cat([g[\"q\"], g[\"k\"], g[\"v\"]], dim=0)\n                if \"qkv\" in want and tuple(t.shape) == want[\"qkv\"]:\n                    found[\"qkv\"] = t.contiguous()\n        for li, g in list(gateup.items()):\n            if \"gate_up\" not in found and {\"gate\", \"up\"} <= g.keys():\n                t = torch.cat([g[\"gate\"], g[\"up\"]], dim=0)\n                if \"gate_up\" in want and tuple(t.shape) == want[\"gate_up\"]:\n                    found[\"gate_up\"] = t.contiguous()\n\n    for path in files_to_scan:\n        with safe_open(path, framework=\"pt\") as f:\n            for key in f.keys():\n                if all(p in found for p in want):\n                    break\n                if not (key.endswith(\".weight\")):\n                    continue\n                li = _layer_idx(key)\n                if li is None:\n                    continue\n                if layer is not None and li != layer:\n                    continue\n                t = f.get_tensor(key)\n                if t.dim() != 2 or t.dtype != torch.bfloat16:\n                    continue\n                shp = tuple(t.shape)\n                if \".q_proj.\" in key:\n                    qkv.setdefault(li, {})[\"q\"] = t\n                elif \".k_proj.\" in key:\n                    qkv.setdefault(li, {})[\"k\"] = t\n                elif \".v_proj.\" in key:\n                    qkv.setdefault(li, {})[\"v\"] = t\n                elif \".gate_proj.\" in key:\n                    gateup.setdefault(li, {})[\"gate\"] = t\n                elif \".up_proj.\" in key:\n                    gateup.setdefault(li, {})[\"up\"] = t\n                elif \".o_proj.\" in key and \"o\" in want and shp == want[\"o\"]:\n                    found.setdefault(\"o\", t.contiguous())\n                elif \".down_proj.\" in key and \"down\" in want and shp == want[\"down\"]:\n                    found.setdefault(\"down\", t.contiguous())\n                try_fuse()\n        if all(p in found for p in want):\n            break\n\n    missing = [p for p in want if p not in found]\n    if missing:\n        where = (f\"layer {layer}\" if layer is not None\n                 else f\"the first {max_shards} shards\")\n        hint = (\"check --layer is in range [0, 79]\" if layer is not None\n                else \"increase --shards or use --synthetic\")\n        raise RuntimeError(\n            f\"Could not find real weights for {missing} in {where} ({hint}).\")\n    return found\n\n\ndef make_synthetic(M, K, seed):\n    g = torch.Generator(device=\"cuda\").manual_seed(seed)\n    return (torch.randn(M, K, generator=g, device=\"cuda\",\n                        dtype=torch.float32) * 0.02).to(torch.bfloat16)\n\n\n# ── Codec registry + force-fuse ──────────────────────────────────────────────\ndef build_codec(name):\n    from tiered_serve.compression.core import (\n        ZipServCompressor, P4FlatCompressor, UBLBFlatCompressor)\n    if name == \"zipserv\":\n        # Run on the CURRENT stream (not a private comp_stream) so the cuda-event\n        # timing captures zipserv's decompress kernel — on a separate stream it\n        # is invisible to current-stream events and was mis-measured ~14x fast\n        # (0.029 vs true 0.41ms). p4flat/ublb already run on the current stream.\n        return ZipServCompressor(torch.cuda.current_stream())\n    if name == \"p4flat\":\n        return P4FlatCompressor()\n    if name == \"ublb_flat\":\n        return UBLBFlatCompressor()\n    raise ValueError(f\"unknown codec {name}\")\n\n\n_FORCE = 10 ** 18\n\n\ndef force_fused(codec, name):\n    \"\"\"Open the codec's per-shape fused N-threshold so the fused kernel runs at\n    every N (the production threshold is calibrated from the crossover).\"\"\"\n    if name == \"zipserv\":\n        from tiered_serve.compression.core import ZipServCompressor\n        ZipServCompressor._n_threshold = staticmethod(lambda M, K: _FORCE)\n    else:  # p4flat, ublb_flat both consult self._fused_max_n_override first\n        codec._fused_max_n_override = _FORCE\n\n\ndef compressed_bytes(comp):\n    for attr in (\"total_compressed_size\", \"nbytes\"):\n        if hasattr(comp, attr):\n            v = getattr(comp, attr)\n            return int(v() if callable(v) else v)\n    return 0\n\n\ndef exception_count(codec_name, comp) -> int:\n    if codec_name == \"zipserv\":\n        return int(comp.compressed_full.numel())\n    target = getattr(comp, \"_c\", comp)\n    for attr in (\"exc_indices\", \"exc_idx\"):\n        value = getattr(target, attr, None)\n        if torch.is_tensor(value):\n            return int(value.numel())\n    return 0\n\n\ndef production_fused_threshold(codec_name, codec, M, K) -> int:\n    if codec_name == \"zipserv\":\n        from tiered_serve.compression.core.zipserv import ZipServCompressor\n        return int(ZipServCompressor._N_THRESHOLD_TABLE.get((M, K), 96))\n    if codec_name == \"p4flat\":\n        return int(codec._FUSED_MAX_N_TABLE.get((M, K), 128))\n    return int(codec._fused_max_n_for(M, K))\n\n\n# ── ATS / Grace-Hopper C2C split placement ───────────────────────────────────\n# With --ats the fused GEMM is measured a SECOND time with the codec's\n# compressed-exponent stream (palette + 4-bit codes + exception lists) relocated\n# to Grace LPDDR, while the raw sign|mantissa byte stream stays in HBM.  On a\n# GH200 (Addressing Mode: ATS) the fused decode+GEMM kernel then reads the\n# exponent payload straight from LPDDR over the NVLink-C2C link into the SMs —\n# no HBM staging copy.  This mirrors the \"Exp ATS\" placement of\n#!/usr/bin/env python3\n\"\"\"Shared, allocation-stable helpers for the fused-kernel benchmarks.\n\nThe benchmark entry points deliberately keep GEMM orchestration and metadata\nhere so every run uses the same timing and provenance semantics.\n\"\"\"\nfrom __future__ import annotations\n\nimport csv\nimport gc\nimport hashlib\nimport os\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport statistics\nimport subprocess\nfrom typing import Any, Callable, Iterable, Mapping, Optional\n\nimport torch\n\n\n@dataclass(frozen=True)\nclass LatencyStats:\n    \"\"\"CUDA event latency samples and the two published percentiles.\"\"\"\n\n    p50_ms: float\n    p95_ms: float\n    samples_ms: tuple[float, ...]\n\n\ndef _percentile(values: list[float], q: float) -> float:\n    \"\"\"Linear percentile matching NumPy's default without adding a dependency.\"\"\"\n    if not values:\n        raise ValueError(\"cannot compute a percentile of an empty sample\")\n    ordered = sorted(float(v) for v in values)\n    if len(ordered) == 1:\n        return ordered[0]\n    pos = (len(ordered) - 1) * q\n    lo = int(pos)\n    hi = min(lo + 1, len(ordered) - 1)\n    frac = pos - lo\n    return ordered[lo] * (1.0 - frac) + ordered[hi] * frac\n\n\nclass H2DContender:\n    \"\"\"Saturate a copy engine without synchronizing the compute stream.\"\"\"\n\n    def __init__(self, nbytes: int, max_bytes: int = 256 * 1024 * 1024):\n        self.nbytes = max(1 << 20, min(int(nbytes), int(max_bytes)))\n        self.stream = torch.cuda.Stream()\n        self.host = torch.empty(self.nbytes, dtype=torch.uint8, pin_memory=True)\n        self.device = torch.empty(self.nbytes, dtype=torch.uint8, device=\"cuda\")\n        self._closed = False\n\n    def refill(self, copies: int) -> None:\n        if self._closed:\n            raise RuntimeError(\"H2DContender is closed\")\n        with torch.cuda.stream(self.stream):\n            for _ in range(copies):\n                self.device.copy_(self.host, non_blocking=True)\n\n    def drain(self) -> None:\n        self.stream.synchronize()\n\n    def close(self) -> None:\n        \"\"\"Release pinned storage between independently sized benchmark cells.\n\n        PyTorch's caching host allocator otherwise retains every differently\n        sized contender buffer. A long scaling sweep can cross the GH200 pinned\n        registration limit even though each individual cell fits, causing a\n        later cudaMemcpyAsync to fail with cudaErrorInvalidValue. Drain before\n        dropping the tensors, then empty only the host cache; this runs outside\n        every timed region.\n        \"\"\"\n        if self._closed:\n            return\n        self.drain()\n        self._closed = True\n        self.host = None\n        self.device = None\n        self.stream = None\n        gc.collect()\n        empty_host_cache = getattr(torch._C, \"_host_emptyCache\", None)\n        if empty_host_cache is not None:\n            empty_host_cache()\n\n\ndef bench_cuda(\n    fn: Callable[[], Any],\n    warmup: int,\n    iters: int,\n    *,\n    flush_fn: Optional[Callable[[], None]] = None,\n    contender: Optional[H2DContender] = None,\n    copies_per_iter: int = 8,\n) -> LatencyStats:\n    \"\"\"Time ``fn`` on the current stream and return P50/P95 in milliseconds.\n\n    ``Event.synchronize`` waits only for the measured compute stream.  A global\n    synchronize here would serialize the optional H2D stream and invalidate the\n    contention experiment.\n    \"\"\"\n    if warmup < 0 or iters <= 0:\n        raise ValueError(f\"warmup must be >=0 and iters >0, got {warmup}/{iters}\")\n    if contender is not None:\n        contender.refill(copies_per_iter * (warmup + 2))\n    for _ in range(warmup):\n        fn()\n   