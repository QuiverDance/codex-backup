sed={compressed_bytes / 2**20:.3f}MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions(K/V)={k_exceptions}/{v_exceptions}\"\n    )\n    print(\n        f\"  encode wall min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\"\n    )\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/{dec[2]:.3f} ms \"\n        f\"median={raw_gib / (dec[1] / 1e3):.1f} GiB/s\"\n    )\n    print(\n        f\"  H2D only min/med/p95={cp[0]:.3f}/{cp[1]:.3f}/{cp[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"exact={is_exact and staged_exact}\"\n    )\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    print(torch.cuda.get_device_name())\n    host_k, host_v = load()\n    print(f\"KV blocks={N}, block_shape={BLOCK_SHAPE}, dense layout=[{N * M_PER_BLOCK}, {K_PER_BLOCK}] x K/V\")\n    for codec_cls, name in (\n        (P4FlatCompressor, \"p4flat-direct\"),\n        (TilePalette3Compressor, \"tile_palette3-direct\"),\n        (ChunkDelta3Compressor, \"chunk_delta3-direct\"),\n    ):\n        run(codec_cls, name, host_k, host_v)\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed"}}
