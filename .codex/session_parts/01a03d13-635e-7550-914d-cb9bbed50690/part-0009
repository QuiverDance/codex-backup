EAD PER EXCEPTION (decode delta once, then scatter over n).  Replaces\n// the old \"1 block (256 threads) per exception\" design which, at decode N,\n// re-decoded each exception 256x AND left 255/256 threads idle (only N of 256\n// did work) -- catastrophic for high-exception layers (e.g. QKV layer 0 = 314k\n// exceptions: 314k block launches x 256 redundant decodes, 1 useful add each at\n// N=1).  num_exc threads total, each decodes its exception once and does N adds.\n// Measured (synthetic, GH200): at N=1 the new kernel is 1.8x faster at 13k\n// exceptions, 7.6x at 113k, 12.7x at 314k (0.50->0.04ms); ~1x at <=1k (typical\n// low-exception layer, no regression).  At large N (>=64) the old per-row\n// coalesced atomics were slightly better at LOW exc counts, but decode-N is\n// small and high-exc layers dominate the cost, so thread-per-exception wins net.\n__global__ void p4_exc_correct_kernel(\n    const int* __restrict__ exc_idx, const uint16_t* __restrict__ exc_val,\n    const uint8_t* __restrict__ codes, const uint8_t* __restrict__ sm,\n    const uint8_t* __restrict__ headers, const uint8_t* __restrict__ codec,\n    const __nv_bfloat16* __restrict__ X, float* __restrict__ Ycorr,\n    int64_t num_exc, int N, int K, int M)\n{\n    const int64_t e = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;\n    if (e >= num_exc) return;\n    const int64_t idx = static_cast<int64_t>(exc_idx[e]);\n    const int m = static_cast<int>(idx / K), k = static_cast<int>(idx % K);\n    const float d = p4_exc_delta(codes, sm, headers, codec, exc_val[e],\n                                 m, k, K >> 6);\n    // Ycorr is [M,N] fp32; atomicAdd because >1 exception may share row m\n    // (exc_idx sorted by m*K+k -> consecutive threads mostly hit the same/adjacent\n    // m, keeping these atomics reasonably local). fp32 keeps colliding adds in\n    // tolerance; the caller folds Ycorr^T into bf16 with a single rounding.\n    const __nv_bfloat16* xk = X + k;                 // X[n,k] = xk[n*K]\n    float* yc = Ycorr + static_cast<int64_t>(m) * N;\n    for (int n = 0; n < N; ++n)\n        atomicAdd(&yc[n], d * __bfloat162float(xk[static_cast<int64_t>(n) * K]));\n// Torch bindings for the WGMMA fusion lab (raw / UBLB-flat producers).\n#include <torch/extension.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cuda_bf16.h>\n#include <cuda_runtime.h>\n#include <cstdint>\n\nextern \"C\" cudaError_t raw_pipe_wgmma_launch(\n    cudaStream_t, const __nv_bfloat16*, const __nv_bfloat16*,\n    __nv_bfloat16*, int, int, int);\nextern \"C\" cudaError_t u4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\nextern \"C\" cudaError_t p4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int,\n    const int*, const uint16_t*, int, int, int, int);\nextern \"C\" cudaError_t p4_exc_correct_launch(\n    cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n    const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n    int64_t, int, int, int);\nextern \"C\" cudaError_t zip_rs_wgmma_launch(\n    cudaStream_t, const uint64_t*, const uint64_t*, const uint64_t*,\n    const uint8_t*, int, const uint16_t*, const int*,\n    const __nv_bfloat16*, __nv_bfloat16*, int, int, int);\n\n// C is the COLUMN-major [M,N] output buffer (physically [N,M] row-major):\n// caller passes a contiguous [N, M] bf16 tensor; element (m,n) lands at n*M+m.\n// Ws (split_k>1) is an [split_k*M*N] f32 workspace; pass an empty tensor for\n// split_k==1 (direct bf16 write path).\n\nstatic float* ws_ptr(torch::Tensor Ws) {\n    return Ws.numel() ? reinterpret_cast<float*>(Ws.data_ptr()) : nullptr;\n}\n\nvoid raw_pipe_wgmma_mm(torch::Tensor A, torch::Tensor B, torch::Tensor C,\n                       int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getC