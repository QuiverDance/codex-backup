 uint8_t*,\n+    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\n extern \"C\" cudaError_t p4_exc_correct_launch(\n     cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n     const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n@@ -85,6 +89,43 @@ void p4_rs_wgmma_mm(torch::Tensor codes, torch::Tensor sm, torch::Tensor headers\n                 \" split_k=\", split_k, \")\");\n }\n \n+void cd3_rs_wgmma_mm(\n+    torch::Tensor codes, torch::Tensor sm, torch::Tensor bases,\n+    torch::Tensor tile_offsets, torch::Tensor warp_prefixes,\n+    torch::Tensor entries17, torch::Tensor B, torch::Tensor C,\n+    torch::Tensor Cf32, int64_t split_k,\n+    int64_t M, int64_t N, int64_t K) {\n+    TORCH_CHECK(codes.is_cuda() && sm.is_cuda() && bases.is_cuda()\n+                && tile_offsets.is_cuda() && warp_prefixes.is_cuda()\n+                && entries17.is_cuda() && B.is_cuda() && C.is_cuda(),\n+                \"cd3_rs_wgmma_mm expects CUDA tensors\");\n+    TORCH_CHECK(codes.scalar_type() == at::kByte\n+                && sm.scalar_type() == at::kByte\n+                && bases.scalar_type() == at::kByte\n+                && tile_offsets.scalar_type() == at::kInt\n+                && warp_prefixes.scalar_type() == at::kShort\n+                && entries17.scalar_type() == at::kByte,\n+                \"cd3_rs_wgmma_mm received invalid codec dtypes\");\n+    TORCH_CHECK(B.scalar_type() == at::kBFloat16\n+                && C.scalar_type() == at::kBFloat16,\n+                \"cd3_rs_wgmma_mm expects BF16 activation/output\");\n+    auto stream = c10::cuda::getCurrentCUDAStream();\n+    cudaError_t e = cd3_rs_wgmma_launch(\n+        stream.stream(),\n+        reinterpret_cast<const uint8_t*>(codes.data_ptr()),\n+        reinterpret_cast<const uint8_t*>(sm.data_ptr()),\n+        reinterpret_cast<const uint8_t*>(bases.data_ptr()),\n+        reinterpret_cast<const int32_t*>(tile_offsets.data_ptr()),\n+        reinterpret_