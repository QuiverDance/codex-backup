ar[(layer_id - 1) % P].record(self.exec_stream)\n                    # WAR: this H2D overwrites slot L%P, last read by layer\n                    # (L-PARITY)'s GEMM.  Layers < PARITY are first occupants\n                    # (fresh buffer) → no prior reader → skip.\n                    if layer_id >= P:\n                        self.load_weight_stream.wait_event(war[layer_id % P])\n                with torch.cuda.stream(self.load_weight_stream):\n                    output.view(src.shape).copy_(src, non_blocking=True)\n                # RAW: record weight-ready on load_weight_stream so the FX\n                # wait_frozen_weight makes the GEMM wait for THIS H2D.  Suppress\n                # the caller's default exec-stream record (it would shadow this\n                # with an already-complete event → torn weight read).\n                self.frozen_decomp_events[comp_key][layer_id].record(\n                    self.load_weight_stream)\n                self._last_prefill_raw_recorded = True\n            else:\n                # Fallback: move H2D off exec_stream onto load_weight_stream\n                # so the copy overlaps compute instead of blocking the GEMM\n                # stream.  The caller records frozen_decomp_events on\n                # decomp_weight_stream after this returns; the wait_stream\n                # below ensures that event fires only after the H2D completes.\n                with torch.cuda.stream(self.load_weight_stream):\n                    output.view(src.shape).copy_(src, non_blocking=True)\n                self.decomp_weight_stream.wait_stream(\n                    self.load_weight_stream)\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_pop()\n            return\n\n        # Decode path: H2D on load_weight_stream, decompress kernel on\n        # decomp_weight_stream, fused via per-(layer,name) events.\n        #\n        # Sync model:\n        #   * H2D waits on kernel_done[name, parity] from the previous\n   