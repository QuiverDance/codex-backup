repo = hub / \"models--meta-llama--Llama-3.1-70B-Instruct\"\n    ref = repo / \"refs\" / \"main\"\n    if not ref.is_file():\n        raise FileNotFoundError(\n            f\"cannot resolve the local checkpoint revision: {ref}\")\n    revision = ref.read_text().strip()\n    if not re.fullmatch(r\"[0-9a-f]{40}\", revision):\n        raise RuntimeError(f\"invalid Hugging Face revision in {ref}: {revision!r}\")\n    snapshot = repo / \"snapshots\" / revision\n    index = snapshot / \"model.safetensors.index.json\"\n    if not index.is_file():\n        raise FileNotFoundError(f\"checkpoint index missing: {index}\")\n    payload = json.loads(index.read_text())\n    weight_map = payload.get(\"weight_map\")\n    if not isinstance(weight_map, dict) or not weight_map:\n        raise RuntimeError(f\"checkpoint index has no weight_map: {index}\")\n    shard_names = sorted(set(weight_map.values()))\n    manifest_lines = []\n    for name in shard_names:\n        shard = snapshot / name\n        if not shard.is_file():\n            raise FileNotFoundError(f\"checkpoint shard missing: {shard}\")\n        blob_sha = shard.resolve().name\n        if not re.fullmatch(r\"[0-9a-f]{64}\", blob_sha):\n            raise RuntimeError(\n                f\"weight shard is not backed by a SHA256-named HF blob: {shard}\")\n        manifest_lines.append(f\"{name}:{blob_sha}:{shard.stat().st_size}\")\n    manifest_hash = hashlib.sha256(\n        (sha256_file(index) + \"\\n\" + \"\\n\".join(manifest_lines)).encode()\n    ).hexdigest()\n    return {\n        \"model_source\": MODEL,\n        \"model_snapshot_revision\": revision,\n        \"model_snapshot_path\": str(snapshot),\n        \"model_index_path\": str(index),\n        \"model_index_sha256\": sha256_file(index),\n        \"model_weight_shards\": len(shard_names),\n        \"model_weight_manifest_sha256\": manifest_hash,\n    }\n\n\ndef _environment_metadata() -> dict[str, Any]:\n    \"\"\"Collect runtime/GPU identity without retaining a 