{"timestamp":"2026-08-27T11:19:56.758Z","ordinal":3026,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042f2-b256-77f3-bc76-0c2ed1bd3330","call_id":"call_SYIGGOqBDwARcFDe2Aa3jGfR","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 12043)\nTotal output lines: 1133\n\n            for attr in info.lpddr_attrs:\n                setattr(c, attr, src_bufs[attr].narrow(0, 0, ln[attr]))\n            c.M = info.M\n            c.K = info.K\n            c.num_exceptions = info.num_exceptions\n            _p3f_ext.decompress(c, output)\n        else:  # zipserv (BF16)\n            # tile_offsets_* are HBM-resident (info.hbm_buffers), exact\n            # size — they are not part of src_bufs / the per-decode H2D.\n            # When sign_mantissa is the canonical (M,K) row-major form, pass it\n            # as canonical_sm — the kernel reads HF sm there (no compacted SM\n            # staging). info.sign_mantissa is the same buffer in that case.\n            _canon = (info.sign_mantissa\n                      if getattr(info, \"_uses_canonical_sm\", False) else None)\n            backend_compressor._ext.decompress(\n                info.sign_mantissa,\n                src_bufs[\"compressed_full\"].narrow(0, 0, ln[\"compressed_full\"]),\n                src_bufs[\"bitmap1\"].narrow(0, 0, ln[\"bitmap1\"]),\n                src_bufs[\"bitmap2\"].narrow(0, 0, ln[\"bitmap2\"]),\n                src_bufs[\"bitmap3\"].narrow(0, 0, ln[\"bitmap3\"]),\n                info.hbm_buffers[\"tile_offsets_median\"],\n                info.hbm_buffers[\"tile_offsets_global\"],\n                info.max_high_freq_count,\n                info.max_full_count,\n                info.start_exp,\n                output,\n                info.M, info.K,\n                gt_m_base, num_row_tiles,\n                _canon)\n\n    def _ensure_prefill_war_events(self):\n        \"\"\"Lazily allocate per-(comp, parity) WAR events for the prefill\n        raw_bf16 path.\n\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\n        2*M*K H2D into the primary buffer moves OFF exec onto\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\n        GEMMs instead of serialising on exec, since\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\n        a cross-stream resource shared across parity-PARITY layers, so the\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\n        has finished reading it.  One event per (comp, parity); pre-recorded\n        so the first PARITY layers (fresh buffers) never block on a\n        never-recorded event.\n        \"\"\"\n        if getattr(self, \"_prefill_war_events\", None) is not None:\n            return\n        self._prefill_war_events = {\n            comp_key: [torch.cuda.Event(external=True)\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n        }\n        for events in self._prefill_war_events.values():\n            for ev in events:\n                ev.record()  # pre-signal\n\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\n                                          info, skip_kernel: bool = False,\n                                          h2d_ctx_held: bool = False,\n                                          collect_into=None\n                                          ) -> None:\n        \"\"\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\n        staging then backend-specific decompress + reconstruct.  The fused\n        H2D-only caller may hold ``load_weight_stream``; dense paths hold\n        ``decomp_weight_stream``.\n\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n                P = self.FROZEN_DECOMP_PARITY\n                if war is not None:\n                    # Default path: free the prior layer's slot for this comp\n                    # inline.  V1 prefill eager lookahead disables this record\n                    # and lets the wrapper mark slots free after the eager piece\n                    # actually consumes them; otherwise scheduling graph K+1\n                    # before graph K would falsely free graph K's qkv slot.\n                    if not getattr(self, \"_v1_prefill_raw_external_war\",\n                                   False):\n                        war[(layer_id - 1) % P].