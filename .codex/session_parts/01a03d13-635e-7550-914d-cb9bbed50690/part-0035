{"timestamp":"2026-08-27T11:19:44.716Z","ordinal":3016,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042f2-834c-7711-bb46-9e86f0865528","call_id":"call_6rXfNL1jskphOvBNBcBNVqQ2","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"module_blocks:\n  model.embed_tokens: null\n  \"model.layers.*.input_layernorm\": null\n  \"model.layers.*.self_attn.qkv_proj\": null\n  \"model.layers.*.self_attn.rotary_emb\": null\n  \"model.layers.*.self_attn.o_proj\": null\n  \"model.layers.*.post_attention_layernorm\": null\n  \"model.layers.*.mlp.gate_up_proj\": null\n  \"model.layers.*.mlp.down_proj\": null\n  model.norm: null\n  lm_head: null\n  logits_processor: null\n  sampler: null\nfrozen_blocks:\n  \"model.layers.*.input_layernorm\": null\n  \"model.layers.*.self_attn.rotary_emb\": null\n  \"model.layers.*.post_attention_layernorm\": null\n  model.norm: null\n  lm_head: null\n  logits_processor: null\n  sampler: null\n\nats_blocks:\n  model.embed_tokens: null\n\n# frozen_split: sign_mantissa on HBM (~59 GB), rest on LPDDR (~41 GB)\n# Designed for GH200 (96 GB HBM + LPDDR5)\nlayer_residency:\n  default:\n    qkv: {mode: offload_compressed, compressor: p4flat}\n    o: {mode: offload_compressed, compressor: p4flat}\n    gate_up: {mode: offload_compressed, compressor: p4flat}\n    down: {mode: offload_compressed, compressor: p4flat}\n  frozen:\n    qkv:\n      mode: frozen_split\n      compressor: p4flat\n      layers: all\n    o:\n      mode: frozen_split\n      compressor: p4flat\n      layers: all\n    gate_up:\n      mode: frozen_split\n      compressor: p4flat\n      layers: all\n    down:\n      mode: frozen_split\n      compressor: p4flat\n      layers: all\n    # decode.  Keeping them HBM-resident (see ``_ZIPSERV_HBM_ATTRS``)\n    # removes them from the per-decode LPDDR→GPU H2D entirely, so only\n    # the bulk codec payload crosses the bus.\n    _ZIPSERV_LPDDR_ATTRS = (\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3',\n    )\n    _DIETGPU_LPDDR_ATTRS = ('compressed_exp',)\n    _DIETGPU_FP8_LPDDR_ATTRS = ('compressed_exp',)\n    _ZIPSERV_FP8_LPDDR_ATTRS = (\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3', 'bitmap4',\n        'group_offsets', 'small_in_group_hi',\n    )\n    # P4-flat keeps sign_mantissa on HBM; the rest of the codec state\n    # (palette headers + 4-bit codes + exception list) lives on LPDDR.\n    # The sorted-by-m exception metadata is fused-MM-only — shipping it\n    # to LPDDR enables frozen_split + --fused-mm to find the same data\n    # the standalone fused-MM path expects.  These buffers are tiny\n    # (proportional to num_exceptions, typically ≪0.01% of weight bytes)\n    # so the LPDDR cost is negligible.\n    _P4FLAT_LPDDR_ATTRS = (\n        'headers', 'codes',\n        'subtile_codec',\n        'exc_indices', 'exc_values',\n        'exc_sorted_indices', 'exc_sorted_values',\n        'exc_group_m', 'exc_group_offsets',\n    )\n    # P4-D16 (global palette variant): same HBM/LPDDR split as P4-flat\n    # but the per-tile palette headers collapse to a single global\n    # palette (16 B) shipped on LPDDR with the rest of the codec state.\n    _P4D16_LPDDR_ATTRS = (\n        'global_palette', 'markers', 'codes',\n        'exc_indices', 'exc_values',\n    )\n    # P3-flat FP8 keeps sm_nibbles on HBM (the e4m3 analog of P4-flat's\n    # sign_mantissa byte, just nibble-packed); the rest of the codec\n    # state lives on LPDDR. (Per-tile exception offsets live inside the\n    # 16-byte header — no separate offsets buffer.)\n    _P3FLAT_FP8_LPDDR_ATTRS = (\n        'headers', 'codes', 'exc_exp_nibbles',\n    )\n    # UBLB-flat: the raw lower byte (lb_raw, M*K bytes = half the BF16) is the\n    # HBM-resident half (the analog of P4-flat's sign_mantissa); the nibble-\n    # packed upper-byte codes + 16-byte palette + (idx, ub) exception list ship\n    # to LPDDR.  Decode = flat_decode(code_stream, lb_raw, palette) + flat_patch.\n    _UBLB_FLAT_LPDDR_ATTRS = (\n        'code_stream', 'palette', 'exc_idx', 'exc_ub',\n    )\n    # ChunkDelta3 keeps the raw sign/mantissa byte plus tiny addressing tables\n    # resident on HBM.  The 3-bit codes, per-thread bases, and packed exception\n    # stream are transferred from LPDDR for each decode.\n    _CHUNK_DELTA3_LPDDR_ATTRS = (\n        'codes', 'thread_bases', 'entries17',\n    )\n    _CHUNK_DELTA3_HBM_ATTRS = (\n        'tile_exception_offsets', 'warp_prefixes',\n    )\n\n    # --- HBM-resident auxiliary buffers (beyond sign_mantissa) ---\n    # These are cloned onto HBM at compress time and NEVER H2D'd in the\n    # decode hot path.  Only ZipServ BF16 has any; other backends keep\n    # everything except sign_mantissa on LPDDR (empty tuple default).\n    _ZIPSERV_HBM_ATTRS = ('tile_offsets_median', 'tile_offsets_global')\n\n    _BACKEND_TO_HBM_ATTRS = {\n        'zipserv': _ZIPSERV_HBM_ATTRS,\n        'chunk_delta3': _CHUNK_DELTA3_HBM_ATTRS,\n    }\n\n    # Compressor-independent raw-exp split: only the uncompressed exponent\n    # crosses the bus (sign_mantissa stays HBM-resident); decode is a pure\n    # bit-merge, no entropy decode.\n    _RAW_EXP_LPDDR_ATTRS = ('raw_exp',)\n\n    _BACKEND_TO_ATTRS = {\n        'zipserv':     _ZIPSERV_LPDDR_ATTRS,\n        'dietgpu':     _DIETGPU_LPDDR_ATTRS,\n        'dietgpu_fp8': _DIETGPU_FP8_LPDDR_ATTRS,\n        'zipserv_fp8': _ZIPSERV_FP8_LPDDR_ATTRS,\n        'p4flat':      _P4FLAT_LPDDR_ATTRS,\n        'ublb_flat':   _UBLB_FLAT_LPDDR_ATTRS,\n        'p4d16':       _P4D16_LPDDR_ATTRS,\n        'p3flat_fp8':  _P3FLAT_FP8_LPDDR_ATTRS,\n        'chunk_delta3': _CHUNK_DELTA3_LPDDR_ATTRS,\n        'raw_exp':     _RAW_EXP_LPDDR_ATTRS,\n    }\n\n    def __init__(self, sign_mantissa: torch.Tensor,\n                 lpddr_buffers: Dict[str, torch.Tensor],\n                 metadata: Dict[str, int],\n                 backend: str = 'zipserv',\n                 lpddr_shared: bool = False,\n                 hbm_buffers: Optional[Dict[str, torch.Tensor]] = None):\n        self.sign_mantissa = sign_mantissa          # GPU permanent\n        # Optional phase-adaptive alternate compression of the SAME weight\n        # (e.g. a fast-decode p4flat codec used at prefill while this primary\n        # info is used at decode). It is a full SplitStorageInfo that ALIASES\n        # this one's ``sign_mantissa`` (only its compressed-exp side differs).\n        self.alt: Optional['SplitStorageInfo'] = None\n        self.lpddr_buffers = lpddr_buffers           # {attr_name: LPDDR hugepage tensor}\n        # Auxiliary buffers kept permanently on HBM alongside\n        # sign_mantissa (e.g. ZipServ tile_offsets); never H2D'd in the\n        # decode hot path.  {attr_name: GPU tensor}.\n        self.hbm_buffers: Dict[str, torch.Tensor] = hbm_buffers or {}\n        self.hbm_attrs: tuple = self._BACKEND_TO_HBM_ATTRS.get(backend, ())\n        self.backend = backend\n        # When True, the LPDDR buffer tensors are aliases owned elsewhere.\n        # Teardown must NOT call\n        # huge_page_allocator.free on them — that would invalidate the\n        # other owner's references and break the next reconfigure.\n        self.lpddr_shared = lpddr_shared\n        self.lpddr_attrs: tuple = self._BACKEND_TO_ATTRS.get(\n                    # prefill critical path entirely.\n                    lpddr_bufs: Dict[str, torch.Tensor] = {}\n                    attrs_to_ship = tuple(lpddr_attrs) + (\"raw_bf16\",)\n                    # ZipServ FP8 keeps its tensor fields nested under\n                    # comped._c; everything else exposes them on comped.\n                    src_obj = (comped._c\n                               if backend == \"zipserv_fp8\"\n                               else comped)\n                    for attr in attrs_to_ship:\n                        if attr == \"raw_bf16\":\n                            # gpu_target is contiguous and already in the\n                            # weight's native dtype (BF16 or FP8); reuse it\n                            # directly — no extra GPU allocation.  The\n                            # buffer key is kept as ``raw_bf16`` for\n                            # backwards-compat with downstream lookups even\n                            # when the dtype is FP8.\n                            gpu_buf = gpu_target\n                        else:\n                            gpu_buf = getattr(src_obj, attr)\n                            # DietGPU's compressed_exp may be over-allocated;\n                            # slice to the actual compressed size.\n                            if (backend in (\"dietgpu\", \"dietgpu_fp8\")\n                                    and attr == \"compressed_exp\"):\n                                gpu_buf = gpu_buf[:comped.exp_compressed_size]\n                        # Allocate hugepage first and D2H directly into\n                        # it — avoids materializing a transient pageable\n                        # CPU copy (gpu_buf.cpu()) which on GH200 ends\n                        # up as a large pinned allocation that counts\n                        # against the GPU process budget.\n                        gpu_buf = gpu_buf.contiguous()\n                        hp_t = self.huge_page_allocator.allocate(\n                            gpu_buf.shape, gpu_buf.stride(),\n                            gpu_buf.dtype, page_type=\"weight\")\n                        hp_t.copy_(gpu_buf)\n                        lpddr_bufs[attr] = hp_t\n\n                    # HBM-resident auxiliary buffers (ZipServ tile_offsets):\n                    # cloned onto HBM, never shipped to LPDDR, so the decode\n                    # H2D only moves the bulk codec payload.\n                    hbm_attrs = SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n                        backend, ())\n                    hbm_bufs = self._build_frozen_split_hbm_bufs(\n                        src_obj, hbm_attrs)\n\n                    # Canonical shared sm: when a DISTINCT prefill-alt codec is\n                    # enabled (e.g. p4flat), store ONE (M,K) row-major\n                    # all-element sign|mantissa on HBM (computed from the\n                    # weight) instead of zipserv's compacted HF-only stream, so\n                    # both the zipserv decode and the alt decode read it (no sm\n                    # duplication). Gated to zipserv BF16.  NOT used for the\n                    # UNIFIED case (alt == primary codec): there the alt aliases\n                    # the primary's own buffers verbatim, so the primary keeps\n                    # its normal compacted sm and the alt decodes identically.\n                    _canonical_sm = (self._prefill_alt_backend\n                                     and self._prefill_alt_backend != backend\n                                     and backend == \"zipserv\")\n                    if _canonical_sm:\n                        hbm_sm = self._compute_canonical_sm(gpu_target)\n\n                    frozen_split_dict[name] = SplitStorageInfo(\n                        hbm_sm, lpddr_bufs, metadata, backend=backend,\n                        hbm_buffers=hbm_bufs)\n                    if _canonical_sm:\n                        frozen_split_dict[name]._uses_canonical_sm = True\n\n                    # Phase-adaptive prefill-alt attach.  Two cases:\n                    #  * Unified (alt == primary codec): reuse the primary's\n                    #    own compressed buffers for the small-chunk prefill\n                    #    decode — no second compression, no extra LPDDR/HBM.\n                    #  * Distinct (e.g. p4flat): compress a second fast-decode\n                    #    copy that shares the HBM sign_mantissa.\n                    if self._prefill_alt_backend and not self._frozen_raw_exp:\n                        # Unified (reuse the primary's own compressed buffers)\n                        # when the configured alt matches the layer codec, OR\n                        # whenever the layer codec is ALREADY a cheap palette\n                        # decode (p4flat / ublb_flat) that the distinct path\n                        # would otherwise compress a second time — reuse it\n                        # directly (no extra LPDDR/HBM, and it avoids the\n                        # distinct path's p4flat-only crash when the configured\n                        # alt defaulted to the zipserv weight backend, e.g.\n                        # cao-p4 with the default --weight-comp).  Distinct path\n                        # only for a non-palette primary wanting a fast alt.\n                        if (self._prefill_alt_backend == backend\n                                or backend in (\"p4flat\", \"ublb_flat\")):\n                            self._attach_prefill_alt_same_codec(\n                                frozen_split_dict[name], metadata, name)\n                        else:\n                            self._attach_prefill_alt(\n                                frozen_split_dict[name], gpu_target,\n                                hbm_sm, name)\n\n                for idx in self.not_frozen_layers:\n                    if self.comp_secondary_buffers[idx] is None:\n                        continue\n                    buf_id = self._stream_slot[idx]\n                    for name in self.tensor_names:\n                        if name not in self.comp_secondary_buffers[idx]:\n                            continue\n                        comped = self.comp_secondary_buffers[idx][name]\n                        shared = self._comp_transfer_bufs[buf_id][name]\n                        comped.register_temp_d_tensor(\n                            self.primary_buffers[idx][name],\n                            gpu_pool=shared)\n\n        # --- Shared GPU staging buffers for frozen_split LPDDR→GPU transfer ---\n        if any_needs_frozen_split:\n            # Max-size scan across all frozen_split layers per tensor name.\n            # We track ``(numel, dtype)`` per attribute so the staging\n            # allocation honours backend-specific dtypes (BF16 / FP8) and\n            # ZipServ-FP8 has buffer types (e.g. ``small_in_group_hi``\n            # int16) that aren't in any hardcoded dtype map.\n            split_max: Dict[str, Dict[str, tuple]] = {}\n            for idx in range(self.n_layers):\n                if self.frozen_split_info[idx] is None:\n                    continue\n                for name, info in self.frozen_split_info[idx].items():\n                    cur = split_max.get(name)\n                    if cur is None:\n                        split_max[name] = {\n                            attr: (buf.numel(), buf.dtype)\n                            for attr, buf in info.lpddr_buffers.items()\n                        }\n                    else:\n                        for attr, buf in info.lpddr_buffers.items():\n                            prev_n, prev_dt = cur.get(attr, (0, buf.dtype))\n                            assert prev_dt == buf.dtype, (\n                                f\"frozen_split staging dtype mismatch for \"\n                                f\"{name}.{attr}: {prev_dt} vs {buf.dtype}\")\n                            cur[attr] = (max(prev_n, buf.numel()), buf.dtype)\n\n            # FROZEN_STAGING_PARITY staging sets per name keyed by\n            # layer parity (idx % FROZEN_STAGING_PARITY).  Independent of\n            # frozen_primary_buffer_pair's parity: staging is gated by\n            # explicit kernel_done_event so the H2D→kernel race is safe at\n            # P=2, while the decomp-output buffers need P=3 because their\n            # WAR vs exec_stream GEMM has no inter-stream event.\n            #\n            # raw_bf16 bypasses staging entirely — prefill H2Ds it\n            # directly into the per-layer output buffer.  (For FP8 weights\n            # the entry is still keyed ``raw_bf16`` for backwards-compat\n            # but its dtype is float8_e4m3fn / float8_e5m2.)\n            self.frozen_split_staging: Dict[\n                str, List[Dict[str, torch.Tensor]]] = {}\n            _STAGING_EXCLUDED = (\"raw_bf16\",)\n            for name, sizes in split_max.items():\n                self.frozen_split_staging[name] = [\n                    {\n                        attr: torch.empty(\n                            numel, dtype=dtype,\n                            device=self.primary_device)\n                        for attr, (numel, dtype) in sizes.items()\n                        if attr not in _STAGING_EXCLUDED\n\n        prefix = \"P\" if self.batch_has_prefill else \"D\"\n        msg = (f\"{prefix} Total: {total_time:.4f} Exec: {exec_time:.4f} \"\n               f\"Stall: {total_stall_time:.4f} \"\n               f\"(WeightBarrier: {weight_barrier_wait:.4f} \"\n               f\"AttnBarrier: {attn_barrier_wait:.4f})\")\n        if weight_load_time > 0.001:\n            msg += f\" WeightH2D: {weight_load_time:.4f}\"\n        if weight_decomp_time > 0.001:\n            msg += f\" WeightDecomp: {weight_decomp_time:.4f}\"\n        if kv_load_time > 0.001:\n            msg += f\" KVH2D: {kv_load_time:.4f}\"\n        if kv_comp_time > 0.001:\n            msg += f\" KVComp: {kv_comp_time:.4f}\"\n        if kv_decomp_time > 0.001:\n            msg += f\" KVDecomp: {kv_decomp_time:.4f}\"\n        if overlap_time > 0.001:\n            msg += f\" DecompOverlap: {overlap_time:.4f}\"\n        # The legacy \"{P,D} Total: ...\" console line is intentionally not\n        # logged (redundant with the [Breakdown] line below); the full\n        # string is still written to the time-log file and nvtx trace.\n        if self._time_log_file is not None:\n            self._time_log_file.write(msg + \"\\n\")\n            self._time_log_file.flush()\n        torch.cuda.nvtx.mark(msg)\n\n        # ── Per-stream breakdown: LLM / WDecomp / KVDecomp / WLoad /\n        #    KVLoad / Stall ──\n        # 