     command.extend([\n            \"--gpu-memory-utilization\",\n            str(gpu_memory_utilization),\n        ])\n    if fused_mm:\n        command.append(\"--fused-mm\")\n    if breakdown:\n        command.append(\"--time-breakdown\")\n    return command\n\n\ndef _sha(path: Path) -> str:\n    return sha256_file(path)\n\n\ndef _token_metadata(token_path: Path, batch: int) -> dict[str, Any]:\n    payload = json.loads(token_path.read_text())\n    if not isinstance(payload, list) or len(payload) != batch:\n        raise RuntimeError(\n            f\"generated-token dump has {len(payload) if isinstance(payload, list) else 'non-list'} \"\n            f\"sequences, expected batch={batch}: {token_path}\")\n    actual = [len(tokens) if isinstance(tokens, list) else -1\n              for tokens in payload]\n    expected = [GENERATION_TOKENS] * batch\n    if actual != expected:\n        raise RuntimeError(\n            f\"generated-token lengths are not exactly {GENERATION_TOKENS}: \"\n            f\"batch={batch} expected={expected} actual={actual}\")\n    return {\n        \"generation_tokens\": GENERATION_TOKENS,\n        \"generation_length_policy\": \"fixed_per_request\",\n        \"prefill_chunk_tokens\": PREFILL_CHUNK,\n        \"generated_tokens_path\": str(token_path),\n        \"generated_tokens_sha256\": _sha(token_path),\n    }\n\n\ndef _model_source_metadata() -> dict[str, Any]:\n    \"\"\"Resolve the exact local HF snapshot and fingerprint its shard manifest.\n\n    Reading every 70B shard merely to re-hash content would add hundreds of GB\n    of I/O before each orchestration run.  Hugging Face stores LFS weights under\n    their content SHA256 blob names, so we validate those names and hash the\n    deterministic ``filename:blob-sha:size`` manifest together with the index.\n    \"\"\"\n    hf_home = Path(os.environ.get(\n        \"HF_HOME\", str(Path.home() / \".cache\" / \"huggingface\")))\n    hub = Path(os.environ.get(\"HF_HUB_CACHE\", str(hf_home / \"hub\")))\n    repo = hub / \"models--meta-llama--Llama-3.1-70B-Instruct\"\n    ref = repo / \"refs\" / \"main\"\n    if not ref.is_file():\n        raise FileNotFoundError(\n            f\"cannot resolve the local checkpoint revision: {ref}\")\n    revision = ref.read_text().strip()\n    if not re.fullmatch(r\"[0-9a-f]{40}\", revision):\n        raise RuntimeError(f\"invalid Hugging Face revision in {ref}: {revision!r}\")\n    snapshot = repo / \"snapshots\" / revision\n    index = snapshot / \"model.safetensors.index.json\"\n    if not index.is_file():\n        raise FileNotFoundError(f\"checkpoint index missing: {index}\")\n    payload = json.loads(index.read_text())\n    weight_map = payload.get(\"weight_map\")\n    if not isinstance(weight_map, dict) or not weight_map:\n        raise RuntimeError(f\"checkpoint index has no weight_map: {index}\")\n    shard_names = sorted(set(weight_map.values()))\n    manifest_lines = []\n    for name in shard_names:\n        shard = snapshot / name\n        if not shard.is_file():\n            raise FileNotFoundError(f\"checkpoint shard missing: {shard}\")\n        blob_sha = shard.resolve().name\n        if not re.fullmatch(r\"[0-9a-f]{64}\", blob_sha):\n            raise RuntimeError(\n                f\"weight shard is not backed by a SHA256-named HF blob: {shard}\")\n        manifest_lines.append(f\"{name}:{blob_sha}:{shard.stat().st_size}\")\n    manifest_hash = hashlib.sha256(\n        (sha256_file(index) + \"\\n\" + \"\\n\".join(manifest_lines)).encode()\n    ).hexdigest()\n    return {\n        \"model_source\": MODEL,\n        \"model_snapshot_revision\": revision,\n        \"model_snapshot_path\": str(snapshot),\n        \"model_index_path\": str(index),\n        \"model_index_sha256\": sha256_file(index),\n        \"model_weight_shards\": len(shard_names),\n        \"model_weight_manifest_sha256\": manifest_hash,\n    }\n\n\ndef _environment_metadata() -> dict[str, Any]:\n    \"\"\"Collect runtime/GPU identity without retaining a CUDA context.\"\"\"\n    meta: dict[str, Any] = {\n        **git_metadata(_REPO_ROOT),\n        **_model_source_metadata(),\n        \"torch_version\": torch.__version__,\n        \"cuda_runtime\": torch.version.cuda or \"\",\n        \"gpu_name\": \"\",\n        \"gpu_driver_version\": \"\",\n        \"gpu_memory_mib\": \"\",\n    }\n    try:\n        proc = subprocess.run(\n            [\"nvidia-smi\", \"--query-gpu=name,driver_version,memory.total\",\n             \"--format=csv,noheader,nounits\", \"--id=0\"],\n            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n            text=True)\n        values = [value.strip() for value in proc.stdout.splitlines()[0].split(\",\")]\n        if len(values) == 3:\n            meta.update({\n                \"gpu_name\": values[0],\n                \"gpu_driver_version\": values[1],\n                \"gpu_memory_mib\": values[2],\n            })\n    except (OSError, subprocess.SubprocessError, IndexError):\n        pass\n    return meta\n\n\ndef _run(\n    command: list[str],\n    log_path: Path,\n    gen_prefix: Path,\n    *,\n    dry_run: bool,\n) -> None:\n    print(\" \".join(command), flush=True)\n    if dry_run:\n        return\n    env = _process_env(command)\n    env[\"TIERED_SERVE_DUMP_GEN\"] = str(gen_prefix)\n    _drop_caches()\n    try:\n        with log_path.open(\"w\") as log:\n            proc = subprocess.run(\n                command, cwd=_REPO_ROOT, env=env,\n                stdout=log, stderr=subprocess.STDOUT)\n    finally:\n        _drop_caches()\n    if proc.returncode != 0:\n        tail = log_path.read_text(errors=\"replace\").splitlines()[-60:]\n        raise RuntimeError(\n            f\"E2E command failed ({proc.returncode}); log={log_path}\\n\" +\n            \"\\n\".join(tail))\n\n\ndef _process_env(command: list[str]) -> dict[str, str]:\n    \"\"\"Return the reproducible environment for one official E2E process.\"\"\"\n"}],"internal_chat_message_metadata_passt