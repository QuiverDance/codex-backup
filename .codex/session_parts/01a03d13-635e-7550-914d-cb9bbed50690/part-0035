llowed by exact fused GEMM.\n\nThe codec's sign/mantissa payload stays resident in HBM.  Only the buffers\nlisted by SplitStorageInfo as LPDDR-resident are copied from pinned host memory\ninto preallocated HBM staging.  The fused GEMM runs on a compute stream after\nwaiting for that copy, matching the frozen_split all-fused dependency chain.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport gc\nimport logging\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.fuseGEMM import (\n    DEFAULT_WEIGHTS_DIR,\n    flush_l2_cache,\n    load_real_projections,\n    proj_shapes,\n)\nfrom tiered_serve.compression.core import (\n    ChunkDelta3Compressor,\n    P4FlatCompressor,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.cpp_exts import zipserv_ext\n\n\nlogging.getLogger().setLevel(logging.WARNING)\nlogging.getLogger(\"vllm\").setLevel(logging.WARNING)\n\n_EXP_ATTRS = {\n    \"p4flat\": SplitStorageInfo._P4FLAT_LPDDR_ATTRS,\n    \"chunk_delta3\": SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS,\n}\n\n\ndef _percentile(values: list[float], q: float) -> float:\n    ordered = sorted(values)\n    return ordered[int(q * (len(ordered) - 1))]\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    return min(values), statistics.median(values), _percentile(values, 0.95)\n\n\ndef _make_codec(name: str):\n    if name == \"p4flat\":\n        codec = P4FlatCompressor()\n    elif name == \"chunk_delta3\":\n        codec = ChunkDelta3Compressor(torch.cuda.current_stream())\n    else:\n        raise ValueError(name)\n    codec._fused_max_n_override = 10**9\n    return codec\n\n\ndef _stage_exponent(comp, attrs: tuple[str, ...]):\n    \"\"\"Keep native sign/mantissa intact; replace only exponent attrs by HBM slots.\"\"\"\n    target = comp._c\n    sources 