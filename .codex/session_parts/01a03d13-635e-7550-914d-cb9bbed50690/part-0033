{"timestamp":"2026-08-27T11:14:11.129Z","ordinal":2904,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042ed-6c39-7220-98e8-49a2124ee3ef","call_id":"call_aRed6pKd50z9bYyJ6zmKcpIB","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass CompressedP4FlatTensor:\n    \"\"\"Container around the native :class:`CompressedP4Flat` struct.\n\n    Mirrors GPU/host tensor fields onto Python instance attrs so the loader\n    can iterate ``_BUFFER_ATTRS`` and stage them through a pool, matching\n    the pattern used by :class:`CompressedZipServFP8GpuTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"headers\", \"codes\", \"sign_mantissa\",\n        \"subtile_codec\",\n        \"exc_indices\", \"exc_values\",\n        \"exc_sorted_indices\", \"exc_sorted_values\",\n        \"exc_group_m\", \"exc_group_offsets\",\n    )\n    # Pre-computed (attr, d_attr) pairs — avoids 10 f-string allocations\n    # per .to() / register_temp_d_tensor call (320 calls/step → 3200 fewer\n    # transient str objects per decode step).\n    _BUFFER_ATTR_D_PAIRS = tuple((a, f\"_d_{a}\") for a in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        # Cached narrow views into GPU staging buffers, created once in\n        # register_temp_d_tensor and reused by every .to() call.  Eliminates\n        # 10 view + 10 setattr(self._c, ...) per .to() call (320 calls/step\n        # → 6400 fewer transient Python objects per decode step).\n        self._h2d_views: Optional[tuple] = None\n        self._h2d_srcs: Optional[tuple] = None\n        self._gpu_buf_cache: Optional[tuple] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def num_groups(self) -> int:\n        return int(self._c.num_groups)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n                               gpu_pool: Optional[Dict[str, torch.Tensor]] = None\n                               ) -> None:\n        \"\"\"Bind decompress destination + per-attr GPU staging slots.\n\n        Pre-creates narrow views into the GPU staging buffers and pushes\n        them into the C struct once, so the per-decode ``.to()`` only does\n        ``copy_`` — no f-strings, no view creation, no per-call setattr.\n        \"\"\"\n        self.output_tensor = temp_d\n        device = temp_d.device\n        views = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            src = getattr(self, attr)\n            if gpu_pool is not None and attr in gpu_pool:\n                dst = gpu_pool[attr]\n            else:\n                dst = torch.empty_like(src, device=device)\n            setattr(self, d_attr, dst)\n            n = src.numel()\n            view = dst[:n] if n > 0 else dst\n            views.append(view)\n            # Set C struct tensor pointer once — the view object is reused\n            # across decode steps, so the pointer never changes.\n            setattr(self._c, attr, view)\n        self._h2d_views = tuple(views)\n        self._h2d_srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n        self._gpu_buf_cache = None  # invalidate get_gpu_buffers cache\n\n    def to_host(self, huge_page_allocator=None\n                ) -> \"CompressedP4FlatTensor\":\n        \"\"\"Move all compressed buffers to pinned/hugepage CPU memory.\"\"\"\n        for attr in self._BUFFER_ATTRS:\n            gpu_tensor = getattr(self, attr)\n            if gpu_tensor.numel() == 0:\n                cpu_tensor = gpu_tensor.to(\"cpu\")\n            elif huge_page_allocator is not None:\n                gpu_tensor = gpu_tensor.contiguous()\n                try:\n                    hp_tensor = huge_page_allocator.allocate(\n                        gpu_tensor.shape, gpu_tensor.stride(),\n                        gpu_tensor.dtype, page_type=\"weight\")\n                    hp_tensor.copy_(gpu_tensor)\n                    cpu_tensor = hp_tensor\n                except (MemoryError, ValueError):\n                    logger.warning(\n                        \"Hugepage exhausted for P4Flat to_host (attr=%s); \"\n                        \"falling back to pinned memory\", attr)\n                    cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            else:\n                cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            setattr(self, attr, cpu_tensor)\n            setattr(self._c, attr, cpu_tensor)\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n        self._h2d_views = None\n        self._h2d_srcs = None\n        self._gpu_buf_cache = None\n        import gc\n        gc.collect()\n        torch.cuda.empty_cache()\n        return self\n\n    def to(self, device=\"cuda\", non_blocking=True) -> None:\n        \"\"\"H2D copy CPU-resident buffers into pre-bound GPU staging slots.\n\n        Hot path: called ~320×/step (4 components × ~80 layers).  Uses\n        pre-cached narrow views and source tensors from\n        ``register_temp_d_tensor`` and dispatches ALL 10 copies in a single\n        C++ call (``batch_h2d``), eliminating 10 Python → C++ frame\n        transitions per call (~2880/step) that were the dominant source of\n        CPython frame data-stack 16 KiB boundary crossings (mmap/munmap).\n        \"\"\"\n        del device\n        views = self._h2d_views\n        if views is None:\n            raise RuntimeError(\n                \"CompressedP4FlatTensor.to(): call register_temp_d_tensor first\")\n        srcs = self._h2d_srcs\n        if srcs is None:\n            srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n            self._h2d_srcs = srcs\n        # Single C++ dispatch: copies all 10 (src, dst) pairs on the current\n        # CUDA stream without leaving this Python frame.\n        _p4f_ext.batch_h2d(srcs, views)\n\n    def get_gpu_buffers(self):\n        cache = self._gpu_buf_cache\n        if cache is not None:\n            return cache\n        views = self._h2d_views\n        if views is not None:\n            # Reuse the same narrow views created by register_temp_d_tensor\n            # — the data is updated in-place by .to(), so the views always\n            # reflect the latest GPU staging contents.\n            self._gpu_buf_cache = views\n            return views\n        out = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            n = getattr(self, attr).numel()\n            dst = getattr(self, d_attr)\n            out.append(dst[:n] if n > 0 else dst)\n        cache = tuple(out)\n        self._gpu_buf_cache = cache\n        return cache\n\n\nclass P4FlatCompressor(TensorCompressor):\n    \"\"\"BF16 P4-flat weight compressor backed by tiered-serve's\n    ``zipserv_p4flat_ext`` PyTorch C++ extension.\n\n    Per-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa\n    byte. Out-of-palette exponents are stored as a separate (index,\n    value) list and reinjected by the patch kernel during decompress\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n                Bpb[:N].copy_(x2)\n                Bp = Bpb\n            # Cbuf[n, m] = sum_k W[m,k]*x[n,k] = F.linear(x, W)[n, m].\n            # Split-K fills the GPU at decode N (see ublb _u4_split_k); the\n            # production p4 path passes no in-kernel exceptions so split-K is safe.\n            sk = _u4_split_k(M, Npad, K)\n            # Split-K fp32 partials: pool like Cbuf/Bpb (keyed by sk too) instead\n            # of torch.empty every call -- the kernel overwrites all sk*Npad*M\n            # partials before the in-launch reduce, so reuse is safe, and at\n            # decode-N this churned the caching allocator (size scales with M, so\n            # QKV/GateUp were worst).\n            if sk > 1:\n                ckey = (\"cf32\", sk, Npad, M, x2.device.index)\n                cf32 = sc.get(ckey)\n                if cf32 is None:\n                    cf32 = torch.empty(sk, Npad, M, dtype=torch.float32, device=x2.device)\n                    sc[ckey] = cf32\n            else:\n                cf32 = _empty_f32(x2.device)\n            ext.p4_rs_wgmma_mm(codes, sm, headers, codec, Bp, Cbuf, cf32, sk, M, Npad, K)\n            if n_exc > 0:\n                # Sum exception corrections in an fp32 scratch and fold into the\n                # bf16 output with a SINGLE rounding -- accumulating directly in\n                # bf16 is non-associative and raced to out-of-tolerance error on\n                # collision-heavy shapes (many exceptions per output row).\n                ycorr = torch.zeros(M, Npad, dtype=torch.float32, device=x2.device)\n                ext.p4_exc_correct(exc_idx, exc_val, codes, sm, headers, codec,\n                                   Bp, ycorr, n_exc, Npad, K, M)\n                y = (Cbuf[:N].float() + ycorr[:, :N].t()).to(torch.bfloat16)\n            else:\n                y = Cbuf[:N]\n        else:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            A = self.decompress(comp)\n            if we is not None:\n                we.record()\n            if A.device != x2.device:\n                A = A.to(x2.device)\n            y = F.linear(x2, A)\n        return y.reshape(*orig[:-1], M)\n\n    def build_split_shell(\n        self,\n        info,\n        staging_dict: Dict[str, torch.Tensor],\n    ) -> CompressedP4FlatTensor:\n        \"\"\"Construct a fused-MM-ready :class:`CompressedP4FlatTensor` whose\n        ``sign_mantissa`` is the HBM-permanent slice and whose remaining\n        codec buffers are aliased onto the layer's frozen-split staging\n        slot.  Used by the loader's ``--fused-mm`` install path so the\n        forward override can call ``linear_apply`` without first\n        materialising the dense weight.\n\n        ``staging_dict`` is ``self.frozen_split_staging[name][parity]``\n        — a dict of ``attr -> staging tensor`` populated by the H2D\n        producer every forward.  Tensors are *aliased*, not copied;\n        consumers must serialise against the H2D event chain that\n        decompress already waits on.\n        \"\"\"\n        # Dual-codec safety: the frozen_split fused-install loop iterates EVERY\n        # frozen_split (layer, component) with a single _compressor_for_mode\n        # instance, but a model can mix codecs per component (e.g. zipserv for\n        # some, p4flat for others). Only build a p4flat shell for p4flat-backed\n        # info; for any other backend raise NotImplementedError so the install\n        # loop skips this layer (it catches NotImplementedError) instead of\n        # mis-binding zipserv attrs (e.g. 'compressed_full') onto a p4flat struct.\n        info_backend = getattr(info, \"backend\", None)\n        if info_backend != \"p4flat\":\n            raise NotImplementedError(\n                f\"P4Flat build_split_shell: info.backend={info_backend!r} is \"\n                f\"not 'p4flat' (dual-codec layer); skipping fused install here.\")\n\n        # Allocate a bare struct and bind its tensor fields to the\n        # combined HBM (sm) + staging (rest) buffers.  Metadata fields\n        # come from ``info``.\n        c = _p4f_ext.CompressedP4Flat()\n        c.sign_mantissa = info.sign_mantissa            # HBM permanent\n        for attr in info.lpddr_attrs:\n            t = staging_dict.get(attr)\n            if t is None:\n                raise RuntimeError(\n                    f\"P4Flat build_split_shell: staging slot missing '{attr}'\")\n            setattr(c, attr, t)\n        c.M = int(info.M)\n        c.K = int(info.K)\n        c.num_exceptions = int(info.num_exceptions)\n        c.num_groups = int(getattr(info, \"num_groups\", 0))\n        # Wrap so register_temp_d_tensor / linear_apply see the right type.\n        return CompressedP4FlatTensor(c)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a042ec-803c-78e2-a2ab-4e6f1fff5d4d","create_time":1787829251.1297014}}}
