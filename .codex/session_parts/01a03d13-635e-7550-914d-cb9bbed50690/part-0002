ing\n        codec buffers are aliased onto the layer's frozen-split staging\n        slot.  Used by the loader's ``--fused-mm`` install path so the\n        forward override can call ``linear_apply`` without first\n        materialising the dense weight.\n\n        ``staging_dict`` is ``self.frozen_split_staging[name][parity]``\n        — a dict of ``attr -> staging tensor`` populated by the H2D\n        producer every forward.  Tensors are *aliased*, not copied;\n        consumers must serialise against the H2D event chain that\n        decompress already waits on.\n        \"\"\"\n\n=== P4Flat binding ===\n/*\n * zipserv_p4flat_ext.cpp — PyTorch C++ extension wrapper for the BF16\n * P4-flat codec (sources copied from LLM-bitfield-compressor).\n *\n * Compress runs on the host (histogram + palette select + 4-bit pack)\n * and stages the result onto GPU buffers.  Decompress and fused MM run\n * entirely on device.\n *\n * Layout:\n *   - one 16-entry exponent palette per 64x64 tile\n *   - 4-bit palette code per element (row-major)\n *   - 1-byte sign|mantissa per element (row-major)\n *   - rare out-of-palette elements: (uint32 index, uint16 value) list\n *\n * The compress side additionally builds a CSR-style exception index\n * (sorted by row m) so that the fused MM's rank-1 patch kernel can\n * iterate row-grouped exceptions without doing a per-call sort.\n */\n\n#include <torch/extension.h>\n#include <c10/cuda/CUDAStream.h>\n#include <c10/cuda/CUDAGuard.h>\n#include <cuda_runtime.h>\n\n#include <algorithm>\n#include <cstdint>\n#include <cstring>\n#include <utility>\n#include <vector>\n\n#include \"zipserv_p4flat.cuh\"\n\nnamespace py = pybind11;\n\nnamespace {\n\n#define CUDA_CHECK_THROW(call) do { \\\n    cudaError_t _e = (call); \\\n    if (_e != cudaSuccess) { \\\n        TORCH_CHECK(false, \"CUDA error \", cudaGetErrorName(_e), \\\n                    \": \", cudaGetErrorString(_e)); \\\n    } \\\n} while (0)\n\nstruct CompressedP4Flat {\n    /* Compressed buffers — initially on CUDA after compress(). */\n    torch::Tensor headers;              // uint8 reinterpreted as BF16P4FlatHeader[]\n    torch::Tensor codes;                // uint8, M*K/2 bytes (4-bit packed, tile-blocked)\n    torch::Tensor sign_mantissa;        // uint8, M*K bytes (tile-blocked)\n    torch::Tensor subtile_codec;        // uint8, M*K/256 bytes — per 16x16 subtile codec marker\n    torch::Tensor exc_indices;          // uint32 (int64 layout), raw insertion order\n    torch::Tensor exc_values;           // uint16 (int16 layout), raw insertion order\n    /* Sorted-by-m metadata — kept on the struct for ABI parity with\n     * earlier checkpoints / dual_memory_loader split-shell rebuilds.\n     * Decompress itself only needs exc_indices + exc_values. */\n    torch::Tensor exc_sorted_indices;   // uint32 (int64 layout)\n    torch::Tensor exc_sorted_values;    // uint16 (int16 layout)\n    torch::Tensor exc_group_m;          // uint32 (int64 layout), [num_groups]\n    torch::Tensor exc_group_offsets;    // uint32 (int64 layout), [num_groups + 1]\n\n    int64_t M = 0;\n    int64_t K = 0;\n    int64_t num_exceptions = 0;\n    int64_t num_groups = 0;\n    /* When true, sign_mantissa is a plain (M,K) row-major all-element stream\n     * (the canonical form shared across codecs in frozen_split) rather than\n     * the native tile-blocked layout. Set on the manually-rebuilt shell. */\n    bool row_major_sm = false;\n\n    int64_t nbytes() const {\n        auto add = [](int64_t acc, const torch::Tensor& t) {\n            return acc + (t.defined() ? t.nbytes() : 0);\n        };\n        int64_t n = 0;\n        n = add(n, headers);\n        n = add(n, codes);\n        n = add(n, sign_mantissa);\n        n = add(n, subtile_codec);\n        n = add(n, exc_indices);\n        n = add(n, exc_values);\n        return n;\n    }\n};\n\n/* ─── GPU compress path ─────────────────────────────────────────────\n * Runs entirely on device; exception postprocessing (sort-by-m + group\n * CSR) is done host-side after a tiny D2H of the exception list. */\nstatic CompressedP4Flat p4flat_compress_gpu(torch::Tensor weight) {\n    int M = (int)weight.size(0);\n    int K = (int)weight.size(1);\n    int64_t n = (int64_t)M * K;\n    constexpr int G = BF16_P4F_TILE_DIM;\n    int num_tiles_m = M / G;\n    int num_tiles_k = K / G;\n    int num_tiles = num_tiles_m * num_tiles_k;\n    int64_t code_bytes = (int64_t)((n + 1) / 2);\n\n    auto w_c = weight.is_contiguous() ? weight : weight.contiguous();\n    auto stream = c10::cuda::getCurrentCUDAStream();\n\n    auto i8_opts  = torch::TensorOptions().dtype(at::kByte).device(torch::kCUDA);\n    auto i32_opts = torch::TensorOptions().dtype(at::kInt).device(torch::kCUDA);\n    auto i16_opts = torch::TensorOptions().dtype(at::kShort).device(torch::kCUDA);\n\n    /* Worst-case exception budget: max(n/100, 16384). Real LLM weights\n     * see ~0.005% exception rate, so 1% is a 200× safety margin. The\n     * kernel asserts via clamp; we re-check after the kernel returns. */\n    int64_t max_exc = std::max<int64_t>((int64_t)16384, n / 100);\n    if (max_exc > n) max_exc = n;\n\n    auto headers_t = torch::empty(\n        {(int64_t)num_tiles * (int64_t)sizeof(BF16P4FlatHeader)}, i8_opts);\n    /* Compress writes flat (M, K) row-major, then we relayout to the\n     * tile-blocked form consumed by decompress (~15% faster). */\n    auto codes_flat    = torch::zeros({code_bytes}, i8_opts);\n    auto sm_flat       = torch::empty({n}, i8_opts);\n    auto exc_idx_worst = torch::empty({max_exc}, i32_opts);\n    auto exc_val_worst = torch::empty({max_exc}, i16_opts);\n    auto exc_count_t   = torch::empty({1}, i32_opts);\n\n    cudaError_t err = BF16P4Flat_CompressGPU_API(\n        stream.stream(),\n        reinterpret_cast<const uint16_t*>(w_c.data_ptr()),\n        M, K,\n        reinterpret_cast<BF16P4FlatHeader*>(headers_t.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes_flat.data_ptr()),\n        reinterpret_cast<uint8_t*>(sm_flat.data_ptr()),\n        reinterpret_cast<uint32_t*>(exc_idx_worst.data_ptr()),\n        reinterpret_cast<uint16_t*>(exc_val_worst.data_ptr()),\n        (int)max_exc,\n        reinterpret_cast<int*>(exc_count_t.data_ptr()));\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_CompressGPU_API failed: \", cudaGetErrorString(err));\n\n    auto codes_t = torch::empty({code_bytes}, i8_opts);\n    auto sm_t    = torch::empty({n},          i8_opts);\n    err = BF16P4Flat_RelayoutToBlocked(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes_flat.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm_flat.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes_t.data_ptr()),\n        reinterpret_cast<uint8_t*>(sm_t.data_ptr()),\n        M, K);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_RelayoutToBlocked failed: \", cudaGetErrorString(err));\n\n    /* Classify each 16x16 subtile and re-encode delta-eligible codes\n     * in place.  Decompress reads the per-subtile marker and takes\n     * either the 1-ADD delta path or the palette path. */\n    int64_t subtile_codec_bytes = (int64_t)(M / 16) * (int64_t)(K / 16);\n    auto subtile_codec_t = torch::empty({subtile_codec_bytes}, i8_opts);\n    err = BF16P4Flat_BuildSubtileCodec(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(headers_t.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes_t.data_ptr()),\n        reinterpret_cast<uint8_t*>(subtile_codec_t.data_ptr()),\n        M, K);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_BuildSubtileCodec failed: \", cudaGetErrorString(err));\n\n    int exc_count_host = 0;\n    CUDA_CHECK_THROW(cudaMemcpyAsync(&exc_count_host, exc_count_t.data_ptr(),\n                                     sizeof(int), cudaMemcpyDeviceToHost,\n                                     stream.stream()));\n    CUDA_CHECK_THROW(cudaStreamSynchronize(stream.stream()));\n    TORCH_CHECK(exc_count_host <= max_exc,\n                \"P4-flat GPU compress: exception budget exceeded \"\n                \"(got=\", exc_count_host, \" max=\", max_exc,\n                \"). Re-run with a larger budget or use the CPU path.\");\n    int num_exceptions = exc_count_host;\n\n    /* Narrow exception buffers to the exact count. */\n    torch::Tensor exc_indices, exc_values;\n    if (num_exceptions > 0) {\n        exc_indices = exc_idx_worst.narrow(0, 0, num_exceptions).clone();\n        exc_values  = exc_val_worst.narrow(0, 0, num_exceptions).clone();\n    } else {\n        exc_indices = torch::zeros({1}, i32_opts);\n        exc_values  = torch::zeros({1}, i16_opts);\n    }\n\n    /* Sort-by-m + CSR group-offsets postprocessing (rank-1 patch path).\n     * Tiny payload — runs on host after a D2H of just the exception list. */\n    torch::Tensor exc_sorted_indices, exc_sorted_values;\n    torch::Tensor exc_group_m, exc_group_offsets;\n    int num_groups = 0;\n    if (num_exceptions > 0) {\n        std::vector<uint32_t> h_idx(num_exceptions);\n        std::vector<uint16_t> h_val(num_exceptions);\n        CUDA_CHECK_THROW(cudaMemcpyAsync(\n            h_idx.data(), exc_indices.data_ptr(),\n            num_exceptions * sizeof(uint32_t),\n            cudaMemcpyDeviceToHost, stream.stream()));\n        CUDA_CHECK_THROW(cudaMemcpyAsync(\n            h_val.data(), exc_values.data_ptr(),\n            num_exceptions * sizeof(uint16_t),\n            cudaMemcpyDeviceToHost, stream.stream()));\n        CUDA_CHECK_THROW(cudaStreamSynchronize(stream.stream()));\n\n        std::vector<size_t> order(num_exceptions);\n        for (size_t i = 0; i < order.size(); ++i) order[i] = i;\n        std::sort(order.begin(), order.end(),\n                  [&h_idx](size_t a, size_t b) {\n                      return h_idx[a] < h_idx[b];\n                  });\n        std::vector<uint32_t> sorted_idx(num_exceptions);\n        std::vector<uint16_t> sorted_val(num_exceptions);\n        for (size_t i = 0; i < order.size(); ++i) {\n            sorted_idx[i] = h_idx[order[i]];\n            sorted_val[i] = h_val[order[i]];\n        }\n        std::vector<uint32_t> group_m, group_offsets;\n        group_offsets.push_back(0);\n        uint32_t cur_m = sorted_idx[0] / (uint32_t)K;\n        group_m.push_back(cur_m);\n        for (size_t i = 1; i < sorted_idx.size(); ++i) {\n            uint32_t mi = sorted_idx[i] / (uint32_t)K;\n            if (mi != cur_m) {\n                group_offsets.push_back((uint32_t)i);\n                group_m.push_back(mi);\n                cur_m = mi;\n            }\n        }\n        group_offsets.push_back((uint32_t)sorted_idx.size());\n        num_groups = (int)group_m.size();\n\n        auto h2d_i32 = [&](const std::vector<uint32_t>& v) {\n            int64_t i32_elems = std::max<int64_t>((int64_t)v.size(), 1);\n            auto t = torch::zeros({i32_elems}, i32_opts);\n            if (!v.empty()) {\n                CUDA_CHECK_THROW(cudaMemcpyAsync(\n                    t.data_ptr(), v.data(), v.size() * sizeof(uint32_t),\n                    cudaMemcpyHostToDevice, stream.stream()));\n            }\n            return t;\n        };\n        auto h2d_i16 = [&](const std::vector<uint16_t>& v) {\n            int64_t elems = std::max<int64_t>((int64_t)v.size(), 1);\n            auto t = torch::zeros({elems}, i16_opts);\n            if (!v.empty()) {\n                CUDA_CHECK_THROW(cudaMemcpyAsync(\n                    t.data_ptr(), v.data(), v.size() * sizeof(uint16_t),\n                    cudaMemcpyHostToDevice, stream.stream()));\n            }\n            return t;\n        };\n        exc_sorted_indices = h2d_i32(sorted_idx);\n        exc_sorted_values  = h2d_i16(sorted_val);\n        exc_group_m        = h2d_i32(group_m);\n        exc_group_offsets  = h2d_i32(group_offsets);\n        CUDA_CHECK_THROW(cudaStreamSynchronize(stream.stream()));\n    } else {\n        exc_sorted_indices = torch::zeros({1}, i32_opts);\n        exc_sorted_values  = torch::zeros({1}, i16_opts);\n        exc_group_m        = torch::zeros({1}, i32_opts);\n        exc_group_offsets  = torch::zeros({1}, i32_opts);\n    }\n\n    CompressedP4Flat out;\n    out.headers       = headers_t;\n    out.codes         = codes_t;\n    out.sign_mantissa = sm_t;\n    out.subtile_codec = subtile_codec_t;\n    out.exc_indices   = exc_indices;\n    out.exc_values    = exc_values;\n    out.exc_sorted_indices = exc_sorted_indices;\n    out.exc_sorted_values  = exc_sorted_values;\n    out.exc_group_m        = exc_group_m;\n    out.exc_group_offsets  = exc_group_offsets;\n    out.M = M;\n    out.K = K;\n    out.num_exceptions = num_exceptions;\n    out.num_groups = num_groups;\n    return out;\n}\n\n/* ─── Lean GPU compress for the KV path ──────────────────────────────\n * Runs ONLY the three device kernels (compress + relayout-to-blocked +\n * subtile-codec) and returns the raw device buffers plus the worst-case\n * exception list and a [1] device exception count.\n *\n * Differs from p4flat_compress_gpu in two ways that matter for batched KV\n * compression:\n *   1. NO host synchronisation — p4flat_compress_gpu does up to three\n *      cudaStreamSynchronize (exc-count readback + the sort-by-m / CSR\n *      group post-processing for the fused-MM rank-1 patch).  The KV\n *      decoder only consumes exc_indices / exc_values, so all of that is\n *      skipped and the whole call stays on-stream (async / non-blocking).\n *   2. The exception count is returned as a device int32[1] tensor instead\n *      of a host scalar, so the Python caller D2Hs it together with the\n *      payload and reads it after a single stream sync.\n *\n * The caller treats a [B*valid_rows, K_b] vertical stack of B blocks as the\n * (M, K) matrix: p4flat tiles are independent 64x64 units, so every tile —\n * hence every block — is compressed independently in one launch, and the\n * returned buffers are the per-block buffers concatenated in block order.\n * exc_indices hold global indices into the stack (block = idx / block_numel).\n *\n * Returns (headers, codes, sign_mantissa, subtile_codec, exc_idx_worst,\n *          exc_val_worst, exc_count) — all on CUDA. */\nstd::tuple<torch::Tensor, torch::Tensor, torch::Tensor, torch::Tensor,\n           torch::Tensor, torch::Tensor, torch::Tensor>\np4flat_compress_lean(torch::Tensor weight) {\n    TORCH_CHECK(weight.dim() == 2, \"weight must be 2D\");\n    TORCH_CHECK(weight.scalar_type() == at::kBFloat16,\n                \"weight dtype must be bfloat16\");\n    TORCH_CHECK(weight.is_cuda(), \"p4flat_compress_lean requires a CUDA tensor\");\n    int M = (int)weight.size(0);\n    int K = (int)weight.size(1);\n    constexpr int G = BF16_P4F_TILE_DIM;\n    TORCH_CHECK(M % G == 0 && K % G == 0,\n                \"M and K must be multiples of \", G, \" (got \", M, \"x\", K, \")\");\n    int64_t n = (int64_t)M * K;\n    int num_tiles = (M / G) * (K / G);\n    int64_t code_bytes = (int64_t)((n + 1) / 2);\n\n    auto w_c = weight.is_contiguous() ? weight : weight.contiguous();\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    auto i8  = torch::TensorOptions().dtype(at::kByte).device(torch::kCUDA);\n    auto i32 = torch::TensorOptions().dtype(at::kInt).device(torch::kCUDA);\n    auto i16 = torch::TensorOptions().dtype(at::kShort).device(torch::kCUDA);\n\n    int64_t max_exc = std::max<int64_t>((int64_t)16384, n / 100);\n    if (max_exc > n) max_exc = n;\n\n    auto headers    = torch::empty(\n        {(int64_t)num_tiles * (int64_t)sizeof(BF16P4FlatHeader)}, i8);\n    auto codes_flat = torch::zeros({code_bytes}, i8);\n    auto sm_flat    = torch::empty({n}, i8);\n    auto exc_idx    = torch::empty({max_exc}, i32);\n    auto exc_val    = torch::empty({max_exc}, i16);\n    auto exc_count  = torch::zeros({1}, i32);\n\n    CUDA_CHECK_THROW(BF16P4Flat_CompressGPU_API(\n        stream.stream(),\n        reinterpret_cast<const uint16_t*>(w_c.data_ptr()),\n        M, K,\n        reinterpret_cast<BF16P4FlatHeader*>(headers.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes_flat.data_ptr()),\n        reinterpret_cast<uint8_t*>(sm_flat.data_ptr()),\n        reinterpret_cast<uint32_t*>(exc_idx.data_ptr()),\n        reinterpret_cast<uint16_t*>(exc_val.data_ptr()),\n        (int)max_exc,\n        reinterpret_cast<int*>(exc_count.data_ptr())));\n\n    auto codes = torch::empty({code_bytes}, i8);\n    auto sm    = torch::empty({n}, i8);\n    CUDA_CHECK_THROW(BF16P4Flat_RelayoutToBlocked(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes_flat.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm_flat.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<uint8_t*>(sm.data_ptr()),\n        M, K));\n\n    int64_t subtile_bytes = (int64_t)(M / 16) * (int64_t)(K / 16);\n    auto subtile = torch::empty({subtile_bytes}, i8);\n    CUDA_CHECK_THROW(BF16P4Flat_BuildSubtileCodec(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(headers.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<uint8_t*>(subtile.data_ptr()),\n        M, K));\n\n    return std::make_tuple(headers, codes, sm, subtile,\n                           exc_idx, exc_val, exc_count);\n}\n\nCompressedP4Flat p4flat_compress(torch::Tensor weight) {\n    TORCH_CHECK(weight.dim() == 2, \"weight must be 2D\");\n    TORCH_CHECK(weight.scalar_type() == at::kBFloat16,\n                \"weight dtype must be bfloat16\");\n    int M = (int)weight.size(0);\n    int K = (int)weight.size(1);\n    TORCH_CHECK(M % BF16_P4F_TILE_DIM == 0 && K % BF16_P4F_TILE_DIM == 0,\n                \"M and K must be multiples of \", BF16_P4F_TILE_DIM,\n                \" (got \", M, \"x\", K, \")\");\n\n    if (weight.is_cuda()) {\n        return p4flat_compress_gpu(weight);\n    }\n\n    /* CPU fallback: kept for CPU-resident inputs (e.g. weights still on\n     * pinned host memo