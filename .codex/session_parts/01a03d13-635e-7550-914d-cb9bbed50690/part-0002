mpression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old_arch_list = _os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n_os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _os.environ.get(\n    \"TIERED_SERVE_CUDA_ARCH\", _default_cuda_arch)\n\n# SM_90a-only WGMMA kernels — built only on Hopper hosts. On Blackwell the\n# fused decompress+GEMM path falls back to the SM_120-compatible\n# zipserv_fused_mm_gpu.cu (ldmatrix + mma.m16n8k16) kernel.\n_is_hopper = _default_cuda_arch.startswith(\"9.\")\n_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_cluster_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_2wg_sm90.cu\",\n] if _is_hopper else []\n\n# When WGMMA sources are omitted, define ZIPSERV_NO_WGMMA so the call sites\n# in zipserv_fused_mm_gpu.cu / zipserv_p4flat_fused_mm.cu /\n# zipserv_p4wg_fused_mm.cu emit stub launchers that return cudaErrorNotSupported.\n_wgmma_defines = [] if _is_hopper else [\"-DZIPSERV_NO_WGMMA=1\"]\n\n_p4flat_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# P4-WG codec — same compression as p4flat but 8x8 subblock layout for\n# WGMMA-friendly fused decompress+GEMM.  WGMMA path is Hopper-only (sm_90a);\n# on Blackwell only the ldmatrix-based fused_mm kernel is built.\n_p4wg_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4wg_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# nvcomp SDK is optional — only build the extension if its headers are\n# available. Without it the nvcomp-backed compressors stay disabled (their\n# Python wrappers log a warning, same as the WGMMA-disabled path).\ndef _nvcomp_include_dir():\n    for candidate in (\"/usr/include/nvcomp_13\", \"/usr/include/nvcomp_12\",\n                      \"/usr/include\"):\n        if _os.path.isfile(_os.path.join(candidate, \"nvcomp\", \"gdeflate.hpp\")):\n            return candidate\n    return None\n\n_nvcomp_inc = _nvcomp_include_dir()\n\n# ---------------------------------------------------------------------------\n# Parallel build: torch's JIT load() builds each extension sequentially, and\n# with only a handful of sources per extension a single heavy nvcc invocation\n# serialises the whole import.  Extensions have distinct names -> distinct\n# build dirs (FileBaton-locked individually), so building them concurrently\n# is safe.  TIERED_SERVE_BUILD_JOBS caps concurrent extension builds; each\n# build's internal ninja parallelism is capped via MAX_JOBS (unless the user\n# already set it) so the total stays around the core count.\n# ---------------------------------------------------------------------------\n_n_build_workers = int(_os.environ.get(\"TIERED_SERVE_BUILD_JOBS\", \"8\"))\n_old_max_jobs = _os.environ.get(\"MAX_JOBS\")\nif _old_max_jobs is None:\n    _os.environ[\"MAX_JOBS\"] = str(\n        max(2, (_os.cpu_count() or 8) // _n_build_workers))\n\n_build_pool = ThreadPoolExecutor(max_workers=_n_build_workers)\n_futures = {}\n\ndef _submit(name, **kwargs):\n    _futures[name] = _build_pool.submit(load, name=name, **kwargs)\n\n_submit(\n    \"huge_page_allocator\",\n    sources=[\n        \"cpp_extensions/csrc/huge_page_allocator.cpp\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\",\n        \"-O3\",\n        \"-std=gnu++17\",\n    ],\n    extra_ldflags=[f\"-L{sysconfig.get_config_var('LIBDIR')}\", \"-lcuda\"],\n)\n\n# Build before kv_offload_system\n_submit(\n    \"unload_worker_ext\",\n    sources=[\n        \"cpp_extensions/csrc/unload_worker_ext.cpp\",\n        \"cpp_extensions/csrc/utils.cpp\",\n    ],\n    extra_include_paths=[\n        \"cpp_extensions/csrc/include\"\n    ],\n    extra_cflags=[\"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\"],\n    with_cuda=True,\n    extra_ldflags=[\n        # \"-Wl,-rpath,/usr/lib/sbsa-linux-gnu/nvcomp/12\",\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\", \"-lcuda\",\n        # \"-L/usr/lib/sbsa-linux-gnu/nvcomp/12\", \"-lnvcomp\"\n    ])\n\n_submit(\n    \"zipserv_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/zipserv/zipserv_ext.cpp\",\n        \"tiered_serve/compression/adapters/zipserv/kv_compress_worker.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_compress_gpu.cu\",\n        \"tiered_serve/compression/cuda/zipserv_decompress_gpu.cu\",\n        \"tiered_serve/compression/adapters/cuda/zipserv_fused_mm_gpu.cu\",\n        *_wgmma_sources,\n        \"tiered_serve/compression/cuda/zipserv_nib4_gpu.cu\",\n        \"tiered_serve/compression/cuda/ublb_gpu.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _zipserv_kernel_dir, _cutlass_include],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\", \"-fopenmp\",\n        *_wgmma_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\",\n        *_wgmma_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n        \"-lgomp\",\n    ])\n\n_submit(\n    \"zipserv_p4flat_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p4flat.cu\",\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_mm.cu\",\n        *_p4flat_wgmma_sources,\n    ],\n    with_cuda=True,\n    # CUTLASS include path needed for the WGMMA kernel's cute headers.\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir, _cutlass_include],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        # -mcpu=grace: target the GH200 Grace core (Neoverse V2, armv9-a + SVE2)\n        # for both ISA and pipeline tuning, so host_encode_blocks vectorises +\n        # schedules for V2.  -funroll-loops for the tight per-tile inner loops.\n        # (host integer encode -> byte-identical output.)\n        \"-mcpu=grace\", \"-funroll-loops\",\n        \"-fopenmp\",  # host_encode_blocks parallelises across KV blocks\n        *_wgmma_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n        *_wgmma_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\", \"-fopenmp\",\n    ],\n)\n\n# ZipServ Offset-Table (OT) ablation codec — replaces ZipServ's bitmap\n# + __popcll dynamic addressing with explicit per-group offset tables.\n# Decoder-only ablation experiment; no fused MM, no WGMMA path.\n_submit(\n    \"zipserv_ot_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_ot_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_ot.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\n_submit(\n    \"zipserv_p4wg_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4wg_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p4wg.cu\",\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4wg_fused_mm.cu\",\n        *_p4wg_wgmma_sources,\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir, _cutlass_include],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        *_wgmma_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n        *_wgmma_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\n# FP8 e4m3 P3-flat (3-bit code + marker scheme + 4-bit sm nibble).\n# Same SM90a arch as the BF16 P4-flat above; uses warp shfl prefix-sum\n# for intra-tile marker rank computation.\n_submit(\n    \"zipserv_p3flat_fp8_ext\",\n    sources=[\n        \"tiered_serve/compression/cuda/zipserv_p3flat_fp8_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p3flat_fp8.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\n# BF16 Global-P4-D16 codec (variant B from LLM-bitfield-compressor's\n# p4variants ablation). Same D16-marker subtile encoding as p4flat but\n# the 16-entry exponent palette is tensor-global instead of per-tile.\n_submit(\n    \"zipserv_p4d16_ext\",\n    sources=[\n        \"tiered_serve/compression/cuda/zipserv_p4d16_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p4d16.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\n_submit(\n    \"zipserv_fp8_ext\",\n    sources=[\n        \"tiered_serve/compression/cuda/zipserv_fp8_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_fp8_e4m3.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\", \"-fopenmp\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xcompiler\", \"-fopenmp\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n        \"-lgomp\",\n    ],\n)\n\n_submit(\n    \"dietgpu_fp8_reconstruct_ext\",\n    sources=[\n        \"tiered_serve/compression/cuda/dietgpu_fp8_reconstruct_ext.cpp\",\n        \"tiered_serve/compression/cuda/dietgpu_fp8_reconstruct.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\nif _nvcomp_inc is not None:\n    _nvcomp_libdir_rel = \"nvcomp/13\" if _nvcomp_inc.endswith(\"13\") else (\n        \"nvcomp/12\" if _nvcomp_inc.endswith(\"12\") else \"\")\n    _submit(\n        \"nvcomp_ext\",\n        sources=[\n            \"cpp_extensions/csrc/nvcomp_ext.cpp\",\n            \"tiered_serve/compression/cuda/ublb_gpu.cu\",\n        ],\n        with_cuda=True,\n        extra_include_paths=[_nvcomp_inc],\n        extra_cflags=[\n            \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        ],\n        extra_cuda_cflags=[\n            \"--std=c++17\", \"-O3\", \"--use_fast_math\",\n        ],\n        extra_ldflags=[\n            f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n            f\"-L/usr/lib/{_libarch}\",\n            f\"-L/usr/lib/{_libarch}/{_nvcomp_libdir_rel}\" if _nvcomp_libdir_rel else f\"-L/usr/lib/{_libarch}\",\n            f\"-Wl,-rpath,/usr/lib/{_libarch}/{_nvcomp_libdir_rel}\" if _nvcomp_libdir_rel else f\"-Wl,-rpath,/usr/lib/{_libarch}\",\n            \"-lcuda\",\n            \"-lnvcomp\",\n        ],\n    )\nelse:\n    import logging as _logging\n    _logging.getLogger(\"vllm\").warning(\n        \"nvcomp_ext disabled: nvcomp SDK headers (nvcomp/gdeflate.hpp) not \"\n        \"found under /usr/include/nvcomp_13|12. Install libnvcomp-dev or \"\n        \"the nvcomp CUDA SDK package to enable nvcomp-backed compressors.\")\n\n# Wait for every build; surface the first failure (same behaviour as the old\n# sequential imports, just without serialising the compiles).\n_exts = {_name: _future.result() for _name, _future in _futures.items()}\n_build_pool.shutdown()\n\n# Restore original TORCH_CUDA_ARCH_LIST / MAX_JOBS\nif _old_arch_list is not None:\n    _os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _old_arch_list\nelse:\n    _os.environ.pop(\"TORCH_CUDA_ARCH_LIST\", None)\nif _old_max_jobs is None:\n    _os.environ.pop(\"MAX_JOBS\", None)\n\nhuge_page_allocator_ext = _exts[\"huge_page_allocator\"]\n\nunload_worker_ext = _exts[\"unload_worker_ext\"]\nsys.modules['tiered_serve.cpp_exts.unload_worker_ext'] = unload_worker_ext\n\nzipserv_ext = _exts[\"zipserv_ext\"]\n\nzipserv_p4flat_ext = _exts[\"zipserv_p4flat_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4flat_ext'] = zipserv_p4flat_ext\n\nzipserv_ot_ext = _exts[\"zipserv_ot_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_ot_ext'] = zipserv_ot_ext\n\nzipserv_p4wg_ext = _exts[\"zipserv_p4wg_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4wg_ext'] = zipserv_p4wg_ext\n\n\n=== compressor_base ===\n\"\"\"Abstract base class for weight tensor compressors.\n\nEvery concrete compressor in :mod:`tiered_serve.tensor_compressor`\n(``UBLBCompressor``, ``ZipServCompressor``, ``DietGPUCompressor``,\n``DietGPUFP8Compressor``, ``ZipServFP8GpuCompressor``) inherits from\n:class:`TensorCompressor` defined here.\n\nShared infrastructure provided by the base class:\n\n* ``self.comp_stream`` — per-instance CUDA stream for compress /\n  decompress.  Created on the current device when the caller does not\n  supply one (and ``None`` on CPU-only hosts).\n* :func:`TensorCompressor._jit_load_ext` — thin wrapper around\n  :func:`torch.utils.cpp_extension.load` that resolves source paths\n  under ``cpp_extensions/csrc`` so subclasses do not have to repeat\n  the same ``os.path.join(__file__, \"..\", ...)`` boilerplate.\n* :func:`TensorCompressor._log_compress_ratio` — uniform info-level log\n  line for compress operations.\n\nThe :class:`CompressedTensor` :class:`typing.Protocol` documents (and,\nunder ``isinstance`` checks, validates) the structural interface every\n``Compressed*Tensor`` class exposes to consumers.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Iterable, Optional, Protocol, runtime_checkable\n\nimport torch\n\n\nlogger = logging.getLogger(__name__)\n\n\n@runtime_checkable\nclass CompressedTensor(Protocol):\n    \"\"\"Structural protocol satisfied by every ``Compressed*Tensor`` class.\n\n    Attributes:\n        output_tensor: Optional pre-allocated decompress destination.\n\n    Properties:\n        total_compressed_size: Total bytes occupied by the compressed\n            payload(s).  Used for ratio logging and slot accounting.\n        nbytes: Alias for total_compressed_size where applicable.\n\n    Methods:\n        to(device): Return a copy of the compressed payload(s) staged on\n            the requested device (or update internal GPU buffers in place\n            for compressors that support it).\n    \"\"\"\n\n    output_tensor: Optional[torch.Tensor]\n\n    @property\n    def total_compressed_size(self) -> int: ...  # pragma: no cover\n\n    def to(self, device: Any) -> \"CompressedTensor\": ...  # pragma: no cover\n\n\nclass TensorCompressor(ABC):\n    \"\"\"Abstract base class for weight tensor compressors.\n\n    Subclasses must implement :meth:`compress` and :meth:`decompress`.\n    They may override :meth:`fused_mm` to provide a fused\n    decompress + GEMM kernel; otherwise the default implementation\n    decompresses then calls :func:`torch.mm`.\n\n    Two CUDA streams are provided so compress and decompress can run\n    concurrently (e.g. compressing layer N+1 while decompressing layer\n    N for matmul):\n\n    * ``self.comp_stream``   — used by :meth:`compress`.\n    * ``self.decomp_stream`` — used by :meth:`decompress` /\n      :meth:`fused_mm`.\n\n    Both default to freshly allocated :class:`torch.cuda.Stream` instances\n    on CUDA hosts and ``None`` on CPU-only hosts.  Either may be passed\n    explicitly by the caller (e.g. to share a stream with an upstream\n    pipeline stage).\n    \"\"\"\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_s