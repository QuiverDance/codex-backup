{"timestamp":"2026-08-26T08:07:49.980Z","ordinal":162,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d1c-73dc-7910-8801-dfe9855c5785","call_id":"call_lv0ZJZ22iELw5uzccC2oEpol","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"=== P4D16 Python ===\n\"\"\"BF16 Global-P4-D16 weight compressor.\n\nVariant B from the p4variants ablation: same 16×16 subtile D16\ncodec marker scheme as P4-flat, but the 16-entry exponent palette\nis tensor-global (not per-tile).  Saves ~16 B × num_tiles of palette\nstorage; decompress throughput is on par with P4-flat (memory-bound\non sm + codes + output bandwidth).\n\nNative PyTorch C++ extension lives at\n``tiered_serve.cpp_exts.zipserv_p4d16_ext``.  M and K must be\nmultiples of 64.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4d16_ext as _p4d16_ext\n    _HAS_P4D16 = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4D16Compressor disabled: failed to load \"\n        f\"zipserv_p4d16_ext ({type(_e).__name__}: {_e})\")\n    _p4d16_ext = None\n    _HAS_P4D16 = False\n\n\nclass CompressedP4D16Tensor:\n    \"\"\"Container around the native :class:`CompressedP4D16` struct.\n\n    Mirrors the GPU/host tensor fields onto Python instance attrs so the\n    loader can iterate ``_BUFFER_ATTRS`` and stage them through a pool,\n    matching the pattern used by :class:`CompressedP4FlatTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"global_palette\", \"markers\", \"codes\", \"sign_mantissa\",\n        \"exc_indices\", \"exc_values\",\n    )\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, f\"_d_{attr}\", None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n                               gpu_pool: Optional[Dict[str, torch.Tensor]] = None\n                               ) -> None:\n        self.output_tensor = temp_d\n        device = temp_d.device\n        for attr in self._BUFFER_ATTRS:\n            src = getattr(self, attr)\n            d_attr = f\"_d_{attr}\"\n            if gpu_pool is not None and attr in gpu_pool:\n                setattr(self, d_attr, gpu_pool[attr])\n            else:\n                setattr(self, d_attr, torch.empty_like(src, device=device))\n\n    def to_host(self, huge_page_allocator=None\n                ) -> \"CompressedP4D16Tensor\":\n        for attr in self._BUFFER_ATTRS:\n            gpu_tensor = getattr(self, attr)\n            if gpu_tensor.numel() == 0:\n                cpu_tensor = gpu_tensor.to(\"cpu\")\n            elif huge_page_allocator is not None:\n                gpu_tensor = gpu_tensor.contiguous()\n                try:\n                    hp_tensor = huge_page_allocator.allocate(\n                        gpu_tensor.shape, gpu_tensor.stride(),\n                        gpu_tensor.dtype, page_type=\"weight\")\n                    hp_tensor.copy_(gpu_tensor)\n                    cpu_tensor = hp_tensor\n                except (MemoryError, ValueError):\n                    logger.warning(\n                        \"Hugepage exhausted for P4D16 to_host (attr=%s); \"\n                        \"falling back to pinned memory\", attr)\n                    cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            else:\n                cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            setattr(self, attr, cpu_tensor)\n            setattr(self._c, attr, cpu_tensor)\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, f\"_d_{attr}\", None)\n        import gc\n        gc.collect()\n        torch.cuda.empty_cache()\n        return self\n\n    def to(self, device=\"cuda\", non_blocking=True) -> None:\n        del device\n        for attr in self._BUFFER_ATTRS:\n            src = getattr(self, attr)\n            d_attr = f\"_d_{attr}\"\n            dst = getattr(self, d_attr)\n            if dst is None:\n                raise RuntimeError(\n                    f\"CompressedP4D16Tensor.to(): {d_attr} not assigned \"\n                    f\"(call register_temp_d_tensor first)\")\n            if dst.numel() < src.numel():\n                raise RuntimeError(\n                    f\"CompressedP4D16Tensor.to(): {d_attr} staging buffer \"\n                    f\"too small: {dst.numel()} < {src.numel()}\")\n            n = src.numel()\n            view = dst[:n] if n > 0 else dst\n            if n > 0:\n                view.copy_(src, non_blocking=non_blocking)\n            setattr(self._c, attr, view)\n\n    def get_gpu_buffers(self):\n        out = []\n        for attr in self._BUFFER_ATTRS:\n            n = getattr(self, attr).numel()\n            dst = getattr(self, f\"_d_{attr}\")\n            out.append(dst[:n] if n > 0 else dst)\n        return tuple(out)\n\n\nclass P4D16Compressor(TensorCompressor):\n    \"\"\"BF16 Global-P4-D16 weight compressor backed by tiered-serve's\n    ``zipserv_p4d16_ext`` PyTorch C++ extension.\n\n    Tensor-global 16-entry exponent palette + 16x16 subtile