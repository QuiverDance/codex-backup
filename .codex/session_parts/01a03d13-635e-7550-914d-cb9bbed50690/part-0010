) {\n   534\t        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n   535\t    };\n   536\t\n   537\t    // p4flat tile data is contiguous per tile (tile-blocked) -> simple copies.\n   538\t    auto load_compressed = [&](int k_tile, int st) {\n   539\t        const int tile_idx = tile_m * tiles_k + k_tile;\n   540\t        const int64_t cbase = static_cast<int64_t>(tile_idx) * 2048;\n   541\t        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n   542\t        cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n   543\t        #pragma unroll\n   544\t        for (int j = 0; j < 2; ++j) {\n   545\t            const int c = tid + j * 128;\n   546\t            cp_async_16(&smem.s_sm[st][c << 4], sm_g + sbase + (c << 4));\n   547\t        }\n   548\t        if (tid == 0) cp_async_16(&smem.s_pal[st][0], headers_g + tile_idx * 16);\n   549\t        if (tid == 1) cp_async_16(&smem.s_marker[st][0], codec_g + tile_idx * 16);\n   550\t    };\n   551\t\n   552\t    CUTE_UNROLL\n   553\t    for (int s = 0; s < Stages - 1; ++s) {\n   554\t        if (s < tk_split) { load_b(k0 + s, s); load_compressed(k0 + s, s); }\n   555\t        cp_async_fence();\n   556\t    }\n   557\t\n   558\t    for (int kk = 0; kk < tk_split; ++kk) {\n   559\t        cp_async_wait<Stages - 2>();\n   560\t        __syncthreads();\n   561\t\n   562\t        decode_regA(kk % Stages);\n   563\t        warpgroup_fence_operand(tCrA);\n   564\t        warpgroup_arrive();\n   565\t        gemm(tiled_mma, tCrA, tCrB(_, _, _, kk % Stages), tCrC);\n   566\t        warpgroup_commit_batch();\n   567\t\n   568\t        const int knext = kk + Stages - 1;\n   569\t        if (knext < tk_split) { load_b(k0 + knext, knext % Stages);\n   570\t                                load_compressed(k0 + knext, knext % Stages); }\n   571\t        cp_async_fence();\n   572\t\n   573\t        warpgroup_wait<0>();\n   574\t        __syncthreads();\n   575\t    }\n   576\t\n   577\t 