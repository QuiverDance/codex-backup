tte + raw lower byte. Decoded in\n    10\t *                   the producer path (branchless, no cumsum, no exceptions).\n    11\t *\n    12\t * This isolates \"is fusion competitive?\" (Step 1: E1 vs cuBLAS) from\n    13\t * \"does decode survive in the producer path?\" (Step 2: U4 vs E1) — the kernel\n    14\t * body (B-load, WGMMA pipeline, epilogue) is byte-identical across modes.\n    15\t *\n    16\t * Convention (matches the proven zipserv fused WGMMA kernel):\n    17\t *   A = weight   [M, K] row-major,  A[m,k] = A[m*K + k]\n    18\t *   B = activate [N, K] row-major,  B[n,k] = B[n*K + k]\n    19\t *   C = output   [M, N] COLUMN-major, C[m,n] = C[m + n*M]\n    20\t *   C[m,n] = sum_k A[m,k] * B[n,k]   (i.e. C = A @ B^T)\n    21\t */\n    22\t#include <cuda_bf16.h>\n    23\t#include <cuda_runtime.h>\n    24\t#include <cstdint>\n    25\t\n    26\t#include <cutlass/bfloat16.h>\n    27\t#include <cutlass/cutlass.h>\n    28\t#include <cute/arch/mma_sm90.hpp>\n    29\t#include <cute/tensor.hpp>\n    30\t\n    31\t// Slim double-buffered smem: just the WGMMA A/B operand tiles. No decode\n    32\t// scratch — the producer writes A elements straight into the swizzled tile.\n    33\t// Shared by the raw_pipe (E1) kernel and its launch helper.\n    34\ttemplate <int TileN, int Stages>\n    35\tstruct LabSmem {\n    36\t    using SmemLayoutA = decltype(\n    37\t        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n    38\t                            cute::make_shape(cute::Int<64>{}, cute::Int<64>{},\n    39\t                                             cute::Int<Stages>{})));\n    40\t    using SmemLayoutB = decltype(\n    41\t        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n    42\t                            cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{},\n    43\t                                             cute::Int<Stages>{})));\n    44\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n    45\t                                   cute::cosize_v<SmemLayoutA>> A;\n    46\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n    47\t                                   cute::cosize_v<SmemLayoutB>> B;\n    48\t};\n    49\t\n    50\t// ============================================================================\n    51\t// B-1: deep multi-stage cp.async pipelined RAW GEMM (E1, cuBLAS-grade attempt).\n    52\t//\n    53\t// Replaces the 2-stage synchronous producer with an S-stage cp.async ring so\n    54\t// many weight loads are in flight (the prior kernel sat at ~14% HBM because\n    55\t// only 2 stages of synchronous loads were ever outstanding). A and B are both\n    56\t// dense BF16 here, so cp.async streams them straight into the swizzled smem\n    57\t// tiles via CuTe copy atoms. Single warpgroup; relies on memory-level\n    58\t// parallelism (deep pipeline) rather than warp specialization for now.\n    59\t// ============================================================================\n    60\ttemplate <int TileN, class MmaOp, int Stages>\n    61\t__global__ void raw_pipe_kernel(\n    62\t    const __nv_bfloat16* __restrict__ A_g,\n    63\t    const __nv_bfloat16* __restrict__ B_g,\n    64\t    __nv_bfloat16*       __restrict__ C_g,\n    65\t    int M, int N, int K)\n    66\t{\n    67\t#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    68\t    using namespace cute;\n    69\t    constexpr int kTileM = 64, kTileK = 64;\n    70\t    using Smem = LabSmem<TileN, Stages>;\n    71\t    using SmemLayoutA = typename Smem::SmemLayoutA;\n    72\t    using SmemLayoutB = typename Smem::SmemLayoutB;\n    73\t\n    74\t    extern __shared__ __align__(128) uint8_t raw_smem[];\n    75\t    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    76\t    auto sA = make_tensor(make_smem_ptr(smem.A.begin()), SmemLayoutA{});\n    77\t    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), SmemLayoutB{});\n    78\t\n    79\t    const int tid     = static_cast<int>(threadIdx.x);\n    80\t    const int tile_n  = static_cast<int>(blockIdx.x);\n    81\t    const int tile_m  = static_cast<int>(blockIdx.y);\n    82\t    const int tiles_k = K >> 6;\n    83\t\n    84\t    // Global operand tensors (row-major), tiled along K.\n    85\t    auto mA = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(A_g)),\n    86\t                          make_layout(make_shape(M, K), make_stride(K, Int<1>{})));\n    87\t    auto gA = local_tile(mA, make_shape(Int<kTileM>{}, Int<kTileK>{}),\n    88\t                         make_coord(tile_m, _));          // (64,64,tiles_k)\n    89\t    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n    90\t                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    91\t    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n    92\t                         make_coord(tile_n, _));          // (TileN,64,tiles_k)\n    93\t\n    94\t    // G->S cp.async tiled copy: 128 threads, 8 bf16 (uint128) per thread along K.\n    95\t    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    96\t    auto tiled_copy = make_tiled_copy(\n    97\t        G2S{},\n    98\t        Layout<Shape<_16, _8>, Stride<_8, _1>>{},  // thr: 16 along M, 8 along K-grp\n    99\t        Layout<Shape<_1, _8>>{});                  // val: 8 along K\n   100\t    auto thr_copy = tiled_copy.get_slice(tid);\n   101\t    auto tAgA = thr_copy.partition_S(gA);          // (CPY,_,_,tiles_k)\n   102\t    auto tAsA = thr_copy.partition_D(sA);          // (CPY,_,_,Stages)\n   103\t    auto tBgB = thr_copy.partition_S(gB);\n   104\t    auto tBsB = thr_copy.partition_D(sB);\n   105\t\n   106\t    // MMA setup.\n   107\t    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n   108\t                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n   109\t    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n   110\t                              make_coord(tile_m, tile_n));\n   111\t    auto tiled_mma = make_tiled_mma(MmaOp{});\n   112\t    auto thr_mma   = tiled_mma.get_thread_slice(tid);\n   113\t    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n   114\t    clear(tCrC);\n   115\t    auto tCrA = thr_mma.make_fragment_A(thr_mma.partition_A(sA));\n   116\t    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n   117\t\n   118\t    // Prefetch first Stages-1 k-tiles.\n   119\t    CUTE_UNROLL\n   120\t    for (int s = 0; s < Stages - 1; ++s) {\n   121\t        if (s < tiles_k) {\n   122\t            copy(tiled_copy, tAgA(_, _, _, s), tAsA(_, _, _, s));\n   123\t            copy(tiled_copy, tBgB(_, _, _, s), tBsB(_, _, _, s));\n   124\t        }\n   125\t        cp_async_fence();\n   126\t    }\n   127\t\n   128\t    for (int k = 0; k < tiles_k; ++k) {\n   129\t        cp_async_wait<Stages - 2>();\n   130\t        __syncthreads();\n   131\t\n   132\t        const int read = k % Stages;\n   133\t        warpgroup_arrive();\n   134\t        gemm(tiled_mma, tCrA(_, _, _, read), tCrB(_, _, _, read), tCrC);\n   135\t        warpgroup_commit_batch();\n   136\t        warpgroup_wait<0>();\n   137\t\n   138\t        const int knext = k + Stages - 1;\n   139\t        if (knext < tiles_k) {\n   140\t            const int write = knext % Stages;\n   141\t            copy(tiled_copy, tAgA(_, _, _, knext), tAsA(_, _, _, write));\n   142\t            copy(tiled_copy, tBgB(_, _, _, knext), tBsB(_, _, _, write));\n   143\t        }\n   144\t        cp_async_fence();\n   145\t        __syncthreads();\n   146\t    }\n   147\t\n   148\t    auto tCgC = thr_mma.partition_C(gC_tile);\n   149\t    CUTE_UNROLL\n   150\t    for (int i = 0; i < size(tCrC); ++i)\n   151\t        tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n   152\t#endif\n   153\t}\n   154\t\n   155\t// 16-byte cp.async (global->shared), committed via cute::cp_async_fence().\n   156\t__device__ __forceinline__ void cp_async_16(void* smem, const void* gmem)\n   157\t{\n   158\t#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 800)\n   159\t    unsigned s = static_cast<unsigned>(__cvta_generic_to_shared(smem));\n   160\t    asm volatile(\"cp.async.cg.shared.global [%0], [%1], 16;\\n\"\n   161\t                 :: \"r\"(s), \"l\"(gmem) : \"memory\");\n   162\t#endif\n   163\t}\n   164\t\n   165\t// ============================================================================\n   166\t// B-2: deep cp.async pipelined UBLB-FLAT fused GEMM (U4pipe).\n   167\t//\n   168\t// Same S-stage pipeline as raw_pipe, but the A operand is compressed: each\n   169\t// stage cp.async-loads the tile's nibble code stream + raw lower bytes into\n   170\t// linear staging smem, then a decode pass (palette[code]<<8 | lb) writes the\n   171\t// swizzled bf16 A tile that WGMMA consumes. B (dense) streams directly like\n   172\t// raw. Exceptions are ignored (clean-only upper bound, as in the U4 kernel).\n   173\t// ============================================================================\n   174\ttemplate <int TileN, int Stages>\n   175\tstruct U4RSSmem {\n   176\t    using SmemLayoutB = decltype(cute::tile_to_shape(\n   177\t        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n   178\t        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n   179\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n   180\t    // Compressed-A staging (coalesced cp.async target); decoded into registers.\n  1560\t# ── RS-mode (register-A) fused decompress+GEMM extension ───────────────\n  1561\t# Built from cpp_extensions/csrc/fused_gemm/{wgmma_lab.cu,wgmma_lab_binding.cpp}\n  1562\t# (needs CUTLASS + sm_90a). Same module name as the experimental lab loader so\n  1563\t# the JIT build is shared/cached. Referenced by absolute path so it works\n  1564\t# regardless of sys.path (e.g. inside a vLLM worker process).\n  1565\t_RS_EXT = None\n