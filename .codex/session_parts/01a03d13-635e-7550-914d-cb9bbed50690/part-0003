{"timestamp":"2026-08-26T08:08:39.350Z","ordinal":179,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d1d-34b6-7a71-9109-f5d4b9908d2f","call_id":"call_gx9UFg93gGssQOTHp1lVKmRl","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        _sync: bool = True,\n    ) -> \"list[CompressedTensor]\":\n        \"\"\"Compress a batch of weights in a single launch.\n\n        Subclasses with a true batched primitive (e.g. nvcomp's\n        ``BatchedXXXCompressAsync``) should override this to avoid the\n        per-tensor host sync incurred by the default fallback.  The base\n        implementation (callable via ``super().compress_batch(...)``)\n        loops over :meth:`compress`.\n        \"\"\"\n        n = len(weights)\n        decomp_outs = decomp_output_tensors or [None] * n\n        comp_outs = comp_output_tensors or [None] * n\n        results: \"list[CompressedTensor]\" = []\n        for w, d_out, c_out in zip(weights, decomp_outs, comp_outs):\n            results.append(self.compress(w, d_out, c_out, _sync=_sync))\n        return results\n\n    @abstractmethod\n    def decompress_batch(\n        self,\n        comps: \"list[CompressedTensor]\",\n        outputs: \"Optional[list[torch.Tensor]]\" = None,\n    ) -> \"list[torch.Tensor]\":\n        \"\"\"Decompress a batch of compressed tensors in a single launch.\n\n        Subclasses with a true batched primitive should override.  The\n        base implementation (callable via\n        ``super().decompress_batch(...)``) loops over :meth:`decompress`.\n        \"\"\"\n        outs = outputs or [None] * len(comps)\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\n\n    # ------------------------------------------------------------------\n    #  Async batch API\n    # ------------------------------------------------------------------\n    #\n    # ``compress_batch_async`` schedules batch compression and returns\n    # immediately; ``wait_compress_async`` blocks until the previously\n    # scheduled work completes.  Used by the KV offload pipeline to\n    # overlap compress with the next layer's GPU compute.\n    #\n    # The default implementation runs ``compress_batch`` on a private\n    # background thread and returns a ``concurrent.futures.Future``.  This\n    # works for any backend whose ``compress_batch`` releases the GIL\n    # (true for the C++ ZipServ ext and for GPU paths that just enqueue\n    # CUDA work).\n    #\n    # Backends with native async (e.g. KV worker pool, GPU CUDA streams)\n    # override BOTH methods with their own signatures — typically a\n    # caller-supplied key (such as ``layer_id``) instead of a Future.\n    # The convention is: ``wait_compress_async`` accepts whatever object\n    # ``compress_batch_async`` returned, OR the same key the caller\n    # passed in.  Signatures are intentionally ``*args, **kwargs`` in\n    # the base because per-backend they vary (KV needs cache-tensor +\n    # block-id args; weight needs a ``list[Tensor]``).\n\n    _async_pool = None  # type: ignore[assignment]\n\n    @classmethod\n    def _get_async_pool(cls):\n        \"\"\"Lazily-allocated single-thread pool for the default async path.\"\"\"\n        if cls._async_pool is None:\n            from concurrent.futures import ThreadPoolExecutor\n            cls._async_pool = ThreadPoolExecutor(\n                max_workers=1, thread_name_prefix=\"TensorCompressor-async\")\n        return cls._async_pool\n\n    def compress_batch_async(\n        self,\n        *args: Any,\n        key: Any = None,\n        output_buffers: Any = None,\n        n_subs_per_block: int = 0,\n        **kwargs: Any,\n    ) -> Any:\n        \"\"\"Schedule a batched compression and return immediately.\n\n        Standard parameters (recognized by both weight and KV backends):\n\n        * ``key``               — opaque identifier the caller will pass\n          to :meth:`wait_compress_async` (KV uses ``layer_id``).  Default\n          backends ignore it and return a Future instead.\n        * ``output_buffers``    — pre-allocated destinations.  Weight: a\n          list of ``CompressedTensor`` slots; KV: a 2-tuple\n          ``(k_cache, v_cache)``.  Default backends ignore it and let the\n          underlying ``compress_batch`` allocate freshly.\n        * ``n_subs_per_block``  — worker-pool fan-out hint.  ``0`` =\n          backend chooses (typically auto: thread-per-block when\n          ``n_blocks ≥ n_workers``, else multi-thread-per-block).  ``1``\n          = thread-per-block.  ``> 1`` = MT-per-block with this fan-out.\n          Default backends ignore it.\n\n        Default behaviour: dispatches ``compress_batch(*args, **kwargs)``\n        on a background thread and returns a\n        :class:`concurrent.futures.Future`.  Backends with a native async\n        pipeline (KV worker manager / GPU CUDA streams) override this\n        with their own positional signature (e.g.\n        ``(layer_id, block_ids, gpu_k, gpu_v)``) and consume the keyword\n        parameters above.\n        \"\"\"\n        del key, output_buffers, n_subs_per_block\n        pool = self._get_async_pool()\n        return pool.submit(self.compress_batch, *args, **kwargs)\n\n    def wait_compress_async(\n        self,\n        handle: Any,\n        *args: Any,\n        timeout: Optional[float] = None,\n        **kwargs: Any,\n    ) -> Any:\n        \"\"\"Block until a previously-scheduled async compress completes.\n\n        Default: ``handle`` is the :class:`concurrent.futures.Future`\n        returned by the default :meth:`compress_batch_async` — calls\n        ``handle.result(timeout)``.  Backends overriding\n        :meth:`compress_batch_async` with a key-based scheme (e.g.\n        ``layer_id``) override this too with their own signature.\n        \"\"\"\n        del args, kwargs\n        from concurrent.futures import Future\n        if isinstance(handle, Future):\n            return handle.result(\n                timeout=timeout if timeout and timeout > 0 else None)\n        raise NotImplementedError(\n            f\"{type(self).__name__}.wait_compress_async: handle of type \"\n            f\"{type(handle).__name__} is not a concurrent.futures.Future. \"\n            \"Subclasses with a key-based async scheme must override \"\n            \"wait_compress_async.\")\n\n    # ------------------------------------------------------------------\n    #  Optional fused decompress + GEMM\n    # ------------------------------------------------------------------\n\n    #: Subclasses that ship a native fused decompress+GEMM kernel (i.e.\n    #: that skip materialising the dense weight tensor) should override\n    #: this to True.  The dual-memory loader consults this flag when the\n    #: user enables ``--fused-mm`` to decide whether a given Linear\n    #: module's forward can be safely re-routed through ``fused_mm`` on\n    #: the inference hot path.\n    HAS_FUSED_MM: bool = False\n\n    def fused_mm(\n        self,\n        comp: CompressedTensor,\n        B: torch.Tensor,\n        C: Optional[torch.Tensor] = None,\n        split_k: int = 1,\n    ) -> torch.Tensor:\n        \"\"\"Default ``C = decompress(comp) @ B^T``.\n\n        Subclasses with a fused reconstruct + GEMM kernel should override\n        this method.  ``split_k`` is accepted for interface parity and is\n        ignored by the default fallback.\n        \"\"\"\n        del split_k\n        M = getattr(comp, \"M\")\n        if C is None:\n            C = torch.empty(B.size(0), M,\n                            dtype=torch.bfloat16, device=B.device).T\n        A = self.decompress(comp).to(B.device)\n        torch.mm(A, B.T, out=C)\n        return C\n\n    # ------------------------------------------------------------------\n    #  Linear-apply adapter (forward-path API)\n    # ------------------------------------------------------------------\n    #\n    # ``linear_apply`` is the shape-stable façade used by the dual-memory\n    # loader's ``--fused-mm`` Linear-forward override.  It takes an\n    # activation ``x`` of shape ``(..., K)`` and returns ``y`` of shape\n    # ``(..., M)`` equivalent to ``F.linear(x, decompress(comp))``\n    # — without materialising the dense weight.\n    #\n    # Bias is intentionally NOT applied here.  The caller (the\n    # ColumnParallel / RowParallel forward shim) handles bias + TP\n    # collectives so the same adapter works for any vLLM Linear variant.\n    #\n    # Subclasses with a native ``fused_mm`` should override this to\n    # avoid the dense-weight fallback path below.  Each compressor's\n    # ``fused_mm`` has its own B/C layout convention (P4Flat:\n    # B(K,N) row-major / C(M,N) row-major; ZipServ + DietGPU:\n    # B(N,K) row-major / C(M,N) column-major) — the adapter centralises\n    # that translation so the loader stays compressor-agnostic.\n\n    def linear_apply(\n        self,\n        comp: CompressedTensor,\n        x: torch.Tensor,\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        \"\"\"Default: decompress + ``F.linear``.  Subclasses override.\n\n        ``wdecomp_events`` is an optional ``(begin, end)`` pair of external\n        CUDA events; when given they bracket ONLY the ``decompress`` call so\n        the --time-breakdown WDecomp line attributes this decode-time decomp\n        (used by the --fused-mm path's fallback decompress, see\n        graph_wait_ops._fused_linear_apply_impl).\n        \"\"\"\n        import torch.nn.functional as F\n\"\"\"Legacy facade for the codec compressor implementations.\n\nEvery public symbol that used to live here is now exposed by a module\nunder :mod:`tiered_serve.compression.core`.  This file keeps the\nhistorical import path working so external code can continue to write\n``from tiered_serve.tensor_compressor import UBLBCompressor`` (or any\nof the other compressors) without modification.\n\nNew code should prefer the canonical paths under ``compression.core``.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\n\nimport torch  # noqa: F401  — re-exported for callers that imported it transitively\n\nfrom tiered_serve.compressor_base import TensorCompressor  # noqa: F401\n\n# ── Re-exports from compression.core ──\n# Canonical definitions live in tiered_serve.compression.core.* — this\n# module never holds a second copy.\nfrom tiered_serve.compression.core.base import (  # noqa: F401\n    BaseExpConfig,\n    SplitStorageInfo,\n    _h2d_record_stream,\n)\nfrom tiered_serve.compression.core.ublb import (  # noqa: F401\n    CompressedUBLBTensor,\n    UBLBCompressor,\n)\nfrom tiered_serve.compression.core.ublb_tbe import (  # noqa: F401\n    CompressedUBLBTBETensor,\n    UBLBTBECompressor,\n    CompressedUBLBFlatTensor,\n    UBLBFlatCompressor,\n)\nfrom tiered_serve.compression.core.zipserv import (  # noqa: F401\n    CompressedZipServTensor,\n    ZipServCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu import (  # noqa: F401\n    _DIETGPU_WORKSPACE_BYTES,\n    _dietgpu_workspace_bytes,\n    _DIETGPU_LIB_SEARCH_PATHS,\n    _ensure_dietgpu_loaded,\n    CompressedDietGPUTensor,\n    DietGPUCompressor,\n)\nfrom tiered_serve.compression.core.dietgpu_fp8 import (  # noqa: F401\n    _HAS_DIETGPU_FP8_CUDA,\n    _FP8_DTYPE_PARAMS,\n    _pack_raw_to_sm_nibbles,\n    _pack_raw_to_exp_nibbles,\n    _unpack_sm_nibbles_u8,\n    _unpack_exp_nibbles_u8,\n    _fp8_kind_of,\n    CompressedDietGPUFP8Tensor,\n    DietGPUFP8Compressor,\n)\nfrom tiered_serve.compression.core.zipserv_fp8 import (  # noqa: F401\n    _HAS_ZSV_FP8_GPU,\n    CompressedZipServFP8GpuTensor,\n    ZipServFP8GpuCompressor,\n)\nfrom tiered_serve.compression.core.p4flat import (  # noqa: F401\n    _HAS_P4FLAT,\n    CompressedP4FlatTensor,\n    P4FlatCompressor,\n)\nfrom tiered_serve.compression.core.zipserv_ot import (  # noqa: F401\n    _HAS_ZSV_OT,\n    CompressedZipServOTTensor,\n    ZipServOTCompressor,\n)\nfrom tiered_serve.compression.core.p3flat_fp8 import (  # noqa: F401\n    _HAS_P3FLAT_FP8,\n    CompressedP3FlatFP8Tensor,\n    P3FlatFP8Compressor,\n)\nfrom tiered_serve.compression.core.p4d16 import (  # noqa: F401\n    _HAS_P4D16,\n    CompressedP4D16Tensor,\n    P4D16Compressor,\n)\nfrom tiered_serve.compression.core.auto import (  # noqa: F401\n    _AutoWeightCompressor,\n)\n\n\nlogger = logging.getLogger(\"vllm\")\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\n\nclass CompressorMixin:\n\n    def _auto_dietgpu_workspace_bytes(self) -> Optional[int]:\n        \"\"\"Compute a workspace size large enough for DietGPU to compress\n        the model's biggest tensor without falling back to ``cudaMalloc``.\n\n        The fallback path triggers HBM ``torch.empty`` at compress time,\n        which races a frozen_split-filled HBM and OOMs (e.g. on Qwen-110B\n        the ``gate_up_proj`` compress needs ~1031 MiB of scratch but the\n        upstream default workspace is only 384 MiB).  Sizing from the\n        actual model avoids the user having to hand-tune\n        ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB`` per model.\n\n        Returns ``None`` to defer to the env-var / module default when\n        the model walk can't find a suitable reference tensor.\n        \"\"\"\n        # User override always wins.\n        if os.getenv(\"TIERED_SERVE_DIETGPU_WORKSPACE_MIB\") is not None:\n            return None\n        ref_blk = self.torch_model.decoder_blocks[0]\n        max_numel = 0\n        for name in self.tensor_names:\n            leaf_name, _, tensor_name = name.rpartition(\".\")\n            try:\n                leaf = ref_blk.module.get_submodule(leaf_name)\n            except AttributeError:\n                continue\n            t = getattr(leaf, tensor_name, None)\n            if t is None:\n                continue\n            if t.numel() > max_numel:\n                max_numel = t.numel()\n        if max_numel == 0:\n            return None\n        # Empirically DietGPU's compress on a BF16 [M, K] tensor peaks at\n        # ~1.22 × (M*K) bytes of stack memory (sm + exp scratch + ANS\n        # state + histograms).  110B observation: M*K=805 MiB requested\n        # 984 MiB.  1.4× gives ~14% headroom for variation across\n        # tensor shapes / vocabularies; round up to MiB.\n        bytes_needed = int(max_numel * 1.4) + 1\n        # Round up to the next MiB to get a clean log line.\n        return ((bytes_needed + (1 << 20) - 1) >> 20) << 20\n\n    def _make_weight_compressor(self, backend: str, *, role: str):\n        \"\"\"Instantiate a single weight compressor for the given backend name.\n\n        ``role`` is \"split\" / \"offload\" / \"default\" and only affects the\n        log line so dual-compressor runs are debuggable.\n\n        ``_AutoWeightCompressor`` lazy-instantiates its BF16/FP8 sub-\n        compressors on first ``compress``/``decompress`` call.  That's\n        unsafe in mixed-backend mode: when the offload compressor is\n        DietGPU and the split compressor is ZipServ, all frozen_split\n        layers compress first and fill HBM with sign_mantissa; by the\n        time the first offload_compressed layer hits DietGPU, the ~1 GB\n        workspace ``torch.empty`` is racing fragmented HBM and OOMs.\n        Eagerly prime BF16 here so both workspaces are allocated up\n        front while HBM is still clean.  Today's targeted models\n        (Qwen/Llama bf16) always hit the BF16 path; FP8 stays lazy.\n\n        DietGPU workspaces are auto-sized from the largest model tensor\n        so users don't need to set ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB``\n        per model (the env var, if set, still wins).\n        \"\"\"\n        stream = self.decomp_weight_stream\n        auto_ws = self._auto_dietgpu_workspace_bytes()\n        if backend in (\"zipserv\", \"dietgpu\"):\n            comp = _AutoWeightCompressor(\n                family=backend, comp_stream=stream,\n                dietgpu_workspace_bytes=auto_ws)\n            comp._bf16()\n            logger.info(\n                \"Weight compressor [%s]: %s (auto BF16/FP8, BF16 primed%s)\",\n                role, backend,\n                \"\" if auto_ws is None\n                else f\", DietGPU ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"zipserv_bf16\":\n            comp = ZipServCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n        elif backend == \"dietgpu_bf16\":\n            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n                \"\" if auto_ws is None\n                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"dietgpu_fp8\":\n            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n                \"\" if auto_ws is None\n                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n        elif backend == \"zipserv_fp8\":\n            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n            # (forked from LLM-bitfield-compressor, built in-tree). No\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n            from tiered_serve.tensor_compressor import UBLBFlatCompressor\n            comp = UBLBFlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: UBLB-flat (BF16)\", role)\n        else:\n            raise ValueError(\n                f\"Unknown weight compressor backend ({role}): \"\n                f\"{backend!r}. Expected one of: \"\n                f\"zipserv, dietgpu, zipserv_bf16, dietgpu_bf16, \"\n                f\"zipserv_fp8, dietgpu_fp8, p4flat, p4d16, p3flat_fp8, \"\n                f\"ublb_flat.\")\n        self._configure_weight_compressor_runtime(comp)\n        return comp\n\n    def _configure_weight_compressor_runtime(self, comp):\n        \"\"\"Attach loader runtime constants to compressor objects.\"\"\"\n        if comp is None or not hasattr(self, \"_cudagraph_ceiling\"):\n            return\n        comp._cudagraph_ceiling = self._cudagraph_ceiling\n        bf16 = getattr(comp, \"_bf16_impl\", None)\n        if bf16 is not None:\n            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n\n    def _compressor_for_mode(self, mode: str):\n        \"\"\"Return the weight compressor instance for a given residency mode.\n\n        ``frozen_split`` is routed to the split-tuned compressor; every\n        other mode that needs a compressor uses the offload one.  Falls\n        back to ``self.weight_compressor`` so this is safe to call even\n        before per-mode compressors are initialised (lazy paths).\n        \"\"\"\n        if mode == \"frozen_split\":\n            return self._compressor_split or self.weight_compressor\n        return self._compressor_offload or self.weight_compressor\n\n    def _compressor_for_cell(self, layer_id: int, comp_key: str,\n                             mode: \"Optional[str]\" = None):\n        \"\"\"Return the compressor instance to use for one (layer, component).\n\n        Honors per-cell compressor overrides from the YAML layer_residency\n        ``{mode, compressor}`` cells: when a cell pins ``compressor: X``,\n        we look up ``X`` in the per-backend pool (lazy-instantiating it\n        the first time) and return that instance.  Cells without an\n        explicit compressor fall through to the legacy\n        ``_compressor_for_mode`` behaviour.\n\n        ``mode`` is optional; when omitted, it's read from\n        ``self.torch_model.layer_weight_comp``.  Passing it explicitly\n        is a perf shortcut on hot paths that already have the mode.\n        \"\"\"\n        # Per-cell override has priority.\n        tm = getattr(self, \"torch_model\", None)\n        if tm is not None:\n            comps = getattr(tm, \"layer_weight_compressor\", None)\n            if comps is not None and 0 <= layer_id < len(comps):\n                backend = comps[layer_id].get(comp_key)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d1b-cc7a-7d83-b4cf-62d5233ccf