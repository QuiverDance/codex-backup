{"timestamp":"2026-08-26T08:07:58.074Z","ordinal":166,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d1c-937a-7660-8b50-2fe11012f510","call_id":"call_WXwfnh0S5qIwXfuHgNmfcJEj","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"=== P4Flat tests ===\n\"\"\"Canonical P4Flat BF16 weight-compression correctness tests.\n\nThe first test covers the direct GPU codec API.  The second mirrors the\ncompressed-weight offload path: compressed buffers move to pinned host memory,\nare copied into registered GPU staging buffers on the load stream, and are\ndecompressed on a dependent stream.\n\nNative extensions are imported only inside the fixture so CPU-only collection\ndoes not build CUDA code.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\nimport torch\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"P4Flat weight compression requires CUDA\"\n)\n\nM = 128\nK = 128\n\n\ndef _make_weight() -> torch.Tensor:\n    \"\"\"Return finite BF16 data with sparse out-of-palette exponents.\n\n    Most elements use twelve common exponents, while sparse elements introduce\n    more than four additional exponents per 64x64 tile.  This keeps the tensor\n    representative of a compressible weight while exercising P4Flat's exact\n    exception-patching path.\n    \"\"\"\n    offset = torch.arange(M * K, device=\"cuda\", dtype=torch.int32)\n    row = offset.div(K, rounding_mode=\"floor\")\n    column = offset.remainder(K)\n    exponent = 112 + offset.remainder(12)\n    rare = row.remainder(16).eq(0).logical_and(column.remainder(16).eq(0))\n    rare_exponent = 32 + row.div(16, rounding_mode=\"floor\") * 8\n    rare_exponent = rare_exponent + column.div(16, rounding_mode=\"floor\")\n    exponent = torch.where(rare, rare_exponent, exponent)\n\n    mantissa = (offset * 37).bitwise_and(0x7F)\n    sign = offset.remainder(2).bitwise_left_shift(15)\n    bits = sign.bitwise_or(exponent.bitwise_left_shift(7)).bitwise_or(mantissa)\n    return bits.to(torch.int16).view(torch.bfloat16).reshape(M, K).contiguous()\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert actual.dtype == expected.dtype == torch.bfloat16\n    assert torch.equal(actual.view(torch.int16), expected.view(torch.int16))\n\n\n@pytest.fixture(scope=\"module\")\ndef compressor():\n    try:\n        from tiered_serve.compression.core.p4flat import P4FlatCompressor\n\n        return P4FlatCompressor()\n    except (ImportError, OSError, RuntimeError) as error:\n        detail = str(error).splitlines()[0] if str(error) else type(error).__name__\n        pytest.skip(f\"P4Flat extension unavailable: {detail}\")\n\n\ndef test_p4flat_direct_roundtrip_is_bit_exact(compressor) -> None:\n    weight = _make_weight()\n\n    compressed = compressor.compress(weight)\n    restored = compressor.decompress(compressed)\n    torch.cuda.synchronize()\n\n    assert compressed.M == M\n    assert compressed.K == K\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\ndef test_p4flat_host_staging_h2d_roundtrip_is_bit_exact(compressor) -> None:\n    weight = _make_weight()\n    output = torch.empty_like(weight)\n    compressed = compressor.compress(weight)\n    torch.cuda.synchronize()\n    compressed_size = compressed.nbytes\n\n    compressed.to_host()\n    assert compressed.nbytes == compressed_size\n    assert all(\n        getattr(compressed, attr).device.type == \"cpu\"\n        for attr in compressed._BUFFER_ATTRS\n    )\n\n    compressed.register_temp_d_tensor(output)\n    load_stream = torch.cuda.Stream()\n    decompress_stream = torch.cuda.Stream()\n    with torch.cuda.stream(load_stream):\n        compressed.to(\"cuda\", non_blocking=True)\n    decompress_stream.wait_stream(load_stream)\n    with torch.cuda.stream(decompress_stream):\n        restored = compressor.decompress(compressed)\n    decompress_stream.synchronize()\n\n    assert restored.data_ptr() == output.data_ptr()\n    assert all(\n        buffer.device.type == \"cuda\" for buffer in compressed.get_gpu_buffers()\n    )\n    _assert_bit_exact(restored, weight)\n\n=== weight registry exact ===\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n\n=== tensor_compressor exports/registry ===\n6:``from tiered_serve.tensor_compressor import UBLBCompressor`` (or any\n17:from tiered_serve.compressor_base import TensorCompressor  # noqa: F401\n29:    UBLBCompressor,\n33:    UBLBTBECompressor,\n35:    UBLBFlatCompressor,\n39:    ZipServCompressor,\n47:    DietGPUCompressor,\n58:    DietGPUFP8Compressor,\n63:    ZipServFP8GpuCompressor,\n67:    CompressedP4FlatTensor,\n68:    P4FlatCompressor,\n73:    ZipServOTCompressor,\n77:    CompressedP3FlatFP8Tensor,\n78:    P3FlatFP8Compressor,\n81:    _HAS_P4D16,\n82:    CompressedP4D16Tensor,\n83:    P4D16Compressor,\n86:    _AutoWeightCompressor,\n\n=== feature backend selection ===\n/root/projects/tiered-serve/tiered_serve/compression/core/__init__.py:50:from tiered_serve.compression.core.p3flat_fp8 import (\n/root/projects/tiered-serve/tiered_serve/compression/core/__init__.py:54:from tiered_serve.compression.core.p4d16 import (\n/root/projects/tiered-serve/tiered_serve/co