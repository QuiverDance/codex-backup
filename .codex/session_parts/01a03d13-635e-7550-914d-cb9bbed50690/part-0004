_rank);\n    }\n\n    int rank = tile_exception_offsets[tile] + thread_rank;\n    const int warp_local_base = lane * kElementsPerThread;\n#pragma unroll\n    for (int item = 0; item < kElementsPerThread; ++item) {\n        const uint8_t exponent = exponent_of(source[source_base + item]);\n        if (exponent < base || exponent > static_cast<int>(base) + 7) {\n            positions[rank] =\n                static_cast<uint16_t>(warp_local_base + item);\n            exception_exponents[rank] = exponent;\n            ++rank;\n        }\n    }\n}\n\n__global__ void PackEntries17Kernel(\n    const uint16_t* __restrict__ positions,\n    const uint8_t* __restrict__ exception_exponents,\n    uint8_t* __restrict__ entries,\n    int64_t count)\n{\n    const int64_t group =\n        static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;\n    const int64_t first = group * 8;\n    if (first >= count) {\n        return;\n    }\n    const int valid = static_cast<int>(min(int64_t{8}, count - first));\n    const int bytes = (valid * 17 + 7) / 8;\n#pragma unroll\n    for (int byte = 0; byte < 17; ++byte) {\n        if (byte < bytes) {\n            const int bit = byte * 8;\n            const int item = bit / 17;\n            const int shift = bit - item * 17;\n            uint64_t packed = 0;\n            if (item < valid) {\n                packed = static_cast<uint64_t>(\n                    (static_cast<uint32_t>(exception_exponents[first + item]) << 9)\n                    | (positions[first + item] & 0x1ffu));\n            }\n            if (item + 1 < valid) {\n                packed |= static_cast<uint64_t>(\n                    (static_cast<uint32_t>(exception_exponents[first + item + 1]) << 9)\n                    | (positions[first + item + 1] & 0x1ffu)) << 17;\n            }\n            entries[group * 17 + byte] =\n                static_cast<uint8_t>(packed >> shift);\n        }\n    }\n}\n\n__device__ __forceinline__ void patch_warp_exceptions(\n    const uint8_