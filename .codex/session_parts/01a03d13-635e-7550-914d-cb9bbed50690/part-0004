strict__ palettes8,\n    const uint8_t* __restrict__ codes,\n    const uint8_t* __restrict__ sign_mantissa,\n    const int32_t* __restrict__ tile_exception_offsets,\n    const uint16_t* __restrict__ warp_prefixes,\n    const uint8_t* __restrict__ entries17,\n    uint16_t* __restrict__ output,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    const int thread = threadIdx.x;\n    const int warp = thread >> 5;\n    const int lane = thread & 31;\n    const uint64_t palette = *reinterpret_cast<const uint64_t*>(\n        palettes8 + static_cast<int64_t>(tile) * 8);\n    const uint64_t code_word = load_code_word(codes, tile, thread);\n    const uint4 sm = *reinterpret_cast<const uint4*>(\n        sign_mantissa + static_cast<int64_t>(tile) * kTileElements\n        + thread * kElementsPerThread);\n\n    uint64_t output0 = 0;\n    uint64_t output1 = 0;\n    uint64_t output2 = 0;\n    uint64_t output3 = 0;\n#pragma unroll\n    for (int item = 0; item < kElementsPerThread; ++item) {\n        const uint8_t code =\n            static_cast<uint8_t>((code_word >> (item * 3)) & 7u);\n        const uint8_t exponent =\n            static_cast<uint8_t>(palette >> (code * 8));\n        append_output(\n            compose_bf16(exponent, sign_mantissa_byte(sm, item)), item,\n            output0, output1, output2, output3);\n    }\n    store_output(\n        output, tile, thread, columns,\n        output0, output1, output2, output3);\n\n    __syncwarp();\n    patch_warp_exceptions(\n        entries17, sign_mantissa, tile_exception_offsets, warp_prefixes,\n        output, tile, warp, lane, columns);\n}\n\n__global__ __launch_bounds__(kThreads, 6)\nvoid DecompressChunkDelta3Kernel(\n    const uint8_t* __restrict__ codes,\n    const uint8_t* __restrict__ sign_mantissa,\n    const uint8_t* __restrict__ thread_bases,\n    const int32_t* __restrict__ tile_exception_offsets,\n    const uint16_t* __restrict__ warp_prefixes,\n    const uint8_t* __restrict__ entries17,\n    uint16_t* __res