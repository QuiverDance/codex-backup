\n__device__ __forceinline__ uint64_t load_code_word(\n    const uint8_t* codes,\n    int tile,\n    int thread)\n{\n    const int64_t base =\n        static_cast<int64_t>(tile) * kCodeBytesPerTile\n        + static_cast<int64_t>(thread) * 6;\n    uint64_t word = 0;\n#pragma unroll\n    for (int byte = 0; byte < 6; ++byte) {\n        word |= static_cast<uint64_t>(codes[base + byte]) << (byte * 8);\n    }\n    return word;\n}\n\n__device__ __forceinline__ int escape_count(uint64_t code_word)\n{\n    constexpr uint64_t kThreeBitLaneLowBits = 0x249249249249ull;\n    const uint64_t matches = code_word & (code_word >> 1)\n        & (code_word >> 2) & kThreeBitLaneLowBits;\n    return __popcll(matches);\n}\n\n__device__ __forceinline__ int exclusive_scan_tile(\n    int value,\n    int* warp_totals,\n    int* warp_prefixes)\n{\n    const int lane = threadIdx.x & 31;\n    const int warp = threadIdx.x >> 5;\n    int inclusive = value;\n#pragma unroll\n    for (int delta = 1; delta < 32; delta <<= 1) {\n        const int prior = __shfl_up_sync(0xffffffffu, inclusive, delta);\n        if (lane >= delta) {\n            inclusive += prior;\n        }\n    }\n    if (lane == 31) {\n        warp_totals[warp] = inclusive;\n    }\n    __syncthreads();\n\n    if (warp == 0) {\n        int total = lane < kWarpsPerTile ? warp_totals[lane] : 0;\n        const int own = total;\n#pragma unroll\n        for (int delta = 1; delta < 32; delta <<= 1) {\n            const int prior = __shfl_up_sync(0xffffffffu, total, delta);\n            if (lane >= delta) {\n                total += prior;\n            }\n        }\n        if (lane < kWarpsPerTile) {\n            warp_prefixes[lane] = total - own;\n        }\n    }\n    __syncthreads();\n    return warp_prefixes[warp] + inclusive - value;\n}\n\n__device__ __forceinline__ uint8_t exponent_of(uint16_t bits)\n{\n    return static_cast<uint8_t>((bits >> 7) & 0xffu);\n}\n\n__device__ __forceinline__ uint8_t sign_mantissa_of(uint16_t bits)\n{\n    return static_cast<uint8_t>(((bits >> 8) & 0x80u) | (bits & 0x7fu));\n}\n\n__device__ __forceinline__ uint16_t compose_bf16(\n    uint8_t exponent,\n    uint8_t sign_mantissa)\n{\n    return (static_cast<uint16_t>(sign_mantissa & 0x80u) << 8)\n        | (static_cast<uint16_t>(exponent) << 7)\n        | static_cast<uint16_t>(sign_mantissa & 0x7fu);\n}\n\n__device__ __forceinline__ uint8_t sign_mantissa_byte(\n    const uint4& packed,\n    int item)\n{\n    uint32_t word;\n    switch (item >> 2) {\n        case 0: word = packed.x; break;\n        case 1: word = packed.y; break;\n        case 2: word = packed.z; break;\n        default: word = packed.w; break;\n    }\n    return static_cast<uint8_t>(word >> ((item & 3) * 8));\n}\n\n__device__ __forceinline__ void append_output(\n    uint16_t value,\n    int item,\n    uint64_t& output0,\n    uint64_t& output1,\n    uint64_t& output2,\n    uint64_t& output3)\n{\n    const int lane = item & 3;\n    if (item < 4) {\n        output0 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else if (item < 8) {\n        output1 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else if (item < 12) {\n        output2 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else {\n        output3 |= static_cast<uint64_t>(value) << (lane * 16);\n    }\n}\n\n__device__ __forceinline__ void store_output(\n    uint16_t* output,\n    int tile,\n    int thread,\n    int columns,\n    uint64_t output0,\n    uint64_t output1,\n    uint64_t output2,\n    uint64_t output3)\n{\n    const int tiles_per_row = columns / kTileDim;\n    const int tile_row = tile / tiles_per_row;\n    const int tile_column = tile - tile_row * tiles_per_row;\n    const int local_row = thread >> 2;\n    const int local_column = (thread & 3) * kElementsPerThread;\n    uint16_t* destination = output\n        + static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n        + tile_column * kTileDim + local_column;\n    auto* vectors = reinterpret_cast<u