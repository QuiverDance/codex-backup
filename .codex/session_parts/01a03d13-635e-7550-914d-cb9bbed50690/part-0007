{"timestamp":"2026-08-26T08:26:13.491Z","ordinal":519,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d2d-4a73-7c22-b2f8-ce74e1815881","call_id":"call_kgBpbqwGkugIMrFn8STizZxv","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"KV GPU decompress (decode) latency + throughput on the production decode\npath: decompress_batch -> decompress_batched (one batched CUDA kernel over the\nGPU-resident compressed block pool), for p4flat and ublb_flat.\n\nKV is compressed once (host encode) to populate the pool; only the GPU batched\ndecode is timed.  Independent of OMP_NUM_THREADS (pure GPU kernel + the codec's\ninternal staging).  GiB/s is over the decoded raw BF16 bytes (K+V).  This is the\ndecode side of the serving dense \"decomp+attention\" path; the encode side is\nkv_cpu_encode.py.\n\nRun from tiered-serve:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmarks/kv_gpu_decode.py [--limit N]\n\"\"\"\nimport argparse\nimport time\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048]            # decodes N of a 2N pool (scatter test needs 2x slots)\n\n\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns):\n    comp = cls(torch.cuda.Stream())\n    pool = 2 * max(ns)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=pool, n_layers=1,\n                           max_gpu_blocks=pool, max_gpu_decomp_blocks=pool)\n    print(f\"  {name}\")\n    for N in ns:\n        # Compress 2N blocks (slots 0..2N-1), then decode N of them two ways:\n        #   contig  = block ids [0..N-1]      -> slots 0..N-1   (sequential reads)\n        #   scatter = block ids [0,2,..,2N-2] -> slots 0,2,..   (paged/fragmented,\n        #             the production pattern where block_table is non-contiguous)\n        # decompress_batch writes output id-indexed (kc[id]=block id), so kc is\n        # sized 2N and we compare/measure only the decoded subset.\n        M = 2 * N\n        comp._kv_active_count[0] = 0; comp._kv_slot[0].fill_(-1)\n        comp.compress_batch_async_from_host(0, list(range(M)), hk[:M].contiguous(),\n                                            hv[:M].contiguous(), 0)\n        comp.wait_compress_async(0, BS)\n        kc = torch.zeros(M, *BS, dtype=torch.bfloat16, device=\"cuda\")\n        vc = torch.zeros_like(kc)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        for label, dids in [(\"contig\", list(range(N))),\n                            (\"scatter\", list(range(0, M, 2)))]:\n            comp.decompress_batch(0, dids, (kc, vc)); torch.cuda.synchronize()\n            sel = torch.tensor(dids)\n            ke = (kc[sel].cpu() - hk[sel]).abs().max().item()\n            ve = (vc[sel].cpu() - hv[sel]).abs().max().item()\n            best = 1e9\n            for _ in range(20):\n                torch.cuda.synchronize(); t0 = time.perf_counter()\n                comp.decompress_batch(0, dids, (kc, vc))\n                torch.cuda.synchronize(); best = min(best, time.perf_counter() - t0)\n            print(f\"     N={N:>4} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\"\n                  f\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\")\n        del kc, vc; torch.cuda.empty_cache()\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--limit\", type=int, default=max(NS))\n    args = ap.parse_args()\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\n    hk, hv = load(2 * max(ns))\n    for cls, name in [(P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\")]:\n        bench(cls, name, hk, hv, ns)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"CPU encode LATENCY + GiB/s + GPU-decode bit-exactness for the production KV\npath (compress_batch_async_from_host -> C++ CPU encoder -> GPU\ndecompress_batch), for p4flat, ublb_flat, bitcomp, and zipserv.\n\nUse OMP_NUM_THREADS for the OpenMP codecs and\nTIERED_SERVE_KV_COMPRESS_WORKERS for worker-pool codecs.\"\"\"\nimport os\nimport sys\nimport time\n\n# Make the repository package importable during direct script execution.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor, _factor_64\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\nfrom tiered_serve.compression.core.zipserv import ZipServCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048, 4096]\n\n\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv):\n    comp = cls(torch.cuda.Stream())\n    max_blocks = max(NS)\n    host_pool_blocks = max_blocks\n    if issubclass(cls, ZipServCompressor):\n        # ZipServ's size-class slub allocator reserves payloads in chunks.\n        # Keep capacity headroom when this benchmark fills every logical slot.\n        host_pool_blocks += max(64, max_blocks // 4)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=host_pool_blocks,\n                           n_layers=1,\n                           max_gpu_blocks=max_blocks,\n                           max_gpu_decomp_blocks=max_blocks)\n    default_workers = max(1, (os.cpu_count() or 1) - 10)\n    n_workers = int(os.environ.get(\n        \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers))\n    comp.init_kv_compress_workers(n_workers, max_blocks, 1)\n    actual_workers = getattr(comp, \"_n_workers\", n_workers)\n    print(f\"  {name:>10}  (OMP={os.environ.get('OMP_NUM_THREADS', 'all')}, \"\n          f\"workers={actual_workers})\")\n    for N in NS:\n        ids = list(range(N))\n        k, v = hk[:N].contiguous(), hv[:N].contiguous()\n        comp.compress_batch_async_from_host(0, ids, k, v, 0)\n        comp.wait_compress_async(0, BS)                       # warmup\n        best = 1e9\n        for _ in range(8):\n            # Dense-slot codecs need their benchmark scratch allocation reset.\n            # ZipServ recycles reservations when the same block IDs are reused.\n            if hasattr(comp, \"_kv_active_count\"):\n                comp._kv_active_count[0] = 0\n            if hasattr(comp, \"_kv_slot\"):\n                comp._kv_slot[0].fill_(-1)\n            t0 = time.perf_counter()\n            comp.compress_batch_async_from_host(0, ids, k, v, 0)\n            comp.wait_compress_async(0, BS)\n            best = min(best, time.perf_counter() - t0)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        print(f\"     N={N:>4} (K+V {mb:5.0f} MiB) : {best*1e3:7.2f} ms\"\n              f\"   ({mb/1024/best:5.1f} GiB/s)\")\n    # bit-exact: GPU-decode the last-compressed batch and compare to the source.\n    N = max(NS); ids = list(range(N))\n    kc = torch.zeros(N, *BS, dtype=torch.bfloat16, device=\"cuda\")\n    vc = torch.zeros_like(kc)\n    comp.decompress_batch(0, ids, (kc, vc)); torch.cuda.synchronize()\n    k_exact = torch.equal(kc.cpu().view(torch.uint16),\n                          hk[:N].view(torch.uint16))\n    v_exact = torch.equal(vc.cpu().view(torch.uint16),\n                          hv[:N].view(torch.uint16))\n    print(f\"     bit-exact (GPU decode vs src) = {k_exact and v_exact}\")\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    hk, hv = load(max(NS))\n    for cls, name in [(P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\"),\n                      (ZipServCompressor, \"zipserv\")]:\n        bench(cls, name, hk, hv)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"BF16 TilePalette3 and ChunkDelta3 weight compressors.\n\nBoth codecs use 3-bit exponent codes over 64x64 tiles and preserve the raw\nsign/mantissa byte.  Exponents that cannot be represented by the primary code\nstream are stored in a packed 17-bit exception stream and patched during the\ndecode kernel, so every BF16 bit pattern round-trips exactly.\n\nThe native GPU implementation is built as\n``tiered_serve.cpp_exts.tp3_cd3_ext``.  Inputs must be contiguous two-\ndimensional CUDA BF16 tensors whose dimensions are multiples of 64.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import tp3_cd3_ext as _tp3_cd3_ext\n    _HAS_TP3_CD3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"TilePalette3/ChunkDelta3 compressors disabled: failed to load \"\n        \"tp3_cd3_ext (%s: %s)\", type(_error).__name__, _error)\n    _tp3_cd3_ext = None\n    _HAS_TP3_CD3 = False\n\n\nclass _CompressedTP3CD3Tensor:\n    \"\"\"Shared staging adapter around one native compressed-tensor struct.\"\"\"\n\n    _BUFFER_ATTRS: tuple[str, ...] = ()\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, f\"_d_{attr}\", None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c