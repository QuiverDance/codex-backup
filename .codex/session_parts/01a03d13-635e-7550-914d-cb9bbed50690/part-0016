 int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"bit-exact={resident_exact and staged_exact}\")\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--blocks\", default=\"1024,2048\")\n    parser.add_argument(\"--codec\", default=\"p4flat,chunk_delta3\")\n    parser.add_argument(\"--warmup\", type=int, default=5)\n    parser.add_argument(\"--iterations\", type=int, default=20)\n    args = parser.parse_args()\n    block_counts = [int(value) for value in args.blocks.split(\",\")]\n    codec_names = [value.strip() for value in args.codec.split(\",\")]\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n        host_k, host_v = _load(args.path, n)\n        print(f\"\\nKV blocks={n}, matrix=[{n * ROWS_PER_BLOCK}, {COLS}] x K/V\")\n        for name in codec_names:\n            _bench(name, host_k, host_v, args.warmup, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"/home/ubuntu/tiered-serve-edit/tests/test_chunk_delta3.py":{"type":"add","content":"\"\"\"Correctness coverage for the production ChunkDelta3 adapter.\"\"\"\nfrom __future__ import annotations\n\nimport pytest\nimport torch\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"ChunkDelta3 requires CUDA\")\n\n\ndef _codec():\n    from tiered_serve.compression.core.chunk_delta3 import ChunkDelta3Compressor\n    return ChunkDelta3Compressor(torch.cuda.current_stream())\n\n\ndef _all_bf16_patterns() -> torch.Tensor:\n    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    return bits.view(torch.bfloat16).reshape(256, 256).cuda().contiguous()\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA tiered-serve-edit/tests/test_chunk_delta3.py\nA tiered-serve-edit/benchmarks/kv_codec.py\n"},"completed_at_ms":1787822794169}}
