{"timestamp":"2026-08-27T09:26:00.977Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0428a-6411-7241-b561-65967a990018","call_id":"call_NOYGgVoiep2Yty1xd6gfuU7D","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"from tiered_serve.kv_cache import vLLMKVCache\n\nfrom tiered_serve.kv_offload_scheduler import KVOffloadScheduler\nfrom tiered_serve.module_block import ModuleBlock\nfrom tiered_serve.tensor_compressor import CompressedZipServTensor, SplitStorageInfo, ZipServCompressor\nfrom tiered_serve.tensor_compressor import CompressedDietGPUTensor, DietGPUCompressor\nfrom tiered_serve.tensor_compressor import (\n    CompressedDietGPUFP8Tensor, DietGPUFP8Compressor,\n    CompressedZipServFP8GpuTensor, ZipServFP8GpuCompressor,\n    CompressedP4FlatTensor, P4FlatCompressor,\n    CompressedChunkDelta3Tensor, ChunkDelta3Compressor,\n    CompressedP4D16Tensor, P4D16Compressor,\n    CompressedP3FlatFP8Tensor, P3FlatFP8Compressor,\n    _AutoWeightCompressor,\n)\nfrom tiered_serve.compression.core import (\n    CompressedUBLBFlatTensor, UBLBFlatCompressor,\n)\nfrom tiered_serve.torch_hooks import (\n    after_exec_attn,\n    after_exec_decoder,\n#                     bitmap exp decode is HEAVIER than p4flat's palette\n#                     (121 vs 72ms), so it crosses over to raw_bf16 earlier.\n#   ublb_flat  1367   } synthetic isolated bench (palette/data-independent);\n#   p4d16      1206   } refine with the slack model if used under a real config.\n#   dietgpu     670   STALE synthetic. ANS+data-dependent — re-derive.\n_PREFILL_ALT_MAX_CHUNK_DEFAULTS = {\n    \"p4flat\": 1330,\n    \"ublb_flat\": 1367,\n    \"p4d16\": 1206,\n    \"zipserv\": 1107,   # cao (frozen_split): slack 243 (decomp 121) -> ~1107\n    \"dietgpu\": 670,    # TODO: re-derive with the slack model on a real config\n}\n\n# Codecs whose decompress is BIT-EXACT w.r.t. the original BF16 weight, so\n# decoding them during prefill is lossless. FP8 cells (zipserv_fp8, dietgpu_fp8,\n# p3flat_fp8) quantize, so offload_compressed prefill must keep their\n# uncompressed copy (see the \"for accuracy\" branch in _get_weight_source).\n_LOSSLESS_OFFLOAD_CODECS = frozenset({\n    \"zipserv\", \"dietgpu\", \"zipserv_bf16\", \"dietgpu_bf16\",\n    \"p4flat\", \"p4d16\", \"ublb_flat\",\n    \"chunk_delta3\",\n})\n\n# Phase-adaptive prefill for offload_compressed weights (see _get_weight_source).\n# offload_compressed already keeps BOTH a compressed and an uncompressed LPDDR\n# copy; today prefill ALWAYS H2Ds the uncompressed one (no chunk gating). Below\n# this per-codec chunk threshold, prefill instead H2Ds + FULL-decompresses the\n# compressed copy. Same slack model as the frozen_split knob\n# (thr = (T_load_raw - T_decomp)/T_gemm_per_token) but with DISTINCT inputs:\n# offload does the FULL-blob decompress (vs frozen_split's cheap exp-only), so\n# T_decomp is much larger, AND offload configs (e.g. flexgen-comp) typically\n# keep half the layers frozen_uncompressed, so fewer layers load -> smaller\n# T_load_raw. Both shrink the slack -> a MUCH lower threshold than frozen_split.\n#   codec    thr   source\n#   zipserv  384   flexgen-comp slack model: load_raw 182 / full decomp 109 ->\n#                  slack 73 -> 384 (vs cao's 1330 — same codec, different config).\n# Codecs without an entry resolve to 0 (disabled = always-uncompressed prefill,\n# i.e. unchanged behaviour). Per-config; override via\n# TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK (same \"<codec>=<n>,...|<int>\" syntax).\n_OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS = {\n    \"zipserv\": 384,   # flexgen-comp (offload, full decompress -> small slack)\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"chunk_delta3\":\n            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n            comp = ChunkDelta3Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 ChunkDelta3\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n       