{"timestamp":"2026-08-27T09:29:18.578Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0428d-67f2-7e31-ac8c-1660596ca444","call_id":"call_xBBPbLODQujyqn6Pp2fF9mD4","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"\n\n# ════════════════════════════════════════════════════════════════════\n#  Per-weight driver\n# ════════════════════════════════════════════════════════════════════\n\ndef _bench_weight(t, name, selected, registry, get_inst, runs, no_cast):\n    \"\"\"Benchmark every applicable codec on one 2-D weight ``t`` (CPU tensor).\n\n    Prints a per-weight header + table and returns the ``Result`` rows.\n    Handles dtype selection (bf16 / fp8 codecs) and the fp16/fp32 -> bf16\n    cast, then defers per-codec timing to :func:`bench_codec`.\n    \"\"\"\n    if t.ndim != 2 or t.numel() < 1024:\n        print(f\"# skip {name} shape={'x'.join(str(d) for d in t.shape)}\")\n        return []\n\n    kind = _fp8_kind(t.dtype)\n    note = \"\"\n    if kind is not None:\n        dtype_kind = \"fp8\"\n        w = t.to(\"cuda\")\n    elif t.dtype == torch.bfloat16:\n        dtype_kind = \"bf16\"\n        w = t.to(\"cuda\")\n    else:\n        if no_cast:\n            print(f\"# skip {name} dtype={t.dtype}\")\n            return []\n        dtype_kind = \"bf16\"\n        w = t.to(\"cuda\").to(torch.bfloat16)\n        note = f\" cast={t.dtype}->bf16\"\n    w = w.contiguous()\n\n    codecs = selected if selected is not None else (\n        _DEFAULT_FP8 if dtype_kind == \"fp8\" else _DEFAULT_BF16)\n    codecs = [c for c in codecs if registry[c][0] == dtype_kind]\n\n    print(f\"# {name} {w.shape[0]}x{w.shape[1]} {w.dtype}{note}\")\n    rows = []\n    for codec in codecs:\n        obj = get_inst(codec)\n        if obj is None:\n            continue\n        try:\n            rows.append(bench_codec(obj, codec, name, w, runs))\n        except Exception as e:\n            if \"out of memory\" in str(e).lower():\n                free = torch.cuda.mem_get_info()[0] / 1024**3\n                msg = f\"CUDA OOM ({free:.1f} GiB free — GPU shared?)\"\n            else:\n                msg = str(e).splitlines()[0] if str(e) else type(e).__name__\n            print(f\"    [{codec}] skipped: {msg}\")\n            torch.cuda.empty_cache()\n    _print_table(rows)\n    del w\n    torch.cuda.empty_cache()\n    return rows\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Main\n# ════════════════════════════════════════════════════════════════════\n\ndef main():\n    ap = argparse.ArgumentParser(\n        description=\"tiered-serve weight compress/decompress benchmark\")\n    ap.add_argument(\"model\", nargs=\"+\",\n                    help=\"HF model id (org/name, resolved from the hub cache) \"\n                         \"or explicit .safetensors path(s)\")\n    ap.add_argument(\"--codec\", default=None,\n                    help=\"Comma-separated codec names, or 'all'. Default: \"\n                         f\"{','.join(_DEFAULT_BF16)} (BF16) / \"\n                         f\"{','.join(_DEFAULT_FP8)} (FP8)\")\n    ap.add_argument(\"--group\", \"-g\", default=None,\n                    help=\"Comma-separated fused groups to run \"\n                         f\"({', '.join(_GROUP_DEFS)}). Default: all\")\n    ap.add_argument(\"--layer\", \"-l\", type=int, default=None,\n                    help=\"Restrict to one transformer layer (e.g. 0)\")\n    ap.add_argument(\"--per-tensor\", action=\"store_true\",\n                    help=\"Benchmark raw per-projection weights (q/k/v/...) \"\n                         \"instead of the fused qkv/o/gateup/down\")\n    ap.add_argument(\"--key\", \"-k\", default=None,\n                    help=\"(--per-tensor) only weights whose name contains this\")\n    ap.add_argument(\"--all-weights\", action=\"store_true\",\n                    help=\"(--per-tensor) include non-projection weights\")\n    ap.add_argument(\"--max-weights\", type=int, default=0,\n                    help=\"Process at most this many weights (0 = all)\")\n    ap.add_argument(\"--runs\", type=int, default=5,\n                    help=\"Timed iterations per codec (best is reported)\")\n    ap.add_argument(\"--no-cast\", action=\"store_true\",\n                    help=\"Skip non-BF16/FP8 weights instead of casting fp16/\"\n                         \"fp32 to bf16\")\n    args = ap.parse_args()\n\n    if not torch.cuda.is_available():\n        sys.exit(\"CUDA is required (tiered-serve weight codecs run on GPU).\")\n\n    shards = _resolve_inputs(args.model)\n    if not shards:\n        sys.exit(\"No safetensors shards found.\")\n\n    registry = _build_registry()\n    selected = (None if args.codec is None\n                else list(registry) if args.codec == \"all\"\n                else [c.strip() for c in args.codec.split(\",\") if c.strip()])\n    if selected is not None:\n        for c in selected:\n            if c not in registry:\n                sys.exit(f\"Unknown codec {c!r}. Known: {', '.join(registry)}\")\n\n    group_filter = None\n    if args.group is not None:\n        group_filter = [g.strip() for g in args.group.split(\",\") if g.strip()]\n        for g in group_filter:\n            if g not in _GROUP_DEFS:\n                sys.exit(f\"Unknown group {g!r}. Known: {', '.join(_GROUP_DEFS)}\")\n\n    mode = \"per-tensor\" if args.per_tensor else \"fused (qkv/o/gateup/down)\"\n    print(\"=\" * 80)\n    print(\"  tiered-serve weight compression benchmark\")\n    print(\"=\" * 80)\n    print(f\"  Shards : {len(shards)} file(s)\")\n    print(f\"  Mode   : {mode}\")\n    print(f\"  GPU    : {torch.cuda.get_device_name(0)}\")\n    print(f\"  Runs   : {args.runs}  (best-of)\")\n    print(\"=\" * 80 + \"\\n\")\n\n    stream = torch.cuda.Stream()\n    instances = {}   # codec name -> built compressor (or None if build failed)\n\n    def _get(codec):\n        if codec not in instances:\n            try:\n                instances[codec] = registry[codec][1](stream)\n            except Exception as e:\n                print(f\"  [build {codec}] FAILED: {e}\")\n                instances[codec] = None\n        return instances[codec]\n\n    all_rows = []\n    processed = 0\n\n    if args.per_tensor:\n        for shard in sorted(shards):\n            if args.max_weights and processed >= args.max_weights:\n                break\n            with safe_open(shard, framework=\"pt\") as sf:\n                keys = _filter_keys(list(sf.keys()), args.key, args.all_weights,\n                                    args.layer, args.max_weights, processed)\n                if not keys:\n                    continue\n                print(f\"# {os.path.basename(shard)} — {len(keys)} weight(s)\\n\")\n                for k in keys:\n                    if args.max_weights and processed >= args.max_weights:\n                        break\n                    rows = _bench_weight(sf.get_tensor(k), _short_name(k),\n                                         selected, registry, _get,\n                                         args.runs, args.no_cast)\n                    all_rows.extend(rows)\n                    if rows:\n                        processed += 1\n                    print()\n    else:\n        index = _build_layer_index(shards, args.layer)\n        if not index:\n            sys.exit(\"No transformer-layer projection weights found \"\n                     \"(use --per-tensor for non-standard checkpoints).\")\n        # Pre-size the DietGPU ANS workspace to the largest fused weight so it\n        # doesn't cudaMalloc a temp buffer per compress (which biases its time).\n        # Falls back to the default (smaller) workspace if the up-front\n        # allocation won't fit — important when the GPU is shared with another\n        # process and free memory is tight.\n        if \"dietgpu\" in (selected if selected is not None else _DEFAULT_BF16):\n         