< 16);\n    return (word >> shift) & 0x1ffffu;\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void cd3_rs_kernel(\n    const uint8_t*       __restrict__ codes_g,\n    const uint8_t*       __restrict__ sm_g,\n    const uint8_t*       __restrict__ bases_g,\n    const int32_t*       __restrict__ tile_offsets_g,\n    const uint16_t*      __restrict__ warp_prefixes_g,\n    const uint8_t*       __restrict__ entries17_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid = static_cast<int>(threadIdx.x);\n    const int tile_n = static_cast<int>(blockIdx.x);\n    const int tile_m = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);\n    const int tk_split = tiles_k / split_k;\n    const int k0 = split_idx * tk_split;\n\n    auto mB = make_tensor(mak