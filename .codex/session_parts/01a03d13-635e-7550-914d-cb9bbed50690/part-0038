yLoader.kv_offload_scheduler = KVOffloadScheduler(\n                DualMemoryLoader.primary_k_caches[0][0][0])\n\n            # Pre-allocate all KV compress/decompress buffers so that the\n            # schedule/wait pipeline runs zero-alloc on the hot path.\n            if self.kv_compressor is not None:\n                k_cache = DualMemoryLoader.primary_k_caches[0]\n                block_shape = tuple(k_cache.shape[1:])\n                block_size = k_cache.shape[1]  # tokens per block\n                # Host pools must cover ALL block_ids for persistent\n                # block_id-indexed compressed storage.\n                num_primary_blocks = k_cache.shape[0]\n                # GPU staging pools only need per-iteration capacity.\n                max_iter_blocks = (\n                    -(- self.max_num_batched_tokens // block_size)\n                    + self.batch_size\n                )\n                # Use pre-allocated hugepage pools from vllm cache engine\n                # if available (allocated before hugepages are exhausted).\n                pre_pools = getattr(DualMemoryLoader, 'zipserv_host_pools', None)\n                self.kv_compressor.warmup_kv_buffers(\n                    block_shape, num_primary_blocks, self.n_layers,\n                    max_gpu_blocks=max_iter_blocks,\n                    max_gpu_decomp_blocks=num_primary_blocks,\n                    huge_page_allocator=self.huge_page_allocator,\n                    pre_allocated_host_pools=pre_pools)\n                # Init C++ compress worker threads (D2H + compress)\n                n_compress_workers = int(os.getenv(\n                    \"TIERED_SERVE_KV_COMPRESS_WORKERS\", str(os.cpu_count() - 10)))\n                self.kv_compressor.init_kv_compress_workers(\n                    n_compress_workers, max_iter_blocks, self.n_layers)\n\n        # Startup has finished its CPU-heavy checkpoint copies and\n        # torch.compile work.  Constrain only the engine main thread's ATen\n        # OpenMP team now, before graph capture / the first serving KV encode.\n        # P4Flat's async worker is a different OpenMP master and explicitly\n        # installs its dedicated team size on its first encode, so it remains\n        # at TIERED_SERVE_KV_COMPRESS_OMP_THREADS (56 by default).\n        if os.getenv(\"TIERED_SERVE_OMP_PHASE_SWITCH\", \"0\") == \"1\":\n            main_threads = max(1, int(os.getenv(\n                \"TIERED_SERVE_MAIN_OMP_THREADS\", \"1\")))\n            startup_threads = torch.get_num_threads()\n            # Set the environment for any later-created OpenMP master and the\n            # current ATen master explicitly; changing only one is insufficient\n            # after libgomp has already served startup parallel regions.\n            os.environ[\"OMP_NUM_THREADS\"] = str(main_threads)\n            torch.set_num_threads(main_threads)\n            logger.info(\n                \"[omp-phase] startup ATen=%d -> serving main=%d; \"\n                \"KV encoder uses its dedicated team\",\n                startup_threads, main_threads)\n\n    def _init_weights(self, huge_tensor_type):\n        for mod in self.torch_model.frozen_blocks:\n            mod.to(self.primary_device)\n\n        self.raw_secondary_tensors: List[Dict[torch.dtype, torch.Tensor]] = []\n        self.secondary_buffers: List[Dict[str, torch.Tensor]] = []\n        for blk in self.torch_model.decoder_blocks:\n            load_device = (self.secondary_device\n                           if not blk.is_frozen else self.primary_device)\n            blk.init_huge_tensor(load_device, huge_tensor_type)\n\n            self.raw_secondary_tensors.append(blk.huge_tensor)\n            self.secondary_buffers.append({\n                **dict(blk.module.named_buffers()),\nimport sys\nimport time\nimport torch\nimport torch.nn as nn\nfrom collections import OrderedDict\nimport sysconfig\nimport gc\nimport logging\nimport os\nfrom datetime import datetime\nfrom typing import Dict, List, Optional, Tuple\n\nfrom torch.utils.cpp_extension import load\n\nfrom tiered_serve import utils\nfrom tiered_serve.cpp_exts import unload_worker_ext\nfrom tiered_serve.cpp_exts.unload_worker_ext import SyncPrimitive\nfrom vllm.model_executor.models.llama import LlamaDecoderLayer  # noqa: F401\n\n# from viztracer import log_sparse\n\nfrom tiered_serve.huge_page_allocator import allocator\nfrom tiered_serve.converged_tensor import HugeTensorType\nfrom tiered_serve.kv_cache import vLLMKVCache\n\nfrom tiered_serve.kv_offload_scheduler import KVOffloadScheduler\nfrom tiered_serve.module_block import ModuleBlock\nfrom tiered_serve.tensor_compressor import CompressedZipServTensor, SplitStorageInfo, ZipServCompressor\nfrom tiered_serve.tensor_compressor import CompressedDietGPUTensor, DietGPUCompressor\nfrom tiered_serve.tensor_compressor import (\n    CompressedDietGPUFP8Tensor, DietGPUFP8Compressor,\n    CompressedZipServFP8GpuTensor, ZipServFP8GpuCompressor,\n    CompressedP4FlatTensor, P4FlatCompressor,\n    CompressedChunkDelta3Tensor, ChunkDelta3Compressor,\n    CompressedP4D16Tensor, P4D16Compressor,\n    CompressedP3FlatFP8Tensor, P3FlatFP8Compressor,\n    _AutoWeightCompressor,\n)\nfrom tiered_serve.compression.core import (\n    CompressedUBLBFlatTensor, UBLBFlatCompressor,\n)\nfrom tiered_serve.torch_hooks import (\n    after_exec_attn,\n    after_exec_decoder,\n    after_exec_mlp_down,\n    after_exec_mlp_up_gate,\n    after_exec_o,\n    after_exec_qkv,\n    after_forward_event,\n    before_exec_attn,\n    before_exec_decoder,\n    before_exec_mlp_up_gate,\n    before_exec_mlp_down,\n    before_exec_o,\n    before_exec_qkv,\n    before_forward_event,\n)\nfrom tiered_serve.torch_model import TorchModel, OFFLOAD_MODES, FROZEN_DECOMP_MODES, COMP_KEYS\n# from tiered_serve.cpp_exts import unload_worker_ext\n\nlogger = logging.getLogger(\"vllm\")\n\n\n_CUDA_DEV = None\n\n\ndef _cuda_dev():\n    global _CUDA_DEV\n    if _CUDA_DEV is None:\n        _CUDA_DEV = torch.device(\"cuda\", torch.cuda.current_device())\n    return _CUDA_DEV\n\n\ndef _patch_torch_current_stream():\n    \"\"\"Make no-arg ``torch.cuda.current_stream()`` shallow process-wide.\n\n    With no device argument it resolves the current device via torch._utils'\n    generic ``_get_device_attr`` lambda chain (~6 frames) — and ``Event.record()``\n    with no stream calls it on every event, so on the per-step decode path\n    (~108 no-arg ``.record()`` sites + the stream contexts) this deep resolution\n    repeatedly pushes the CPython frame data-stack across its 16 KiB chunk\n    boundary.  The worker runs on one fixed GPU, so resolve the device once and\n    pass it explicitly; behaviour is identical, the resolution is shallow.\n    \"\"\"\n    cur = torch.cuda.current_stream\n    if getattr(cur, \"_ts_patched\", False):\n        return\n\n    def _fast(device=None):\n        return cur(_cuda_dev() if device is None else device)\n\n    _fast._ts_patched = True\n    torch.cuda.current_stream = _fast\n\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a042ec-803c-78e2-a2ab-4e6f1fff5d4d","create_time":1787829995.3005583}}}
