{"timestamp":"2026-08-27T09:47:14.057Z","ordinal":1316,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0429d-d109-79c3-bc63-20ddf9c90c9d","call_id":"call_FngyvmIVV2vE85HnqWaMwvX1","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        cuda_sources=[cu_src],\n        functions=[\"tbe_host_encode\", \"flat_host_encode\",\n                   \"flat_host_encode_blocks\", \"flat_decompress_batched\",\n                   \"flat_decode_kv_layer\",\n                   \"tbe_host_encode_blocks\", \"tbe_decompress_batched\",\n                   \"tbe_histogram\", \"tbe_build_oob_rel\", \"tbe_analyze\",\n                   \"tbe_scatter\", \"tbe_count_oob\", \"tbe_reconstruct\",\n                   \"tbe_reconstruct_batched\", \"flat_decode\",\n                   \"flat_decode_batched\", \"flat_patch\", \"exc_correct\"],\n        with_cuda=True,\n        # -mcpu=grace: Grace (Neoverse V2, armv9-a + SVE2) ISA + tuning so the\n        # host encoders auto-vectorise (sm/lb/pack) and the SVE2 stream-compaction\n        # encode path compiles.  host integer encode -> byte-identical output.\n        extra_cflags=[\"-O3\", \"-mcpu=grace\", \"-funroll-loops\", \"-fopenmp\"],\n        extra_ldflags=[\"-fopenmp\"],\n        verbose=False,\n    )\n    return _EXT\n\n\n# ── RS-mode (register-A) fused decompress+GEMM extension ───────────────\n# Built from cpp_extensions/csrc/fused_gemm/{wgmma_lab.cu,wgmma_lab_binding.cpp}\n# (needs CUTLASS + sm_90a). Same module name as the experimental lab loader so\n# the JIT build is shared/cached. Referenced by absolute path so it works\n# regardless of sys.path (e.g. inside a vLLM worker process).\n_RS_EXT = None\n\n\ndef _get_rs_ext():\n    global _RS_EXT\n    if _RS_EXT is not None:\n        return _RS_EXT\n    from torch.utils.cpp_extension import load as _load\n    here = os.path.dirname(os.path.abspath(__file__))\n    root = os.path.abspath(os.path.join(here, \"..\", \"..\", \"..\"))\n    fg = os.path.join(root, \"cpp_extensions\", \"csrc\", \"fused_gemm\")\n    cutlass = os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if not cutlass:\n        for c in (\"/root/projects/cutlass/include\",\n                  os.path.expanduser(\"~/cutlass/include\"),\n                  \"/usr/local/cutlass/include\"):\n            if os.path.isfile(os.path.join(c, \"cute\", \"tensor.hpp\")):\n                cutlass = c\n                break\n    old = os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n    os.environ[\"TORCH_CUDA_ARCH_LIST\"] = os.environ.get(\n        \"TIERED_SERVE_CUDA_ARCH\", \"9.0a\")\n    try:\n        _RS_EXT = _load(\n            name=\"wgmma_lab_ext\",\n            sources=[os.path.join(fg, \"wgmma_lab_binding.cpp\"),\n                     os.path.join(fg, \"wgmma_lab.cu\")],\n            with_cuda=True,\n            extra_include_paths=[cutlass] if cutlass else [],\n            extra_cflags=[\"-O3\", \"-std=gnu++17\"],\n            extra_cuda_cflags=[\"--std=c++17\", \"-O3\"],\n            extra_ldflags=[\"-lcuda\"],\n            verbose=False,\n        )\n    finally:\n        if old is not None:\n            os.environ[\"TORCH_CUDA_ARCH_LIST\"] = old\n        else:\n            os.environ.pop(\"TORCH_CUDA_ARCH_LIST\", None)\n    return _RS_EXT\n\n\n_EMPTY_F32 = {}\n\n\ndef _empty_f32(device):\n    t = _EMPTY_F32.get(device)\n    if t is None:\n        t = torch.empty(0, dtype=torch.float32, device=device)\n        _EMPTY_F32[device] = t\n    return t\n\n\ndef _pad_n(N, M=0):\n    \"\"\"Pad N to a WGMMA N-tile, M-awarely avoiding the slow 64x128 tile: it holds\n    2 blocks/SM but a single warpgroup each, so for SMALL M (few M-tiles, can't\n    fill the device) the wider 64x192 tile wins despite more work.  Used by the\n    p4flat RS fused linear_apply.\"\"\"\n    base = ((N + 63) // 64) * 64\n    if base == 128 and (M >> 6) < 256:\n        return 192\n    return base\n\n\ndef _u4_split_k(M, Npad, K):\n    \"\"\"Pick split-K so the u4_rs grid (M/64 x Npad/tileN) fills the GPU at decode\n    N.  split_k must divide tiles_k (=K/64).  Split-K helps only in the\n    latency-bound decode regime (small N): at larger N the per-block WGMMA work\n    already keeps the SMs busy, so the extra blocks + reduction regress\n    (measured: down/o N>=256 ~0.9x).  Cap split_k by N accordingly.\"\"\"\n    tn = (256 if Npad % 256 == 0 else 192 if Npad % 192 == 0\n          else 128 if Npad % 128 == 0 else 64)\n    tiles_k = K // 64\n    base = (M // 64) * (Npad // tn)\n    # Only split at the smallest decode tile (Npad==64): there the grid is most\n    # undersubscribed and split-K wins big (~1.2-1.25x).  At Npad>=128 the\n    # per-block work already fills the SMs, so splitting regresses (measured:\n    # p4 down N=96/128 flipped fused->decmm); leave those unsplit.\n    max_sk = 4 if Npad <= 64 else 1   # sk=2 @Npad128 measured no gain (enough work/block)\n    sk = 1\n    while sk < max_sk and base * sk * 2 <= 768 and tiles_k % (sk * 2) == 0:\n        sk *= 2\n    return sk\n\n\nclass CompressedUBLBTBETensor:\n    \"\"\"Compressed BF16 tensor: triple-bitmap upper byte + raw lower byte.\"\"\"\n\n    def __init__(self, buffers: Dict[str, Any]):\n        self.bm1: torch.Tensor = buffers[\"bm1\"]          # [num_tiles] uint64\n        self.bm2: torch.Tensor = buffers[\"bm2\"]\n        self.bm3: torch.Tensor = buffers[\"bm3\"]\n        self.lb_raw: torch.Tensor = buffers[\"lb_raw\"]    # [n] uint8\n        self.fallback: torch.Tensor = buffers[\"fallback\"]  # [n_oob] uint8\n        self.palette: torch.Tensor = buffers[\"palette\"]  # [8] uint8\n        # two-level fallback offset: superblock base (int32) + per-tile rel (int16)\n    with a flat per-element 4-bit code into a 16-entry palette instead of the\n    triple bitmap. Decode is branchless (no popcount/rank/transpose) — the\n    P4flat-style fast path — at a lower ratio ceiling (16/(4+8) = 1.333x).\n\n    With ``HAS_FUSED_MM = True`` the inference hot path (``--fused-mm`` +\n    frozen_compressed) routes the forward through :meth:`linear_apply`, which\n    fuses decode into a register-A WGMMA GEMM (the U4-RS kernel). For batch /\n    token counts above the per-shape :meth:`_fused_max_n_for` threshold it falls\n    back to decompress + ``F.linear`` (faster in the prefill / compute-bound\n    regime). The palette-only fused decode mishandles the rare out-of-palette\n    exceptions (~0.01% of weights), so an exact sparse correction is ALWAYS\n    applied after the fused GEMM, making the fused path bit-exact.\n\n    The threshold is PER-SHAPE (:attr:`_FUSED_MAX_N_TABLE`), looked up by\n    :meth:`_fused_max_n_for`.\n    \"\"\"\n\n    HAS_FUSED_MM = True\n\n    # Per-(M,K) fused-decode N threshold (0 = never fuse this shape).  Measured\n    # by bench_rs_projections.py (fused U4-RS vs decompress+cuBLAS on the real\n    # Llama-70B projection shapes): the kernel pads N to a 64-row WGMMA tile, so\n    # fused beats decompress+cuBLAS at one full tile (N<=64) for O/Down, through\n    # N=128 for GateUp (huge M -> Npad=128 still wins), and never for QKV (cheap\n    # decode + slow fused GEMM lose at every N).  Above the threshold the padded\n    # tile is wasted work and cuBLAS wins, so fall back to decompress + F.linear.\n    # Re-wired 2026-06-10 from benchmark_codec_decision.py (H2D-contended; fused\n    # incl split-K). Earlier values were from an isolated bench (no H2D overlap).\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused wins or is a noise-level tie (<=2%) vs decmp\n        # under H2D.\n        (10240, 8192): 0,     # QKV    (never)\n        (8192,  8192): 64,    # O      (clear win at 64 via split-K)\n        (57344, 8192): 0,     # GateUp (was 128; no clear win, only loose ties)\n        (8192, 28672): 64,    # Down   (split-K win <=64; jumps to +13% at 96)\n    }\n\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\n        super().__init__(comp_stream)\n        # Per-shape fused-N threshold lives in _fused_max_n_for / _FUSED_MAX_N_TABLE.\n        # tests/benchmarks may set this instance attr directly to force-fuse at all N.\n        self._fused_max_n_override = None\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-shape fused N threshold (0 = never fuse this shape); unknown shapes\n        fall back to 64 (the one-full-WGMMA-tile sweet spot).  An instance-level\n        ``_fused_max_n_override`` (set by tests/benchmarks) overrides all shapes.\"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 64)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the U4-RS register-A WGMMA kernel for small N; falls back to\n        decompress + F.linear for large N (prefill) or non-aligned shapes.\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` (fused branch leaves them unrecorded),\n        so --time-breakdown WDecomp reflects the decode-time fallback decomp.\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and comp.code_stream.is_cuda)\n        if use_fused:\n            ext = _get_rs_ext()\n            x2c = x2.contiguous()\n            Npad = ((N + 63) // 64) * 64\n            Bp = x2c if Npad == N else torch.zeros(\n                Npad, K, dtype=torch.bfloat16, device=x2.device)\n            if Npad != N:\n                Bp[:N].copy_(x2c)\n            # Cbuf[n, m] = sum_k W_approx[m,k]*x[n,k] = F.linear(x, W_approx)[n, m].\n            Cbuf = torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device)\n            # Split-K: at decode N the grid (N/tile x M/64) is tiny and leaves the\n            # GPU <1 wave full (latency-bound). Splitting K multiplies the block\n            # count to fill the SMs; each block writes an fp32 partial that a\n            # reduction kernel sums. Reduction traffic is negligible at decode N.\n            sk = _u4_split_k(M, Npad, K)\n            cf32 = (torch.empty(sk, Npad, M, dtype=torch.float32, device=x2.device)\n                    if sk > 1 else _empty_f32(x2.device))\n            ext.u4_rs_wgmma_mm(comp.code_stream, comp.lb_raw, comp.palette,\n                               Bp, Cbuf, cf32, sk, M, Npad, K)\n            y = Cbuf[:N]\n            # The fused decode used palette[0] for out-of-palette exceptions\n            # (wrong exponent -> large error). Add the exact sparse correction\n            # so the result matches decompress+matmul. The correction is summed\n            # in an fp32 scratch (the kernel's atomics) and folded into the bf16\n            # output with a SINGLE rounding -- accumulating directly in bf16 is\n            # non-associative and raced to out-of-tolerance error on large-K\n            # shapes (down_proj) where many exceptions hit the same output row.\n            # Always applied: the palette-only fused decode is otherwise lossy.\n            if comp.exc_idx.numel() > 0:\n                ycorr = torch.zeros(M, N, dtype=torch.float32, device=x2.device)\n                _get_ext().exc_correct(\n                    comp.exc_idx, comp.exc_ub, comp.lb_raw, comp.palette,\n                    x2c, ycorr, N, K, M)\n                y = (y.float() + ycorr.t()).to(torch.bfloat16)\n        else:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            A = self.decompress(comp)\n            if we is not None:\n                we.record()\n            if A.device != x2.device:\n                A = A.to(x2.device)\n            y = F.linear(x2, A)\n        return y.reshape(*orig[:-1], M)\n\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def decompress_batch(self, *args, **kwargs):\n        return super().decompress_batch(*args, **kwargs)\n\n    def compress(self, weight, decomp_output_tensor=None,\n                 comp_output_tensor=None, _sync=True):\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(f\"UBLBFlatCompressor expects BF16, got {weight.dtype}\")\n        if weight.dim() != 2:\n            raise ValueError(f\"expects 2D [M,K], got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\"UBLBFlatCompressor requires a CUDA tensor\")\n        M, K = int(weight.shape[0]), int(weight.shape[1])\n        n = M * K\n        if n % 512 != 0:\n            raise ValueError(f\"requires M*K multiple of 512 (warp tile), got {n}\")\n        dev = weight.device\n\n        # little-endian bf16 bytes: [lb0, ub0, lb1, ub1, ...]\n        bv = weight.contiguous().view(torch.uint8).reshape(-1)\n        lb_raw = bv[0::2].contiguous()\n        ub = bv[1::2].contiguous()\n\n        # 16-entry palette = 16 most frequent upper bytes (codes 0..15).\n        hist = torch.bincount(ub.to(torch.int64), minlength=256)\n        pal_idx = torch.topk(hist, 16).indices.to(torch.uint8)\n        palette = pal_idx.clone()\n        ub_l = ub.to(torch.int64)\n        lut = torch.zeros(256, dtype=torch.uint8, device=dev)\n        lut[pal_idx.to(torch.int64)] = torch.arange(16, dtype=torch.uint8, device=dev)\n        in_pal = torch.zeros(256, dtype=torch.bool, device=dev)\n        in_pal[pal_idx.to(torch.int64)] = True\n\n        codes = lut[ub_l]                       # [n] uint8, 0..15\n        exc_mask = ~in_pal[ub_l]                # [n] bool\n        exc_idx = exc_mask.nonzero(as_tuple=True)[0].to(torch.int32)\n        exc_ub = ub[exc_mask].contiguous()\n        # nibble-pack: low nibble = even element, high nibble = odd element\n        code_stream = (codes[0::2] | (codes[1::2] << 4)).contiguous()\n\n        comp = CompressedUBLBFlatTensor({\n            \"code_stream\": code_stream, \"lb_raw\": lb_raw, \"palette\": palette,\n            \"exc_idx\": exc_idx, \"exc_ub\": exc_ub, \"M\": M, \"K\": K,\n        })\n        if decomp_output_tensor is not None:\n            comp.output_tensor = decomp_output_tensor\n        if _sync:\n            torch.cuda.synchronize()\n            ne = int(exc_idx.numel())\n            logger.info(\n                f\"UBLB-flat compress [{M}x{K}]: \"\n                f\"ratio={weight.nbytes / max(1, comp.total_compressed_size):.3f}x, \"\n                f\"exc={ne} ({100.0 * ne / n:.2f}%)\")\n        return comp\n\n    def compress_cpu(self, weight, _sync=True):\n        \"\"\"CPU (host) encoder — C++ OpenMP ``flat_host_encode``, same compressed\n        layout as :meth:`compress`, decodable bit-exact by the GPU flat_decode +\n        flat_patch kernels (decode stays on GPU). The fast (CPU-encode +\n        GPU-decode) production pattern, mirroring ublb_tbe's ``compress_cpu``.\n    #   batch 128: O/GU/Down fused, QKV decomp = 189.65ms (all-fused incl QKV\n    #     192.30 -> QKV's RS kernel is too slow even with contention; decomp\n    #     O/Down per isolated-optimal = 194.20 -> WORSE, contention dominates).\n    #   batch 256: GU/Down fused (256) = 321.67 vs GU/Down decomp (192) = 331.11\n    #     -> fusing wins by 9.4ms even at N=256 (isolated bench says decomp here,\n    #     but the engine HBM-write contention flips it).\n    # That measurement supported fusing O/GateUp/Down broadly, but keep the\n    # live table scoped to the batch-128 serving range we are validating now;\n    # N>256 (prefill) decompresses anyway via fallback.\n    # The isolated+H2D benchmark below crossed over to decompress+cuBLAS earlier\n    # for O/Down, but the batch-128 serving trace regressed in exactly that\n    # region: dense materialization pushes the frozen-weight scheduling gap into\n    # every decode graph.  Keep QKV conservative, but restore O/Down to the\n    # in-engine batch-128 fused range.\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused WINS or is a noise-level TIE (<=2%) vs decmp\n        # under H2D -- a tie favours fused anyway (no dense-weight HBM write).\n        #\n        # QKV fuses (=64) like the rest.  The fused path is the RS kernel (approx) + a\n        # SEPARATE p4_exc_correct kernel (one block per out-of-palette exception);\n        # decompress pays no exception cost, so a HIGH-exception layer can flip\n        # fused below decomp.  But a PER-LAYER, real-weight sweep (all 80 Llama-70B\n        # layers @ N=64, H2D) showed fused WINS 78/80 QKV layers (~1.13x); only the\n        # 2 extreme early layers lose (layer0 314k exc -> 0.44x, layer1 39k ->\n        # 0.96x).  O 77/80 (3 are noise-level ~1.0x), GateUp 80/80 (even layer0\n        # 113k exc wins 1.31x -- its 940MB avoided write swamps exceptions), Down\n        # 80/80.  We accept the 1-2 extreme-outlier layers (e.g. QKV layer0)\n        # being slower rather than gate per layer -- aggregate TPOT cost ~0.1%.\n        # (Earlier QKV=0 was a layer-0 sampling artifact: the isolated bench's\n        # real-weight loader only ever sees layer 0, the 314k outlier.  Most QKV\n        # layers have ~1.6k exceptions and fuse-win.)\n        # best-N re-derived by an 8-step N sweep on a representative (median-exc)\n        # real layer (layer 40, N=8..256, H2D).  Cliff is structural: at N>64 the\n        # small-M shapes (QKV/O/Down) remap to the slow Npad=192 WGMMA tile\n        # (_pad_n), so they lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n           