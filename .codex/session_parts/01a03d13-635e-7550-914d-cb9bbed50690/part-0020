  \"\"\"Allocate per-(K, M, N) scratch tensors that ``linear_apply_into``\n        will reuse.  The default returns ``None`` and the custom op falls\n        back to the alloc-every-call :meth:`linear_apply`.\n        \"\"\"\n        del K, M, N, dtype, device\n        return None\n\n    def linear_apply_into(\n        self,\n        comp: CompressedTensor,\n        x: \"torch.Tensor\",\n        scratch: Any,\n    ) -> \"torch.Tensor\":\n        \"\"\"Zero-alloc variant of :meth:`linear_apply` that writes\n        intermediates into ``scratch``.  Default just delegates to\n        :meth:`linear_apply` (which allocates per call) — subclasses\n        that supply :meth:`alloc_fused_scratch` should override this.\n        \"\"\"\n        del scratch\n        return self.linear_apply(comp, x)\n\n    def build_split_shell(self, info: Any, staging_dict: Any) -> CompressedTensor:\n        \"\"\"Build a fused-MM-ready compressed-tensor shell for frozen_split.\n\n        ``info`` is a :class:`SplitStorageInfo` carrying the HBM-permanent\n        ``sign_mantissa`` plus scalar metadata, and ``staging_dict`` is\n        the per-(name, parity) dict of staging tensors that the H2D\n        producer populates each forward.\n\n        Subclasses that support frozen_split + ``--fused-mm`` must\n        override this to return a ``Compressed{Backend}Tensor`` whose\n        codec buffers are aliased onto the right HBM/staging memory.\n        \"\"\"\n    def build_offload_shell(\n        self,\n        comped: \"CompressedZipServTensor\",\n        output_tensor: Optional[torch.Tensor] = None,\n    ) -> \"CompressedZipServTensor\":\n        \"\"\"Construct a fused-MM-ready :class:`CompressedZipServTensor` for an\n        ``offload_compressed`` cell.\n\n        Unlike :meth:`build_split_shell` (frozen_split keeps ``sign_mantissa``\n        HBM-permanent), offload streams the WHOLE compressed blob into the\n        per-decode GPU staging every step.  So every codec buffer aliases\n        ``comped``'s GPU staging via :meth:`get_gpu_buffers` — the\n        ``_H2D_ATTRS`` (sign_mantissa / compressed_full / bitmaps) live in the\n        shared ``_d_*`` pool (overwritten each step by ``.to()``), while\n        ``tile_offsets_*`` are the per-layer permanent ``_d_tile_offsets_*``\n        copies.  The fused kernel then reads the freshly-streamed blob directly\n        and the dense decompress is skipped on the load path.\n\n        ``output_tensor`` (the layer's dense primary buffer) is bound so\n        ``fused_mm``'s large-N fallback (decompress → cuBLAS when\n        ``N > _n_threshold``) has a destination for the dense weight.\n        \"\"\"\n        sm, cf, b1, b2, b3, tom, tog = comped.get_gpu_buffers()\n        M, K = int(comped.M), int(comped.K)\n        buffers = {\n            'sign_mantissa': sm,\n            'compressed_full': cf,\n            'bitmap1': b1,\n            'bitmap2': b2,\n            'bitmap3': b3,\n            'tile_offsets_median': tom,\n            'tile_offsets_global': tog,\n            'max_high_freq_count': int(comped.max_high_freq_count),\n            'max_full_count': int(comped.max_full_count),\n            'start_exp': int(comped.start_exp),\n            'num_global_tiles': (M // 64) * (K // 64),\n            'num_tiles': (M // 8) * (K // 8),\n            'M': M,\n            'K': K,\n        }\n        shell = CompressedZipServTensor(buffers)\n        if output_tensor is not None:\n            shell.output_tensor = output_tensor\n        # All fused/decompress ops run on the current stream — capture-safe.\n        return shell\n\n    def alloc_fused_scratch(self, K: int, M: int, N: int,\n                            dtype: torch.dtype, device: torch.device\n                            ) -> Dict[str, torch.Tensor]:\n        \"\"\"Pre-allocate scratch for ZipServ's fused_mm.  ZipServ takes B\n        as ``(N, K)`` row-major (= the activation view directly) and\n        writes C in column-major ``(M, N)`` layout — its 