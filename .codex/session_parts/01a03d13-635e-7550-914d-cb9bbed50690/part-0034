return min(values), statistics.median(values), _percentile(values, 0.95)\\n+\\n+\\n+def _make_codec(name: str):\\n+    if name == \\\"p4flat\\\":\\n+        codec = P4FlatCompressor()\\n+    elif name == \\\"chunk_delta3\\\":\\n+        codec = ChunkDelta3Compressor(torch.cuda.current_stream())\\n+    else:\\n+        raise ValueError(name)\\n+    codec._fused_max_n_override = 10**9\\n+    return codec\\n+\\n+\\n+def _stage_exponent(comp, attrs: tuple[str, ...]):\\n+    \\\"\\\"\\\"Keep native sign/mantissa intact; replace only exponent attrs by HBM slots.\\\"\\\"\\\"\\n+    target = comp._c\\n+    host_sources = []\\n+    device_staging = []\\n+    for attr in attrs:\\n+        source = getattr(target, attr).contiguous()\\n+        host = torch.empty_like(source, device=\\\"cpu\\\", pin_memory=True)\\n+        host.copy_(source)\\n+        staging = torch.empty_like(source, device=source.device)\\n+        staging.copy_(source)\\n+        setattr(target, attr, staging)\\n+        if source.numel() > 0:\\n+            host_sources.append(host)\\n+            device_staging.append(staging)\\n+    torch.cuda.synchronize()\\n+    return tuple(host_sources), tuple(device_staging)\\n+\\n+\\n+def _batch_h2d(host_sources, device_staging, stream: torch.cuda.Stream):\\n+    if not host_sources:\\n+        return\\n+    zipserv_ext.batch_memcpy_ptrs(\\n+        [dst.data_ptr() for dst in device_staging],\\n+        [src.data_ptr() for src in host_sources],\\n+        [src.numel() * src.element_size() for src in host_sources],\\n+        stream.cuda_stream,\\n+    )\\n+\\n+\\n+def _bench_one(codec_name, proj, weight_cpu, n, warmup, iterations, flush):\\n+    weight = weight_cpu.cuda()\\n+    M, K = weight.shape\\n+    codec = _make_codec(codec_name)\\n+    comp = codec.compress(weight)\\n+    attrs = tuple(_EXP_ATTRS[codec_name])\\n+    host_sources, device_staging = _stage_exponent(comp, attrs)\\n+    h2d_bytes = sum(t.numel() * t.element_size() for t in host_sources)\\n+\\n+    generator = torch.Generator(device=\\\"cuda\\\").manual_seed(20250827 + n)\\n+    x = torch.randn(n, K, generator=generator, dtype=torch.bfloat16,\\n+                    device=\\\"cuda\\\")\\n+    scratch = codec.alloc_fused_scratch(K, M, n, x.dtype, x.device)\\n+\\n+    def fused():\\n+        return codec.linear_apply_into(comp, x, scratch)\\n+\\n+    # First-use compilation and scratch allocations are outside the samples.\\n+    actual = fused()\\n+    expected = torch.nn.functional.linear(x, weight)\\n+    torch.cuda.synchronize()\\n+    amax = expected.float().abs().max().item()\\n+    if not torch.allclose(actual.float(), expected.float(),\\n+                          atol=max(1.0, 0.02 * amax), rtol=0.02):\\n+        raise RuntimeError(f\\\"fused mismatch: {codec_name}/{proj}/N={n}\\\")\\n+\\n+    copy_stream = torch.cuda.Stream()\\n+    compute_stream = torch.cuda.current_stream()\\n+    ready = torch.cuda.Event()\\n+\\n+    def run_once(timed: bool):\\n+        if flush:\\n+            flush_l2_cache()\\n+            compute_stream.synchronize()\\n+        start = torch.cuda.Event(enable_timing=timed)\\n+        copy_end = torch.cuda.Event(enable_timing=timed)\\n+        kernel_begin = torch.cuda.Event(enable_timing=timed)\\n+        end = torch.cuda.Event(enable_timing=timed)\\n+        with torch.cuda.stream(copy_stream):\\n+            start.record(copy_stream)\\n+            _batch_h2d(host_sources, device_staging, copy_stream)\\n+            copy_end.record(copy_stream)\\n+            ready.record(copy_stream)\\n+        with torch.cuda.stream(compute_stream):\\n+            compute_stream.wait_event(ready)\\n+            kernel_begin.record(compute_stream)\\n+            output = fused()\\n+            end.record(compute_stream)\\n+        end.synchronize()\\n+        if not timed:\\n+            return output, None\\n+        return output, (\\n+            start.elapsed_time(copy_end),\\n+            kernel_begin.elapsed_time(end),\\n+         