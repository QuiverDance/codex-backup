adapters/cuda/zipserv_fused_wgmma_cluster_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_2wg_sm90.cu\",\n] if _is_hopper else []\n\n# When WGMMA sources are omitted, define ZIPSERV_NO_WGMMA so the call sites\n# in zipserv_fused_mm_gpu.cu / zipserv_p4flat_fused_mm.cu /\n# zipserv_p4wg_fused_mm.cu emit stub launchers that return cudaErrorNotSupported.\n_wgmma_defines = [] if _is_hopper else [\"-DZIPSERV_NO_WGMMA=1\"]\n\n_p4flat_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# P4-WG codec — same compression as p4flat but 8x8 subblock layout for\n# WGMMA-friendly fused decompress+GEMM.  WGMMA path is Hopper-only (sm_90a);\n# on Blackwell only the ldmatrix-based fused_mm kernel is built.\n_p4wg_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4wg_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# nvcomp SDK is optional — only build the extension if its headers are\n# available. Without it the nvcomp-backed compressors stay disabled (their\n# Python wrappers log a warning, same as the WGMMA-disabled path).\ndef _nvcomp_include_dir():\n    for candidate in (\"/usr/include/nvcomp_13\", \"/usr/include/nvcomp_12\",\n                      \"/usr/include\"):\n        if _os.path.isfile(_os.path.join(candidate, \"nvcomp\", \"gdeflate.hpp\")):\n            return candidate\n    return None\n\n_nvcomp_inc = _nvcomp_include_dir()\n\n# ---------------------------------------------------------------------------\n# Parallel build: torch's JIT load() builds each extension sequentially, and\n# with only a handful of sources per extension a single heavy nvcc invocation\n# serialises the whole import.  Extensions have distinct names -> distinct\n# build dirs (FileBaton-locked individually), so building them concurrently\n# is safe.  TIERED_SERVE_BUILD_JOBS caps concurrent extension builds; each\n# build's internal ninja parallelism is capped via MAX_JO