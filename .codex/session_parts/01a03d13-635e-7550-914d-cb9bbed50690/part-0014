),\\n    re.compile(r\\\"(?i)(authorization:\\\\s*bearer\\\\s+)[A-Za-z0-9._~+/=-]+\\\"),\\n)\\n\\n\\ndef redact(text: str) -> str:\\n    for pattern in SECRET_PATTERNS:\\n        text = pattern.sub(lambda match: match.group(1) + \\\"[REDACTED]\\\"\\n                           if match.lastindex else \\\"[REDACTED]\\\", text)\\n    return text\\n\\n\\ndef visible_text(content: list[dict]) -> list[str]:\\n    texts: list[str] = []\\n    for item in content:\\n        text = item.get(\\\"text\\\") or item.get(\\\"input_text\\\") or item.get(\\n            \\\"output_text\\\")\\n        if not text:\\n            continue\\n        # These are runtime-injected context records, not user-authored chat.\\n        if text.startswith(\\\"<recommended_plugins>\\\"):\\n            continue\\n        if text.startswith(\\\"<environment_context>\\\"):\\n            continue\\n        texts.append(redact(text.strip()))\\n    return texts\\n\\n\\ndef main() -> None:\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\\"rollout\\\", type=Path)\\n    parser.add_argument(\\\"output\\\", type=Path)\\n    args = parser.parse_args()\\n\\n    messages: list[tuple[str, str]] = []\\n    session_id = \\\"unknown\\\"\\n    timestamp = \\\"unknown\\\"\\n    cli_version = \\\"unknown\\\"\\n\\n    with args.rollout.open(encoding=\\\"utf-8\\\") as source:\\n        for line in sour…5027 tokens truncated…ompressor):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"FP8 e4m3 P3-flat weight compressor backed by tiered-serve's\\\\n    ``zipserv_p3flat_fp8_ext`` PyTorch C++ extension.\\\\n\\\\n    Per-tile 7-entry exp palette + 3-bit codes (palette idx or marker\\\\n    code 7) + 4-bit sm nibbles. Out-of-palette exps land in a per-tile\\\\n    exception substream (4-bit exp nibbles, packed 2/byte) addressed by\\\\n    intra-tile rank computed via warp prefix-sum during decompress.\\\\n\\\\n    Target ratio on Llama-3.1-70B-FP8 down_proj: ~1.10–1.12×. M and K\\\\n    must be multiples of 64.\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    HAS_FUSED_MM = False\\\\n\\\\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\\\\n        super().__init__(comp_stream)\\\\n        if not _HAS_P3FLAT_FP8:\\\\n            raise RuntimeError(\\\\n                \\\\\\\"P3FlatFP8Compressor requires tiered-serve's \\\\\\\"\\\\n                \\\\\\\"zipserv_p3flat_fp8_ext extension to build successfully.\\\\\\\")\\\\n\\\\n    def compress(\\\\n        self,\\\\n        weight: torch.Tensor,\\\\n        decomp_output_tensor: Optional[torch.Tensor] = None,\\\\n        comp_output_tensor: Optional[CompressedP3FlatFP8Tensor] = None,\\\\n        _sync: bool = True,\\\\n    ) -> CompressedP3FlatFP8Tensor:\\\\n        del comp_output_tensor\\\\n        if weight.dtype != torch.float8_e4m3fn:\\\\n            raise TypeError(\\\\n                f\\\\\\\"P3FlatFP8Compressor expects float8_e4m3fn, got {weight.dtype}\\\\\\\")\\\\n        if weight.ndim != 2:\\\\n            raise ValueError(\\\\n                f\\\\\\\"P3FlatFP8Compressor expects a 2-D tensor, got {tuple(weight.shape)}\\\\\\\")\\\\n        if not weight.is_cuda:\\\\n            raise RuntimeError(\\\\n                \\\\\\\"P3FlatFP8Compressor.compress requires a CUDA-resident weight\\\\\\\")\\\\n\\\\n        c_struct = _p3f_ext.compress(weight)\\\\n        comp = CompressedP3FlatFP8Tensor(c_struct)\\\\n        if decomp_output_tensor is not None:\\\\n            comp.output_tensor = decomp_output_tensor\\\\n        if _sync:\\\\n            ratio = weight.nbytes / max(1, comp.nbytes)\\\\n            logger.info(\\\\n                f\\\\\\\"P3FlatFP8 compress [{comp.M}x{comp.K}]: ratio={ratio:.3f}x  \\\\\\\"\\\\n                f\\\\\\\"nbytes={comp.nbytes}  num_exceptions={comp.num_exceptions}\\\\\\\")\\\\n        return comp\\\\n\\\\n    def decompress(\\\\n        self,\\\\n        comp: CompressedP3FlatFP8Tensor,\\\\n        output: Optional[torch.Tensor] = None,\\\\n    ) -> torch.Tensor:\\\\n        if not isinstance(comp, CompressedP3FlatFP8Tensor):\\\\n            raise TypeError(\\\\n                f\\\\\\\"P3FlatFP8Compressor.decompress expects \\\\\\\"\\\\n                f\\\\\\\"CompressedP3FlatFP8Tensor, got {type(comp).__name__}\\\\\\\")\\\\n        if output is None:\\\\n            output = comp.output_tensor\\\\n        return _p3f_ext.decompress(comp._c, output)\\\\n\\\\n    def compress_batch(self, *args, **kwargs):\\\\n        return super().compress_batch(*args, **kwargs)\\\\n\\\\n    def decompress_batch(self, *args, **kwargs):\\\\n        return super().decompress_batch(*args, **kwargs)\\\\n\\\\n    def build_split_shell(self, info, staging_dict):\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Reconstruct a ``CompressedP3FlatFP8`` struct from per-attr buffers\\\\n        (HBM-resident ``sm_nibbles`` + LPDDR/staging-resident headers /\\\\n        codes / exc data) so frozen_split can route through decompress.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        c = _p3f_ext.CompressedP3FlatFP8()\\\\n        c.sm_nibbles = info.sm_nibbles  # HBM-resident\\\\n        for attr in info.lpddr_attrs:\\\\n            c_t = staging_dict[attr]\\\\n            ln = info.lpddr_numels[attr]\\\\n            setattr(c, attr, c_t.narrow(0, 0, ln) if ln > 0 else c_t)\\\\n        c.M = int(info.M)\\\\n        c.K = int(info.K)\\\\n        c.num_exceptions = int(info.num_exceptions)\\\\n        return CompressedP3FlatFP8Tensor(c)\\\\n\\\\n=== cpp_exts tail/export ===\\\\n    ],\\\\n    with_cuda=True,\\\\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\\\\n    extra_cflags=[\\\\n        \\\\\\\"-D_GLIBCXX_USE_CXX11_ABI=1\\\\\\\", \\\\\\\"-O3\\\\\\\", \\\\\\\"-std=gnu++17\\\\\\\",\\\\n    ],\\\\n    extra_cuda_cflags=[\\\\n        \\\\\\\"--std=c++17\\\\\\\", \\\\\\\"-O3\\\\\\\",\\\\n    ],\\\\n    extra_ldflags=[\\\\n        f\\\\\\\"-L{sysconfig.get_config_var('LIBDIR')}\\\\\\\",\\\\n        f\\\\\\\"-L/usr/lib/{_libarch}\\\\\\\",\\\\n        \\\\\\\"-lcuda\\\\\\\",\\\\n  