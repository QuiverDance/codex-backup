{"timestamp":"2026-08-27T09:46:49.193Z","ordinal":1300,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0429d-6fe9-7e41-b237-88d633bf9fb1","call_id":"call_yWfFpXDOXUAJbA3CQ2sZ7rrc","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Torch bindings for the WGMMA fusion lab (raw / UBLB-flat producers).\n#include <torch/extension.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cuda_bf16.h>\n#include <cuda_runtime.h>\n#include <cstdint>\n\nextern \"C\" cudaError_t raw_pipe_wgmma_launch(\n    cudaStream_t, const __nv_bfloat16*, const __nv_bfloat16*,\n    __nv_bfloat16*, int, int, int);\nextern \"C\" cudaError_t u4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\nextern \"C\" cudaError_t p4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int,\n    const int*, const uint16_t*, int, int, int, int);\nextern \"C\" cudaError_t p4_exc_correct_launch(\n    cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n    const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n    int64_t, int, int, int);\nextern \"C\" cudaError_t zip_rs_wgmma_launch(\n    cudaStream_t, const uint64_t*, const uint64_t*, const uint64_t*,\n    const uint8_t*, int, const uint16_t*, const int*,\n    const __nv_bfloat16*, __nv_bfloat16*, int, int, int);\n\n// C is the COLUMN-major [M,N] output buffer (physically [N,M] row-major):\n// caller passes a contiguous [N, M] bf16 tensor; element (m,n) lands at n*M+m.\n// Ws (split_k>1) is an [split_k*M*N] f32 workspace; pass an empty tensor for\n// split_k==1 (direct bf16 write path).\n\nstatic float* ws_ptr(torch::Tensor Ws) {\n    return Ws.numel() ? reinterpret_cast<float*>(Ws.data_ptr()) : nullptr;\n}\n\nvoid raw_pipe_wgmma_mm(torch::Tensor A, torch::Tensor B, torch::Tensor C,\n                       int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = raw_pipe_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const __nv_bfloat16*>(A.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"raw_pipe_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K, \")\");\n}\n\nvoid u4_rs_wgmma_mm(torch::Tensor code_stream, torch::Tensor lb_raw,\n                    torch::Tensor palette, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = u4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(code_stream.data_ptr()),\n        reinterpret_cast<const uint8_t*>(lb_raw.data_ptr()),\n        reinterpret_cast<const uint8_t*>(palette.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k, (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"u4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\nvoid p4_rs_wgmma_mm(torch::Tensor codes, torch::Tensor sm, torch::Tensor headers,\n                    torch::Tensor codec, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = p4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm.data_ptr()),\n        reinterpret_cast<const uint8_t*>(headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(codec.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k,\n        nullptr, nullptr, 0,                       // no exception correction\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"p4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\n// zipserv RS-mode fused decode + GEMM. bm1/2/3 are the triple-bitmap uint64\n// arrays; csm is the canonical [M*K] row-major sign|mantissa; fv holds the\n// low-freq (LF) bf16 values in flat (tile_idx, bit) order and fvoff is the\n// per-small-tile LF prefix offset — both decoded inline (no correction pass).\nvoid zip_rs_wgmma_mm(torch::Tensor bm1, torch::Tensor bm2, torch::Tensor bm3,\n                     torch::Tensor csm, int64_t start_exp,\n                     torch::Tensor fv, torch::Tensor fvoff,\n                     torch::Tensor B, torch::Tensor C,\n                     int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = zip_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint64_t*>(bm1.data_ptr()),\n        reinterpret_cast<const uint64_t*>(bm2.data_ptr()),\n        reinterpret_cast<const uint64_t*>(bm3.data_ptr()),\n        reinterpret_cast<const uint8_t*>(csm.data_ptr()),\n        (int)start_exp,\n        reinterpret_cast<const uint16_t*>(fv.data_ptr()),\n        reinterpret_cast<const int*>(fvoff.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"zip_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K, \")\");\n}\n\nvoid p4_exc_correct(torch::Tensor exc_idx, torch::Tensor exc_val,\n                    torch::Tensor codes, torch::Tensor sm, torch::Tensor headers,\n                    torch::Tensor codec, torch::Tensor X, torch::Tensor Ycorr,\n                    int64_t num_exc, int64_t N, int64_t K, int64_t M) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = p4_exc_correct_launch(\n        stream.stream(),\n        reinterpret_cast<const int*>(exc_idx.data_ptr()),\n        reinterpret_cast<const uint16_t*>(exc_val.data_ptr()),\n        reinterpret_cast<const uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm.data_ptr()),\n        reinterpret_cast<const uint8_t*>(headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(codec.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(X.data_ptr()),\n        reinterpret_cast<float*>(Ycorr.data_ptr()),\n        (int64_t)num_exc, (int)N, (int)K, (int)M);\n    TORCH_CHECK(e == cudaSuccess, \"p4_exc_correct_launch failed: \",\n                cudaGetErrorString(e));\n}\n\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n    m.def(\"p4_rs_wgmma_mm\", &p4_rs_wgmma_mm, \"RS-mode register-A p4flat fused GEMM (P4 B-4, lossy)\");\n    m.def(\"zip_rs_wgmma_mm\", &zip_rs_wgmma_mm, \"RS-mode register-A zipserv fused GEMM (triple-bitmap, exact w/ LF correction)\");\n    m.def(\"p4_exc_correct\", &p4_exc_correct, \"p4flat fused exact exception correction\");\n    m.def(\"u4_rs_wgmma_mm\", &u4_rs_wgmma_mm, \"RS-mode register-A UBLB-flat fused GEMM (U4 B-4)\");\n    m.def(\"raw_pipe_wgmma_mm\", &raw_pipe_wgmma_mm, \"deep cp.async pipelined raw WGMMA GEMM (E1 B-1)\");\n}\n\"\"\"Lossless BF16 ChunkDelta3 compressor.\n\nChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\n16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\nencodes exponent deltas in three bits.  Values outside the local 3-bit range\nare restored from a packed 17-bit exception stream, making the codec bit exact.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\ntry:\n    from tiered_serve.cpp_exts import tp3_cd3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load tp3_cd3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"warp_prefixes\",\n        \"entries17\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n            alignment = tensor.element_size()\n            offset = (offset + alignment - 1) // alignment * alignment\n            layout.append(\n                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n            offset += tensor.nbytes\n\n        if huge_page_allocator is not None:\n            try:\n                host_slab = huge_page_allocator.allocate(\n                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n            except (MemoryError, ValueError):\n                logger.warning(\n                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n                    \"pinned host memory\")\n                host_slab = torch.empty(offset, dtype=torch.uint8,\n                                        pin_memory=True)\n        else:\n            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n\n        host_views = []\n        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n            view.copy_(source)\n            setattr(self, attr, view)\n            host_views.append(view)\n        self._host_slab = host_slab\n        self._slab_layout = tuple(layout)\n        self._device_slab = None\n        self._h2d_views = None\n        self._h2d_sources = None\n        self._copy_slab = False\n        self._set_native_buffers(tuple(host_views))\n        return self\n\n    def to(self, device=\"cuda\", non_blocking: bool = True):\n        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n        if torch.device(device).type != \"cuda\":\n            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n        if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = False\n    codec_name = \"chunk_delta3\"\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\"ChunkDelta3Compressor requires a CUDA tensor\")\n        if weight.shape[0] % 64 or weight.shape[1] % 64:\n            raise ValueError(\n                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n                f\"got {tuple(weight.shape)}\")\n\n        source = weight.contiguous()\n        stream = self.comp_stream or torch.cuda.current_stream(weight.device)\n        producer_stream = torch.cuda.current_stream(weight.device)\n        if stream != producer_stream:\n            stream.wait_stream(producer_stream)\n        with torch.cuda.stream(stream):\n            native = _cd3_ext.compress_chunk_delta3(source)\n        if _sync:\n            # The packed-entry kernel is enqueued after a host-visible count\n            # readback.  Complete it before exposing the object cross-stream.\n            stream.synchronize()\n        compressed = CompressedChunkDelta3Tensor(native)\n        if decomp_output_tensor is not None:\n            compressed.output_tensor = decomp_output_tensor\n        if _sync:\n            ratio = weight.nbytes / max(1, compressed.nbytes)\n            logger.info(\n                \"ChunkDelta3 compress [%dx%d]: ratio=%.3fx nbytes=%d \"\n                \"exceptions=%d\", compressed.M, compressed.K, ratio,\n                compressed.nbytes, compressed.num_exceptions)\n        return compressed\n\n    def decompress(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        output: Optional[torch.Tensor] = None,\n    ) -> torch.Tensor:\n        if not isinstance(comp, CompressedChunkDelta3Tensor):\n            raise TypeError(\n                \"ChunkDelta3Compressor.decompress expects \"\n                f\"CompressedChunkDelta3Tensor, got {type(comp).__name__}\")\n        output = output if output is not None else comp.output_tensor\n        if output is None:\n            if comp.sign_mantissa.device.type != \"cuda\":\n                raise RuntimeError(\n                    \"Host-resident ChunkDelta3 data must be staged before \"\n                    \"decompression\")\n            output = torch.empty(\n                (comp.M, comp.K), dtype=torch.bfloat16,\n                device=comp.sign_mantissa.device)\n        return _cd3_ext.decompress_chunk_delta3(comp._c, output)\n\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def decompress_batch(self, *args, **kwargs):\n        return super().decompress_batch(*args, **kwargs)\n\n    def build_split_shell(self, info, staging_dict):\n        if getattr(info, \"backend\", None) != \"chunk_delta3\":\n            raise NotImplementedError(\n                \"ChunkDelta3 build_split_shell requires chunk_delta3 data\")\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.sign_mantissa = info.sign_mantissa\n        for attr in info.lpddr_attrs:\n            value = staging_dict.get(attr)\n            if value is None:\n                raise RuntimeError(\n                    f\"ChunkDelta3 staging slot missing {attr!r}\")\n            setattr(native, attr, value)\n        for attr in info.hbm_attrs:\n            value = info.hbm_buffers.get(attr)\n            if value is None:\n                raise RuntimeError(f\"ChunkDelta3 HBM buffer missing {attr!r}\")\n            setattr(native, attr, value)\n        native.M = int(info.M)\n        native.K = int(info.K)\n        native.num_exceptions = int(info.num_exceptions)\n        return CompressedChunkDelta3Tensor(native)\n                    gateup.setdefault(li, {})[\"up\"] = t\n                elif \".o_proj.\" in key and \"o\" in want and shp == want[\"o\"]:\n                    found.setdefault(\"o\", t.contiguous())\n                elif \".down_proj.\" in key and \"down\" in want and shp == want[\"down\"]:\n                    found.setdefault(\"down\", t.contiguous())\n                try_fuse()\n        if all(p in found for p in want):\n            break\n\n    missing = [p for p in want if p not in found]\n    if missing:\n        where = (f\"layer {layer}\" if layer is not None\n                 else f\"the first {max_shards} shards\")\n        hint = (\"check --layer is in range [0, 79]\" if layer is not None\n                else \"increase --shards or use --synthetic\")\n        raise RuntimeError(\n            f\"Could not find real weights for {missing} in {where} ({hint}).\")\n    return found\n\n\ndef make_synthetic(M, K, seed):\n    g = torch.Generator(device=\"cuda\").manual_seed(seed)\n    return (torch.randn(M, K, generator=g, device=\"cuda\",\n                        dtype=torch.float32) * 0.02).to(torch.bfloat16)\n\n\n# ── Codec registry + force-fuse ──────────────────────────────────────────────\ndef build_codec(name):\n    from tiered_serve.compression.core import (\n        ZipServCompressor, P4FlatCompressor, UBLBFlatCompressor)\n    if name == \"zipserv\":\n        # Run on the CURRENT stream (not a private comp_stream) so the cuda-event\n        # timing captures zipserv's decompress kernel — on a separate stream it\n        # is invisible to current-stream events and was mis-measured ~14x fast\n        # (0.029 vs true 0.41ms). p4flat/ublb already run on the current stream.\n        return ZipServCompressor(torch.cuda.current_stream())\n    if name == \"p4flat\":\n        return P4FlatCompressor()\n    if name == \"ublb_flat\":\n        return UBLBFlatCompressor()\n    raise ValueError(f\"unknown codec {name}\")\n\n\n_FORCE = 10 ** 18\n\n\ndef force_fused(codec, name):\n    \"\"\"Open the codec's per-shape fused N-threshold so the fused kernel runs at\n    every N (the production threshold is calibrated from the crossover).\"\"\"\n    if name == \"zipserv\":\n        from tiered_serve.compression.core import ZipServCompressor\n        ZipServCompressor._n_threshold = staticmethod(lambda M, K: _FORCE)\n    else:  # p4flat, ublb_flat both consult self._fused_max_n_override first\n        codec._fused_max_n_override = _FORCE\n\n\ndef compressed_bytes(comp):\n    for attr in (\"total_compressed_size\", \"nbytes\"):\n        if hasattr(comp, attr):\n            v = getattr(comp, attr)\n            return int(v() if callable(v) else v)\n    return 0\n\n\ndef exception_count(codec_name, comp) -> int:\n    if codec_name == \"zipserv\":\n        return int(comp.compressed_full.numel())\n    target = getattr(comp, \"_c\", comp)\n    for attr in (\"exc_indices\", \"exc_idx\"):\