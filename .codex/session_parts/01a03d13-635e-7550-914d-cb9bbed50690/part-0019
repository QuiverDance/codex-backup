F32[device] = t\\n  1615\\t    return t\\n  1616\\t\\n  1617\\t\\n  1618\\tdef _pad_n(N, M=0):\\n  1619\\t    \\\"\\\"\\\"Pad N to a WGMMA N-tile, M-awarely avoiding the slow 64x128 tile: it holds\\n  1620\\t    2 blocks/SM but a single warpgroup each, so for SMALL M (few M-tiles, can't\\n  1621\\t    fill the device) the wider 64x192 tile wins despite more work.  Used by the\\n  1622\\t    p4flat RS fused linear_apply.\\\"\\\"\\\"\\n  1623\\t    base = ((N + 63) // 64) * 64\\n  1624\\t    if base == 128 and (M >> 6) < 256:\\n  1625\\t        return 192\\n  1626\\t    return base\\n  1627\\t\\n  1628\\t\\n  1629\\tdef _u4_split_k(M, Npad, K):\\n  1630\\t    \\\"\\\"\\\"Pick split-K so the u4_rs grid (M/64 x Npad/tileN) fills the GPU at decode\\n  1631\\t    N.  split_k must divide tiles_k (=K/64).  Split-K helps only in the\\n  1632\\t    latency-bound decode regime (small N): at larger N the per-block WGMMA work\\n  1633\\t    already keeps the SMs busy, so the extra blocks + reduction regress\\n  1634\\t    (measured: down/o N>=256 ~0.9x).  Cap split_k by N accordingly.\\\"\\\"\\\"\\n  1635\\t    tn = (256 if Npad % 256 == 0 else 192 if Npad % 192 == 0\\n  1636\\t          else 128 if Npad % 128 == 0 else 64)\\n  1637\\t    tiles_k = K // 64\\n  1638\\t    base = (M // 64) * (Npad // tn)\\n  1639\\t    # Only split at the smallest decode tile (Npad==64): there the grid is most\\n  1640\\t    # undersubscribed and split-K wins big (~1.2-1.25x).  At Npad>=128 the\\n  1641\\t    # per-block work already fills the SMs, so splitting regresses (measured:\\n  1642\\t    # p4 down N=96/128 flipped fused->decmm); leave those unsplit.\\n  1643\\t    max_sk = 4 if Npad <= 64 else 1   # sk=2 @Npad128 measured no gain (enough work/block)\\n  1644\\t    sk = 1\\n  1645\\t    while sk < max_sk and base * sk * 2 <= 768 and tiles_k % (sk * 2) == 0:\\n  1646\\t        sk *= 2\\n  1647\\t    return sk\\n  1648\\t\\n  1649\\t\\n  1650\\tclass CompressedUBLBTBETensor:\\n  1651\\t    \