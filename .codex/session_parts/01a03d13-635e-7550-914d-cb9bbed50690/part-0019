, float* Cf32, int split_k,\n    const int* exc_idx, const uint16_t* exc_val, int num_exc,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<256, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<192, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<128, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<64, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        return err;\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// ChunkDelta3 RS-mode fused decode + GEMM.\n//\n// One 6