One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n// The matching base exponent is one byte per logical thread and sign/mantissa\n// is one raw byte per value.  Decode writes the reconstructed BF16 values\n// directly into the WGMMA register-A fragment, so no dense weight is emitted.\n//\n// CD3 exceptions are frequent enough on real weights that a sparse output\n// correction pass is a poor fit.  Instead each block expands only the current\n// tile's packed 17-bit exception records into a shared exponent override map\n// before constructing register A.  The WGMMA therefore consumes the exact\n// lossless weight, and split-K remains valid.\n// ============================================================================\ntemplate <int TileN, int Stages>\nstruct CD3RSSmem {\n    using SmemLayoutB = decltype(cute::tile_to_shape(\n        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n    alignas(16) uint8_t s_codes[Stages][1536];       // 4096 packed 3-bit codes\n    alignas(16) uint8_t s_sm[Stages][4096];          // raw sign|mantissa\n    alignas(16) uint8_t s_bases[Stages][256];        // base per 16-value chunk\n    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n    alignas(16) uint32_t s_exc_mask[Stages][128];    // one bit per tile value\n};\n\n__device__ __forceinline__ uint32_t cd3_unpack_entry17(\n    const uint8_t* entries, int64_t index)\n{\n    const int64_t bit = index * 17;\n    const int64_t byte = bit >> 3;\n    const int shift = static_cast<int>(bit & 7);\n    const uint32_t word = static_cast<uint32_t>(entries[byte])\n        | (static_cast<uint32_t>(entries[byte + 1]) << 8)\n        | (static_cast<uint32_t>(entries[byte + 2]) << 16);\n    return (word >> shift) & 0x1ffffu;\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void cd3_rs_kernel(\n    const uint8_t*       __restrict__ codes_g,\n    const uint8_t*       __restrict__ sm_g,\n    const uint8_t*       __restrict__ bases_g,\n    const int32_t*       __restrict__ tile_offsets_g,\n    const uint16_t*      __restrict__ warp_prefixes_g,\n    const uint8_t*       __restrict__ entries17_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid = static_cast<int>(threadIdx.x);\n    const int tile_n = static_cast<int>(blockIdx.x);\n    const int tile_m = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);\n    const int tk_split = tiles_k / split_k;\n    const int k0 = split_idx * tk_split;\n\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n                         make_coord(tile_n, _));\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    auto tiled_copy = make_tiled_copy(G2S{},\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n    auto thr_copy = tiled_copy.get_slice(tid);\n    auto tBgB = thr_copy.partition_S(gB);\n    auto tBsB = thr_copy.partition_D(sB);\n\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat