t int end = tile_offsets_g[tile_idx + 1];\n        smem.s_exc_mask[st][tid] = 0;\n        __syncthreads();\n        for (int e = begin + tid; e < end; e += 128) {\n            const int local = e - begin;\n            int warp = 0;\n            #pragma unroll\n            for (int w = 1; w < 8; ++w)\n                warp += local >= static_cast<int>(\n                    warp_prefixes_g[static_cast<int64_t>(tile_idx) * 8 + w]);\n            const uint32_t entry = cd3_unpack_entry17(entries17_g, e);\n            const int pos = warp * 512 + static_cast<int>(entry & 0x1ffu);\n            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 9);\n            atomicOr(&smem.s_exc_mask[st][pos >> 5], 1u << (pos & 31));\n        }\n        __syncthreads();\n    };\n\n    auto decode_regA = [&](int st) {\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrA); ++i) {\n            auto c = tCcA(i);\n            const int m = get<0>(c), k = get<1>(c);\n            const int owner = m * 4 + (k >> 4);\n            const int item = k & 15;\n            const int bit = item * 3;\n            const int byte = owner * 6 + (bit >> 3);\n            const int shift = bit & 7;\n            uint16_t packed = smem.s_codes[st][byte];\n            if (shift > 5)\n                packed |= static_cast<uint16_t>(smem.s_codes[st][byte + 1]) << 8;\n            const uint8_t code = static_cast<uint8_t>((packed >> shift) & 7u);\n            const int pos = m * 64 + k;\n            const bool is_exception =\n                (smem.s_exc_mask[st][pos >> 5] >> (pos & 31)) & 1u;\n            const uint8_t exp = is_exception\n                ? smem.s_exc_exp[st][pos]\n                : static_cast<uint8_t>(smem.s_bases[st][owner] + code);\n            const uint8_t smv = smem.s_sm[st][owner * 16 + item];\n            const uint16_t bits = static_cast<uint16_t>(\n                (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                (static_cast<uint16_t>(exp) << 7) |\n                static_cast<uint16_t>(smv & 0x7fu));\n            const __nv_bfloat16 value = __ushort_as_bfloat16(bits);\n            tCrA(i) = reinterpret_cast<const bfloat16_t&>(value);\n        }\n    };\n\n    CUTE_UNROLL\n    for (int s = 0; s < Stages - 1; ++s) {\n        if (s < tk_split) {\n            load_b(k0 + s, s);\n            load_compressed(k0 + s, s);\n        }\n        cp_async_fence();\n    }\n\n    for (int kk = 0; kk < tk_split; ++kk) {\n        cp_async_wait<Stages - 2>();\n        __syncthreads();\n\n        const int st = kk % Stages;\n        build_exception_map(k0 + kk, st);\n        decode_regA(st);\n        warpgroup_fence_operand(tCrA);\n        warpgroup_arrive();\n        gemm(tiled_mma, tCrA, tCrB(_, _, _, st), tCrC);\n        warpgroup_commit_batch();\n\n        const int knext = kk + Stages - 1;\n        if (knext < tk_split) {\n            load_b(k0 + knext, knext % Stages);\n            load_compressed(k0 + knext, knext % Stages);\n        }\n        cp_async_fence();\n\n        warpgroup_wait<0>();\n        __syncthreads();\n    }\n\n    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchCD3RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint16_t* warp_prefixes, const uint8_t* entries17,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\n        (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, bases, tile_offsets, warp_prefixes, entries17,\n        B, C, Cf32, M, N, K, split_k);\n    cudaError_t err = cudaGetLastError();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a042ab-5f37-73c2-b087-e56e5f7a02d1","create_time":1787827085.5925186}}}
