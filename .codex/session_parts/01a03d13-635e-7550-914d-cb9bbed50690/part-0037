{"timestamp":"2026-08-27T11:23:48.813Z","ordinal":3164,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042f6-3ccd-7103-9cfe-ddbf364dcc08","call_id":"call_hPYvmttLqqodR8GUjtIWBbUZ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Correctness coverage for the production ChunkDelta3 adapter.\"\"\"\nfrom __future__ import annotations\n\nimport pytest\nimport torch\nimport torch.nn.functional as F\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"ChunkDelta3 requires CUDA\")\n\n\ndef _codec():\n    from tiered_serve.compression.core.chunk_delta3 import ChunkDelta3Compressor\n    return ChunkDelta3Compressor(torch.cuda.current_stream())\n\n\ndef _all_bf16_patterns() -> torch.Tensor:\n    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    # Transpose so each 16-value CD3 chunk spans many exponents.  A plain\n    # reshape groups equal exponents and never exercises the exception stream.\n    return (bits.view(torch.bfloat16).reshape(256, 256).t().contiguous()\n            .cuda())\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a042ec-803c-78e2-a2ab-4e6f1fff5d4d","create_time":1787829828.8134952}}}
