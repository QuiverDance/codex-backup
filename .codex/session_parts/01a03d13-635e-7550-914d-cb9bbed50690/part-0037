{"timestamp":"2026-08-27T11:24:29.895Z","ordinal":3189,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a042f6-dd47-7fa0-801c-6f01d7b307d4","call_id":"call_UZMwy7sqYmHUa1ogfeuEHdVG","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n\n    def _compressor_for_mode(self, mode: str):\n        \"\"\"Return the weight compressor instance for a given residency mode.\n\n        ``frozen_split`` is routed to the split-tuned compressor; every\n        other mode that needs a compressor uses the offload one.  Falls\n        back to ``self.weight_compressor`` so this is safe to call even\n        before per-mode compressors are initialised (lazy paths).\n        \"\"\"\n        if mode == \"frozen_split\":\n            return self._compressor_split or self.weight_compressor\n        return self._compressor_offload or self.weight_compressor\n\n    def _compressor_for_cell(self, layer_id: int, comp_key: str,\n                             mode: \"Optional[str]\" = None):\n        \"\"\"Return the compressor instance to use for one (layer, component).\n\n        Honors per-cell compressor overrides from the YAML layer_residency\n        ``{mode, compressor}`` cells: when a cell pins ``compressor: X``,\n        we look up ``X`` in the per-backend pool (lazy-instantiating it\n        the first time) and return that instance.  Cells without an\n        explicit compressor fall through to the legacy\n        ``_compressor_for_mode`` behaviour.\n\n        ``mode`` is optional; when omitted, it's read from\n        ``self.torch_model.layer_weight_comp``.  Passing it explicitly\n        is a perf shortcut on hot paths that already have the mode.\n        \"\"\"\n        # Per-cell override has priority.\n        tm = getattr(self, \"torch_model\", None)\n        if tm is not None:\n            comps = getattr(tm, \"layer_weight_compressor\", None)\n            if comps is not None and 0 <= layer_id < len(comps):\n                backend = comps[layer_id].get(comp_key)\n                if backend is not None:\n                    return self._get_or_make_backend(backend)\n        # Fallback: legacy mode-based selection.\n        if mode is None and tm is not None:\n            mode = tm.layer_weight_comp[layer_id].get(comp_key, \"\")\n        return self._compressor_for_mode(mode or \"\")\n\n    def _get_or_make_backend(self, backend: str):\n        \"\"\"Lazy-instantiate (and memoise) a compressor for ``backend``.\n\n        Shares the split / offload instances when the requested\n        backend matches what was set up from env vars, so the pool\n        doesn't double-allocate the same codec's workspace.\n        \"\"\"\n        pool = getattr(self, \"_compressors_by_backend\", None)\n        if pool is None:\n            pool = {}\n            self._compressors_by_backend = pool\n        existing = pool.get(backend)\n        if existing is not None:\n            return existing\n        # Match against the split / offload instances created in __init__.\n        for slot in (self._compressor_split, self._compressor_offload):\n            if slot is None:\n                continue\n            # Each compressor wrapper has either ``_family`` (auto) or\n            # we infer the name from its class.  Match by either.\n            sb = (getattr(slot, \"_family\", None)\n                  or type(slot).__name__.lower())\n            if sb == backend or backend in sb:\n                pool[backend] = slot\n                return slot\n        # Build a fresh instance — same path as init-time backend choice.\n        instance = self._make_weight_compressor(backend, role=\"cell\")\n        pool[backend] = instance\n        return instance\n        DualMemoryLoader.use_weight_comp = use_weight_comp\n        # It's set on vLLM Scheduler when budget is less than half of num_batched_tokens\n        DualMemoryLoader.load_comp_weight = DualMemoryLoader.use_weight_comp\n\n        # Mantissa/Exponent split storage mode (Phase 0 plumbing).\n        # When on:\n        #   * weight backend is forced to dietgpu_bf16 upstream in the\n        #     entrypoint (sign|mant HBM + compressed exp LPDDR)\n        #   * kv backend is forced to \"mantexp\" upstream (handled below)\n        self.mantexp_split = os.getenv(\n            \"TIERED_SERVE_MANTEXP_SPLIT\", \"0\") == \"1\"\n        self.mantexp_split_weight = os.getenv(\n            \"TIERED_SERVE_MANTEXP_SPLIT_WEIGHT\", \"0\") == \"1\"\n        self.mantexp_split_kv = os.getenv(\n            \"TIERED_SERVE_MANTEXP_SPLIT_KV\", \"0\") == \"1\"\n        DualMemoryLoader.mantexp_split = self.mantexp_split\n        DualMemoryLoader.mantexp_split_weight = self.mantexp_split_weight\n        DualMemoryLoader.mantexp_split_kv = self.mantexp_split_kv\n        if self.mantexp_split:\n            logger.info(\n                \"[mantexp-split] enabled: weight_split=%s, kv_split=%s\",\n                self.mantexp_split_weight, self.mantexp_split_kv)\n\n        # Per-mode weight compressors.\n        #   * ``_compressor_split``   — used for frozen_split (sign+mantissa\n        #     stays on HBM, only exponent decoded per forward; favours low\n        #     decomp latency).\n        #   * ``_compressor_offload`` — used for offload_compressed and\n        #     frozen_compressed (full compressed weight transferred each\n        #     forward; favours compression ratio).\n        # ``self.weight_compressor`` is kept as a backward-compat alias for\n        # the offload variant so legacy call sites and external references\n        # (e.g. ``cache_loader.weight_compressor``) keep working when both\n        # modes select the same backend.\n        self._compressor_split = None\n        self._compressor_offload = None\n        self.weight_compressor = None\n        if DualMemoryLoader.use_weight_comp:\n            base_backend = os.getenv(\n                \"TIERED_SERVE_WEIGHT_COMP_BACKEND\", \"zipserv\").lower()\n            split_backend = os.getenv(\n                \"TIERED_SERVE_SPLIT_COMP_BACKEND\", base_backend).lower()\n            # Remember the frozen_split primary (decode) codec so the\n            # prefill-alt default can \"unify\" to it: alt == primary unless\n            # TIERED_SERVE_PREFILL_ALT_BACKEND explicitly overrides it.\n            self._split_backend = split_backend\n            offload_backend = os.getenv(\n                \"TIERED_SERVE_OFFLOAD_COMP_BACKEND\", base_backend).lower()\n            # Remember the offload codec so offload_compressed prefill can key\n            # its (mode-distinct) compress-on-small-chunk threshold by codec.\n            self._offload_backend = offload_backend\n            self._compressor_split = self._make_weight_compressor(\n                split_backend, role=\"split\")\n            if offload_backend == split_backend:\n                # Same backend → share a single instance.  Saves an entire\n                # set of workspace buffers / CUDA streams and avoids two\n                # ZipServ ext managers fighting over the same resources.\n                self._compressor_offload = self._compressor_split\n            else:\n                self._compressor_offload = self._make_weight_compressor(\n                    offload_backend, role=\"offload\")\n            # Legacy alias.  Most call sites that used self.weight_compressor\n            # directly were dealing with offload/frozen_compressed paths; we\n            # alias to the offload compressor so they keep behaving the\n            # same when the user supplies only the base flag.\n            self.weight_compressor = self._compressor_offload\n\n        env_var_value = os.getenv(\"TIERED_SERVE_USE_KV_COMP\")\n        use_kv_comp = env_var_value is not None and env_var_value == \"1\"\n        DualMemoryLoader.no_offload_kv = (\n            os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n        if DualMemoryLoader.no_offload_kv:\n            # KV stays fully resident in GPU HBM: disable offload + KV\n            # compression entirely (weights are still offloaded).\n            use_kv_comp = False\n        DualMemoryLoader.use_kv_comp = use_kv_comp\n        DualMemoryLoader.kv_full_block_only = False\n\n        self.kv_compressor = None\n        if DualMemoryLoader.use_kv_comp:\n            kv_comp_backend = os.getenv(\n                \"TIERED_SERVE_KV_COMP_BACKEND\", \"zipserv\").lower()\n            if kv_comp_backend not in (\n                    \"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\", \"p4flatcpu\",\n                    \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_BACKEND: \"\n                    f\"{kv_comp_backend!r}. Expected one of: \"\n                    f\"zipserv, dietgpu, mantexp, p4flat, p4flatcpu, \"\n                    f\"bitcomp, bitcompcpu, ublb_flat, ublb_tbe.\")\n\n                src = self.comp_secondary_buffers[layer_id]\n                return src.get(tensor_name) if src else None\n            else:\n                src = self.secondary_buffers[layer_id]\n                return src.get(tensor_name) if src else None\n\n    def decompress_frozen_weight(self, layer_id: int):\n        \"\"\"Decompress frozen compressed weights into the shared decompression buffer.\"\"\"\n        comp_data = self.frozen_comp_buffers[layer_id]\n        if comp_data is None:\n            return\n        with torch.cuda.stream(self.decomp_weight_stream):\n            # BEGIN marker for the time-breakdown diagnostic.  This\n            # path runs all components in one batch, so we pair against\n            # the \"qkv\" END slot below to give the breakdown a single\n            # (begin,end) interval covering the whole layer's decomp.\n            if hasattr(self, \"begin_frozen_decomp_events\"):\n                self.begin_frozen_decomp_events[\"qkv\"][layer_id].record(\n                    self.decomp_weight_stream)\n            for name, comped in comp_data.items():\n                self.weight_compressor.decompress(comped)\n            self.frozen_decomp_event.record(self.decomp_weight_stream)\n            # Mirror the whole-layer interval into the \"qkv\" per-comp\n            # END slot so the time-breakdown picks it up (pipelined\n            # paths fill all four slots; this path only fills \"qkv\").\n            if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                self.end_frozen_decomp_timing_events[\"qkv\"][\n                    layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen compressed weights with per-component events.\n\n        Unlike decompress_frozen_weight which records a single event after\n        all tensors, this records per-component events so exec_stream can\n        start each matmul as soon as its specific tensor is ready.\n\n        Honors per-cell compressor overrides from the YAML\n        ``layer_residency`` ``{mode, compressor}`` cells: each\n        component's decomp instance is looked up via\n        ``_compressor_for_cell``.  Cells without an override fall\n        through to the legacy global ``weight_compressor``.\n        \"\"\"\n        comp_data = self.frozen_comp_buffers[layer_id]\n        if comp_data is None:\n            return\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                if hasattr(self, \"begin_frozen_decomp_events\"):\n                    self.begin_frozen_decomp_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n                comp = self._compressor_for_cell(\n                    layer_id, comp_key, mode=\"frozen_compressed\")\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    comped = comp_data.get(name)\n                    if comped is not None:\n                        comp.decompress(comped)\n                self.frozen_decomp_events[comp_key][layer_id].record(\n                    self.decomp_weight_stream)\n                if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                    self.end_frozen_decomp_timing_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path stays event-light.\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                # WDecomp timing for the split path is recorded tightly\n                # around each _frozen_split_run_decompress kernel below\n                # (AFTER its H2D wait_event), NOT here.  The old coarse\n                # per-comp_key begin/end straddled every tensor's (and\n                # pipelined group's) H2D wait_event, so WDecomp absorbed the\n                # LPDDR->HBM load-wait bubble — already counted in WLoad —\n                # and read ~= GPUFwd while Compute looked tiny.  Per-kernel\n                # intervals are unioned into WDecomp via\n                # frozen_split_decomp_intervals; the load-wait now correctly\n                # surfaces as Stall.  (begin/end_frozen_decomp_events stay\n                # for the frozen_compressed path, which has no separate H2D.)\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    info = split_data.get(name)\n                    if info is None:\n                        continue\n                    staging = self.frozen_split_staging[name][staging_parity]\n                    output = self.frozen_primary_buffer_pair[name][output_parity]\n                    backend_compressor = self._resolve_backend_compressor(\n                        info, layer_id, comp_key)\n\n                    if is_prefill:\n\nif [[ $# -gt 0 ]]; then\n    CONFIGS=(\"$@\")\nelse\n    CONFIGS=(\"flexgen\" \"flexgen-comp\" \"cao-zs\" \"cao-zs-fused\" \\\n             \"cao-p4\" \"cao-p4-fused\" \"cao-p4-kvcomp\" \"cao-zs-kvcomp\")\nfi\n\n# config별 서버 플래그 (weight-comp 백엔드 / --fused-mm / --kv-comp 조합).\n# --weight-comp 백엔드는 config YAML 안에 박힌 per-layer compressor 와 일치해야 한다\n#   cao-zs* → zipserv, cao-p4* → p4flat (cao-*-kvcomp 도 동일 규칙).\ndeclare -A CFG_FLAGS=(\n    [flexgen]=\"--weight-comp zipserv\"\n    [flexgen-comp]=\"--weight-comp zipserv\"\n    [cao-zs]=\"--weight-comp zipserv\"\n    [cao-zs-fused]=\"--weight-comp zipserv --fused-mm\"\n    [cao-zs-kvcomp]=\"--weight-comp zipserv --fused-mm --kv-comp ublb_flat\"\n    [cao-p4]=\"--weight-comp p4flat\"\n    [cao-p4-fused]=\"--weight-comp p4flat --fused-mm\"\n    [cao-p4-kvcomp]=\"--weight-comp p4flat --fused-mm --kv-comp ublb_flat\"\n)\n\nfor cfg in \"${CONFIGS[@]}\"; do\n    # 클라이언트에 현재 config 전달 → 결과가 config별 디렉토리로 저장됨\n    CLIENT_CMD=\"bash scripts/serving/client/${CLIENT_SCRIPT}.sh $MODEL_ALIAS $cfg\"\n\n    # config별 서버 플래그 결정 (미등록 config 는 zipserv weight-comp 기본)\n    EXTRA_FLAGS=\"${CFG_FLAGS[$cfg]:-}\"\n    if [[ -z \"$EXTRA_FLAGS\" ]]; then\n        echo \"[!] '$cfg' 에 대한 플래그 매핑 없음 → 기본 '--weight-comp zipserv' 사용\"\n        EXTRA_FLAGS=\"--weight-comp zipserv\"\n    fi\n\n    echo \"\"\n    echo \"==========================================\"\n    echo \"  Config: $cfg\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a042ec-803c-78e2-a2ab-4e6f1fff5d4d","create_time":1787829869.8956563}}}
