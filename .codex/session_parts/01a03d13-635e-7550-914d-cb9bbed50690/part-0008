# from_numpy-views it), and the memo REPLACES (never mutates) the cached\n        # array, so an in-flight worker from a prior step keeps its own copy.\n        if (block_ids is getattr(self, \"_fh_filter_key\", None)\n                and n_off == getattr(self, \"_fh_filter_noff\", -1)):\n            bid_arr = self._fh_filter_arr\n        else:\n            bid_arr = np.asarray(block_ids, dtype=np.int64)\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': bid_arr,\n            'physical_slots': physical_slots,\n        }\n\n    def _launch_group(self, host_k, host_v, gpu_k, gpu_v,\n                      gids_arr, gslots, valid_tm: int) -> bool:\n        \"\"\"Compress one occupancy group: gather its blocks' valid_rows prefix\n        into a stack and store K and V.  ``gids_arr``/``gslots`` are numpy.\"\"\"\n        M_b, K_b = self._M_b, self._K_b\n        valid_rows = valid_tm * 64\n        g = int(gids_arr.shape[0])\n        gids = torch.as_tensor(gids_arr, device=gpu_k.device)   # numpy -> GPU\n        k_stack = (gpu_k[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        v_stack = (gpu_v[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        k_secondary = self._store_stack(\n            host_k, gslots, k_stack, g, valid_tm)\n        v_secondary = self._store_stack(\n            host_v, gslots, v_stack, g, valid_tm)\n        return k_secondary or v_secondary\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        state = self._pending_compress.pop(layer_id, None)\n        if state is not None:\n            state['event'].synchronize()\n            buffer_ids = state['buffer_ids']\n            pv = self._persistent_valid[layer_id]\n            # Vectorized mark-valid (avoids a per-block bytearray write lo