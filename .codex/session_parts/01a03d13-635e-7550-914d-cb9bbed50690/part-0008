or(TensorCompressor):\n    \"\"\"Common production-interface adapter for both native codecs.\"\"\"\n\n    HAS_FUSED_MM = False\n    codec_name = \"\"\n    compressed_type = _CompressedTP3CD3Tensor\n\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\n        super().__init__(comp_stream)\n        if not _HAS_TP3_CD3:\n            raise RuntimeError(\n                f\"{type(self).__name__} requires tp3_cd3_ext to build \"\n                \"successfully\")\n\n    def _native_compress(self, weight: torch.Tensor):\n        raise NotImplementedError\n\n    def _native_decompress(self, compressed, output: torch.Tensor):\n        raise NotImplementedError\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[_CompressedTP3CD3Tensor] = None,\n        _sync: bool = True,\n    ) -> _CompressedTP3CD3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"{type(self).__name__} expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"{type(self).__name__} expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\n                f\"{type(self).__name__}.compress requires a CUDA tensor\")\n        if weight.shape[0] % 64 or weight.shape[1] % 64:\n            raise ValueError(\n                f\"{type(self).__name__} requires dimensions divisible by 64, \"\n                f\"got {tuple(weight.shape)}\")\n\n        source = weight.contiguous()\n        with torch.cuda.stream(self.comp_stream):\n            native = self._native_compress(source)\n        if _sync:\n            # The final exception-pack kernel is enqueued after the native\n            # count readback.  Complete it before exposing the compressed\n            