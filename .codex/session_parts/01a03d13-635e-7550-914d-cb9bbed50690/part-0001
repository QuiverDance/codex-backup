able_timing=True)\n+    samples: list[float] = []\n+    for _ in range(runs):\n+        begin.record()\n+        call()\n+        end.record()\n+        end.synchronize()\n+        samples.append(begin.elapsed_time(end))\n+    return float(torch.tensor(samples).median().item())\n+\n+\n+def all_bf16_patterns() -> torch.Tensor:\n+    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n+    return bits.view(torch.bfloat16).reshape(256, 256).cuda()\n+\n+\n+def main() -> None:\n+    args = parse_args()\n+    extension = load_extension(args.extension.resolve())\n+    source = all_bf16_patterns()\n+    tile_palette3 = extension.compress_tile_palette3(source)\n+    chunk_delta3 = extension.compress_chunk_delta3(source)\n+    tile_output = torch.empty_like(source)\n+    chunk_output = torch.empty_like(source)\n+\n+    tile_call = lambda: extension.decompress_tile_palette3(\n+        tile_palette3, tile_output\n+    )\n+    chunk_call = lambda: extension.decompress_chunk_delta3(\n+        chunk_delta3, chunk_output\n+    )\n+    tile_call()\n+    chunk_call()\n+    torch.cuda.synchronize()\n+    correctness = {\n+        \"tile_palette3\": exact(tile_output, source),\n+        \"chunk_delta3\": exact(chunk_output, source),\n+    }\n+    if not all(correctness.values()):\n+        raise AssertionError(f\"bit-exact check failed: {correctness}\")\n+\n+    result = {\n+        \"gpu\": torch.cuda.get_device_name(),\n+        \"compute_capability\": list(torch.cuda.get_device_capability()),\n+        \"torch\": torch.__version__,\n+        \"cuda\": torch.version.cuda,\n+        \"all_65536_bf16_patterns_bit_exact\": correctness,\n+        \"tile_palette3\": {\n+            \"compressed_bytes\": tile_palette3.nbytes,\n+            \"compression_ratio_x\": source.nbytes / tile_palette3.nbytes,\n+            \"num_exceptions\": tile_palette3.num_exceptions,\n+            \"frozen_hbm_bytes\": tile_palette3.frozen_hbm_bytes,\n+            \"frozen_transfer_bytes\": tile_pa