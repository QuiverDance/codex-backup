 frozen_split_dict: Dict[str, SplitStorageInfo] = {}\n\n            for name in self.tensor_names:\n                comp_key = self.tensor_to_component.get(name)\n                raw_mode = (\n                    self.layer_weight_comp[idx].get(\n                        comp_key, \"offload\")\n                    if comp_key else \"offload\")\n                mode = self._effective_mode(raw_mode, is_frozen)\n\n                leaf_name, _, tensor_name = name.rpartition(\".\")\n                leaf_module = blk.module.get_submodule(leaf_name)\n                target: torch.Tensor = getattr(\n                    leaf_module, tensor_name, None)\n                if target is None:\n                    raise RuntimeError(\n                        f\"Can't find {name} in {blk.module._get_name()}\")\n\n                if mode == \"offload\":\n                    # Always store uncompressed copy in DRAM.\n                    # After UVA conversion the param.data is a cuda view;\n                    # prefer the original CPU hugepage tensor stored by\n                    # immigrant_model_loader so secondary→primary copies\n                    # are proper H2D transfers.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n                    # When USE_WEIGHT_COMP=1, also store compressed copy\n                    if DualMemoryLoader.use_weight_comp:\n                        logger.info(\n                            f\"Compressing Decoder-{idx}.{name}\")\n                        with torch.cuda.stream(\n                                self.decomp_weight_stream):\n                            comped = self._compressor_for_cell(\n                                idx, comp_key, mode=mode).compress(\n                                target,\n                                temp_buffers[buffer_id][name])\n                            torch.cuda.synchronize()\n                            logger.info(\n                                f\"Decoder-{idx}.{name}: \"\n                                f\"Compression Ratio: \"\n                                f\"{target.nbytes/comped.nbytes:.2f}x\")\n                            comped.to_host(self.huge_page_allocator)\n                        comp_dict[name] = comped\n\n                elif mode == \"offload_uncompressed\":\n                    # Always store uncompressed in DRAM; skip compression\n                    # even when USE_WEIGHT_COMP=1.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n\n                elif mode == \"offload_compressed\":\n                    # Always store compressed in DRAM; also keep uncompressed\n                    # copy so prefill can bypass decompression.\n                    # Decompressed to primary buffer at inference time.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = target.data\n                    else:\n                        uncomp_dict[name] = target\n                    logger.info(\n                        f\"Compressing (offload_compressed) Decoder-{idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        comped = self._compressor_for_cell(\n                            idx, comp_key, mode=mode).compress(\n                            target,\n                            temp_buffers[buffer_id][name])\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: \"\n                            f\"Compression Ratio: \"\n                            f\"{target.nbytes/comped.nbytes:.2f}x\")\n                        comped.to_host(self.huge_page_allocator)\n                    comp_dict[name] = comped\n\n                elif mode == \"frozen_compressed\":\n                    # Compress on GPU, keep compressed data on GPU.\n                    # Weight may arrive in CPU hugepage (moved there during\n                    # load_weights to prevent HBM exhaustion when total frozen\n                    # weights exceed GPU capacity, e.g. GH200 unified memory).\n                    # After UVA conversion hugepage tensors report\n                    # device.type==\"cuda\", so check _on_hugepage to\n                    # distinguish genuine GPU tensors from UVA views.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing \"\n                        f\"{'Frozen' if is_frozen else 'FrozenCompressed'}\"\n                        f\" Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            # Copy weight into frozen_primary_buffer on\n                            # the same stream as compress to guarantee\n                            # ordering. On GH200, a copy from UVA\n                            # hugepages on the default stream may not be\n                            # visible to decomp_weight_stream without\n                            # explicit synchronization.\n                            gpu_target.copy_(target, non_blocking=False)\n                        comped = self._compressor_for_cell(\n                            idx, comp_key, mode=mode).compress(\n                            gpu_target, primary)\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: Compression Ratio: \"\n                            f\"{gpu_target.nbytes/comped.nbytes:.2f}x\")\n\n                    # Free the CPU hugepage source after compression.\n                    # After UVA conversion, target.data_ptr() is the\n                    # CUDA device pointer, not the CPU hugepage ptr\n                    # that the allocator tracks.  Use the original CPU\n                    # tensor stored by the model loader so the free\n                    # actually finds the allocation.\n                    if gpu_target is not target:\n                        cpu_data = getattr(target, '_tiered_serve_cpu_data',\n                                           target)\n                        self.huge_page_allocator.free(cpu_data)\n\n                    frozen_comp_dict[name] = comped\n\n                    # Redirect module param to this layer's parity-specific\n                    # decomp buffer (even layers→buf0, odd→buf1).  Bound\n                    # ONCE here at init; never reassigned, so the V1\n                    # piecewise CUDA graph can capture a stable pointer.\n                    delattr(leaf_module, tensor_name)\n                    setattr(leaf_module, tensor_name,\n                            torch.nn.Parameter(\n                                primary,\n                                requires_grad=False))\n\n                    # Install fused decompress+GEMM override if the user\n                    # enabled --fused-mm and the bound compressor exposes\n                    # a native fused kernel.  With fused_mm the dense\n                    # decompress kernel is skipped (see\n                    # decompress_frozen_tensors); the compressed buffer\n                    # is permanent HBM so no H2D is needed either.\n                    self._maybe_install_fused_mm(\n                        leaf_module, comped,\n                        self._compressor_for_cell(idx, comp_key, mode=mode),\n                        layer_id=idx,\n                        comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                        mode=\"frozen_compressed\", tensor_name=name)\n\n                elif mode == \"frozen_split\":\n                    # Compress on GPU, keep sign_mantissa on HBM,\n                    # move remaining buffers to LPDDR hugepage.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing FrozenSplit Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            gpu_target.copy_(target, non_blocking=False)\n                        # Per-cell backend: the resulting CompressedTensor\n                        # type sets SplitStorageInfo.backend below, and the\n                        # decode reconstruct (_resolve_backend_compressor)\n                        # re-derives the SAME per-cell instance, so compress\n                        # and reconstruct stay matched.\n                        if self._frozen_raw_exp:\n                            comped = RawExpCompressed.from_weight(gpu_target)\n                        else:\n                            comped = self._compressor_for_cell(\n                                idx, comp_key, mode=mode).compress(\n                                gpu_target, primary)\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: Compression Ratio: \"\n                            f\"{gpu_target.nbytes/comped.nbytes:.2f}x\")\n\n                    # sign_mantissa stays on GPU.  ZipServ FP8 keeps its\n                    # tensor fields nested under ``comped._c``; everything\n                    # else exposes them on ``comped`` directly. P3-flat FP8\n                    # stores the HBM-resident half-byte stream as\n                    # ``sm_nibbles`` (no separate sign_mantissa byte).\n                    if isinstance(comped, CompressedP3FlatFP8Tensor):\n                        hbm_sm = comped.sm_nibbles.clone()\n                    elif isinstance(comped, CompressedUBLBFlatTensor):\n                        # UBLB-flat: the raw lower byte stays on HBM (the\n                        # sign_mantissa analog); code_stream/palette/exc ship\n                        # to LPDDR.  Stored generically as ``sign_mantissa``.\n                        hbm_sm = comped.lb_raw.clone()\n                    else:\n                        sm_src = (comped._c\n                                  if isinstance(comped, CompressedZipServFP8GpuTensor)\n                                  else comped)\n                        hbm_sm = sm_src.sign_mantissa.clone()\n\n                    # Backend-specific LPDDR layout\n                    if isinstance(comped, RawExpCompressed):\n                        backend = \"raw_exp\"\n                        lpddr_attrs = (\"raw_exp\",)\n                        metadata = {\"M\": comped.M, \"K\": comped.K}\n                    elif isinstance(comped, CompressedDietGPUTensor):\n                        backend = \"dietgpu\"\n                        # raw-exp mode: ship the uncompressed exp (M*K) instead\n                        # of the ANS-compressed stream so decode can merge-only.\n                        lpddr_attrs = (\n                            (\"raw_exp\",)\n                            if (os.getenv(\"TIERED_SERVE_FROZEN_RAW_EXP\", \"0\")\n                                == \"1\" and comped.raw_exp is not None)\n                            else SplitStorageInfo._DIETGPU_LPDDR_ATTRS)\n                        metadata = {\n                            \"exp_compressed_size\": comped.exp_compressed_size,\n                            \"M\": comped.M,\n                            \"K\": comped.K,\n                        }\n                    elif isinstance(comped, CompressedDietGPUFP8Tensor):\n                        backend = \"dietgpu_fp8\"\n                        lpddr_attrs = SplitStorageInfo._DIETGPU_FP8_LPDDR_ATTRS\n                        metadata = {\n                            \"exp_compressed_size\": comped.exp_compressed_size,\n                            \"M\": comped.M,\n                            \"K\": comped.K,\n                            \"fp8_kind\": comped.fp8_kind,\n                            \"sm_nibble_packed\": comped.sm_nibble_packed,\n                            \"exp_nibble_packed\": comped.exp_nibble_packed,\n                        }\n                    elif isinstance(comped, CompressedZipServFP8GpuTensor):\n                        # CompressedZipServFP8GpuTensor wraps a native struct\n                        # at ``comped._c``; lift its tensor fields out for\n                        # split storage.\n                        c = comped._c\n                        backend = \"zipserv_fp8\"\n                        lpddr_attrs = SplitStorageInfo._ZIPSERV_FP8_LPDDR_ATTRS\n                        metadata = {\n                            \"M\": int(c.M),\n                            \"K\": int(c.K),\n                            \"total_high_freq\": int(c.total_high_freq),\n                            \"total_full\": int(c.total_full),\n                            \"start_exp\": int(c.start_exp),\n                            \"num_bitmaps\": int(c.num_bitmaps),\n                            \"num_tiles\": int(c.num_tiles),\n                            \"num_groups\": int(c.num_groups),\n                            \"fp8_kind\": comped.fp8_kind,\n                        }\n                    elif isinstance(comped, CompressedP4FlatTensor):\n                        # P4-flat: sign_mantissa stays HBM; headers + codes +\n                        # exception list (insertion order + sorted-by-m\n                        # metadata for fused MM) all ship to LPDDR so the\n                        # frozen_split fused_mm path can rebuild the shell.\n                        backend = \"p4flat\"\n                        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n                        metadata = {\n                            \"M\": int(comped.M),\n                            \"K\": int(comped.K),\n                            \"num_exceptions\": int(comped.num_exceptions),\n                            \"num_groups\": int(comped.num_groups),\n                        }\n                    elif isinstance(comped, CompressedChunkDelta3Tensor):\n                        # Keep this branch routed through the shared backend\n                        # descriptor so init and runtime reconfiguration cannot\n                        # disagree about which CD3 buffers belong in LPDDR.\n                        backend, lpddr_attrs, metadata = (\n                            self._frozen_split_backend_meta(comped))\n                    elif isinstance(comped, CompressedUBLBFlatTensor):\n                        # UBLB-flat: lb_raw stays HBM (hbm_sm above); the\n                        # nibble-packed codes + palette + (idx, ub) exception\n                        # list ship to LPDDR.  Decode = flat_decode + flat_patch.\n                        backend = \"ublb_flat\"\n                        lpddr_attrs = SplitStorageInfo._UBLB_FLAT_LPDDR_ATTRS\n                        metadata = {\n                            \"M\": int(comped.M),\n                            \"K\": int(comped.K),\n                            \"num_exceptions\": int(comped.exc_idx.numel()),\n                        }\n                    elif isinstance(comped, CompressedP4D16Tensor):\n                        # P4-D16 (Global-P4-D16): sign_mantissa stays HBM;\n                        # the 16-byte global palette + tile-major markers +\n                        # codes + (idx, val) exception list ship to LPDDR.\n                        backend = \"p4d16\"\n                        lpddr_attrs = SplitStorageInfo._P4D16_LPDDR_ATTRS\n                        metadata = {\n                            \"M\": int(comped.M),\n                            \"K\": int(comped.K),\n                            \"num_exceptions\": int(comped.num_exceptions),\n                        }\n                    elif isinstance(comped, CompressedP3FlatFP8Tensor):\n                        # P3-flat FP8 e4m3: sm_nibbles stays HBM (the FP8\n                        # analog of P4-flat's sign_mantissa byte stream,\n                        # just nibble-packed); per-tile palette headers +\n                        # codes + tile_exc_offsets + exc_exp_nibbles ship\n                        # to LPDDR.\n                        backend = \"p3flat_fp8\"\n                        lpddr_attrs = SplitStorageInfo._P3FLAT_FP8_LPDDR_ATTRS\n                        metadata = {\n                            \"M\": int(comped.M),\n                            \"K\": int(comped.K),\n                            \"num_exceptions\": int(comped.num_exceptions),\n                        }\n                    else:\n                        backend = \"zipserv\"\n                        lpddr_attrs = SplitStorageInfo._ZIPSERV_LPDDR_ATTRS\n                        metadata = {\n                            \"max_high_freq_count\": comped.max_high_freq_count,\n                            \"max_full_count\": comped.max_full_count,\n                            \"start_exp\": comped.start_exp,\n                            \"M\": comped.M,\n                            \"K\": comped.K,\n                        }\n\n                    # Move auxiliary buffers + raw_bf16 to LPDDR hugepage.\n                    #\n                    # raw_bf16 is the full uncompressed BF16 copy used by\n                    # the prefill fast path: prefill H2Ds it directly into\n                    # the output buffer, with no reconstruct kernel and no\n                    # GPU-side staging slot.  The legacy raw_exp path\n                    # (M*K uint8 + Triton reconstruct kernel) is no longer\n                    # generated — the GPU staging slot it required was\n                    # ~1.27 GiB on Qwen-110B, and the LPDDR footprint\n                    # difference (raw_bf16 = 2·M*K vs raw_exp = M*K) is\n                    # offset by removing the reconstruct kernel from the\n                    # prefill critical path entirely.\n                    lpddr_bufs: Dict[str, torch.Tensor] = {}\n                    attrs_to_ship = tuple(lpddr_attrs) + (\"raw_bf16\",)\n                    # ZipServ FP8 keeps its tensor fields nested under\n                    # comped._c; everything else exposes them on comped.\n                    src_obj = (comped._c\n                               if backend == \"zipserv_fp8\"\n                               else comped)\n                    for attr in attrs_to_ship:\n                        if attr == \"raw_bf16\":\n                            # gpu_target is contiguous and already in the\n                            # weight's native dtype (BF16 or FP8); reuse it\n                            # directly — no extra GPU allocation.  The\n                            # buffer key is kept as ``raw_bf16`` for\n                            # backwards-compat with downstream lookups even\n                            # when the dtype is FP8.\n                            gpu_buf = gpu_target\n                        else:\n                            gpu_buf = getattr(src_obj, attr)\n                            # DietGPU's compressed_exp may be over-allocated;\n                            # slice to the actual compressed size.\n                            if (backend in (\"dietgpu\", \"dietgpu_fp8\")\n                                    and attr == \"compressed_exp\"):\n                                gpu_buf = gpu_buf[:comped.exp_compressed_size]\n                        # Allocate hugepage first and D2H directly into\n                        # it — avoids materializing a transient pageable\n                        # CPU copy (gpu_buf.cpu()) which on GH200 ends\n                        # up as a large pinned allocation that counts\n                        # against the GPU process budget.\n                        gpu_buf = gpu_buf.contiguous()\n                        hp_t = self.huge_page_allocator.allocate(\n                            gpu_buf.shape, gpu_buf.stride(),\n                            gpu_buf.dtype, page_type=\"weight\")\n                        hp_t.copy_(gpu_buf)\n                        lpddr_bufs[attr] = hp_t\n\n                    # HBM-resident auxiliary buffers (ZipServ tile_offsets):\n                    # cloned onto HBM, never shipped to LPDDR, so the decode\n                    # H2D only moves the bulk codec payload.\n                    hbm_attrs = SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n                        backend, ())\n                    hbm_bufs = self._build_frozen_split_hbm_bufs(\n                        src_obj, hbm_attrs)\n\n                    # Canonical shared sm: when a DISTINCT prefill-alt codec is\n                    # enabled (e.g. p4flat), store ONE (M,K) row-major\n                    # all-element sign|mantissa on HBM (