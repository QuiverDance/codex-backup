RuntimeError(\"Not Supported Primary Device:\", primary_device)\n\n        secondary_device = os.environ[\"TIERED_SERVE_SECONDARY_DEVICE\"].lower()\n        if not (\"cuda\" in secondary_device or \"cpu\" in secondary_device):\n            raise RuntimeError(\"Not Supported Secondary Device:\", secondary_device)\n\n        cuda_device = torch.device(primary_device)\n        scheduler_config = vllm_config.scheduler_config\n\n        with set_default_torch_dtype(model_config.dtype):\n            # Use 'meta' device to avoid allocating ~140 GB of regular CPU\n            # memory upfront.  Parameters are materialised below directly on\n            # hugepages (offloaded) or CUDA (frozen), so peak RSS stays low.\n            with torch.device('meta'):\n                model = initialize_model(\n                    vllm_config=vllm_config,\n                    model_config=model_config,\n                )\n\n            model.full_path = \"\"\n            set_every_module_full_path(model)\n            model.name = os.environ[\"TIERED_SERVE_MODEL_ID\"]\n\n            torch_model = TorchModel(\n                model,\n                make_context(\n                    model,\n                    os.environ[\"TIERED_SERVE_MODULE_BLOCK_CONFIG_PATH\"],\n                ),\n            )\n            self.torch_model = torch_model\n            model.torch_model = torch_model\n            if hasattr(model, 'model'):\n                model.model.torch_model = torch_model\n            model.phase = 0\n\n            # ---- Materialise parameters from meta device ----\n            # Offloaded weights → hugepages (no regular-CPU allocation)\n            # Frozen / non-layer weights → CUDA\n            from tiered_serve.huge_page_allocator import allocator\n\n            def _set_module_param(mod, attr, new_tensor, param):\n                \"\"\"Replace a meta parameter with a real one, preserving the\n                original parameter class (e.g. BasevLLMParameter) so that\n       