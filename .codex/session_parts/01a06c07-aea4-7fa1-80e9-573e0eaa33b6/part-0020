                 p4flat,cd3 (default: p4flat,cd3)\n  --modes LIST                  raw,kvcomp (default: raw,kvcomp)\n  --chunks LIST                 Comma-separated max_num_batched_tokens\n                                (default: 2048,4096,8192)\n  --request-rates LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 1)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --stop-after-request N        Stop after send-order requests 1..N have all\n                                completed. Later requests keep arriving until\n                                then and are cancelled at the boundary. Use\n                                1100 to preserve the default 1200/100/100\n                                measurement window; 0 waits for all (default)\n  --breakdown                   Record diagnostic timing for every server\n                                forward (instrumented; client perf is invalid)\n  --smoke                       Run two requests without percentile trimming;\n                                validates startup and request handling only\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --codecs cd3\n  scripts/serving/run_performance_suite.sh --codecs p4flat,cd3 --chunks 8192\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --stop-after-request 1100\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\n  scripts/serving/run_performance_suite.sh --chunks 8192 --breakdown\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --codecs)\n      (($# >= 2)) || die \"--codecs requires a value\"\n      parse_csv \"$2\" CODECS\n      shift 2\n      ;;\n    --modes)\n      (($# >= 2)) || die \"--modes requires a value\"\n      parse_csv \"$2\" MODES\n      shift 2\n      ;;\n    --chunks)\n      (($# >= 2)) || die \"--chunks requires a value\"\n      parse_csv \"$2\" CHUNKS\n      shift 2\n      ;;\n    --request-rates)\n      (($# >= 2)) || die \"--request-rates requires a value\"\n      parse_csv \"$2\" REQUEST_RATES\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --max-num-seqs)\n      (($# >= 2)) || die \"--max-num-seqs requires a value\"\n      MAX_NUM_SEQS=\"$2\"\n      shift 2\n      ;;\n    --dedicated-kv-blocks)\n      (($# >= 2)) || die \"--dedicated-kv-blocks requires a value\"\n      DEDICATED_KV_BLOCKS=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --weight-buffers)\n      (($# >= 2)) || die \"--weight-buffers requires a value\"\n      WEIGHT_BUFFERS=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\ndone\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\