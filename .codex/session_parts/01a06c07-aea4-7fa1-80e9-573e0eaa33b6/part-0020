{"timestamp":"2026-09-04T13:17:56.294Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c91-98c6-7982-ba61-878bd3a6b631","call_id":"call_Vqs6woeRhRtLJYgEWxTVynEB","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import os\nimport mmap\nimport ctypes\nimport logging\nimport math\nimport torch\nimport atexit\nimport threading\n\nimport cupy\n\nfrom tiered_serve.cpp_exts import huge_page_allocator_ext\n\nlogger = logging.getLogger(__name__)\n\n\nclass HugePageAllocator:\n    _instance = None\n    _lock = threading.Lock()\n\n    def __new__(cls, *args, **kwargs):\n        # 여러 스레드/프로세스에서의 동시 접근을 막기 위해 lock을 사용합니다.\n        if cls._instance is None:\n            with cls._lock:\n                # lock을 획득한 후 다시 한번 인스턴스 존재 여부를 확인합니다.\n                if cls._instance is None:\n                    cls._instance = super().__new__(cls)\n        return cls._instance\n\n    def __init__(\n            self,\n            total_num_pages: int,\n            n_weight_pages=8,\n            hugepage_dir=\"/mnt/hugepages\",\n            filename_prefix=\"hp_tensor\",\n            hugepage_size=16 * 1024 * 1024 * 1024,  # 16GiB\n    ):\n        # 이 인스턴스가 이미 초기화되었다면, 다시 실행하지 않습니다.\n        if hasattr(self, \"_initialized\") and self._initialized:\n            return\n\n        with self._lock:\n            if hasattr(self, \"_initialized\") and self._initialized:\n                return\n\n            self.n_weight_pages = n_weight_pages\n            if total_num_pages < self.n_weight_pages:\n                raise ValueError(\n                    f\"total_num_pages must be >= {self.n_weight_pages}.\")\n\n            self.dir = hugepage_dir\n            self.prefix = filename_prefix\n            self.hp_size = hugepage_size\n            self.pages = {}\n            self.allocations = {}\n            self.shared_kv_info = {}\n\n            self.is_primary_process = False\n\n            self._next_idx = {}\n\n            # Pinned-memory fallback: when a hugepage allocation fails for a\n            # weight tensor, fall back to cudaHostAlloc so we can use the\n            # rest of system RAM beyond the 16 GiB hugepage quota.\n            self._pinned_fallback_enabled = (\n                os.getenv(\"TIERED_SERVE_PINNED_FALLBACK\", \"1\") == \"1\")\n            self._pinned_fallback_types = frozenset({\"weight\"})\n            self._pinned_allocs = {}  # tensor_ptr -> {\"host_ptr\", \"size\", \"type\"}\n            self._pinned_total_bytes = 0\n\n            if not os.path.exists(self.dir):\n                # 경쟁 상태(race condition)를 대비해 exist_ok=True 사용\n                os.makedirs(self.dir, exist_ok=True)\n\n            self.n_kv_pages = max(0, total_num_pages - self.n_weight_pages)\n\n            # Ensure the hugepage pool is large enough.\n            self._ensure_hugepage_pool(total_num_pages)\n\n            num_pages_config = {\n                \"weight\": self.n_weight_pages,\n                \"kv\": self.n_kv_pages\n            }\n\n            for page_type, num in num_pages_config.items():\n                self.pages[page_type] = []\n                for i in range(num):\n                    page_path = os.path.join(self.dir,\n                                             f\"{self.prefix}_{page_type}_{i}\")\n\n                    page, was_created = self._create_page(page_path)\n                    if was_created:\n                        self.is_primary_process = True\n\n                    page[\"blocks\"] = [{\n                        \"offset\": 0,\n                        \"size\": self.hp_size,\n                        \"free\": True\n                    }]\n                    self.pages[page_type].append(page)\n\n                    if page_type == \"kv\":\n                        self.shared_kv_info[i] = {\n                            \"path\": page[\"path\"],\n                            \"base_ptr\": page[\"base_ptr\"],\n                            \"device_ptr\": page[\"device_ptr\"],\n                            \"size\": self.hp_size,\n                        }\n                logger.info(\n                    \"Initialized %d pages for type '%s'. Primary process: %s\",\n                    num, page_type, self.is_primary_process)\n\n            self._initialized = True\n\n    def _ensure_hugepage_pool(self, needed: int):\n        \"\"\"Grow the hugepage pool on NUMA node 0 if it is smaller than needed.\n\n        On GH200 (ARM), 16 GiB hugepages rely on contiguous physical memory\n        and cannot be reallocated once fragmented.  We drop the page cache\n        and try compaction as a best-effort measure.\n        \"\"\"\n        hp_size_kb = self.hp_size // 1024\n        pool_path = (f\"/sys/devices/system/node/node0/hugepages/\"\n                     f\"hugepages-{hp_size_kb}kB/nr_hugepages\")\n        try:\n            current = int(open(pool_path).read().strip())\n            if current >= needed:\n                return\n            # Best-effort: drop caches + compact memory to defragment\n            os.system(\"sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null; \"\n                      \"echo 1 > /proc/sys/vm/compact_memory 2>/dev/null\")\n            with open(pool_path, \"w\") as f:\n                f.write(str(needed))\n            actual = int(open(pool_path).read().strip())\n            if actual < needed:\n                logger.warning(\n                    \"hugepage pool grew %d -> %d but wanted %d. \"\n                    \"16 GiB hugepages may not be recoverable after \"\n                    \"fragmentation. Consider rebooting or setting \"\n                    \"hugepages at boot time.\",\n                    current, actual, needed)\n            else:\n                logger.info(\"Grew hugepage pool: %d -> %d (requested %d)\",\n                            current, actual, needed)\n        except Exception as e:\n            logger.warning(\"could not grow hugepage pool: %s\", e)\n\n    def _create_page(self, path: str):\n        # 파일이 존재하는지 확인하여 이 프로세스가 생성자인지 결정\n        is_creator = not os.path.exists(path)\n\n        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)\n        try:\n            # 파일 생성자만 파일 크기를 설정 (ftruncate)\n            if is_creator:\n                os.ftruncate(fd, self.hp_size)\n\n            buf = mmap.mmap(fd, self.hp_size, mmap.MAP_SHARED,\n                            mmap.PROT_READ | mmap.PROT_WRITE)\n        finally:\n            os.close(fd)\n\n        base_ptr = ctypes.addressof(ctypes.c_char.from_buffer(buf))\n        self._register_cuda_host(base_ptr, path, buf)\n        device_ptr = self._get_cuda_device_pointer(base_ptr)\n\n        page_data = {\n            \"mmap\": buf,\n            \"base_ptr\": base_ptr,\n            \"device_ptr\": device_ptr,\n            \"path\": path,\n        }\n        return page_data, is_creator\n\n    def get_shared_kv_info(self) -> dict:\n        \"\"\"\n        다른 프로세스에서 접근할 수 있도록 공유 설정된 'kv' 페이지들의\n        정보(경로, 포인터 등)가 담긴 딕셔너리를 반환합니다.\n        \"\"\"\n        return self.shared_kv_info\n\n    def calc_num_cache_block(self, n_layers: int,\n                             total_cache_block_size: int) -> int:\n        if n_layers < self.n_kv_pages:\n            raise ValueError(\n                f\"# of layers: {n_layers}, but # of HugePage for KV: \"\n                f\"{self.n_kv_pages}. Please increase # of HugePage for KV\")\n\n        size_per_hp = self.hp_size // (math.ceil(n_layers / self.n_kv_pages))\n        num_blk_per_hp = size_per_hp // (total_cache_block_size // n_layers)\n\n        return num_blk_per_hp\n\n    def _register_cuda_host(self, base_ptr, path, buf):\n        try:\n            cupy.cuda.runtime.hostRegister(base_ptr, self.hp_size,\n                                           0x02)\n        except cupy.cuda.runtime.CUDARuntimeError as e:\n            buf.close()\n            # 파일 생성에 실패하면 즉시 삭제\n            if os.path.exists(path):\n                os.unlink(path)\n            raise RuntimeError(f\"cudaHostRegister failed: {e}\")\n\n    def _get_cuda_device_pointer(self, base_ptr):\n        libcudart = ctypes.CDLL(\"libcudart.so\")\n        func = libcudart.cudaHostGetDevicePointer\n        func.restype = ctypes.c_int\n        func.argtypes = [\n            ctypes.POINTER(ctypes.c_void_p),\n            ctypes.c_void_p,\n            ctypes.c_uint,\n        ]\n        device_ptr_p = ctypes.c_void_p()\n        ret = func(ctypes.byref(device_ptr_p),\n                   ctypes.c_void_p(base_ptr),\n                   ctypes.c_uint(0))\n        if ret != 0:\n            cupy.cuda.runtime.hostUnregister(base_ptr)\n            raise RuntimeError(\n                f\"cudaHostGetDevicePointer failed with error code {ret}\")\n        return device_ptr_p.value\n\n    # Round per-allocation reservations up to this many bytes so that the\n    # data_ptr of every tensor handed out by the pool is naturally aligned.\n    # Matches PyTorch's CUDA caching allocator (256-byte) and is enough to\n    # satisfy `cp.async.cg.shared.global` 16B / vectorized loads when a\n    # buffer is read directly from LPDDR via ATS (--ats-decomp).\n    _ALLOC_ALIGN = 256\n\n    def _find_and_alloc(self, req_bytes, shape, stride, dtype, page_type):\n        \"\"\"내부 유틸리티: 빈 블록을 찾아 할당을 시도하고, 상세 정보를 내부적으로 저장\"\"\"\n        align = self._ALLOC_ALIGN\n        reserved_bytes = (req_bytes + align - 1) & ~(align - 1)\n        for page in self.pages[page_type]:\n            for i, block in enumerate(page[\"blocks\"]):\n                if block[\"free\"] and block[\"size\"] >= reserved_bytes:\n                    tensor_ptr = page[\"base_ptr\"] + block[\"offset\"]\n                    tensor = huge_page_allocator_ext.allocate(\n                        tensor_ptr, req_bytes, list(shape), list(stride),\n                        dtype)\n\n                    alloc_info = {\n                        \"path\": page[\"path\"],\n                        \"offset\": block[\"offset\"],\n                        \"page_size\": self.hp_size,\n                        \"type\": page_type,\n                    }\n                    self.allocations[tensor.data_ptr()] = alloc_info\n\n                    original_size = block[\"size\"]\n                    block[\"size\"] = reserved_bytes\n                    block[\"free\"] = False\n                    if original_size > reserved_bytes:\n                        new_block = {\n                            \"offset\": block[\"offset\"] + reserved_bytes,\n                            \"size\": original_size - reserved_bytes,\n                            \"free\": True,\n                        }\n                        page[\"blocks\"].insert(i + 1, new_block)\n\n                    return tensor\n        return None\n\n    def allocate(self,\n                 shape,\n                 stride,\n                 dtype=torch.float32,\n                 page_type: str = \"weight\"):\n        req_bytes = math.prod(shape) * torch.empty([],\n                                                   dtype=dtype).element_size()\n        if req_bytes == 0 or len(shape) == 0:\n            return torch.empty(shape, dtype=dtype)\n        if req_bytes > self.hp_size:\n            raise ValueError(\"Requested size exceeds page size.\")\n        if page_type not in self.pages:\n            raise MemoryError(f\"No pages for type '{page_type}'.\")\n\n        tensor = self._find_and_alloc(req_bytes, shape, stride, dtype,\n                                      page_type)\n        if tensor is not None:\n            return tensor\n\n        if (self._pinned_fallback_enabled\n                and page_type in self._pinned_fallback_types):\n            return self._allocate_pinned(req_bytes, shape, stride, dtype,\n                                         page_type)\n\n        raise MemoryError(\n            f\"Not enough capacity for type '{page_type}' even after compaction.\"\n        )\n\n    def _allocate_pinned(self, req_bytes, shape, stride, dtype, page_type):\n        \"\"\"Fallback path: cudaHostAlloc when hugepage pool is exhausted.\n\n        Uses cudaHostAllocMapped (flag 0x02) so the region is mapped into\n        the GPU address space, matching the hugepage region's semantics.\n        Allocated regions are tracked in ``self._pinned_allocs`` and must\n        be freed via ``cudaFreeHost`` in ``free()`` / ``cleanup()``.\n        \"\"\"\n        try:\n            host_ptr = int(cupy.cuda.runtime.hostAlloc(req_bytes, 0x02))\n        except cupy.cuda.runtime.CUDARuntimeError as e:\n            raise MemoryError(\n                f\"Hugepage pool exhausted and cudaHostAlloc fallback failed \"\n                f\"({req_bytes} bytes for '{page_type}'): {e}\"\n            )\n        try:\n            tensor = huge_page_allocator_ext.allocate(\n                host_ptr, req_bytes, list(shape), list(stride), dtype)\n        except Exception:\n            cupy.cuda.runtime.freeHost(host_ptr)\n            raise\n\n        tensor_ptr = tensor.data_ptr()\n        self._pinned_allocs[tensor_ptr] = {\n            \"host_ptr\": host_ptr,\n            \"size\": req_bytes,\n            \"type\": page_type,\n        }\n        # Keep an entry in self.allocations so free()/info APIs see it,\n        # marked with kind=pinned to take the cudaFreeHost path.\n        self.allocations[tensor_ptr] = {\n            \"path\": None,\n            \"offset\": 0,\n            \"page_size\": req_bytes,\n            \"type\": page_type,\n            \"kind\": \"pinned\",\n        }\n        self._pinned_total_bytes += req_bytes\n        logger.info(\n            \"Pinned fallback: +%.2f MiB (%s); pinned total now %.2f GiB\",\n            req_bytes / (1024**2), page_type,\n            self._pinned_total_bytes / (1024**3))\n        return tensor\n\n    def get_kv_cache_info_list(self) -> list:\n        \"\"\"\n        할당된 모든 텐서 정보 중 page_type이 'kv'인 것들만 필터링하여\n        UnloadWorker가 필요로 하는 형식의 리스트로 만들어 반환합니다.\n        \"\"\"\n        info_list = []\n        for alloc_info in self.allocations.values():\n            # Skip pinned fallback entries: they have no backing file path\n            # and the UnloadWorker layout assumes a hugepage file.\n            if alloc_info.get(\"kind\") == \"pinned\":\n                continue\n            if alloc_info.get(\"type\") == \"kv\":\n                # Worker에 필요한 정보만 추출하여 추가\n                info_list.append({\n                    \"path\": alloc_info[\"path\"],\n                    \"offset\": alloc_info[\"offset\"],\n                    \"page_size\": alloc_info[\"page_size\"],\n                })\n        return info_list\n\n    def free(self, tensor: torch.Tensor) -> None:\n        \"\"\"Hugepage 할당을 해제하고 인접한 free 블록들을 병합합니다.\"\"\"\n        ptr = tensor.data_ptr()\n        alloc_info = self.allocations.pop(ptr, None)\nimport contextlib\nimport gc\nimport logging\nimport os\nimport re\nfrom typing import Optional\n\nimport torch\nfrom torch import nn\n\nfrom vllm.config import ModelConfig, VllmConfig\nfrom vllm.config.load import LoadConfig\nfrom vllm.model_executor.model_loader.default_loader import DefaultModelLoader\nfrom vllm.model_executor.model_loader.utils import (\n    initialize_model,\n)\n\n\n@contextlib.contextmanager\ndef _hugepage_bounce_to_gpu(\n    module: nn.Module, target_device: torch.device,\n    frozen_hbm: Optional[set] = None,\n    module_name: str = \"\",\n):\n    \"\"\"Move a module's CPU parameters to ``target_device`` for the\n    duration of the block, then copy them back **in-place** into the\n    original CPU buffer (preserving its hugepage backing, alignment,\n    pin_memory state, etc.).\n\n    Unlike vLLM's ``device_loading_context`` (which allocates a brand-new\n    ``empty_strided`` CPU buffer on exit and points the parameter at it),\n    this preserves the original hugepage allocation. Required for FP8 /\n    INT8 ``process_weights_after_loading`` paths whose CUDA-only custom\n    ops modify the weight tensor in place — letting us run them on GPU\n    while keeping the host backing untouched.\n\n    Caveats:\n    * If the parameter's total byte size changes during the block (e.g.\n      ``weight_scale`` shrinks to a scalar via ``max()``) the original\n      hugepage backing cannot be reused. If the parameter's full name\n      (``<module_name>.<param_name>``) matches the ``frozen_hbm`` set\n      (typically built by yaml-driven wildcard expansion of patterns\n      like ``\"*.weight_scale\"``), the tensor is left on GPU. Otherwise\n      a fresh CPU buffer is allocated (matches the default\n      ``device_loading_context`` behaviour and loses the hugepage\n      backing).\n    * Newly added parameters (e.g. quant scale inverses created during\n      ``process_weights_after_loading``) always stay on ``target_device``.\n    \"\"\"\n    if target_device.type == \"cpu\":\n        yield module\n        return\n\n    saved_cpu_buffers: dict[str, torch.Tensor] = {}\n    for name, p in module.named_parameters():\n        if p.device.type == \"cpu\":\n            # Keep a reference to the original (likely hugepage-backed) buffer.\n            saved_cpu_buffers[name] = p.data\n            p.data = p.data.to(target_device, non_blocking=False)\n\n    try:\n        yield module\n    finally:\n        for name, p in module.named_parameters():\n            if name not in saved_cpu_buffers:\n                continue\n            cpu_buf = saved_cpu_buffers[name]\n            if p.device.type == \"cpu\":\n                continue\n            # vLLM's FP8 process_weights_after_loading calls weight.t() and\n            # replace_parameter, which changes the parameter's shape and\n            # stride (transpose view). The numel/element_size and total\n            # byte size are preserved though, so we can reinterpret the\n            # hugepage buffer in the new (shape, dtype) and copy the GPU\n            # data into it in-place. This avoids any new CPU allocation\n            # — critical at 100+ GB FP8 model scales where doubling host\n            # memory triggers OOM.\n            try:\n                if cpu_buf.dtype != p.data.dtype:\n                    cpu_buf = cpu_buf.view(p.data.dtype)\n                same_nbytes = (cpu_buf.numel() * cpu_buf.element_size()\n                               == p.data.numel() * p.data.element_size())\n                if not same_nbytes:\n                    raise RuntimeError(\"hugepage buffer size mismatch\")\n                # ``view`` would force the result back to a contiguous\n                # row-major layout, silently undoing the column-major\n                # transpose that vLLM's FP8 ``process_weights_after_loading``\n                # bakes into ``weight`` (so cutlass_scaled_mm sees\n                # ``b.stride(0) == 1``).  Use ``as_strided`` instead to\n                # mirror p.data's exact stride on top of the hugepage\n                # storage.  Copy is still logical-element-preserving.\n                target = torch.as_strided(\n                    cpu_buf, p.data.shape, p.data.stride())\n                target.copy_(p.data)\n                p.data = target\n                # vLLM's FP8 process_weights_after_loading calls\n                # replace_parameter, producing a fresh nn.Parameter that\n                # loses the _on_hugepage marker.  The data we just put\n                # back IS hugepage-backed, so restore the marker — the\n                # downstream UVA-conversion loop in load_model() keys on\n                # it to flip p.data to a CUDA view.\n                p._on_hugepage = True\n            except RuntimeError as e:\n                # weight_scale / input_scale typically shrink to a scalar\n                # during requantize_with_max_scale, so byte size won't\n                # match the original hugepage buffer. Behaviour here is\n                # yaml-driven via the `frozen_hbm` block: if this\n                # parameter's full name matches one of the user's\n                # patterns we keep it on GPU; otherwise we allocate a\n                # fresh CPU buffer.\n                full_name = f\"{module_name}.{name}\" if module_name else name\n                pinned = frozen_hbm is not None and full_name in frozen_hbm\n                if pinned:\n                    _logger.debug(\n                        \"_hugepage_bounce_to_gpu: %s pinned to HBM by \"\n                        \"frozen_hbm (%s; numel=%d)\",\n                        full_name, e, p.data.numel())\n                else:\n                    _logger.warning(\n                        \"_hugepage_bounce_to_gpu: %s falling back to \"\n                        \"fresh CPU alloc (%s; numel=%d). Add it to \"\n                        \"`frozen_hbm` in the ts-config to pin to GPU.\",\n                        full_name, e, p.data.numel())\n                    p.data = p.data.detach().to(\"cpu\")\nfrom vllm.utils.torch_utils import set_default_torch_dtype\nfrom vllm.registry import register_external_loader\n\nfrom tiered_serve.torch_model import TorchModel, OFFLOAD_MODES\nfrom tiered_serve.module_block import make_context\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\nfrom tiered_serve.utils import set_every_module_full_path\nfrom tiered_serve.torch_hooks import before_model_forward, after_model_forward\n\n_logger = logging.getLogger(\"vllm\")\n\n\ndef _component_from_param_name(name: str) -> str | None:\n    \"\"\"Map a parameter name to its tiered-serve component key.\"\"\"\n    if \".self_attn.qkv_proj.\" in name:\n        return \"qkv\"\n    if \".self_attn.o_proj.\" in name:\n        return \"o\"\n    if \".mlp.gate_up_proj.\" in name:\n        return \"gate_up\"\n    if \".mlp.down_proj.\" in name:\n        return \"down\"\n    return None\n\n\ndef _param_in_path_set(name: str, path_set: set) -> bool:\n    \"\"\"Return True when ``name`` (a state_dict key) is matched by a\n    wildcard-expanded YAML path set (e.g. ``frozen_blocks``, ``ats_blocks``).\n\n    Two kinds of match are honoured: exact (the YAML entry resolved to\n    this parameter directly) and ancestor (the YAML entry resolved to a\n    module that owns this parameter).  Ancestor matching is needed because\n    ``frozen_blocks: model.layers.*.input_layernorm`` resolves to module\n    paths in :func:`make_context`'s wildcard expansion, while the\n    materialization loop iterates parameter paths like\n    ``model.layers.0.input_layernorm.weight``.\n    \"\"\"\n    if not path_set:\n        return False\n    if name in path_set:\n        return True\n    # Walk ancestor prefixes (strip one \".tail\" segment at a time).\n    cut = name.rfind(\".\")\n    while cut != -1:\n        if name[:cut] in path_set:\n            return True\n        cut = name.rfind(\".\", 0, cut)\n    return False\n\n\nclass ImmigrantModelLoader(DefaultModelLoader):\n    @staticmethod\n    def _process_weights_after_loading(\n        model: nn.Module,\n        model_config: ModelConfig,\n        target_device: torch.device,\n    ) -> None:\n        \"\"\"Like vLLM's process_weights_after_loading but avoids\n        device_loading_context for modules whose parameters live on\n        hugepages.  The vanilla code-path moves CPU params to GPU and\n        then allocates *new* pinned-CPU tensors to put them back,\n        permanently destroying the hugepage backing and wasting ~140 GB\n        of regular RSS.\"\"\"\n        from vllm.attention.layer import Attention, MLAAttention\n        from vllm.model_executor.layers.quantization.base_config import (\n            QuantizeMethodBase,\n        )\n        from vllm.model_executor.model_loader.utils import (\n            device_loading_context,\n        )\n        from vllm.model_executor.model_loader.online_quantization import (\n            maybe_save_metadata_and_attributes_for_weight_reloading,\n        )\n\n        # Read `frozen_hbm` block from the ts-config YAML and expand\n        # i