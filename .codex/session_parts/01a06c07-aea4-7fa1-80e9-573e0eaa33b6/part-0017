TS_GOODPUT_SLO_MS\", \"200,250\").split(\",\")\n    ]\n    # slo_stats[\"total\"] = 완료(성공+실패) 요청 수, slo_stats[slo] = attained 수\n    slo_stats = {\"total\": 0}\n    for _slo in slo_ms_list:\n        slo_stats[_slo] = 0\n\n    async def limited_request_func(request_func_input, session, pbar):\n        async with semaphore:\n            output = await request_func(\n                request_func_input=request_func_input, session=session, pbar=pbar\n            )\n            # 요청이 끝날 때마다 그 요청의 ttft/tpot 와 지금까지의 SLO attainment 출력.\n            # 분모는 완료된 모든 요청(실패 포함) — summary 의 전체 평균 정의와 일치.\n            slo_stats[\"total\"] += 1\n            if output.success:\n                out_len = output.output_tokens or request_func_input.output_len or 0\n                # mean TPOT (out_len<=1 이면 0 으로 본다; goodput 관례와 동일)\n                tpot = (\n                    (output.latency - output.ttft) / (out_len - 1)\n                    if out_len > 1\n                    else 0.0\n                )\n                ttft_ms = output.ttft * 1000.0\n                tpot_ms = tpot * 1000.0\n                prefill_ok = ttft_ms <= ttft_slo_ms\n                for slo in slo_ms_list:\n                    if prefill_ok and tpot_ms <= slo:\n                        slo_stats[slo] += 1\n\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n                    f\"ttft={ttft_ms:.1f}ms \"\n                    f\"tpot={tpot_ms:.1f}ms \"\n                    f\"| {attain}\"\n                )\n            else:\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n                    f\"failed: {output.error} | {attain}\"\n                )\n            if pbar is not None:\n                pbar.write(line)\n            else:\n                print(line, flush=True)\n            return output\n\n    benchmark_start_time = time.perf_counter()\n    tasks: list[asyncio.Task] = []\n\n    rps_change_events = []\n    last_int_rps = -1\n    if ramp_up_strategy is not None and ramp_up_start_rps is not None:\n        last_int_rps = ramp_up_start_rps\n        rps_change_events.append(\n            {\n                \"rps\": last_int_rps,\n                \"timestamp\": datetime.now().isoformat(),\n            }\n        )\n\n    async for request, current_request_rate in get_request(\n        input_requests,\n        request_rate,\n        burstiness,\n        ramp_up_strategy,\n        ramp_up_start_rps,\n        ramp_up_end_rps,\n    ):\n        if ramp_up_strategy is not None:\n            current_int_rps = int(current_request_rate)\n            if current_int_rps > last_int_rps:\n                timestamp = datetime.now().isoformat()\n                for rps_val in range(last_int_rps + 1, current_int_rps + 1):\n                    rps_change_events.append({\"rps\": rps_val, \"timestamp\": timestamp})\n                last_int_rps = current_int_rps\n        prompt, prompt_len, output_len, mm_content, request_id = (\n            request.prompt,\n            request.prompt_len,\n            request.expected_output_len,\n            request.multi_modal_data,\n            request.request_id,\n        )\n        req_model_id, req_model_name = model_id, model_name\n        if lora_modules:\n            req_lora_module = next(lora_modules)\n            req_model_id, req_model_name = req_lora_module, req_lora_module\n\n        request_func_input = RequestFuncInput(\n            model=req_model_id,\n            model_name=req_model_name,\n            prompt=prompt,\n