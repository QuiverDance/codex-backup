UM_PROMPTS=1200\nSKIP_FIRST_N_REQUESTS=100\nSKIP_LAST_N_REQUESTS=100\n# 1-based send-order prefix.  Zero means wait for all NUM_PROMPTS requests.\nSTOP_AFTER_REQUEST=0\n\nNUMA_NODE=0\nGPU_INDEX=0\nSTARTUP_TIMEOUT=900\nSHUTDOWN_TIMEOUT=120\nCLEANUP_TIMEOUT=180\nMAX_IDLE_HBM_MIB=1024\nOUTPUT_ROOT=\"${REPO_ROOT}/benchmark_results/serving_suite\"\nDRY_RUN=0\nCHECK_ONLY=0\nBREAKDOWN=0\nSMOKE=0\n\nusage() {\n  cat <<'EOF'\nUsage: scripts/serving/run_performance_suite.sh [options]\n\nRuns isolated llama70b serving experiments. Every combination of KV mode,\nchunk size, request rate, and repeat gets a fresh server process.\n\nOptions:\n  --codecs LIST                 p4flat,cd3 (default: p4flat,cd3)\n  --modes LIST                  raw,kvcomp (default: raw,kvcomp)\n  --chunks LIST                 Comma-separated max_num_batched_tokens\n                                (default: 2048,4096,8192)\n  --request-rates LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 1)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --stop-after-request N        Stop after send-order requests 1..N have all\n                                completed. La