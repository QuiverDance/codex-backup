 169\t    # Unified compressed-weight path (decode + captured-size prefill): the\n   170\t    # compressor's linear_apply decides fused (N <= per-(M,K) threshold) vs\n   171\t    # decompress+cuBLAS (N > thr, or fused-off) INTERNALLY — both on the current\n   172\t    # stream, both captured.  The decision is (M,K,N)-only, so it bakes per\n   173\t    # captured size.  WDecomp events (entry[8:10]) bracket the fallback decompress\n   174\t    # only; the fused kernel leaves them unrecorded so its inseparable decode\n   175\t    # folds into Compute.\n   176\t    y = entry[2].linear_apply(entry[3], x, wdecomp_events=(entry[8], entry[9]))\n   177\t\n   178\t    if kde is not None:\n   179\t        kde.record(cur)\n   180\t    return y\n   181\t\n   182\t\n   183\tdef _fused_linear_apply_fake(x: torch.Tensor, layer_id: int,\n   184\t                             comp_id: int, M: int) -> torch.Tensor:\n   185\t    # Output shape is (*x.shape[:-1], M); device + dtype follow x.\n   186\t    out_shape = list(x.shape[:-1]) + [int(M)]\n   187\t    return torch.empty(out_shape, dtype=x.dtype, device=x.device)\n   188\t\n   189\t\n   190\tdirect_register_custom_op(\n   191\t    op_name=\"fused_linear_apply\",\n   192\t    op_func=_fused_linear_apply_impl,\n   193\t    fake_impl=_fused_linear_apply_fake,\n   194\t    mutates_args=[],\n   195\t    target_lib=_lib,\n   196\t)\n   197\t\n   198\t\n   199\tdef _wait_frozen_weight_impl(weight: torch.Tensor, layer_id: int,\n   200\t                             comp_id: int) -> None:\n   201\t    \"\"\"In-graph per-buffer weight-ready wait.\n   202\t\n   203\t    Inserted before each projection GEMM by ``insert_frozen_weight_waits`` so\n   204\t    that, inside the captured piecewise CUDA graph, the GEMM waits for ITS OWN\n   205\t    weight buffer to be ready (H2D copy or decompress complete) before reading\n   206\t    it — instead of the coarse per-piece wait the wrapper does on cur_stream.\n   207\t\n   208\t    The wait target mirrors the eager ``before_exec_*`` hook selection exactly:\n   209\t\n   210\t      * uncompressed-frozen (resident on GPU)        → no wait\n   211\t      * compressed / split-frozen (decompress in-place)→ frozen_decomp_events\n   212\t      * fully-frozen (uncompressed) layer            → no wait\n   213\t      * streamed (offload_uncompressed/compressed)   → exec_*_barriers\n   214\t\n   215\t    The events are ``external=True``; the ``wait_event`` recorded here during\n   216\t    capture becomes a graph node that, on each replay, waits for the\n   217\t    most-recent recorded state of the event (re-recorded each step by the\n   218\t    loads / decomp scheduling in the wrapper's _before/_after_replay).\n   219\t    \"\"\"\n   220\t    try:\n   221\t        from tiered_serve.dual_memory_loader import DualMemoryLoader\n   222\t\n   223\t        dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n   224\t        comp = _ID_TO_COMP.get(int(comp_id))\n   225\t        if dm is None or comp is None:\n   226\t            return\n   227\t\n   228\t        stream = torch.cuda.current_stream(weight.device)\n   229\t\n   230\t        # Resolve the single event this (layer, comp) must wait on, mirroring\n   231\t        # the eager ``before_exec_*`` selection.  ``None`` => no wait.\n   232\t        ev = None\n   233\t        unc = getattr(dm, \"frozen_uncompressed_flags\", None)\n   234\t        if unc is not None and unc[layer_id].get(comp, False):\n   235\t            # uncompressed-frozen: weight already resident → no wait.\n   236\t            ev = None\n   237\t        elif (dm.comp_frozen_flags[layer_id].get(comp, False)\n   238\t                or dm.split_frozen_flags[layer_id].get(comp, False)):\n   239\t            # compressed / split-frozen: wait on this component's decompress.\n   240\t            if hasattr(dm, \"frozen_decomp_events\"):\n   241\t                ev = dm.frozen_decomp_events[comp][layer_id]\n   242\t            elif hasattr(dm, \"frozen_decomp_event\"):\n   243\t                ev = dm.frozen_decomp_event\n   244\t        elif layer_id in getattr(dm, \"frozen_layers\", ()):\n   245\t            # fully-frozen (uncompressed) layer kept resident → no wait.\n   246\t            ev = None\n   247\t        else:\n   248\t            # streamed (offload_uncompressed / offload_compressed): wait on\n   249\t            # the exec barrier recorded when this component's H2D / decompress\n   250\t            # into the double-buffer completes.\n   251\t            barriers = getattr(dm, _EXEC_BARRIER_ATTR[comp], None)\n   252\t            ev = barriers[layer_id] if barriers is not None else None\n   253\t\n   254\t        if ev is None:\n   255\t            return\n   256\t\n   257\t        # Time the in-graph weight-ready stall so calc_times can attribute it\n   258\t        # to this (layer, comp).  The wait lives INSIDE the captured piece, so\n   259\t        # the between-piece gap can't see it — begin/end bracket the wait_event\n   260\t        # (decode breakdown only; gated on collect_times).\n   261\t        wb = getattr(dm, \"_v1_wwait_begin_events\", None)\n   262\t        we = getattr(dm, \"_v1_wwait_end_events\", None)\n   263\t        timed = (wb is not None and we is not None\n   264\t                 and getattr(dm, \"collect_times\", False))\n   265\t        idx = layer_id * 4 + int(comp_id)\n   266\t        if timed:\n   267\t            wb[idx].record(stream)\n   268\t        stream.wait_event(ev)\n   269\t        if timed:\n   270\t            we[idx].record(stream)\n   271\t    except Exception:\n   272\t        # Keep graph execution robust if tiered-serve is not active during\n   273\t        # profiling or non-CUDA fake runs.\n   274\t        return\n   275\t\n   276\t\n   277\tdef _wait_frozen_weight_fake(weight: torch.Tensor, layer_id: int,\n   278\t                             comp_id: int) -> None:\n   279\t    return\n   280\t\n   281\t\n   282\t# Register weight as a mutated arg so torch.compile cannot elide the op as\n   283\t# dead code (it has no return value). The op does not actually mutate weight\n   284\t# data — it only inserts a stream wait_event before subsequent GEMMs read\n   285\t# the weight. Declaring mutation prevents DCE while keeping the op as a\n   286\t# pure side-effect barrier.\n   287\tdirect_register_custom_op(\n   288\t    op_name=\"wait_frozen_weight\",\n   289\t    op_func=_wait_frozen_weight_impl,\n   290\t    fake_impl=_wait_frozen_weight_fake,\n   291\t    mutates_args=[\"weight\"],\n   292\t    target_lib=_lib,\n   293\t)\n   294\t\n   295\t\n   296\t_COMP_SUBSTR = (\n   297\t    (\"self_attn_modules_qkv_proj\", \"qkv\"),\n   298\t    (\"self_attn_modules_o_proj\", \"o\"),\n   299\t    (\"mlp_modules_gate_up_proj\", \"gate_up\"),\n   300\t    (\"mlp_modules_down_proj\", \"down\"),\n   301\t    # Looser variants seen in post-grad get_attr / placeholder names across\n   302\t    # torch/vLLM versions (module-path mangling differs).\n   303\t    (\"qkv_proj\", \"qkv\"),\n   304\t    (\"o_proj\", \"o\"),\n   305\t    (\"gate_up_proj\", \"gate_up\"),\n   306\t    (\"down_proj\", \"down\"),\n   307\t)\n   308\t\n   309\t\n   310\tdef component_from_weight_name(name: str) -> tuple[int, str] | None:\n   311\t    \"\"\"Best-effort (layer_id, comp) extraction from a weight node name.\n   312\t\n   313\t    Tries the strict Dynamo get_attr mangling first, then a looser fallback\n   314\t    that just needs a ``layers.<N>`` index and one of the four projection\n   315\t    substrings somewhere in the name.  Returns None if neither matches.\n   316\t    \"\"\"\n   317\t    match = _LAYER_RE.search(name)\n   318\t    if match is not None:\n   319\t        layer_id = int(match.group(1))\n   320\t        path = match.group(2)\n   321\t        for sub, comp in _COMP_SUBSTR:\n   322\t            if sub in path:\n   323\t                return layer_id, comp\n   324\t\n   325\t    # Looser fallback.\n   326\t    lm = _LAYER_NUM_RE.search(name)\n   327\t    if lm is None:\n   328\t        return None\n   329\t    layer_id = int(lm.group(1))\n   330\t    for sub, comp in _COMP_SUBSTR:\n   331\t        if sub in name:\n   332\t            return layer_id, comp\n   333\t    return None\n   334\t\n   335\t\n   336\tdef _is_linear_like(node) -> tuple[bool, int]:\n   337\t    \"\"\"Return (is_linear, weight_arg_idx) for a call_function node.\n   338\t\n   339\t    Post-grad graphs have linear decomposed to aten.mm / aten.addmm /\n   340\t    aten._scaled_mm (FP8); pre-grad may still carry aten.linear.  Weight is\n   341\t    args[1] for mm/_scaled_mm/linear and args[2] for addmm (bias, input, w).\n   342\t    \"\"\"\n   343\t    if node.op != \"call_function\":\n   344\t        return False, -1\n   345\t    target = node.target\n   346\t    target_name = getattr(target, \"name\", lambda: str(target))()\n   347\t    if target_name == \"aten::addmm\":\n   348\t        return (len(node.args) >= 3), 2\n   349\t    if target_name in (\"aten::linear\", \"aten::mm\", \"aten::_scaled_mm\") \\\n   350\t            or target is torch._C._nn.linear \\\n   351\t            or \"built-in function linear\" in str(target):\n   352\t        return (len(node.args) >= 2), 1\n   353\t    return False, -1\n   354\t\n   355\t\n   356\tdef insert_frozen_weight_waits(graph_or_gm) -> int:\n   357\t    \"\"\"Insert a per-component ``wait_frozen_weight`` op before each projection\n   358\t    GEMM so the wait is baked into the captured graph.\n   359\t\n   360\t    Accepts either a ``torch.fx.Graph`` (vLLM ``post_grad_custom_post_pass``\n   361\t    calling convention) or a ``torch.fx.GraphModule``.  Runs once per\n   362\t    piecewise subgraph, so it is invoked many times; the totals are\n   363\t    accumulated on ``DualMemoryLoader._v1_weight_waits_inserted`` and gate the\n   364\t    wrapper's coarse-wait fallback.\n   365\t    \"\"\"\n   366\t    import logging\n   367\t\n   368\t    logger = logging.getLogger(\"vllm\")\n   369\t\n   370\t    if isinstance(graph_or_gm, torch.fx.GraphModule):\n   371\t        graph = graph_or_gm.graph\n   372\t        owner_gm = graph_or_gm\n   373\t    else:\n   374\t        graph = graph_or_gm\n   375\t        owner_gm = None\n   376\t\n   377\t    inserted = 0\n   378\t    linear_seen = 0\n   379\t    unmatched = []  # (target_name, weight_node_name, weight_node_op)\n   380\t    for node in list(graph.nodes):\n   381\t        is_lin, weight_arg_idx = _is_linear_like(node)\n   382\t        if not is_lin:\n   383\t            continue\n   384\t        linear_seen += 1\n   385\t        weight_arg = node.args[weight_arg_idx]\n   386\t        if not isinstance(weight_arg, torch.fx.Node):\n   387\t            continue\n   388\t        # get_attr nodes carry the qualified param path in .target; placeholder\n   389\t        # / other nodes only in .name — try both.\n   390\t        cand_names = [weight_arg.name]\n   391\t        if isinstance(getattr(weight_arg, \"target\", None), str):\n   392\t            cand_names.append(weight_arg.target)\n   393\t        parsed = None\n   394\t        for nm in cand_names:\n   395\t            parsed = component_from_weight_name(nm)\n   396\t            if parsed is not None:\n   397\t                break\n   398\t        if parsed is None:\n   399\t            if len(unmatched) < 8:\n   400\t                tname = getattr(node.target, \"name\",\n   401\t                                lambda: str(node.target))()\n   402\t                unmatched.append((tname, weight_arg.name, weight_arg.op))\n   403\t            continue\n   404\t        layer_id, comp = parsed\n   405\t        with graph.inserting_before(node):\n   406\t            graph.call_function(\n   407\t                torch.ops.tiered_serve.wait_frozen_weight.default,\n   408\t                args=(weight_arg, layer_id, _COMP_TO_ID[comp]),\n   409\t            )\n   410\t        # Don't replace the GEMM's weight arg. The wait op is a side-effect\n   411\t        # barrier — declaring `mutates_args=[\"weight\"]` prevents DCE and\n   412\t        # forces the op to run before any subsequent op that reads `weight`.\n   413\t        inserted += 1\n   414\t\n   415\t    if inserted:\n   416\t        graph.lint()\n   417\t        if owner_gm is not None:\n   418\t            owner_gm.recompile()\n   419\t\n   420\t    # Observability: this pass is unverifiable without a real compile, so make\n   421\t    # the match outcome loud.  inserted==0 while linear_seen>0 means the\n   422\t    # weight-node naming didn't match — the dumped sample shows what to tune.\n   423\t    if inserted == 0 and linear_seen > 0:\n   424\t        logger.warning(\n   425\t            \"[ts-fx-wait] 0/%d linear nodes matched for weight-wait \"\n   426\t            \"insertion; weight-node naming unrecognized. Samples \"\n   427\t            \"(gemm, weight_name, weight_op): %s\",\n   428\t            linear_seen, unmatched)\n   429\t    else:\n   430\t        logger.info(\n   431\t            \"[ts-fx-wait] inserted %d weight-wait op(s) over %d linear \"\n   432\t            \"node(s) in this piece\", inserted, linear_seen)\n   433\t\n   434\t    # Accumulate + flip the wrapper's per-component path on, so coarse\n   435\t    # per-piece waits are skipped only when in-graph waits actually exist.\n   436\t    try:\n   437\t        from tiered_serve.dual_memory_loader import DualMemoryLoader\n   438\t        DualMemoryLoader._v1_weight_waits_inserted = (\n   439\t            getattr(DualMemoryLoader, \"_v1_weight_waits_inserted\", 0)\n   440\t            + inserted)\n   441\t        if inserted:\n   442\t            DualMemoryLoader._v1_weight_waits_active = True\n   443\t    except Exception:\n   444\t        pass\n   445\t\n   446\t    return inserted\n5:CUDA graphs split at attention ops.  The compiled pieces are each wrapped in\n18:    (attention L0 runs eagerly)\n20:    (attention Lk runs eagerly)\n24:  V0: attention IS inside the captured graph (on exec_stream/replay_stream)\n25:  V1: attention runs eagerly on current_stream BETWEEN piecewise graphs\n28:  - ``unloaded_kv[k]`` must be recorded AFTER attention k completes,\n30:  - ``exec_attn_barriers[k]`` must be waited on current_stream before\n31:    attention k runs, so we wait in wrapper_k.after_replay\n82:# Decode-only steps load/decompress the CURRENT layer right before attention.\n84:# prefill attention writes the current layer's KV.\n127:        Normal prefill can pipeline L+1 because its attention writes the\n283:        Prefill NONE-path pieces run attention/MLP inside ``self.runnable``.\n325:        path because the expensive attention/MLP already ran inside\n356:        one attention's worth of lead time — their H2D+decomp spilled into the\n472:                \"assumes 81 for 80-layer model (per-attention split)\",\n609:        # For last graph, no attention follows → record end immediately\n648:            # The previous step's attention may have written a resident tail\n657:            # Resident tail rows were last written by attention on the\n682:            # the last attention piece. Make later block free/reuse and the\n794:        # graph replay (which includes attention k).  In V1, attention k\n797:        # attention k-1 has already completed on current_stream by now.\n805:            # Wait until attention on compute stream finishes reading KV\n824:            # storage that attention(k) will overwrite, so the compute stream\n856:            # unload gate (line ~631) waits on the prev attention, and aliasing\n874:            # attention is automatic (decode(L+1) follows attention(L) in exec\n917:                # attention waits the right load (JIT: was wrongly target_kv_idx).\n918:                barrier = dm.exec_attn_barriers[decode_tgt]\n1072:    def _after_replay(self, dm, idx: int, n_graphs: int,\n1083:        In V1, attention runs AFTER this wrapper returns on current_stream.\n1084:        So steps 2-3 (which depend on attention completion) are DEFERRED to\n1087:        We DO need to ensure KV for THIS layer is loaded before attention\n1089:        exec_attn_barriers[graph_idx] on current_stream.\n1128:            barrier = dm.exec_attn_barriers[target_kv_local]\n1134:        # for eager attention, to give the decomp stream + copy engine the\n1136:        # left the big gate_up/down weights with a single attention of lead\n1188:        # In V0, the exec_attn_barriers[graph_idx] wait is baked into the\n1189:        # captured graph.  In V1, attention runs eagerly on current_stream\n1192:            # The elapsed between begin/end is the GPU stall attention takes\n1205:            cur_stream.wait_event(dm.exec_attn_barriers[graph_idx])\n1212:        #    _before_replay (needs attention to complete first) ──\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06c08-dab1-7df3-80fd-f5a977ff60b7","create_time":1788519022.4839103}}}
