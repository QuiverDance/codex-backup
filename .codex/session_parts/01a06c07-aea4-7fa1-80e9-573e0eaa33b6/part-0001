low.\n   428\t        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\n   429\t        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\n   430\t        #    into the decomp kernel (LPDDR is read directly via\n   431\t        #    host-mapped UVA), so those H2D bytes don't surface as a\n   432\t        #    separate event — they are folded into the WDecomp time\n   433\t        #    instead.\n   434\t        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\n   435\t        #    → end_forward).  Python-loop TPOT additionally includes\n   436\t        #    scheduler / sampling / output assembly on CPU.  See the\n   437\t        #    [Step] StepLatency log emitted by\n   438\t        #    offline_offload_kvweight.py for the perf_counter step time.\n   439\t        if self.time_breakdown:\n   440\t            # ── Subtract in-graph cur_stream waits from LLM intervals ──\n   441\t            # Two distinct barriers block cur_stream INSIDE the\n   442\t            # [begin_exec, end_exec] window — during either, cur_stream is\n   443\t            # stalled, NOT running GEMM/attention:\n   444\t            #   1. KV-barrier wait: the wrapper's `_after_replay` does\n   445\t            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\n   446\t            #      (see v1_cuda_graph_wrapper.py) before eager attention.\n   447\t            #      Timed by `_v1_kv_wait_*`.\n   448\t            #   2. In-graph weight-ready wait: the FX-injected\n   449\t            #      `wait_frozen_weight` op blocks each projection GEMM until\n   450\t            #      its weight H2D/decomp lands (see graph_wait_ops.py).\n   451\t            #      Timed per (layer, component) by `_v1_wwait_*`.\n   452\t            # Counting either as LLM busy inflates ComputeUnion and hides\n   453\t            # stall.  The legacy \"Exec\" line subtracts BOTH (via\n   454\t            # attn_barrier_wait + weight_stall), so LLM here must subtract\n   455\t            # both too — otherwise the breakdown LLM reads high by the\n   456\t            # weight-wait time.  Subtract the union of all wait sub-intervals\n   457\t            # so LLM reflects actual compute on cur_stream and the stall calc\n   458\t            # treats wait time as compute-idle.\n   459\t            wait_intervals: List[Tuple[float, float]] = []\n   460\t            for wbe, wee in (\n   461\t                    (getattr(self, '_v1_kv_wait_begin_events', None),\n   462\t                     getattr(self, '_v1_kv_wait_end_events', None)),\n   463\t                    (getattr(self, '_v1_wwait_begin_events', None),\n   464\t                     getattr(self, '_v1_wwait_end_events', None))):\n   465\t                if not wbe or not wee:\n   466\t                    continue\n   467\t                for i in range(min(len(wbe), len(wee))):\n   468\t                    try:\n   469\t                        wb = init_event.elapsed_time(wbe[i])\n   470\t                        we = init_event.elapsed_time(wee[i])\n   471\t                    except RuntimeError:\n   472\t                        continue\n   473\t                    if wb < -0.01 or we < -0.01 or we - wb < 0.001:\n   474\t                        continue\n   475\t                    wait_intervals.append((wb, we))\n   476\t            # KV and weight waits all live on cur_stream and run sequentially,\n   477\t            # so they are already non-overlapping — a sort is enough to meet\n   478\t            # _subtract_intervals' \"sorted AND non-overlapping\" precondition\n   479\t            # (no union-merge needed).  Likewise llm_intervals: the per-kernel\n   480\t            # exec intervals don't overlap (single cur_stream), so subtract\n   481\t            # directly without unioning first.\n   482\t            wait_intervals.sort(key=lambda x: x[0])\n   483\t            # Compute = exec minus cur_stream waits; decomp is carved out\n   484\t            # further down (once its intervals are built).  llm_brk is\n   485\t            # computed there, NOT here.\n   486\t            llm_active_intervals = self._subtract_intervals(\n   487\t                llm_intervals, wait_intervals)\n   488\t\n   489\t            # Frozen weight decomp uses a separate event pair\n   490\t            # (begin_frozen_decomp_events /\n   491\t            #  end_frozen_decomp_timing_events) keyed by\n   492\t            # (comp_key, layer_id), distinct from the sync-only\n   493\t            # frozen_decomp_events used for cross-stream waits and from\n   494\t            # the per-layer begin/end_decomp_events used by the offload\n   495\t            # path.  Collect intervals for frozen layers so WDecomp\n   496\t            # reflects both modes.\n   497\t            frozen_decomp_intervals = []\n   498\t            if (use_weight_comp\n   499\t                    and hasattr(self, \"begin_frozen_decomp_events\")\n   500\t                    and hasattr(self, \"end_frozen_decomp_timing_events\")):\n   501\t                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n   502\t                    begin_list = self.begin_frozen_decomp_events.get(\n   503\t                        comp_key, [])\n   504\t                    end_list = self.end_frozen_decomp_timing_events.get(\n   505\t                        comp_key, [])\n   506\t                    for layer_id in self.frozen_layers:\n   507\t                        if (layer_id >= len(begin_list)\n   508\t                                or layer_id >= len(end_list)):\n   509\t                            continue\n   510\t                        try:\n   511\t                            begin_t = init_event.elapsed_time(\n   512\t                                begin_list[layer_id])\n   513\t                            end_t = init_event.elapsed_time(\n   514\t                                end_list[layer_id])\n   515\t                        except RuntimeError:\n   516\t                            continue\n   517\t                        # Skip stale (pre-init) or zero-duration events.\n   518\t                        # Either side being pre-init means this layer\n   519\t                        # didn't actually decompress in this forward.\n   520\t                        if (begin_t < -0.01 or end_t < -0.01\n   521\t                                or end_t - begin_t < 0.001):\n   522\t                            continue\n   523\t                        frozen_decomp_intervals.append((begin_t, end_t))\n   524\t                frozen_decomp_intervals.sort(key=lambda x: x[0])\n   525\t\n   526\t            # frozen_split's per-(layer,name) decomp kernel uses its\n   527\t            # own lazy timing cache (the per-comp_key\n   528\t            # end_frozen_decomp_timing_events slots are written by the\n   529\t            # frozen_compressed paths, not by\n   530\t            # _decompress_frozen_split_for_name).\n   531\t            frozen_split_decomp_intervals = []\n   532\t            sd_begin_cache = getattr(\n   533\t                self,\n   534\t                \"_frozen_split_decomp_begin_timing_events_cache\",\n   535\t                None)\n   536\t            sd_end_cache = getattr(\n   537\t                self,\n   538\t                \"_frozen_split_decomp_end_timing_events_cache\",\n   539\t                None)\n   540\t            if sd_begin_cache and sd_end_cache:\n   541\t                for key, begin_ev in sd_begin_cache.items():\n   542\t                    end_ev = sd_end_cache.get(key)\n   543\t                    if end_ev is None:\n   544\t                        continue\n   545\t                    try:\n   546\t                        b_t = init_event.elapsed_time(begin_ev)\n   547\t                        e_t = init_event.elapsed_time(end_ev)\n   548\t                    except RuntimeError:\n   549\t                        continue\n   550\t                    if (b_t < -0.01 or e_t < -0.01\n   551\t                            or e_t - b_t < 0.001):\n   552\t                        continue\n   553\t                    frozen_split_decomp_intervals.append((b_t, e_t))\n   554\t                frozen_split_decomp_intervals.sort(key=lambda x: x[0])\n   555\t\n   556\t            all_weight_decomp_intervals = (\n   557\t                weight_decomp_intervals\n   558\t                + frozen_decomp_intervals\n   559\t                + frozen_split_decomp_intervals)\n   560\t            wdecomp_union: List[Tuple[float, float]] = []\n   561\t            wdecomp_brk = 0.0\n   562\t            if all_weight_decomp_intervals:\n   563\t                wdecomp_union = self._calc_exec_times(\n   564\t                    all_weight_decomp_intervals, [])\n   565\t                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\n   566\t\n   567\t            kvdecomp_union: List[Tuple[float, float]] = []\n   568\t            kvdecomp_brk = 0.0\n   569\t            if use_kv_comp and kv_decomp_intervals:\n   570\t                kvdecomp_union = self._calc_exec_times(\n   571\t                    kv_decomp_intervals, [])\n   572\t                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\n   573\t\n   574\t            # ── Separate Compute from WEIGHT Decomp ──\n   575\t            # The decode GEMM blocks on cur_stream until its WEIGHT\n   576\t            # decompression (on decomp_weight_stream) completes — the weight IS\n   577\t            # the GEMM operand, so the GEMM cannot start until decomp lands.\n   578\t            # Only ~6ms of that block surfaces as the in-graph _v1_wwait; the\n   579\t            # rest stays inside the exec window, which is why Compute(LLM) read\n   580\t            # ~= WDecomp ~= GPUFwd even though the real GEMM is tiny.  Carve the\n   581\t            # weight-decomp union out so Compute is GEMM+attention only.\n   582\t            #\n   583\t            # KV decode must NOT be carved (it used to be — that was a bug).\n   584\t            # It is prefetched one layer ahead (start_kv_decompress(L+1) in\n   585\t            # _before_replay(L), finish in _after_replay(L)) and runs on\n   586\t            # batch_decomp_stream CONCURRENTLY with the productive GEMM of the\n   587\t            # next graph piece — it does not block that GEMM.  Attention's real\n   588\t            # wait for its OWN layer's KV is the exec_attn_barrier, and that\n   589\t            # wait is ALREADY removed above via _v1_kv_wait (wait_intervals).\n   590\t            # Subtracting the decode interval a second time here removed real,\n   591\t            # concurrent GEMM from Compute, so Compute SHRANK when --kv-comp was\n   592\t            # enabled (C.A.O b128 165.6 → C.A.O+KVComp 139.0, exactly the ~22ms\n   593\t            # decode carved out) even though the real compute is unchanged.\n   594\t            # Leave KV decode in Compute and report it separately as KVDecomp,\n   595\t            # a concurrent stream-busy metric that overlaps Compute by design\n   596\t            # (so Compute + KVDecomp may exceed GPUFwd — that overlap is the\n   597\t            # decode being hidden under compute).  Stall is unaffected:\n   598\t            # compute_union below unions the decomp intervals back in anyway.\n   599\t            if wdecomp_union:\n   600\t                llm_active_intervals = self._subtract_intervals(\n   601\t                    llm_active_intervals, wdecomp_union)\n   602\t            llm_brk = sum(e - b for b, e in llm_active_intervals)\n   603\t\n   604\t            # Frozen_split mode H2D's the compressed-exp / aux LPDDR\n   605\t            # buffers every decode step on load_weight_stream (see\n   606\t            # _decompress_frozen_split_for_name).  These do NOT land in\n   607\t            # begin/end_memcpy_weight_events.  We pair the timing-only\n   608\t            # BEGIN/END cache (the sync _frozen_split_h2d_events is not\n   609\t            # enable_timing).\n   610\t            frozen_split_h2d_intervals = []\n   611\t            begin_cache = getattr(\n   612\t                self, \"_frozen_split_h2d_begin_events_cache\", None)\n   613\t            end_cache = getattr(\n   614\t                self, \"_frozen_split_h2d_end_timing_events_cache\", None)\n   615\t            if begin_cache and end_cache:\n   616\t                for key, begin_ev in begin_cache.items():\n   617\t                    end_ev = end_cache.get(key)\n   618\t                    if end_ev is None:\n   619\t                        continue\n   620\t                    try:\n   621\t                        b_t = init_event.elapsed_time(begin_ev)\n   622\t                        e_t = init_event.elapsed_time(end_ev)\n   623\t                    except RuntimeError:\n   624\t                        continue\n   625\t                    if (b_t < -0.01 or e_t < -0.01\n   626\t                            or e_t - b_t < 0.001):\n   627\t                        continue\n   628\t                    frozen_split_h2d_intervals.append((b_t, e_t))\n   629\t                frozen_split_h2d_intervals.sort(key=lambda x: x[0])\n   630\t\n   631\t            all_weight_load_intervals = (\n   632\t                weight_memcpy_times + frozen_split_h2d_intervals)\n   633\t            wload_union: List[Tuple[float, float]] = []\n   634\t            wload_brk = 0.0\n   635\t            if all_weight_load_intervals:\n   636\t                wload_union = self._calc_exec_times(\n   637\t                    all_weight_load_intervals, [])\n   638\t                wload_brk = sum(e - b for b, e in wload_union)\n   639\t\n   640\t            # Diagnostic: count how many intervals reached each bucket so\n   641\t            # we can tell whether wload_brk is low because intervals were\n   642\t            # filtered (stale events) or because the union truly is small.\n   643\t            if not self.batch_has_prefill and os.getenv(\n   644\t                    \"TIERED_SERVE_BREAKDOWN_VERBOSE\", \"0\") == \"1\":\n   645\t                wmt_sum = sum(e - b for b, e in weight_memcpy_times)\n   646\t                fsi_sum = sum(e - b for b, e in frozen_split_h2d_intervals)\n   647\t                logger.info(\n   648\t                    \"[WLoadDbg] weight_memcpy: n=%d sum=%.2fms | \"\n   649\t                    \"frozen_split_h2d: n=%d sum=%.2fms | \"\n   650\t                    \"union=%.2fms (cache_size begin=%d end=%d)\",\n   651\t                    len(weight_memcpy_times), wmt_sum,\n   652\t                    len(frozen_split_h2d_intervals), fsi_sum,\n   653\t                    wload_brk,\n   654\t                    len(begin_cache or {}),\n   655\t                    len(end_cache or {}))\n   656\t\n   657\t            kvload_union: List[Tuple[float, float]] = []\n   658\t            kvload_brk = 0.0\n   659\t            # KVLoad = the wall-clock the KV stream actually spends moving KV\n   660\t            # H2D, measured DIRECTLY by the CUDA events that bracket each\n   661\t            # layer's transfer: the raw load_kv_stream memcpys (begin/\n   662\t            # end_memcpy_kv) plus the compressed-blob H2D on batch_decomp_stream\n   663\t            # (_kv_h2d_begin .. _kv_dec_h2d).  Union-merge so back-to-back\n   664\t            # intervals on the one stream aren't double-counted, then sum.\n   665\t            # NO weight-overlap subtraction: KV H2D and weight H2D serialise on\n   666\t            # the single GH200 copy engine, so they never overlap in wall-clock\n   667\t            # and there is nothing to attribute away.\n   668\t            # Compressed-KV path: the H2D is the dedicated load_kv_stream blob\n   669\t            # transfer, bracketed TIGHTLY by _kv_h2d_begin .. _kv_dec_h2d.  Use\n   670\t            # that alone — the loader's begin/end_memcpy_kv span ALSO covers the\n   671\t            # double-buffer consumed-wait that precedes the H2D, which would\n   672\t            # inflate KVLoad with the previous layer's decode time.  Raw KV has\n   673\t            # no _kv_h2d events, so fall back to the load_kv_stream memcpys.\n   674\t            if kv_h2d_intervals:\n   675\t                # KVLoad = Σ each layer's KV H2D begin..end elapsed_time, read\n   676\t                # DIRECTLY from the tight _kv_h2d_begin.._kv_dec_h2d events — the\n   677\t                # real per-transfer engine time.  NO union-merge: the per-layer\n   678\t                # intervals are disjoint on the load stream (union == sum), and\n   679\t                # the raw event elapsed_time is the source of truth.  Under the\n   680\t                # single-stream (H2D-on-weight) layout each layer's KV H2D runs\n   681\t                # in its own engine slot, so this reads the clean ~raw/ratio\n   682\t                # transfer (~0.29 ms/layer) instead of the inflated value the KV\n   683\t                # op showed when it queued behind weight on a separate stream.\n   684\t                kvload_brk = sum(e - b for b, e in kv_h2d_intervals)\n   685\t            else:\n   686\t                # Raw KV on a separate stream: the begin/end_memcpy_kv bracket is\n   687\t                # inflated (absorbs prefetched weight on the shared link).  Don't\n   688\t                # use it directly.  KVLoad = engine_busy_union − WLoad: the union\n   689\t                # of weight ∪ KV intervals is inflation-immune (the absorbed\n   690\t                # weight is double-counted and the merge cancels it → true H2D\n   691\t                # engine-busy), and wload_brk is the clean head-of-queue weight\n   692\t                # union.  Additive by construction, zero perturbation, validated\n   693\t                # vs nsys (union 150.79 − weight 112.92 = 37.87 ≈ KV 37.86 @b64).\n   694\t                # (Same recovery as kv_load_time above; see that comment.)\n   695\t                engine_busy_union = sum(\n   696\t                    e - b for b, e in self._calc_exec_times(\n   697\t                        all_weight_