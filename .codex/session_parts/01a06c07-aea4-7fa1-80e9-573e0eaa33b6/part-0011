{"timestamp":"2026-09-04T11:23:15.480Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c28-9a98-71a2-af38-49f41c78beb7","call_id":"call_L2JyarlqTXredJgQUihJTxKu","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        use_kv_comp = DualMemoryLoader.use_kv_comp\n\n        # Count/clamp every timing interval against this forward.  Reset the\n        # diagnostics before the first _calc_intervals call.\n        self._timing_window_clip_count = 0\n        self._timing_window_drop_count = 0\n\n        # ── Compute intervals ──\n        # begin_exec/end_exec is a graph-piece ENVELOPE.  It includes queue and\n        # transitive dependency idle, so it is useful for diagnostics but is\n        # never a valid source for productive Compute.\n        llm_intervals = self._calc_intervals(\n            init_event, self.begin_exec_events, self.end_exec_events,\n            total_time)\n        if llm_intervals:\n            llm_intervals = self._calc_exec_times(llm_intervals, [])\n\n        # Productive projection markers are baked into compiled graph pieces by\n        # graph_wait_ops; V1 eager attention is bracketed by its neighbouring\n        # graph wrappers.  Require the full 5-per-layer set.  A partial set is\n        # reported as unavailable rather than silently using ExecResidual.\n        kernel_intervals = self._calc_intervals(\n            init_event, self.begin_kernel_events, self.end_kernel_events,\n            total_time, require_contained=True)\n        expected_compute_markers = 5 * self.n_layers\n        compute_markers_valid = (\n            len(kernel_intervals) == expected_compute_markers)\n        # Keep each marker associated with its (layer, component) id.  The\n        # aggregate list above is sorted by timestamp, so it cannot be used to\n        # classify a particular projection after the fact.\n        marker_intervals_by_id = {}\n        if compute_markers_valid:\n            for event_id in range(expected_compute_markers):\n                interval = self._calc_intervals(\n                    init_event,\n                    [self.begin_kernel_events[event_id]],\n                    [self.end_kernel_events[event_id]],\n                    total_time, require_contained=True,\n                    count_invalid=False)\n                if len(interval) != 1:\n                    compute_markers_valid = False\n                    marker_intervals_by_id = {}\n                    break\n                marker_intervals_by_id[event_id] = interval\n\n        # Registry presence means that the projection is routed through\n        # linear_apply, not that the codec necessarily chose its fused kernel.\n        # ZipServ/P4Flat/CD3 can decide at runtime to do\n        # decompress + F.linear instead.  In that case entry[8:10] brackets\n        # only the fallback decompression; subtract it from the projection\n        # marker and attribute the remaining dense GEMM to DenseCompute.\n        # A true fused kernel has no such event and stays inseparable in\n        # FusedWeightCompute.  Large eager prefill has a third route: it reads\n        # the raw BF16 primary directly, so the entire marker is dense.\n        fused_override_entries = {}\n        fused_reg = getattr(self, \"_fused_reg\", None)\n        kernel_slot_by_comp = (0, 1, 3, 4)\n        if fused_reg:\n            for layer_id in range(self.n_layers):\n                for comp_id, kernel_slot in enumerate(kernel_slot_by_comp):\n                    reg_idx = layer_id * 4 + comp_id\n                    if (reg_idx < len(fused_reg)\n                            and fused_reg[reg_idx] is not None):\n                        fused_override_entries[\n                            5 * layer_id + kernel_slot] = fused_reg[reg_idx]\n        actual_fused_event_ids = set()\n        fallback_dense_event_ids = set()\n        raw_prefill_dense_event_ids = set()\n        fused_weight_compute_intervals = []\n        dense_compute_intervals = []\n        if compute_markers_valid:\n            for event_id in range(expected_compute_markers):\n                projection_interval = marker_intervals_by_id[event_id]\n                entry = fused_override_entries.get(event_id)\n                if entry is None:\n                    dense_compute_intervals.extend(projection_interval)\n                    continue\n\n                ceiling = int(getattr(self, \"_cudagraph_ceiling\", 0) or 0)\n                is_raw_prefill_fallback = bool(\n                    self.batch_has_prefill\n                    and len(entry) > 10 and entry[10] is not None\n                    and ceiling\n                    and int(getattr(self, \"cur_num_tokens\", 0)) > ceiling)\n                if is_raw_prefill_fallback:\n                    raw_prefill_dense_event_ids.add(event_id)\n                    dense_compute_intervals.extend(projection_interval)\n                    continue\n\n                fallback_decomp = []\n                if (len(entry) > 9\n                        and entry[8] is not None and entry[9] is not None):\n                    candidate = self._calc_intervals(\n                        init_event, [entry[8]], [entry[9]], total_time,\n                        require_contained=True, count_invalid=False)\n                    # The event pool is reused.  Only a decomp interval nested\n                    # in this projection marker proves that this invocation\n                    # actually took the fallback route.\n                    marker_begin, marker_end = projection_interval[0]\n                    fallback_decomp = [\n                        interval for interval in candidate\n                        if (interval[0] >= marker_begin - 0.01\n                            and interval[1] <= marker_end + 0.01)]\n\n                if fallback_decomp:\n                    fallback_dense_event_ids.add(event_id)\n                    dense_compute_intervals.extend(self._subtract_intervals(\n                        projection_interval, fallback_decomp))\n                else:\n                    actual_fused_event_ids.add(event_id)\n                    fused_weight_compute_intervals.extend(projection_interval)\n\n            dense_compute_intervals = self._calc_exec_times(\n                dense_compute_intervals, [])\n            fused_weight_compute_intervals = self._calc_exec_times(\n                fused_weight_compute_intervals, [])\n        productive_compute_intervals = (\n            self._calc_exec_times(\n                dense_compute_intervals, fused_weight_compute_intervals)\n            if compute_markers_valid else [])\n        llm_time = sum(e - b for b, e in llm_intervals)\n\n        # ── Weight decompression intervals (only when compressed) ──\n        weight_decomp_time = 0.0\n        overlap_time = 0.0\n        weight_decomp_intervals = []\n        if use_weight_comp and load_comp_weight:\n            # Include all not-frozen layers' decomp events.\n            # Stale events (from layers that didn't actually decompress)\n            # are filtered by the begin_time / duration checks below.\n            weight_decomp_intervals = self._calc_intervals(\n            # further down (once its intervals are built).  llm_brk is\n            # computed there, NOT here.\n            exec_residual_intervals = self._subtract_intervals(\n                llm_intervals, wait_intervals)\n\n            # Frozen weight decomp uses a separate event pair\n            # (begin_frozen_decomp_events /\n            #  end_frozen_decomp_timing_events) keyed by\n            # (comp_key, layer_id), distinct from the sync-only\n            # frozen_decomp_events used for cross-stream waits and from\n            # the per-layer begin/end_decomp_events used by the offload\n            # path.  Collect intervals for frozen layers so WDecomp\n            # reflects both modes.\n            frozen_decomp_intervals = []\n            if (use_weight_comp\n                    and hasattr(self, \"begin_frozen_decomp_events\")\n                    and hasattr(self, \"end_frozen_decomp_timing_events\")):\n                frozen_decomp_begin = []\n                frozen_decomp_end = []\n                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                    begin_list = self.begin_frozen_decomp_events.get(\n                        comp_key, [])\n                    end_list = self.end_frozen_decomp_timing_events.get(\n                        comp_key, [])\n                    # These pools are also bound to fused overrides on\n                    # offload_compressed (non-frozen) layers.  Such a cell can\n                    # take the runtime decompress+linear fallback and records\n                    # its WDecomp here, not in begin/end_decomp_events.\n                    for layer_id in range(self.n_layers):\n                        if (layer_id >= len(begin_list)\n                                or layer_id >= len(end_list)):\n                            continue\n                        frozen_decomp_begin.append(begin_list[layer_id])\n                        frozen_decomp_end.append(end_list[layer_id])\n                frozen_decomp_intervals = self._calc_intervals(\n                    init_event, frozen_decomp_begin, frozen_decomp_end,\n                    total_time)\n\n            # frozen_split's per-(layer,name) decomp kernel uses its\n            # own lazy timing cache (the per-comp_key\n            # end_frozen_decomp_timing_events slots are written by the\n            # frozen_compressed paths, not by\n            # _decompress_frozen_split_for_name).\n            frozen_split_decomp_intervals = []\n            sd_begin_cache = getattr(\n                self,\n                \"_frozen_split_decomp_begin_timing_events_cache\",\n                None)\n            sd_end_cache = getattr(\n                self,\n                \"_frozen_split_decomp_end_timing_events_cache\",\n                None)\n            if sd_begin_cache and sd_end_cache:\n                split_decomp_keys = [\n                    key for key in sd_begin_cache if key in sd_end_cache]\n                frozen_split_decomp_intervals = self._calc_intervals(\n            #   ExecResidual — graph-piece envelope after known waits/WDecomp;\n            #              diagnostic only, never substituted for Compute.\n            #   WDecomp  — weight decompression on decomp_weight_stream\n            #   KVDecomp — KV decompression on the KV decomp stream(s).  This\n            #              runs CONCURRENTLY with ProductiveCompute (it is\n            #              prefetched a layer ahead), so it is NOT carved out and\n            #              is NOT part of the additive GPUFwd tiling — it is a\n            #              standalone stream-busy figure that overlaps it.\n            #   WLoad    — weight H2D on load_weight_stream\n            #   KVLoad   — KV H2D on load_kv_stream\n            #   ExposedLoad — load-active wall time with no recorded productive\n            #              compute/decompression.  Stall is a compatibility\n            #              alias, not total GPU idle.\n            def _fmt_metric(value):\n                return \"NA\" if value is None else f\"{value:.4f}\"\n\n            brk_msg = (\n                f\"{prefix} [Breakdown] \"\n                f\"GPUFwd: {total_time:.4f} | \"\n                f\"Compute: {_fmt_metric(llm_brk)} \"\n                f\"WDecomp: {wdecomp_brk:.4f} \"\n                f\"KVDecomp: {kvdecomp_brk:.4f} \"\n                f\"WLoad: {wload_brk:.4f} \"\n                f\"KVLoad: {kvload_brk:.4f} \"\n                f\"Stall: {_fmt_metric(stall_brk)} \"\n                f\"DenseCompute: {_fmt_metric(dense_compute_brk)} \"\n                f\"FusedWeightCompute: \"\n                f\"{_fmt_metric(fused_weight_compute_brk)} \"\n                f\"ProductiveCompute: \"\n                f\"{_fmt_metric(productive_compute_brk)} \"\n                f\"ExecResidual: {exec_residual_brk:.4f} \"\n                f\"ExposedLoad: {_fmt_metric(exposed_load_brk)} \"\n                f\"Unclassified: {_fmt_metric(unclassified_brk)} \"\n                f\"ComputeMarkers: {len(kernel_intervals)}/\"\n                f\"{expected_compute_markers} \"\n                f\"FusedRoutes: {len(actual_fused_event_ids)}/\"\n                f\"{len(fallback_dense_event_ids)}/\"\n                f\"{len(fused_override_entries)} \"\n                f\"RawPrefillDense: {len(raw_prefill_dense_event_ids)} \"\n                f\"WindowClip: {self._timing_window_clip_count} \"\n                f\"WindowDrop: {self._timing_window_drop_count} \"\n                f\"Instrumented: 1\")\n            # Both phases' breakdowns are accumulated (see below) and logged\n            # once per batch by the benchmark driver\n            # (offline_offload_kvweight.py); the per-step console line is\n            # suppressed for BOTH so the console isn't spammed one line per\n            # step.  File + nvtx keep the full per-step record regardless.\n            if self._time_log_file is not None:\n                self._time_log_file.write(brk_msg + \"\\n\")\n                self._time_log_file.flush()\n            torch.cuda.nvtx.mark(brk_msg)\n\n            # Expose the breakdown as a plain dict for the benchmark driver\n            # and diagnostics.  Overwritten each calc_times call; prefill /\n            # decode are distinguishable via the \"is_prefill\" field.\n            self.last_breakdown = {\n                \"is_prefill\": self.batch_has_prefill,\n                \"gpu_fwd_ms\": total_time,\n                \"compute_ms\": llm_brk,\n                \"dense_compute_ms\": dense_compute_brk,\n                \"fused_weight_compute_ms\": fused_weight_compute_brk,\n                \"productive_compute_ms\": productive_compute_brk,\n                \"exec_residual_ms\": exec_residual_brk,\n                \"wdecomp_ms\": wdecomp_brk,\n                \"kvdecomp_ms\": kvdecomp_brk,\n                \"wload_ms\": wload_brk,\n                \"kvload_ms\": kvload_brk,\n                \"stall_ms\": stall_brk,\n                \"exposed_load_ms\": exposed_load_brk,\n                \"unclassified_ms\": unclassified_brk,\n                \"compute_markers\": len(kernel_intervals),\n                \"compute_markers_expected\": expected_compute_markers,\n                \"fused_override_markers\": len(fused_override_entries),\n                \"fused_kernel_markers\": len(actual_fused_event_ids),\n                \"fused_fallback_markers\": len(fallback_dense_event_ids),\n                \"raw_prefill_dense_markers\": len(\n                validate_semantic_answers(\n                    semantic_prompt,\n                    gen_tokens,\n                    expected_count=batch,\n                    expected_text=args.expect_text,\n                    logger=logger,\n                )\n\n            # One TPOT sample per request.  Warmup is applied in the request's\n            # inter-token domain, not by discarding arbitrary batch steps.\n            for request_id, stamps in token_times.items():\n                n_intervals = len(stamps) - 1\n                dropped = min(args.warmup, n_intervals)\n                kept = n_intervals - dropped\n                if kept > 0:\n                    tpots.append(\n                        (stamps[-1] - stamps[dropped]) * 1000 / kept)\n            if args.warmup > 0 and tpots:\n                logger.info(\n                    \"TPOT warmup: excluded first %d inter-token interval(s) \"\n                    \"per request (%d request samples)\",\n                    args.warmup, len(tpots))\n            if decode_step_latencies:\n                logger.info(\n                    \"DecodeStepLatency(ms) Mean: %.2f Median: %.2f \"\n                    \"(batch-step domain, %d samples)\",\n                 