=6\nKV_ADDR_ORDER=1\nKV_LOCALITY=0\nKV_RANDOM_ALLOC=0\nNUM_PROMPTS=1200\nSKIP_FIRST_N_REQUESTS=100\nSKIP_LAST_N_REQUESTS=100\n# 1-based send-order prefix.  Zero means wait for all NUM_PROMPTS requests.\nSTOP_AFTER_REQUEST=0\n\nNUMA_NODE=0\nGPU_INDEX=0\nSTARTUP_TIMEOUT=900\nSHUTDOWN_TIMEOUT=120\nCLEANUP_TIMEOUT=180\nMAX_IDLE_HBM_MIB=1024\nOUTPUT_ROOT=\"${REPO_ROOT}/benchmark_results/serving_suite\"\nDRY_RUN=0\nCHECK_ONLY=0\nBREAKDOWN=0\nSMOKE=0\n\nusage() {\n  cat <<'EOF'\nUsage: scripts/serving/run_performance_suite.sh [options]\n\nRuns isolated llama70b serving experiments. Every combination of KV mode,\nchunk size, request rate, and repeat gets a fresh server process.\n\nOptions:\n  --codecs LIST                 p4flat,cd3 (default: p4flat,cd3)\n  --modes LIST                  raw,kvcomp (default: raw,kvcomp)\n  --chunks LIST                 Comma-separated max_num_batched_tokens\n                                (default: 2048,4096,8192)\n  --request-rates LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 1)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --stop-after-request N        Stop after send-order requests 1..N have all\n                                completed. Later requests keep arriving until\n                                then and are cancelled at the boundary. Use\n                                1100 to preserve the default 1200/100/100\n                                measurement window; 0 waits for all (default)\n  --breakdown                   Record a detailed timing breakdown for every\n                                server forward iteration\n  --smoke                       Run two requests without percentile trimming;\n                                validates startup and request handling only\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --codecs cd3\n  scripts/serving/run_performance_suite.sh --codecs p4flat,cd3 --chunks 8192\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --stop-after-request 1100\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\n  scripts/serving/run_performance_suite.sh --chunks 8192 --breakdown\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --codecs)\n      (($# >= 2)) || die \"--codecs requires a value\"\n      parse_csv \"$2\" CODECS\n      shift 2\n      ;;\n    --modes)\n      (($# >= 2)) || die \"--modes requires a value\"\n      parse_csv \"$2\" MODES\n      shift 2\n      ;;\n    --chunks)\n      (($# >= 2)) || die \"--chunks requires a value\"\n      parse_csv \"$2\" CHUNKS\n      shift 2\n      ;;\n    --request-rates)\n      (($# >= 2)) || die \"--request-rates requires a value\"\n      parse_csv \"$2\" REQUEST_RATES\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --max-num-seqs)\n      (($# >= 2)) || die \"--max-num-seqs requires a value\"\n      MAX_NUM_SEQS=\"$2\"\n      shift 2\n      ;;\n    --dedicated-kv-blocks)\n      (($# >= 2)) || die \"--dedicated-kv-blocks requires a value\"\n      DEDICATED_KV_BLOCKS=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --weight-buffers)\n      (($# >= 2)) || die \"--weight-buffers requires a value\"\n      WEIGHT_BUFFERS=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --stop-after-request)\n      (($# >= 2)) || die \"--stop-after-request requires a value\"\n      STOP_AFTER_REQUEST=\"$2\"\n      shift 2\n      ;;\n    --breakdown)\n      BREAKDOWN=1\n      shift\n      ;;\n    --smoke)\n      SMOKE=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\nrequire_uint stop-after-request \"$STOP_AFTER_REQUEST\"\n\nCLIENT_NUM_PROMPTS=$((SMOKE ? 2 : NUM_PROMPTS))\nCLIENT_SKIP_FIRST_N_REQUESTS=$((SMOKE ? 0 : SKIP_FIRST_N_REQUESTS))\nCLIENT_SKIP_LAST_N_REQUESTS=$((SMOKE ? 0 : SKIP_LAST_N_REQUESTS))\nif ((STOP_AFTER_REQUEST > 0)); then\n  ((STOP_AFTER_REQUEST <= CLIENT_NUM_PROMPTS)) \\\n    || die \"--stop-after-request (${STOP_AFTER_REQUEST}) exceeds num prompts (${CLIENT_NUM_PROMPTS})\"\n  ((STOP_AFTER_REQUEST > CLIENT_SKIP_FIRST_N_REQUESTS)) \\\n    || die \"--stop-after-request must leave at least one measured request after the leading trim\"\nfi\n\nfor codec in \"${CODECS[@]}\"; do\n  [[ \"$codec\" == p4flat || \"$codec\" == cd3 ]] \\\n    || die \"unsupported codec: ${codec}\"\ndone\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not-executable=${CLIENT_SCRIPT}\")\n\n  for required in nvidia-smi numactl setsid curl findmnt awk sed grep tee; do\n    command -v \"$required\" >/dev/null || problems+=(\"command-missing=${required}\")\n  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  local codec config expected\n  for codec in \"${CODECS[@]}\"; do\n    if [[ \"$codec\" == p4flat ]]; then\n      expected=p4flat\n      for config in \"$P4_RAW_CONFIG\" \"$P4_KVCOMP_CONFIG\"; do\n        [[ -e \"$config\" ]] || problems+=(\"missing=${config}\")\n        grep -Eq \"compressor:[[:space:]]*${expected}\" \"$config\" \\\n          2>/dev/null || problems+=(\"config-codec-mismatch=${config}:${expected}\")\n      done\n    else\n      expected=chunk_delta3\n      config=\"$CD3_CONFIG\"\n      [[ -e \"$config\" ]] || problems+=(\"missing=${config}\")\n      grep -Eq \"compressor:[[:space:]]*${expected}\" \"$config\" \\\n        2>/dev/null || problems+=(\"config-codec-mismatch=${config}:${expected}\")\n    fi\n  done\n\n  if ((${#problems[@]})); then\n    printf '[suite] ERROR: preflight failed: %s\\n' \"$(IFS='; '; echo \"${problems[*]}\")\" >&2\n    return 1\n  fi\n}\n\nmapfile -t INHERITED_TIERED_ENV < <(compgen -e | awk '/^TIERED_SERVE_/ { print }' | sort)\nCLEAN_ENV=(env -u LD_PRELOAD -u RESULT_DIR -u CUDA_VISIBLE_DEVICES \\\n  -u VLLM_DISABLE_COMPILE_CACHE -u PYTORCH_CUDA_ALLOC_CONF)\nfor inherited_var in \"${INHERITED_TIERED_ENV[@]}\"; do\n  CLEAN_ENV+=(-u \"$inherited_var\")\ndone\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type port_hex\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+=(\"nvidia-smi-query-failed\")\n    gpu_line=\",\"\n  fi\n  IFS=',' read -r hbm_used gpu_util <<<\"$gpu_line\"\n  if [[ ! \"$hbm_used\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-hbm=${hbm_used:-empty}\")\n  elif ((hbm_used > MAX_IDLE_HBM_MIB)); then\n    problems+=(\"hbm=${hbm_used}MiB>${MAX_IDLE_HBM_MIB}MiB\")\n  fi\n  if [[ ! \"$gpu_util\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-gpu-util=${gpu_util:-empty}\")\n  elif ((gpu_util != 0)); then\n    problems+=(\"gpu-util=${gpu_util}%\")\n  fi\n\n  gpu_apps=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-compute-apps=pid,process_name,used_memory \\\n      --format=csv,noheader,nounits 2>/dev/null | sed '/^[[:space:]]*$/d' || true)\"\n  [[ -z \"$gpu_apps\" ]] || problems+=(\"gpu-processes=${gpu_apps//$'\\n'/ | }\")\n\n  if [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]]; then\n    hp_total=\"$(<\"${HUGEPAGE_SYSFS}/nr_hugepages\")\"\n    hp_free=\"$(<\"${HUGEPAGE_SYSFS}/free_hugepages\")\"\n    if [[ -r \"${HUGEPAGE_SYSFS}/resv_hugepages\" ]]; then\n      hp_reserved=\"$(<\"${HUGEPAGE_SYSFS}/resv_hugepages\")\"\n    else\n      hp_reserved=\"n/a\"\n    fi\n    if [[ \"$hp_total\" =~ ^[0-9]+$ ]] && ((hp_total < WEIGHT_HUGE_PAGES)); then\n      problems+=(\"hugepages-total=${hp_total}<weight-pages=${WEIGHT_HUGE_PAGES}\")\n    fi\n    [[ \"$hp_total\" == \"$hp_free\" ]] || problems+=(\"hugepages-free=${hp_free}/${hp_total}\")\n    [[ \"$hp_reserved\" == n/a || \"$hp_reserved\" == 0 ]] || problems+=(\"hugepages-reserved=${hp_reserved}\")\n  else\n    hp_total=\"?\"\n    hp_free=\"?\"\n    hp_reserved=\"?\"\n    problems+=(\"16GiB-hugepage-sysfs-missing\")\n  fi\n\n  mount_type=\"$(findmnt -n -o FSTYPE /mnt/hugepages 2>/dev/null || true)\"\n  [[ \"$mount_type\" == hugetlbfs ]] || problems+=(\"/mnt/hugepages=${mount_type:-not-mounted}\")\n\n  printf -v port_hex '%04X' \"$PORT\"\n  if awk -v suffix=\":${port_hex}\" \\\n      '$2 ~ suffix \"$\" && $4 == \"0A\" { found=1 } END { exit !found }' \\\n      /proc/net/tcp /proc/net/tcp6 2>/dev/null; then\n    problems+=(\"port-${PORT}=in-use\")\n  fi\n\n  if ((${#problems[@]})); then\n    LAST_STATE_DETAIL=\"$(IFS='; '; echo \"${problems[*]}\")\"\n    return 1\n  fi\n  LAST_STATE_DETAIL=\"gpu=${GPU_INDEX} hbm=${hbm_used}MiB util=${gpu_util}% hugepages=${hp_free}/${hp_total}\"\n  return 0\n}\n\nwait_for_clean_state() {\n  local context=\"$1\"\n  local deadline=$((SECONDS + CLEANUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ! capture_clean_state; do\n    if ((SECONDS >= deadline)); then\n      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n      next_report=$((SECONDS + 15))\n    fi\n    sleep 2\n  done\n  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n}\n\nsanitize_id() {\n  local value=\"$1\"\n  value=\"${value//./p}\"\n  value=\"${value//\\//_}\"\n  printf '%s' \"$value\"\n}\n\nquote_command() {\n  printf '%q ' \"$@\"\n  printf '\\n'\n}\n\nCMD=()\nbuild_server_command() {\n  local codec=\"$1\"\n  local mode=\"$2\"\n  local chunk=\"$3\"\n  local config weight_codec kv_backend\n  local -a mode_args=()\n  local -a codec_env=()\n  local -a breakdown_args=()\n\n  if [[ \"$codec\" == p4flat ]]; then\n    weight_codec=p4flat\n    kv_backend=p4flat\n    if [[ \"$mode\" == kvcomp ]]; then\n      config=\"$P4_KVCOMP_CONFIG\"\n    else\n      config=\"$P4_RAW_CONFIG\"\n    fi\n  else\n    weight_codec=chunk_delta3\n    kv_backend=chunk_delta3\n    config=\"$CD3_CONFIG\"\n    codec_env=(\"TIERED_SERVE_CD3_FUSED_MAX_N=128\")\n  fi\n\n  if [[ \"$mode\" == kvcomp ]]; then\n    mode_args=(--kv-comp \"$kv_backend\")\n  fi\n  if ((BREAKDOWN)); then\n    # Serving calls the detailed per-forward breakdown mode --collect-time.\n    # It records both the legacy timing line and the granular [Breakdown] line.\n    breakdown_args=(--collect-time)\n  fi\n\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n    \"LD_PRELOAD=${STACK_POOL_SO}\"\n    \"VLLM_DISABLE_COMPILE_CACHE=1\"\n    \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\"\n    \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n    \"TIERED_SERVE_N_WEIGHT_BUFFERS=${WEIGHT_BUFFERS}\"\n    \"TIERED_SERVE_DEDICATED_KV_BLOCKS=${DEDICATED_KV_BLOCKS}\"\n    \"TIERED_SERVE_GPU_RESERVE_GIB=${GPU_RESERVE_GIB}\"\n    \"TIERED_SERVE_KV_ADDR_ORDER=${KV_ADDR_ORDER}\"\n    \"TIERED_SERVE_KV_LOCALITY=${KV_LOCALITY}\"\n    \"TIERED_SERVE_KV_RANDOM_ALLOC=${KV_RANDOM_ALLOC}\"\n    \"${codec_env[@]}\"\n    numactl --cpunodebind=\"$NUMA_NODE\" --membind=\"$NUMA_NODE\"\n    \"$PYTHON_BIN\" \"$SERVER_SCRIPT\"\n    --model \"$MODEL_PATH\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --no-enable-prefix-caching\n    --chunked-prefill\n    --max-context-len \"$MAX_CONTEXT_LEN\"\n    --max-num-batched-tokens \"$chunk\"\n    --max-num-seqs \"$MAX_NUM_SEQS\"\n    --weight-comp \"$weight_codec\"\n    --fused-mm\n    \"${mode_args[@]}\"\n    \"${breakdown_args[@]}\"\n    --ts-configs \"$config\"\n    --host 127.0.0.1\n    --port \"$PORT\"\n  )\n}\n\nbuild_client_command() {\n  local result_dir=\"$1\"\n  local label=\"$2\"\n  local rate=\"$3\"\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=\"\n    \"PATH=${REPO_ROOT}/.venv/bin:${PATH}\"\n    \"RESULT_DIR=${result_dir}\"\n    \"AZURE_CONV_NUM_PROMPTS=${CLIENT_NUM_PROMPTS}\"\n    \"AZURE_CONV_SKIP_FIRST_N_REQUESTS=${CLIENT_SKIP_FIRST_N_REQUESTS}\"\n    \"AZURE_CONV_SKIP_LAST_N_REQUESTS=${CLIENT_SKIP_LAST_N_REQUESTS}\"\n    \"AZURE_CONV_STOP_AFTER_REQUEST=${STOP_AFTER_REQUEST}\"\n    bash \"$CLIENT_SCRIPT\" \"$MODEL_ALIAS\" \"$label\" \"$rate\"\n  )\n}\n\nwait_for_server() {\n  local pid=\"$1\"\n  local deadline=$((SECONDS + STARTUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ((SECONDS < deadline)); do\n    if curl -fsS \"http://127.0.0.1:${PORT}/health\" >/dev/null 2>&1; then\n      echo \"[suite] server is ready\"\n      return 0\n    fi\n    if ! kill -0 \"$pid\" 2>/dev/null; then\n      echo \"[suite] ERROR: server exited before becoming ready\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for server readiness\"\n      next_report=$((SECONDS + 30))\n    fi\n    sleep 2\n  done\n  echo \"[suite] ERROR: server readiness timed out after ${STARTUP_TIMEOUT}s\" >&2\n  return 1\n}\n\nprocess_group_alive() {\n  local pgid=\"$1\"\n  ps -eo pgid=,stat= | awk -v pgid=\"$pgid\" '$1 == pgid && $2 !~ /^Z/ { found=1 } END { exit !found }'\n}\n\nwait_for_group_exit() {\n  local pgid=\"$1\"\n  local timeout=\"$2\"\n  local deadline=$((SECONDS + timeout))\n  while process_group_alive \"$pgid\"; do\n    ((SECONDS < deadline)) || return 1\n    sleep 1\n  done\n  return 0\n}\n\nSERVER_PGID=\"\"\nCLIENT_PGID=\"\"\nSERVER_EXIT_STATUS=\"-\"\nSERVER_STOP_KIND=\"not-started\"\n\nstop_server() {\n  local pgid=\"$SERVER_PGID\"\n  [[ -n \"$pgid\" ]] || return 0\n\n  if process_group_alive \"$pgid\"; then\n    SERVER_STOP_KIND=\"interrupt\"\n    echo \"[suite] stopping server process group ${pgid} with SIGINT\"\n    kill -INT -- \"-${pgid}\" 2>/dev/null || true\n    if ! wait_for_group_exit \"$pgid\" \"$SHUTDOWN_TIMEOUT\"; then\n      SERVER_STOP_KIND=\"term\"\n      echo \"[suite] server did not stop after SIGINT; sending SIGTERM\" >&2\n      kill -TERM -- \"-${pgid}\" 2>/dev/null || true\n      if ! wait_for_group_exit \"$pgid\" 30; then\n        SERVER_STOP_KIND=\"kill\"\n        echo \"[suite] server did not stop after SIGTERM; sending SIGKILL\" >&2\n        kill -KILL -- \"-${pgid}\" 2>/dev/null || true\n        wait_for_group_exit \"$pgid\" 15 || true\n      fi\n    fi\n  else\n    SERVER_STOP_KIND=\"already-exited\"\n  fi\n\n  set +e\n  wait \"$pgid\" 2>/dev/null\n  SERVER_EXIT_STATUS=$?\n  set -e\n  SERVER_PGID=\"\"\n}\n\nstop_client() {\n  local pgid=\"$CLIENT_PGID\"\n  [[ -n \"$pgid\" ]] || return 0\n  if process_group_alive \"$pgid\"; then\n    echo \"[suite] stopping client process group ${pgid}\" >&2\n    kill -TERM -- \"-${pgid}\" 2>/dev/null || true\n    if ! wait_for_group_exit \"$pgid\" 30; then\n      kill -KILL -- \"-${pgid}\" 2>/dev/null || true\n      wait_for_group_exit \"$pgid\" 15 || true\n    fi\n  fi\n  set +e\n  wait \"$pgid\" 2>/dev/null\n  set -e\n  CLIENT_PGID=\"\"\n}\n\ncleanup_active_groups