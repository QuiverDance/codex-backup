{"timestamp":"2026-09-04T12:59:55.614Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c81-1b5e-7411-b3e1-1128e7408826","call_id":"call_FVr4brQu8zbK0u5bcuPpNZaz","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        skip_first_n: Number of leading requests (in send order) to exclude\n            from the aggregated metrics (warmup).\n        skip_last_n: Number of trailing requests (in send order) to exclude\n            from the aggregated metrics (cooldown).\n\n    Returns:\n        A tuple of the benchmark metrics and the actual output lengths.\n    \"\"\"\n    n = len(outputs)\n    # Warmup/cooldown trim: only requests whose send-order index falls in\n    # [window_lo, window_hi) are counted toward the aggregated metrics. The\n    # per-request detail (``actual_output_lens`` and ``outputs[i].tpot``) is\n    # still populated for every request so detailed dumps stay aligned.\n    window_lo = max(0, skip_first_n)\n    # ``outputs`` can be an intentionally completed prefix under\n    # --stop-after-request. Keep the trailing trim anchored to the original\n    # offered list, not to that shorter prefix.\n    window_hi = min(n, len(input_requests) - max(0, skip_last_n))\n    if window_hi <= window_lo:\n        # Degenerate window (would skip everything) — disable trimming.\n        window_lo, window_hi = 0, n\n\n    actual_output_lens: list[int] = []\n    total_input = 0\n    total_output = 0\n    completed = 0\n        \"sz_p50\": float(np.percentile(arr, 50)),\n        \"sz_p90\": float(np.percentile(arr, 90)),\n        \"sz_max\": float(np.max(arr)),\n    }\n\n\ndef _save_client_log(\n    log_dir: str,\n    model_id: str,\n    request_rate: float,\n    benchmark_duration: float,\n    metrics: \"BenchmarkMetrics\",\n    outputs: list[RequestFuncOutput],\n    skip_first_n: int = 0,\n    skip_last_n: int = 0,\n    total_requests: int | None = None,\n) -> None:\n    \"\"\"Save client benchmark results to the server's log directory.\"\"\"\n    log_path = os.path.join(log_dir, \"client.log\")\n\n    # Warmup/cooldown trim: aggregate only the send-order window\n    # [win_lo, win_hi); the per-request table below still lists every request.\n    n_out = len(outputs)\n    win_lo = max(0, skip_first_n)\n    offered_n = n_out if total_requests is None else total_requests\n    win_hi = min(n_out, offered_n - max(0, skip_last_n))\n    if win_hi <= win_lo:\n        win_lo, win_hi = 0, n_out\n    windowed_outputs = outputs[win_lo:win_hi]\n\n    successful = [o for o in windowed_outputs if o.success]\n    ttfts_ms = [o.ttft * 1000 for o in successful if o.ttft > 0]\n    tpots_ms = [o.tpot * 1000 for o in successful if o.tpot > 0]\n    selected_percentile_metrics: list[str],\n    selected_percentiles: list[float],\n    ignore_eos: bool,\n    goodput_config_dict: dict[str, float],\n    max_concurrency: int | None,\n    lora_modules: Iterable[str] | None,\n    extra_headers: dict | None,\n    extra_body: dict | None,\n    ramp_up_strategy: Literal[\"linear\", \"exponential\"] | None = None,\n    ramp_up_start_rps: int | None = None,\n    ramp_up_end_rps: int | None = None,\n    ready_check_timeout_sec: int = 600,\n    skip_first_n_requests: int = 0,\n    skip_last_n_requests: int = 0,\n    stop_after_request: int = 0,\n):\n    try:\n        request_func = ASYNC_REQUEST_FUNCS[endpoint_type]\n    except KeyError:\n        raise ValueError(f\"Unknown backend: {endpoint_type}\") from None\n\n    if stop_after_request < 0 or stop_after_request > len(input_requests):\n        raise ValueError(\n            \"stop_after_request must be between 0 and the number of offered \"\n            f\"requests ({len(input_requests)}), got {stop_after_request}\"\n        )\n    if 0 < stop_after_request <= skip_first_n_requests:\n        raise ValueError(\n            \"stop_after_request must leave at least one request after the \"\n            \"leading metric trim\"\n        )\n\n    # Reuses connections across requests to reduce TLS handshake overhead.\n    connector = aiohttp.TCPConnector(\n        limit=max_concurrency or 0,\n        limit_per_host=max_concurrency or 0,\n        ttl_dns_cache=300,\n        use_dns_cache=True,\n        keepalive_timeout=60,\n        enable_cleanup_closed=True,\n        force_close=False,\n        ssl=(\"https://\" in api_url),\n    )\n\n    session = aiohttp.ClientSession(\n        connector=connector,\n        trust_env=True,\n        timeout=aiohttp.ClientTimeout(total=6 * 60 * 60),\n    )\n\n    print(\"Starting initial single prompt test run...\")\n    test_prompt, test_prompt_len, test_output_len, test_mm_content = (\n        input_requests[0].prompt,\n        input_requests[0].prompt_len,\n        input_requests[0].expected_output_len,\n        input_requests[0].multi_modal_data,\n        asyncio.Semaphore(max_concurrency)\n        if max_concurrency\n        else contextlib.nullcontext()\n    )\n\n    # SLO attainment(누적) 설정: summary.csv 의 request_{200,250}_att 와 동일 정의.\n    # 한 요청이 \"attained\" 되려면 (TTFT <= prefill SLO) 이고 (mean TPOT <= decode SLO)\n    # 여야 한다. decode SLO 두 기준(200/250ms)을 동시에 추적한다.\n    # prefill SLO 는 TS_PREFILL_SLO_MS(기본 2000), decode SLO 는\n    # TS_GOODPUT_SLO_MS(콤마 구분, 기본 200,250) 로 바꿀 수 있다.\n    ttft_slo_ms = float(os.environ.get(\"TS_PREFILL_SLO_MS\", \"2000\"))\n    slo_ms_list = [\n        float(x) for x in os.environ.get(\"TS_GOODPUT_SLO_MS\", \"200,250\").split(\",\")\n    ]\n    # slo_stats[\"total\"] = 완료(성공+실패) 요청 수, slo_stats[slo] = attained 수\n    slo_stats = {\"total\": 0}\n    for _slo in slo_ms_list:\n        slo_stats[_slo] = 0\n\n    # A stop target is a one-based SEND-ORDER prefix. Wait until every\n    # request in that prefix is terminal, rather than stopping when an\n    # arbitrary count of requests (or only request N) finishes. This prevents\n    # a slow earlier request from disappearing from the metric window.\n    completion_target = stop_after_request\n    prefix_terminal = [False] * completion_target\n    completed_prefix = 0\n    stop_event = asyncio.Event()\n\n    async def limited_request_func(request_func_input, session, pbar):\n        async with semaphore:\n            output = await request_func(\n                request_func_input=request_func_input, session=session, pbar=pbar\n            )\n            # 요청이 끝날 때마다 그 요청의 ttft/tpot 와 지금까지의 SLO attainment 출력.\n            # 분모는 완료된 모든 요청(실패 포함) — summary 의 전체 평균 정의와 일치.\n            slo_stats[\"total\"] += 1\n            if output.success:\n                out_len = output.output_tokens or request_func_input.output_len or 0\n                # mean TPOT (out_len<=1 이면 0 으로 본다; goodput 관례와 동일)\n                tpot = (\n                    (output.latency - output.ttft) / (out_len - 1)\n                    if out_len > 1\n                    else 0.0\n                )\n                ttft_ms = output.ttft * 1000.0\n                tpot_ms = tpot * 1000.0\n                prefill_ok = ttft_ms <= ttft_slo_ms\n                for slo in slo_ms_list:\n                    if prefill_ok and tpot_ms <= slo:\n                        slo_stats[slo] += 1\n\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n                    f\"ttft={ttft_ms:.1f}ms \"\n                    f\"tpot={tpot_ms:.1f}ms \"\n                    f\"| {attain}\"\n                )\n            else:\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n  