rent_start, current_end = next_start, next_end\n\n        merged.append((current_start, current_end))\n\n        return merged\n\n    def _calc_stalls(self, init_event: torch.cuda.Event,\n                     exec_intervals: List[Tuple[int, int]],\n                     memcpy_intervals: List[Tuple[int, int]]):\n        total_stall = 0.0\n        exec_idx = 0\n        for m_start, m_end in memcpy_intervals:\n            memcpy_duration = m_end - m_start\n            overlap_with_exec = 0.0\n\n            while (exec_idx < len(exec_intervals)\n                   and exec_intervals[exec_idx][1] <= m_start):\n                exec_idx += 1\n\n            temp_idx = exec_idx\n            while (temp_idx < len(exec_intervals)\n                   and exec_intervals[temp_idx][0] < m_end):\n                e_start, e_end = exec_intervals[temp_idx]\n\n                overlap = max(0, min(m_end, e_end) - max(m_start, e_start))\n                overlap_with_exec += overlap\n\n                temp_idx += 1\n\n            stall = memcpy_duration - overlap_with_exec\n            total_stall += stall\n\n        return total_stall\n\n    def _calc_intervals(self, init_event: torch.cuda.Event,\n                        begin_events: List[torch.cuda.Event],\n                        end_events: List[torch.cuda.Event]):\n        intervals = []\n        for begin, end in zip(begin_events, end_events):\n            begin_time = init_event.elapsed_time(begin)\n            end_time = init_event.elapsed_time(end)\n            # Skip stale events from init/reset (before this forward)\n            if begin_time < -0.01:\n                continue\n            # Skip zero-duration events (never recorded this iteration)\n            if end_time - begin_time < 0.001:\n                continue\n            intervals.append((begin_time, end_time))\n        intervals.sort(key=lambda x: x[0])\n\n        return intervals\n\n    @staticmethod\n    def _merge_union(intervals):\n        \"\"\"Total wall-clo