be_active in expected.items():\n   302\t        value = breakdown[metric]\n   303\t        if should_be_active:\n   304\t            assert value > 0.0, (\n   305\t                f\"{case.case_id}: expected active {metric}, got {value}\")\n   306\t        else:\n   307\t            assert value <= 0.0001, (\n   308\t                f\"{case.case_id}: expected inactive {metric}, got {value}\")\n   309\t\n   310\t\n   311\tdef _assert_route(case: FeatureCase, log_text: str, model: str) -> None:\n   312\t    residency = _parse_residency(log_text)\n   313\t    expected_residency = _expected_residency(case, model)\n   314\t    for component in COMPONENTS:\n   315\t        assert component in residency, (\n   430\t                type(leaf_module).__name__)\n   431\t            return\n   432\t\n   433\t        # Populate the runtime registry as a flat list — see\n   434\t        # ``graph_wait_ops._fused_linear_apply_impl`` for the entry\n   435\t        # layout.  Pre-bind every per-(layer, comp_id) state here so\n   436\t        # the hot path needs zero ``getattr`` / dict-lookup / tuple-key\n   437\t        # construction.\n   438\t        reg = getattr(self, \"_fused_reg\", None)\n   439\t        if reg is None:\n   440\t            reg = [None] * (self.n_layers * self._FUSED_REG_SLOTS_PER_LAYER)\n   441\t            self._fused_reg = reg\n   442\t\n   443\t        comp_name = _FUSED_MM_ID_TO_COMP.get(int(comp_id))\n   444\t        kernel_done_event = None\n   445\t        if mode == \"frozen_split\" and tensor_name is not None:\n   446\t            kernel_done_event = self._frozen_split_kernel_done_event(\n   447\t                int(layer_id), tensor_name)\n   448\t        elif (mode == \"offload_compressed\" and tensor_name is not None\n   449\t              and comp_name is not None):\n   450\t            # in-graph WAR kde: fused op records it AFTER the GEMM (line 160)\n   451\t            # so the next H2D into this (name, slot) staging waits the mid-graph\n   452\t            # compute completion instead of whole-graph / prior-H2D.\n   453\t            kernel_done_event = self._fused_offload_kernel_done_event(\n   454\t                int(layer_id), tensor_name)\n   455\t\n   456\t        # frozen_decomp_event (entry[4], the \"weight ready\" wait):\n   457\t        fde = None\n   458\t        if mode == \"offload_compressed\" and comp_name is not None:\n   459\t            # offload SKIPS the dense decompress, so frozen_decomp_events\n   460\t            # (a decompress-done signal recorded ONLY on the frozen_split\n   461\t            # path) never fires here.  Wait instead on the offload exec\n   462\t            # barrier, recorded on decomp_weight_stream after the H2D\n   463\t            # (_fused_offload_h2d issues decomp_weight_stream.wait_stream so it\n   464\t            # truly follows the H2D).\n   465\t            from tiered_serve.graph_wait_ops import _EXEC_BARRIER_ATTR\n   466\t            barriers = getattr(self, _EXEC_BARRIER_ATTR.get(comp_name, \"\"), None)\n   467\t            if barriers is not None and int(layer_id) < len(barriers):\n   468\t                fde = barriers[int(layer_id)]\n   469\t        elif mode == \"frozen_split\" and comp_name is not None:\n   470\t            # frozen_split: staging populated asynchronously; wait on the\n   471\t            # per-component decompress-done event.\n   472\t            if hasattr(self, \"frozen_decomp_events\"):\n   473\t                fde = self.frozen_decomp_events[comp_name][int(layer_id)]\n   474\t            elif hasattr(self, \"frozen_decomp_event\"):\n   475\t                fde = self.frozen_decomp_event\n   476\t\n   477\t        # Pre-extract the pybind struct (``comp._c``) for compressors\n   478\t        # that expose one (P4Flat).  This lets the hot-path skip the\n   479\t        # Python attribute lookup ``comp_ref._c`` on every call.\n   480\t        comp_c = getattr(comped, \"_c\", None)\n   481\t\n   482\t        # [8],[9] WDecomp