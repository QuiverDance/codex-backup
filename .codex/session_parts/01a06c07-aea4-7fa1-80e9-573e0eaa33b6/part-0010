{"timestamp":"2026-09-04T11:21:29.536Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c26-fcc0-7dc2-8a30-7759f86eb853","call_id":"call_IaWTnXJikkjoMR3j9Rlq6CU7","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    # ``benchmarks/fuseGEMM.py`` (fused wins for N <= threshold;\n    # above it, decompress + cuBLAS amortises the redundant per-N-tile decode\n    # and wins).  The earlier ``M*K <= 70M ? 128 : 64`` heuristic was inverted\n    # for the wide layers — GateUp/Down (largest M*K) actually keep winning up\n    # to N=112-128, not 64 — so the crossovers are tabulated per shape.\n    #   QKV    10240x8192 : N96  (N80=0.99x N96=1.01x N112=0.96x)\n    #   O       8192x8192 : N128 (N128=1.07x N256=0.36x)\n    #   GateUp 57344x8192 : N112 (N112=1.06x N128=0.93x)\n    #   Down    8192x28672: N128 (N128=1.06x N256=0.33x)\n    # Re-wired 2026-06-10 from benchmark_codec_decision.py (H2D-contended fuse-\n    # vs-decomp crossover on real Llama-70B, 2% tie band). Value = largest\n    # decode-N where fused still beats decompress+cuBLAS under weight-offload H2D.\n    # NOTE: corrected after a bench timing bug — zipserv decompress/decomp+MM run\n    # on a private comp_stream and were invisible to the current-stream cuda\n    # events (mis-measured ~14x fast), making decomp look artificially cheap.\n    # Fixed by timing zipserv on the current stream; the true (slower) decomp\n    # shifts the crossover higher (QKV 96->112, O 64->96, GateUp 96->112).\n    _N_THRESHOLD_TABLE = {\n        (10240, 8192): 112,   # QKV\n        (8192, 8192): 80,     # O\n        (57344, 8192): 112,   # GateUp\n        (8192, 28672): 128,   # Down\n    }\n\n    @staticmethod\n    def _n_threshold(M: int, K: int) -> int:\n        \"\"\"Per-layer N threshold: use fused for N <= threshold, decomp+MM above.\n\n        Returns the measured crossover for known LLaMA-70B projection shapes;\n        for unseen shapes falls back to 96, the conservative point at which\n        every measured shape still wins (so an unknown layer never regresses\n        below decompress+cuBLAS by switching to fused).\n        \"\"\"\n        return ZipServCompressor._N_THRESHOLD_TABLE.get((M, K), 96)\n\n    def fused_mm(\n        self,\n        comp: CompressedZipServTensor,\n        B: torch.Tensor,\n        C: Optional[torch.Tensor] = None,\n        split_k: int = 1,\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        \"\"\"Fused decompress + GEMM: C = A_compressed × B^T.\n\n        For small N uses the fused CUDA kernel (avoids separate\n        decompression).  For larger N, decompresses A once and\n        delegates to cuBLAS which amortises the decode cost.\n\n        Args:\n            comp: CompressedZipServTensor (buffers must be on GPU).\n            B: BF16 matrix [N, K] on GPU.\n            C: Pre-allocated [M, N] BF16 output (optional; must use\n               column-major layout, e.g. ``torch.empty(N, M).T``).\n            split_k: Split-K factor for the GEMM kernel.\n\n        Returns:\n            Output matrix C [M, N] (column-major strides [1, M]).\n        \"\"\"\n        N = B.size(0)\n        if C is None:\n            # Column-major: fused kernel writes Output[i,j]=*(ptr+i+j*M)\n            C = torch.empty(N, comp.M,\n                            dtype=torch.bfloat16, device=\"cuda\").T\n\n        # SINGLE STREAM: both the decompress+cuBLAS (large N) and the fused\n        # kernel (small N) run on the CURRENT stream — the cudagraph capture/\n        # replay stream under capture, exec_stream eagerly.  No comp_stream fork\n        # (illegal during capture, and a no-op for overlap since comp_stream ==\n        # decomp_weight_stream == exec_stream).\n        if N > self._n_threshold(comp.M, comp.K):\n            # Large N (prefill chunk / large decode): decompress once → cuBLAS.\n            # Reuse comp.output_tensor (build_offload_shell binds it to the dense\n            # primary) if registered, else decompress() allocates a fresh M×K.\n            # Bracket the decode kernel with the WDecomp timing events (the GEMM\n            # that follows is Compute); fused branch below leaves them unrecorded\n            # so its inseparable decode folds into Compute (--time-breakdown).\n            _wb, _we = wdecomp_events if wdecomp_events else (None, None)\n            A_dense = self.decompress(comp, begin_event=_wb, end_event=_we)\n            torch.mm(A_dense, B.T, out=C)\n            return C\n\n        # Small N: fused decompress+GEMM kernel.  Allocate enough for auto\n        # Split-K (C++ may promote split_k up to 8 when block count is low; 8 is\n        # the measured optimal cap for decode-N serving).\n        workspace = torch.empty(\n            max(split_k, 8) * comp.M * N,\n            dtype=torch.bfloat16, device=\"cuda\")\n        self._ext.fused_mm(\n            comp.sign_mantissa,\n            comp.compressed_full,\n            comp.bitmap1,\n            comp.bitmap2,\n            comp.bitmap3,\n            comp.tile_offsets_median,\n            comp.tile_offsets_global,\n            comp.max_high_freq_count,\n            comp.max_full_count,\n            comp.start_exp,\n            B, C,\n            comp.M, N, comp.K,\n            workspace,\n            split_k,\n        )\n        return C\n\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    @staticmethod\n    def _pack_cpu_weight_entries(\n        packed_per_stripe: torch.Tensor,\n        counts: torch.Tensor,\n    ) -> torch.Tensor:\n        \"\"\"Compact stripe-local Packed20x3 words into one weight stream.\"\"\"\n        block_prefix = torch.zeros(\n            counts.numel() + 1, dtype=torch.int64, device=\"cpu\")\n        block_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n        total = int(block_prefix[-1].item())\n        if total == 0:\n            return torch.empty(0, dtype=torch.int64)\n\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n                Bpb[:N].copy_(x2)\n                Bp = Bpb\n            # Cbuf[n, m] = sum_k W[m,k]*x[n,k] = F.linear(x, W)[n, m].\n            # Split-K fills the GPU at decode N (see ublb _u4_split_k); the\n            # production p4 path passes no in-kernel exceptions so split-K is safe.\n            sk = _u4_split_k(M, Npad, K)\n            # Split-K fp32 partials: pool like Cbuf/Bpb (keyed by sk too) instead\n            # of torch.empty every call -- the kernel overwrites all sk*Npad*M\n            # partials before the in-launch reduce, so reuse is safe, and at\n            # decode-N this churned the caching allocator (size scales with M, so\n            # QKV/GateUp were worst).\n            if sk > 1:\n                ckey = (\"cf32\", sk, Npad, M, x2.device.index)\n                cf32 = sc.get(ckey)\n                if cf32 is None:\n                    cf32 = torch.empty(sk, Npad, M, dtype=torch.float32, device=x2.device)\n                    sc[ckey] = cf32\n            else:\n                cf32 = _empty_f32(x2.device)\n            ext.p4_rs_wgmma_mm(codes, sm, headers, codec, Bp, Cbuf, cf32, sk, M, Npad, K)\n            if n_exc > 0:\n                # Sum exception corrections in an fp32 scratch and fold into the\n                # bf16 output with a SINGLE rounding -- accumulating directly in\n                # bf16 is non-associative and raced to out-of-tolerance error on\n                # collision-heavy shapes (many exceptions per output row).\n                ycorr = torch.zeros(M, Npad, dtype=torch.float32, device=x2.device)\n                ext.p4_exc_correct(exc_idx, exc_val, codes, sm, headers, codec,\n                                   Bp, ycorr, n_exc, Npad, K, M)\n                y = (Cbuf[:N].float() + ycorr[:, :N].t()).to(torch.bfloat16)\n            else:\n                y = Cbuf[:N]\n        else:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            A = self.decompress(comp)\n            if we is not None:\n                we.record()\n            if A.device != x2.device:\n                A = A.to(x2.device)\n            y = F.linear(x2, A)\n        return y.reshape(*orig[:-1], M)\n\n    def build_split_shell(\n        self,\n        info,\n        staging_dict: Dict[str, torch.Tensor],\n    ) -> CompressedP4FlatTensor:\n        \"\"\"Construct a fused-MM-ready :class:`CompressedP4FlatTensor` whose\n        ``sign_mantissa`` is the HBM-permanent slice and whose remaining\n        codec buffers are aliased onto the layer's frozen-split staging\n        slot.  Used by the loader's ``--fused-mm`` install path so the\n        forward override can call ``linear_apply`` without first\n        materialising the dense weight.\n\n        ``staging_dict`` is ``self.frozen_split_staging[name][parity]``\n        — a dict of ``attr -> staging tensor`` populated by the H2D\n        producer every forward.  Tensors are *aliased*, not copied;\n        consumers must serialise against the H2D event chain that\n        decompress already waits on.\n        \"\"\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06c23-f222-7ad1-a19d-e1c49b2f1182","create_time":1788520889.5360372}}}
