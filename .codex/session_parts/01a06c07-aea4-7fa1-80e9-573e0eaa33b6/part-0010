{"timestamp":"2026-09-04T11:21:25.143Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c26-eb97-7803-8c92-cf85f83178ae","call_id":"call_OvWz584fLTABYOg1pVfbcXzZ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    # loader's ``--fused-mm`` Linear-forward override.  It takes an\n    # activation ``x`` of shape ``(..., K)`` and returns ``y`` of shape\n    # ``(..., M)`` equivalent to ``F.linear(x, decompress(comp))``\n    # — without materialising the dense weight.\n    #\n    # Bias is intentionally NOT applied here.  The caller (the\n    # ColumnParallel / RowParallel forward shim) handles bias + TP\n    # collectives so the same adapter works for any vLLM Linear variant.\n    #\n    # Subclasses with a native ``fused_mm`` should override this to\n    # avoid the dense-weight fallback path below.  Each compressor's\n    # ``fused_mm`` has its own B/C layout convention (P4Flat:\n    # B(K,N) row-major / C(M,N) row-major; ZipServ + DietGPU:\n    # B(N,K) row-major / C(M,N) column-major) — the adapter centralises\n    # that translation so the loader stays compressor-agnostic.\n\n    def linear_apply(\n        self,\n        comp: CompressedTensor,\n        x: torch.Tensor,\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        \"\"\"Default: decompress + ``F.linear``.  Subclasses override.\n\n        ``wdecomp_events`` is an optional ``(begin, end)`` pair of external\n        CUDA events; when given they bracket ONLY the ``decompress`` call so\n        the --time-breakdown WDecomp line attributes this decode-time decomp\n        (used by the --fused-mm path's fallback decompress, see\n        graph_wait_ops._fused_linear_apply_impl).\n        \"\"\"\n        import torch.nn.functional as F\n        wb, we = wdecomp_events if wdecomp_events else (None, None)\n        if wb is not None:\n            wb.record()\n        A = self.decompress(comp)\n        if we is not None:\n            we.record()\n        if A.device != x.device:\n            A = A.to(x.device)\n        return F.linear(x, A)\n\n    # ------------------------------------------------------------------\n    #  Scratch-buffer linear_apply (zero-alloc forward-path fast path)\n    # ------------------------------------------------------------------\n\n    def alloc_fused_scratch(self, K: int, M: int, N: int,\n                            dtype: \"torch.dtype\", device: \"torch.device\"\n                            ) -> Any:\n        \"\"\"Allocate per-(K, M, N) scratch tensors that ``linear_apply_into``\n        will reuse.  The default returns ``None`` and the custom op falls\n        back to the alloc-every-call :meth:`linear_apply`.\n        \"\"\"\n        del K, M, N, dtype, device\n        return None\n\n    def linear_apply_into(\n        self,\n        comp: CompressedTensor,\n        x: \"torch.Tensor\",\n        scratch: Any,\n    ) -> \"torch.Tensor\":\n        \"\"\"Zero-alloc variant of :meth:`linear_apply` that writes\n        intermediates into ``scratch``.  Default just delegates to\n        :meth:`linear_apply` (which allocates per call) — subclasses\n        that supply :meth:`alloc_fused_scratch` should override this.\n        \"\"\"\n        ``(M, N)`` column-major (= ``(N, M)`` row-major .t()).\"\"\"\n        opts = dict(dtype=dtype, device=device)\n        return {\n            'C': torch.empty((N, M), **opts).t(),\n        }\n\n    def linear_apply_into(\n        self,\n        comp: CompressedDietGPUTensor,\n        x: torch.Tensor,\n        scratch: Dict[str, torch.Tensor],\n    ) -> torch.Tensor:\n        \"\"\"Zero-alloc variant of :meth:`linear_apply` writing into\n        the caller's pre-allocated scratch buffers.\"\"\"\n        if x.dim() != 2:\n            x = x.reshape(-1, x.shape[-1])\n        C = scratch['C']\n        self.fused_mm(comp, x.contiguous(), C)\n        if self.comp_stream is not None:\n            torch.cuda.current_stream(C.device).wait_event(\n                self.comp_stream.record_event())\n        return C.t()\n\n    def linear_apply(\n        self,\n        comp: CompressedDietGPUTensor,\n        x: torch.Tensor,\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        \"\"\"y = F.linear(x, A).  Same B/C convention as ZipServ.\n\n        ``wdecomp_events`` accepted for fused-MM call-site compatibility but\n        ignored: this path always runs the fused decomp+GEMM kernel (no\n        separable fallback decompress to time).\n        \"\"\"\n        del wdecomp_events\n        K = int(comp.K)\n        M = int(comp.M)\n        N = x.numel() // K\n        x_2d = x.reshape(N, K) if x.dim() != 2 else x\n        B = x_2d.contiguous()                     # (N, K) row-major\n        C = self.fused_mm(comp, B)                # (M, N) col-major\n        # DietGPU's fused_mm already records a cross-stream event onto\n        # default_stream, but we also want consumers on the current\n        # (possibly graph-captured) stream to wait — record once more.\n        if self.comp_stream is not None:\n            event = self.comp_stream.record_event()\n            torch.cuda.current_stream(C.device).wait_event(event)\n        y = C.t().reshape(*x.shape[:-1], M).contiguous()\n        return y\n        # Loop fallback: per-tensor dispatch handles mixed dtypes.\n        return [self.compress(w, *args, **kwargs) for w in weights]\n\n    def decompress_batch(self, comps, outputs=None):\n        outs = outputs or [None] * len(comps)\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\n\n    def fused_mm(self, comp, *args, **kwargs):\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"fused_mm is only implemented for BF16 compressors\")\n        return self._bf16().fused_mm(comp, *args, **kwargs)\n\n    def linear_apply(self, comp, x, *args, **kwargs):\n        # Hot path under ``--fused-mm`` (see graph_wait_ops._fused_linear_apply\n        # _impl).  frozen_split shells are BF16; FP8 has no fused path.\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"linear_apply (fused) is only implemented for BF16 compressors\")\n        return self._bf16().linear_apply(comp, x, *args, **kwargs)\n\n    def build_split_shell(self, info, staging_dict):\n        # frozen_split fused-MM install: delegate to the BF16 backend (the\n        # split codec compresses BF16 sign+mantissa).  Raises\n        # NotImplementedError if the backend lacks fused support; the\n        # DualMemoryLoader install loop catches it and skips the override.\n        return self._bf16().build_split_shell(info, staging_dict)\n\n    def build_offload_shell(self, comped, output_tensor=None):\n        # offload_compressed fused-MM install: delegate to the BF16 backend.\n        # AttributeError (backend lacks it) / NotImplementedError are caught by\n        # the install loop, which then leaves the cell on the dense path.\n        return self._bf16().build_offload_shell(comped, output_tensor)\n\n    def linear_apply_into(\n        self,\n        comp: CompressedZipServTensor,\n        x: torch.Tensor,\n        scratch: Dict[str, torch.Tensor],\n    ) -> torch.Tensor:\n        \"\"\"Zero-alloc variant of :meth:`linear_apply` writing into\n        the caller's pre-allocated scratch buffers.\"\"\"\n        if x.dim() != 2:\n            x = x.reshape(-1, x.shape[-1])\n        C = scratch['C']\n        # Single stream (current): fused_mm runs on the caller's stream, so the\n        # result is already ordered — no comp_stream event bridge needed.\n        self.fused_mm(comp, x.contiguous(), C)\n        return C.t()\n\n    def linear_apply(\n        self,\n        comp: CompressedZipServTensor,\n        x: torch.Tensor,\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        \"\"\"y = F.linear(x, A) where A is the bit-exact-decoded weight.\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events that\n        bracket ONLY the fallback decompress in ``fused_mm``'s large-N\n        (decompress + cuBLAS) path, for --time-breakdown WDecomp.  The small-N\n        fused-kernel path leaves them unrecorded so its inseparable decode folds\n        into Compute.\n\n        ZipServ ``fused_mm`` takes B as ``(N, K)`` row-major (i.e. the\n        2-D view of the activation directly) and writes C in ``(M, N)``\n        column-major layout.  ``C.T`` is therefore an (N, M) row-major\n        view that we can reshape onto the original leading dims.\n\n        Runs entirely on the CURRENT stream (no comp_stream), so the result is\n        already ordered for the caller — no cross-stream event bridge.\n        \"\"\"\n        K = int(comp.K)\n        M = int(comp.M)\n        N = x.numel() // K\n        x_2d = x.reshape(N, K) if x.dim() != 2 else x\n        if N > self._n_threshold(M, K):\n            # N > thr: decompress ONCE, then run the GEMM with the IDENTICAL\n            # cuBLAS call the non-fused path uses — F.linear(x, A) == x @ Aᵀ,\n            # the (N, M) output orientation.  Do NOT route through fused_mm's\n            # torch.mm(A, xᵀ) (the transposed (M, N) / large-M form): for that\n            # orientation cuBLAS selects a split-K / atomic-accumulate algorithm\n            # whose reduction order is NON-DETERMINISTIC run-to-run (observed:\n            # batch-128 decode diverged ~40/128 first-tokens between identical\n            # runs, while no-fused — which uses F.linear — is bit-stable). The\n            # (N, M) F.linear orientation is deterministic, and matching the\n            # non-fused call exactly makes fused N>thr decode bit-exact with it.\n            _wb, _we = wdecomp_events if wdecomp_events else (None, None)\n            A_dense = self.decompress(comp, begin_event=_wb, end_event=_we)\n            # Write the GEMM into a PRE-ALLOCATED, cudagraph-stable output\n            # buffer (per (M,K,N), reused across layers — consumed downstream\n            # before the same-shape layer reuses it).  A freshly-allocated\n            # F.linear output INSIDE the opaque custom op is non-deterministic\n            # under cudagraph capture/replay (the alloc isn't pool-baked the way\n            # inductor's traced output is), which is the run-to-run divergence\n            # source for the N>thr decode path.  torch.mm(x, Aᵀ) is the SAME\n            # (N,M) cuBLAS orientation F.linear uses (deterministic), so the\n            # result stays bit-exact with the non-fused path.\n            cache = getattr(self, \"_decomp_out_cache\", None)\n            if cache is None:\n                cache = self._decomp_out_cache = {}\n            _ceil = getattr(self, \"_cudagraph_ceiling\", 0) or 512\n            if N > _ceil:\n                # EAGER large prefill (N > cudagraph ceiling): the chunk length N\n                # VARIES step to step (8192, 8184, 8176, 8112, ...).  Keying the\n                # output by (M,K,N) like the decode path below would cache a full\n                # N*M buffer for EVERY distinct chunk length -> the cache grows\n                # without bound and leaks GBs (the gate_up output alone is\n                # ~N*57344*2 B), exhausting HBM mid-prefill.  Eager => no cudagraph\n                # capture, so one per-(M,K) scratch grown to the largest N seen and\n                # sliced to N is safe AND deterministic (no pool baking needed).\n                # Reused across layers/steps; consumed downstream before the same-\n                # (M,K) layer reuses it (same invariant the decode cache relies on).\n                pscr = getattr(self, \"_prefill_out_scratch\", None)\n                if pscr is None:\n                    pscr = self._prefill_out_scratch = {}\n                s = pscr.get((M, K))\n                if s is None or s.shape[0] < N:\n                    s = torch.empty(N, M, dtype=x_2d.dtype, device=x_2d.device)\n                    pscr[(M, K)] = s\n                out = s[:N]\n            else:\n                _ckey = (M, K, N)\n                out = cache.get(_ckey)\n                if out is None:\n                    out = torch.empty(N, M, dtype=x_2d.dtype, device=x_2d.device)\n                    cache[_ckey] = out\n            torch.mm(x_2d, A_dense.t(), out=out)\n            return out.reshape(*x.shape[:-1], M)\n        # N <= thr: fused decompress+GEMM kernel (single deterministic kernel).\n        # ZipServ wants B as (N, K) — directly the row-major activation.\n        B = x_2d.contiguous()\n        C = self.fused_mm(comp, B, wdecomp_events=wdecomp_events)  # (M,N) col-major\n        # (M, N) col-major == (N, M) row-major; .T is a contiguous view.\n        y = C.t().reshape(*x.shape[:-1], M).contiguous()\n        return y\n        # tests/benchmarks may set this instance attr directly to force-fuse at all N.\n        self._fused_max_n_override = None\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-shape fused N threshold (0 = never fuse this shape); unknown shapes\n        fall back to 64 (the one-full-WGMMA-tile sweet spot).  An instance-level\n        ``_fused_max_n_override`` (set by tests/benchmarks) overrides all shapes.\"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 64)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the U4-RS register-A WGMMA kernel for small N; falls back to\n        decompress + F.linear for large N (prefill) or non-aligned shapes.\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress