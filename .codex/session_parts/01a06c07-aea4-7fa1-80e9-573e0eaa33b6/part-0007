n    59\t        if llm_intervals:\n    60\t            llm_intervals = self._calc_exec_times(llm_intervals, [])\n    61\t\n    62\t        # Productive projection markers are baked into compiled graph pieces by\n    63\t        # graph_wait_ops; eager attention retains the existing module-hook\n    64\t        # markers.  Require the full 5-per-layer set.  A partial set is reported\n    65\t        # as unavailable rather than silently falling back to ExecResidual.\n    66\t        kernel_intervals = self._calc_intervals(\n    67\t            init_event, self.begin_kernel_events, self.end_kernel_events,\n    68\t            total_time)\n    69\t        expected_compute_markers = 5 * self.n_layers\n    70\t        compute_markers_valid = (\n    71\t            len(kernel_intervals) == expected_compute_markers)\n    72\t        productive_compute_intervals = (\n    73\t            self._calc_exec_times(kernel_intervals, [])\n    74\t            if compute_markers_valid else [])\n    75\t\n    76\t        # Fused overrides make weight decode and projection compute\n    77\t        # inseparable.  Keep those projection intervals out of DenseCompute and\n    78\t        # expose them independently while retaining Compute as their union for\n    79\t        # backward-compatible total productive work.\n    80\t        fused_event_ids = set()\n    81\t        fused_reg = getattr(self, \"_fused_reg\", None)\n    82\t        kernel_slot_by_comp = (0, 1, 3, 4)\n    83\t        if fused_reg:\n    84\t            for layer_id in range(self.n_layers):\n    85\t                for comp_id, kernel_slot in enumerate(kernel_slot_by_comp):\n    86\t                    reg_idx = layer_id * 4 + comp_id\n    87\t                    if reg_idx < len(fused_reg) and fused_reg[reg_idx] is not None:\n    88\t                        fused_event_ids.add(5 * layer_id + kernel_slot)\n    89\t        fused_weight_compute_intervals = []\n    90\t        dense_compute_intervals = []\n    91\t        if compute_markers_valid:\n    92\t            if fused_event_ids:\n    93\t                fused_weight_compute_intervals = self._calc_exec_times(\n    94\t                    self._calc_intervals(\n    95\t                        init_event,\n    96\t                        [self.begin_kernel_events[i]\n    97\t                         for i in sorted(fused_event_ids)],\n    98\t                        [self.end_kernel_events[i]\n    99\t                         for i in sorted(fused_event_ids)],\n   100\t                        total_time), [])\n   101\t            dense_event_ids = [\n   102\t                i for i in range(expected_compute_markers)\n   103\t                if i not in fused_event_ids]\n   104\t            dense_compute_intervals = self._calc_exec_times(\n   105\t                self._calc_intervals(\n   106\t                    init_event,\n   107\t                    [self.begin_kernel_events[i] for i in dense_event_ids],\n   108\t                    [self.end_kernel_events[i] for i in dense_event_ids],\n   109\t                    total_time), [])\n   110\t        llm_time = sum(e - b for b, e in llm_intervals)\n   111\t\n   112\t        # ── Weight decompression intervals (only when compressed) ──\n   113\t        weight_decomp_time = 0.0\n   114\t        overlap_time = 0.0\n   115\t        weight_decomp_intervals = []\n   116\t        if use_weight_comp and load_comp_weight:\n   117\t            # Include all not-frozen layers' decomp events.\n   118\t            # Stale events (from layers that didn't actually decompress)\n   119\t            # are filtered by the begin_time / duration checks below.\n   120\t            weight_decomp_intervals = self._calc_intervals(\n   121\t                init_event,\n   122\t                [e for i, e in enumerate(self.begin_decomp_events)\n   123\t                 if (i // 4) in self.not_frozen_layers],\n   124\t                [e for i, e in enumerate(self.end_decomp_events)\n   125\t                 if (i // 4) in self.not_frozen_layers],\n   126\t            )\n   127\t            weight_decomp_time = sum(\n   128\t                e - b for b, e in weight_decomp_intervals)\n   129\t            overlap_time = self._calculate_total_overlap(\n   130\t                llm_intervals, weight_decomp_intervals)\n   131\t\n   132\t        # ── KV comp / decomp (only when KV compression enabled) ──\n   133\t        kv_comp_time = 0.0\n   134\t        kv_decomp_time = 0.0\n   135\t        # Compressed-KV H2D split out of decomp and folded into KVLoad below\n   136\t        # (directly summed with the load_kv_stream copies, no overlap accounting).\n   137\t        kv_comp_h2d_time = 0.0\n   138\t        kv_h2d_intervals: List[Tuple[float, float]] = []\n   139\t        if use_kv_comp:\n   140\t            kv_comp_intervals = self._calc_intervals(\n   141\t                init_event,\n   142\t                self.begin_kv_comp_events,\n   143\t                self.end_kv_comp_events)\n   144\t            kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\n   145\t\n   455\t        # Each metric is the wall-clock union of the recorded CUDA\n   456\t        # events on that stream (events overlap across streams, so we\n   457\t        # de-dupe via _calc_exec_times rather than summing).\n   458\t        #\n   459\t        # Notes on what this CAN'T see:\n   460\t        # 1) frozen_compressed layers don't H2D during decode (the\n   461\t        #    compressed bytes already live in HBM).  frozen_split\n   462\t        #    layers DO H2D the compressed-exp/aux LPDDR buffers every\n   463\t        #    decode step on load_weight_stream; those are captured via\n   464\t        #    _frozen_split_h2d_(begin|end_timing)_events_cache below.\n   465\t        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\n   466\t        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\n   467\t        #    into the decomp kernel (LPDDR is read directly via\n   468\t        #    host-mapped UVA), so those H2D bytes don't surface as a\n   469\t        #    separate event — they are folded into the WDecomp time\n   470\t        #    instead.\n   471\t        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\n   472\t        #    → end_forward).  Python-loop TPOT additionally includes\n   473\t        #    scheduler / sampling / output assembly on CPU.  See the\n   474\t        #    [Step] StepLatency log emitted by\n   475\t        #    offline_offload_kvweight.py for the perf_counter step time.\n   476\t        if self.time_breakdown:\n   477\t            # ── Subtract in-graph cur_stream waits from LLM intervals ──\n   478\t            # Two distinct barriers block cur_stream INSIDE the\n   479\t            # [begin_exec, end_exec] window — during either, cur_stream is\n   480\t            # stalled, NOT running GEMM/attention:\n   481\t            #   1. KV-barrier wait: the wrapper's `_after_replay` does\n   482\t            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\n   483\t            #      (see v1_cuda_graph_wrapper.py) before eager attention.\n   484\t            #      Timed by `_v1_kv_wait_*`.\n   485\t            #   2. In-graph weight-ready wait: the FX-injected\n   486\t            #      `wait_frozen_weight` op blocks each projection GEMM until\n   487\t            #      its weight H2D/decomp lands (see graph_wait_ops.py).\n   488\t            #      Timed per (layer, component) by `_v1_wwait_*`.\n   489\t            # Counting either as LLM busy inflates ComputeUnion and hides\n   490\t            # stall.  The legacy \"Exec\" line subtracts BOTH (via\n   491\t            # attn_barrier_wait + weight_stall), so LLM here must subtract\n   492\t            # both too — otherwise the breakdown LLM reads high by the\n   493\t            # weight-wait time.  Subtract the union of all wait sub-intervals\n   494\t            # so LLM reflects actual compute on cur_stream and the stall calc\n   495\t            # treats wait time as compute-idle.\n   496\t            wait_intervals: List[Tuple[float, float]] = []\n   497\t            for wbe, wee in (\n   498\t                    (getattr(self, '_v1_kv_wait_begin_events', None),\n   499\t                     getattr(self, '_v1_kv_wait_end_events', None)),\n   500\t                    (getattr(self, '_v1_wwait_begin_events', None),\n   501\t                     getattr(self, '_v1_wwait_end_events', None))):\n   502\t                if not wbe or not wee:\n   503\t                    continue\n   504\t                wait_intervals.extend(self._calc_intervals(\n   505\t                    init_event, wbe, wee, total_time))\n   506\t            # KV and weight waits all live on cur_stream and run sequentially,\n   507\t            # so they are already non-overlapping — a sort is enough to meet\n   508\t            # _subtract_intervals' \"sorted AND non-overlapping\" precondition\n   509\t            # (no union-merge needed).  Likewise llm_intervals: the per-kernel\n   510\t            # exec intervals don't overlap (single cur_stream), so subtract\n   511\t            # directly without unioning first.\n   512\t            wait_intervals.sort(key=lambda x: x[0])\n   513\t            # Compute = exec minus cur_stream waits; decomp is carved out\n   514\t            # further down (once its intervals are built).  llm_brk is\n   515\t            # computed there, NOT here.\n   516\t            exec_residual_intervals = self._subtract_intervals(\n   517\t                llm_intervals, wait_intervals)\n   518\t\n   519\t            # Frozen weight decomp uses a separate event pair\n   520\t            # (begin_frozen_decomp_events /\n   521\t            #  end_frozen_decomp_timing_events) keyed by\n   522\t            # (comp_key, layer_id), distinct from the sync-only\n   523\t            # frozen_decomp_events used for cross-stream waits and from\n   524\t            # the per-layer begin/end_decomp_events used by the offload\n   525\t            # path.  Collect intervals for frozen layers so WDecomp\n   526\t            # reflects both modes.\n   527\t            frozen_decomp_intervals = []\n   528\t            if (use_weight_comp\n   529\t                    and hasattr(self, \"begin_frozen_decomp_events\")\n   530\t                    and hasattr(self, \"end_frozen_decomp_timing_events\")):\n   531\t                frozen_decomp_begin = []\n   532\t                frozen_decomp_end = []\n   533\t                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n   534\t                    begin_list = self.begin_frozen_decomp_events.get(\n   535\t                        comp_key, [])\n   536\t                    end_list = self.end_frozen_decomp_timing_events.get(\n   537\t                        comp_key, [])\n   538\t                    for layer_id in self.frozen_layers:\n   539\t                        if (layer_id >= len(begin_list)\n   540\t                                or layer_id >= len(end_list)):\n   541\t                            continue\n   542\t                        frozen_decomp_begin.append(begin_list[layer_id])\n   543\t                        frozen_decomp_end.append(end_list[layer_id])\n   544\t                frozen_decomp_intervals = self._calc_intervals(\n   545\t                    init_event, frozen_decomp_begin, frozen_decomp_end,\n   546\t                    total_time)\n   547\t\n   548\t            # frozen_split's per-(layer,name) decomp kernel uses its\n   549\t            # own lazy timing cache (the per-comp_key\n   550\t            # end_frozen_decomp_timing_events slots are written by the\n   551\t            # frozen_compressed paths, not by\n   552\t            # _decompress_frozen_split_for_name).\n   553\t            frozen_split_decomp_intervals = []\n   554\t            sd_begin_cache = getattr(\n   555\t                self,\n   556\t                \"_frozen_split_decomp_begin_timing_events_cache\",\n   557\t                None)\n   558\t            sd_end_cache = getattr(\n   559\t                self,\n   560\t                \"_frozen_split_decomp_end_timing_events_cache\",\n   561\t                None)\n   562\t            if sd_begin_cache and sd_end_cache:\n   563\t                split_decomp_keys = [\n   564\t                    key for key in sd_begin_cache if key in sd_end_cache]\n   565\t                frozen_split_decomp_intervals = self._calc_intervals(\n   566\t                    init_event,\n   567\t                    [sd_begin_cache[key] for key in split_decomp_keys],\n   568\t                    [sd_end_cache[key] for key in split_decomp_keys],\n   569\t                    total_time)\n   570\t\n   571\t            all_weight_decomp_intervals = (\n   572\t                weight_decomp_intervals\n   573\t                + frozen_decomp_intervals\n   574\t                + frozen_split_decomp_intervals)\n   575\t            wdecomp_union: List[Tuple[float, float]] = []\n   576\t            wdecomp_brk = 0.0\n   577\t            if all_weight_decomp_intervals:\n   578\t                wdecomp_union = self._calc_exec_times(\n   579\t                    all_weight_decomp_intervals, [])\n   580\t                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\n   581\t\n   582\t            kvdecomp_union: List[Tuple[float, float]] = []\n   583\t            kvdecomp_brk = 0.0\n   584\t            if use_kv_comp and kv_decomp_intervals:\n   585\t                kvdecomp_union = self._calc_exec_times(\n   586\t                    kv_decomp_intervals, [])\n   587\t                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\n   588\t\n   589\t            # ── Productive Compute vs graph-piece residual ──\n   590\t            # Keep the historical subtraction only as ExecResidual.  It cannot\n   591\t            # establish productive-kernel time because an unobserved transitive\n   592\t            # weight dependency remains inside the graph-piece enve