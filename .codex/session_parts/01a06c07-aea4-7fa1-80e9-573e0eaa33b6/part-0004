comp in (\"o\", \"gate_up\", \"down\"):\n   318\t                _record(comp, last)\n   319\t\n   320\t    def _prefetch_frozen_before_eager(self, dm, piece_idx: int,\n   321\t                                      n_pieces: int, cur_stream):\n   322\t        \"\"\"Prefill eager path: queue piece K+1's raw-bf16 H2D before piece K.\n   323\t\n   324\t        The normal ``_after_replay`` lookahead is too late for prefill NONE\n   325\t        path because the expensive attention/MLP already ran inside\n   326\t        ``eager_run Gk``.  With external WAR events, scheduling G+1 here is\n   327\t        safe at parity 2: piece G reads qkv(G) + O/MLP(G-1), while piece G+1\n   328\t        writes qkv(G+1) + O/MLP(G), i.e. distinct component parity slots.\n   329\t        \"\"\"\n   330\t        if (not hasattr(dm, \"frozen_decomp_event\")\n   331\t                or not self._can_lookahead_frozen_decomp(dm)\n   332\t                or self._wload_graph_on(dm)):\n   333\t            return\n   334\t\n   335\t        depth = self._frozen_lookahead_depth(dm)\n   336\t        target = min(piece_idx + depth, n_pieces - 1)\n   337\t        hwm = getattr(dm, \"_frozen_sched_hwm\", piece_idx)\n   338\t        if target <= hwm:\n   339\t            return\n   340\t\n   341\t        self._cached_stream_wait(\n   342\t            dm, dm.decomp_weight_stream, cur_stream,\n   343\t            (\"prefetch_before_eager\", piece_idx))\n   344\t        dm._v1_prefill_raw_external_war = True\n   345\t        for g in range(hwm + 1, target + 1):\n   346\t            self._schedule_frozen_decomp_for_graph(dm, g, n_pieces)\n   347\t        dm._frozen_sched_hwm = target\n   348\t\n   349\t    @staticmethod\n   350\t    def _frozen_lookahead_depth(dm) -> int:\n   351\t        \"\"\"How many graphs ahead to prefetch frozen-weight decomp/H2D.\n   352\t\n   353\t        The old pipeline prefetched exactly +1 graph: decomp for graph K+1\n   354\t        was queued in ``_after_replay(K)`` and consum