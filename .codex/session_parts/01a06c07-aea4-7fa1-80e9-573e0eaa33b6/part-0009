{"timestamp":"2026-09-04T11:20:20.466Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c25-eef2-7452-9089-96172e3b14ad","call_id":"call_AFzWrlRD8obSYCIrgpAUlLN0","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"-rw-r--r--+ 1 root root 57323 Sep  4 11:14 /var/lib/containerd/io.containerd.snapshotter.v1.overlayfs/snapshots/3/fs/root/projects/tiered-serve/tiered_serve/dual_memory_loader/timing.py\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\n\nclass FusedMMMixin:\n\n    # ------------------------------------------------------------------\n    #  fused_mm install path (Phase 1: frozen_compressed only)\n    # ------------------------------------------------------------------\n    # When the user passes ``--fused-mm``, tiered-serve overrides\n    # ``layer.quant_method.apply`` on each Linear module backed by a\n    # fused-MM-capable compressor.  Frozen-split decode stages only the\n    # compressed side buffers; the custom op chooses fused GEMM or one\n    # decompress+cuBLAS fallback at the point of use.\n    #\n    # ``_fused_mm_enabled`` returns the loader-time cached --fused-mm gate.\n\n    def _fused_mm_enabled(self) -> bool:\n        return getattr(self, \"_use_fused_mm\", False)\n\n    def _refresh_fused_weight_wait_coverage(self) -> None:\n        \"\"\"Publish whether every dynamic weight is guarded inside its custom op.\n\n        The V1 wrapper may skip its coarse per-piece weight barrier only when\n        every non-resident (layer, component) has a fused registry entry with a\n        concrete weight-ready event.  Mixed fused/native configurations remain\n        on the conservative coarse-wait path.\n        \"\"\"\n        reg = getattr(self, \"_fused_reg\", None)\n        slots = self._FUSED_REG_SLOTS_PER_LAYER\n        required = 0\n        covered = 0\n\n        for layer_id in range(self.n_layers):\n            block = self.torch_model.decoder_blocks[layer_id]\n            for comp_id, comp_key in enumerate(self._SLOT_TO_COMP):\n                mode = self._effective_mode(\n                    self.layer_weight_comp[layer_id].get(comp_key, \"offload\"),\n                    block.is_frozen)\n                if mode == \"frozen_uncompressed\":\n                    continue\n                required += 1\n                entry_idx = layer_id * slots + comp_id\n                entry = (\n                    reg[entry_idx]\n                    if reg is not None and entry_idx < len(reg)\n                    else None\n                )\n                # frozen_split is the overlap-safe path implemented here:\n                # its producer records entry[4] directly on load_weight_stream.\n                # offload_compressed still bridges through exec_stream in the\n                # V0-compatible load path, so keep the coarse wrapper fallback\n                # for mixed/offload configurations.\n                if (mode == \"frozen_split\"\n                        and entry is not None\n                        and entry[4] is not None):\n                    covered += 1\n\n        complete = required > 0 and covered == required\n        self._v1_fused_weight_waits_complete = complete\n        logger.info(\n            \"[fused-mm] component weight-ready coverage: %d/%d complete=%s\",\n            covered, required, complete)\n\n    def _fused_offload_kernel_done_event(self, layer_id: int, name: str\n                                         ) -> \"torch.cuda.Event\":\n        \"\"\"Lazy WAR-gate event for an ``offload_compressed`` fused cell.\n\n        The compressed blob is streamed into the SHARED ``_d_*`` staging slot\n        (``_comp_transfer_bufs[_stream_slot[layer]][name]``); layers sharing a\n        slot share ONE event, so the next H2D into the slot can wait on the\n        prior fused GEMM that still reads it.  Recorded by the fused custom op\n        after it consumes the slot (registry entry[5]); the load path\n        (``_fused_offload_h2d``) waits on it before the next H2D.  Created\n        pre-recorded so the first wait is a no-op.  Keyed by stream slot (not\n        absolute layer) to match the physical staging the WAR protects.\n        \"\"\"\n        cache = getattr(self, \"_fused_offload_kernel_done_events\", None)\n        if cache is None:\n            cache = {}\n            self._fused_offload_kernel_done_events = cache\n        key = (name, self._stream_slot[layer_id])\n        ev = cache.get(key)\n        if ev is None:\n            ev = torch.cuda.Event(external=True)\n            ev.record()\n            cache[key] = ev\n        return ev\n\n    def _is_fused_offload_cell(self, layer_id: int, comp_id: int) -> bool:\n        \"\"\"True iff this (layer, component) got an offload fused override.\n\n        The load path consults this before skipping the dense decompress —\n        cells whose offload-fused install was skipped (unsupported codec, no\n        staging) must keep the dense path so the native forward reads a valid\n        primary buffer.\n        \"\"\"\n        if comp_id is None:\n            return False\n        reg = getattr(self, \"_fused_reg\", None)\n        if reg is None:\n            return False\n        i = layer_id * self._FUSED_REG_SLOTS_PER_LAYER + comp_id\n        return 0 <= i < len(reg) and reg[i] is not None\n\n    def _install_frozen_split_fused_mm_overrides(self):\n        \"\"\"Phase-3 install: for every frozen_split (layer, name), build a\n        fused-MM-ready shell whose ``sign_mantissa`` is the HBM-permanent\n        slice and whose remaining codec buffers alias the layer's\n        parity-specific staging slot.  Bind it to the corresponding\n        Linear module so the forward-override (installed below) calls\n        ``compressor.linear_apply(shell, x)`` instead of consuming the\n        dense decompress output.\n\n        The loader only stages the compressed side buffers.  The custom op\n        waits for that H2D and then selects fused GEMM vs\n        decompress+cuBLAS at the point of use.  Its kernel-done event protects\n        the parity-shared staging slot from the next writer.\n        \"\"\"\n        for idx in range(self.n_layers):\n            info_dict = self.frozen_split_info[idx]\n            if info_dict is None:\n                continue\n            parity = idx % self.FROZEN_STAGING_PARITY\n            block = self.torch_model.decoder_blocks[idx]\n            for name, info in info_dict.items():\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\nfrom tiered_serve.dual_memory_loader.init import InitMixin\nfrom tiered_serve.dual_memory_loader.frozen_split import FrozenSplitMixin\nfrom tiered_serve.dual_memory_loader.compressor import CompressorMixin\nfrom tiered_serve.dual_memory_loader.fused_mm import FusedMMMixin\nfrom tiered_serve.dual_memory_loader.weights import WeightLoadMixin\nfrom tiered_serve.dual_memory_loader.kv import KVMixin\nfrom tiered_serve.dual_memory_loader.timing import TimingMixin\n\n\nvmm_allocator_ext = load(\n    name=\"vmm_allocator\",\n    sources=[\n        \"etc/vmm_allocator/vmm_allocator.cpp\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\",\n        \"-O3\",\n        \"-std=gnu++17\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        \"-L/usr/lib/aarch64-linux-gnu\",\n        \"-lcuda\",\n    ],\n)\n\n\nclass DualMemoryLoader(\n    InitMixin,\n    FrozenSplitMixin,\n    CompressorMixin,\n    FusedMMMixin,\n    WeightLoadMixin,\n    KVMixin,\n    TimingMixin,\n):\n    # batch_has_prefill: True whenever the current batch contains ANY prefill\n    # chunk (attn_metadata.max_query_len > 1), independent of cudagraph mode.\n    # Single source of truth for every prefill-vs-decode decision (weight\n    # path, KV path, breakdown labels).  True even for a prefill chunk that\n    # runs under a PIECEWISE graph (which a cudagraph-mode check would miss).\n    batch_has_prefill = False\n    # Current batch's total token count (1 for a single-token decode step).\n    # Set per-forward in torch_hooks.before_model_forward alongside\n    # batch_has_prefill; used to pick the prefill weight codec (large batches\n    # amortise raw_bf16's H2D, small batches prefer a compressed fast-decode\n    # codec).\n    cur_num_tokens = 1\n    # ran_eager: did the last forward run eager (no CUDA graph)?  Used only\n    # for timing-event stream selection in torch_hooks; NOT a prefill signal.\n    ran_eager = False\n    is_profiling = False\n\n    is_graph_capturing = False\n    is_graph_warming_up = False\n\n    kv_caches = []\n    unload_targets: set = set()\n    num_dedicated_blocks = None\n    # P4Flat full-block-only mode: each active request owns one physical HBM\n    # tail row until its 16-token block completes.\n    kv_full_block_only = False\n    num_tail_slots = 0\n    kv_physical_block_offset = None\n    tail_manager = None\n    tail_k_caches = None\n    tail_v_caches = None\n    no_offload_kv = False\n    # Opt-in mixed/prefill route: reconstruct historical offloaded blocks from\n    # the persistent compressed store. Fresh prompt blocks have no persistent\n    # slot and are filtered by the compressor before attention writes them.\n    # Resolved once during loader setup; never read from os.environ per layer.\n    kv_comp_prefill_load = False\n    # Number of parity slots in the HBM decode buffer (set by gpu_worker):\n    # 1 = single shared buffer (legacy), 2 = double-buffer ping-pong by layer\n    # parity.  ==2 enables the raw post-D2H unload event below.\n    kv_decode_n_parity = 1\n\n    slot_managers = None\n\n    # Per-step [Breakdown] dicts accumulated during time_breakdown, split by\n    # phase.  calc_times appends one entry per step here INSTEAD of logging to\n    # the console every step (which spammed one line per prefill/decode step);\n    # the of