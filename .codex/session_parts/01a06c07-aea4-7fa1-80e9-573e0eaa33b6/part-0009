{"timestamp":"2026-09-04T11:19:38.248Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06c25-4a08-7801-8fbb-336bd12bca72","call_id":"call_gRkRjcLi3iDhzYEK6YEBkbrC","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        if not self._fused_mm_enabled():\n            return\n        if not getattr(compressor, \"HAS_FUSED_MM\", False):\n            return\n        if getattr(leaf_module, \"_tiered_serve_fused_mm_installed\", False):\n            return\n        if layer_id is None or comp_id is None:\n            logger.warning(\n                \"fused_mm: skipping install on %s — missing layer_id/comp_id; \"\n                \"Dynamo would graph-break on the pybind call.\",\n                type(leaf_module).__name__)\n            return\n\n        # Populate the runtime registry as a flat list — see\n        # ``graph_wait_ops._fused_linear_apply_impl`` for the entry\n        # layout.  Pre-bind every per-(layer, comp_id) state here so\n        # the hot path needs zero ``getattr`` / dict-lookup / tuple-key\n        # construction.\n        reg = getattr(self, \"_fused_reg\", None)\n        if reg is None:\n            reg = [None] * (self.n_layers * self._FUSED_REG_SLOTS_PER_LAYER)\n            self._fused_reg = reg\n\n        comp_name = _FUSED_MM_ID_TO_COMP.get(int(comp_id))\n        kernel_done_event = None\n        if mode == \"frozen_split\" and tensor_name is not None:\n            kernel_done_event = self._frozen_split_kernel_done_event(\n                int(layer_id), tensor_name)\n        elif (mode == \"offload_compressed\" and tensor_name is not None\n              and comp_name is not None):\n            # in-graph WAR kde: fused op records it AFTER the GEMM (line 160)\n            # so the next H2D into this (name, slot) staging waits the mid-graph\n            # compute completion instead of whole-graph / prior-H2D.\n            kernel_done_event = self._fused_offload_kernel_done_event(\n                int(layer_id), tensor_name)\n\n        # frozen_decomp_event (entry[4], the \"weight ready\" wait):\n        fde = None\n        if mode == \"offload_compressed\" and comp_name is not None:\n            # offload SKIPS the dense decompress, so frozen_decomp_events\n            # (a decompress-done signal recorded ONLY on the frozen_split\n            # path) never fires here.  Wait instead on the offload exec\n            # barrier, recorded on decomp_weight_stream after the H2D\n            # (_fused_offload_h2d issues decomp_weight_stream.wait_stream so it\n            # truly follows the H2D).\n            from tiered_serve.graph_wait_ops import _EXEC_BARRIER_ATTR\n            barriers = getattr(self, _EXEC_BARRIER_ATTR.get(comp_name, \"\"), None)\n            if barriers is not None and int(layer_id) < len(barriers):\n                fde = barriers[int(layer_id)]\n        elif mode == \"frozen_split\" and comp_name is not None:\n            # frozen_split: staging populated asynchronously; wait on the\n            # per-component decompress-done event.\n            if hasattr(self, \"frozen_decomp_events\"):\n                fde = self.frozen_decomp_events[comp_name][int(layer_id)]\n            elif hasattr(self, \"frozen_decomp_event\"):\n                fde = self.frozen_decomp_event\n\n        # Pre-extract the pybind struct (``comp._c``) for compressors\n        # that expose one (P4Flat).  This lets the hot-path skip the\n        # Python attribute lookup ``comp_ref._c`` on every call.\n        comp_c = getattr(comped, \"_c\", None)\n\n        # [8],[9] WDecomp timing events for the linear_apply FALLBACK decomp.\n        # When linear_apply decompresses instead of fusing (QKV always — its\n        # fused threshold is 0; and any component at N > fused_max_n), it\n        # brackets ``self.decompress`` with these so the [Breakdown] WDecomp\n        # reflects that decode-time decomp.  The genuinely-fused path leaves\n        # them unrecorded (the decomp is inside the GEMM kernel, inseparable,\n        # so it correctly folds into Compute).  None unless the time-breakdown\n        # event pools exist.\n        _wd_begin = _wd_end = None\n        if (comp_name is not None\n                and hasattr(self, \"begin_frozen_decomp_events\")):\n            _wd_begin = self.begin_frozen_decomp_events[comp_name][\n                int(layer_id)]\n            _wd_end = self.end_frozen_decomp_timing_events[comp_name][\n                int(layer_id)]\n\n        # [11],[12] time the weight-ready barrier inside the custom op.\n        # Bind the events once here so the serving hot path does not read\n        # collect_times or traverse loader attributes on every projection.\n        _ww_begin = _ww_end = None\n        if self.collect_times:\n            _ww_idx = int(layer_id) * 4 + int(comp_id)\n            _ww_begin = self._v1_wwait_begin_events[_ww_idx]\n            _ww_end = self._v1_wwait_end_events[_ww_idx]\n\n        # Positional list — see graph_wait_ops._fused_linear_apply_impl\n        # for the slot indices.\n        reg[int(layer_id) * self._FUSED_REG_SLOTS_PER_LAYER + int(comp_id)] = [\n            int(comped.K),                # [0] K\n            int(comped.M),                # [1] M\n            compressor,                   # [2] compressor\n            comped,                       # [3] comp_ref (CompressedXxxTensor)\n            fde,                          # [4] frozen_decomp_event (or None)\n            kernel_done_event,            # [5] kernel_done_event (or None)\n            {},                           # [6] scratch_by_N\n            comp_c,                       # [7] pre-extracted comp._c (or None)\n            _wd_begin,                    # [8] WDecomp begin event (or None)\n            _wd_end,                      # [9] WDecomp end event (or None)\n            # [10] leaf Linear, ONLY for frozen_split — its ``.weight`` is the\n            #      materialized dense PRIMARY the op reads for LARGE prefill\n            #      (chunk > cudagraph ceiling: runs eager, loader put raw_bf16 in\n            #      primary).  None for offload: offload streams the compressed\n            #      blob into the shared staging EVERY step (prefill incl., via\n            #      _fused_offload_h2d), so offload prefill — any size — takes the\n        [6] scratch_by_N (legacy slot, retained for ZipServ/DietGPU)\n        [7] comp_c     pre-extracted ``comp._c`` (legacy slot)\n        [8] wd_begin   WDecomp begin event (or None) — timed by linear_apply\n        [9] wd_end     WDecomp end event   (or None)   only on the fallback\n                        decompress path (fused path leaves them unrecorded).\n        [10] leaf      Linear used by the large-prefill dense fallback\n        [11] ww_begin  weight-ready wait begin event (or None)\n        [12] ww_end    weight-ready wait end event (or None)\n    \"\"\"\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n    dm = DualMemoryLoader._v1_dm_ref\n    # During the real ``profile_run`` and the cudagraph WARMUP the wrapper skips\n    # weight streaming, so the per-decode staging the fused op reads is stale.\n    # offload's bulk sign_mantissa is then OOB → IMA; frozen_split's sign_mantissa\n    # is HBM-permanent so it survives, but the guard is harmless there.  Return\n    # the output SHAPE only there; do NOT short-circuit during the cudagraph\n    # CAPTURE (the REAL op must bake in — the per-step data is streamed before\n    # each decode replay).  Capture is detected via the dedicated\n    # ``_v1_fused_capturing`` flag (vllm/compilation/cuda_graph.py).\n    if dm is not None and (getattr(dm, \"is_profiling\", False)\n                           or getattr(dm, \"is_graph_warming_up\", False)):\n        _capturing = (getattr(dm, \"_v1_fused_capturing\", False)\n                      or torch.cuda.is_current_stream_capturing())\n        if not _capturing:\n            return x.new_zeros(*x.shape[:-1], M)\n\n    entry = dm._fused_reg[layer_id * _REG_ENTRY_SLOTS + comp_id]\n    fde = entry[4]\n    kde = entry[5]\n    ww_begin = entry[11]\n    ww_end = entry[12]\n\n    # SINGLE STREAM: decompress+GEMM (or the fused kernel) run on the CURRENT\n    # stream — the cudagraph capture/replay stream under capture, exec_stream\n    # eagerly.  No comp_stream fork (capture-illegal; see ZipServ fused_mm /\n    # decompress).  ``fde`` is the per-component weight-ready barrier, recorded\n    # on the producer stream (load_weight_stream for frozen_split H2D). Waiting\n    # it on the current stream is capture-safe and orders the decode after the\n    # H2D in both captured and eager execution.\n    cur = torch.cuda.current_stream(x.device)\n    _capturing = (getattr(dm, \"_v1_fused_capturing\", False)\n                  or torch.cuda.is_current_stream_capturing())\n    if fde is not None:\n        if ww_begin is not None:\n            ww_begin.record(cur)\n        cur.wait_event(fde)\n        if ww_end is not None:\n            ww_end.record(cur)\n    elif not _capturing:\n        # Eager cell with no recorded barrier: order after the H2D stream\n        # directly (cross-stream wait_stream is illegal during capture).\n        _lws = getattr(dm, \"load_weight_stream\", None)\n        if _lws is not None:\n            if ww_begin is not None:\n                ww_begin.record(cur)\n            cur.wait_stream(_lws)\n            if ww_end is not None:\n                ww_end.record(cur)\n\n    # Unlike the old graph-piece envelope, these events bracket only the\n    # projection implementation.  In the fused path that implementation is\n    # intentionally inseparable (weight decode + GEMM); TimingMixin reports it\n    # separately as FusedWeightCompute.\n    _compute_timed = getattr(dm, \"collect_times\", False)\n    _kernel_slot = _COMP_TO_KERNEL_SLOT[_ID_TO_COMP[int(comp_id)]]\n    if _compute_timed:\n        dm.begin_kernel_events[5 * int(layer_id) + _kernel_slot].record(cur)\n\n    # LARGE PREFILL (eager only) → plain GEMM on the raw dense PRIMARY.\n    # The forward override ALWAYS routes through this op (no Dynamo-traced\n    # branch), so this op alone must distinguish the two weight sources.  When a\n    # prefill chunk exceeds the cudagraph capture ceiling it (a) runs eager (stock\n    # vLLM dispatch sends num_tokens > max_cudagraph_capture_size to NONE) and\n    # (b) the loader materialised the raw_bf16 dense weight into the leaf's\n    # ``.weight`` (PREFILL_ALT_MAX_CHUNK == ceiling), NOT the compressed staging.\n    # So decode + captured-size prefill (N <= ceiling) take the staging path\n    # below; only this eager large-prefill case reads primary.  This op is OPAQUE\n    # to Dynamo, so the branch is evaluated at runtime — at CAPTURE N == the\n    # captured size <= ceiling, so the staging path is what gets baked.\n    if getattr(dm, \"batch_has_prefill\", False) and entry[10] is not None:\n        _ceil = getattr(dm, \"_cudagraph_ceiling\", 0)\n        if _ceil and (x.numel() // entry[0]) > _ceil:\n            y = torch.nn.functional.linear(x, entry[10].weight)\n            if _compute_timed:\n                dm.end_kernel_events[\n                    5 * int(layer_id) + _kernel_slot].record(cur)\n            if kde is not None:\n                kde.record(cur)\n            return y\n\n            #              runs CONCURRENTLY with ProductiveCompute (it is\n            #              prefetched a layer ahead), so it is NOT carved out and\n            #              is NOT part of the additive GPUFwd tiling — it is a\n            #              standalone stream-busy figure that overlaps it.\n            #   WLoad    — weight H2D on load_weight_stream\n            #   KVLoad   — KV H2D on load_kv_stream\n            #   ExposedLoad — load-active wall time with no recorded productive\n            #              compute/decompression.  Stall is a compatibility\n            #              alias, not total GPU idle.\n            def _fmt_metric(value):\n                return \"NA\" if value is None else f\"{value:.4f}\"\n\n            brk_msg = (\n                f\"{prefix} [Breakdown] \"\n                f\"GPUFwd: {total_time:.4f} | \"\n                f\"Compute: {_fmt_metric(llm_brk)} \"\n                f\"WDecomp: {wdecomp_brk:.4f} \"\n                f\"KVDecomp: {kvdecomp_brk:.4f} \"\n                f\"WLoad: {wload_brk:.4f} \"\n                f\"KVLoad: {kvload_brk:.4f} \"\n                f\"Stall: {_fmt_metric(stall_brk)} \"\n                f\"DenseCompute: {_fmt_metric(dense_compute_brk)} \"\n                f\"FusedWeightCompute: \"\n                f\"{_fmt_metric(fused_weight_compute_brk)} \"\n                f\"ProductiveCompute: \"\n                f\"{_fmt_metric(productive_compute_brk)} \"\n                f\"ExecResidual: {exec_residual_brk:.4f} \"\n                f\"ExposedLoad: {_fmt_metric(exposed_load_brk)} \"\n                f\"Unclassified: {_fmt_metric(unclassified_brk)} \"\n                f\"ComputeMarkers: {len(kernel_intervals)}/\"\n                f\"{expected_compute_markers} \"\n                f\"WindowClip: {self._timing_window_clip_count} \"\n                f\"WindowDrop: {self._timing_window_drop_count} \"\n                f\"Instrumented: 1\")\n            # Both phases' breakdowns are accumulated (see below) and logged\n            # once per batch by the benchmark driver\n            # (offline_offload_kvweight.py); the per-step console line is\n            # suppressed for BOTH so the console isn't spammed one line per\n            # step.  File + nvtx keep the full per-step record regardless.\n            if self._time_log_file is not None:\n                self._time_log_file.write(brk_msg + \"\\n\")\n                self._time_log_file.flush()\n            torch.cuda.nvtx.mark(brk_msg)\n\n            # Expose the breakdown as a plain dict for the benchmark driver\n            # and diagnostics.  Overwritten each calc_times call; prefill /\n            # decode are distinguishable via the \"is_prefill\" field.\n            self.last_breakdown = {\n                \"is_prefill\": self.batch_has_prefill,\n                \"gpu_fwd_ms\": total_time,\n                \"compute_ms\": llm_brk,\n                \"dense_compute_ms\": dense_compute_brk,\n                \"fused_weight_compute_ms\": fused_weight_compute_brk,\n                \"productive_compute_ms\": productive_compute_brk,\n                \"exec_residual_ms\": exec_residual_brk,\n                \"wdecomp_ms\": wdecomp_brk,\n                \"kvdecomp_ms\": kvdecomp_brk,\n                \"wload_ms\": wload_brk,\n                \"kvload_ms\": kvload_brk,\n                \"stall_ms\": stall_brk,\n                \"exposed_load_ms\": exposed_load_brk,\n                \"unclassified_ms\": unclassified_brk,\n                \"compute_markers\": len(kernel_intervals),\n                \"compute_markers_expected\": expected_compute_markers,\n                \"window_clip_count\": self._timing_window_clip_count,\n                \"window_drop_count\": self._timing_window_drop_count,\n                \"instrumented\": True,\n                \"compute_includes_weight_decomp\": False,\n                \"fused_weight_compute_includes_weight_decomp\": bool(\n                    fused_event_ids),\n                \"wload_measurement\": \"direct_union\",\n                \"kvload_measurement\": (\n                    \"direct_sum\" if kv_h2d_intervals\n                    else \"engine_union_residual\"),\n            }\n            if (not self.batch_has_prefill and use_kv_comp\n                    and getattr(_kc, \"_cpu_profile_enabled\", False)):\n                _join_total = float(getattr(\n                    _kc, \"_step_cpu_join_total_ms\", 0.0))\n                _worker_wait = float(getattr(\n                    _kc, \"_step_cpu_worker_wait_ms\", 0.0))\n                self.last_breakdown.update({\n                    \"kv_cpu_join_ms\": _join_total,\n                    \"kv_cpu_worker_wait_ms\": _worker_wait,\n                    \"kv_cpu_publish_ms\": max(\n                        0.0, _join_total - _worker_wait),\n                    \"kv_cpu_join_calls\": int(getattr(\n                        _kc, \"_step_cpu_join_calls\", 0)),\n                    \"kv_cpu_join_blocks\": int(getattr(\n                        _kc, \"_step_cpu_join_blocks\", 0)),\n                    \"kv_cpu_join_max_ms\": float(getattr(\n                exec_idx += 1\n\n            temp_idx = exec_idx\n            while (temp_idx < len(exec_intervals)\n                   and exec_intervals[temp_idx][0] < m_end):\n                e_start, e_end = exec_intervals[temp_idx]\n\n                overlap = max(0, min(m_end, e_end) - max(m_start, e_start))\n                overlap_with_exec += overlap\n\n                temp_idx += 1\n\n            stall = memcpy_duration - overlap_with_exec\n            total_stall += stall\n\n        return total_stall\n\n    def _calc_intervals(self, init_event: torch.cuda.Event,\n                        begin_events: List[torch.cuda.Event],\n                        end_events: List[torch.cuda.Event],\n                        window_end_ms: float | None = None,\n                        require_contained: bool = False):\n        \"\"\"Return valid event intervals clipped to the current forward.\n\n        CUDA events are reused across steps and some producer work can finish\n        just outside the begin/end-forward markers.  Neither case may leak into\n        a per-forward metric.  Clip partial overlap, drop fully outside/stale\n        pairs, and keep counters so lifecycle bugs remain observable.\n        \"\"\"\n        if window_end_ms is None:\n            window_end_ms = init_event.elapsed_time(self.end_forward_event)\n        intervals = []\n        for begin, end in zip(begin_events, end_events):\n            try:\n                raw_begin = init_event.elapsed_time(begin)\n                raw_end = init_event.elapsed_time(end)\n            except RuntimeError:\n                self._timing_window_drop_count = getattr(\n                    self, \"_timing_window_drop_count\", 0) + 1\n                continue\n            if require_contained and (\n                    raw_begin < 0.0 or raw_end > window_end_ms):\n                self._timing_window_drop_count = getattr(\n                    self, \"_timing_window_drop_count\", 0) + 1\n                continue\n            # Never-recorded/reversed pairs and intervals wholly outside this\n            # forward are stale, not zero-cost activity.\n            if (raw_end - raw_begin < 0.001\n                    or raw_end <= 0.0\n                    or raw_begin >= window_end_ms):\n                self._timing_window_drop_count = getattr(\n                    self, \"_timing_window_drop_count\", 0) + 1\n                continue\n            begin_time = max(0.0, raw_begin)\n            end_time = min(window_end_ms, raw_end)\n            if end_time - begin_time < 0.001:\n                self._timing_window_drop_count = getattr(\n                    self, \"_timing_window_drop_count\", 0) + 1\n                continue\n            if begin_time != raw_begin or end_time != raw_end:\n                self._timing_window_clip_count = getattr(\n                    self, \"_timing_window_clip_count\", 0) + 1\n            intervals.append((begin_time, end_time))\n        intervals.sort(key=lambda x: x[0])\n\n        return intervals\n\n    @staticmethod\n    def _merge_union(intervals):\n        \"\"\"Total wall-clock length of the UNION of (begin, end) intervals —\n        overlapping/back-to-back intervals are merged so the result is never\n        double-counted.  Used to measure copy-engine-busy time: all H2D shares\n        the single GH200 copy engine, so the union of the weight and KV H2D\n        intervals is the true engine-busy time (transfers are serial 