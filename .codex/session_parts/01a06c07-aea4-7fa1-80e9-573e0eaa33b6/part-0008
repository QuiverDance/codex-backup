                    bd_path = os.path.join(folder_path, breakdown_name)\n   999\t                        _hdr = not os.path.exists(bd_path)\n  1000\t                        with open(bd_path, \"a\") as _bf:\n  1001\t                            if _hdr:\n  1002\t                                _bf.write(\n  1003\t                                    \"batch gpu_fwd compute dense_compute \"\n  1004\t                                    \"fused_weight_compute productive_compute \"\n  1005\t                                    \"exec_residual \"\n  1006\t                                    \"wdecomp kvdecomp wload kvload stall \"\n  1007\t                                    \"exposed_load unclassified compute_markers \"\n  1008\t                                    \"compute_markers_expected window_clip_count \"\n  1009\t                                    \"window_drop_count instrumented\\n\")\n  1010\t                            _bf.write(\n  1011\t                                f\"{batch} {_fmt(avg['gpu_fwd_ms'])} \"\n  1012\t                                f\"{_fmt(avg['compute_ms'])} \"\n  1013\t                                f\"{_fmt(avg['dense_compute_ms'])} \"\n  1014\t                                f\"{_fmt(avg['fused_weight_compute_ms'])} \"\n  1015\t                                f\"{_fmt(avg['productive_compute_ms'])} \"\n  1016\t                                f\"{_fmt(avg['exec_residual_ms'])} \"\n  1017\t                                f\"{_fmt(avg['wdecomp_ms'])} \"\n  1018\t                                f\"{_fmt(avg['kvdecomp_ms'])} \"\n  1019\t                                f\"{_fmt(avg['wload_ms'])} \"\n  1020\t                                f\"{_fmt(avg['kvload_ms'])} \"\n  1021\t                                f\"{_fmt(avg['stall_ms'])} \"\n  1022\t                                f\"{_fmt(avg['exposed_load_ms'])} \"\n  1023\t                                f\"{_fmt(avg['unclassified_ms'])} \"\n  1024\t                                f\"{avg['com