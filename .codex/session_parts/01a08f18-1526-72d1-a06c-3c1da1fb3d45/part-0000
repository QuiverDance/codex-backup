{"timestamp":"2026-09-11T06:14:10.697Z","ordinal":62,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a08f1a-2609-74b2-8180-d1ffefb8b55c","call_id":"call_D5lhCxoJKUPMNQovkx2MQPBn","output":[{"type":"input_text","text":"Script completed\nWall time 1.5 seconds\nOutput:\n"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"8256e8\",\"wall_time_seconds\":0.151364907,\"exit_code\":0,\"original_token_count\":1760,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"bench serve 결과 JSON 에서 핵심 지표를 뽑아 CSV 로 저장한다.\\n\\nbench serve 가 저장한 JSON 은 generated_texts/ttfts/latencies 같은 큰 배열이\\n한 줄로 섞여 있어 열어보기 불편하다. 핵심 스칼라 지표만 추려 <name>.csv\\n(헤더 1줄 + 값 1줄) 로 쓴다. 여러 run 의 csv 를 그대로 concat 하면 표가 된다.\\n\\ngoodput: per-request inter-token latency(itls) 분포에서 p90/p95/p99 를 구해\\nSLO(기본 200ms) 이하면 그 요청을 \\\"good\\\" 으로 본다. p{N}_goodput_reqs 는 초당\\ngood 요청 수(req/s, request_throughput 과 비교용), p{N}_goodput_frac 은 전체 대비\\n비율이다. SLO 는 환경변수 TS_GOODPUT_SLO_MS 로 바꿀 수 있다.\\n\\nUsage: python3 prettify_result.py RESULT.json [RESULT2.json ...]\\n   SLO 변경:  TS_GOODPUT_SLO_MS=150 python3 prettify_result.py RESULT.json\\n\\\"\\\"\\\"\\nimport csv\\nimport json\\nimport math\\nimport os\\nimport sys\\nfrom pathlib import Path\\n\\n# goodput SLO (ms) 와 측정 백분위\\nSLO_MS = float(os.environ.get(\\\"TS_GOODPUT_SLO_MS\\\", \\\"200\\\"))\\nGOODPUT_PCTS = (90, 95, 99)\\n\\n# CSV 컬럼 순서 (JSON 에 없으면 빈 칸)\\nFIELDS = [\\n    \\\"model\\\", \\\"ts_config\\\", \\\"request_rate\\\", \\\"date\\\",\\n    \\\"num_prompts\\\", \\\"completed\\\", \\\"failed\\\", \\\"duration\\\",\\n    \\\"request_throughput\\\", \\\"output_throughput\\\", \\\"total_token_throughput\\\",\\n    \\\"max_output_tokens_per_s\\\", \\\"max_concurrent_requests\\\",\\n    \\\"mean_ttft_ms\\\", \\\"median_ttft_ms\\\", \\\"p90_ttft_ms\\\",\\n    \\\"mean_tpot_ms\\\", \\\"median_tpot_ms\\\", \\\"p90_tpot_ms\\\",\\n    \\\"mean_itl_ms\\\", \\\"median_itl_ms\\\", \\\"p90_itl_ms\\\",\\n    \\\"goodput_slo_ms\\\",\\n    \\\"p90_goodput_reqs\\\", \\\"p90_goodput_frac\\\",\\n    \\\"p95_goodput_reqs\\\", \\\"p95_goodput_frac\\\",\\n    \\\"p99_goodput_reqs\\\", \\\"p99_goodput_frac\\\",\\n    \\\"total_input_tokens\\\", \\\"total_output_tokens\\\",\\n]\\n\\n\\ndef _percentile(sorted_vals: list, q: float) -> float:\\n    \\\"\\\"\\\"numpy.percentile 기본(linear interpolation) 과 동일한 백분위.\\n\\n    기존 p90_*_ms 필드(vllm 의 np.percentile)와 계산 방식을 맞춘다.\\n    \\\"\\\"\\\"\\n    n = len(sorted_vals)\\n    if n == 1:\\n        return sorted_vals[0]\\n    rank = (q / 100.0) * (n - 1)\\n    lo = int(math.floor(rank))\\n    hi = int(math.ceil(rank))\\n    if lo == hi:\\n        return sorted_vals[lo]\\n    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * (rank - lo)\\n\\n\\ndef compute_goodput(data: dict) -> dict:\\n    \\\"\\\"\\\"per-request itls 의 p90/p95/p99 가 SLO 이하인 요청을 good 으로 집계.\\n\\n    - itls 는 초 단위라 ms 로 환산한다.\\n    - error 가 있는 요청은 무조건 not-good.\\n    - 출력 토큰이 1개라 itl 이 비어 있는 요청은 token 지연 위반이 없으므로 good.\\n    - reqs = good / duration (req/s), frac = good / 전체 요청수.\\n    \\\"\\\"\\\"\\n    itls = data.get(\\\"itls\\\") or []\\n    errors = data.get(\\\"errors\\\") or [None] * len(itls)\\n    duration = data.get(\\\"duration\\\") or 0.0\\n    total = len(itls)\\n\\n    good = {p: 0 for p in GOODPUT_PCTS}\\n    for req_itls, err in zip(itls, errors):\\n        if err:\\n            continue\\n        if not req_itls:  # 토큰 1개 등 ITL 없음 → 위반 없음\\n            for p in GOODPUT_PCTS:\\n                good[p] += 1\\n            continue\\n        s = sorted(x * 1000.0 for x in req_itls)  # s -> ms\\n        for p in GOODPUT_PCTS:\\n            if _percentile(s, p) <= SLO_MS:\\n                good[p] += 1\\n\\n    res = {\\\"goodput_slo_ms\\\": SLO_MS}\\n    for p in GOODPUT_PCTS:\\n        res[f\\\"p{p}_goodput_reqs\\\"] = round(good[p] / duration, 4) if duration else \\\"\\\"\\n        res[f\\\"p{p}_goodput_frac\\\"] = round(good[p] / total, 4) if total else \\\"\\\"\\n    return res\\n\\n\\ndef to_csv(path: Path) -> None:\\n    with open(path) as f:\\n        data = json.load(f)\\n\\n    row = {k: data.get(k, \\\"\\\") for k in FIELDS}\\n    row.update(compute_goodput(data))\\n\\n    out = path.with_suffix(\\\".csv\\\")\\n    with open(out, \\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow(FIELDS)\\n        w.writerow([row.get(k, \\\"\\\") for k in FIELDS])\\n    print(f\\\"  csv -> {out.name}\\\")\\n\\n\\ndef main() -> None:\\n    if len(sys.argv) < 2:\\n        sys.exit(__doc__)\\n    for arg in sys.argv[1:]:\\n        p = Path(arg)\\n        if not p.is_file():\\n            print(f\\\"[!] not found: {p}\\\")\\n            continue\\n        try:\\n            to_csv(p)\\n        except (json.JSONDecodeError, OSError) as e:\\n            print(f\\\"[!] skip {p}: {e}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nrequest_rate ttft_p50 ttft_p90 ttft_p95 ttft_p99 tpot_p50 tpot_p90 tpot_p95 tpot_p99 itl_p50 itl_p90 itl_p95 itl_p99 e2el_p50 e2el_p90 e2el_p95 e2el_p99 prefill_att(%) decode_200_att(%) decode_250_att(%) request_200_att(%) request_250_att(%) n_batches prefill_batch(%) decode_batch(%) batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\\n1.4 593.46 1784.32 2639.77 5270.88 189.88 302.94 326.23 407.81 128.24 418.89 587.13 1332.30 24665.62 104878.94 114647.03 134383.40 91.40 53.20 68.60 50.20 64.10 4899 19.02 80.98 50.45 48.00 85.00 114\\nrequest_rate ttft_p50 ttft_p90 ttft_p95 ttft_p99 tpot_p50 tpot_p90 tpot_p95 tpot_p99 itl_p50 itl_p90 itl_p95 itl_p99 e2el_p50 e2el_p90 e2el_p95 e2el_p99 prefill_att(%) decode_200_att(%) decode_250_att(%) request_200_att(%) request_250_att(%) n_batches prefill_batch(%) decode_batch(%) batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\\n1.4 595.34 1849.50 2857.22 5270.34 192.72 297.27 316.67 399.61 128.74 426.55 592.80 1321.88 24783.16 103933.44 112175.50 131645.27 91.20 53.40 69.80 50.30 65.20 4769 19.67 80.33 51.89 49.00 86.00 114