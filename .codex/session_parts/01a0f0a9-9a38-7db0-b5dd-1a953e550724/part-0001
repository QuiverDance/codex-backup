uired\\n        state.garbage_words = garbage_words\\n        stats = self._csr_stats[layer_id, kv]\\n        stats[\\\"append_words\\\"] += append_words\\n        stats[\\\"peak_used_words\\\"] = max(stats[\\\"peak_used_words\\\"], required)\\n\\n    def _discard_persistent_csr_slot(\\n            self, layer_id: int, slot: int) -> None:\\n        self._discard_persistent_csr_slots(\\n            layer_id, np.asarray([slot], dtype=np.int64))\\n\\n    @cd3_cpu_profile.timed(\\\"csr.retire\\\")\\n    def _discard_persistent_csr_slots(\\n            self, layer_id: int, slots: np.ndarray) -> None:\\n        \\\"\\\"\\\"Retire K/V scratch metadata together without touching H2D data.\\\"\\\"\\\"\\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\\n        if slots.size == 0:\\n            return\\n        counts = self._host_num_exceptions_np[layer_id]\\n        states = self._persistent_csr.get(layer_id, {})\\n        k_state, v_state = states.get(\\\"k\\\"), states.get(\\\"v\\\")\\n        # CSR rebuild replaces its state/word-count arrays. Resolve them now;\\n        # only the fixed scratch-pool views above are cached across callbacks.\\n        k_garbage, v_garbage = _cd3_ext.retire_kv_csr_slots(\\n            slots, counts[\\\"k\\\"], counts[\\\"v\\\"],\\n            k_state.word_counts if k_state is not None else None,\\n            v_state.word_counts if v_state is not None else None,\\n        )\\n        if k_state is not None:\\n            k_state.garbage_words += k_garbage\\n        if v_state is not None:\\n            v_state.garbage_words += v_garbage\\n        for side, state, retired_words in ((\\\"k\\\", k_state, k_garbage),\\n                                           (\\\"v\\\", v_state, v_garbage)):\\n            if state is None:\\n                continue\\n            stats = getattr(self, \\\"_csr_stats\\\", {}).get((layer_id, side))\\n            if stats is not None:\\n                stats[\\\"retired_words\\\"] += retired_words\\n\\n    def _acquire_csr_host_arena(\\n            self, length: int) -> Tuple[torch.Tensor, torch.Tensor | None]:\\n        \\\"\\\"\\\"Return an exact view backed by a retained pinned int64 arena.\\\"\\\"\\\"\\n        if length == 0:\\n            return self._csr_host_tensor(0), None\\n        capacity = 1 << (length - 1).bit_length()\\n        available = min((size for size in self._free_csr_host_arenas\\n                         if size >= capacity), default=None)\\n        if available is not None:\\n            bucket = self._free_csr_host_arenas[available]\\n            arena = bucket.pop()\\n\"}}"},{"type":"input_text","text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"657d56\",\"wall_time_seconds\":0.000011456,\"exit_code\":0,\"original_token_count\":4421,\"output\":\"            self._decompress_blocks(layer_id, chunk, k_cache, v_cache,\\n                                    chunk_index=index)\\n\\n    def _restore_secondary_fallbacks(\\n            self, layer_id: int, candidates: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\\n        \\\"\\\"\\\"Restore exception-overflow rows from authoritative raw KV.\\n\\n        The host encoder retains the true exception count while safely\\n        truncating Packed20 writes at the fixed row capacity.  If either side\\n        of a K/V pair overflowed, restore both sides from ``secondary_kv`` and\\n        remove that block from the CD3 launch.  Normal rows pay no per-step\\n        metadata scan until a layer has observed an overflow.\\n        \\\"\\\"\\\"\\n        if (not self._secondary_fallback_possible.get(layer_id, False)\\n                or candidates.size == 0):\\n            return candidates\\n\\n        slots = self._kv_slot_np[layer_id][candidates]\\n        slot_ok = slots >= 0\\n        if not bool(slot_ok.any()):\\n            return candidates\\n        probe_positions = np.flatnonzero(slot_ok)\\n        probe_slots = slots[slot_ok]\\n        pools = self._host_pools[layer_id]\\n        overflow = (\\n            pools[\\\"k\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        overflow |= (\\n            pools[\\\"v\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        if not bool(overflow.any()):\\n            return candidates\\n\\n        fallback_positions = probe_positions[overflow]\\n        fallback_ids = np.ascontiguousarray(\\n            candidates[fallback_positions], dtype=np.int64)\\n        self._decode_raw_from_secondary(\\n            layer_id, fallback_ids, k_cache, v_cache)\\n        keep = np.ones(candidates.size, dtype=np.bool_)\\n        keep[fallback_positions] = False\\n        return np.ascontiguousarray(candidates[keep])\\n\\n    def _decode_raw_from_secondary(\\n            self, layer_id: int, block_ids: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n        if layer_id >= len(DualMemoryLoader.kv_caches):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV overflow fallback requires raw secondary KV, \\\"\\n                f\\\"but layer {layer_id} has no DualMemoryLoader cache\\\")\\n        secondary = getattr(\\n            DualMemoryLoader.kv_caches[layer_id], \\\"secondary_kv\\\", None)\\n        if secondary is None:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV overflow fallback requires raw secondary KV, \\\"\\n                f\\\"but layer {layer_id} has no secondary_kv\\\")\\n\\n        profile = kv_cpu_profile.new_load(layer_id, \\\"cd3_raw_fallback\\\", len(block_ids))\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        host_ids = torch.from_numpy(block_ids)\\n        with torch.cuda.stream(self.batch_decomp_stream):\\n            device_ids = kv_load_metrics.h2d(host_ids, k_cache.device)\\n            k_cache.index_copy_(\\n                0, device_ids,\\n                kv_load_metrics.h2d(secondary[0][host_ids], k_cache.device, raw=True))\\n            v_cache.index_copy_(\\n                0, device_ids,\\n                kv_load_metrics.h2d(secondary[1][host_ids], v_cache.device, raw=True))\\n\\n        if profile is not None:\\n            raw_bytes = len(block_ids) * self._block_numel * 4\\n            profile.update(raw_bytes=raw_bytes, wire_bytes=raw_bytes + len(block_ids) * 8,\\n                           body_bytes=raw_bytes, entry_bytes=0, active_entry_bytes=0,\\n                           extra_entry_bytes=0, stage_cpu_ms=(_time.perf_counter_ns() - started) / 1e6)\\n\\n    def _pack_csr_entries(\\n            self, pool: Dict[str, torch.Tensor],\\n            storage_slots: np.ndarray\\n            ) -> Tuple[torch.Tensor, torch.Tensor, list[torch.Tensor]]:\\n        \\\"\\\"\\\"Compact exact per-slot Packed20 words into one pinned CSR arena.\\\"\\\"\\\"\\n        storage_slots = np.ascontiguousarray(storage_slots, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[storage_slots]\\n        # Rows restored from raw secondary may still be present in a full-HWM\\n        # staging range.  They are never decoded, so safely clamp their\\n        # truncated scratch row while retaining offsets for every body row.\\n        stored_counts = np.minimum(counts, self._entry_capacity)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        packed, packed_owner = self._acquire_csr_host_arena(total_words)\\n        offsets, offsets_owner = self._acquire_csr_host_arena(\\n            storage_slots.size)\\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n            pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n            torch.from_numpy(storage_slots), packed, offsets)\\n        return packed, offsets, [packed_owner, offsets_owner]\\n\\n    @_nsys_trace.call(\\\"CPU.KV.CSR.Plan.BUILD\\\", \\\"setup\\\", key=\\\"layer_id\\\")\\n    def _build_decode_plan(\\n            self, layer_id: int,\\n            block_ids: np.ndarray, k_cache, v_cache) -> _DecodePlan:\\n        self._reclaim_csr_plans()\\n        if self.storage_backend == \\\"hybrid\\\":\\n            from tiered_serve.chunk_delta3_kv_plan import prepare_hybrid_plan\\n            return prepare_hybrid_plan(self, layer_id, block_ids,\\n                                       profile=cd3_cpu_profile.enabled or kv_cpu_profile._enabled)\\n        n = len(block_ids)\\n        hwm = self._kv_slot_allocator[layer_id].high_water\\n        states = self._persistent_csr[layer_id]\\n        if states[\\\"k\\\"] is None or states[\\\"v\\\"] is None:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 persistent CSR is missing for layer={layer_id}\\\")\\n\\n        slots = np.ascontiguousarray(\\n            self._kv_slot_np[layer_id][block_ids], dtype=np.int32)\\n        if bool((slots < 0).any()):\\n            missing = int(block_ids[np.flatnonzero(slots < 0)[0]])\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV has no slot for layer={layer_id} \\\"\\n                f\\\"block={missing}\\\")\\n\\n        block_ids_tensor = torch.from_numpy(\\n            np.ascontiguousarray(block_ids, dtype=np.int64))\\n        block_ids_cpu, block_ids_owner = self._acquire_csr_host_arena(n)\\n        host_owners = [block_ids_owner] if block_ids_owner is not None else []\\n\\n        gpu_entry_capacity = self._gpu_decomp_pool_ring[0][\\\"k\\\"][\\n            \\\"entries20x3\\\"].numel()\\n        repack = any(\\n            states[kv].used_words > gpu_entry_capacity\\n            for kv in (\\\"k\\\", \\\"v\\\"))\\n        if repack:\\n            order = np.argsort(slots, kind=\\\"stable\\\")\\n            storage_slots = np.ascontiguousarray(\\n                slots[order], dtype=np.int64)\\n            packed_k, offsets_k, owners_k = self._pack_csr_entries(\\n                self._host_pools[layer_id][\\\"k\\\"], storage_slots)\\n            packed_v, offsets_v, owners_v = self._pack_csr_entries(\\n                self._host_pools[layer_id][\\\"v\\\"], storage_slots)\\n            host_owners.extend(\\n                owner for owner in owners_k + owners_v\\n                if owner is not None)\\n            host_entries = (packed_k, packed_v)\\n            host_offsets = (offsets_k, offsets_v)\\n        else:\\n            host_entries = (\\n                states[\\\"k\\\"].entries[:states[\\\"k\\\"].used_words],\\n                states[\\\"v\\\"].entries[:states[\\\"v\\\"].used_words],\\n            )\\n            host_offsets = (\\n                states[\\\"k\\\"].offsets,\\n                states[\\\"v\\\"].offsets,\\n            )\\n\\n        host_bodies = (\\n            self._host_pools[layer_id][\\\"k\\\"][\\\"body\\\"],\\n            self._host_pools[layer_id][\\\"v\\\"][\\\"body\\\"],\\n        )\\n        entry_words = (\\n            host_entries[0].numel(), host_entries[1].numel())\\n        staged_bytes = (\\n            n * (2 * self._body_stride + 3 * 8)\\n            + host_entries[0].nbytes + host_entries[1].nbytes)\\n        active_words = tuple(int(states[side].word_counts[slots].sum()) for side in (\\\"k\\\", \\\"v\\\"))\\n        plan = _DecodePlan(\\n            layer_id=layer_id,\\n            block_ids=block_ids,\\n            block_ids_cpu=block_ids_cpu,\\n            generation=self._decode_generation.get(layer_id, 0),\\n            slots_gpu=self._identity_slots_gpu[:n],\\n            host_bodies=host_bodies,\\n            host_offsets=host_offsets,\\n            host_entries=host_entries,\\n            offsets_are_compact=repack,\\n            storage_rows=n,\\n            entry_words=entry_words,\\n            entry_wire_bytes=tuple(words * 8 for words in entry_words),\\n            staged_bytes=staged_bytes,\\n            host_owners=host_owners,\\n            h2d_done=(self._free_csr_h2d_events.pop()\\n                      if self._free_csr_h2d_events else torch.cuda.Event()),\\n            side_payload=tuple(n * self._record_body_bytes + words * 8 for words in active_words),\\n            side_alignment=(n * (self._body_stride - self._record_body_bytes),) * 2,\\n            side_gap=tuple((entry_words[i] - active_words[i]) * 8 for i in range(2)),\\n            csr_garbage_bytes=(0 if repack else 8 * sum(\\n                states[side].garbage_words for side in (\\\"k\\\", \\\"v\\\"))),\\n            profile_active_entry_bytes=8 * sum(active_words),\\n        )\\n        rings = self._gpu_decomp_pool_ring\\n        native_profile = {} if cd3_cpu_profile.enabled else None\\n        plan.serial_native = _cd3_ext.prepare_chunk_delta3_kv_serial(\\n            block_ids_tensor, self._kv_slot[layer_id], block_ids_cpu,\\n            *host_bodies, *host_offsets, *host_entries,\\n            [ring[\\\"k\\\"][\\\"body\\\"] for ring in rings],\\n            [ring[\\\"v\\\"][\\\"body\\\"] for ring in rings],\\n            [ring[\\\"k\\\"][\\\"entry_word_offsets\\\"] for ring in rings],\\n            [ring[\\\"v\\\"][\\\"entry_word_offsets\\\"] for ring in rings],\\n            self._block_ids_gpu_ring,\\n            [ring[\\\"k\\\"][\\\"entries20x3\\\"] for ring in rings],\\n            [ring[\\\"v\\\"][\\\"entries20x3\\\"] for ring in rings],\\n            repack, hwm, plan.slots_gpu,\\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\\n            native_profile)\\n        plan.output_buffers = (k_cache, v_cache)\\n        plan.staged_bytes = plan.serial_native.wire_bytes\\n        if native_profile is not None:\\n            cd3_cpu_profile.record(\\\"load.native_plan_build_cpu_ms\\\", int(\\n                native_profile[\\\"native_plan_build_cpu_ms\\\"] * 1e6))\\n        return plan\\n\\n    @_nsys_trace.call(\\\"KV.CSR.H2D+Decode.ENQUEUE\\\", \\\"decomp\\\", key=\\\"plan.layer_id\\\")\\n    def _stage_decode_plan(\\n            self, plan: _DecodePlan, ring_slot: int,\\n            stream: torch.cuda.Stream, profile=None, *, decode_events=None) -> None:\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        if plan.block_ids_cpu is None:\\n            raise RuntimeError(\\\"ChunkDelta3 decode plan was already released\\\")\\n        metrics = kv_load_metrics.current()\\n        transfer = None\\n# CD3 KV 실행 모드\\n\\nCD3 KV는 두 모드만 지원한다. 기본값은 `hybrid`다.\\n\\n| `--cd3-kv-storage` | 저장 방식 | 전송·복원 |\\n| --- | --- | --- |\\n| `csr` | 기존 CSR append. 폐기된 entries는 garbage로 남는다. | K/V를 함께 전송한 뒤 paired decoder로 복원한다. |\\n| `hybrid` | 고정 body와 요청·layer·K/V별 16 KiB entries page. 선택한 페이지 전체를 전송한다. | K decode를 먼저 enqueue하고 V 전송과 겹치는 pipeline이다. |\\n\\n두 모드 모두 현재 CPU 최적화를 사용한다. Native encode/metadata 처리,\\n직접 pinned 메모리 할당, active-set·decode-plan 캐시와 staging ring을 유지한다.\\nKV exponent delta는 3bit, decoder는 128 threads로 고정한다.\\nWeight compression과 `--cd3-base-rows`는 기존 설정을 유지한다.\\n\\n## 실행\\n\\n기존 serving suite 명령에서 `--cd3-kv-storage hybrid`를 선택하면 현재 구현인\\n`page16`을 사용한다. 페이지 크기는 **16,384 bytes로 고정**이며 별도 page-size\\n인자나 자동 탐색이 없다. `--chunks 8192`는 기존 token batch 설정으로, 페이지\\n크기가 아니다. 다음은 사용자가 필요할 때 실행할 명령이며 구현 검증 중에는\\nserving/offline 성능 실험을 실행하지 않는다.\\n\\n```bash\\n# Hybrid/pipeline (기본값)\\nbash scripts/serving/run_performance_suite.sh \\\\\\n  --codecs cd3 --modes kvcomp --cd3-kv-storage hybrid \\\\\\n  --chunks 8192 --request-rates 1.2 --max-num-seqs 128\\n\\n# 기존 CSR append/serial: 나머지 실험 조건을 동일하게 지정한다.\\nbash scripts/serving/run_performance_suite.sh \\\\\\n  --codecs cd3 --modes kvcomp --cd3-kv-storage csr \\\\\\n  --chunks 8192 --request-rates 1.2 --max-num-seqs 128\\n\\n# Offline\\nbash scripts/offline/run_performance_suite.sh \\\\\\n  --methods cao-cd3-fused-kvcomp --cd3-kv-storage hybrid \\\\\\n  --batches 64 --repeats 1\\n```\\n\\nDriver를 직접 실행하면 `TIERED_SERVE_KV_CD3_STORAGE=csr|hybrid`를 사용한다.\\nHybrid에는 `TIERED_SERVE_KV_FULL_BLOCK_ONLY=1`과 block ownership이 필요하며,\\n조건이 맞지 않으면 초기화 오류를 낸다. Suite가 full-block 설정을 제공한다.\\n실행 로그와 manifest에는 선택된 storage와 그에 따른 execution이 기록된다.\\n\\n성능 비교에는 동일한 trace, 요청 수, trimming, dedicated KV 용량, RPS,\\nconcurrency와 CPU 배치를 사용한다. Serving의 byte/timing/CPU 계측은 기본 OFF다.\\n전송량 확인은 `--kv-byte-metrics`, GPU timing은 `--breakdown`, CPU 분석은\\n`--cd3-cpu-profile`로 별도 실행한다. Offline은 기존대로 byte 계측을 기본 제공한다.\\n\\n## 저장 및 수명 관리\\n\\nCSR은 native prefix 계산으로 새 entries를 tail에 append한다. 용량을\\n초과하거나 garbage 정리로 재할당을 피할 수 있을 때 worker가 compact한다.\\n전체 arena가 GPU staging보다 크면 선택된 블록의 entries만 repack한다.\\n이 두 용량 보호 경로는 유지한다. 매번 compact하는 정책이나 garbage hole에\\n삽입하는 별도 배치 알고리즘은 없다.\\n\\nHybrid encoder는 body를 기존 고정 slot에 직접 기록한다. Entries는 bounded\\nworker scratch를 거쳐 시작 시 예약한 pinned/registered arena의 페이지로 옮긴다.\\n같은 owner의 마지막 페이지 하나만 확인하는 O(1) 위치 결정이며 payload 복사는\\nO(record bytes)다. 6 KiB, 5 KiB, 4 KiB record는 한 페이지에 함께 들어간다.\\nRecord를 나누거나 이전 hole을 찾거나 기존 KV를 재압축하지 않는다. 0 entries는\\n페이지를 쓰지 않는다. 페이지 checkout/reuse 때만 전체를 0으로 초기화한다.\\n현재 codec/shape에서 계산한 최대 entries record가 16 KiB보다 크면 시작 시 거절한다.\\n\\nNative planner는 현재 decode chunk가 참조하는 페이지를 한 번씩 선택한다.\\nPool당 하나의 epoch/slot index를 재사용하며 entries 주소 정렬·span 병합은 없다.\\n기존 body-slot 정렬과 body span 병합은 유지한다. Decoder offset은\\n`(plan-local page slot * 16384 + record byte offset) / 8`이고 body/decoder 포맷은\\n바꾸지 않는다. 선택 페이지 안의 inactive/dead record와 tail padding도 전송된다.\\n\\nK/V 각각 body+metadata batch와 entries 전용 batch로 분리한다. Entries batch의\\n모든 길이는 16,384 bytes이며 마지막 페이지도 줄이지 않는다. 빈 entries batch는\\n생략해 chunk당 batch API 호출은 2~4회다. `cudaMemcpyBatchAsync` 지원이 없으면\\nhybrid 초기화 오류이며 개별 memcpy로 우회하지 않는다. K-ready 후 K decode를\\nCPU에서 enqueue한 다음 V batch를 제출한다. 두 ring의 consumed event와 attention의\\n기존 output-ready 의존성을 유지한다.\\n\\nHost allowance 안에 page table/free list, planner snapshots와 worker scratch를\\n포함한다. 기존 두 ring의 HBM 크기는 유지하며 side당 entries staging bytes / 16384의\\n내림값을 보수적인 chunk row 상한으로 사용한다(최악에는 record마다 페이지 하나).\\n따라서 페이지를 공유하는 경우에도 기존보다 chunk가 더 잘게 나뉠 수 있고,\\n같은 페이지를 chunk마다 재전송할 수 있다. 한 페이지조차 담지 못하면 초기화 오류다.\\n실제 host/GPU 예산, page16 정책, chunk 상한과 backend를 초기화 로그에 기록한다.\\n\\n두 모드 모두 비동기 H2D 완료까지 원본과 routing metadata를 보유한다.\\n새 full block 등록 시 계획을 무효화하고 pending writer를 등록한다. Worker는\\n이전 layer H2D 완료를 기다리고 끝난 plan lease를 회수한 뒤 tail에도 쓴다.\\nPending writer가 있는 layer에는 새 decode/H2D를 제출할 수 없으며 기존 loader의\\njoin/publish를 거쳐야 한다. Native append도 leased page 쓰기를 거절한다.\\nPublish·free는 layer generation을 갱신하고, canonical active-set version 변경은\\nchunk/routing을 다시 만든다. 변경이 없으면 identity/version 검사로 plan을 재사용한다.\\n\\nHybrid page의 record/reader/pending writer 보호와 generation 검증을 유지한다.\\nRequest retirement는 해당 record만 논리적으로 제거하고 마지막 H2D reader가 끝난\\n페이지를 반환한다. 남은 live record가 있으면 dead bytes를 그대로 둔다.\\n부분 제출 오류는 H2D와 이미 enqueue된 K decode 양쪽 stream을 drain한다. 완료를\\n확인할 수 없으면 source·metadata·ring·dense output을 quarantine한다. 명시적 shutdown도 진행 중인 작업을\\n완료시킨다. 유효 압축 용량을 넘는 예외 record는 authoritative secondary KV에서\\nraw로 복원하여 BF16 비트를 보존한다.\\n\\n## 결과 해석\\n\\n현재 hybrid/pipeline은 과거 가변 entries span 전송과 다른 `page16` 구현이다.\\nManifest에 이 식별자와 고정 페이지 정책을 기록한다. 고정 entries 길이는 관측된\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0f0a9-a0e9-7172-903d-1999fd14a141","create_time":1790744119.0721157}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
