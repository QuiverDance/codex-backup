ement registry.\\n# Encode workers never acquire lifecycle gates; wait_compress_async can join\\n# a worker while holding its layer gate. Shutdown still requires quiescence.\\ndef _hybrid_layer_gate(method):\\n    @wraps(method)\\n    def call(self, layer_id, *args, **kwargs):\\n        gates = getattr(self, \\\"_hybrid_layer_gates\\\", None)\\n        if self.storage_backend != \\\"hybrid\\\" or gates is None:\\n            return method(self, layer_id, *args, **kwargs)\\n        with gates[layer_id]:\\n            return method(self, layer_id, *args, **kwargs)\\n    return call\\n\\n\\ndef _hybrid_all_layer_gates(method):\\n    @wraps(method)\\n    def call(self, *args, **kwargs):\\n        gates = getattr(self, \\\"_hybrid_layer_gates\\\", None)\\n        if self.storage_backend != \\\"hybrid\\\" or gates is None:\\n            return method(self, *args, **kwargs)\\n        with ExitStack() as stack:\\n            for gate in gates:  # Fixed increasing layer order.\\n                stack.enter_context(gate)\\n            return method(self, *args, **kwargs)\\n    return call\\n\\n\\ndef _hybrid_retirement_registry(method):\\n    @wraps(method)\\n    def call(self, *args, **kwargs):\\n        if self.storage_backend != \\\"hybrid\\\":\\n            return method(self, *args, **kwargs)\\n        # Protect only the shared retired-plan list and arena/event recycling.\\n        # This lock must not enclose plan preparation or CUDA submission.\\n        with self._slot_state_lock:\\n            return method(self, *args, **kwargs)\\n    return call\\n\\n\\n@dataclass\\nclass _PersistentCSRState:\\n    entries: torch.Tensor\\n    offsets: torch.Tensor\\n    word_counts: np.ndarray\\n    used_words: int\\n    garbage_words: int\\n    max_words: int\\n    gpu_words: int\\n\\n\\n@dataclass\\nclass _DecodePlan:\\n    layer_id: int\\n    block_ids: np.ndarray\\n    block_ids_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event | None\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n    completion_valid: bool = True\\n    profile_active_entry_bytes: int | None = None\\n    side_payload: tuple = (0, 0)\\n    side_alignment: tuple = (0, 0)\\n    side_gap: tuple = (0, 0)\\n    csr_garbage_bytes: int = 0\\n    serial_native: Any = None\\n    output_buffers: tuple = ()\\n    entry_wire_bytes: tuple = (0, 0)\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    kv_load_metrics_supported = True\\n    supports_kv_ownership = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        required = (\\n            \\\"pack_host_chunk_delta3_entries_csr\\\",\\n            \\\"prepare_chunk_delta3_kv_serial\\\",\\n            \\\"KVSlotAllocator\\\",\\n            \\\"retire_kv_csr_slots\\\",\\n            \\\"prepare_host_chunk_delta3_csr_append\\\",\\n            \\\"append_host_chunk_delta3_csr\\\",\\n        )\\n        if (not _HAS_CHUNK_DELTA3\\n                or any(not hasattr(_cd3_ext, name) for name in required)):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the CSR KV decoder and native slot allocator\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        self._decode_ring_idx = 0\\n        self._gpu_decomp_pool_ring = []\\n        self._decode_consumed = []\\n        self._tb = False\\n        self.storage_backend = os.getenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", \\\"hybrid\\\")\\n        if self.storage_backend not in (\\\"csr\\\", \\\"hybrid\\\"):\\n            raise ValueError(\\\"CD3 KV storage must be csr or hybrid\\\")\\n        self.execution = \\\"pipeline\\\" if self.storage_backend == \\\"hybrid\\\" else \\\"serial\\\"\\n        if self.storage_backend == \\\"hybrid\\\":\\n            if os.getenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"0\\\") != \\\"1\\\":\\n                raise ValueError(\\\"CD3 hybrid requires TIERED_SERVE_KV_FULL_BLOCK_ONLY=1\\\")\\n            if not hasattr(_cd3_ext, \\\"HybridKVStore\\\"):\\n                raise RuntimeError(\\\"CD3 hybrid requires the updated native extension\\\")\\n            if (getattr(_cd3_ext, \\\"hybrid_page_bytes\\\", None) != 16384\\n                    or not getattr(_cd3_ext, \\\"hybrid_batch_supported\\\", False)):\\n                raise RuntimeError(\\\"CD3 hybrid requires the page16 extension with cudaMemcpyBatchAsync\\\")\\n        self._hybrid_stores = {}\\n        self._hybrid_ownership = {}\\n        self._entry_pool = None\\n        self._entry_arenas = []\\n        self._hybrid_allocator = None\\n        se