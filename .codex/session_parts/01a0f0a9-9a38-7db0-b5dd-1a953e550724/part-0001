ward and then\\n        # passes the same Python list to every layer.  Compare that set once at\\n        # the step boundary instead of running np.array_equal in every layer's\\n        # decompress_batch call.  The held list reference makes the identity\\n        # check generation-safe (CPython cannot recycle its id while held).\\n        self._prepared_active_list = None\\n        self._prepared_active_candidates = None\\n        self._prepared_active_version = 0\\n        self._storage_metrics_enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n\\n    @staticmethod\\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\\n\\n        result = compressed_block_bytes(\\\"chunk_delta3\\\", block_elements)\\n        assert result is not None\\n        return result\\n\\n    def _build_body_layout(self) -> None:\\n        layout = {}\\n        offset = 0\\n        for name, width, dtype, alignment in (\\n            (\\\"codes\\\", self._code_bytes, torch.uint8, 1),\\n            (\\\"sign_mantissa\\\", self._block_numel, torch.uint8, 1),\\n            (\\\"thread_bases\\\", self._base_bytes, torch.uint8, 1),\\n            (\\\"tile_exception_offsets\\\", self._tiles_per_block + 1,\\n             torch.int32, 4),\\n        ):\\n            offset = _align_up(offset, alignment)\\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\\n            layout[name] = (offset, nbytes, width, dtype)\\n            offset += nbytes\\n        self._body_stride = _align_up(offset, 128)\\n        self._body_layout = layout\\n        self._record_body_bytes = offset\\n\\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\\n        if huge_page_allocator is not None:\\n            numel = 1\\n            for size in shape:\\n                numel *= size\\n            # A configured serving allocator has already budgeted the CD3 KV