"K output must be a contiguous 3-D CUDA BF16 tensor\\\");\\n        TORCH_CHECK(v_output.is_cuda() && v_output.is_contiguous()\\n                        && v_output.sizes() == k_output.sizes()\\n                        && v_output.scalar_type() == at::kBFloat16,\\n                    \\\"V output must match K output\\\");\\n\\n        num_output_blocks = slots.numel();\\n        const int64_t rows = k_output.size(1);\\n        columns = k_output.size(2);\\n        TORCH_CHECK(num_output_blocks > 0 && rows > 0 && columns > 0\\n                        && rows % kTileDim == 0 && columns % kTileDim == 0,\\n                    \\\"CSR ChunkDelta3 dimensions must be positive multiples of 64\\\");\\n        tiles_per_block =\\n            (rows / kTileDim) * (columns / kTileDim);\\n        block_elements = rows * columns;\\n        const int64_t code_bytes = tiles_per_block * kTileElements * kKVDeltaBits / 8;\\n        const int64_t base_bytes = tiles_per_block * kBasesPerTile;\\n\\n        TORCH_CHECK(k_body.is_cuda() && k_body.is_contiguous()\\n                        && k_body.scalar_type() == at::kByte\\n                        && k_body.dim() == 2 && k_body.size(0) > 0,\\n                    \\\"invalid ChunkDelta3 K CSR body\\\");\\n        TORCH_CHECK(v_body.is_cuda() && v_body.is_contiguous()\\n                        && v_body.scalar_type() == at::kByte\\n                        && v_body.sizes() == k_body.sizes(),\\n                    \\\"invalid ChunkDelta3 V CSR body\\\");\\n        body_stride = k_body.size(1);\\n        TORCH_CHECK(body_stride % 8 == 0,\\n                    \\\"ChunkDelta3 CSR body stride must be 8-byte aligned\\\");\\n\\n        auto check_entries = [](const torch::Tensor& entries, const char* name) {\\n            TORCH_CHECK(entries.is_cuda() && entries.is_contiguous()\\n                            && entries.scalar_type() == at::kLong\\n                            && entries.dim() == 1,\\n                        \\\"invalid ChunkDelta3 \\\", name, \\\" CSR entries\\\");\\n        };\\n        check_entries(k_entries20x3, \\\"K\\\");\\n        check_entries(v_entries20x3, \\\"V\\\");\\n        auto check_entry_offsets = [body_rows = k_body.size(0)](\\n                const torch::Tensor& offsets, const char* name) {\\n            TORCH_CHECK(offsets.is_cuda() && offsets.is_contiguous()\\n                            && offsets.scalar_type() == at::kLong\\n                            && offsets.dim() == 1\\n                            && offsets.size(0) == body_rows,\\n                        \\\"invalid ChunkDelta3 \\\", name, \\\" CSR entry offsets\\\");\\n        };\\n        check_entry_offsets(k_entry_word_offsets, \\\"K\\\");\\n        check_entry_offsets(v_entry_word_offsets, \\\"V\\\");\\n        TORCH_CHECK(slots.is_cuda() && slots.is_contiguous()\\n                        && slots.scalar_type() == at::kInt && slots.dim() == 1,\\n                    \\\"invalid CSR ChunkDelta3 slots buffer\\\");\\n        TORCH_CHECK(output_blocks.is_cuda() && output_blocks.is_contiguous()\\n                        && output_blocks.scalar_type() == at::kLong\\n                        && output_blocks.dim() == 1\\n                        && output_blocks.numel() >= num_output_blocks,\\n                    \\\"invalid CSR ChunkDelta3 output-block buffer\\\");\\n\\n        auto align_up = [](int64_t value, int64_t alignment) {\\n            return (value + alignment - 1) / alignment * alignment;\\n        };\\n        sm_offset = code_bytes;\\n        base_offset = sm_offset + block_elements;\\n        offsets_offset = align_up(base_offset + base_bytes, 4);\\n        TORCH_CHECK(\\n            offsets_offset + (tiles_per_block + 1) * 4 <= body_stride,\\n            \\\"ChunkDelta3 CSR body is too small\\\");\\n\\n        TORCH_CHECK(num_output_blocks <= k_body.size(0),\\n                    \\\"CSR slots exceed staged body rows\\\");\\n        for (const auto& tensor : {k_body, v_body, k_entries20x3, v_entries20x3,\\n                                  k_entry_word_offsets, v_entry_word_offsets,\\n                                  slots, output_blocks, v_output}) {\\n            TORCH_CHECK(tensor.device() == k_output.device(),\\n                        \\\"CSR paired decoder tensors must share one CUDA device\\\");\\n        }\\n    }\\n\\n    void launch(cudaStream_t stream, int64_t begin_event, int64_t end_event) const\\n    {\\n        record_kv_probe_event(begin_event, stream);\\n        check_cuda_error(\\n            CD3_DecompressBatchedCSRPair(\\n                stream,\\n                k_body.data_ptr<uint8_t>(), v_body.data_ptr<uint8_t>(),\\n                static_cast<int>(body_stride), static_cast<int>(sm_offset),\\n                static_cast<int>(base_offset), static_cast<int>(offsets_offset),\\n                reinterpret_cast<const uint64_t*>(\\n                    k_entries20x3.data_ptr<int64_t>()),\\n                reinterpret_cast<const uint64_t*>(\\n                    v_entries20x3.data_ptr<int64_t>()),\\n                k_entry_word_offsets.data_ptr<int64_t>(),\\n                v_entry_word_offsets.data_ptr<int64_t>(),\\n                slots.data_ptr<int32_t>(), output_blocks.data_ptr<int64_t>(),\\n                reinterpret_cast<uint16_t*>(k_output.data_ptr()),\\n                reinterpret_cast<uint16_t*>(v_output.data_ptr()),\\n                static_cast<int>(num_output_blocks),\\n                static_cast<int>(tiles_per_block),\\n                static_cast<int>(block_elements), static_cast<int>(columns)),\\n            \\\"CD3_DecompressBatchedCSRPair\\\");\\n        record_kv_probe_event(end_event, stream);\\n    }\\n};\\n\\n#include \\\"chunk_delta3_csr_serial.h\\\"\\n\\n}  // namespace\\n# CD3 hybrid entries 전송 실험 — 2026-09-23\\n\\n첨부 제안은 실험할 가치가 있었다. 실제 hybrid의 descriptor 증가 대부분이 entries에서 나왔다. 하지만 이 GH200/B64 조건에서 entries-only compact는 전체 지연을 개선하지 못했다. 기본값은 `direct`로 유지하며, `compact`는 명시적으로 선택하는 A/B 옵션으로만 남긴다.\\n\\n## 실제 70B 실행 결과\\n\\nGH200, CUDA 13.0, Llama-3.1-70B-Instruct, KV 3-bit, B64, 입력 1020, 생성 129, 요청당 warmup 16, prefill chunk 8192, dedicated KV 2432블록. 각 행은 새 프로세스 1회 실행이다. `--breakdown`은 끄고 기본 바이트 카운터만 사용했다. 모든 실행은 정상 종료했고 GPU/hugepage가 유휴 상태로 돌아왔다.\\n\\n| 경로 | TPOT P50 (ms) | Decode 전체 descriptors | Entry source spans |\\n| --- | ---: | ---: | ---: |\\n| CSR / serial | 109.2936 | 88,320 | NA |\\n| Hybrid direct / pipeline | 109.4197 | 1,327,032 | 1,267,512 |\\n| 초기 compact (body 순서) | 122.8521 | 80,000 | 5,415,276 |\\n| 최종 compact (저장 순서) | 121.3347 | 80,000 | 1,267,512 |\\n\\n최종 compact는 direct보다 TPOT가 10.89% 느렸다. descriptor는 1,327,032 → 80,000개로 93.97% 감소했지만, 두 hybrid 경로의 decode H2D는 **893,356,842,000 bytes로 동일**했다. Body descriptors도 28,800개로 같았다. Entries descriptors만 1,267,512 → 20,480개로 줄었다. 두 hybrid 경로 모두 gap bytes는 0이었다.\\n\\nCSR/serial의 H2D는 893,791,277,776 bytes였고 이 실행의 gap bytes는 434,435,776이었다. 이번 조건에서는 기존 hybrid direct와 CSR/serial의 TPOT 차이가 작았다. 사용자가 관측한 다른 workload의 격차가 해결됐다는 의미는 아니다.\\n\\n## KV 갱신이 있는 구간\\n\\n계측을 추가하지 않고 scheduler 로그와 KV CSV를 연결했다. `Schedule Info`의 시간은 직전 schedule 이후 간격이므로 CSV step `i`를 schedule `i+2`에 대응시켰다. 64개 요청이 모두 살아 있는 step 24 이후에서 전송 대상 raw-equivalent KV bytes가 직전 step보다 증가한 경우와 같은 경우를 나눴다. 이 분류는 **실제 plan_hit counter가 아닌 관측 가능한 대리 지표**이고, 시간도 정확한 engine.step 내부 시간이 아닌 schedule 간격이다.\\n\\n| 경로 | KV bytes 증가: 53개 간격 P50 (ms) | KV bytes 유지: 52개 간격 P50 (ms) |\\n| --- | ---: | ---: |\\n| CSR / serial | 109.050 | 106.735 |\\n| Hybrid direct / pipeline | 109.120 | 107.110 |\\n| 초기 compact (body 순서) | 135.320 | 108.705 |\\n| 최종 compact (저장 순서) | 132.580 | 108.790 |\\n\\n손해가 KV bytes 증가 구간에 집중됐다. 따라서 descriptor 감소만 보고 채택하거나 plan 재사용 성능만으로 결론 내릴 수 없다. 이 실행은 CPU packing, buffer 재사용 대기, 계획 갱신, 새 블록 압축의 기여를 별도로 계측하지 않았으므로 하나를 원인으로 단정하지 않는다.\\n\\n## 구현과 검증\\n\\n- request-owned segment, generation 검사, reader lease, 기존 fixed body 전송을 유지했다.\\n- 모든 layer가 공유하는 두 K/V pinned transfer ring만 사용한다. 최종 B64 실행에서 전송용 reserve 1,073,762,304 bytes를 기존 host budget 안에서 차감했다. recipe metadata도 같은 예산에 포함한다.\\n- K packing → K H2D → K decode 등록 후 V packing을 진행한다. 버퍼는 해당 H2D 완료 이후에만 덮어쓴다. 불확실한 CUDA 완료는 재사용을 막는다.\\n- 최종 구현은 기존 direct planner의 저장 순서 정렬과 정확한 연속 구간을 재사용한다. 초기 body 순서는 CPU 복사 구간이 약 4.3배 많았고 TPOT도 더 높았다.\\n- chunk당 entries가 양쪽 모두 존재하면 H2D descriptor 수는 `2B + 5`이다. GPU 복원 offsets를 packed 위치에 맞춘다.\\n- 최종 native storage/encoder/production asynchronous pipeline 테스트 **19개 통과**. bit-exact KV 복원, sparse routing, 두 layer/ring 교차 사용, 해제·재사용, overflow, 전송 capacity 경계를 확인했다. metrics 테스트 **5개 통과**. 두 suite CLI dry-run 및 shell syntax도 통과했다.\\n- 소스 리뷰에서 추가 actionable 결함은 발견하지 못했다. 4-bit KV 및 긴 serving workload는 이번 성능 검증 범위에 포함하지 않았다.\\n\\n초기 구현의 실제 KV 샘플 256블록 시험도 모두 bit exact였다. Steady KV-ready wall 중앙값은 direct 0.1063ms, compact 0.1238ms였고, 같은 크기의 두 active set을 번갈아 바꾸면 0.1455ms, 0.1580ms였다. 샘플에서는 K/V entries가 각각 4구간뿐이었다. 이 측정은 전체 forward를 대체하지 않는다.\\n\\n## 재현\\n\\n컨테이너 `tiered-serve`, 저장소 `/root/projects/tiered-serve`에서 실행한다.\\n\\n```bash\\nbash scripts/offline/run_performance_suite.sh \\\\\\n  --methods cao-cd3-fused-kvcomp --batches 64 --repeats 1 \\\\\\n  --dedicated-kv-blocks 2432 \\\\\\n  --cd3-kv-storage hybrid --cd3-kv-execution pipeline \\\\\\n  --cd3-kv-entry-transfer compact\\n```\\n\\n직접 전송과 비교하려면 마지막 값을 `direct`로 바꾼다. Serving suite에도 같은 옵션이 있다. 압축기 직접 사용 시 환경 변수는 `TIERED_SERVE_KV_CD3_ENTRY_TRANSFER=compact`다. 기본은 `direct`다.\\n\\n각 실행의 `summary.tsv`, runner log, KV CSV와 집계는 다음 경로에 있다.\\n\\n- `benchmark_results/cd3_entry_transfer/csr_serial/20260923_122501/`\\n- `benchmark_results/cd3_entry_transfer/hybrid_direct/20260923_122933/`\\n- `benchmark_results/cd3_entry_transfer/hybrid_compact/20260923_123244/`\\n- `benchmark_results/cd3_entry_transfer/hybrid_compact_storage_order/20260923_123944/`\\n\\n기계가 읽을 수 있는 통합 결과: `benchmark_results/cd3_entry_transfer/results.json`. 초기 샘플 로그: `benchmark_results/cd3_entry_transfer/sampled_kv/`.\\n\\n기준 commit: `19a15c5d66d14481acb7e00c5e6f371d8ffb0964` 위의 미커밋 변경. 최종 측정 native header SHA-256: `45d7d8f1