s CPU int64\");\n    TORCH_CHECK(!slots.is_cuda() && slots.is_contiguous()\n                    && slots.dim() == 1\n                    && slots.scalar_type() == at::kLong\n                    && slots.numel() == block_ids.numel(),\n                \"slots must be contiguous CPU int64 matching block_ids\");\n    TORCH_CHECK(rows > 0 && columns > 0\n                    && rows % kTileDim == 0\n                    && columns % kTileDim == 0,\n                \"host ChunkDelta3 dimensions must be positive multiples \"\n                \"of 64\");\n\n    const int64_t blocks = block_ids.numel();\n    if (blocks == 0) {\n        return;\n    }\n    const int64_t block_elements = rows * columns;\n    TORCH_CHECK(source.dim() >= 2 && source.size(0) > 0\n                    && source.numel() == source.size(0) * block_elements,\n                \"source shape is incompatible with rows*columns\");\n    const int64_t tiles_per_block =\n        (rows / kTileDim) * (columns / kTileDim);\n    const int64_t code_bytes = tiles_per_block * kCodeBytesPerTile;\n    const int64_t base_bytes = tiles_per_block * kThreads;\n    const int64_t host_slots = codes.size(0);\n\n    auto check_cpu_byte_2d = [host_slots](\n            const torch::Tensor& tensor, int64_t width, const char* name) {\n        TORCH_CHECK(!tensor.is_cuda() && tensor.is_contiguous()\n                        && tensor.scalar_type() == at::kByte\n                        && tensor.dim() == 2\n                        && tensor.size(0) == host_slots\n                        && tensor.size(1) == width,\n                    \"invalid host ChunkDelta3 \", name, \" buffer\");\n    };\n    check_cpu_byte_2d(codes, code_bytes, \"codes\");\n    check_cpu_byte_2d(\n        sign_mantissa, block_elements, \"sign_mantissa\");\n    check_cpu_byte_2d(thread_bases, base_bytes, \"thread_bases\");\n    TORCH_CHECK(!tile_exception_offsets.is_cuda()\n                    && tile_exception_offsets.is_contiguous()\n                    && tile