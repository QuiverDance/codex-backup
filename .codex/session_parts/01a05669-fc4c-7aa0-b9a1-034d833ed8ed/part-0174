{"timestamp":"2026-09-01T03:46:42.977Z","ordinal":8036,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05b13-8ca1-79a3-86d2-2a125d4c0d5a","call_id":"call_vNWnZypPwk17jV7p7AV0MQza","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"CPU encode LATENCY + GiB/s + GPU-decode bit-exactness for the production KV\npath (compress_batch_async_from_host -> C++ CPU encoder -> GPU\ndecompress_batch), for chunk_delta3, p4flat, ublb_flat, bitcomp, and zipserv.\n\nUse OMP_NUM_THREADS for the OpenMP codecs and\nTIERED_SERVE_KV_COMPRESS_WORKERS for worker-pool codecs.\n\nExamples:\n  python benchmarks/kv_cpu_encode.py --codec chunk_delta3 --blocks 1024,2048\n  python benchmarks/kv_cpu_encode.py --codec p4flat --blocks 1024,2048\n\"\"\"\nimport argparse\nimport os\nimport sys\nimport time\n\n# Make the repository package importable during direct script execution.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor, _factor_64\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\nfrom tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3CPUKVCompressor\nfrom tiered_serve.compression.core.zipserv import ZipServCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns, iterations):\n    comp = cls(torch.cuda.Stream())\n    max_blocks = max(ns)\n    host_pool_blocks = max_blocks\n    if issubclass(cls, ZipServCompressor):\n        # ZipServ's size-class slub allocator reserves payloads in chunks.\n        # Keep capacity headroom when this benchmark fills every logical slot.\n        host_pool_blocks += max(64, max_blocks // 4)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=host_pool_blocks,\n                           n_layers=1,\n                           max_gpu_blocks=max_blocks,\n                           max_gpu_decomp_blocks=max_blocks)\n    default_workers = max(1, (os.cpu_count() or 1) - 10)\n    n_workers = int(os.environ.get(\n        \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers))\n    comp.init_kv_compress_workers(n_workers, max_blocks, 1)\n    actual_workers = getattr(comp, \"_n_workers\", n_workers)\n    print(f\"  {name:>10}  (OMP={os.environ.get('OMP_NUM_THREADS', 'all')}, \"\n          f\"workers={actual_workers})\")\n    for N in ns:\n        ids = list(range(N))\n        k, v = hk[:N].contiguous(), hv[:N].contiguous()\n        comp.compress_batch_async_from_host(0, ids, k, v, 0)\n        comp.wait_compress_async(0, BS)                       # warmup\n        samples = []\n        for _ in range(iterations):\n            # Dense-slot codecs need their benchmark scratch allocation reset.\n            # ZipServ recycles reservations when the same block IDs are reused.\n            if hasattr(comp, \"_kv_active_count\"):\n                comp._kv_active_count[0] = 0\n            if hasattr(comp, \"_kv_slot\"):\n                comp._kv_slot[0].fill_(-1)\n            t0 = time.perf_counter()\n            comp.compress_batch_async_from_host(0, ids, k, v, 0)\n            comp.wait_compress_async(0, BS)\n            samples.append(time.perf_counter() - t0)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        ordered = sorted(samples)\n        best = ordered[0]\n        median = ordered[len(ordered) // 2]\n        print(f\"     N={N:>4} (K+V {mb:5.0f} MiB) : \"\n              f\"min/med={best*1e3:7.2f}/{median*1e3:7.2f} ms\"\n              f\"   ({mb/1024/median:5.1f} GiB/s)\")\n    # bit-exact: GPU-decode the last-compressed batch and compare to the source.\n    N = max(ns); ids = list(range(N))\n    kc = torch.zeros(N, *BS, dtype=torch.bfloat16, device=\"cuda\")\n    vc = torch.zeros_like(kc)\n    comp.decompress_batch(0, ids, (kc, vc)); torch.cuda.synchronize()\n    k_exact = torch.equal(kc.cpu().view(torch.uint16),\n                          hk[:N].view(torch.uint16))\n    v_exact = torch.equal(vc.cpu().view(torch.uint16),\n                          hv[:N].view(torch.uint16))\n    print(f\"     bit-exact (GPU decode vs src) = {k_exact and v_exact}\")\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--blocks\", default=\"1024,2048,4096\")\n    parser.add_argument(\"--codec\", default=(\n        \"p4flat,ublb_flat,bitcomp,zipserv\"))\n    parser.add_argument(\"--iterations\", type=int, default=8)\n    args = parser.parse_args()\n    ns = [int(value) for value in args.blocks.split(\",\")]\n    selected = set(args.codec.split(\",\"))\n    hk, hv = load(max(ns))\n    for cls, name in [(ChunkDelta3CPUKVCompressor, \"chunk_delta3\"),\n                      (P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\"),\n                      (ZipServCompressor, \"zipserv\")]:\n        if name in selected:\n            bench(cls, name, hk, hv, ns, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n\n_ROLE_PATS = (\n    (\"q_proj\", \"q\"), (\"k_proj\", \"k\"), (\"v_proj\", \"v\"), (\"o_proj\", \"o\"),\n    (\"gate_proj\", \"gate\"), (\"up_proj\", \"up\"), (\"down_proj\", \"down\"),\n    (\".wq.\", \"q\"), (\".wk.\", \"k\"), (\".wv.\", \"v\"), (\".wo.\", \"o\"),\n    (\".w1.\", \"gate\"), (\".w3.\", \"up\"), (\".w2.\", \"down\"),\n)\n\n#: Fused group name -> the projection roles concatenated along dim 0.\n_GROUP_DEFS = OrderedDict([\n    (\"qkv\", (\"q\", \"k\", \"v\")),\n    (\"o\", (\"o\",)),\n    (\"gateup\", (\"gate\", \"up\")),\n    (\"down\", (\"down\",)),\n])\n\n\ndef _role(key):\n    for pat, r in _ROLE_PATS:\n        if pat in key:\n            return r\n    return None\n\n\ndef _build_layer_index(shards, layer_filter):\n    \"\"\"Map ``layer_idx -> {role: (shard_path, key)}`` across all shards.\"\"\"\n    index = {}\n    for shard in shards:\n        with safe_open(shard, framework=\"pt\") as sf:\n            for k in sf.keys():\n                r = _role(k)\n                if r is None:\n                    continue\n                m = _LAYER_RE.search(k)\n                if m is None:\n                    continue\n                li = int(m.group(1))\n                if layer_filter is not None and li != layer_filter:\n                    continue\n                index.setdefault(li, {})[r] = (shard, k)\n    return index\n\n\ndef _load_layer(parts):\n    \"\"\"Load every projection tensor for one layer; ``role -> CPU tensor``.\"\"\"\n    by_shard = {}\n    for role, (shard, key) in parts.items():\n        by_shard.setdefault(shard, []).append((role, key))\n    out = {}\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for role, key in items:\n                out[role] = sf.get_tensor(key)\n    return out\n\n\ndef _max_fused_numel(index, group_filter):\n    \"\"\"Largest element count among the fused groups that will be benchmarked.\n\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n                    && entries20x3.dim() == 2\n                    && entries20x3.size(0) == num_blocks,\n                \"invalid batched ChunkDelta3 packed-entry buffer\");\n    TORCH_CHECK(num_exceptions.is_cuda() && num_exceptions.is_contiguous()\n                    && num_exceptions.scalar_type() == at::kInt\n                    && num_exceptions.sizes()\n                        == c10::IntArrayRef({num_blocks}),\n                \"invalid batched ChunkDelta3 exception-count buffer\");\n\n    const c10::cuda::CUDAGuard device_guard(source.device());\n    auto tile_counts = torch::empty(\n        {num_blocks, tiles_per_block},\n        source.options().dtype(at::kInt));\n    check_cuda_error(\n        CD3_Compress