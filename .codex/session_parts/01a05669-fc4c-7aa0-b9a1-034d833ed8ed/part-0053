thr_mma = tiled_mma.get_thread_slice(tid);\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n    clear(tCrC);\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n\n    using SmemLayoutA = decltype(tile_to_shape(\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n                                SmemLayoutA{});\n    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n\n    auto load_b = [&](int k_tile, int pipe) {\n        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n    };\n\n    auto load_compressed = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\n        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\n        if (tid < 96)\n            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n        #pragma unroll\n        for (int j = 0; j < 2; ++j) {\n            const int chunk = tid + j * 128;\n            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\n        }\n        if (tid < 16)\n            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\n    };\n\n    auto build_exception_map = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int begin = tile_offsets_g[tile_idx];\n        const int end = tile_offsets_g[tile_idx + 1];\n        smem.s_exc_mask[st][tid] = 0;\n        __syncthreads();\n        for (int e = begin + tid; e < end; e += 128) {\n            const int64_t group = static_cast<int64_t>(e) / 3;\n            const int slot = e - static_cast<int>(group * 3);\n            const uint32_t entry = static_cast<uint32_t>(\n                (entries20x3_g[group] >> (slot * 20)) & 0xfffff