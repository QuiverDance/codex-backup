    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchCD3RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint64_t* entries20x3,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\n        (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, bases, tile_offsets, entries20x3,\n        B, C, Cf32, M, N, K, spli