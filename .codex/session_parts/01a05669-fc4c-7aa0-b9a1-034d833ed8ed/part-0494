 max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbytes + host_v.nbytes) / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    extra = \"\"\n    if args.codec == \"chunk_delta3\":\n        transfer_bytes = sum(\n            tensor.nbytes for tensor in plan[\"copy_sources\"])\n        extra = (\n            f\"transfer_bytes={transfer_bytes} \"\n            f\"ratio={(host_k.nbytes + host_v.nbytes) / transfer_bytes:.4f}x \"\n            f\"body_stride={compressor._body_stride} \"\n            f\"scratch_capacity={compressor._entry_capacity} \")\n    print(\n        f\"codec={args.codec} blocks={args.blocks} cpu_encode={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"{extra}\"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n    compressor.stop_kv_compress_workers()\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\nimport numpy as np\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3KVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int, cycle_input: bool = False):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    available = min(len(saved[k_name]), len(saved[\"v_blocks\"]))\n    if available < count and not cycle_input:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    indices = (range(count) if available >= count\n               else (index % available for index in range(count)))\n    indices = list(indices)\n    k = torch.stack(\n        [saved[k_name][index].contiguous() for index in indices])\n    v = torch.stack(\n        [saved[\"v_blocks\"][index].contiguous() for index in indices])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef align_up(value: int, alignment: int):\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef allocate_csr_encode_buffers(blocks: int, packed_capacity: int):\n    \"\"\"Allocate a fixed body and a temporary growable exception matrix.\"\"\"\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n    block_elements = int(np.prod(BLOCK_SHAPE))\n    tiles = block_elements // 4096\n    base_rows = int(_cd3_ext.compiled_base_rows())\n    code_bytes = tiles * 1536\n    sm_offset = code_bytes\n    base_offset = sm_offset + block_elements\n    base_bytes = tiles * (256 // base_rows)\n    offsets_offset = align_up(base_offset + base_bytes, 4)\n    body_used = offsets_offset + (tiles + 1) * 4\n    body_stride = align_up(body_used, 128)\n    body = torch.empty(\n        (blocks, body_stride), dtype=torch.uint8).pin_memory()\n    views = {\n        \"codes\": body[:, :code_bytes],\n        \"sign_mantissa\": body[:, sm_offset:base_offset],\n        \"thread_bases\": body[:, base_offset:base_offset + base_bytes],\n        \"tile_exception_offsets\": body[\n            :, offsets_offset:body_used].view(torch.int32),\n    }\n    entries = torch.empty(\n        (blocks, packed_capacity), dtype=torch.int64).pin_memory()\n    counts = torch.empty((blocks,), dtype=torch.int32).pin_memory()\n    return body, views, entries, counts, body_stride\n\n\ndef encode_csr_side(\n        source: torch.Tensor, initial_capacity: int, growth: int):\n    \"\"\"Encode with bounded scratch, growing in Packed20-safe increments.\"\"\"\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n    blocks = source.shape[0]\n    block_ids = torch.arange(blocks, dtype=torch.int64)\n    slots = torch.arange(blocks, dtype=torch.int64)\n    capacity = align_up(max(3, initial_capacity), 3)\n    growth = align_up(max(3, growth), 3)\n    attempts = 0\n    while True:\n        packed_capacity = (capacity + 2) // 3\n        body, views, entries, counts, body_stride = \\\n            allocate_csr_encode_buffers(blocks, packed_capacity)\n        _cd3_ext.host_encode_chunk_delta3_blocks(\n            source.view(torch.int16), block_ids, slots,\n            views[\"codes\"], views[\"sign_mantissa\"],\n            views[\"thread_bases\"], views[\"tile_exception_offsets\"],\n            entries, counts, 128, 128)\n        attempts += 1\n        maximum = int(counts.max())\n        if maximum <= capacity:\n            break\n        capacity += ((maximum - capacity + growth - 1) // growth) * growth\n\n    count_array = counts.numpy().astype(np.int64, copy=False)\n    word_counts = (count_array + 2) // 3\n    raw_bytes_per_side = int(source[0].nbytes)\n    raw_preferred = (\n        body_stride + word_counts * 8 + 8 >= raw_bytes_per_side)\n    word_offsets = np.empty(blocks, dtype=np.int64)\n    if blocks:\n        word_offsets[0] = 0\n        if blocks > 1:\n            np.cumsum(word_counts[:-1], out=word_offsets[1:])\n    total_words = int(word_counts.sum())\n    packed = torch.empty((total_words,), dtype=torch.int64).pin_memory()\n    offsets = torch.empty((blocks,), dtype=torch.int64).pin_memory()\n    offsets.numpy()[:] = word_offsets\n    packed_array = packed.numpy()\n    entries_array = entries.numpy()\n    for block, words in enumerate(word_counts):\n        words = int(words)\n        begin = int(word_offsets[block])\n        packed_array[begin:begin + words] = entries_array[block, :words]\n    return {\n        \"body\": body,\n        \"entries\": packed,\n        \"entry_word_offsets\": offsets,\n        \"counts\": counts,\n        \"capacity\": capacity,\n        \"attempts\": attempts,\n        \"body_stride\": body_stride,\n        \"raw_preferred\": raw_preferred,\n    }\n\n\ndef run_csr(args, host_k, host_v):\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n    from tiered_serve.cpp_exts import zipserv_ext\n\n    started = time.perf_counter()\n    encoded_k = encode_csr_side(\n        host_k, args.initial_exception_capacity, args.capacity_growth)\n    encoded_v = encode_csr_side(\n        host_v, args.initial_exception_capacity, args.capacity_growth)\n    encode_ms = (time.perf_counter() - started) * 1e3\n    if encoded_k[\"body_stride\"] != encoded_v[\"body_stride\"]:\n        raise RuntimeError(\"K/V CSR body strides do not match\")\n\n    stream = torch.cuda.Stream()\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    slots = torch.arange(args.blocks, dtype=torch.int32, device=\"cuda\")\n    output_blocks = torch.arange(\n        args.blocks, dtype=torch.int64, device=\"cuda\")\n    device = {}\n    for side, encoded in ((\"k\", encoded_k), (\"v\", encoded_v)):\n        device[f\"{side}_body\"] = torch.empty(\n            encoded[\"body\"].shape, dtype=torch.uint8, device=\"cuda\")\n        device[f\"{side}_entries\"] = torch.empty(\n            encoded[\"entries\"].shape, dtype=torch.int64, device=\"cuda\")\n        device[f\"{side}_offsets\"] = torch.empty(\n            encoded[\"entry_word_offsets\"].shape,\n            dtype=torch.int64, device=\"cuda\")\n\n    all_destinations = [\n        device[\"k_body\"], device[\"v_body\"],\n        device[\"k_entries\"], device[\"v_entries\"],\n        device[\"k_offsets\"], device[\"v_offsets\"],\n    ]\n    all_sources = [\n        encoded_k[\"body\"], encoded_v[\"body\"],\n        encoded_k[\"entries\"], encoded_v[\"entries\"],\n        encoded_k[\"entry_word_offsets\"], encoded_v[\"entry_word_offsets\"],\n    ]\n    copy_pairs = [\n        (destination, source)\n        for destination, source in zip(all_destinations, all_sources)\n        if source.numel() > 0\n    ]\n    destinations = [pair[0] for pair in copy_pairs]\n    sources = [pair[1] for pair in copy_pairs]\n\n    def h2d_only():\n        zipserv_ext.batch_memcpy(\n            destinations, sources, stream.cuda_stream)\n\n    def resident_decode():\n        _cd3_ext.decompress_chunk_delta3_batched_csr_pair_stream(\n            device[\"k_body\"], device[\"v_body\"],\n            device[\"k_entries\"], device[\"v_entries\"],\n            device[\"k_offsets\"], device[\"v_offsets\"], slots, output_blocks,\n            output_k.view(args.blocks, 128, 128),\n            output_v.view(args.blocks, 128, 128), stream.cuda_stream)\n\n    def production():\n        h2d_only()\n        resident_decode()\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    production()\n    torch.cuda.synchronize()\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n\n    transfer_bytes = sum(tensor.nbytes for tensor in sources)\n    raw_bytes = host_k.nbytes + host_v.nbytes\n    raw_gib = raw_bytes / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    k_counts = encoded_k[\"counts\"].numpy()\n    v_counts = encoded_v[\"counts\"].numpy()\n    print(\n        f\"codec=chunk_delta3_csr blocks={args.blocks} \"\n        f\"cpu_encode_pack={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"transfer_bytes={transfer_bytes} ratio={raw_bytes / transfer_bytes:.4f}x \"\n        f\"body_stride={encoded_k['body_stride']} \"\n        f\"scratch_capacity_k_v={encoded_k['capacity']}/{encoded_v['capacity']} \"\n        f\"encode_attempts_k_v={encoded_k['attempts']}/{encoded_v['attempts']} \"\n        f\"exceptions_mean_k_v={k_counts.mean():.2f}/{v_counts.mean():.2f} \"\n        f\"exceptions_max_k_v={k_counts.max()}/{v_counts.max()} \"\n        f\"raw_preferred_k_v={encoded_k['raw_preferred'].sum()}/\"\n        f\"{encoded_v['raw_preferred'].sum()} \"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n\n\ndef run_raw(args, host_k, host_v):\n    from tiered_serve.cpp_exts import zipserv_ext\n\n    stream = torch.cuda.Stream()\n    output_k = torch.empty_like(host_k, device=\"cuda\")\n    output_v = torch.empty_like(host_v, device=\"cuda\")\n    destinations = [output_k, output_v]\n    sources = [host_k, host_v]\n\n    def run_once():\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record(stream)\n        zipserv_ext.batch_memcpy(destinations, sources, stream.cuda_stream)\n        end.record(stream)\n        end.synchronize()\n        return begin.elapsed_time(end)\n\n    for _ in range(args.warmup):\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06c20-69b9-7a41-9681-ff7aee6ae96e","create_time":1788521348.9575517}}}
