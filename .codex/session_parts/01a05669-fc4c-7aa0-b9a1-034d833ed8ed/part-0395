  from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_cpu_weight_encode_stages_and_roundtrips_bit_exact() -> None:\n    codec = _codec()\n    generator = torch.Generator().manual_seed(911)\n    source = torch.randn(\n        256, 256, generator=generator, dtype=torch.float32\n    ).to(torch.bfloat16).contiguous()\n\n    compressed = codec.compress(source)\n    assert compressed.sign_mantissa.device.type == \"cpu\"\n    output = torch.empty(source.shape, dtype=source.dtype, device=\"cuda\")\n    compressed.register_temp_d_tensor(output)\n    compressed.to(non_blocking=False)\n    restored = codec.decompress(compressed, output)\n    torch.cuda.synchronize()\n\n    _assert_bit_exact(restored.cpu(), source)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\n@pytest.mark.parametrize(\"split_h2d\", [False, True])\ndef test_cpu_kv_backend_async_roundtrip_and_pending_free(\n        split_h2d: bool) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        if split_h2d:\n            compressor.load_kv_stream = torch.cuda.Stream()\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        # Freeing an ID after enqueue must quarantine its captured slot; the\n        # retiring worker may finish writing it but must not republish it.\n        compressor.free_persistent_block(0, 1)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        prepared = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared, torch.tensor(prepared).numpy())\n        initial_active_version = compressor._prepared_active_version\n        compressor.decompress_batch(\n            0, prepared, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # A newly materialized list with identical content keeps the version;\n        # the held identity still proves that per-layer fast-path calls belong\n        # to the currently prepared step.\n        prepared_same = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared_same, torch.tensor(prepared_same).numpy())\n        assert compressor._prepared_active_version == initial_active_version\n        assert compressor._prepared_active_list is prepared_same\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        active = [2, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        assert compressor._prepared_active_version == initial_active_version + 2\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n\n        compressor.free_persistent_block(0, 6)\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(v_cache[2].cpu(), host_v[2])\n        assert torch.count_nonzero(k_cache[6]).item() == 0\n        assert torch.count_nonzero(v_cache[6]).item() == 0\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 16, 32, 40, 48, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\nimport numpy as np\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3KVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    if len(saved[k_name]) < count or len(saved[\"v_blocks\"]) < count:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    k = torch.stack(\n        [value.contiguous() for value in saved[k_name][:count]])\n    v = torch.stack(\n        [value.contiguous() for value in saved[\"v_blocks\"][:count]])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--blocks\", type=int, required=True)\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    codec_type = (ChunkDelta3KVCompressor\n                  if args.codec == \"chunk_delta3\"\n                  else P4FlatCPUKVCompressor)\n    host_k, host_v = load_blocks(args.path, args.blocks)\n    compressor = codec_type(torch.cuda.Stream())\n    compressor.warmup_kv_buffers(\n        block_shape=BLOCK_SHAPE, max_n_blocks=args.blocks,\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0, block_ids, (output_k, output_v))\n\n    # Mirror the loader's once-per-forward active-set publication.  CD3 uses\n    # this to reuse a generation-checked decode plan without repeating an O(N)\n    # content comparison in every layer; other codecs are unchanged.\n    prepare_active = getattr(compressor, \"prepare_active_set\", None)\n    if prepare_active is not None:\n        prepare_active(block_ids, np.asarray(block_ids, dtype=np.int64))\n\n    # Populate device blobs, decode metadata, and the CD3 steady-state plan.\n    production()\n    torch.cuda.synchronize()\n\n    if args.codec == \"chunk_delta3\":\n        from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n        plan = compressor._decode_plans[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                plan[\"copy_destinations_ring\"][0], plan[\"copy_sources\"])\n\n        def resident_decode():\n            rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair_stream(\n                compressor._gpu_decomp_pool[\"k\"][\"blob\"][:rows],\n                compressor._gpu_decomp_pool[\"v\"][\"blob\"][:rows],\n                plan[\"slots_gpu\"], plan[\"block_ids_gpu\"],\n                output_k.view(args.blocks, 128, 128),\n                output_v.view(args.blocks, 128, 128),\n                compressor._packed_capacity, stream.cuda_stream)\n    else:\n        blob_stride, block_numel, k_width, max_rows, max_exc = \\\n            compressor._fast_const\n        gi = compressor._gi_dev_ring[0]\n        gu = compressor._gu_dev_ring[0]\n        gb = compressor._gb_dev_ring[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                [compressor._gpu_dec_blob[:args.blocks],\n                 compressor._gpu_dec_blob_v[:args.blocks]],\n                [compressor._host_pools[0][\"k\"][\"blob\"][:args.blocks],\n                 compressor._host_pools[0][\"v\"][\"blob\"][:args.blocks]])\n\n        def resident_decode():\n            compressor._invoke_decode_layer(\n                compressor._gpu_dec_blob,\n                compressor._gpu_dec_blob_v,\n                blob_stride, gi, gu, gb, args.blocks,\n                output_k, output_v, block_numel, k_width,\n                max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbytes + host_v.nbytes) / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    print(\n        f\"codec={args.codec} blocks={args.blocks} cpu_encode={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n    compressor.stop_kv_compress_workers()\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06186-6325-79b3-9454-03c11387a0a9","create_time":1788342695.0516565}}}
