compress_workers()\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 16, 32, 40, 48, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\nimport numpy as np\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3KVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"