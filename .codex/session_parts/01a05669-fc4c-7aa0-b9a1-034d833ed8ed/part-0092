txas=-v\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\",\n    ],\n)\n\n# ZipServ Offset-Table (OT) ablation codec — replaces ZipServ's bitmap\n# + __popcll dynamic addressing with explicit per-group offset tables.\n# Decoder-only ablation experiment; no fused MM, no WGMMA path.\n_submit(\n    \"zipserv_ot_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_ot_ext.cpp\",\ncase \"$KV_BACKEND\" in\n  zipserv|dietgpu|mantexp|p4flat|p4flatcpu|ublb_flat) ;;\n  *) die \"unsupported --kv-backend: ${KV_BACKEND}\" ;;\nesac\n\nif [[ -n \"$START_FROM\" ]]; then\n  selected_methods=()\n  found_start=0\n  for method in \"${METHODS[@]}\"; do\n    if [[ \"$method\" == \"$START_FROM\" ]]; then\n      found_start=1\n    fi\n    if ((found_start)); then\n      selected_methods+=(\"$method\")\n    fi\n  done\n  ((found_start)) || die \"unknown --start-from method: ${START_FROM}\"\n  METHODS=(\"${selected_methods[@]}\")\nfi\n\nMODEL_OWNER=\"${MODEL%%/*}\"\nMODEL_NAME=\"${MODEL##*/}\"\nCONFIG_ROOT=\"${REPO_ROOT}/tiered_serve/model_configs/${MODEL_OWNER}/${MODEL_NAME}\"\n\n# Sets METHOD_LABEL, CONFIG_STEM, EXPECTED_CODEC, METHOD_ENV, and FEATURE_ARGS.\nbuild_method() {\n  local method=\"$1\"\n  FEATURE_ARGS=()\n  METHOD_ENV=()\n  EXPECTED_CODEC=\"\"\n  case \"$method\" in\n    flexgen)\n      METHOD_LABEL=\"FlexGen\"\n      CONFIG_STEM=\"flexgen\"\n      ;;\n    flexgen-zipserv)\n      METHOD_LABEL=\"FlexGen(w/ zipserv)\"\n      # Fused-MM is a CLI feature. This YAML is the current ZipServ\n      # offload_compressed placement and is valid with or without the flag.\n      # flexgen-comp.yaml cannot be used here: it is currently P4Flat.\n      CONFIG_STEM=\"flexgen-comp-fused\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv)\n      ;;\n    flexgen-zipserv-fused)\n      METHOD_LABEL=\"FlexGen-fused(w/ zipserv)\"\n      CONFIG_STEM=\"flexgen