ups;\n    return out;\n}\n\n/* Fused decompress + GEMM: C = A_decoded @ B where A is p4flat-compressed.\n *  - comp:    CompressedP4Flat for the (M, K) weight matrix A.\n *  - B:       CUDA bfloat16 (K, N) row-major.\n *  - output:  optional CUDA bfloat16 (M, N) row-major; allocated if absent.\n *\n * Returns the output tensor.  Exceptions (rare bf16 values that didn't fit\n * the per-tile palette) are corrected by a follow-up rank-1 patch kernel\n * driven by the compressor's (group_m, group_offsets) CSR. */\nstatic torch::Tensor p4flat_fused_mm(\n          py::arg(\"n\"),\n          \"Scatter n GPU staging blobs to host-pool slot rows in one batched \"\n          \"D2H (cudaMemcpyBatchAsync); used-bytes-only, no host scatter.\");\n    m.def(\"decode_layer_prep\", &p4flat_decode_layer_prep,\n          py::arg(\"cand\"), py::arg(\"valid\"), py::arg(\"slot_tbl\"),\n          py::arg(\"kvr\"), py::arg(\"kec\"), py::arg(\"kir\"),\n          py::arg(\"vvr\"), py::arg(\"vec\"), py::arg(\"vir\"),\n          py::arg(\"pif\"), py::arg(\"puf\"), py::arg(\"bif\"),\n          py::arg(\"gi\"), py::arg(\"gu\"), py::arg(\"gb\"),\n          py::arg(\"hkb\"), py::arg(\"hvb\"), py::arg(\"gkb\"), py::arg(\"gvb\"),\n          py::arg(\"active\"), py::arg(\"ring_ev\"), py::arg(\"dec_ev\"),\n          py::arg(\"stream\"),\n          \"One-call per-layer KV decode staging: valid-filter + slot/meta \"\n          \"gather into the pinned ring, meta+blob async H2D, event records. \"\n          \"Returns n blocks (0=skip, -1=valid/slot desync).\");\n    m.def(\"blob_gather_h2d\", &p4flat_blob_gather_h2d,\n          py::arg(\"src\"), py::arg(\"dst\"), py::arg(\"slots\"), py::arg(\"sizes\"),\n          py::arg(\"n\"),\n          \"Gather n host-pool slot rows into GPU staging rows 0..n-1 in one \"\n          \"batched H2D (cudaMemcpyBatchAsync); used-bytes-only, skips padding \"\n          \"and inactive slots.  H2D analog of blob_scatter_d2h.\");\n    m.def(\"host_decode_blocks\", &p4flat_host_decode_blocks,\n          py::arg(\"blob\"), py::arg(\"blob_stride\"), py::arg(\"slots\"),\n          py::arg(\"valid_rows\"), py::arg(\"exc_cnt\"), py::arg(\"is_raw\"),\n          py::arg(\"out\"), py::arg(\"M_b\"), py::arg(\"K_b\"), py::arg(\"row_major_sm\"),\n          \"CPU OpenMP batch decode (benchmark/reference; serving decode is GPU).\");\n    m.def(\"host_encode_blocks\", &p4flat_host_encode_blocks,\n          py::arg(\"src\"), py::arg(\"block_ids\"), py::arg(\"slots\"),\n          py::arg(\"blob\"), py::arg(\"total_size\"), py::arg(\"exc_cnt\"),\n          py::arg(\"is_raw\"), py::arg(\"valid_rows\"), py::arg(\"M_b\"),\n          py::arg(\"K_b\"), py::arg(\"valid_tm\"),\n          \"CPU OpenMP batch encode (byte-identical to the NumPy reference). \"\n          \"Reads src[block_ids[b]] (no host gather) and writes the serialized \"\n          \"blob + meta directly into pool slot slots[b].\");\n    m.def(\"host_encode_blocks_tp\", &p4flat_host_encode_blocks_tp,\n          py::arg(\"src\"), py::arg(\"block_ids\"), py::arg(\"slots\"),\n          py::arg(\"blob\"), py::arg(\"total_size\"), py::arg(\"exc_cnt\"),\n          py::arg(\"is_raw\"), py::arg(\"valid_rows\"), py::arg(\"M_b\"),\n          py::arg(\"K_b\"), py::arg(\"valid_tm\"),\n          \"Byte-identical to host_encode_blocks, but parallelised over \"\n          \"(block x tile) so it doesn't starve when B < thread count (weights / \"\n          \"few-block KV calls).\");\n    m.def(\"scatter_fixed\", &p4flat_scatter_fixed,\n          py::arg(\"blob\"), py::arg(\"slots\"), py::arg(\"stg_h\"), py::arg(\"stg_c\"),\n          py::arg(\"stg_sm\"), py::arg(\"stg_cd\"), py::arg(\"B\"), py::arg(\"hb\"),\n          py::arg(\"cb\"), py::arg(\"smb\"), py::arg(\"cdb\"),\n          \"OpenMP scatter of GPU-compress staging into the blob pool: writes \"\n          \"each block's [headers|codes|sm|subtile] fixed region into slot \"\n          \"row slots[b].  Replaces the single-threaded NumPy assembly.\");\n    m.def(\"decompress\", &p4flat_decompress,\n          py::arg(\"comp\"), py::arg(\"output\") = py::none(),\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05b92-35ce-7bc3-a247-93bd68f8de3a","create_time":1788242849.2896974}}}
