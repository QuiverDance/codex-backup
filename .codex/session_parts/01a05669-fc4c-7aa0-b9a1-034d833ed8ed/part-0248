 UBLBFlatCompressor()\n    if name == \"chunk_delta3\":\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec {name}\")\n\n\n_FORCE = 10 ** 18\n\n\ndef force_fused(codec, name):\n    \"\"\"Open the codec's per-shape fused N-threshold so the fused kernel runs at\n    every N (the production threshold is calibrated from the crossover).\"\"\"\n    if name == \"zipserv\":\n        from tiered_serve.compression.core import ZipServCompressor\n        ZipServCompressor._n_threshold = staticmethod(lambda M, K: _FORCE)\n    else:  # p4flat, ublb_flat both consult self._fused_max_n_override first\n        codec._fused_max_n_override = _FORCE\n\n\ndef compressed_bytes(comp):\n    for attr in (\"total_compressed_size\", \"nbytes\"):\n        if hasattr(comp, attr):\n            v = getattr(comp, attr)\n            return int(v() if callable(v) else v)\n    return 0\n\n\ndef exception_count(codec_name, comp) -> int:\n    if codec_name == \"zipserv\":\n        return int(comp.compressed_full.numel())\n    if hasattr(comp, \"num_exceptions\"):\n        return int(comp.num_exceptions)\n    target = getattr(comp, \"_c\", comp)\n    for attr in (\"exc_indices\", \"exc_idx\"):\n        value = getattr(target, attr, None)\n        if torch.is_tensor(value):\n            return int(value.numel())\n    return 0\n\n\ndef production_fused_threshold(codec_name, codec, M, K) -> int:\n    if codec_name == \"zipserv\":\n        from tiered_serve.compression.core.zipserv import ZipServCompressor\n        return int(ZipServCompressor._N_THRESHOLD_TABLE.get((M, K), 96))\n    if codec_name == \"p4flat\":\n        return int(codec._FUSED_MAX_N_TABLE.get((M, K), 128))\n    return int(codec._fused_max_n_for(M, K))\n\n\n# ── ATS / Grace-Hopper C2C split placement ───────────────────────────────────\n# With --ats the fused GEMM is measured a SECOND time with the codec's\n# compressed-exponent stream (palette + 4-bit codes + exception lists) relocated\n# to Grace LPDDR, while the raw sign|mantissa byte stream stays in HBM.  On a\n# GH200 (Addressing Mode: ATS) the fused decode+GEMM kernel then reads the\n# exponent payload straight from LPDDR over the NVLink-C2C link into the SMs —\n# no HBM staging copy.  This mirrors the \"Exp ATS\" placement of\n# ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py\n# (HugepagePool + device-pointer \"DHA\" tensors) and cpu_hbm_test.py's\n# numa_alloc_onnode + cudaHostRegister C2C path.\n#\n# Per-codec split: keep the mantissa attr in HBM, move every other compressed\n# buffer the fused kernel reads to ATS.  target_fn locates the object whose\n# attrs the kernel reads (the native struct for p4flat, the wrapper otherwise).\n_ATS_PLAN = {\n    \"p4flat\":    (lambda comp: comp._c, \"sign_mantissa\",\n                  (\"codes\", \"headers\", \"subtile_codec\",\n                   \"exc_indices\", \"exc_values\")),\n    \"ublb_flat\": (lambda comp: comp, \"lb_raw\",\n                  (\"code_stream\", \"palette\", \"exc_idx\", \"exc_ub\")),\n    \"zipserv\":   (lambda comp: comp, \"sign_mantissa\",\n                  (\"compressed_full\", \"bitmap1\", \"bitmap2\", \"bitmap3\",\n                   \"tile_offsets_median\", \"tile_offsets_global\")),\n    \"chunk_delta3\": (lambda comp: comp._c, \"sign_mantissa\",\n                     (\"codes\", \"thread_bases\", \"entries20x3\")),\n}\n\n_DHA_EXT = None\n\n\ndef _get_dha_ext():\n    \"\"\"JIT ext wrapping a raw CUDA device pointer as a (no-op-deleter) Tensor.\n\n    Lifted verbatim from ats-benchmarks' nvcomp_h2d_vs_ats._get_dha_ext: builds\n    a CUDA at::Tensor over an externally-owned device pointer so a hugepage /\n    NUMA LPDDR region (mapped to the GPU via cudaHostGetDevicePointer) can be\n    handed to the codec kernels exactly like an HBM tensor (.is_cuda == True).\n    \"\"\"\n    global _DHA_EXT\n    if _DHA_EXT is not None:\n        return _DHA_EXT\n    from torch.utils.cpp_extension import load_inline\n    cpp_src = r\"\"\"\n#include <pybind11/pybind11.h>\n#include <pybind11/stl.h>\n#include <torch/extension.h>\nnamespace py = pybind11;\nat::Tensor dha_allocate(\n    uint64_t ptr, int64_t nbytes,\n    const std::vector<int64_t>& sizes,\n    const std::vector<int64_t>& strides,\n    const at::ScalarType dtype) {\n  const at::Device device(at::kCUDA, 0);\n  auto noop_deleter = [](void*) {};\n  c10::DataPtr data_ptr(reinterpret_cast<void*>(ptr), nullptr, noop_deleter, device);\n  auto storage_impl = c10::make_intrusive<c10::StorageImpl>(\n      c10::StorageImpl::use_byte_size_t(), nbytes, std::move(data_ptr), nullptr, false);\n  at::Tensor tensor = at::empty({0}, at::TensorOptions().dtype(dtype).device(device));\n  tensor.set_(storage_impl, 0, sizes, strides);\n  return tensor;\n}\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n  m.def(\"dha_allocate\", &dha_allocate,\n        py::arg(\"ptr\"), py::arg(\"nbytes\"), py::arg(\"sizes\"),\n        py::arg(\"strides\"), py::arg(\"dtype\"));\n}\n\"\"\"\n    _DHA_EXT = load_inline(\n        name=\"fusegemm_dha_ext\", cpp_sources=[cpp_src],\n        extra_cflags=[\"-O3\", \"-std=gnu++17\"], verbose=False)\n    return _DHA_EXT\n\n    weight_hashes = {\n        (layer, proj): sha256_tensor(weight)\n        for layer, weights in weights_by_layer.items()\n        for proj, weight in weights.items()\n    }\n    checkpoint_index = os.path.join(\n        args.weights_dir, \"model.safetensors.index.json\")\n    checkpoint_index_sha256 = (\n        sha256_file(checkpoint_index) if os.path.isfile(checkpoint_index) else \"\")\n    common_meta = runtime_metadata(_REPO_ROOT)\n    common_meta.update({\n        \"benchmark\": \"fused_gemm_scaling\",\n        \"benchmark_script_sha256\": sha256_file(__file__),\n        \"benchmark_helper_sha256\": sha256_file(\n            os.path.join(_REPO_ROOT, \"benchmarks\", \"fused_bench_common.py\")),\n        \"repeat_id\": args.repeat_id,\n        \"weight_source\": os.path.abspath(args.weights_d