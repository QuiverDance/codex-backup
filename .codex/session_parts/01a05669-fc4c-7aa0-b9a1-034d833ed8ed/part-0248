rride for cross-GPU/model retuning.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 128,\n        (8192, 8192): 128,\n        (57344, 8192): 128,\n        (8192, 28672): 128,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        # Weight compression is an offline/load-time operation.  Keep its\n        # compute on the host so it never steals SM time from serving.  The\n        # completed compressed buffers are staged to CUDA only when the input\n        # itself is CUDA; CPU callers retain a host-resident result.\n        self._cpu_weight_encode = (\n            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: in