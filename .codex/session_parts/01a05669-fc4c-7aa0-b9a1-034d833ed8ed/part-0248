ork_items:\n            M, K = shapes[proj]\n            production_threshold = production_fused_threshold(\n                codec_name, codec, M, K)\n            W = weight_cpu.cuda()\n\n            # N-independent: compress, decompress, ratio.  Official cells are\n            # fail-fast: a missing kernel or OOM must not silently shrink the\n            # matrix and still produce a plausible-looking CSV.\n            comp = codec.compress(W)\n            cbytes = compressed_bytes(comp)\n            if cbytes <= 0:\n                raise RuntimeError(\n                    f\"{codec_name}/{proj}/layer{layer_id}: compressed size is zero\")\n            ratio = (M * K * 2) / cbytes\n            comp_stats = bench_gpu_stats(\n                lambda: codec.compress(W), args.warmup, args.iters,\n                not args.no_flush)\n            W_dec = torch.empty(M, K, dtype=torch.bfloat16, device=\"cuda\")\n            codec.decompress(comp, W_dec)\n            torch.cuda.current_stream().synchronize()\n            if not torch.equal(W_dec, W):\n                raise RuntimeError(\n                    f\"{codec_name}/{proj}/layer{layer_id}: \"\n                    \"compress/decompress is not bit-exact\")\n            decomp_stats = bench_gpu_stats(\n                lambda: codec.decompress(comp, W_dec), args.warmup,\n                args.iters, not args.no_flush)\n            comp_ms = comp_stats.p50_ms\n            decomp_ms = decomp_stats.p50_ms\n\n            # ── ATS placement: relocate the compressed-exponent buffers to\n            # LPDDR (mantissa stays HBM) so the fused kernel reads them over\n            # C2C.  ensure_hbm/ensure_ats flip comp's live buffers between the\n            # two placements per measurement; both read identical bytes. ──\n            ats_on = False\n            ats_backend = \"\"\n            ensure_hbm = (lambda: None)\n            ensure_ats = (lambda: None)\n            if ats_pool is not None and codec_name in _ATS_PLAN:\n                try:\n                    ats_pool.reset()\n                    _tgt, _exp_attrs, _hbm_t, _ats_t = place_exponent_in_ats(\n                        codec_name, comp, ats_pool)\n                    _state = {\"cur\": None}\n\n                    def ensure_hbm(_t=_tgt, _a=_exp_attrs, _h=_hbm_t, _s=_state):\n                        if _s[\"cur\"] != \"hbm\":\n                            for _k in _a:\n                                setattr(_t, _k, _h[_k])\n                            _s[\"cur\"] = \"hbm\"\n\n                    def ensure_ats(_t=_tgt, _a=_exp_attrs, _v=_ats_t, _s=_state):\n                        if _s[\"cur\"] != \"ats\":\n                            for _k in _a:\n                                setattr(_t, _k, _v[_k])\n                            _s[\"cur\"] = \"ats\"\n\n                    ats_on = True\n                    ats_backend = ats_pool.backend\n                except Exception as ex:  # noqa: BLE001\n                    torch.cuda.empty_cache()\n                    print(f\"  [ats-skip {codec_name}/{proj}] \"\n                          f\"{type(ex).__name__}: {str(ex)[:90]}\", file=sys.stderr)\n\n            print(f\"\\n[{codec_name}] layer={layer_id} {proj} {M}x{K}  \"\n                  f\"compress={comp_ms:.3f}ms  decompress={decomp_ms:.3f}ms  \"\n                  f\"compressed={cbytes/1024**2:.1f}MiB  ratio={ratio:.3f}x\")\n            ats_hdr = (f\" {'decmpATS':>17} | {'fusedATS':>17} |\"\n                       if ats_on else \"\")\n            ats_sub = (f\" {'iso':>8} {'h2d':>8} | {'iso':>8} {'h2d':>8} |\"\n                       if ats_on else \"\")\n            print(f\"  {'N':>5} | {'rawGEMM':>17} | {'decomp+GEMM':>17} | \"\n                  f\"{'fused':>17} |{ats_hdr} {'best':>6} {'spd':>6}\")\n            print(f\"  {'':>5} | {'iso':>8} {'h2d':>8} | {'iso':>8} {'h2d':>8} | \"\n                  f\"{'iso':>8} {'h2d':>8} |{ats_sub}\")\n            print(\"  \" + \"-\" * (96 + (40 if ats_on else 0)))\n\n            h2d_bytes = args.h2d_bytes or cbytes or (M * K * 2)\n            contender = None if args.no_h2d else H2DContender(h2d_bytes)\n\n            for N in n_values:\n                proj_index = projs.index(proj)\n                activation_seed = (\n                    args.seed + max(layer_id, 0) * 100_000 +\n                    proj_index * 10_000 + N)\n                generator = torch.Generator(device=\"cuda\")\n                generator.manual_seed(activation_seed)\n                x = torch.randn(\n                    N, K, generator=generator, dtype=torch.bfloat16,\n                    device=\"cuda\")\n                Wt = W.t()\n                Y = torch.empty(N, M, dtype=torch.bfloat16, device=\"cuda\")\n                fused_scratch = codec.alloc_fused_scratch(\n                    K, M, N, x.dtype, x.device)\n                flops = 2.0 * M * N * K\n\n                def raw():\n                    torch.matmul(x, Wt, out=Y)\n\n                def decmm():\n                    ensure_hbm()\n                    codec.decompress(comp, W_dec)\n                    torch.matmul(x, W_dec.t(), out=Y)\n\n                def fused():\n                    ensure_hbm()\n                    return codec.linear_apply_into(comp, x, fused_scratch)\n\n                def decmm_ats():\n                    # decomp reads the exponent from LPDDR (mantissa from HBM),\n                    # writes the dense bf16 weight to HBM, then cuBLAS.\n                    ensure_ats()\n                    codec.decompress(comp, W_dec)\n                    torch.matmul(x, W_dec.t(), out=Y)\n\n                def fused_ats():\n                    # fused decode+GEMM: exponent streamed from LPDDR over C2C,\n                    # no dense-weight HBM write.\n                    ensure_ats()\n                    return codec.linear_apply_into(comp, x, fused_scratch)\n\n                def measure(fn, contend):\n                    return bench_compute_stats(\n                        fn, args.warmup, args.iters, not args.no_flush,\n                        contender=contend)\n\n                # Fused validity gate (always on unless --no-validate): forcing\n                # the fused kernel past a codec's native N-threshold can yield a\n                # numerically WRONG result (e.g. ublb_flat qkv).  A wrong kernel\n                # is never a usable strategy, so null its timing and flag it\n                # rather than report misleading garbage latency.\n                fused_check = \"unvalidated\"\n                if not args.no_validate:\n                    try:\n                        yf = fused().contiguous().float()\n                        codec.decompress(comp, W_dec)\n                        yref = torch.matmul(x, W_dec.t()).float()\n                        amax = yref.abs().max().item()\n                        ok = torch.allclose(yf, yref, atol=max(1.0, 0.02 * amax),\n                                            rtol=0.02)\n                        fused_check = \"ok\" if ok else \"invalid\"\n                    except RuntimeError as ex:\n                        raise RuntimeError(\n                            f\"fused validation failed for {codec_name}/\"\n                            f\"layer{layer_id}/{proj}/N={N}\") from ex\n                    if fused_check == \"invalid\":\n                        raise RuntimeError(\n                            f\"fused output mismatch for {codec_name}/\"\n                            f\"layer{layer_id}/{proj}/N={N}\")\n\n                # ATS reads identical bytes from LPDDR, so the result must match\n                # the HBM-fused reference bit-for-bit; validate to catch a broken\n                # DHA mapping rather than silently timing a wrong kernel.\n                ats_check = \"unvalidated\"\n                if ats_on and not args.no_validate and fused_check != \"invalid\":\n                    try:\n                        ya = fused_ats().contiguous().float()\n                        ensure_hbm(