HUNK_DELTA3_LPDDR_ATTRS,\n}\n\n\ndef _percentile(values: list[float], q: float) -> float:\n    ordered = sorted(values)\n    return ordered[int(q * (len(ordered) - 1))]\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    return min(values), statistics.median(values), _percentile(values, 0.95)\n\n\ndef _make_codec(name: str):\n    if name == \"p4flat\":\n        codec = P4FlatCompressor()\n    elif name == \"chunk_delta3\":\n        codec = ChunkDelta3Compressor(torch.cuda.current_stream())\n    else:\n        raise ValueError(name)\n    codec._fused_max_n_override = 10**9\n    return codec\n\n\ndef _stage_exponent(comp, attrs: tuple[str, ...]):\n    \"\"\"Build the same LPDDR sources and HBM staging used by frozen_split.\"\"\"\n    target = comp._c\n    host_sources = []\n    device_staging = []\n    for attr in attrs:\n        source = getattr(target, attr).contiguous()\n        if source.numel() == 0:\n            setattr(target, attr, torch.empty_like(source))\n            continue\n        host = huge_page_allocator.allocate(\n            source.shape, source.stride(), source.dtype, page_type=\"weight\")\n        host.copy_(source)\n        staging = torch.empty_like(source, device=source.device)\n        staging.copy_(source)\n        setattr(target, attr, staging)\n        host_sources.append(host)\n        device_staging.append(staging)\n    torch.cuda.synchronize()\n    ptrs = (\n        [dst.data_ptr() for dst in device_staging],\n        [src.data_ptr() for src in host_sources],\n        [src.numel() * src.element_size() for src in host_sources],\n    )\n    return tuple(host_sources), tuple(device_staging), ptrs\n\n\ndef _batch_h2d(ptrs, stream: torch.cuda.Stream):\n    if not ptrs[0]:\n        return\n    zipserv_ext.batch_memcpy_ptrs(\n        ptrs[0], ptrs[1], ptrs[2],\n        stream.cuda_stream,\n    )\n\n\ndef _bench_one(codec_name, proj, weight_cpu, n, warmup, iterations, flush):\n    weight = weight_cpu.cuda()\n    M, K = weight.shape\n    codec = _make_codec(codec_name)\n    comp = codec.compress(weight)\n    attrs = tuple(_EXP_ATTRS[codec_name])\n    host_sources, device_staging, ptrs = _stage_exponent(comp, attrs)\n    h2d_bytes = sum(t.numel() * t.element_size() for t in host_sources)\n\n    generator = torch.Generator(device=\"cuda\").manual_seed(20250827 + n)\n    x = torch.randn(n, K, generator=generator, dtype=torch.bfloat16,\n                    device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(K, M, n, x.dtype, x.device)\n\n    def fused():\n        return codec.linear_apply_into(comp, x, scratch)\n\n    # First-use compilation and scratch allocations are outside the samples.\n    actual = fused()\n    expected = torch.nn.functional.linear(x, weight)\n    torch.cuda.synchronize()\n    amax = expected.float().abs().max().item()\n    if not torch.allclose(actual.float(), expected.float(),\n                          atol=max(1.0, 0.02 * amax), rtol=0.02):\n        raise RuntimeError(f\"fused mismatch: {codec_name}/{proj}/N={n}\")\n\n    copy_stream = torch.cuda.Stream()\n    compute_stream = torch.cuda.current_stream()\n    ready = torch.cuda.Event()\n\n    def run_once(timed: bool):\n        if flush:\n            flush_l2_cache()\n            compute_stream.synchronize()\n        start = torch.cuda.Event(enable_timing=timed)\n        copy_end = torch.cuda.Event(enable_timing=timed)\n        kernel_begin = torch.cuda.Event(enable_timing=timed)\n        end = torch.cuda.Event(enable_timing=timed)\n        with torch.cuda.stream(copy_stream):\n            start.record(copy_stream)\n            _batch_h2d(ptrs, copy_stream)\n            copy_end.record(copy_stream)\n            ready.record(copy_stream)\n        with torch.cuda.stream(compute_stream):\n            compute_stream.wait_event(ready)\n            kernel_begin.record(compute_stream)\n            output = fused()\n            end.record(compute_stream)\n        end.synchronize()\n        if not timed:\n            return output, None\n        return output, (\n            start.elapsed_time(copy_end),\n            kernel_begin.elapsed_time(end),\n            start.elapsed_time(end),\n        )\n\n    for _ in range(warmup):\n        run_once(False)\n    copies, kernels, totals = [], [], []\n    for _ in range(iterations):\n        _, sample = run_once(True)\n        copies.append(sample[0])\n        kernels.append(sample[1])\n        totals.append(sample[2])\n\n    result = {\n        \"codec\": codec_name,\n        \"projection\": proj,\n        \"layer\": 40,\n        \"N\": n,\n        \"M\": M,\n        \"K\": K,\n        \"h2d_bytes\": h2d_bytes,\n        \"h2d_mib\": h2d_bytes / 2**20,\n        \"h2d_p50_ms\": _stats(copies)[1],\n        \"h2d_p95_ms\": _stats(copies)[2],\n        \"fused_p50_ms\": _stats(kernels)[1],\n        \"fused_p95_ms\": _stats(kernels)[2],\n        \"h2d_fused_p50_ms\": _stats(totals)[1],\n        \"h2d_fused_p95_ms\": _stats(totals)[2],\n        \"correctness\": True,\n    }\n    del comp, codec, weight, x, actual, expected, scratch\n    for host in host_sources:\n        huge_page_allocator.free(host)\n    del host_sources, device_staging, ptrs\n    gc.collect()\n    torch.cuda.empty_cache()\n    return result\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    parser.add_argument(\"--layer\", type=int, default=40)\n    parser.add_argument(\"--n\", type=int, default=64)\n    parser.add_argument(\"--warmup\", type=int, default=20)\n    parser.add_argument(\"--iterations\", type=int, default=200)\n    parser.add_argument(\"--no-flush\", action=\"store_true\")\n    parser.add_argument(\"--csv\", required=True)\n    args = parser.parse_args()\n    if args.layer != 40:\n        raise ValueError(\"this benchmark currently records layer 40 only\")\n\n    shapes = proj_shapes(1)\n    weights = load_real_projections(\n        args.weights_dir, shapes, layer=args.layer)\