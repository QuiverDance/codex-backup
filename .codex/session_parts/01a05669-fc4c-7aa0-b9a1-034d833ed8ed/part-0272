n# offload_compressed configs use _OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS.\n#\n# Two effects make frozen_split (e.g. cao) carry a HIGH threshold:\n#   * frozen_split decode is EXP-ONLY (sm stays HBM) — far cheaper than the\n#     offload full-blob decompress, so T_decomp is small.\n#   * with all layers frozen_split, every layer loads raw (large T_load_raw).\n#   => big slack => large threshold.\n#   codec      thr    source\n#   p4flat     1330   hand-calibrated 400ms cao-p4flat operating point\n#                     (exp-only decomp 72 / load_raw 364 -> slack 292).\n#   chunk_delta3 1856 GH200/Llama-70B end-to-end forced-route sweep:\n#                     compressed standalone wins through N=1824; raw BF16\n#                     wins at N=1856 and every tested point through N=3072.\n#   zipserv    1107   cao slack model: load_raw 364 / exp-only decomp 121 ->\n#                     slack 243 -> 1330*243/292 = ~1107. zipserv's triple-\n#                     bitmap exp decode is HEAVIER than p4flat's palette\n#                     (121 vs 72ms), so it crosses over to raw_bf16 earlier.\n#   ublb_flat  1367   } synthetic isolated bench (palette/data-independent);\n#   p4d16      1206   } refine with the slack model if used under a real config.\n#   dietgpu     670   STALE synthetic. ANS+data-dependent — re-derive.\n_PREFILL_ALT_MAX_CHUNK_DEFAULTS = {\n    \"p4flat\": 1330,\n    \"chunk_delta3\": 1856,\n    \"ublb_flat\": 1367,\n    \"p4d16\": 1206,\n    \"zipserv\": 1107,   # cao (frozen_split): slack 243 (decomp 121) -> ~1107\n    \"dietgpu\": 670,    # TODO: re-derive with the slack model on a real config\n}\n\n# Codecs whose decompress is BIT-EXACT w.r.t. the original BF16 weight, so\n# decoding them during prefill is lossless. FP8 cells (zipserv_fp8, dietgpu_fp8,\n# p3flat_fp8) quantize, so offload_compressed prefill must keep their\n# uncompressed copy (see the \"for accuracy\" branch in _get_weight_source).\n_LOSSLESS_OFFLOAD_CODECS = frozenset({\n    \"zipserv\", \"dietgpu\", \"zipserv_bf16\", \"dietgpu_bf16\",\n    \"p4flat\", \"p4d16\", \"ublb_flat\",\n    \"chunk_delta3\",\n})\n\n# Phase-adaptive prefill for offload_compressed weights (see _get_weight_source).\n# offload_compressed already keeps BOTH a compressed and an uncompressed LPDDR\n# copy; today prefill ALWAYS H2Ds the uncompressed one (no chunk gating). Below\n# this per-codec chunk threshold, prefill instead H2Ds + FULL-decompresses the\n# compressed copy. Same slack model as the frozen_split knob\n# (thr = (T_load_raw - T_decomp)/T_gemm_per_token) but with DISTINCT inputs:\n# offload does the FULL-blob decompress (vs frozen_split's cheap exp-only), so\n# T_decomp is much larger, AND offload configs (e.g. flexgen-comp) typically\n# keep half the layers frozen_uncompressed, so fewer layers load -> smaller\n# T_load_raw. Both shrink the slack -> a MUCH lower threshold than frozen_split.\n#   codec    thr   source\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        # Weight compression is an offline/load-time operation.  Keep its\n        # compute on the host so it never steals SM time from serving.  The\n        # completed compressed buffers are staged to CUDA only when the input\n        # itself is CUDA; CPU callers retain a host-resident result.\n        self._cpu_weight_encode = (\n            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n        self._fused_max_n_override: Optional[int] = None\n        self._fused_max_n_by_shape_override: dict[tuple[int, int], int] = {}\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n        # Projection-specific overrides make route calibration possible without\n        # rebuilding the extension or editing the production table.  A shape\n        # override takes precedence over the uniform override above.\n        projection_shapes = {\n            \"QKV\": (10240, 8192),\n            \"O\": (8192, 8192),\n            \"GATE_UP\": (57344, 8192),\n            \"DOWN\": (8192, 28672),\n        }\n        for projection, shape in projection_shapes.items():\n            env_name = f\"TIERED_SERVE_CD3_FUSED_MAX_N_{projection}\"\n            raw_value = os.getenv(env_name)\n            if raw_value is None:\n                continue\n            value = int(raw_value)\n            if value < 0:\n                raise ValueError(f\"{env_name} must be non-negative\")\n            self._fused_max_n_by_shape_override[shape] = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        shape_override = self._fused_max_n_by_shape_override.get((M, K))\n        if shape_override is not None:\n            return int(shape_override)\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and CD3 shared-memory pressure.\n        # Hopper WGMMA supports standard 64x{16,32} shapes.  Preserve the\n        # existing 64-wide path at N>32, but avoid doing 2-4x excess activation\n        # work in the latency-critical small-token regime.\n        if N <= 16:\n            n_pad = 16\n        elif N <= 32:\n            n_pad = 32\n        elif N <= 48:\n            n_pad = 48\n        else:\n            n_pad = ((N + 63) // 64) * 64\n        # Split-K is tuned per TileN regime after the reduced-shared-memory\n        # kernels raised TileN64/128 residency to five/four CTAs.  Split-4 wins\n        # throughout N<=64; at N=128 only GateUp's large grid stays unsplit.\n        if n_pad <= 32:\n            # The smaller B tile and single exception map allow enough\n            # resident CTAs that split-4 wins for every production projection.\n            split_k = 4\n        elif n_pad <= 64:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 4,\n                (8192, 28672): 4,\n            }.get((M, K), _u4_split_k(M, n_pad, K))\n        elif n_pad == 128:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 1,\n                (8192, 28672): 4,\n            }.get((M, K), 1)\n        elif n_pad in (192, 256):\n            split_k = 4 if (M, K) == (10240, 8192) else 1\n        else:\n            split_k = 1\n        output = torch.empty(\n            n_pad, M, dtype=torch.bfloat16, device=device)\n        padded_input = torch.empty(\n            n_pad, K, dtype=torch.bfloat16, device=device)\n        partials = (\n            torch.empty(\n                split_k, n_pad, M, dtype=torch.float32, device=device)\n            if split_k > 1\n            else _empty_f32(device)\n        )\n        return {\n            \"key\": (M, K, N, device.index),\n            \"n_pad\": n_pad,\n            \"split_k\": split_k,\n            \"output\": output,\n            \"padded_input\": padded_input,\n            \"partials\": partials,\n        }\n\n    def alloc_fused_scratch(\n        self,\n        K: int,\n        M: int,\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    @staticmethod\n    def _pack_cpu_weight_entries(\n        packed_per_stripe: torch.Tensor,\n        counts: torch.Tensor,\n    ) -> torch.Tensor:\n        \"\"\"Compact stripe-local Packed20x3 words into one weight stream.\"\"\"\n        block_prefix = torch.zeros(\n            counts.numel() + 1, dtype=torch.int64, device=\"cpu\")\n        block_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n        total = int(block_prefix[-1].item())\n        if total == 0:\nmodule_blocks:\n  model.embed_tokens: null\n  \"model.layers.*.input_layernorm\": null\n  \"model.layers.*.self_attn.qkv_proj\": null\n  \"model.layers.*.self_attn.rotary_emb\": null\n  \"model.layers.*.self_attn.o_proj\": null\n  \"model.layers.*.post_attention_layernorm\": null\n  \"model.layers.*.mlp.gate_up_proj\": null\n  \"model.layers.*.mlp.down_proj\": null\n  model.norm: null\n  lm_head: null\n  logits_processor: null\n  sampler: null\nfrozen_blocks:\n  \"model.layers.*.input_layernorm\": null\n  \"model.layers.*.self_attn.rotary_emb\": null\n  \"model.layers.*.post_attention_layernorm\": null\n  model.norm: null\n  lm_head: null\n  logits_processor: null\n  sampler: null\n\nats_blocks:\n  model.embed_tokens: null\n\n# frozen_split: sign_mantissa on HBM (~59 GB), rest on LPDDR (~41 GB)\n# Designed for GH200 (96 GB HBM + LPDDR5)\nlayer_residency:\n  default:\n    qkv: {mode: offload_compressed, compressor: chunk_delta3}\n    o: {mode: offload_compressed, compressor: chunk_delta3}\n    gate_up: {mode: offload_compressed, compressor: chunk_delta3}\n    down: {mode: offload_compressed, compressor: chunk_delta3}\n  frozen:\n    qkv:\n      mode: frozen_split\n      compressor: chunk_delta3\n      layers: all\n    o:\n      mode: frozen_split\n      compressor: chunk_delta3\n      layers: all\n    gate_up:\n      mode: frozen_split\n      compressor: chunk_delta3\n      layers: all\n    down:\n      mode: frozen_split\n      compressor: chunk_delta3\n      layers: all\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05bee-b4d9-7d91-9c13-042c2f3dc999","create_time":1788248866.6570954}}}
