                  group_slices.append((dsts, srcs))\n                                info._zs_group_slices = group_slices\n                            for g, grp in enumerate(plan):\n                                gev = self._zipserv_group_h2d_event(\n                                    layer_id, name, g)\n                                with torch.cuda.stream(\n                                        self.load_weight_stream):\n                                    dsts, srcs = group_slices[g]\n                                    self._coalesced_h2d(dsts, srcs)\n                                    gev.record(self.load_weight_stream)\n                                self.decomp_weight_stream.wait_event(gev)\n                                # Per-group decode timing: recorded AFTER this\n                                # group's H2D wait_event(gev) so the inter-group\n                                # load-wait bubbles (decomp_weight_stream blocked\n                                # on the next group's H2D) stay OUT of WDecomp.\n                                # The breakdown unions these per-group intervals.\n                                if tb:\n                                    self._frozen_split_decomp_begin_timing_event(\n                                        layer_id, name, group=g).record(\n                                            self.decomp_weight_stream)\n                                self._frozen_split_run_decompress(\n                                    info, staging, info.lpddr_numels,\n                                    output, backend_compressor,\n                                    gt_m_base=grp[\"gt_m_base\"],\n                                    num_row_tiles=grp[\"num_row_tiles\"])\n                                if tb:\n                                    self._frozen_split_decomp_end_timing_event(\n                                        layer_id, name, group=g).record(\n                                            self.decomp_weight_st