self._frozen_split_decomp_end_timing_event(\n                    layer_id, name).record(self.decomp_weight_stream)\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_pop()\n            # Record kernel completion on decomp_weight_stream so the *next*\n            # decode step's H2D for this same (layer,name) can wait on it\n            # before overwriting `staging`.\n            kernel_done_event.record(self.decomp_weight_stream)\n            return\n\n        # ── Pipelined path: per row-tile group H2D + decode ──\n        # Groups write disjoint staging regions at their absolute positions.\n        # Loads are issued back-to-back on load_weight_stream (no throttle);\n","stderr":"","aggregated_output":"                    \"bitmap1\": (bm_lo, bm_hi),\n                    \"bitmap2\": (bm_lo, bm_hi),\n                    \"bitmap3\": (bm_lo, bm_hi),\n                },\n            })\n            start += n_tiles\n        if not getattr(self, \"_logged_zs_pipeline\", False):\n            self._logged_zs_pipeline = True\n            logger.info(\n                \"[ZipServ-pipeline] enabled: stages=%d min_tiles/group=%d \"\n                \"(first tensor M=%d K=%d tile_m=%d gt_m_total=%d -> %d \"\n                \"groups, R=%d)\",\n                stages, min_tiles, M, K, tile_m, gt_m_total,\n                len(groups), R)\n        return groups\n\n    def _frozen_split_decomp_begin_timing_event(self, layer_id: int,\n                                                  name: str,\n                                                  group=None\n                                                  ) -> torch.cuda.Event:\n        \"\"\"BEGIN timing marker for the frozen_split per-(layer,name)\n        decompress kernel on ``decomp_weight_stream``.  Used only by\n        the time-breakdown diagnostic so the kernel duration shows up\n        in WDecomp (the existing frozen_decomp_events per-comp_key\n        slots aren't written by the split path, which dispatches\n        per-tensor).\n\n        ``group`` distinguishes the pipelined zipserv row-tile groups so\n        each group's decode is timed as its own interval (recorded AFTER\n        that group's H2D wait_event); the breakdown unions them, so the\n        per-group H2D-wait bubbles between kernels stay OUT of WDecomp.\"\"\"\n        cache = getattr(\n            self, \"_frozen_split_decomp_begin_timing_events_cache\", None)\n        if cache is None:\n            cache = {}\n            self._frozen_split_decomp_begin_timing_events_cache = cache\n        key = (layer_id, name) if group is None else (layer_id, name, group)\n        ev = cache.get(key)\n        if ev is None:\n            ev = torch.cuda.Event(enable_timing=True, external=True)\n            ev.record()\n            cache[key] = ev\n        return ev\n\n    def _frozen_split_decomp_end_timing_event(self, layer_id: int,\n                                                name: str,\n                                                group=None\n                                                ) -> torch.cuda.Event:\n        \"\"\"END timing marker paired with the BEGIN above.\"\"\"\n        cache = getattr(\n            self, \"_frozen_split_decomp_end_timing_events_cache\", None)\n        if cache is None:\n            cache = {}\n            self._frozen_split_decomp_end_timing_events_cache = cache\n        key = (layer_id, name) if group is None else (layer_id, name, group)\n        ev = cache.get(key)\n        if ev is None:\n            ev = torch.cuda.Event(enable_timing=True, external=True)\n            ev.record()\n            cache[key] = ev\n        return ev\n\n    def _ensure_graph_replay_end_events(self, n_graphs: int\n                                        ) -> List[torch.cuda.Event]:\n        \"\"\"Lazy per-graph_idx event recorded on cur_stream at the end of\n        ``_after_replay(K)`` to mark graph K's GPU-side completion.\n        decomp_weight_stream waits on event[K-1] before launching graph\n        K+1's decomp in ``_before_replay(K)`` so it doesn't write to a\n        parity-K%3 buffer that an older in-flight graph (e.g. graph\n        K-3, parity (K-3)%3 = K%3) is still reading.\"\"\"\n        cache = getattr(self, \"_graph_replay_end_events\", None)\n        if cache is None or len(cache) < n_graphs:\n            cache = []\n            for _ in range(n_graphs):\n                ev = torch.cuda.Event(external=True)\n                ev.record()  # initial value satisfied\n                cache.append(ev)\n            self._graph_replay_end_events = cache\n        return cache\n\n    def _ensure_graph_decomp_done_events(self, n_graphs: int\n                                         ) -> List[torch.cuda.Event]:\n        \"\"\"Lazy per-graph_idx event used to gate cur_stream's graph K\n        replay on completion of graph K's frozen weight decompress.\n        Decomp for graph K is pre-launched in ``_before_replay(K-1)``\n        so it overlaps with graph K-1 replay + attention K-1.  This\n        event is recorded right after that launch on decomp_weight_stream\n        and waited on cur_stream at the start of graph K's _before_replay.\n        Allocated once on first use, sized to n_graphs.\"\"\"\n        cache = getattr(self, \"_graph_decomp_done_events\", None)\n        if cache is None or len(cache) < n_graphs:\n            cache = []\n            for _ in range(n_graphs):\n                ev = torch.cuda.Event(external=True)\n                ev.record()  # initial value satisfied\n                cache.append(ev)\n            self._graph_decomp_done_events = cache\n        return cache\n\n    def _frozen_split_kernel_done_event(self, layer_id: int, name: str\n                                        ) -> torch.cuda.Event:\n        \"\"\"Lazy event recorded after each frozen-split decompress kernel.\n\n        The staging buffers are keyed by ``(name, layer_id % parity)``, not by\n        absolute layer id.  Lookahead can therefore schedule layer K+2 while\n        layer K's kernel is still reading the same staging slot.  Gate H2D on\n        the previous kernel for the same physical staging slot.\n        \"\"\"\n        cache = getattr(self, \"_frozen_split_kernel_done_events\", None)\n        if cache is None:\n            cache = {}\n            free_by_name = self._frozen_split_alt_staging_free_events = {}\n        h2d_by_name = getattr(\n            self, \"_frozen_split_alt_h2d_done_events\", None)\n        if h2d_by_name is None:\n            h2d_by_name = self._frozen_split_alt_h2d_done_events = {}\n\n        free_events = free_by_name.setdefault(name, [])\n        h2d_events = h2d_by_name.setdefault(name, [])\n        while len(free_events) < self.FROZEN_STAGING_PARITY:\n            free = torch.cuda.Event(external=True)\n            free.record()  # first occupant has no prior decoder to wait for\n            free_events.append(free)\n            h2d_events.append(torch.cuda.Event(external=True))\n\n    def _materialize_frozen_split_prefill_alt(\n            self, layer_id, name, alt, output, alt_comp):\n        \"\"\"Stage one eager-prefill alt weight without blocking compute H2D.\n\n        The wrapper schedules a future NONE-path piece after the current piece\n        has been submitted. Putting only these copies on load_weight_stream lets\n        them overlap that current compute. The H2D-done wait and decoder remain\n        on exec afterwards, ordered before the future component-ready event and\n        consuming GEMM.\n        \"\"\"\n        parity = layer_id % self.FROZEN_STAGING_PARITY\n        alt_staging = self.frozen_split_alt_staging[name][parity]\n        staging_free = self._frozen_split_alt_staging_free_events[name][parity]\n        h2d_done = self._frozen_split_alt_h2d_done_events[name][parity]\n\n        # Do not overwrite this parity slot while its previous P4 decoder is\n        # still reading it.\n        self.load_weight_stream.wait_event(staging_free)\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.load_weight_stream):\n            if tb:\n                self._frozen_split_h2d_begin_event(\n                    layer_id, name).record(self.load_weight_stream)\n            for attr in alt.lpddr_attrs:\n                ne = alt.lpddr_numels[attr]\n                alt_staging[attr][:ne].copy_(\n                    alt.lpddr_buffers[attr], non_blocking=True)\n            if tb:\n                self._frozen_split_h2d_end_timing_event(\n                    layer_id, name).record(self.load_weight_stream)\n            h2d_done.record(self.load_weight_stream)\n\n        # Keep P4 decode and its dense output on exec/current. Moving the decoder\n        # itself would add SM contention and a second cross-stream WAR on the\n        # parity-shared dense primary buffer.\n        self.decomp_weight_stream.wait_event(h2d_done)\n        if tb:\n            self._frozen_split_decomp_begin_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        self._frozen_split_run_decompress(\n            alt, alt_staging, alt.lpddr_numels, output, alt_comp)\n        if tb:\n            self._frozen_split_decomp_end_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        staging_free.record(self.decomp_weight_stream)\n\n    @staticmethod\n    def _parse_prefill_alt_max_chunk(raw, default=None):\n        \"\"\"Parse TIERED_SERVE_PREFILL_ALT_MAX_CHUNK into (per_backend, fallback).\n\n        Accepts a single int (one global override for every codec) or a comma\n        list of \"<codec>=<n>\" entries plus an optional bare int that overrides\n        the default for codecs not explicitly named. Codec keys are lower-cased\n        to match SplitStorageInfo.backend. Whitespace around tokens is ignored.\n\n        ``fallback`` stays ``None`` unless the env contained a bare int. None\n        signals \"unset\", so ``_alt_max_chunk_for`` then consults the built-in\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n                P = self.FROZEN_DECOMP_PARITY\n                if war is not None:\n                    # Default path: free the prior layer's slot for this comp\n                    # inline.  V1 prefill eager lookahead disables this record\n                    # and lets the wrapper mark slots free after the eager piece\n                    # actually consumes them; otherwise scheduling graph K+1\n                    # before graph K would falsely free graph K's qkv slot.\n                    if not getattr(self, \"_v1_prefill_raw_external_war\",\n                                   False):\n                        war[(layer_id - 1) % P].record(self.exec_stream)\n                    # WAR: this H2D overwrites slot L%P, last read by layer\n                    # (L-PARITY)'s GEMM.  Layers < PARITY are first occupants\n                    # (fresh buffer) → no prior reader → skip.\n                    if layer_id >= P:\n                        self.load_weight_stream.wait_event(war[layer_id % P])\n           