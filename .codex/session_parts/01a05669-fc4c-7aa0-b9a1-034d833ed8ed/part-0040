n only.  Caller already set decomp_weight_stream\n            # as current; record on that stream explicitly to match\n            # H2D-side instrumentation semantics.\n            if tb:\n                self._frozen_split_decomp_begin_timing_event(\n                    layer_id, name).record(self.decomp_weight_stream)\n            self._frozen_split_run_decompress(\n                info, info.lpddr_buffers, info.lpddr_numels,\n                output, backend_compressor)\n            if tb:\n                self._frozen_split_decomp_end_timing_event(\n                    layer_id, name).record(self.decomp_weight_stream)\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_pop()\n            kernel_done_event.record(self.decomp_weight_stream)\n            return\n\n        h2d_event = self._frozen_split_h2d_event(layer_id, name)\n        # Block this H2D against the previous use of the same physical\n        # staging slot.  DIAGNOSTIC (WLOAD_GRAPH): skip during cudagraph capture\n        # — waiting on an external event (kernel_done, recorded outside this\n        # capture) can detach load_weight from the capture so the H2D below is\n        # not recorded into the graph (replay then never loads -> stale weights).\n        if (not _ENV_ANY_WLOAD_GRAPH\n                or not torch.cuda.is_current_stream_capturing()):\n            self.load_weight_stream.wait_event(kernel_done_event)\n        if tb:\n            h2d_begin = self._frozen_split_h2d_begin_event(layer_id, name)\n            h2d_end_timing = self._frozen_split_h2d_end_timing_event(\n                layer_id, name)\n        # Pipeline the (zipserv BF16) H2D + decode in row-tile groups so\n        # group g+1's H2D overlaps group g's decode.  Disabled for the\n        # fused_mm (skip_kernel) path, which needs the whole staging slot\n        # populated for the matmul to read; QKV/O are left whole.\n        plan = None if skip_kernel else self._zipserv_pipeline_plan(\n            info, self.tensor_to_component.get(name))\n\n        if plan is None and collect_into is not None:\n            # #8 batched H2D: defer the copy + h2d_event.record + decomp\n            # wait_event to the caller, which issues ONE batch_memcpy for ALL\n            # projections then records each event.  The WAR guard\n            # (load_weight_stream.wait_event(kernel_done_event)) already ran\n            # above, so the staging slot is safe to overwrite.\n            single = getattr(info, \"_zs_single_slices\", None)\n            if single is None:\n                single = (\n                    [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\n                     for attr in info.lpddr_attrs],\n                    [info.lpddr_buffers[attr]\n                     for attr in info.lpddr_attrs])\n                info._zs_single_slices = single\n            collect_into.append((single[0], single[1], h2d_event))\n            return\n\n        if plan is None:\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_h2d L{layer_id}.{name}\")\n            # When the caller (decompress_frozen_tensors, all-fused decode path)\n            # already holds the load_weight_stream context for the whole\n            # projection loop, stream(None) is a no-op — the copy below\n            # reads current_stream() = load_weight_stream and the records are\n            # explicit, so we skip the per-projection stream-context churn.\n            with torch.cuda.stream(None if h2d_ctx_held else self.load_weight_stream):\n                # BEGIN/END timing markers for the time-breakdown\n                # diagnostic, paired with the sync h2d_event below.\n                # frozen_split keeps sign_mantissa on HBM but H2D's the\n                # compressed-exp/aux buffers every decode step, so this is\n                # the dominant Weight Load source in frozen_split configs\n                # and was being missed by the per-layer\n                # begin_memcpy_weight_events filter.  Two separate END\n                # events because the sync one (h2d_event) must have\n                # enable_timing=False for cross-stream wait semantics.\n                if tb:\n                    h2d_begin.record(self.load_weight_stream)\n                # Single coalesced H2D for all codec buffers (QKV/O and any\n                # non-pipelined tensor load in one dispatch, not one-per-attr).\n                # dst/src views are fixed across decode steps (parity-stable\n                # staging, fixed lpddr_buffers, fixed numels), so build them\n                # once and cache on info instead of re-slicing every step.\n                single = getattr(info, \"_zs_single_slices\", None)\n                if single is None:\n                    single = (\n                        [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\n                         for attr in info.lpddr_attrs],\n                        [info.lpddr_buffers[attr]\n                         for attr in info.lpddr_attrs])\n                    info._zs_single_slices = single\n                    # Cache the raw dst/src/size arrays alongside the views so\n                    # the batched H2D goes through batch_memcpy_ptrs (no per-call\n                    # tensor->ptr rebuild).  Stable for the same reason the views\n                    # are (parity-fixed staging, immutable LPDDR buffers/numels).\n                    info._zs_ptr_arrays = (\n                        [d.data_ptr() for d in single[0]],\n                        [s.data_ptr() for s in single[1]],\n                        [s.numel() * s.element_size() for s in single[1]])\n                # h2d_ctx_held => caller holds torch.cuda.stream(load_weight_stream),\n                # so current_stream() == load_weight_stream: pass its cached raw\n                # handle and skip the per-call current_stream() driver lookup.\n                _sh = self._lw_stream_handle() if h2d_ctx