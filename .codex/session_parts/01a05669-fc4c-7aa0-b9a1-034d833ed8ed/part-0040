_event or None\n        [6] scratch_by_N (legacy slot, retained for ZipServ/DietGPU)\n        [7] comp_c     pre-extracted ``comp._c`` (legacy slot)\n        [8] wd_begin   WDecomp begin event (or None) — timed by linear_apply\n        [9] wd_end     WDecomp end event   (or None)   only on the fallback\n                        decompress path (fused path leaves them unrecorded).\n        [10] leaf      Linear used by the large-prefill dense fallback\n        [11] ww_begin  weight-ready wait begin event (or None)\n        [12] ww_end    weight-ready wait end event (or None)\n    \"\"\"\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n    dm = DualMemoryLoader._v1_dm_ref\n    # During the real ``profile_run`` and the cudagraph WARMUP the wrapper skips\n    # weight streaming, so the per-decode staging the fused op reads is stale.\n    # offload's bulk sign_mantissa is then OOB → IMA; frozen_split's sign_mantissa\n    # is HBM-permanent so it survives, but the guard is harmless there.  Return\n    # the output SHAPE only there; do NOT short-circuit during the cudagraph\n    # CAPTURE (the REAL op must bake in — the per-step data is streamed before\n    # each decode replay).  Capture is detected via the dedicated\n    # ``_v1_fused_capturing`` flag (vllm/compilation/cuda_graph.py).\n    if dm is not None and (getattr(dm, \"is_profiling\", False)\n                           or getattr(dm, \"is_graph_warming_up\", False)):\n        _capturing = (getattr(dm, \"_v1_fused_capturing\", False)\n                      or torch.cuda.is_current_stream_capturing())\n        if not _capturing:\n            return x.new_zeros(*x.shape[:-1], M)\n\n    entry = dm._fused_reg[layer_id * _REG_ENTRY_SLOTS + comp_id]\n    fde = entry[4]\n    kde = entry[5]\n    ww_begin = entry[11]\n    ww_end = entry[12]\n\n    # SINGLE STREAM: decompress+GEMM (or the fused kernel) run on the CURRENT\n    # stream — the cudagraph capture/replay stream under capture, exec_stream\n    # eagerly.  No comp_stream fork (capture-illegal; see ZipServ fused_mm /\n    # decompress).  ``fde`` is the per-component weight-ready barrier, recorded\n    # on the producer stream (load_weight_stream for frozen_split H2D). Waiting\n    # it on the current stream is capture-safe and orders the decode after the\n    # H2D in both captured and eager execution.\n    cur = torch.cuda.current_stream(x.device)\n    _capturing = (getattr(dm, \"_v1_fused_capturing\", False)\n                  or torch.cuda.is_current_stream_capturing())\n    if fde is not None:\n        if ww_begin is not None:\n            ww_begin.record(cur)\n        cur.wait_event(fde)\n        if ww_end is not None:\n            ww_end.record(cur)\n    elif not _capturing:\n        # Eager cell with no recorded barrier: order after the H2D stream\n        # directly (cross-stream wait_stream is illegal during capture).\n        _lws = getattr(dm, \"load_weight_stream\", None)\n        if _lws is not None:\n            if ww_begin is not None:\n                ww_begin.record(cur)\n            cur.wait_stream(_lws)\n            if ww_end is not None:\n                ww_end.record(cur)\n\n    # LARGE PREFILL (eager only) → plain GEMM on the raw dense PRIMARY.\n    # The forward override ALWAYS routes through this op (no Dynamo-traced\n    # branch), so this op alone must distinguish the two weight sources.  When a\n    # prefill chunk exceeds the cudagraph capture ceiling it (a) runs eager (stock\n    # vLLM dispatch sends num_tokens > max_cudagraph_capture_size to NONE) and\n    # (b) the loader materialised the raw_bf16 dense weight into the leaf's\n    # ``.weight`` (PREFILL_ALT_MAX_CHUNK == ceiling), NOT the compressed staging.\n    # So decode + captured-size prefill (N <= ceiling) take the staging path\n    # below; only this eager large-prefill case reads primary.  This op is OPAQUE\n    # to Dynamo, so the branch is evaluated at runtime — at CAPTURE N == the\n    # captured size <= ceiling, so the staging path is what gets baked.\n    if getattr(dm, \"batch_has_prefill\", False) and entry[10] is not None:\n        _ceil = getattr(dm, \"_cudagraph_ceiling\", 0)\n        if _ceil and (x.numel() // entry[0]) > _ceil:\n            return torch.nn.functional.linear(x, entry[10].weight)\n\n    # Unified compressed-weight path (decode + captured-size prefill): the\n    # compressor's linear_apply decides fused (N <= per-(M,K) threshold) vs\n    # decompress+cuBLAS (N > thr, or fused-off) INTERNALLY — both on the current\n    # stream, both captured.  The decision is (M,K,N)-only, so it bakes per\n    # captured size.  WDecomp events (entry[8:10]) bracket the fallback decompress\n    # only; the fused kernel leaves them unrecorded so its inseparable decode\n    # folds into Compute.\n    y = entry[2].linear_apply(entry[3], x, wdecomp_events=(entry[8], entry[9]))\n\n    if kde is not None:\n        kde.record(cur)\n    return y\n\n\ndef _fused_linear_apply_fake(x: torch.Tensor, layer_id: int,\n                             comp_id: int, M: int) -> torch.Tensor:\n    # Output shape is (*x.shape[:-1], M); device + dtype follow x.\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    def compress(\n        self,\n            if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                self.end_frozen_decomp_timing_events[\"qkv\"][\n                    layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen compressed weights with per-component events.\n\n        Unlike decompress_frozen_weight which records a single event after\n        all tensors, this records per-component events so exec_stream can\n        start each matmul as soon as its specific tensor is ready.\n\n        Honors per-cell compressor overrides from the YAML\n        ``layer_residency`` ``{mode, compressor}`` cells: each\n        component's decomp instance is looked up via\n        ``_compressor_for_cell``.  Cells without an override fall\n        through to the legacy global ``weight_compressor``.\n        \"\"\"\n        comp_data = self.frozen_comp_buffers[layer_id]\n        if comp_data is None:\n            return\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                if hasattr(self, \"begin_frozen_decomp_events\"):\n                    self.begin_frozen_decomp_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n                comp = self._compressor_for_cell(\n                    layer_id, comp_key, mode=\"frozen_compressed\")\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    comped = comp_data.get(name)\n                    if comped is not None:\n                        comp.decompress(comped)\n                self.frozen_decomp_events[comp_key][layer_id].record(\n                    self.decomp_weight_stream)\n                if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                    self.end_frozen_decomp_timing_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path stays event-light.\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                # WDecomp timing for the split path is recorded tightly\n                # around each _frozen_split_run_decompress kernel below\n                # (AFTER its H2D wait_event), NOT here.  The old coarse\n                # per-comp_