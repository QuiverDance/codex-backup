", \"0\") == \"1\")\n   596\t            if _full_block_only and kv_comp_backend not in (\n   597\t                    \"p4flat\", \"p4flatcpu\", \"chunk_delta3\"):\n   598\t                raise ValueError(\n   599\t                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY=1 currently requires \"\n   600\t                    \"the p4flat, p4flatcpu, or chunk_delta3 KV backend; got \"\n   601\t                    f\"{kv_comp_backend!r}\")\n   602\t            DualMemoryLoader.kv_full_block_only = _full_block_only\n   603\t\n   604\t            # ── KV compression producer mode ──\n   605\t            # Selects how the compressed KV copy is produced during unload.\n   606\t            # Both modes always store raw KV in LPDDR secondary so that\n   607\t            # prefill-containing phases load uncompressed without paying\n   608\t            # decompression latency.  Resolved *before* the backend is\n   609\t            # instantiated because p4flat picks its encode implementation\n   610\t            # (GPU vs CPU) from the producer mode below.\n   611\t            #\n   612\t            #   gpu_direct:\n   613\t            #       Backend's existing pipeline produces compressed KV on GPU\n   614\t            #       (DietGPU/MantExp/p4flat run compress kernels on\n   615\t            #       comp_stream).  Raw secondary unload runs in parallel.\n   616\t            #\n   617\t            #   cpu_after_raw_swap:\n   618\t            #       Avoid GPU compression entirely.  Raw KV is D2H'd to\n   619\t            #       LPDDR secondary first, then a CPU compressor reads\n   620\t            #       directly from secondary_kv (no extra D2H) and writes\n   621\t            #       into the persistent compressed host pool.  Supported only\n   622\t            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n   623\t            #       manager), p4flat, and ChunkDelta3 (Python worker boundary\n   624\t            #       around an OpenMP C++ encoder).\n   625\t            # Default is backend-aware.  ZipServ is CPU-encode only in the\n   626\t            # serving path: raw KV is first swapped to secondary_kv and its C++\n   627\t            # worker manager compresses directly from that host tensor.  This\n   628\t            # is also enforced below so an inherited producer env cannot route\n   629\t            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n   630\t            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n   631\t            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n   632\t            # host_encode_blocks) variant of the p4flat codec — it always uses\n   633\t            # the cpu_after_raw_swap producer, regardless of the env default.\n   634\t            # p4flat's gpu_direct compress runs 3 device kernels\n   635\t            # (compress_lean) on comp_stream.  When weight compression is also\n   636\t            # active, those kernels contend with weight-decompress + fused-mm\n   637\t            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n   638\t            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n   639\t            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n   640\t            # default p4flat to the CPU encoder whenever weight comp is on (the\n   641\t            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n   642\t            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n   643\t            # where the GPU has spare SMs and the two paths are on par\n   644\t            # (180 vs 176 ms).  An explicit env value below still overrides.\n   645\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   646\t                                   \"ublb_flat\", \"ublb_tbe\"):\n   647\t                _default_producer = \"cpu_after_raw_swap\"\n   648\t            elif kv_comp_backend == \"chunk_delta3\":\n   649\t                # CD3 GPU encode contends directly with fused weight decode/MM\n   650\t                # once KV offload begins.  The host encoder consumes the raw\n   651\t                # secondary copy asynchronously and is the serving default.\n   652\t                _default_producer = \"cpu_after_raw_swap\"\n   653\t            elif (kv_comp_backend == \"p4flat\"\n   654\t                    and DualMemoryLoader.use_weight_comp):\n   655\t                _default_producer = \"cpu_after_raw_swap\"\n   656\t            else:\n   657\t                _default_producer = \"gpu_direct\"\n   658\t            kv_comp_producer = os.getenv(\n   659\t                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n   660\t            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n   661\t                raise ValueError(\n   662\t                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n   663\t                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n   664\t                    f\"'cpu_after_raw_swap'.\")\n   665\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   666\t                                   \"ublb_flat\", \"ublb_tbe\") and \\\n   667\t                    kv_comp_producer != \"cpu_after_raw_swap\":\n   668\t                logger.warning(\n   669\t                    \"%s is CPU-encode only; ignoring \"\n   670\t                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n   671\t                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n   672\t                kv_comp_producer = \"cpu_after_raw_swap\"\n   673\t            if (kv_comp_producer == \"cpu_after_raw_swap\"\n   674\t                    and kv_comp_backend not in\n   675\t                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n   676\t                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n   677\t                raise ValueError(\n   678\t                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n   679\t                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n   680\t                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n   681\t                    f\"(backend \"\n   682\t                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n   683\t            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n   684\t\n   685\t            # ── Backend instantiation (p4flat's encode side depends on the\n   686\t            #    producer mode resolved above) ──\n   687\t            if kv_comp_backend == \"dietgpu\":\n   688\t                from tiered_serve.dietgpu_kv_compressor import (\n   689\t                    DietGPUKVCompressor,\n   690\t                )\n   691\t                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n   692\t                logger.info(\"KV compressor: DietGPU\")\n   693\t            elif kv_comp_backend == \"mantexp\":\n   694\t                # Mantissa/Exponent split: sm stays in HBM, exp is\n   695\t                # ANS-compressed and persisted in LPDDR (see\n   696\t                # tiered_serve/mantexp_kv_compressor.py).\n   697\t                if not self.mantexp_split_kv:\n   698\t                    logger.warning(\n   699\t                        \"KV backend 'mantexp' selected without \"\n   700\t                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n   701\t                from tiered_serve.mantexp_kv_compressor import (\n   702\t                    MantExpKVCompressor,\n   703\t                )\n   704\t                self.kv_compressor = MantExpKVCompressor(\n   705\t                    self.decomp_kv_stream)\n   706\t                logger.info(\"KV compressor: MantExp (split storage)\")\n   707\t            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n   708\t                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n   709\t                # backends share the same GPU decode kernel and storage layout:\n   710\t                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n   711\t                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n   712\t                #                         host_encode_blocks)\n   713\t                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n   714\t                # follows the producer mode (defaults to gpu_direct).\n   715\t                # See tiered_serve/p4flat_kv_compressor.py.\n   716\t                from tiered_serve.p4flat_kv_compressor import (\n   717\t                    P4FlatCPUKVCompressor,\n   718\t                    P4FlatKVCompressor,\n   719\t                )\n   720\t                if (kv_comp_backend == \"p4flatcpu\"\n   721\t                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n   722\t                    self.kv_compressor = P4FlatCPUKVCompressor(\n   723\t                        self.decomp_kv_stream)\n   724\t                    logger.info(\n   725\t                        \"KV compressor: P4Flat (CPU encode, \"\n   726\t                        \"C++ OpenMP host_encode_blocks)\")\n   727\t                else:\n   728\t                    self.kv_compressor = P4FlatKVCompressor(\n   729\t                        self.decomp_kv_stream)\n   730\t                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n   270\t    if DualMemoryLoader.kv_full_block_only:\n   271\t        _tail_plan = dm_loader.tail_step_plan\n   272\t        _completed_local = dm_loader.tail_completed_local_ids\n   273\t        if dm_loader.kv_buffer_ids != _completed_local:\n   274\t            raise RuntimeError(\n   275\t                \"full-block KV unload set does not match completed blocks: \"\n   276\t                f\"unload={dm_loader.kv_buffer_ids}, \"\n   277\t                f\"completed={_completed_local}\")\n   278\t        dm_loader._tail_verified_full_unload_blocks += len(_completed_local)\n   279\t        if (\n   280\t            _tail_plan.rollovers\n   281\t            and not dm_loader._tail_logged_first_rollover_unload\n   282\t        ):\n   283\t            dm_loader._tail_logged_first_rollover_unload = True\n   284\t            logger.info(\n   285\t                \"[kv-full-block] first rollover unload verified: \"\n   286\t                \"full_targets=%d rollovers=%d resident_after=%d \"\n   287\t                \"partial_targets=0\",\n   288\t                len(_completed_local), len(_tail_plan.rollovers),\n   289\t                len(_tail_plan.resident_after))\n   290\t\n   291\t    if hasattr(vLLMKVCache, \"used_block_ids\"):\n   292\t        _ub = vLLMKVCache.used_block_ids\n   293\t        _nd = dm_loader.num_dedicated_blocks\n   294\t        if hasattr(_ub, \"unpack\"):\n   295\t            # bitarray fast path: ONE C-speed unpack to a 0/1 byte mask +\n   296\t            # vectorized index extraction.  Replaces a Python\n   297\t            # ``enumerate(bitarray)`` loop over EVERY block id (~ms of pure\n   298\t            # forward-thread CPU per step at 30k+ blocks).  flatnonzero of\n   299\t            # the [num_dedicated:] slice yields offloadable-relative ids,\n   300\t            # already sorted ascending.\n   301\t            _mask = np.frombuffer(_ub.unpack(), dtype=np.uint8)\n   302\t            _hi = (len(_mask) if num_primary is None\n   303\t                   else min(len(_mask), _nd + num_primary))\n   304\t            _act = np.flatnonzero(_mask[_nd:_hi])\n   305\t            dm_loader.np_active_kv_buffer_ids = _act\n   306\t            dm_loader.active_kv_buffer_ids = _act.tolist()\n   307\t        else:  # generic fallback (used_block_ids not a bitarray)\n   308\t            dm_loader.active_kv_buffer_ids = [\n   309\t                i - _nd\n   310\t                for i, bit in enumerate(_ub)\n   311\t                if (bit and i >= _nd\n   312\t                    and (num_primary is None or i - _nd < num_primary))\n   313\t            ]\n   314\t            dm_loader.active_kv_buffer_ids.sort()\n   315\t            dm_loader.np_active_kv_buffer_ids = np.array(\n   316\t                dm_loader.active_kv_buffer_ids, dtype=np.int64)\n   317\t\n   318\t        # Full-block-only mode keeps current partials in request-private HBM\n   319\t        # rows. Current-step full blocks also need no LP load: a fresh block is\n   320\t        # overwritten in all 16 positions, while a completing resident gets\n   321\t        # its valid prefix from the tail->shared rollover D2D.\n   322\t        if DualMemoryLoader.kv_full_block_only:\n   323\t            _tail_skip = dm_loader.tail_lp_skip_local_ids\n   324\t            if _tail_skip:\n   325\t                _skip_np = np.asarray(\n   326\t                    sorted(set(_tail_skip)), dtype=np.int64)\n   327\t                dm_loader.np_active_kv_buffer_ids = np.setdiff1d(\n   328\t                    dm_loader.np_active_kv_buffer_ids,\n   329\t                    _skip_np,\n   330\t                    assume_unique=True,\n   331\t                )\n   332\t                dm_loader.active_kv_buffer_ids = (\n   333\t                    dm_loader.np_active_kv_buffer_ids.tolist())\n   334\t        dm_loader._active_kv_sorted = True\n   335\t        _na = dm_loader.np_active_kv_buffer_ids\n   336\t        torch.cuda.nvtx.mark(\n   337\t            f\"Active Buffers: {_na.size} \"\n   338\t            f\"{int((np.diff(_na) != 1).sum()) + 1 if _na.size else 0}\"\n   339\t        )\n   340\t\n   341\t    if DualMemoryLoader.use_kv_comp:\n   342\t        # Publish the canonical active set once per forward.  CD3 uses the\n   343\t        # held list identity plus a content version to skip an O(N) active-set\n   344\t        # comparison in every layer; codecs without this optional hook retain\n   345\t        # their existing path unchanged.\n   346\t        kc = getattr(