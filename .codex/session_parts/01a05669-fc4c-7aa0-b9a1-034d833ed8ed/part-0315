._M_b, self._K_b),\n   861\t                    v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n   862\t                    self._packed_capacity,\n   863\t                )\n   864\t\n   865\t\n   866\t_cudart_lib = None\n   867\t_cudart_lock = threading.Lock()\n   868\t\n   869\t\n   870\tdef _get_cudart():\n   871\t    global _cudart_lib\n   872\t    if _cudart_lib is not None:\n   873\t        return _cudart_lib\n   874\t    with _cudart_lock:\n   875\t        if _cudart_lib is None:\n   876\t            lib = None\n   877\t            candidates = sorted(glob.glob(os.path.join(\n   878\t                os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n   879\t            for candidate in candidates:\n   880\t                try:\n   881\t                    lib = ctypes.CDLL(candidate)\n   882\t                    break\n   883\t                except OSError:\n   884\t                    continue\n   885\t            if lib is None:\n   886\t                try:\n   887\t                    lib = ctypes.CDLL(\"libcudart.so\")\n   888\t                except OSError:\n   889\t                    lib = False\n   890\t            _cudart_lib = lib\n   891\t    return _cudart_lib\n   892\t\n   893\t\n   894\tdef _sync_cuda_event(handle: int) -> None:\n   895\t    if not handle:\n   896\t        return\n   897\t    lib = _get_cudart()\n   898\t    if lib:\n   899\t        result = lib.cudaEventSynchronize(ctypes.c_void_p(int(handle)))\n   900\t        if result != 0:\n   901\t            raise RuntimeError(\n   902\t                f\"cudaEventSynchronize failed for CD3 CPU encode: {result}\")\n   903\t    else:  # pragma: no cover - libcudart is present in serving containers\n   904\t        torch.cuda.synchronize()\n   905\t\n   906\t\n   907\tclass ChunkDelta3CPUKVCompressor(ChunkDelta3KVCompressor):\n   908\t    \"\"\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\n   909\t\n   910\t    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\n   911\t    that D2H event and encodes directly from the host tensor into persistent\n   912\t    physical slots, keeping encode kernels off the fused-MM critical path.\n   913\t    \"\"\"\n   914\t\n   915\t    _USES_GPU_COMPRESS = False\n   916\t\n   917\t    def __init__(self, comp_stream: torch.cuda.Stream):\n   918\t        if not _HAS_CHUNK_DELTA3 or not hasattr(\n   919\t                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n   920\t            raise RuntimeError(\n","stderr":"","aggregated_output":"   450\t            heapq.heappush(self._kv_free_heap[layer_id], slot)\n   451\t\n   452\t    @staticmethod\n   453\t    def _slot_runs(slots: list[int]):\n   454\t        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n   455\t        if not slots:\n   456\t            return\n   457\t        row_begin = 0\n   458\t        slot_begin = slots[0]\n   459\t        previous = slot_begin\n   460\t        for row in range(1, len(slots)):\n   461\t            slot = slots[row]\n   462\t            if slot != previous + 1:\n   463\t                yield row_begin, row, slot_begin\n   464\t                row_begin = row\n   465\t                slot_begin = slot\n   466\t            previous = slot\n   467\t        yield row_begin, len(slots), slot_begin\n   468\t\n   469\t    def _batch_h2d(self, destinations: list[torch.Tensor],\n   470\t                   sources: list[torch.Tensor],\n   471\t                   stream: torch.cuda.Stream | None = None) -> None:\n   472\t        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n   473\t        if not destinations:\n   474\t            return\n   475\t        if len(destinations) == 1:\n   476\t            if stream is None:\n   477\t                destinations[0].copy_(sources[0], non_blocking=True)\n   478\t            else:\n   479\t                with torch.cuda.stream(stream):\n   480\t                    destinations[0].copy_(sources[0], non_blocking=True)\n   481\t            return\n   482\t        extension = self._batch_ext\n   483\t        if extension is None:\n   484\t            try:\n   485\t                from tiered_serve.cpp_exts import zipserv_ext as extension\n   486\t            except Exception:\n   487\t                extension = False\n   488\t            self._batch_ext = extension\n   489\t        if extension and hasattr(extension, \"batch_memcpy\"):\n   490\t            extension.batch_memcpy(\n   491\t                destinations, sources,\n   492\t                (torch.cuda.current_stream().cuda_stream\n   493\t                 if stream is None else stream.cuda_stream))\n   494\t        else:\n   495\t            if stream is None:\n   496\t                torch._foreach_copy_(\n   497\t                    destinations, sources, non_blocking=True)\n   498\t            else:\n   499\t                with torch.cuda.stream(stream):\n   500\t                    torch._foreach_copy_(\n   501\t                        destinations, sources, non_blocking=True)\n   502\t\n   503\t    def _launch_compress(self, layer_id: int, block_ids: list,\n   504\t                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n   505\t        num_primary = gpu_k.shape[0]\n   506\t        block_ids = [int(bid) for bid in block_ids\n   507\t                     if 0 <= int(bid) < num_primary]\n   508\t        n = len(block_ids)\n   509\t        if n == 0:\n   510\t            return\n   511\t        if n > self._max_gpu_blocks:\n   512\t            raise RuntimeError(\n   513\t                f\"ChunkDelta3 KV encode batch {n} exceeds \"\n   514\t                f\"capacity {self._max_gpu_blocks}\")\n   515\t        slots = [self._assign_kv_slot(layer_id, bid) for bid in block_ids]\n   516\t        bid_gpu = torch.as_tensor(\n   517\t            block_ids, dtype=torch.long, device=gpu_k.device)\n   518\t\n   519\t        with torch.cuda.stream(self.comp_stream):\n   520\t            k_blocks = gpu_k[bid_gpu].reshape(\n   521\t                n, self._M_b, self._K_b).contiguous()\n   522\t            v_blocks = gpu_v[bid_gpu].reshape(\n   523\t                n, self._M_b, self._K_b).contiguous()\n   524\t            for kv, blocks in ((\"k\", k_blocks), (\"v\", v_blocks)):\n   525\t                pool = self._gpu_comp_pool[kv]\n   526\t                _cd3_ext.compress_chunk_delta3_batched(\n   527\t                    blocks,\n   528\t                    pool[\"codes\"][:n],\n   529\t                    pool[\"sign_mantissa\"][:n],\n   530\t                    pool[\"thread_bases\"][:n],\n   531\t                    pool[\"tile_exception_offsets\"][:n],\n   532\t                    pool[\"entries20x3\"][:n],\n   533\t                    pool[\"num_exceptions\"][:n],\n   534\t                )\n   535\t                host = self._host_pools[layer_id][kv]\n   536\t                # Physical slots are persistent and may contain holes.  Keep\n   537\t                # the copies asynchronous on comp_stream; the event below\n   538\t                # gates publication and later slot reuse.\n   539\t                for row_begin, row_end, slot_begin in self._slot_runs(slots):\n   540\t                    length = row_end - row_begin\n   541\t                    for name in self._FIELDS:\n   542\t                        host[name][slot_begin:slot_begin + length].copy_(\n   543\t                            pool[name][row_begin:row_end], non_blocking=True)\n   544\t            event = self.comp_stream.record_event()\n   545\t\n   546\t        self._pending_compress[layer_id] = {\n   547\t            \"event\": event,\n   548\t            \"buffer_ids\": block_ids,\n   549\t            \"physical_slots\": slots,\n   550\t        }\n   551\t\n   552\t    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n   553\t                            timeout_sec: float = -1.0) -> None:\n   554\t        del timeout_sec\n   555\t    