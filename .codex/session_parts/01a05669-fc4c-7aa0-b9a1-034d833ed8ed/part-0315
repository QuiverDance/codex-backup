ase_backend).lower()\n   548\t            # Remember the offload codec so offload_compressed prefill can key\n   549\t            # its (mode-distinct) compress-on-small-chunk threshold by codec.\n   550\t            self._offload_backend = offload_backend\n   551\t            self._compressor_split = self._make_weight_compressor(\n   552\t                split_backend, role=\"split\")\n   553\t            if offload_backend == split_backend:\n   554\t                # Same backend → share a single instance.  Saves an entire\n   555\t                # set of workspace buffers / CUDA streams and avoids two\n   556\t                # ZipServ ext managers fighting over the same resources.\n   557\t                self._compressor_offload = self._compressor_split\n   558\t            else:\n   559\t                self._compressor_offload = self._make_weight_compressor(\n   560\t                    offload_backend, role=\"offload\")\n   561\t            # Legacy alias.  Most call sites that used self.weight_compressor\n   562\t            # directly were dealing with offload/frozen_compressed paths; we\n   563\t            # alias to the offload compressor so they keep behaving the\n   564\t            # same when the user supplies only the base flag.\n   565\t            self.weight_compressor = self._compressor_offload\n   566\t\n   567\t        env_var_value = os.getenv(\"TIERED_SERVE_USE_KV_COMP\")\n   568\t        use_kv_comp = env_var_value is not None and env_var_value == \"1\"\n   569\t        DualMemoryLoader.no_offload_kv = (\n   570\t            os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n   571\t        if DualMemoryLoader.no_offload_kv:\n   572\t            # KV stays fully resident in GPU HBM: disable offload + KV\n   573\t            # compression entirely (weights are still offloaded).\n   574\t            use_kv_comp = False\n   575\t        DualMemoryLoader.use_kv_comp = use_kv_comp\n   576\t        DualMemoryLoader.kv_full_block_only = False\n   577\t\n   578\t        self.kv_compressor = None\n   579\t        if DualMemoryLoader.use_kv_comp:\n   580\t            kv_comp_backend = os.getenv(\n   581\t                \"TIERED_SERVE_KV_COMP_BACKEND\", \"zipserv\").lower()\n   582\t            if kv_comp_backend not in (\n   583\t                    \"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\", \"p4flatcpu\",\n   584\t                    \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\",\n   585\t                    \"chunk_delta3\"):\n   586\t                raise ValueError(\n   587\t                    f\"Unknown TIERED_SERVE_KV_COMP_BACKEND: \"\n   588\t                    f\"{kv_comp_backend!r}. Expected one of: \"\n   589\t                    f\"zipserv, dietgpu, mantexp, p4flat, p4flatcpu, \"\n   590\t                    f\"bitcomp, bitcompcpu, ublb_flat, ublb_tbe, \"\n   591\t                    f\"chunk_delta3.\")\n   592\t\n   593\t            _full_block_only = (\n   594\t                os.getenv(\n   595\t                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\")\n   596\t            if _full_block_only and kv_comp_backend not in (\n   597\t                    \"p4flat\", \"p4flatcpu\", \"chunk_delta3\"):\n   598\t                raise ValueError(\n   599\t                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY=1 currently requires \"\n   600\t                    \"the p4flat, p4flatcpu, or chunk_delta3 KV backend; got \"\n   601\t                    f\"{kv_comp_backend!r}\")\n   602\t            DualMemoryLoader.kv_full_block_only = _full_block_only\n   603\t\n   604\t            # ── KV compression producer mode ──\n   605\t            # Selects how the compressed KV copy is produced during unload.\n   606\t            # Both modes always store raw KV in LPDDR secondary so that\n   607\t            # prefill-containing phases load uncompressed without paying\n   608\t            # decompression latency.  Resolved *before* the backend is\n   609\t            # instantiated because p4flat picks its encode implementation\n   610\t            # (GPU vs CPU) from the producer mode below.\n   611\t            #\n   612\t            #   gpu_direct:\n   613\t            #       Backend's existing pipeline produces compressed KV on GPU\n   614\t            #       (DietGPU/MantExp/p4flat run compress kernels on\n   615\t            #       comp_stream).  Raw secondary unload runs in parallel.\n   616\t            #\n   617\t            #   cpu_after_raw_swap:\n   618\t            #       Avoid GPU compression entirely.  Raw KV is D2H'd to\n   619\t            #       LPDDR secondary first, then a CPU compressor reads\n   620\t            #       directly from secondary_kv (no extra D2H) and writes\n   621\t            #       into the persistent compressed host pool.  Supported only\n   622\t            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n   623\t            #       manager), p4flat, and ChunkDelta3 (Python worker boundary\n   624\t            #       around an OpenMP C++ encoder).\n   625\t            # Default is backend-aware.  ZipServ is CPU-encode only in the\n   626\t            # serving path: raw KV is first swapped to secondary_kv and its C++\n   627\t            # worker manager compresses directly from that host tensor.  This\n   628\t            # is also enforced below so an inherited producer env cannot route\n   629\t            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n   630\t            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n   631\t            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n   632\t            # host_encode_blocks) variant of the p4flat codec — it always uses\n   633\t            # the cpu_after_raw_swap producer, regardless of the env default.\n   634\t            # p4flat's gpu_direct compress runs 3 device kernels\n   635\t            # (compress_lean) on comp_stream.  When weight compression is also\n   636\t