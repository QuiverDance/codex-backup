                block_ids: np.ndarray,\n   683\t                           k_cache: torch.Tensor) -> Dict[str, Any]:\n   684\t        n = len(block_ids)\n   685\t        hwm = self._kv_active_count[layer_id]\n   686\t        slot_table = self._kv_slot_np[layer_id]\n   687\t        slots_np = np.ascontiguousarray(\n   688\t            slot_table[block_ids], dtype=np.int32)\n   689\t        if bool((slots_np < 0).any()):\n   690\t            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n   691\t            raise RuntimeError(\n   692\t                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n   693\t                f\"block={missing}\")\n   694\t\n   695\t        # The production steady state is dense: all active physical slots are\n   696\t        # requested.  Skip Python list conversion and run construction there.\n   697\t        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n   698\t        slot_runs = None\n   699\t        if dense:\n   700\t            packed_h2d = False\n   701\t        else:\n   702\t            slot_runs = list(self._slot_runs(slots_np.tolist()))\n   703\t            max_runs = max(0, int(os.getenv(\n   704\t                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n   705\t            packed_h2d = (\n   706\t                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n   707\t                or hwm > self._max_gpu_decomp_blocks + 1)\n   708\t\n   709\t        slots_gpu = (\n   710\t            self._identity_slots_gpu[:n]\n   711\t            if packed_h2d else torch.as_tensor(\n   712\t                slots_np, dtype=torch.int32, device=k_cache.device))\n   713\t        block_ids_gpu = torch.as_tensor(\n   714\t            block_ids, dtype=torch.long, device=k_cache.device)\n   715\t        copy_destinations_ring = [[], []]\n   716\t        copy_sources = []\n   717\t        for kv in (\"k\", \"v\"):\n   718\t            host_blob = self._host_pools[layer_id][kv][\"blob\"]\n   719\t            if packed_h2d:\n   720\t                for row_begin, row_end, slot_begin in slot_runs:\n   721\t                    length = row_end - row_begin\n   722\t                    for ring_index, gpu_pool in enumerate(\n   723\t                            self._gpu_decomp_pool_ring):\n   724\t                        copy_destinations_ring[ring_index].append(\n   725\t                            gpu_pool[kv][\"blob\"][row_begin:row_end])\n   726\t                    copy_sources.append(\n   727\t                        host_blob[slot_begin:slot_begin + length])\n   728\t            else:\n   729\t                for ring_index, gpu_pool in enumerate(\n   730\t                        self._gpu_decomp_pool_ring):\n   731\t                    copy_destinations_ring[ring_index].append(\n   732\t                        gpu_pool[kv][\"blob\"][:hwm])\n   733\t                copy_sources.append(host_blob[:hwm])\n   734\t        storage_rows = n if packed_h2d else hwm\n   735\t        return {\n   736\t            \"block_ids\": block_ids,\n   737\t            \"generation\": self._decode_generation.get(layer_id, 0),\n   738\t            \"slots_gpu\": slots_gpu,\n   739\t            \"block_ids_gpu\": block_ids_gpu,\n   740\t            # Slot-zero alias retained for benchmark/backward compatibility.\n   741\t            \"copy_destinations\": copy_destinations_ring[0],\n   742\t            \"copy_destinations_ring\": copy_destinations_ring,\n   743\t            \"copy_sources\": copy_sources,\n   744\t            \"storage_rows\": storage_rows,\n   745\t        }\n   746\t\n   747\t    def _decompress_blocks(self, layer_id: int, block_ids,\n   748\t                           k_cache: torch.Tensor,\n   749\t                           v_cache: torch.Tensor) -> None:\n   750\t        n = len(block_ids)\n   751\t        if n == 0:\n   752\t            return\n   753\t        if n > self._max_gpu_decomp_blocks:\n   754\t            raise RuntimeError(\n   755\t  