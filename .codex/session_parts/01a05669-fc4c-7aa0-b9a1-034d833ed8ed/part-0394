kend in _P4_LAYOUTS:\n        raw_bytes = elements * 2\n        return ((raw_bytes + 127) // 128) * 128 + 9\n    if backend == \"chunk_delta3\":\n        if elements <= 0 or elements % 4096:\n            raise ValueError(\n                \"ChunkDelta3 KV block size must be a positive multiple of 4096\")\n        tiles = elements // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n        offset = tiles * 1536 + elements + tiles * 256\n        offset = ((offset + 3) // 4) * 4 + (tiles + 1) * 4\n        offset = ((offset + 7) // 8) * 8 + (entry_capacity // 3) * 8\n        offset = ((offset + 3) // 4) * 4 + 4\n        return ((offset + 127) // 128) * 128\n    return None\n        else:\n            cnt_arr = np.zeros(n, dtype=np.int64)\n        total_arr = fixed + cnt_arr * per_es\n        compressed_arr = total_arr <= min(raw_bytes, self._blob_stride)\n        raw_in_row_arr = (~compressed_arr) & (raw_bytes <= self._blob_stride)\n        secondary_arr = (~compressed_arr) & (~raw_in_row_arr)\n\n        # Splice exceptions only when the complete blob fits this physical row.\n        for b in np.nonzero(cnt_arr)[0]:\n            if not compressed_arr[b]:\n                continue\n            m = (blk_h == b)\n            cnt = int(cnt_arr[b])\n            ib, vb = cnt * idx_es, cnt * val_es\n            blob_np[slots_arr[b], fixed:fixed + ib] = loc_h[m].view(np.uint8)\n            blob_np[slots_arr[b], fixed + ib:fixed + ib + vb] = \\\n                val_h[m].view(np.uint8)\n\n        # Raw-in-row fallback is possible only with a raw-safe stride.  With a\n        # tight row, publish is_raw=2 below and restore from raw secondary KV.\n        for b in np.nonzero(raw_in_row_arr)[0]:\n            host_pool['blob'][slots_arr[b], :raw_bytes].copy_(\n                stack_2d[b * valid_rows:(b + 1) * valid_rows].reshape(-1)\n                .view