{"timestamp":"2026-08-31T08:56:51.659Z","ordinal":4832,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05707-953f-7740-b541-b3122741c3a1","item":{"type":"CommandExecution","id":"exec-1f5937b2-7f43-47ba-ad39-6d9634c999de","process_id":"68769","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc \"cd /root/projects/tiered-serve && sed -n '1,260p' tiered_serve/p4flat_kv_compressor.py && sed -n '560,790p' tiered_serve/dual_memory_loader/__init__.py && sed -n '150,300p' offline_offload_kvweight.py\""],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc \"cd /root/projects/tiered-serve && sed -n '1,260p' tiered_serve/p4flat_kv_compressor.py && sed -n '560,790p' tiered_serve/dual_memory_loader/__init__.py && sed -n '150,300p' offline_offload_kvweight.py\""}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"P4Flat KV cache compressor.\n\nDrop-in ``kv_compressor`` for ``DualMemoryLoader`` that uses the BF16 P4-flat\ncodec (per-64x64-tile 16-entry exponent palette + 4-bit code + raw\nsign|mantissa byte, with out-of-palette exponents kept as an exception list).\nSelected with ``--kv-comp p4flat`` (``TIERED_SERVE_KV_COMP_BACKEND=p4flat``).\n\nLike :class:`DietGPUKVCompressor` the base :class:`P4FlatKVCompressor` is a\nGPU-kernel backend (no C++ worker threads): ``compress_batch_async`` launches\nthe compress + D2H on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.  It serves the ``gpu_direct`` KV producer mode (the default\nfor ``--kv-comp p4flat``).  The ``cpu_after_raw_swap`` producer is served by\nthe :class:`P4FlatCPUKVCompressor` subclass below (CPU worker-pool encode);\nboth share the same GPU decode kernel and on-host storage layout.\n\nIt subclasses :class:`DietGPUKVCompressor` purely to reuse the codec-agnostic\npersistent-slot bookkeeping (``_assign_kv_slot`` / ``_free_kv_slot`` /\n``has_*`` / ``free_persistent_block`` / ``decompress_batch`` chunking).  The\nstorage layout and the codec are completely different and overridden below.\n\nStorage layout (per layer, per K and V), one dense pool of variable-length\ncompressed blobs indexed by physical slot:\n  - ``blob``       : pinned [host_n, max_comp_size] uint8.  Each row holds a\n    serialised compressed block ``[headers | codes | sm | codec |\n    exc_idx | exc_val]`` (or, on raw fallback, the raw BF16 bytes).\n  - ``total_size`` : pinned [host_n] int32 — used bytes of the blob row.\n  - ``exc_cnt``    : pinned [host_n] int32 — number of exceptions.\n  - ``is_raw``     : pinned [host_n] uint8 — 0 compressed, 1 raw BF16 stored\n    in-row, 2 raw BF16 retained only in secondary KV (tight-stride overflow).\n\nA KV block of shape ``block_shape`` is flattened to ``block_numel`` BF16\nelements and reshaped to a 2-D ``[M_b, K_b]`` matrix with both dims multiples\nof 64 (p4flat requires this).  The reshape is a contiguous view, so the codec\nstays bit-exact; the (M_b, K_b) factoring only affects the compression ratio.\n``block_numel`` must therefore be a multiple of 64*64 = 4096.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ctypes\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nimport time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom typing import Any, Dict, List, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\n\nlogger = logging.getLogger(\"vllm\")  # configured/flushed handler (was __name__\n# = \"tiered_serve.*\" -> root, which suppressed INFO and split ERROR to stderr,\n# hiding [kv-decode]/MAPPING-DESYNC diagnostics from the server log file)\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:  # pragma: no cover - extension build/runtime issue\n    logger.warning(\n        \"P4FlatKVCompressor disabled: failed to load zipserv_p4flat_ext \"\n        \"(%s: %s)\", type(_e).__name__, _e)\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\ndef _align(n: int, a: int) -> int:\n    return (n + a - 1) // a * a\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Factor ``numel`` into ``(M_b, K_b)`` with both multiples of 64,\n    chosen as close to square as possible.  Raises if ``numel`` is not a\n    multiple of 4096 (= 64*64).\"\"\"\n    if numel % 4096 != 0:\n        raise ValueError(\n            f\"P4Flat KV: block_numel={numel} is not a multiple of 4096 \"\n            f\"(64*64); cannot factor into 64-aligned (M_b, K_b). Padding is \"\n            f\"not supported.\")\n    best = None\n    m = 64\n    while m * m <= numel:\n        if numel % m == 0:\n            k = numel // m\n            if k % 64 == 0:\n                best = (m, k)  # largest square-ish m wins as loop advances\n        m += 64\n    if best is None:\n        # Fall back to the most rectangular valid split (M_b=64).\n        if (numel // 64) % 64 == 0:\n            best = (64, numel // 64)\n        else:\n            raise ValueError(\n                f\"P4Flat KV: cannot factor block_numel={numel} into \"\n                f\"64-aligned (M_b, K_b).\")\n    return best\n\n\ndef _factor_64_kv(numel: int, occupancy: bool) -> Tuple[int, int]:\n    \"\"\"Factor a KV block into ``(M_b, K_b)``.\n\n    Occupancy mode (``TIERED_SERVE_KV_P4FLAT_OCCUPANCY``) lays the block out\n    *tall* — ``K_b=64`` so ``M_b=numel//64`` — instead of square.  The KV\n    block is ``[block_size, H, D]`` flattened row-major, so the token axis is\n    the outermost (slowest) dim: written tokens occupy a contiguous *prefix*\n    of rows and the unwritten tail is a contiguous suffix of all-zero rows.\n    A tall layout maximises the number of independent 64-row palette-tile\n    bands (``M_b//64``), making the all-zero suffix fall on whole skippable\n    tile bands at the finest possible granularity (``4096//H/D`` tokens/band).\n    A square factoring would instead pack ~8 tokens into one 64-row band (or\n    a single band for small blocks, ``M_b==64``), defeating partial-block\n    skipping.  Tile count — and thus palette/header overhead — is identical\n    either way (``numel//4096`` tiles), so the ratio impact is marginal.\n\n    Non-occupancy mode keeps the historical square factoring (bit-exact with\n    the validated path).\"\"\"\n    if not occupancy:\n        return _factor_64(numel)\n    if numel % 4096 != 0:\n        raise ValueError(\n            f\"P4Flat KV: block_numel={numel} is not a multiple of 4096; \"\n            f\"cannot use occupancy-aware tall layout.\")\n    return (numel // 64, 64)\n\n\nclass P4FlatKVCompressor(DietGPUKVCompressor):\n    \"\"\"BF16 P4-flat KV cache compressor (GPU-kernel backend).\"\"\"\n\n    # The GPU-encode path uses the batched-compress pinned staging; the\n    # CPU-encode subclass overrides this to skip allocating it.\n    _USES_GPU_COMPRESS = True\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_P4FLAT:\n            raise RuntimeError(\n                \"P4FlatKVCompressor requires tiered-serve's zipserv_p4flat_ext \"\n                \"extension to build successfully.\")\n        # Bypass DietGPUKVCompressor.__init__ (it loads DietGPU and allocates\n        # an ANS workspace we don't need); initialise the shared state directly.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\n        # the compute stream — used as a plain attribute, no per-call resolution.\n        self._kv_decode_on_compute = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_ON_COMPUTE\", \"0\") == \"1\"\n        # KV-load stream separation: run the compressed-blob H2D on the\n        # dedicated load_kv_stream (wired by the loader) instead of\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\n        # pipelines with layer L's decode.  load_kv_stream is gated on\n        # \"QKV weights loaded\" by the graph wrapper, so the blob H2D starts\n        # when the single copy engine is free of weight H2D — otherwise it\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\n        # loader wires one (it aliases it to load_weight_stream), and falls back\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\n        # wired (e.g. a standalone compressor with no loader).\n        self.load_kv_stream = None   # wired by the loader after construction\n        self._dec_blob_ring_idx = 0\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Set by the loader from time_breakdown.  When False, the decode skips\n        # the breakdown-only event records (_kv_h2d_begin) — the per-step CUDA\n        # event record() was ~12% of forward-thread CPU in profiling.\n        self._tb = False\n\n        # Per-decode metadata (slots / valid_rows / exc_cnt / is_raw) H2D.\n        # Default = async ring of pinned buffers, event-gated so a lagging\n        # in-flight H2D is never overwritten on reuse — the exact failure that\n        # forced the old synchronous ``torch.stack(...).cuda()`` (pageable ->\n        # ~1 ms/graph CPU dispatch that starves the GPU).  Set\n        # TIERED_SERVE_KV_META_SYNC=1 to restore that legacy sync path.\n        self._meta_sync_fallback = os.getenv(\n            \"TIERED_SERVE_KV_META_SYNC\", \"0\") == \"1\"\n        self._meta_ring_n = 0\n        self._meta_ring_pi = None   # list[pinned int32 [5*cap]]  (cs,vrk,eck,vrv,ecv)\n        self._meta_ring_pu = None   # list[pinned uint8 [2*cap]]  (is_raw k,v)\n        self._meta_ring_b = None    # list[pinned int64 [cap]]    (block_ids)\n        self._meta_ring_ev = None   # list[cuda.Event] gating buffer reuse\n        self._meta_ring_idx = 0\n\n        # Reused, codec-agnostic persistent-slot bookkeeping (see base class).\n        self._compressed_kv: Dict[int, Any] = {}\n        self._persistent_valid: Dict[int, bytearray] = {}\n        self._kv_slot: Dict[int, torch.Tensor] = {}\n        self._kv_slot_np: Dict[int, Any] = {}   # numpy authority (shared mem)\n        self._kv_slot_block: Dict[int, List[int]] = {}\n        # P4Flat free-list slot management (overrides the base dense\n        # swap-with-last).  ``_kv_active_count`` is repurposed as the staging\n        # HIGH-WATER-MARK (max-assigned-slot + 1 = the [0:hwm] extent the decode\n        # H2D copies); freed slots go to a per-layer min-heap and are refilled\n        # lowest-first so hwm — hence the decode over-copy — stays tight, and\n        # top-of-range frees shrink hwm.  This makes ``free`` metadata-only (no\n        # _move_host_slot host memcpy, no decode-stream sync) — see\n        # ``_free_kv_slot`` and ``_kv_free_metadata_only`` below.\n        self._kv_active_count: Dict[int, int] = {}   # == hwm per layer\n        self._kv_free_heap: Dict[int, list] = {}     # min-heap of free slots\n        self._kv_free_slots: Dict[int, set] = {}     # membership (lazy-delete)\n        # Signals dual_memory_loader.kv.free_slot that this compressor's free path touches no\n        # GPU/host pool memory, so the pre-free decode-stream sync is unneeded.\n        self._kv_free_metadata_only = True\n        # Decode staging H2D: copy only the occupied (live) slot RUNS in\n        # [0:hwm), batching them into one cudaMemcpyBatchAsync so holes\n        # (freed-not-yet-realloc'd slots — possible whenever frees outpace\n        # allocs, e.g. a drain phase) aren't transferred.  ``free_set`` is the\n        # sparse bitarray of holes, so runs come from a membership split (no\n        # sort).  Below this hole count a single [0:hwm] copy is cheaper than\n        # the scan, so we skip it (env-tunable; 0 = always batch).\n        self._decode_hole_threshold = int(os.getenv(\n            \"TIERED_SERVE_KV_DECODE_HOLE_THRESHOLD\", \"32\"))\n        self._batch_ext = None      # cached zipserv_ext for batch_memcpy\n        # Decode-arg CPU-dispatch trims (the per-layer Python/torch op count is\n        # what stalls before_replay — ~20 dispatches x n_layers showed up as\n        # ~2 ms of forward-thread CPU before the blob batchmemcpy in nsys):\n        #  - grid sizing uses STATIC caps (M_b / exc_cap) instead of four\n        #    per-layer pinned .max() reductions; the per-block device arrays\n        #    still bound each block's work in-kernel.\n        #    TIERED_SERVE_KV_DECODE_VALIDATE=1 restores the exact maxes\n        #    (tighter grids + full corrupt-meta detection) for debugging.\n        #  - the block-id vector is identical for every layer of a step, so\n        #    its CPU tensor + device upload are cached step-level\n        #    (content-keyed) and reused by the remaining n_layers-1 decodes.\n        self._decode_validate = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_VALIDATE\", \"0\") == \"1\"\n        self._cbids_cache_np = None    # np.int64 id vector (content key)\n        self._cbids_cache_t = None     # CPU int64 tensor wrapping it\n        self._cbids_cache_gpu = None   # device int64 tensor (uploaded once)\n        # Step-level cache for wait_compress_async: the buffer_ids list is\n        # identical across all layers of a step, so np.asarray + torch.from_numpy\n        # only need to run once per step (not ×80 layers).  Keyed on object\n        # identity (is) with a held reference, matching the decompress_batch\n        # cache pattern.\n        self._wc_bids_np = None        # np.int64 array\n        self._wc_bids_t = None         # torch int64 tensor wrapping _wc_bids_np\n        self._wc_bids_list = None      # source list (identity key)\n        self._wc_vtm = None            # cached valid_tm array for occupancy grouping\n        self._pending_compress: Dict[int, Dict[str, Any]] = {}\n        self._secondary_fallback_possible: Dict[int, bool] = {}\n\n        self._kv_pools_ready = False\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n\n        # Occupancy-aware KV compression (TIERED_SERVE_KV_P4FLAT_OCCUPANCY):\n        # only encode/decode the 64-row tile bands covering written tokens of\n        # each (partial) block.  ``_block_valid_tokens`` is a per-step\n        # {buffer_id -> valid_token_count} map published by the forward hook;\n        # ``None`` (default / metadata unavailable) means \"treat every block as\n        # full\", which reduces to the historical full-block behaviour.\n        self._occupancy_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_P4FLAT_OCCUPANCY\", \"0\") == \"1\")\n                    offload_backend, role=\"offload\")\n            # Legacy alias.  Most call sites that used self.weight_compressor\n            # directly were dealing with offload/frozen_compressed paths; we\n            # alias to the offload compressor so they keep behaving the\n            # same when the user supplies only the base flag.\n            self.weight_compressor = self._compressor_offload\n\n        env_var_value = os.getenv(\"TIERED_SERVE_USE_KV_COMP\")\n        use_kv_comp = env_var_value is not None and env_var_value == \"1\"\n        DualMemoryLoader.no_offload_kv = (\n            os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n        if DualMemoryLoader.no_offload_kv:\n            # KV stays fully resident in GPU HBM: disable offload + KV\n            # compression entirely (weights are still offloaded).\n            use_kv_comp = False\n        DualMemoryLoader.use_kv_comp = use_kv_comp\n        DualMemoryLoader.kv_full_block_only = False\n\n        self.kv_compressor = None\n        if DualMemoryLoader.use_kv_comp:\n            kv_comp_backend = os.getenv(\n                \"TIERED_SERVE_KV_COMP_BACKEND\", \"zipserv\").lower()\n            if kv_comp_backend not in (\n                    \"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\", \"p4flatcpu\",\n                    \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_BACKEND: \"\n                    f\"{kv_comp_backend!r}. Expected one of: \"\n                    f\"zipserv, dietgpu, mantexp, p4flat, p4flatcpu, \"\n                    f\"bitcomp, bitcompcpu, ublb_flat, ublb_tbe.\")\n\n            _full_block_only = (\n                os.getenv(\n                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\")\n            if _full_block_only and kv_comp_backend not in (\n                    \"p4flat\", \"p4flatcpu\"):\n                raise ValueError(\n                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY=1 currently requires \"\n                    \"the p4flat or p4flatcpu KV backend; got \"\n                    f\"{kv_comp_backend!r}\")\n            DualMemoryLoader.kv_full_block_only = _full_block_only\n\n            # ── KV compression producer mode ──\n            # Selects how the compressed KV copy is produced during unload.\n            # Both modes always store raw KV in LPDDR secondary so that\n            # prefill-containing phases load uncompressed without paying\n            # decompression latency.  Resolved *before* the backend is\n            # instantiated because p4flat picks its encode implementation\n            # (GPU vs CPU) from the produc