.codec,\n                \"--warmup\", str(args.warmup),\n                \"--iterations\", str(args.iterations),\n                \"--single-process\",\n            ], check=True)\n        return\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n        host_k, host_v = _load(args.path, n)\n        print(f\"\\nKV blocks={n}, matrix=[{n * ROWS_PER_BLOCK}, {COLS}] x K/V\")\n        for name in codec_names:\n            _bench(name, host_k, host_v, args.warmup, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"started_at_ms":1788166607434,"completed_at_ms":1788166607434}}
