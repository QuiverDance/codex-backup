                   t = torch.empty(\n                        *shape, dtype=dtype, device='cpu').pin_memory()\n                pool[name] = t\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            # Accept pre-allocated pools (must match the DietGPU layout).\n            self._host_pools = pre_allocated_host_pools\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging pools (one set each for compress, decompress).\n        def _alloc_gpu_pool(n_blocks: int) -> Dict[str, torch.Tensor]:\n            return {\n                'comp_exp':  torch.empty(\n                    n_blocks, max_comp_size, dtype=torch.uint8,\n                    device='cuda'),\n                'sm':        torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'exp':       torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'sizes':     torch.empty(\n                    n_blocks, dtype=torch.int32, device='cuda'),\n            }\n\n        self.