        if opt.startswith(\"pagesize=\"):\n                        sz = opt.split(\"=\", 1)[1].upper()\n                        mult = {\"K\": 1 << 10, \"M\": 1 << 20, \"G\": 1 << 30}.get(\n                            sz[-1], 1)\n                        best = int(sz[:-1]) * mult if sz[-1].isalpha() \\\n                            else int(sz)\n        return best\n    except OSError:\n        return None\n\n\nclass _AtsPool:\n    \"\"\"LPDDR-backed, GPU-addressable (ATS/C2C) bump pool for exponent buffers.\n\n    Prefers a hugetlbfs mmap (peak C2C bandwidth, the canonical ats-benchmarks\n    HugepagePool path); falls back to numa_alloc_onnode on the LPDDR node when\n    no free hugepages exist.  Either way the region is cudaHostRegister'd\n    (PORTABLE|MAPPED) and a device pointer is obtained via\n    cudaHostGetDevicePointer, so a kernel dereferences it straight from Grace\n    LPDDR over the C2C link.  ``to_ats`` D2H-copies a CUDA tensor into the pool\n    and returns a DHA CUDA-view over the LPDDR device pointer.\n    \"\"\"\n\n    _ALIGN = 256\n\n    def __init__(self, pool_bytes, hugepage_dir, lpddr_node=0):\n        self.pool_bytes = int(pool_bytes)\n        self.hugepage_dir = hugepage_dir\n        self.lpddr_node = int(lpddr_node)\n        self._off = 0\n        self._host_ptr = 0\n        self._dev_ptr = 0\n        self.backend = None\n        self._mm = None\n        self._path = None\n        self._numa = None\n        self._numa_ptr = 0\n        self._hp_err = None\n        cr = ctypes.CDLL(\"libcudart.so\")\n        cr.cudaHostRegister.argtypes = [ctypes.c_void_p, ctypes.c_size_t,\n                                        ctypes.c_uint]\n        cr.cudaHostRegister.restype = ctypes.c_int\n        cr.cudaHostUnregister.argtypes = [ctypes.c_void_p]\n        cr.cudaHostUnregister.restype = ctypes.c_int\n        cr.cudaHostGetDevicePointer.argtypes = [\n            ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_uint]\n        cr.cudaHostGetDevicePointer.restype = ctypes.c_int\n        self._cr = cr\n\n    def _register(self, host_ptr, nbytes):\n        rc = self._cr.cudaHostRegister(ctypes.c_void_p(host_ptr), nbytes,\n                                       0x01 | 0x02)  # PORTABLE | MAPPED\n        if rc != 0:\n            raise RuntimeError(f\"cudaHostRegister failed rc={rc}\")\n        dev = ctypes.c_void_p()\n        rc = self._cr.cudaHostGetDevicePointer(\n            ctypes.byref(dev), ctypes.c_void_p(host_ptr), 0)\n        if rc != 0:\n            raise RuntimeError(f\"cudaHostGetDevicePointer failed rc={rc}\")\n        return int(dev.value)\n\n    def _init(self):\n        if self.backend is not None:\n            return\n        try:\n            self._init_hugepage()\n            self.backend = \"hugepage\"\n            return\n        except Exception as e:  # noqa: BLE001 — fall back, report later\n            self._hp_err = e\n        self._init_numa()\n        self.backend = \"numa-lpddr\"\n\n    def _init_hugepage(self):\n        import mmap\n        import tempfile\n        d = self.hugepage_dir\n        if not (d and os.path.isdir(d) and os.access(d, os.W_OK)):\n            raise RuntimeError(f\"hugepage dir unusable: {d}\")\n        psize = _hugetlbfs_pagesize(d)\n        nbytes = self.pool_bytes\n        if psize:  # hugetlbfs mmap length must be a whole-page multiple\n            nbytes = ((nbytes + psize - 1) // psize) * psize\n        fd, path = tempfile.mkstemp(prefix=\"fusegemm_ats_\", dir=d)\n        try:\n            os.ftruncate(fd, nbytes)\n            mm = mmap.mmap(fd, nbytes, flags=mmap.MAP_SHARED,\n                           prot=mmap.PROT_READ | mmap.PROT_WRITE)\n        finally:\n            os.close(fd)\n        host = ctypes.addressof(ctypes.c_char.from_buffer(mm))\n        self._dev_ptr = self._register(host, nbytes)\n        self._host_ptr = host\n        self.pool_bytes = nbytes\n        self._mm = mm\n        self._path = path\n\n    def _init_numa(self):\n        numa = ctypes.CDLL(\"libnuma.so.1\")\n        numa.numa_alloc_onnode.argtypes = [ctypes.c_size_t, ctypes.c_int]\n        numa.numa_alloc_onnode.restype = ctypes.c_void_p\n        numa.numa_free.argtypes = [ctypes.c_void_p, ctypes.c_size_t]\n        ptr = numa.numa_alloc_onnode(self.pool_bytes, self.lpddr_node)\n        if not ptr:\n            raise MemoryError(\n                f\"numa_alloc_onnode({self.pool_bytes}, node \"\n                f\"{self.lpddr_node}) failed (hugepage also failed: \"\n                f\"{self._hp_err})\")\n        self._numa = numa\n        self._numa_ptr = int(ptr)\n        self._dev_ptr = self._register(self._numa_ptr, self.pool_bytes)\n        self._host_ptr = self._numa_ptr\n\n    def _alloc_raw(self, nbytes):\n        self._init()\n        off = ((self._off + self._ALIGN - 1) // self._ALIGN) * self._ALIGN\n        if off + nbytes > self.pool_bytes:\n            raise RuntimeError(\n                f\"ATS pool exhausted: need {off + nbytes} > {self.pool_bytes} \"\n                f\"bytes (raise --ats-pool-gib)\")\n        self._off = off + nbytes\n        return self._host_ptr + off, self._dev_ptr + off\n\n    def to_ats(self, t):\n        \"\"\"Copy CUDA tensor ``t`` into LPDDR; return a DHA CUDA view over it.\"\"\"\n        t = t.contiguous()\n        nbytes = t.numel() * t.element_size()\n        if nbytes == 0:\n            return t\n        h, d = self._alloc_raw(nbytes)\n        buf = (ctypes.c_uint8 * nbytes).from_address(h)\n        host_view = torch.frombuffer(buf, dtype=torch.uint8).view(\n            t.dtype).reshape(t.shape)\n        host_view.copy_(t)  # blocking D2H into Grace LPDDR\n        return _get_dha_ext().dha_allocate(\n            int(d), int(nbytes), list(t.shape), list(t.stride()), t.dtype)\n\n    def reset(self):\n        self._off = 0\n\n    def cleanup(self):\n        if self._host_ptr:\n            try:\n                self._cr.cudaHostUnregister(ctypes.c_void_p(self._host_ptr))\n            except Exception:  # noqa: BLE001\n                pass\n        if self._mm is not None:\n            self._mm.close()\n            if self._path is not None:\n                try:\n                    os.unlink(self._path)\n                except OSError:\n                    pass\n        elif self._numa is not None and self._numa_ptr:\n            self._numa.numa_free(ctypes.c_void_p(self._numa_ptr),\n                                 self.pool_bytes)\n        self._host_ptr = self._dev_ptr = 0\n\n\ndef place_exponent_in_ats(codec_name, comp, pool):\n    \"\"\"Relocate the codec's compressed-exponent buffers into LPDDR/ATS.\n\n    Returns ``(target, exp_attrs, hbm_tensors, ats_tensors)``: the object whose\n    attrs the fused kernel reads, the list of relocated attrs, and the two\n    tensor sets so the caller can flip the live buffers between HBM and ATS per\n    measurement.  Zero-size / non-CUDA buffers (e.g. an empty exception list)\n    are left untouched — the kernel never reads them.\n    \"\"\"\n    target_fn, _mant_attr, exp_attrs = _ATS_PLAN[codec_name]\n    target = target_fn(comp)\n    hbm, ats = {}, {}\n    for a in exp_attrs:\n        t = getattr(target, a, None)\n        hbm[a] = t\n        if not torch.is_tensor(t) or t.numel() == 0 or not t.is_cuda:\n            ats[a] = t  # nothing to relocate; not on the read path\n        else:\n            ats[a] = pool.to_ats(t)\n    torch.cuda.synchronize()  # ensure every D2H into LPDDR has landed\n    return target, exp_attrs, hbm, ats\n\n\n# ── CLI ──────────────────────────────────────────────────────────────────────\ndef parse_args():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--codecs\", default=\"zipserv,p4flat\")\n    ap.add_argument(\"--projs\", default=\"qkv,o,gate_up,down\")\n    ap.add_argument(\"--n-values\",\n                    default=\"1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,160,192,256,512,1024\")\n    ap.add_argument(\"--tp\", type=int, default=1,\n                    help=\"tensor-parallel degree (shards shapes; needs --synthetic for tp>1)\")\n    ap.add_argument(\"--synthetic\", action=\"store_true\",\n                    help=\"random bf16 weights instead of the real checkpoint\")\n    ap.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    ap.add_argument(\"--shards\", type=int, default=6,\n                    help=\"max safetensor shards to scan for real weights\")\n    ap.add_argument(\"--layers\", default=\"0,40\",\n                    help=\"comma-separated real checkpoint layers; official \"\n                         \"scaling run uses the outlier-heavy 0 and representative 40\")\n    ap.add_argument(\"--layer\", type=int, default=None,\n                    help=\"legacy single-layer override for --layers\")\n    ap.add_argument(\"--repeat-id\", type=int, default=0,\n                    help=\"independent-process repeat recorded in every CSV row\")\n    ap.add_argument(\"--seed\", type=int, default=2025010215,\n                    help=\"base seed for reproducible BF16 activations\")\n    ap.add_argument(\"--warmup\", type=int, default=5)\n    ap.add_argument(\"--iters\", type=int, default=50)\n    ap.add_argument(\"--no-flush\", action=\"store_true\",\n                    help=\"disable L2 flush between iters\")\n    ap.add_argument(\"--no-h2d\", action=\"store_true\",\n                    help=\"skip the concurrent-H2D contention condition\")\n    ap.add_argument(\"--h2d-bytes\", type=int, default=0,\n                    help=\"H2D contention traffic per copy (0 = codec compressed size)\")\n    ap.add_argument(\"--check\", action=\"store_true\",\n                    help=\"print per-row fused OK/INVALID marker (validity gate \"\n                         \"is always on unless --no-validate)\")\n    ap.add_argument(\"--no-validate\", action=\"store_true\",\n                    help=\"skip the fused bi