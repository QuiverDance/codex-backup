{"timestamp":"2026-08-31T07:13:15.645Z","ordinal":1435,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a056aa-497d-7da3-992d-6350d793db44","call_id":"call_jhcV7wZpHf9RXeyupLJImILK","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import sys\nimport sysconfig\nimport platform\nimport os as _os\nimport ctypes as _ctypes\nfrom concurrent.futures import ThreadPoolExecutor\n\nfrom torch.utils.cpp_extension import load\n\n# Linux multiarch dir — x86_64-linux-gnu on Intel/AMD, aarch64-linux-gnu on Grace.\n_libarch = \"x86_64-linux-gnu\" if platform.machine() == \"x86_64\" else \"aarch64-linux-gnu\"\n# Default CUDA arch: SM 12.0a (Blackwell consumer / RTX PRO Blackwell Server) on\n# x86 hosts; SM 9.0a (Hopper / Grace Hopper) on aarch64 hosts. Override with\n# TIERED_SERVE_CUDA_ARCH if you need a different target.\n_default_cuda_arch = \"12.0a\" if platform.machine() == \"x86_64\" else \"9.0a\"\n\n# Pre-load libcuda.so so that CUDA driver symbols are available\ntry:\n    _ctypes.CDLL(\"libcuda.so\", mode=_ctypes.RTLD_GLOBAL)\nexcept OSError:\n    try:\n        _ctypes.CDLL(f\"/usr/lib/{_libarch}/libcuda.so\", mode=_ctypes.RTLD_GLOBAL)\n    except OSError:\n        pass  # will fail later with a clearer error from the linker\n\n_csrc_dir = _os.path.join(_os.path.dirname(__file__), \"..\", \"..\", \"cpp_extensions\", \"csrc\")\n_zipserv_kernel_dir = _os.path.join(_csrc_dir, \"zipserv\")\n# After Phase 1 migration, codec-core .cu live under\n# tiered_serve/compression/cuda/ and fused MM kernels under\n# tiered_serve/compression/adapters/cuda/.  Headers (include/, zipserv/)\n# stay in cpp_extensions/csrc/ and are reached via the existing\n# _csrc_dir/_zipserv_kernel_dir extra_include_paths.\n_compression_dir = _os.path.join(\n    _os.path.dirname(__file__), \"..\", \"compression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old_arch_list = _os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n_os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _os.environ.get(\n    \"TIERED_SERVE_CUDA_ARCH\", _default_cuda_arch)\n\n# SM_90a-only WGMMA kernels — built only on Hopper hosts. On Blackwell the\n# fused decompress+GEMM path falls back to the SM_120-compatible\n# zipserv_fused_mm_gpu.cu (ldmatrix + mma.m16n8k16) kernel.\n_is_hopper = _default_cuda_arch.startswith(\"9.\")\n_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_cluster_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_2wg_sm90.cu\",\n] if _is_hopper else []\n\n# When WGMMA sources are omitted, define ZIPSERV_NO_WGMMA s