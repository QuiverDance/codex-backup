Error:\n    try:\n        _ctypes.CDLL(f\"/usr/lib/{_libarch}/libcuda.so\", mode=_ctypes.RTLD_GLOBAL)\n    except OSError:\n        pass  # will fail later with a clearer error from the linker\n\n_csrc_dir = _os.path.join(_os.path.dirname(__file__), \"..\", \"..\", \"cpp_extensions\", \"csrc\")\n_zipserv_kernel_dir = _os.path.join(_csrc_dir, \"zipserv\")\n# After Phase 1 migration, codec-core .cu live under\n# tiered_serve/compression/cuda/ and fused MM kernels under\n# tiered_serve/compression/adapters/cuda/.  Headers (include/, zipserv/)\n# stay in cpp_extensions/csrc/ and are reached via the existing\n# _csrc_dir/_zipserv_kernel_dir extra_include_paths.\n_compression_dir = _os.path.join(\n    _os.path.dirname(__file__), \"..\", \"compression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old_arch_list = _os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n_os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _os.environ.get(\n    \"TIERED_SERVE_CUDA_ARCH\", _default_cuda_arch)\n\n# SM_90a-only WGMMA kernels — built only on Hopper hosts. On Blackwell the\n# fused decompress+GEMM path falls back to the SM_120-compatible\n# zipserv_fused_mm_gpu.cu (ldmatrix + mma.m16n8k16) kernel.\n_is_hopper = _default_cuda_arch.startswith(\"9.\")\n_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_cluster_sm90.cu\",\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_2wg_sm90.cu\",\n] if _is_hopper else []\n\n# When WGMMA sources are omitted, define ZIPSERV_NO_WGMMA so the call sites\n# in zipserv_fused_mm_gpu.cu / zipserv_p4flat_fused_mm.cu /\n# zipserv_p4wg_fused_mm.cu emit stub launchers that return cudaErrorNotSupported.\n_wgmma_defines = [] if _is_hopper else [\"-DZIPSERV_NO_WGMMA=1\"]\n\n_p4flat_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# P4-WG codec — same compression as p4flat but 8x8 subblock layout for\n# WGMMA-friendly fused decompress+GEMM.  WGMMA path is Hopper-only (sm_90a);\n# on Blackwell only the ldmatrix-based fused_mm kernel is built.\n_p4wg_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_p4wg_fused_wgmma_sm90.cu\",\n] if _is_hopper else []\n\n# nvcomp SDK is optional — only build the extension if its headers are\n# available. Without it the nvcomp-backed compressors stay disabled (their\n# Python wrappers log a warning, same as the WGMMA-disabled path).\ndef _nvcomp_include_dir():\n    for candidate in (\"/usr/include/nvcomp_13\", \"/usr/include/nvcomp_12\",\n                      \"/usr/include\"):\n        if _os.path.isfile(_os.path.join(candidate, \"nvcomp\", \"gdeflate.hpp\")):\n            return candidate\n    return None\n\n_nvcomp_inc = _nvcomp_include_dir()\n\n# ---------------------------------------------------------------------------\n# Parallel build: torch's JIT load() builds each extension sequentially, and\n# with only a handful of sources per extension a single heavy nvcc invocation\n# serialises the whole import.  Extensions have distinct names -> distinct\n# build dirs (FileBaton-locked individually), so building them concurrently\n# is safe.  TIERED_SERVE_BUILD_JOBS caps concurrent extension builds; each\n# build's internal ninja parallelism is capped via MAX_JOBS (unless the user\n# already set it) so the total stays around the core count.\n# ---------------------------------------------------------------------------\n_n_build_workers = int(_os.environ.get(\"TIERED_SERVE_BUILD_JOBS\", \"8\"))\n_old_max_jobs = _os.environ.get(\"MAX_JOBS\")\nif _old_max_jobs is None:\n    _os.environ[\"MAX_JOBS\"] = str(\n        max(2, (_os.cpu_count() or 8) // _n_build_workers))\n\n_build_pool = ThreadPoolExecutor(max_workers=_n_build_workers)\n_futures = {}\n\ndef _submit(name, **kwargs):\n    _futures[name] = _build_pool.submit(load, name=name, **kwargs)\n\n_submit(\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # The experimental benchmark force-opens the threshold.  Keep production\n    # routing disabled until a serving-level crossover has been calibrated.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 0,\n        (8192, 8192): 0,\n        (57344, 8192): 0,\n        (8192, 28672): 0,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and CD3 shared-memory pressure.\n        n_pad = ((N + 63) // 64) * 64\n        # CD3 blocks do more per-K-tile work than P4/U4, so their generic\n        # split-K=4 choice over-splits O/Down.  Real layer-40 A/B measurements\n        # select two splits there; QKV still benefits slightly from four.\n        if n_pad <= 64:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 2,\n                (8192, 28672): 2,\n            }.get((M, K), _u4_split_k(M, n_pad, K))\n        elif n_pad == 128:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 2,\n                (57344, 8192): 2,\n                (8192, 28672): 2,\n            }.get((M, K), 1)\n        elif n_pad in (192, 256):\n            split_k = 4 if (M, K) == (10240, 8192) else 1\n        else:\n            split_k = 1\n        output = torch.empty(\n            n_pad, M, dtype=torch.bfloat16, device=device)\n        padded_input = torch.empty(\n            n_pad, K, dtype=torch.bfloat16, device=device)\n        partials = (\n            torch.empty(\n                split_k, n_pad, M, dtype=torch.float32, device=device)\n            if split_k > 1\n            else _empty_f32(device)\n        )\n        return {\n            \"key\": (M, K, N, device.index),\n            \"n_pad\": n_pad,\n            \"split_k\": split_k,\n            \"output\": output,\n            \"padded_input\": padded_input,\n            \"partials\": partials,\n        }\n\n    def alloc_fused_scratch(\n        self,\n        K: int,\n        M: int,\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=N