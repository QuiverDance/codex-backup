f exception_count(codec_name, comp) -> int:\n    if codec_name == \"zipserv\":\n        return int(comp.compressed_full.numel())\n    if hasattr(comp, \"num_exceptions\"):\n        return int(comp.num_exceptions)\n    target = getattr(comp, \"_c\", comp)\n    for attr in (\"exc_indices\", \"exc_idx\"):\n        value = getattr(target, attr, None)\n        if torch.is_tensor(value):\n            return int(value.numel())\n    return 0\n\n\ndef production_fused_threshold(codec_name, codec, M, K) -> int:\n    if codec_name == \"zipserv\":\n        from tiered_serve.compression.core.zipserv import ZipServCompressor\n        return int(ZipServCompressor._N_THRESHOLD_TABLE.get((M, K), 96))\n    if codec_name == \"p4flat\":\n        return int(codec._FUSED_MAX_N_TABLE.get((M, K), 128))\n    return int(codec._fused_max_n_for(M, K))\n\n\n# ── ATS / Grace-Hopper C2C split placement ───────────────────────────────────\n# With --ats the fused GEMM is measured a SECOND time with the codec's\n# compressed-exponent stream (palette + 4-bit codes + exception lists) relocated\n# to Grace LPDDR, while the raw sign|mantissa byte stream stays in HBM.  On a\n# GH200 (Addressing Mode: ATS) the fused decode+GEMM kernel then reads the\n# exponent payload straight from LPDDR over the NVLink-C2C link into the SMs —\n# no HBM staging copy.  This mirrors the \"Exp ATS\" placement of\n# ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py\n# (HugepagePool + device-pointer \"DHA\" tensors) and cpu_hbm_test.py's\n# numa_alloc_onnode + cudaHostRegister C2C path.\n#\n# Per-codec split: keep the mantissa attr in HBM, move every other compressed\n# buffer the fused kernel reads to ATS.  target_fn locates the object whose\n# attrs the kernel reads (the native struct for p4flat, the wrapper otherwise).\n_ATS_PLAN = {\n    \"p4flat\":    (lambda comp: comp._c, \"sign_mantissa\",\n                  (\"codes\", \"headers\", \"subtile_codec\",\n                   \"exc_indices\", \"exc_values\")),\n    \"ublb_flat\": (lambda comp: comp, \"lb_raw\",\n                  (\"code_stream\", \"palette\", \"exc_idx\", \"exc_ub\")),\n    \"zipserv\":   (lambda comp: comp, \"sign_mantissa\",\n                  (\"compressed_full\", \"bitmap1\", \"bitmap2\", \"bitmap3\",\n                   \"tile_offsets_median\", \"tile_offsets_global\")),\n    \"chunk_delta3\": (lambda comp: comp._c, \"sign_mantissa\",\n                     (\"codes\", \"thread_bases\", \"entries20x3\")),\n}\n\n_DHA_EXT = None\n\n\ndef _get_dha_ext():\n    \"\"\"JIT ext wrapping a raw CUDA device pointer as a (no-op-deleter) Tensor.\n\n    Lifted verbatim from ats-benchmarks' nvcomp_h2d_vs_ats._get_dha_ext: builds\n    a CUDA at::Tensor over an externally-owned device pointer so a hugepage /\n    NUMA LPDDR region (mapped to the GPU via cudaHostGetDevicePointer) can be\n    handed to the codec kernels exactly like an HBM tensor (.is_cuda == True).\n    \"\"\"\n    global _DHA_EXT\n    if _DHA_EXT is not None:\n        return _DHA_EXT\n    from torch.utils.cpp_extension import load_inline\n    cpp_src = r\"\"\"\n#include <pybind11/pybind11.h>\n#include <pybind11/stl.h>\n#include <torch/extension.h>\nnamespace py = pybind11;\nat::Tensor dha_allocate(\n    uint64_t ptr, int64_t nbytes,\n    const std::vector<int64_t>& sizes,\n    const std::vector<int64_t>& strides,\n    const at::ScalarType dtype) {\n  const at::Device device(at::kCUDA, 0);\n  auto noop_deleter = [](void*) {};\n  c10::DataPtr data_ptr(reinterpret_cast<void*>(ptr), nullptr, noop_deleter, device);\n  auto storage_impl = c10::make_intrusive<c10::StorageImpl>(\n      c10::StorageImpl::use_byte_size_t(), nbytes, std::move(data_ptr), nullptr, false);\n  at::Tensor tensor = at::empty({0}, at::TensorOptions().dtype(dtype).device(device));\n  tensor.set_(storage_impl, 0, sizes, strides);\n  return tensor;\n}\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n  m.def(\"dha_allocate\", &dha_allocate,\n        py::arg(\"ptr\"), py::arg(\"nbytes\"), py::arg(\"sizes\"),\n        py::arg(\"strides\"), py::arg(\"dtype\"));\n}\n\"\"\"\n    _DHA_EXT = load_inline(\n        name=\"fusegemm_dha_ext\", cpp_sources=[cpp_src],\n        extra_cflags=[\"-O3\", \"-std=gnu++17\"], verbose=False)\n    return _DHA_EXT\n\n\ndef _hugetlbfs_pagesize(path):\n    \"\"\"Return the hugetlbfs page size (bytes) backing ``path``, or None.\"\"\"\n    try:\n        with open(\"/proc/mounts\") as f:\n            best = None\n            for line in f:\n                parts = line.split()\n                if len(parts) < 3 or parts[2] != \"hugetlbfs\":\n                    continue\n                mnt = parts[1]\n                if not os.path.abspath(path).startswith(os.path.abspath(mnt)):\n                    continue\n                for opt in parts[3].split(\",\"):\n                    if opt.startswith(\"pagesize=\"):\n                        sz = opt.split(\"=\", 1)[1].upper()\n                        mult = {\"K\": 1 << 10, \"M\": 1 << 20, \"G\": 1 << 30}.get(\n                            sz[-1], 1)\n                        best = int(sz[:-1]) * mult if sz[-1].isalpha() \\\n                            else int(sz)\n        return best\n    except OSError:\n        return None\n\n\nclass _AtsPool:\n    \"\"\"LPDDR-backed, GPU-addressable (ATS/C2C) bump pool for exponent buffers.\n\n    Prefers a hugetlbfs mmap (peak C2C bandwidth, the canonical ats-benchmarks\n    HugepagePool path); falls back to numa_alloc_onnode on the LPDDR node when\n    no free hugepages exist.  Either way the region is cudaHostRegister'd\n    (PORTABLE|MAPPED) and a device pointer is obtained via\n    cudaHostGetDevicePointer, so a kernel dereferences it straight from Grace\n    LPDDR over the C2C link.  ``to_ats`` D2H-copies a CUDA tensor into the pool\n    and returns a DHA CUDA-view over the LPDDR device pointer.\n    \"\"\"\n\n    _ALIGN = 256\n\n    def __init__(self, pool_bytes, hugepage_dir, lpddr_node=0):\n        self.pool_bytes = int(pool_bytes)\n        self.hugepage_dir = hugepage_dir\n        self.lpddr_node = int(lpddr_node)\n        self._off = 0\n        self._host_ptr = 0\n        self._dev_ptr = 0\n        self.backend = None\n        self._mm = None\n        self._path = None\n        self._numa = None\n        self._numa_ptr = 0\n        self._hp_err = None\n        cr = ctypes.CDLL(\"libcudart.so\")\n        cr.cudaHostRegister.argtypes = [ctypes.c_void_p, ctypes.c_size_t,\n                                        ctypes.c_uint]\n        cr.cudaHostRegister.restype = ctypes.c_int\n        cr.cudaHostUnregister.argtypes = [ctypes.c_void_p]\n        cr.cudaHostUnregister.restype = ctypes.c_int\n        cr.cudaHostGetDevicePointer.argtypes = [\n            ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_uint]\n        cr.cudaHostGetDevicePointer.restype = ctypes.c_int\n        self._cr = cr\n\n    def _register(self, host_ptr, nbytes):\n        rc = self._cr.cudaHostRegister(ctypes.c_void_p(host_ptr), nbytes,\n                                       0x01 | 0x02)  # PORTABLE | MAPPED\n        if rc != 0:\n            raise RuntimeError(f\"cudaHostRegister failed rc={rc}\")\n        dev = ctypes.c_void_p()\n        rc = self._cr.cudaHostGetDevicePointer(\n            ctypes.byref(dev), ctypes.c_void_p(host_ptr), 0)\n        if rc != 0:\n            raise RuntimeError(f\"cudaHostGetDevicePointer failed rc={rc}\")\n        return int(dev.value)\n\n    def _init(self):\n        if self.backend is not None:\n            return\n        try:\n            self._init_hugepage()\n            self.backend = \"hugepage\"\n            return\n        except Exception as e:  # noqa: BLE001 — fall back, report later\n            self._hp_err = e\n        self._init_numa()\n        self.backend = \"numa-lpddr\"\n\n    def _init_hugepage(self):\n        import mmap\n        import tempfile\n        d = self.hugepage_dir\n        if not (d and os.path.isdir(d) and os.access(d, os.W_OK)):\n            raise RuntimeError(f\"hugepage dir unusable: {d}\")\n        psize = _hugetlbfs_pagesize(d)\n        nbytes = self.pool_bytes\n        if psize:  # hugetlbfs mmap length must be a whole-page multiple\n            nbytes = ((nbytes + psize - 1) // psize) * psize\n        fd, path = tempfile.mkstemp(prefix=\"fusegemm_ats_\", dir=d)\n        try:\n            os.ftruncate(fd, nbytes)\n            mm = mmap.mmap(fd, nbytes, flags=mmap.MAP_SHARED,\n                           prot=mmap.PROT_READ | mmap.PROT_WRITE)\n        finally:\n            os.close(fd)\n        host = ctypes.addressof(ctypes.c_char.from_buffer(mm))\n        self._dev_ptr = self._register(host, nbytes)\n        self._host_ptr = host\n        self.pool_bytes = nbytes\n        self._mm = mm\n        self._path = path\n\n    def _init_numa(self):\n        numa = ctypes.CDLL(\"libnuma.so.1\")\n        numa.numa_alloc_onnode.argtypes = [ctypes.c_size_t, ctypes.c_int]\n        numa.numa_alloc_onnode.restype = ctypes.c_void_p\n        numa.numa_free.argtypes = [ctypes.c_void_p, ctypes.c_size_t]\n        ptr = numa.numa_alloc_onnode(self.pool_bytes, self.lpddr_node)\n        if not ptr:\n            raise MemoryError(\n                f\"numa_alloc_onnode({self.pool_bytes}, node \"\n                f\"{self.lpddr_node}) failed (hugepage also failed: \"\n                f\"{self._hp_err})\")\n        self._numa = numa\n        self._numa_ptr = int(ptr)\n        self._dev_ptr = self._register(self._numa_ptr, self.pool_bytes)\n        self._host_ptr = self._numa_ptr\n\n    def _alloc_raw(self, nbytes):\n        self._init()\n        off = ((self._off + self._ALIGN - 1) // self._ALIGN) * self._ALIGN\n        if off + nbytes > self.pool_bytes:\n            raise RuntimeError(\n                f\"ATS pool exhausted: need {off + nbytes} > {self.pool_bytes} \"\n                f\"bytes (raise --ats-pool-gib)\")\n        self._off = off + nbytes\n        return self._host_ptr + off, self._dev_ptr + off\n\n    def to_ats(s