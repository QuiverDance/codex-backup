mp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n        for layer, weights in weights_by_layer.items()\n        for proj in projs\n    ]\n\n    # ── ATS exponent->LPDDR pool (GH200 C2C) ──\n    ats_pool = None\n    if args.ats:\n        ats_pool = _AtsPool(int(args.ats_pool_gib * (1 << 30)),\n                            args.ats_hugepage_dir, args.ats_lpddr_node)\n        try:\n            ats_pool.to_ats(torch.zeros(256, dtype=torch.uint8, device=\"cuda\"))\n            ats_pool.reset()\n        except Exception as e:  # noqa: BLE001 — degrade to HBM-only on failure\n            print(f\"ATS: DISABLED — pool init failed \"\n                  f\"({type(e).__name__}: {str(e)[:100]})\")\n            ats_pool.cleanup()\n            ats_pool = None\n\n    print(\"=\" * 128)\n    print(f\"Codec decision benchmark — weights={src}, tp={args.tp}, \"\n          f\"warmup={args.warmup}, iters={args.iters}, \"\n          f\"flush={'off' if args.no_flush else 'on'}, \"\n          f\"h2d={'off' if args.no_h2d else 'on'}\")\n    if ats_pool is not None:\n        print(f\"ATS: exponent->LPDDR via {ats_pool.backend} \"\n              f\"({args.ats_pool_gib:.1f} GiB/proj), mantissa->HBM, SMs read \"\n              f\"the exponent over NVLink-C2C (no HBM staging)\")\n    print(\"=\" * 128)\n\n    rows = []\n    for codec_name in codecs:\n        codec = build_codec(codec_name)\n        force_fused(codec, codec_name)\n\n        for layer_id, proj, weight_cpu in work_items:\n            M, K = shapes[proj]\n            production_threshold = production_fused_thres