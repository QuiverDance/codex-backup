  && tile_exception_offsets.scalar_type() == at::kInt\n                    && tile_exception_offsets.dim() == 2\n                    && tile_exception_offsets.size(0) == host_slots\n                    && tile_exception_offsets.size(1)\n                        == tiles_per_block + 1\n                    && tile_exception_offsets.stride(1) == 1\n                    && tile_exception_offsets.stride(0)\n                        >= tiles_per_block + 1,\n                \"invalid host ChunkDelta3 tile_exception_offsets buffer\");\n    TORCH_CHECK(!entries20x3.is_cuda()\n                    && entries20x3.scalar_type() == at::kLong\n                    && entries20x3.dim() == 2\n                    && entries20x3.size(0) == host_slots\n                    && entries20x3.size(1) > 0\n                    && entries20x3.stride(1) == 1\n                    && entries20x3.stride(0) >= entries20x3.size(1),\n                \"invalid host ChunkDelta3 entries20x3 buffer\");\n    TORCH_CHECK(!num_exceptions.is_cuda()\n                    && num_exceptions.scalar_type() == at::kInt\n                    && num_exceptions.dim() == 1\n                    && num_exceptions.size(0) == host_slots\n                    && num_exceptions.stride(0) >= 1,\n                \"invalid host ChunkDelta3 num_exceptions buffer\");\n\n    const int64_t* bid_ptr = block_ids.data_ptr<int64_t>();\n    const int64_t* slot_ptr = slots.data_ptr<int64_t>();\n    for (int64_t block = 0; block < blocks; ++block) {\n        TORCH_CHECK(bid_ptr[block] >= 0\n                        && bid_ptr[block] < source.size(0),\n                    \"ChunkDelta3 host source block out of range: \",\n                    bid_ptr[block]);\n        TORCH_CHECK(slot_ptr[block] >= 0\n                        && slot_ptr[block] < host_slots,\n                    \"ChunkDelta3 host destination slot out of range: \",\n                    slot_ptr[block]);\n    }\n\n    const uint16_t* input =\n        reinterpret_cast<const uint16_t*>(source.data_ptr<int16_t>());\n    uint8_t* code_out = codes.data_ptr<uint8_t>();\n    uint8_t* sm_out = sign_mantissa.data_ptr<uint8_t>();\n    uint8_t* base_out = thread_bases.data_ptr<uint8_t>();\n    int32_t* offset_out = tile_exception_offsets.data_ptr<int32_t>();\n    uint64_t* entry_out =\n        reinterpret_cast<uint64_t*>(entries20x3.data_ptr<int64_t>());\n    int32_t* count_out = num_exceptions.data_ptr<int32_t>();\n    const int64_t packed_capacity = entries20x3.size(1);\n    const int64_t entry_capacity = packed_capacity * 3;\n    const int64_t code_stride = codes.stride(0);\n    const int64_t sm_stride = sign_mantissa.stride(0);\n    const int64_t base_stride = thread_bases.stride(0);\n    const int64_t offset_stride = tile_exception_offsets.stride(0);\n    const int64_t entry_stride = entries20x3.stride(0);\n    const int64_t count_stride = num_exceptions.stride(0);\n    const int tiles_per_row = static_cast<int>(columns / kTileDim);\n\n    py::gil_scoped_release no_gil;\n#pragma omp parallel for schedule(static)\n    for (int64_t block = 0; block < blocks; ++block) {\n        const int64_t source_block = bid_ptr[block];\n        const int64_t destination_slot = slot_ptr[block];\n        int32_t* offsets = offset_out\n            + destination_slot * offset_stride;\n        uint64_t* destination = entry_out\n            + destination_slot * entry_stride;\n        int32_t total = 0;\n\n        // A single OpenMP owner completes one block.  This preserves the\n        // tile/thread/item exception order without prefix buffers or barriers\n        // and reads every source value only once.\n        for (int tile = 0; tile < tiles_per_block; ++tile) {\n            offsets[tile] = total;\n            const int tile_row = tile / tiles_per_row;\n            const int tile_column = tile - tile_row * tiles_per_row;\n            for (int base_index = 0; base_index < kBasesPerTile;\n                 ++base_index) {\n                const int row_group = base_index >> 2;\n                const int column_group = base_index & 3;\n                const int first_local_row = row_group * kBaseRows;\n                alignas(16) uint8_t exponents[kBaseRows][16];\n                uint8_t minimum_exponent = 255;\n                uint8_t maximum_exponent = 0;\n\n                // Gather every 16-value logical code chunk covered by this\n                // base and write sign/mantissa in the canonical thread-major\n                // layout.  Only the base sharing granularity changes.\n                for (int base_row = 0; base_row < kBaseRows; ++base_row) {\n                    const int local_row = first_local_row + base_row;\n                    const int thread = local_row * 4 + column_group;\n                    const int64_t source_base =\n                        source_block * block_elements\n                        + static_cast<int64_t>(\n                            tile_row * kTileDim + local_row) * columns\n                        + tile_column * kTileDim + column_group * 16;\n                    uint8_t* destination_sm = sm_out\n                        + destination_slot * sm_stride\n                        + static_cast<int64_t>(tile) * kTileElements\n                        + thread * 16;\n#if defined(__aarch64__)\n    module.def(\"compiled_base_rows\", []() { return kBaseRows; });\n#ifdef CD3_DECODE_THREADS\n    module.def(\n        \"compiled_decode_threads\", []() { return CD3_DECODE_THREADS; });\n#endif\n    pybind11::class_<CompressedChunkDelta3>(module, \"CompressedChunkDelta3\")\n        .def(pybind11::init<>())\n        .def_readwrite(\"codes\", &CompressedChunkDelta3::codes)\n        .def_readwrite(\n            \"sign_mantissa\", &CompressedChunkDelta3::sign_mantissa)\n        .def_readwrite(\"thread_bases\", &CompressedChunkDelta3::thread_bases)\n        .def_readwrite(\n            \"tile_exception_offsets\",\n            &CompressedChunkDelta3::tile_exception_offsets)\n        .def_readwrite(\"entries20x3\", &CompressedChunkDelta3::entries20x3)\n        .def_readwrite(\"M\", &CompressedChunkDelta3::M)\n        .def_readwrite(\"K\", &CompressedChunkDelta3::K)\n        .def_readwrite(\n            \"num_exceptions\", &CompressedChunkDelta3::num_exceptions)\n        .def_property_readonly(\"nbytes\", &CompressedChunkDelta3::nbytes)\n        .def_property_readonly(\n            \"frozen_hbm_bytes\", &CompressedChunkDelta3::frozen_hbm_bytes)\n        .def_property_readonly(\n            \"frozen_transfer_bytes\",\n            &CompressedChunkDelta3::frozen_transfer_bytes);\n\n    module.def(\n        \"decompress_chunk_delta3\", &decompress_chunk_delta3,\n        pybind11::arg(\"compressed\"), pybind11::arg(\"output\"));\n    module.def(\n        \"host_encode_chunk_delta3_blocks\",\n        &host_encode_chunk_delta3_blocks,\n        pybind11::arg(\"source\"), pybind11::arg(\"block_ids\"),\n        pybind11::arg(\"slots\"), pybind11::arg(\"codes\"),\n        pybind11::arg(\"sign_mantissa\"),\n        pybind11::arg(\"thread_bases\"),\n        pybind11::arg(\"tile_exception_offsets\"),\n        pybind11::arg(\"entries20x3\"),\n        pybind11::arg(\"num_exceptions\"), pybind11::arg(\"rows\"),\n        pybind11::arg(\"columns\"),\n        \"CPU OpenMP ChunkDelta3 encode from selected raw host blocks \"\n        \"directly into persistent destination slots.\");\n    module.def(\n        \"decompress_chunk_delta3_batched_blob_pair_stream\",\n        &decompress_chunk_delta3_batched_blob_pair_stream,\n        pybind11::arg(\"k_blob\"), pybind11::arg(\"v_blob\"),\n        pybind11::arg(\"slots\"), pybind11::arg(\"output_blocks\"),\n        pybind11::arg(\"k_output\"), pybind11::arg(\"v_output\"),\n        pybind11::arg(\"packed_capacity\"), pybind11::arg(\"stream_handle\"));\n}\n\"\"\"Lossless BF16 ChunkDelta3 compressor.\n\nChunkDelta3 stores the sign and mantissa byte verbatim.  Codes remain in\n16-value row chunks inside a 64x64 tile; an experimental row-group setting can\nshare one 8-bit exponent base across 1, 16, 32, or 64 such chunks with the same\ncolumn range.  Exponent deltas use three bits.  Values outside the local range\nare restored from tile-local 20-bit ``(exponent8, position12)`` exceptions,\npacked three per aligned 64-bit word, making the codec bit exact.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\n_BASE_ROWS = int(os.getenv(\"TIERED_SERVE_CD3_BASE_ROWS\", \"1\"))\nif _BASE_ROWS not in (1, 16, 32, 64):\n    raise ValueError(\n        \"TIERED_SERVE_CD3_BASE_ROWS must be 1, 16, 32, or 64\")\n\ntry:\n    from tiered_serve.cpp_exts import chunk_delta3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load chunk_delta3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            