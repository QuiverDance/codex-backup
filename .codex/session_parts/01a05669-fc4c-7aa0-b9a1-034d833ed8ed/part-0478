             \"CD3_DECODE_THREADS must be one of 64,128,256\");\nconstexpr int kElementsPerThread = 16;\nconstexpr int kCodeBytesPerTile = kTileElements * 3 / 8;\n\n__device__ __forceinline__ uint64_t load_code_word(\n    const uint8_t* codes,\n    int tile,\n    int thread)\n{\n    const int64_t base =\n        static_cast<int64_t>(tile) * kCodeBytesPerTile\n        + static_cast<int64_t>(thread) * 6;\n    // A 64x64 tile is exactly 1536 bytes.  Align each 6-byte chunk down to a\n    // 4-byte boundary and fetch two words: even the last chunk (base=1530)\n    // reads only bytes 1528..1535, so this never crosses the tile boundary.\n    const int64_t aligned_base = base & ~int64_t{3};\n    const uint32_t word0 = *reinterpret_cast<const uint32_t*>(\n        codes + aligned_base);\n    const uint32_t word1 = *reinterpret_cast<const uint32_t*>(\n        codes + aligned_base + 4);\n    return (static_cast<uint64_t>(word0)\n            | (static_cast<uint64_t>(word1) << 32))\n        >> ((base & 3) * 8);\n}\n\n__device__ __forceinline__ uint16_t compose_bf16(\n    uint8_t exponent,\n    uint8_t sign_mantissa)\n{\n    return (static_cast<uint16_t>(sign_mantissa & 0x80u) << 8)\n        | (static_cast<uint16_t>(exponent) << 7)\n        | static_cast<uint16_t>(sign_mantissa & 0x7fu);\n}\n\n__device__ __forceinline__ uint8_t sign_mantissa_byte(\n    const uint4& packed,\n    int item)\n{\n    uint32_t word;\n    switch (item >> 2) {\n        case 0: word = packed.x; break;\n        case 1: word = packed.y; break;\n        case 2: word = packed.z; break;\n        default: word = packed.w; break;\n    }\n    return static_cast<uint8_t>(word >> ((item & 3) * 8));\n}\n\n__device__ __forceinline__ void append_output(\n    uint16_t value,\n    int item,\n    uint64_t& output0,\n    uint64_t& output1,\n    uint64_t& output2,\n    uint64_t& output3)\n{\n    const int lane = item & 3;\n    if (item < 4) {\n        output0 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else if 