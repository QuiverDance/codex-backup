 __restrict__ block_tile_exception_offsets,\n#include <torch/extension.h>\n#include <c10/cuda/CUDAGuard.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cuda_runtime.h>\n\n#include <algorithm>\n#include <cstdint>\n#include <cstring>\n#include <utility>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#include <arm_sve.h>\n#endif\n\nnamespace py = pybind11;\n\nextern \"C\" cudaError_t CD3_Decompress(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const int32_t*, const uint64_t*, uint16_t*, int, int);\nextern \"C\" cudaError_t CD3_DecompressBatchedBlobPair(\n    cudaStream_t, const uint8_t*, const uint8_t*, int, int, int, int, int,\n    const int32_t*, const int64_t*, uint16_t*, uint16_t*, int, int, int, int,\n    int);\n\nnamespace {\n\nconstexpr int kTileDim = 64;\nconstexpr int kTileElements = kTileDim * kTileDim;\nconstexpr int kThreads = 256;\n#ifndef CD3_BASE_ROWS\n#define CD3_BASE_ROWS 1\n#endif\nconstexpr int kBaseRows = CD3_BASE_ROWS;\nstatic_assert(kBaseRows == 1 || kBaseRows == 16 || kBaseRows == 32\n              || kBaseRows == 64,\n              \"CD3_BASE_ROWS must be one of 1,16,32,64\");\nconstexpr int kBasesPerTile = kThreads / kBaseRows;\nconstexpr int kCodeBytesPerTile = kTileElements * 3 / 8;\n\n#if defined(__aarch64__)\ninline uint64_t pack_3bit_codes_neon(uint8x16_t codes)\n{\n    // 16 x 3-bit lanes -> 8 x 6-bit -> 4 x 12-bit -> 2 x 24-bit.\n    const uint8x8_t even_codes = vget_low_u8(vuzp1q_u8(codes, codes));\n    const uint8x8_t odd_codes = vget_low_u8(vuzp2q_u8(codes, codes));\n    const uint8x8_t pairs6 = vorr_u8(\n        even_codes, vshl_n_u8(odd_codes, 3));\n\n    const uint16x8_t pairs6_wide = vmovl_u8(pairs6);\n    const uint16x4_t even_pairs = vget_low_u16(\n        vuzp1q_u16(pairs6_wide, pairs6_wide));\n    const uint16x4_t odd_pairs = vget_low_u16(\n        vuzp2q_u16(pairs6_wide, pairs6_wide));\n    const uint16x4_t groups12 = vorr_u16(\n        even_pairs, vshl_n_u16(odd_pairs, 6));\n\n    const uint32