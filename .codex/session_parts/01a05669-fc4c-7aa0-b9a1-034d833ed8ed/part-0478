\", columns, \"]\");\n}\n\nstruct CompressedChunkDelta3 {\n    torch::Tensor codes;\n    torch::Tensor sign_mantissa;\n    torch::Tensor thread_bases;\n    torch::Tensor tile_exception_offsets;\n    torch::Tensor entries20x3;\n    int64_t M = 0;\n    int64_t K = 0;\n    int64_t num_exceptions = 0;\n\n    int64_t nbytes() const\n    {\n        return tensor_bytes(codes)\n            + tensor_bytes(sign_mantissa)\n            + tensor_bytes(thread_bases)\n            + tensor_bytes(tile_exception_offsets)\n            + tensor_bytes(entries20x3);\n    }\n\n    int64_t frozen_hbm_bytes() const\n    {\n        return tensor_bytes(sign_mantissa)\n            + tensor_bytes(tile_exception_offsets);\n    }\n\n    int64_t frozen_transfer_bytes() const\n    {\n        return tensor_bytes(codes)\n            + tensor_bytes(thread_bases)\n            + tensor_bytes(entries20x3);\n    }\n};\n\nvoid check_chunk_delta3(const CompressedChunkDelta3& compressed)\n{\n    TORCH_CHECK(\n        compressed.M > 0 && compressed.K > 0\n            && compressed.M % kTileDim == 0\n            && compressed.K % kTileDim == 0,\n        \"invalid ChunkDelta3 shape\");\n    const int64_t num_tiles =\n        (compressed.M / kTileDim) * (compressed.K / kTileDim);\n    check_byte(compressed.codes, \"codes\");\n    check_byte(compressed.sign_mantissa, \"sign_mantissa\");\n    check_byte(compressed.thread_bases, \"thread_bases\");\n    check_int(compressed.tile_exception_offsets, \"tile_exception_offsets\");\n    check_long(compressed.entries20x3, \"entries20x3\");\n    TORCH_CHECK(compressed.codes.numel() == num_tiles * kCodeBytesPerTile,\n                \"invalid code size\");\n    TORCH_CHECK(compressed.sign_mantissa.numel() == compressed.M * compressed.K,\n                \"invalid sign/mantissa size\");\n    TORCH_CHECK(compressed.thread_bases.numel() == num_tiles * kBasesPerTile,\n                \"invalid thread-base size\");\n    TORCH_CHECK(compressed.tile_exception_offsets.numel() == num_tiles + 1,\n                \"invalid exception offset size\");\n    TORCH_CHECK(\n        compressed.entries20x3.numel()\n            == (compressed.num_exceptions + 2) / 3,\n        \"invalid exception entry size\");\n}\n\ntorch::Tensor decompress_chunk_delta3(\n    const CompressedChunkDelta3& compressed,\n    torch::Tensor output)\n{\n    check_chunk_delta3(compressed);\n    check_output(output, compressed.M, compressed.K);\n    const c10::cuda::CUDAGuard device_guard(output.device());\n    const int64_t num_tiles =\n        (compressed.M / kTileDim) * (compressed.K / kTileDim);\n    check_cuda_error(\n        CD3_Decompress(\n            current_stream(),\n            compressed.codes.data_ptr<uint8_t>(),\n            compressed.sign_mantissa.data_ptr<uint8_t>(),\n            compressed.thread_bases.data_ptr<uint8_t>(),\n            compressed.tile_exception_offsets.data_ptr<int32_t>(),\n            reinterpret_cast<const uint64_t*>(\n                compressed.entries20x3.data_ptr<int64_t>()),\n            reinterpret_cast<uint16_t*>(output.data_ptr()),\n            static_cast<int>(num_tiles), static_cast<int>(compressed.K)),\n        \"CD3_Decompress\");\n    return output;\n}\n\nvoid host_encode_chunk_delta3_blocks(\n    torch::Tensor source,\n    torch::Tensor block_ids,\n    torch::Tensor slots,\n    torch::Tensor codes,\n    torch::Tensor sign_mantissa,\n    torch::Tensor thread_bases,\n    torch::Tensor tile_exception_offsets,\n    torch::Tensor entries20x3,\n    torch::Tensor num_exceptions,\n    int64_t rows,\n    int64_t columns)\n{\n    TORCH_CHECK(!source.is_cuda() && source.is_contiguous()\n                    && source.scalar_type() == at::kShort,\n                \"source must be contiguous CPU int16 BF16 storage\");\n    TORCH_CHECK(!block_ids.is_cuda() && block_ids.is_contiguous()\n                    && block_ids.dim() == 1\n                    && block_ids.scalar_type() == at::kLong,\n                \"block_ids must be contiguous CPU int64