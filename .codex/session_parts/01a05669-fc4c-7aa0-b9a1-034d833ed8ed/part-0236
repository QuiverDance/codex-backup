const int64_t nt = (int64_t)(vr / G) * ntk;\n        const uint8_t* hdr = b;                          // headers (16/tile)\n        const uint8_t* codes = b + nt * 16;\n        const uint8_t* sm = codes + (int64_t)vr * K_b / 2;\n        const uint8_t* subt = sm + (int64_t)vr * K_b;\n        for (int64_t tm = 0; tm < vr / G; ++tm)\n            for (int64_t tk = 0; tk < ntk; ++tk) {\n                const int64_t ti = tm * ntk + tk;\n                const uint8_t* pal = hdr + ti * 16;\n                const uint8_t* tc = codes + ti * (G * G / 2);\n                for (int r = 0; r < G; ++r)\n                    for (int c = 0; c < G; ++c) {\n                        int bk = c / BK, kib = c & (BK - 1);\n                        uint8_t byte = tc[bk * (G * BK / 2) + r * (BK / 2)\n                                          + (kib >> 1)];\n                        uint8_t code = (kib & 1) ? (byte >> 4) : (byte & 0xF);\n                        int64_t gidx = (tm * G + r) * K_b + (tk * G + c);\n                        uint8_t smv = rsm\n                            ? sm[gidx]\n                            : sm[ti * (G * G) + bk * (G * BK) + r * BK + kib];\n                        uint8_t marker = subt[ti * 16 + (r >> 4) * 4 + (c >> 4)];\n                        uint8_t exp = (marker != 0xFF)\n                            ? (uint8_t)(marker + code) : pal[code];\n                        o[gidx] = (uint16_t)(((smv & 0x80u) << 8)\n                                  | ((uint16_t)exp << 7) | (smv & 0x7fu));\n                    }\n            }\n        const int cnt = ec_p[i];\n        if (cnt) {\n            const int64_t cdb = (int64_t)(vr / 16) * (K_b / 16);\n            const int64_t fixed = nt * 16 + (int64_t)vr * K_b / 2\n                                  + (int64_t)vr * K_b + cdb;\n            const uint32_t* ei = reinterpret_cast<const uint32_t*>(b + fixed);\n            const uint16_t* ev =\n                reinterpret_cast<const uint16_t*>(b + fixed + (int64_t)cnt * 4);\n    