eadline=$((SECONDS + CLEANUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ! capture_clean_state; do\n    if ((SECONDS >= deadline)); then\n      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n      next_report=$((SECONDS + 15))\n    fi\n    sleep 2\n  done\n  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n}\n\nCURRENT_PGID=\"\"\nterminate_current_group() {\n  [[ -n \"$CURRENT_PGID\" ]] || return 0\n  if kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null; then\n    echo \"[suite] stopping only the active run process group ${CURRENT_PGID}\" >&2\n    kill -TERM -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    local deadline=$((SECONDS + 10))\n    while kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null && ((SECONDS < deadline)); do\n      sleep 1\n    done\n    if kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null; then\n      kill -KILL -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    fi\n  fi\n}\n\nhandle_signal() {\n  local signal=\"$1\"\n  terminate_current_group\n  [[ \"$signal\" == INT ]] && exit 130\n  exit 143\n}\n\ntrap 'handle_signal INT' INT\ntrap 'handle_signal TERM' TERM\ntrap 'terminate_current_group' EXIT\n\npreflight_files\n\nif ((CHECK_ONLY)); then\n  wait_for_clean_state \"suite preflight\" || exit 1\n  echo \"[suite] PASS: configs, dependencies, and resources are ready\"\n  exit 0\nfi\n\nif ((DRY_RUN)); then\n  echo \"[suite] dry-run: ${#METHODS[@]} methods x ${REPEATS} repeat(s)\"\n  for ((round = 1; round <= REPEATS; round++)); do\n    if ((round % 2 == 1)); then\n      order=(\"${METHODS[@]}\")\n    else\n      order=()\n      for ((idx = ${#METHODS[@]} - 1; idx >= 0; idx--)); do\n        order+=(\"${METHODS[idx]}\")\n      done\n    fi\n    for method in \"${order[@]}\"; do\n      build_command \"$