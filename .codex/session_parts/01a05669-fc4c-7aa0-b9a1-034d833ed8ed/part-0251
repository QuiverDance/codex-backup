d3-fused\n  cao-cd3-fused-kvcomp\n)\n\nusage() {\n  cat <<'EOF'\nUsage: bash scripts/offline/run_performance_suite.sh [OPTIONS]\n\nRuns all eight offline performance configurations. Every configuration and\nrepeat starts a fresh Python process. The next run starts only after the GPU,\n16 GiB HugePages, and tiered-serve processes return to an idle state.\n\nOptions:\n  --methods LIST          Comma/space-separated method IDs (default: all)\n  --batches LIST          Comma/space-separated batches (default: 1,16,32,64,96,128)\n  --repeats N             Fresh-process repeats per method (default: 3)\n  --input-seq-len N       Random input tokens per request (default: 1020)\n  --gen N                 Tokens generated per request (default: 129)\n  --warmup N              Initial TPOT samples excluded (default: 16)\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\n  --kv-backend NAME       KV codec for the two kvcomp cells (default: p4flat)\n  --gpu-index N           Physical GPU used and checked (default: 0)\n  --numa-node N           NUMA memory node (default: 0)\n  --weight-huge-pages N   16 GiB pages assigned to weights (default: 14)\n  --max-idle-hbm-mib N    Maximum clean-state HBM use (default: 1024)\n  --cleanup-timeout SEC   Wait for clean state between runs (default: 120)\n  --output-root DIR       Suite logs/manifests directory\n  --start-from METHOD     Start at METHOD and run the remaining methods\n  --check-only            Run resource/config preflight and exit\n  --dry-run               Validate mappings and print commands only\n  -h, --help              Show this help\n\nExamples:\n  bash scripts/offline/run_performance_suite.sh\n  bash scripts/offline/run_performance_suite.sh --methods cao-cd3-fused,cao-p4flat-fused\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --batches 16,64,128\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --start-from flexgen-zipserv\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --dry-run\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nrequire_uint() {\n  local option=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${option} requires a non-negative integer: ${value}\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --methods)\n      (($# >= 2)) || die \"--methods requires a value\"\n      method_spec=\"${2//,/ }\"\n      read -r -a METHODS <<<\"${method_spec}\"\n      shift 2\n      ;;\n    --batches)\n      (($# >= 2)) || die \"--batches requires a value\"\n      batch_spec=\"${2//,/ }\"\n      read -r -a BATCHES <<<\"${batch_spec}\"\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --input-seq-len)\n      (($# >= 2)) || die \"--input-seq-len requires a value\"\n      INPUT_SEQ_LEN=\"$2\"\n      shift 2\n      ;;\n    --gen)\n      (($# >= 2)) || die \"--gen requires a value\"\n      GEN_TOKENS=\"$2\"\n      shift 2\n      ;;\n    --warmup)\n      (($# >= 2)) || die \"--warmup requires a value\"\n      WARMUP=\"$2\"\n      shift 2\n      ;;\n    --prefill-chunk)\n      (($# >= 2)) || die \"--prefill-chunk requires a value\"\n      PREFILL_CHUNK=\"$2\"\n      shift 2\n      shift 2\n      ;;\n    --kv-backend)\n      (($# >= 2)) || die \"--kv-backend requires a value\"\n      KV_BACKEND=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --start-from)\n      (($# >= 2)) || die \"--start-from requires a value\"\n      START_FROM=\"$2\"\n      shift 2\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_uint --repeats \"$REPEATS\"\nrequire_uint --input-seq-len \"$INPUT_SEQ_LEN\"\nrequire_uint --gen \"$GEN_TOKENS\"\nrequire_uint --warmup \"$WARMUP\"\nrequire_uint --prefill-chunk \"$PREFILL_CHUNK\"\nrequire_uint --gpu-index \"$GPU_INDEX\"\nrequire_uint --numa-node \"$NUMA_NODE\"\nrequire_uint --weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_uint --max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\nrequire_uint --cleanup-timeout \"$CLEANUP_TIMEOUT\"\n((REPEATS > 0)) || die \"--repeats must be greater than zero\"\n((INPUT_SEQ_LEN > 0)) || die \"--input-seq-len must be greater than zero\"\n((GEN_TOKENS > 0)) || die \"--gen must be greater than zero\"\n((PREFILL_CHUNK > 0)) || die \"--prefill-chunk must be greater than zero\"\n((CLEANUP_TIMEOUT > 0)) || die \"--cleanup-timeout must be greater than zero\"\n((${#BATCHES[@]} > 0)) || die \"--batches must not be empty\"\nfor batch in \"${BATCHES[@]}\"; do\n  require_uint --batches \"$batch\"\n  ((batch > 0)) || die \"batch sizes must be greater than zero\"\ndone\n\ncase \"$KV_BACKEND\" in\n  zipserv|dietgpu|mantexp|p4flat|p4flatcpu|ublb_flat|chunk_delta3) ;;\n  *) die \"unsupported --kv-backend: ${KV_BACKEND}\" ;;\nesac\n\nif [[ -n \"$START_FROM\" ]]; then\n  selected_methods=()\n  found_start=0\n  for method in \"${METHODS[@]}\"; do\n    if [[ \"$method\" == \"$START_FROM\" ]]; then\n      found_start=1\n    fi\n    if ((found_start)); then\n      selected_methods+=(\"$method\")\n    fi\n  done\n  ((found_start)) || die \"unknown --start-from method: ${START_FROM}\"\n  METHODS=(\"${selected_methods[@]}\")\nfi\n\nMODEL_OWNER=\"${MODEL%%/*}\"\nMODEL_NAME=\"${MODEL##*/}\"\nCONFIG_ROOT=\"${REPO_ROOT}/tiered_serve/model_configs/${MODEL_OWNER}/${MODEL_NAME}\"\n\n# Sets METHOD_LABEL, CONFIG_STEM, EXPECTED_CODEC, METHOD_ENV, and FEATURE_ARGS.\nbuild_method() {\n  local method=\"$1\"\n  FEATURE_ARGS=()\n  METHOD_ENV=()\n  EXPECTED_CODEC=\"\"\n  case \"$method\" in\n    flexgen)\n      METHOD_LABEL=\"FlexGen\"\n      CONFIG_STEM=\"flexgen\"\n      ;;\n    flexgen-zipserv)\n      METHOD_LABEL=\"FlexGen(w/ zipserv)\"\n      # Fused-MM is a CLI feature. This YAML is the current ZipServ\n      # offload_compressed placement and is valid with or without the flag.\n      # flexgen-comp.yaml cannot be used here: it is currently P4Flat.\n      CONFIG_STEM=\"flexgen-comp-fused\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv)\n      ;;\n    flexgen-zipserv-fused)\n      METHOD_LABEL=\"FlexGen-fused(w/ zipserv)\"\n      CONFIG_STEM=\"flexgen-comp-fused\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv --fused-mm)\n      ;;\n    cao-zipserv)\n      METHOD_LABEL=\"C.A.O(w/ zipserv)\"\n      CONFIG_STEM=\"cao-zs\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv)\n      ;;\n    cao-zipserv-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ zipserv)\"\n      CONFIG_STEM=\"cao-zs-fused\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv --fused-mm)\n      ;;\n    cao-zipserv-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ zipserv)-kvcomp\"\n      CONFIG_STEM=\"cao-zs-kvcomp\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    cao-p4flat-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)\"\n      CONFIG_STEM=\"cao-p4-fused\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm)\n      ;;\n    cao-p4flat-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)-kvcomp\"\n      CONFIG_STEM=\"cao-p4-kvcomp\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    cao-cd3-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ CD3)\"\n      CONFIG_STEM=\"cao-cd3-fused\"\n      EXPECTED_CODEC=\"chunk_delta3\"\n      METHOD_ENV=(\"TIERED_SERVE_CD3_FUSED_MAX_N=128\")\n      FEATURE_ARGS=(--weight-comp chunk_delta3 --fused-mm)\n      ;;\n    cao-cd3-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ CD3)-kvcomp\"\n      CONFIG_STEM=\"cao-cd3-fused\"\n      EXPECTED_CODEC=\"chunk_delta3\"\n      METHOD_ENV=(\"TIERED_SERVE_CD3_FUSED_MAX_N=128\")\n      FEATURE_ARGS=(--weight-comp chunk_delta3 --fused-mm\n                    --kv-comp chunk_delta3)\n      ;;\n    *)\n      die \"internal error: unknown method ${method}\"\n      ;;\n  esac\n  CONFIG_PATH=\"${CONFIG_ROOT}/${CONFIG_STEM}.yaml\"\n}\n\npreflight_files() {\n  [[ -x \"$PYTHON\" ]] || die \"Python not found: ${PYTHON}\"\n  [[ -f \"$DRIVER\" ]] || die \"offline driver not found: ${DRIVER}\"\n  [[ -f \"$STACK_POOL\" ]] || die \"stack-pool preload library not found: ${STACK_POOL}\"\n  command -v numactl >/dev/null || die \"numactl is required\"\n  command -v setsid >/dev/null || die \"setsid is required\"\n  command -v nvidia-smi >/dev/null || die \"nvidia-smi is required\"\n  command -v findmnt >/dev/null || die \"findmnt is required\"\n\n  local method\n  for method in \"${METHODS[@]}\"; do\n    build_method \"$method\"\n    [[ -f \"$CONFIG_PATH\" ]] || die \"config not found: ${CONFIG_PATH}\"\n    if [[ -n \"$EXPECTED_CODEC\" ]] &&\n       ! grep -q \"compressor: ${EXPECTED_CODEC}\" \"$CONFIG_PATH\"; then\n      die \"${method}: ${CONFIG_PATH} does not declare ${EXPECTED_CODEC}\"\n    fi\n  done\n}\n\n# Clear every inherited tiered-serve knob. Each child receives only the common\n# values below and the flags selected by build_method().\nENV_PREFIX=(env)\nwhile IFS='=' read -r env_name _; do\n  if [[ \"$env_name\" == TIERED_SERVE_* ]]; then\n    ENV_PREFIX+=(-u \"$env_name\")\n  fi\ndone < <(env)\nENV_PREFIX+=(\n  \"PYTHONHASHSEED=0\"\n  \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n  \"LD_PRELOAD=${STACK_POOL}\"\n  \"VLLM_DISABLE_COMPILE_CACHE=1\"\n  \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n  \"TIERED_SERVE_N_WEIGHT_BUFFERS=2\"\n)\n\nbuild_command() {\n  local method=\"$1\"\n  build_method \"$method\"\n  CMD=(\n    \"${ENV_PREFIX[@]}\"\n    \"${METHOD_ENV[@]}\"\n    numactl -m \"$NUMA_NODE\"\n    \"$PYTHON\" \"$DRIVER\"\n    --model \"$MODEL\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --tensor-parallel-size 1\n    --block-size 16\n    --no-enable-prefix-caching\n    --batch \"${BATCHES[@]}\"\n    --inputseqlen \"$INPUT_SEQ_LEN\"\n    --gen \"$GEN_TOKENS\"\n    --fixed-generation-length\n    --prefill-chunk \"$PREFILL_CHUNK\"\n    --warmup \"$WARMUP\"\n    --ts-configs \"$CONFIG_PATH\"\n    \"${FEATURE_ARGS[@]}\"\n  )\n}\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+