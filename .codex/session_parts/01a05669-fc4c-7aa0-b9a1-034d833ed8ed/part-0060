{"timestamp":"2026-08-31T07:51:01.562Z","ordinal":2526,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a056cc-dcba-79e3-b638-da2f69b3fda7","call_id":"call_73FrcFKtMfaAlgzITDyAHwIz","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    if hasattr(comp, \"num_exceptions\"):\n        return int(comp.num_exceptions)\n    target = getattr(comp, \"_c\", comp)\n    for attr in (\"exc_indices\", \"exc_idx\"):\n        value = getattr(target, attr, None)\n        if torch.is_tensor(value):\n            return int(value.numel())\n    return 0\n\n\ndef production_fused_threshold(codec_name, codec, M, K) -> int:\n    if codec_name == \"zipserv\":\n        from tiered_serve.compression.core.zipserv import ZipServCompressor\n        return int(ZipServCompressor._N_THRESHOLD_TABLE.get((M, K), 96))\n    if codec_name == \"p4flat\":\n        return int(codec._FUSED_MAX_N_TABLE.get((M, K), 128))\n    return int(codec._fused_max_n_for(M, K))\n\n\n# ── ATS / Grace-Hopper C2C split placement ───────────────────────────────────\n# With --ats the fused GEMM is measured a SECOND time with the codec's\n# compressed-exponent stream (palette + 4-bit codes + exception lists) relocated\n# to Grace LPDDR, while the raw sign|mantissa byte stream stays in HBM.  On a\n# GH200 (Addressing Mode: ATS) the fused decode+GEMM kernel then reads the\n# exponent payload straight from LPDDR over the NVLink-C2C link into the SMs —\n# no HBM staging copy.  This mirrors the \"Exp ATS\" placement of\n# ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py\n# (HugepagePool + device-pointer \"DHA\" tensors) and cpu_hbm_test.py's\n# numa_alloc_onnode + cudaHostRegister C2C path.\n#\n# Per-codec split: keep the mantissa attr in HBM, move every other compressed\n# buffer the fused kernel reads to ATS.  target_fn locates the object whose\n# attrs the kernel reads (the native struct for p4flat, the wrapper otherwise).\n_ATS_PLAN = {\n    \"p4flat\":    (lambda comp: comp._c, \"sign_mantissa\",\n                  (\"codes\", \"headers\", \"subtile_codec\",\n                   \"exc_indices\", \"exc_values\")),\n    \"ublb_flat\": (lambda comp: comp, \"lb_raw\",\n                  (\"code_stream\", \"palette\", \"exc_idx\", \"exc_ub\")),\n    \"zipserv\":   (lambda comp: comp, \"sign_mantissa\",\n                  (\"compressed_full\", \"bitmap1\", \"bitmap2\", \"bitmap3\",\n                   \"tile_offsets_median\", \"tile_offsets_global\")),\n    \"chunk_delta3\": (lambda comp: comp._c, \"sign_mantissa\",\n                     (\"codes\", \"thread_bases\", \"entries20x3\")),\n}\n\n_DHA_EXT = None\n\n\ndef _get_dha_ext():\n    \"\"\"JIT ext wrapping a raw CUDA device pointer as a (no-op-deleter) Tensor.\n\n    Lifted verbatim from ats-benchmarks' nvcomp_h2d_vs_ats._get_dha_ext: builds\n    a CUDA at::Tensor over an externally-owned device pointer so a hugepage /\n    NUMA LPDDR region (mapped to the GPU via cudaHostGetDevicePointer) can be\n    handed to the codec kernels exactly like an HBM tensor (.is_cuda == True).\n    \"\"\"\n    global _DHA_EXT\n    if _DHA_EXT is not None:\n        return _DHA_EXT\n    from torch.utils.cpp_extension import load_inline\n\"\"\"Correctness coverage for the production ChunkDelta3 adapter.\"\"\"\nfrom __future__ import annotations\n\nimport pytest\nimport torch\nimport torch.nn.functional as F\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"ChunkDelta3 requires CUDA\")\n\n\ndef _codec():\n    from tiered_serve.compression.core.chunk_delta3 import ChunkDelta3Compressor\n    return ChunkDelta3Compressor(torch.cuda.current_stream())\n\n\ndef _all_bf16_patterns() -> torch.Tensor:\n    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    # Transpose so each 16-value CD3 chunk spans many exponents.  A plain\n    # reshape groups equal exponents and never exercises the exception stream.\n    return (bits.view(torch.bfloat16).reshape(256, 256).t().contiguous()\n            .cuda())\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_serving_fused_threshold_override(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\ndef test_frozen_split_keeps_offsets_with_sign_mantissa_in_hbm() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False