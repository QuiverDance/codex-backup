\n       ! grep -q \"compressor: ${EXPECTED_CODEC}\" \"$CONFIG_PATH\"; then\n      die \"${method}: ${CONFIG_PATH} does not declare ${EXPECTED_CODEC}\"\n    fi\n  done\n}\n\n# Clear every inherited tiered-serve knob. Each child receives only the common\n# values below and the flags selected by build_method().\nENV_PREFIX=(env)\nwhile IFS='=' read -r env_name _; do\n  if [[ \"$env_name\" == TIERED_SERVE_* ]]; then\n    ENV_PREFIX+=(-u \"$env_name\")\n  fi\ndone < <(env)\nENV_PREFIX+=(\n  \"PYTHONHASHSEED=0\"\n  \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n  \"LD_PRELOAD=${STACK_POOL}\"\n  \"VLLM_DISABLE_COMPILE_CACHE=1\"\n  \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n  \"TIERED_SERVE_N_WEIGHT_BUFFERS=2\"\n)\n\nbuild_command() {\n  local method=\"$1\"\n  local -a timing_args=()\n  build_method \"$method\"\n  if ((BREAKDOWN)); then\n    timing_args=(--time-breakdown)\n  fi\n  CMD=(\n    \"${ENV_PREFIX[@]}\"\n    \"${METHOD_ENV[@]}\"\n    numactl -m \"$NUMA_NODE\"\n    \"$PYTHON\" \"$DRIVER\"\n    --model \"$MODEL\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --block-size 16\n    --no-enable-prefix-caching\n    --batch \"${BATCHES[@]}\"\n    --inputseqlen \"$INPUT_SEQ_LEN\"\n    --gen \"$GEN_TOKENS\"\n    --fixed-generation-length\n    --prefill-chunk \"$PREFILL_CHUNK\"\n    --warmup \"$WARMUP\"\n    --ts-configs \"$CONFIG_PATH\"\n    \"${FEATURE_ARGS[@]}\"\n    \"${timing_args[@]}\"\n  )\n}\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type\n  local -a problems=()\n\n  offenders=\"$(active_tier