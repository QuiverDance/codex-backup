.done = True\n        with self._pin_lock:\n            index = self._pin_counter % self._n_workers\n            self._pin_counter += 1\n        self._pin_tls.index = index\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_dynamic(0)\n        if self._pin_workers:\n            compression_cpus = [\n                cpu for cpu in allowed if cpu >= self._reserve_cores]\n            if len(compression_cpus) < self._n_workers:\n                compression_cpus = allowed\n            usable = compression_cpus[:min(\n                len(compression_cpus),\n                self._n_workers * self._omp_thread_cap)]\n            begin = len(usable) * index // self._n_workers\n            end = len(usable) * (index + 1) // self._n_workers\n            affinity = set(usable[begin:end])\n            if not affinity:\n                affinity = {allowed[index % len(allowed)]}\n            try:\n                os.sched_setaffinity(0, affinity)\n            except OSError as error:\n                logger.warning(\n                    \"CD3 compress worker %d affinity failed: %s\",\n                    index, error)\n        else:\n            affinity = set(allowed)\n        omp_threads = min(len(affinity), self._omp_thread_cap)\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(omp_threads))\n        ordered = tuple(sorted(affinity))\n        with self._pin_lock:\n            self._worker_affinities[index] = ordered\n            self._worker_omp_threads[index] = omp_threads\n        logger.info(\n            \"CD3 compress worker %d -> %d CPUs (%d-%d), OMP=%d\",\n            index, len(ordered), ordered[0], ordered[-1], omp_threads)\n\n    def compress_batch_async(self, layer_id: int, block_ids: list,\n                             gpu_k: torch.Tensor,\n                             gpu_v: torch.Tensor) -> None:\n        raise NotImplementedError(\n            \"ChunkDelta3CPUKVCompressor uses cpu_after_raw_swap; \"\n            \"select gpu_direct explicitly for GPU encoding\")\n\n    def _assign_kv_slots(self, layer_id: int,\n                         block_ids: np.ndarray) -> np.ndarray:\n        # Match P4Flat's batched fast path.  The old list comprehension called\n        # into Python once per block and dominated the large-N microbenchmark\n        # even though the native CD3 encoder itself was already competitive.\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_table = self._kv_slot_np[layer_id]\n        previous = slot_table[bid_arr]\n        new_mask = previous < 0\n        if not bool(new_mask.any()):\n            return np.ascontiguousarray(previous, dtype=np.int64)\n\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot_blocks = self._kv_slot_block[layer_id]\n        capacity = len(slot_blocks)\n        high_water = self._kv_active_count[layer_id]\n        new_block_ids = bid_arr[new_mask].tolist()\n        new_slots = []\n        for _ in new_block_ids:\n            slot = -1\n            while heap:\n                candidate = heapq.heappop(heap)\n                if candidate in free_set:\n                    free_set.discard(candidate)\n                    slot = candidate\n                    break\n            if slot < 0:\n                if high_water >= capacity:\n                    raise RuntimeError(\n                        \"ChunkDelta3 KV persistent slot pool full for \"\n                        f\"layer={layer_id}\")\n                slot = high_water\n                high_water += 1\n            new_slots.append(slot)\n\n        new_slots_array = np.asarray(new_slots, dtype=np.int64)\n        slot_table[bid_arr[new_mask]] = new_slots_array\n        result = previous.copy()\n        result[new_mask] = new_slots_array\n        for block_id, slot in zip(new_block_ids, new_slots):\n            slot_blocks[slot] = block_id\n        self._kv_active_count[layer_id] = high_water\n        return np.ascontiguousarray(result, dtype=np.int64)\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        free_set = self._kv_free_slots[layer_id]\n        high_water = self._kv_active_count[layer_id]\n        if slot == high_water - 1:\n            high_water -= 1\n            while high_water - 1 in free_set:\n                free_set.discard(high_water - 1)\n                high_water -= 1\n            self._kv_active_count[layer_id] = high_water\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get(\"buffer_ids\", ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64))\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_table = self._kv_slot_np.get(layer_id)\n                if slot_table is None or not 0 <= block_id < slot_table.size:\n                    return\n                slot = int(slot_table[block_id])\n                if slot < 0:\n                    return\n                slot_table[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n            self._free_kv_slot(layer_id, block_id)\n\n    def compress_batch_async_from_host(\n        self,\n        layer_id: int,\n        block_ids: list,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        wait_event_handle: int = 0,\n    ) -> None:\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        num_source_blocks = host_k.shape[0]\n        block_array = np.asarray(block_ids, dtype=np.int64)\n        if block_array.size:\n            block_array = block_array[\n                (block_array >= 0) & (block_array < num_source_blocks)]\n        if block_array.size == 0:\n            return\n        decode_event_handle = int(\n            self._kv_dec_h2d[layer_id].cuda_event)\n        with self._slot_state_lock:\n            slots = self._assign_kv_slots(layer_id, block_array)\n            valid = self._persistent_valid[layer_id]\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\n            state = self._worker_state_for_layer(layer_id)\n            state[\"error\"] = None\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05b62-7955-71d3-91bb-97ec9505224f","create_time":1788239708.2376158}}}
