rks/benchmarks/compress/python/bf16_split_decompress_ats.py\n# (HugepagePool + device-pointer \"DHA\" tensors) and cpu_hbm_test.py's\n# numa_alloc_onnode + cudaHostRegister C2C path.\n#\n# Per-codec split: keep the mantissa attr in HBM, move every other compressed\n# buffer the fused kernel reads to ATS.  target_fn locates the object whose\n# attrs the kernel reads (the native struct for p4flat, the wrapper otherwise).\n_ATS_PLAN = {\n    \"p4flat\":    (lambda comp: comp._c, \"sign_mantissa\",\n                  (\"codes\", \"headers\", \"subtile_codec\",\n                   \"exc_indices\", \"exc_values\")),\n    \"ublb_flat\": (lambda comp: comp, \"lb_raw\",\n                  (\"code_stream\", \"palette\", \"exc_idx\", \"exc_ub\")),\n    \"zipserv\":   (lambda comp: comp, \"sign_mantissa\",\n                  (\"compressed_full\", \"bitmap1\", \"bitmap2\", \"bitmap3\",\n                   \"tile_offsets_median\", \"tile_offsets_global\")),\n    \"chunk_delta3\": (lambda comp: comp._c, \"sign_mantissa\",\n                     (\"codes\", \"thread_bases\", \"entries20x3\")),\n}\n\n_DHA_EXT = None\n\n\ndef _get_dha_ext():\n    \"\"\"JIT ext wrapping a raw CUDA device pointer as a (no-op-deleter) Tensor.\n\n    Lifted verbatim from ats-benchmarks' nvcomp_h2d_vs_ats._get_dha_ext: builds\n    a CUDA at::Tensor over an externally-owned device pointer so a hugepage /\n    NUMA LPDDR region (mapped to the GPU via cudaHostGetDevicePointer) can be\n    handed to the codec kernels exactly like an HBM tensor (.is_cuda == True).\n    \"\"\"\n    global _DHA_EXT\n    if _DHA_EXT is not None:\n        return _DHA_EXT\n    from torch.utils.cpp_extension import load_inline\n    cpp_src = r\"\"\"\n#include <pybind11/pybind11.h>\n#include <pybind11/stl.h>\n#include <torch/extension.h>\nnamespace py = pybind11;\nat::Tensor dha_allocate(\n    uint64_t ptr, int64_t nbytes,\n    const std::vector<int64_t>& sizes,\n    const std::vector<int64_t>& strides,\n    const at::ScalarType dtype