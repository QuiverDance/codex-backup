onst uint64_t matches = code_word & (code_word >> 1)\n        & (code_word >> 2) & kThreeBitLaneLowBits;\n    return __popcll(matches);\n}\n\n__device__ __forceinline__ int exclusive_scan_tile(\n    int value,\n    int* warp_totals,\n    int* warp_prefixes)\n{\n    const int lane = threadIdx.x & 31;\n    const int warp = threadIdx.x >> 5;\n    int inclusive = value;\n#pragma unroll\n    for (int delta = 1; delta < 32; delta <<= 1) {\n        const int prior = __shfl_up_sync(0xffffffffu, inclusive, delta);\n        if (lane >= delta) {\n            inclusive += prior;\n        }\n    }\n    if (lane == 31) {\n        warp_totals[warp] = inclusive;\n    }\n    __syncthreads();\n\n    if (warp == 0) {\n        int total = lane < kWarpsPerTile ? warp_totals[lane] : 0;\n        const int own = total;\n#pragma unroll\n        for (int delta = 1; delta < 32; delta <<= 1) {\n            const int prior = __shfl_up_sync(0xffffffffu, total, delta);\n            if (lane >= delta) {\n                total += prior;\n            }\n        }\n        if (lane < kWarpsPerTile) {\n            warp_prefixes[lane] = total - own;\n        }\n    }\n    __syncthreads();\n    return warp_prefixes[warp] + inclusive - value;\n}\n\n__device__ __forceinline__ uint8_t exponent_of(uint16_t bits)\n{\n    return static_cast<uint8_t>((bits >> 7) & 0xffu);\n}\n        sign_mantissa_words[item >> 2] |=\n            static_cast<uint32_t>(sign_mantissa_of(values[item]))\n            << ((item & 3) * 8);\n    }\n\n    const int64_t code_base =\n        static_cast<int64_t>(tile) * kCodeBytesPerTile\n        + static_cast<int64_t>(thread) * 6;\n#pragma unroll\n    for (int byte = 0; byte < 6; ++byte) {\n        codes[code_base + byte] =\n            static_cast<uint8_t>(code_word >> (byte * 8));\n    }\n    uint4 packed_sign_mantissa;\n    packed_sign_mantissa.x = sign_mantissa_words[0];\n    packed_sign_mantissa.y = sign_mantissa_words[1];\n    packed_sign_mantissa.z = sign_mantissa_words[2];\n    packed_sign_mantissa.w = sign_mantissa_words[3];\n    *reinterpret_cast<uint4*>(\n        sign_mantissa + static_cast<int64_t>(tile) * kTileElements\n        + thread * kElementsPerThread) = packed_sign_mantissa;\n\n    const int exception_count = kElementsPerThread - best_count;\n    const int rank = exclusive_scan_tile(\n        exception_count, warp_totals, warp_prefixes);\n    if (thread == kThreads - 1) {\n        tile_exception_counts[tile] = rank + exception_count;\n    }\n}\n\n__global__ void BuildTilePalette3EntriesKernel(\n    const uint16_t* __restrict__ source,\n    const uint8_t* __restrict__ codes,\n    const int32_t* __restrict__ tile_exception_offsets,\n    uint16_t* __restrict__ warp_prefixes,\n    uint16_t* __restrict__ positions,\n    uint8_t* __restrict__ exception_exponents,\n    int num_tiles,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    if (tile >= num_tiles) {\n        return;\n    }\n    const int thread = threadIdx.x;\n    const int lane = thread & 31;\n    const int warp = thread >> 5;\n    __shared__ int warp_totals[kWarpsPerTile];\n    __shared__ int tile_warp_prefixes[kWarpsPerTile];\n\n    const uint64_t code_word = load_code_word(codes, tile, thread);\n    const int count = escape_count(code_word);\n    const int thread_rank = exclusive_scan_tile(\n        count, warp_totals, tile_warp_prefixes);\n    if (lane == 0) {\n        warp_prefixes[static_cast<int64_t>(tile) * kWarpsPerTile + warp] =\n            static_cast<uint16_t>(thread_rank);\n    }\n\n    int rank = tile_exception_offsets[tile] + thread_rank;\n    const int warp_local_base = lane * kElementsPerThread;\n    const int64_t source_base = source_base_for_thread(tile, thread, columns);\n#pragma unroll\n    for (int item = 0; item < kElementsPerThread; ++item) {\n        const uint8_t code =\n            static_cast<uint8_t>((code_word >> (item * 3)) & 7u);\n        if (code == kPaletteSize) {\n            positions[rank] =\n                static_cast<uint16_t>(warp_local_base + item);\n            exception_exponents[rank] = exponent_of(source[source_base + item]);\n            ++rank;\n        }\n    }\n}\n\n__global__ void BuildChunkDelta3EntriesKernel(\n    const uint16_t* __restrict__ source,\n    const uint8_t* __restrict__ thread_bases,\n    const int32_t* __restrict__ tile_exception_offsets,\n    uint32_t* __restrict__ entries20,\n    int num_tiles,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    if (tile >= num_tiles) {\n        return;\n    }\n    const int thread = threadIdx.x;\n    __shared__ int warp_totals[kWarpsPerTile];\n    __shared__ int tile_warp_prefixes[kWarpsPerTile];\n    const int64_t source_base = source_base_for_thread(tile, thread, columns);\n#!/usr/bin/env python3\n\"\"\"Unified codec decision benchmark for the tiered-serving weight path.\n\nFor each compressor codec (zipserv / p4flat / ublb_flat / chunk_delta3) and each Llama-3.1-70B\nprojection (qkv, o, gate_up, down) this measures the data needed to calibrate\nthe serving strategy, per token count N, between three choices:\n\n  1. fused             — decompress + GEMM in one kernel (no dense HBM write)\n  2. decomp-then-GEMM  — decompress to a dense bf16 weight, then cuBLAS\n  3. raw bf16 load     — skip compression, GEMM the dense bf16 weight directly\n                         (the compute floor; its load cost = raw_bytes / BW is\n                         estimated from the reported ratio)\n\nReported per (codec, proj):\n  * compress time, decompress time, compression ratio + compressed bytes\nReported per (codec, layer, proj, N), under TWO conditions — isolated and with a\nconcurrent H2D memcpy running (mimicking the next layer's weight offload):\n  * raw GEMM, decomp+GEMM, fused latency P50/P95\n\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\nfused has no dense write and is contention-immune. An isolated sweep therefore\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\n\nTo characterise the fused KERNEL at every N (so production thresholds can be\ncalibrated), the per-codec production N-thresholds are forced wide open.\n\nUsage:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\n  ... --synthetic --check --n-values 1,64,256\n  ... --csv codec_decision.csv\n  ... --codecs zipserv,p4flat --projs o,gate_up\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\n\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\nlink, adding two iso/h2d column groups:\n\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\n                the SMs, no dense-weight HBM staging at all.\n\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\nalike.  See\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\n\"\"\"\n\nimport argparse\nimport ctypes\nimport glob\nimport logging\nimport os\nimport re\nimport sys\n\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom benchmarks.fused_bench_common import (\n    H2DContender,\n    LatencyStats,\n    add_timing,\n    bench_cuda,\n    runtime_metadata,\n    sha256_file,\n    sha256_tensor,\n    write_csv,\n)\n\n# Silence per-compress codec INFO spam (logged once per timed iteration).\nlogging.getLogger(\"tiered_serve\").setLevel(logging.WARNING)\n\n\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\nHIDDEN_SIZE = 8192\nNUM_Q_HEADS = 64\nNUM_KV_HEADS = 8\nHEAD_DIM = 128\nINTERMEDIATE_SIZE = 28672\nN_LAYERS = 80\n\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\n\n\ndef proj_shapes(tp):\n    \"\"\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\n\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\n    shard the contraction dim.\n    \"\"\"\n    return {\n        \"qkv\":     (QKV_OUT // tp,    HIDDEN_SIZE),\n        \"o\":       (HIDDEN_SIZE,      Q_DIM // tp),\n        \"gate_up\": (GATEUP_OUT // tp, HIDDEN_SIZE),\n        \"down\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\n    }\n\n\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\n_l2_flush_buf = None\n\n\ndef flush_l2_cache():\n    global _l2_flush_buf\n    if _l2_flush_buf is None:\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\n                                    device=\"cuda\")\n    _l2_flush_buf.zero_()\n\n\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\n    \"\"\"P50/P95 per-iteration GPU time in an isolated stream.\"\"\"\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n    )\n\n\ndef bench_gpu(fn, warmup, iters, flush):\n    \"\"\"Backward-compatible P50-only wrapper used by older imports.\"\"\"\n    return bench_gpu_stats(fn, warmup, iters, flush).p50_ms\n\n\ndef bench_compute_stats(fn, warmup, iters, flush, contender=None,\n                        copies_per_iter=8) -> LatencyStats:\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n        contender=contender,\n        copies_per_iter=copies_per_iter,\n    )\n\n\ndef bench_compute(fn, warmup, iters, flush, contender=None, copies_per_iter=8):\n    \"\"\"Backward-compatible P50-only wrapper used by older scripts.\"\"\"\n    return bench_compute_stats(\n        fn, warmup, iters, flush, contender, copies_per_iter).p50_ms\n\n\n# ── Weight sources ───────────────────────────────────────────────────────────\nDEFAULT_WEIGHTS_DIR = (\n    \"/root/.cache/huggingface/hub/models--meta-llama--Llama-3.1-70B-Instruct\"\n    \"/snapshots/1605565b47bb9346c5515c34102e054115b4f98b\"\n)\n\n\ndef _layer_idx(name):\n    m = re.search(r'\\.layers\\.(\\d+)\\.', name)\n    return int(m.group(1)) if m else None\n\n\ndef load_real_projections(weights_dir, want_shapes, max_shards=6, layer=None):\n    \"\"\"Return {proj: bf16 CPU tensor (M,K)} pulled from real Llama-70B weights.\n\n    Fuses q+k+v -> qkv and gate+up -> gate_up per layer, then takes the first\n    tensor whose shape matches each requested projection.  Reads shards until\n    every wanted shape is satisfied.\n\n    ``layer`` (int) restricts the scan to that decoder layer's weights — use it\n    to pin the measurement to a representative layer (e.g. the median-exception\n    layer 40) instead of whatever shard 0 happens to expose first (layer 0, the\n    314k-exception QKV outlier).  All shards are scanned when ``layer`` is set,\n    since a high layer can live past ``max_shards``.\n    \"\"\"\n    from safetensors import safe_open\n    files = sorted(glob.glob(os.path.join(weights_dir, \"*.safetensors\")))\n    if not files:\n        raise FileNotFoundError(f\"No safetensors in {weights_dir}\")\n    if layer is not None:\n        files_to_scan = files          # a specific layer may live past shard 6\n    else:\n        files_to_scan = files[:max_shards]\n\n    want = {proj: tuple(shape) for proj, shape in want_shapes.items()}\n    found = {}\n    # per-layer accumulators for fusion\n    qkv = {}      # layer -> {q,k,v}\n    gateup = {}   # layer -> {gate,up}\n\n    def try_fuse():\n        for li, g in list(qkv.items()):\n            if \"qkv\" not in found and {\"q\", \"k\", \"v\"} <= g.keys():\n                t = torch.cat([g[\"q\"], g[\"k\"], g[\"v\"]], dim=0)\n                if \"qkv\" in want and tuple(t.shape) == want[\"qkv\"]:\n                    found[\"qkv\"] = t.contiguous()\n        for li, g in list(gateup.items()):\n            if \"gate_up\" not in found and {\"gate\", \"up\"} <= g.keys():\n                t = torch.cat([g[\"gate\"], g[\"up\"]], dim=0)\n                if \"gate_up\" in want and tuple(t.shape) == want[\"gate_up\"]:\n                    found[\"gate_up\"] = t.contiguous()\n\n    for path in files_to_scan:\n        with safe_open(path, framework=\"pt\") as f:\n            for key in f.keys():\n                if all(p in found for p in want):\n                    break\n                if not (key.endswith(\".weight\")):\n                    continue\n                li = _layer_idx(key)\n                if li is None:\n                    continue\n                if layer is not None and li != layer:\n                    continue\n                t = f.get_tensor(key)\n                if t.dim() != 2 or t.dtype != torch.bfloat16:\n                    continue\n                shp = tuple(t.shape)\n                if \".q_proj.\" in key:\n                    qkv.setdefault(li, {})[\"q\"] = t\n                elif \".k_proj.\" in key:\n                    qkv.setdefault(li, {})[\"k\"] = t\n                elif \".v_proj.\" in key:\n                    qkv.setdefault(li, {})[\"v\"] = t\n                elif \".gate_proj.\" in key:\n                    gateup.setdefault(li, {})[\"gate\"] = t\n                elif \".up_proj.\" in key:\n                    gateup.setdefault(li, {})[\"up\"] = t\n                elif \".o_proj.\" in key and \"o\" in want and shp == want[\"o\"]:\n                    found.setdefault(\"o\", t.contiguous())\n                elif \".down_proj.\" in key and \"down\" in want and shp == want[\"down\"]:\n                    found.setdefault(\"down\", t.contiguous())\n                try_fuse()\n        if all(p in found for p in want):\n            break\n\n    missing = [p for p in want if p not in found]\n    if missing:\n        where = (f\"layer {layer}\" if layer is not None\n                 else f\"the first {max_shards} shards\")\n        hint = (\"check --layer is in range [0, 79]\" if layer is not None\n                else \"increase --shards or use --synthetic\")\n        raise RuntimeError(\n            f\"Could not find real weights for {missing} in {where} ({hint}).\")\n    return found\n\n\ndef make_synthetic(M, K, seed):\n    g = torch.Generator(device=\"cuda\").manual_seed(seed)\n    return (torch.randn(M, K, generator=g, device=\"cuda\",\n                        dtype=torch.float32) * 0.02).to(torch.bfloat16)\n\n\n# ── Codec registry + force-fuse ──────────────────────────────────────────────\ndef build_codec(name):\n    from tiered_serve.compression.core import (\n        ZipServCompressor, P4FlatCompressor, UBLBFlatCompressor,\n        ChunkDelta3Compressor)\n","stderr":"","aggregated_output":"        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<256, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<192, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<128, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<64, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        return err;\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// ChunkDelta3 RS-mode fused decode + GEMM.\n//\n// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n// The matching base exponent is one byte per logical thread and sign/mantissa\n// is one raw byte per value.  Decode writes the reconstructed BF16 values\n// directly into the WGMMA register-A fragment, so no dense weight is emitted.\n//\n// CD3 exceptions are frequent enough on real weights that a sparse output\n// correction pass is a poor fit.  Instead each block expands only the current\n// tile's packed 20-bit exception records into a shared exponent override map\n// before constructing register A.  The WGMMA therefore consumes the exact\n// lossless weight, and split-K remains valid.\n// ============================================================================\ntemplate <int TileN, int Stages>\nstruct CD3RSSmem {\n    using SmemLayoutB = decltype(cute::tile_to_shape(\n        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n    alignas(16) uint8_t s_codes[Stages][1536];\n    alignas(16) uint8_t s_sm[Stages][4096];\n    alignas(16) uint8_t s_bases[Stages][256];\n    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n    // One word per physical WGMMA thread; bit i patches register-A fragment i.\n    alignas(16) uint32_t s_exc_mask[Stages][128];\n};\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void cd3_rs_kernel(\n    const uint8_t*       __restrict__ codes_g,\n    const uint8_t*       __restrict__ sm_g,\n    const uint8_t*       __restrict__ bases_g,\n    const int32_t*       __restrict__ tile_offsets_g,\n    const uint64_t*      __restrict__ entries20x3_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid = static_cast<int>(threadIdx.x);\n    const int tile_n = static_cast<int>(blockIdx.x);\n    const int tile_m = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);\n    const int tk_split = tiles_k / split_k;\n    const int k0 = split_idx * tk_split;\n\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n                         make_coord(tile_n, _));\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    auto tiled_copy = make_tiled_copy(G2S{},\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n    auto thr_copy = tiled_copy.get_slice(tid);\n    auto tBgB = thr_copy.partition_S(gB);\n    auto tBsB = thr_copy.partition_D(sB);\n\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                              make_coord(tile_m, tile_n));\n    auto tiled_mma = make_tiled_mma(MmaOp{});\n    auto thr_mma = tiled_mma.get_thread_slice(tid);\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n    clear(tCrC);\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n\n    using SmemLayoutA = decltype(tile_to_shape(\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n                                SmemLayoutA{});\n    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n\n    auto load_b = [&](int k_tile, int pipe) {\n        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n    };\n\n    auto load_compressed = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\n        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\n        if (tid < 96)\n            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n        #pragma unroll\n        for (int j = 0; j < 2; ++j) {\n            const int chunk = tid + j * 128;\n            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\n        }\n        if (tid < 16)\n            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\n    };\n\n    auto build_exception_map = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int begin = tile_offsets_g[tile_idx];\n        const int end = tile_offsets_g[tile_idx + 1];\n        smem.s_exc_mask[st][tid] = 0;\n        __syncthreads();\n        for (int e = begin + tid; e < end; e += 128) {\n            const int64_t group = static_cast<int64_t>(e) / 3;\n            const int slot = e - static_cast<int>(group * 3);\n            const uint32_t entry = static_cast<uint32_t>(\n                (entries20x3_g[group] >> (slot * 20)) & 0xfffffu);\n            const int pos = static_cast<int>(entry & 0xfffu);\n            const int m = pos >> 6;\n            const int k = pos & 63;\n            const int owner_thread =\n                (m >> 4) * 32 + ((m & 7) << 2) + ((k & 7) >> 1);\n            const int fragment =\n                (k >> 3) * 4 + ((m & 8) >> 2) + (k & 1);\n            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 12);\n            atomicOr(&smem.s_exc_mask[st][owner_thread], 1u << fragment);\n        }\n        __syncthreads();\n    };\n\n    auto decode_regA = [&](int st) {\n        const uint32_t lane_exception_mask = smem.s_exc_mask[st][tid];\n        const int row0 = (tid >> 5) * 16 + ((tid & 31) >> 2);\n        const int item_pair = (tid & 3) * 2;\n        CUTE_UNROLL\n        for (int chunk = 0; chunk < 4; ++chunk) {\n            CUTE_UNROLL\n            for (int row_half = 0; row_half < 2; ++row_half) {\n                const int m = row0 + row_half * 8;\n                const int owner = m * 4 + chunk;\n                const int byte = owner * 6;\n                const int aligned_byte = byte & ~3;\n                const uint32_t word0 = *reinterpret_cast<const uint32_t*>(\n                    &smem.s_codes[st][aligned_byte]);\n                const uint32_t word1 = *reinterpret_cast<const uint32_t*>(\n                    &smem.s_codes[st][aligned_byte + 4]);\n                const uint64_t code_word =\n                    (static_cast<uint64_t>(word0)\n                     | (static_cast<uint64_t>(word1) << 32))\n                    >> ((byte & 3) * 8);\n                CUTE_UNROLL\n                for (int half = 0; half < 2; ++half) {\n                    CUTE_UNROLL\n                    for (int parity = 0; parity < 2; ++parity) {\n                        const int item = half * 8 + item_pair + parity;\n                        const int k = chunk * 16 + item;\n                        const int i =\n                            chunk * 8 + half * 4 + row_half * 2 + parity;\n                        const uint8_t code = static_cast<uint8_t>(\n                            (code_word >> (item * 3)) & 7u);\n                        const int pos = m * 64 + k;\n                        uint8_t exp = static_cast<uint8_t>(\n                            smem.s_bases[st][owner] + code);\n                        const bool is_exception =\n                            (lane_exception_mask >> i) & 1u;\n                        if (is_exception)\n                            exp = smem.s_exc_exp[st][pos];\n                        const uint8_t smv = smem.s_sm[st][owner * 16 + item];\n                        const uint16_t bits = static_cast<uint16_t>(\n                            (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                            (static_cast<uint16_t>(exp) << 7) |\n                            static_cast<uint16_t>(smv & 0x7fu));\n                        const __nv_bfloat16 value = __ushort_as_bfloat16(bits);\n                        tCrA(i) = reinterpret_cast<const bfloat16_t&>(value);\n                    }\n                }\n            }\n        }\n    };\n\n    CUTE_UNROLL\n    for (int s = 0; s < Stages - 1; ++s) {\n        if (s < tk_split) {\n            load_b(k0 + s, s);\n            load_compressed(k0 + s, s);\n        }\n        cp_async_fence();\n    }\n\n    for (int kk = 0; kk < tk_split; ++kk) {\n        cp_async_wait<Stages - 2>();\n        __syncthreads();\n\n        const int st = kk % Stages;\n        build_exception_map(k0 + kk, st);\n        decode_regA(st);\n        warpgroup_fence_operand(tCrA);\n        warpgroup_arrive();\n        gemm(tiled_mma, tCrA, tCrB(_, _, _, st), tCrC);\n        warpgroup_commit_batch();\n\n        const int knext = kk + Stages - 1;\n        if (knext < tk_split) {\n            load_b(k0 + knext, knext % Stages);\n            load_compressed(k0 + knext, knext % Stages);\n        }\n        cp_async_fence();\n\n        warpgroup_wait<0>();\n        __syncthreads();\n    }\n\n    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchCD3RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint64_t* entries20x3,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\n        (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, bases, tile_offsets, entries20x3,\n        B, C, Cf32, M, N, K, split_k);\n    cudaError_t err = cudaGetLastError();\n    if (err != cudaSuccess || split_k <= 1) return err;\n    const int64_t MN = static_cast<int64_t>(M) * N;\n    const int t = 256;\n    const int64_t blocks = (MN + t - 1) / t;\n    splitk_reduce_kernel<<<static_cast<unsigned>(blocks), t, 0, stream>>>(\n        Cf32, C, MN, split_k);\n    return cudaGetLastError();\n}\n\nextern \"C\" cudaError_t cd3_rs_wgmma_launch(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint64_t* entries20x3,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<256, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<192, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<128, MMA, 3>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        return LaunchCD3RS<64, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// zipserv RS-mode fused decode + GEMM (Triple Bitmap Encoding).\n#include <cuda_runtime.h>\n\n#include <cstdint>\n\nnamespace {\n\nconstexpr int kTileDim = 64;\nconstexpr int kTileElements = kTileDim * kTileDim;\nconstexpr int kThreads = 256;\nconstexpr int kElementsPerThread = 16;\nconstexpr int kCodeBytesPerTile = kTileElements * 3 / 8;\nconstexpr int kPaletteSize = 7;\nconstexpr int kWarpsPerTile = kThreads / 32;\n\n__device__ __forceinline__ uint64_t load_code_word(\n    const uint8_t* codes,\n    int tile,\n    int thread)\n{\n    const int64_t base =\n        static_cast<int64_t>(tile) * kCodeBytesPerTile\n        + static_cast<int64_t>(thread) * 6;\n    uint64_t word = 0;\n#pragma unroll\n    for (int byte = 0; byte < 6; ++byte) {\n        word |= static_cast<uint64_t>(codes[base + byte]) << (byte * 8);\n    }\n    return word;\n}\n\n__device__ __forceinline__ int escape_count(uint64_t code_word)\n{\n    constexpr uint64_t kThreeBitLaneLowBits = 0x249249249249ull;\n    const uint64_t matches = code_word & (code_word >> 1)\n        & (code_word >> 2) & kThreeBitLaneLowBits;\n    return __popcll(matches);\n}\n\n__device__ __forceinline__ int exclusive_scan_tile(\n    int value,\n    int* warp_totals,\n    int* warp_prefixes)\n{\n    const int lane = threadIdx.x & 31;\n    const int warp = threadIdx.x >> 5;\n    int inclusive = value;\n#pragma unroll\n    for (int delta = 1; delta < 32; delta <<= 1) {\n        const int prior = __shfl_up_sync(0xffffffffu, inclusive, delta);\n        if (lane >= delta) {\n            inclusive += prior;\n        }\n    }\n    if (lane == 31) {\n        warp_totals[warp] = inclusive;\n    }\n    __syncthreads();\n\n    if (warp == 0) {\n        int total = lane < kWarpsPerTile ? warp_totals[lane] : 0;\n        const int own = total;\n#pragma unroll\n        for (int delta = 1; delta < 32; delta <<= 1) {\n            const int prior = __shfl_up_sync(0xffffffffu, total, delta);\n            if (lane >= delta) {\n                total += prior;\n            }\n        }\n        if (lane < kWarpsPerTile) {\n            warp_prefixes[lane] = total - own;\n        }\n    }\n    __syncthreads();\n    return warp_prefixes[warp] + inclusive - value;\n}\n\n__device__ __forceinline__ uint8_t exponent_of(uint16_t bits)\n{\n    return static_cast<uint8_t>((bits >> 7) & 0xffu);\n}\n        sign_mantissa_words[item >> 2] |=\n            static_cast<uint32_t>(sign_mantissa_of(values[item]))\n            << ((item & 3) * 8);\n    }\n\n    const int64_t code_base =\n        static_cast<int64_t>(tile) * kCodeBytesPerTile\n        + static_cast<int64_t>(thread) * 6;\n#pragma unroll\n    for (int byte = 0; byte < 6; ++byte) {\n        codes[code_base + byte] =\n            static_cast<uint8_t>(code_word >> (byte * 8));\n    }\n    uint4 packed_sign_mantissa;\n    packed_sign_mantissa.x = sign_mantissa_words[0];\n    packed_sign_mantissa.y = sign_mantissa_words[1];\n    packed_sign_mantissa.z = sign_mantissa_words[2];\n    packed_sign_mantissa.w = sign_mantissa_words[3];\n    *reinterpret_cast<uint4*>(\n        sign_mantissa + static_cast<int64_t>(tile) * kTileElements\n        + thread * kElementsPerThread) = packed_sign_mantissa;\n\n    const int exception_count = kElementsPerThread - best_count;\n    const int rank = exclusive_scan_tile(\n        exception_count, warp_totals, warp_prefixes);\n    if (thread == kThreads - 1) {\n        tile_exception_counts[tile] = rank + exception_count;\n    }\n}\n\n__global__ void BuildTilePalette3EntriesKernel(\n    const uint16_t* __restrict__ source,\n    const uint8_t* __restrict__ codes,\n    const int32_t* __restrict__ tile_exception_offsets,\n    uint16_t* __restrict__ warp_prefixes,\n    uint16_t* __restrict__ positions,\n    uint8_t* __restrict__ exception_exponents,\n    int num_tiles,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    if (tile >= num_tiles) {\n        return;\n    }\n    const int thread = threadIdx.x;\n    const int lane = thread & 31;\n    const int warp = thread >> 5;\n    __shared__ int warp_totals[kWarpsPerTile];\n    __shared__ int tile_warp_prefixes[kWarpsPerTile];\n\n    const uint64_t code_word = load_code_word(codes, tile, thread);\n    const int count = escape_count(code_word);\n    const int thread_rank = exclusive_scan_tile(\n        count, warp_totals, tile_warp_prefixes);\n    if (lane == 0) {\n        warp_prefixes[static_cast<int64_t>(tile) * kWarpsPerTile + warp] =\n            static_cast<uint16_t>(thread_rank);\n    }\n\n    int rank = tile_exception_offsets[tile] + thread_rank;\n    const int warp_local_base = lane * kElementsPerThread;\n    const int64_t source_base = source_base_for_thread(tile, thread, columns);\n#pragma unroll\n    for (int item = 0; item < kElementsPerThread; ++item) {\n        const uint8_t code =\n            static_cast<uint8_t>((code_word >> (item * 3)) & 7u);\n        if (code == kPaletteSize) {\n            positions[rank] =\n                static_cast<uint16_t>(warp_local_base + item);\n            exception_exponents[rank] = exponent_of(source[source_base + item]);\n            ++rank;\n        }\n    }\n}\n\n__global__ void BuildChunkDelta3EntriesKernel(\n    const uint16_t* __restrict__ source,\n    const uint8_t* __restrict__ thread_bases,\n    const int32_t* __restrict__ tile_exception_offsets,\n    uint32_t* __restrict__ entries20,\n    int num_tiles,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    if (tile >= num_tiles) {\n        return;\n    }\n    const int thread = threadIdx.x;\n    __shared__ int warp_totals[kWarpsPerTile];\n    __shared__ int tile_warp_prefixes[kWarpsPerTile];\n    const int64_t source_base = source_base_for_thread(tile, thread, columns);\n#!/usr/bin/env python3\n\"\"\"Unified codec decision benchmark for the tiered-serving weight path.\n\nFor each compressor codec (zipserv / p4flat / ublb_flat / chunk_delta3) and each Llama-3.1-70B\nprojection (qkv, o, gate_up, down) this measures the data needed to calibrate\nthe serving strategy, per token count N, between three choices:\n\n  1. fused             — decompress + GEMM in one kernel (no dense HBM write)\n  2. decomp-then-GEMM  — decompress to a dense bf16 weight, then cuBLAS\n  3. raw bf16 load     — skip compression, GEMM the dense bf16 weight directly\n                         (the compute floor; its load cost = raw_bytes / BW is\n                         estimated from the reported ratio)\n\nReported per (codec, proj):\n  * compress time, decompress time, compression ratio + compressed bytes\nReported per (codec, layer, proj, N), under TWO conditions — isolated and with a\nconcurrent H2D memcpy running (mimicking the next layer's weight offload):\n  * raw GEMM, decomp+GEMM, fused latency P50/P95\n\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\nfused has no dense write and is contention-immune. An isolated sweep therefore\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\n\nTo characterise the fused KERNEL at every N (so production thresholds can be\ncalibrated), the per-codec production N-thresholds are forced wide open.\n\nUsage:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\n  ... --synthetic --check --n-values 1,64,256\n  ... --csv codec_decision.csv\n  ... --codecs zipserv,p4flat --projs o,gate_up\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\n\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\nlink, adding two iso/h2d column groups:\n\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\n                the SMs, no dense-weight HBM staging at all.\n\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\nalike.  See\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\n\"\"\"\n\nimport argparse\nimport ctypes\nimport glob\nimport logging\nimport os\nimport re\nimport sys\n\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom benchmarks.fused_bench_common import (\n    H2DContender,\n    LatencyStats,\n    add_timing,\n    bench_cuda,\n    runtime_metadata,\n    sha256_file,\n    sha256_tensor,\n    write_csv,\n)\n\n# Silence per-compress codec INFO spam (logged once per timed iteration).\nlogging.getLogger(\"tiered_serve\").setLevel(logging.WARNING)\n\n\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\nHIDDEN_SIZE = 8192\nNUM_Q_HEADS = 64\nNUM_KV_HEADS = 8\nHEAD_DIM = 128\nINTERMEDIATE_SIZE = 28672\nN_LAYERS = 80\n\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\n\n\ndef proj_shapes(tp):\n    \"\"\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\n\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\n    shard the contraction dim.\n    \"\"\"\n    return {\n        \"qkv\":     (QKV_OUT // tp,    HIDDEN_SIZE),\n        \"o\":       (HIDDEN_SIZE,      Q_DIM // tp),\n        \"gate_up\": (GATEUP_OUT // tp, HIDDEN_SIZE),\n        \"down\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\n    }\n\n\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\n_l2_flush_buf = None\n\n\ndef flush_l2_cache():\n    global _l2_flush_buf\n    if _l2_flush_buf is None:\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\n                                    device=\"cuda\")\n    _l2_flush_buf.zero_()\n\n\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\n    \"\"\"P50/P95 per-iteration GPU time in an isolated stream.\"\"\"\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n    )\n\n\ndef bench_gpu(fn, warmup, iters, flush):\n    \"\"\"Backward-compatible P50-only wrapper used by older imports.\"\"\"\n    return bench_gpu_stats(fn, warmup, iters, flush).p50_ms\n\n\ndef bench_compute_stats(fn, warmup, iters, flush, contender=None,\n                        copies_per_iter=8) -> LatencyStats:\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n        contender=contender,\n        copies_per_iter=copies_per_iter,\n    )\n\n\ndef bench_compute(fn, warmup, iters, flush, contender=None, copies_per_iter=8):\n    \"\"\"Backward-compatible P50-only wrapper used by older scripts.\"\"\"\n    return bench_compute_stats(\n        fn, warmup, iters, flush, contender, copies_per_iter).p50_ms\n\n\n# ── Weight sources ───────────────────────────────────────────────────────────\nDEFAULT_WEIGHTS_DIR = (\n    \"/root/.cache/huggingface/hub/models--meta-llama--Llama-3.1-70B-Instruct\"\n    \"/snapshots/1605565b47bb9346c5515c34102e054115b4f98b\"\n)\n\n\ndef _layer_idx(name):\n    m = re.search(r'\\.layers\\.(\\d+)\\.', name)\n    return int(m.group(1)) if m else None\n\n\ndef load_real_projections(weights_dir, want_shapes, max_shards=6, layer=None):\n    \"\"\"Return {proj: bf16 CPU tensor (M,K)} pulled from real Llama-70B weights.\n\n    Fuses q+k+v -> qkv and gate+up -> gate_up per layer, then takes the first\n    tensor whose shape matches each requested projection.  Reads shards until\n    every wanted shape is satisfied.\n\n    ``layer`` (int) restricts the scan to that decoder layer's weights — use it\n    to pin the measurement to a representative layer (e.g. the median-exception\n    layer 40) instead of whatever shard 0 happens to expose first (layer 0, the\n    314k-exception QKV outlier).  All shards are scanned when ``layer`` is set,\n    since a high layer can live past ``max_shards``.\n    \"\"\"\n    from safetensors import safe_open\n    files = sorted(glob.glob(os.path.join(weights_dir, \"*.safetensors\")))\n    if not files:\n        raise FileNotFoundError(f\"No safetensors in {weights_dir}\")\n    if layer is not None:\n        files_to_scan = files          # a specific layer may live past shard 6\n    else:\n        files_to_scan = files[:max_shards]\n\n    want = {proj: tuple(shape) for proj, shape in want_shapes.items()}\n    found = {}\n    # per-layer accumulators for fusion\n    qkv = {}      # layer -> {q,k,v}\n    gateup = {}   # layer -> {gate,up}\n\n    def try_fuse():\n        for li, g in list(qkv.items()):\n            if \"qkv\" not in found and {\"q\", \"k\", \"v\"} <= g.keys():\n                t = torch.cat([g[\"q\"], g[\"k\"], g[\"v\"]], dim=0)\n                if \"qkv\" in want and tuple(t.shape) == want[\"qkv\"]:\n                    found[\"qkv\"] = t.contiguous()\n        for li, g in list(gateup.items()):\n            if \"gate_up\" not in found and {\"gate\", \"up\"} <= g.keys():\n                t = torch.cat([g[\"gate\"], g[\"up\"]], dim=0)\n                if \"gate_up\" in want and tuple(t.shape) == want[\"gate_up\"]:\n                    found[\"gate_up\"] = t.contiguous()\n\n    for path in files_to_scan:\n        with safe_open(path, framework=\"pt\") as f:\n            for key in f.keys():\n                if all(p in found for p in want):\n                    break\n                if not (key.endswith(\".weight\")):\n                    continue\n                li = _layer_idx(key)\n                if li is None:\n                    continue\n                if layer is not None and li != layer:\n                    continue\n                t = f.get_tensor(key)\n                if t.dim() != 2 or t.dtype != torch.bfloat16:\n                    continue\n                shp = tuple(t.shape)\n                if \".q_proj.\" in key:\n                    qkv.setdefault(li, {})[\"q\"] = t\n                elif \".k_proj.\" in key:\n                    qkv.setdefault(li, {})[\"k\"] = t\n                elif \".v_proj.\" in key:\n                    qkv.setdefault(li, {})[\"v\"] = t\n                elif \".gate_proj.\" in key:\n                    gateup.setdefault(li, {})[\"gate\"] = t\n                elif \".up_proj.\" in key:\n                    gateup.setdefault(li, {})[\"up\"] = t\n                elif \".o_proj.\" in key and \"o\" in want and shp == want[\"o\"]:\n                    found.setdefault(\"o\", t.contiguous())\n                elif \".down_proj.\" in key and \"down\" in want and shp == want[\"down\"]:\n                    found.setdefault(\"down\", t.contiguous())\n                try_fuse()\n        if all(p in found for p in want):\n            break\n\n    missing = [p for p in want if p not in found]\n    if missing:\n        where = (f\"layer {layer}\" if layer is not None\n                 else f\"the first {max_shards} shards\")\n        hint = (\"check --layer is in range [0, 79]\" if layer is not None\n                else \"increase --shards or use --synthetic\")\n        raise RuntimeError(\n            f\"Could not find real weights for {missing} in {where} ({hint}).\")\n    return found\n\n\ndef make_synthetic(M, K, seed):\n    g = torch.Generator(device=\"cuda\").manual_seed(seed)\n    return (torch.randn(M, K, generator=g, device=\"cuda\",\n                        dtype=torch.float32) * 0.02).to(torch.bfloat16)\n\n\n# ── Codec registry + force-fuse ──────────────────────────────────────────────\ndef build_codec(name):\n    from tiered_serve.compression.core import (\n        ZipServCompressor, P4FlatCompressor, UBLBFlatCompressor,\n        ChunkDelta3Compressor)\n","exit_code":0,"duration":{"secs":0,"nanos":3200},"formatted_output":"        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<256, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<192, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<128, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<64, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        return err;\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// ChunkDelta3 RS-mode fused decode + GEMM.\n//\n// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n// The matching base exponent is one byte per logical thread and sign/mantissa\n// is one raw byte per value.  Decode writes the reconstructed BF16 values\n// directly into the WGMMA register-A fragment, so no dense weight is emitted.\n//\n// CD3 exceptions are frequent enough on real weights that a sparse output\n// correction pass is a poor fit.  Instead each block expands only the current\n// tile's packed 20-bit exception records into a shared exponent override map\n// before constructing register A.  The WGMMA therefore consumes the exact\n// lossless weight, and split-K remains valid.\n// ============================================================================\ntemplate <int TileN, int Stages>\nstruct CD3RSSmem {\n    using SmemLayoutB = decltype(cute::tile_to_shape(\n        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n    alignas(16) uint8_t s_codes[Stages][1536];\n    alignas(16) uint8_t s_sm[Stages][4096];\n    alignas(16) uint8_t s_bases[Stages][256];\n    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n    // One word per physical WGMMA thread; bit i patches register-A fragment i.\n    alignas(16) uint32_t s_exc_mask[Stages][128];\n};\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void cd3_rs_kernel(\n    const uint8_t*       __restrict__ codes_g,\n    const uint8_t*       __restrict__ sm_g,\n    const uint8_t*       __restrict__ bases_g,\n    const int32_t*       __restrict__ tile_offsets_g,\n    const uint64_t*      __restrict__ entries20x3_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid = static_cast<int>(threadIdx.x);\n    const int tile_n = static_cast<int>(blockIdx.x);\n    const int tile_m = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);\n    const int tk_split = tiles_k / split_k;\n    const int k0 = split_idx * tk_split;\n\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n                         make_coord(tile_n, _));\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    auto tiled_copy = make_tiled_copy(G2S{},\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n    auto thr_copy = tiled_copy.get_slice(tid);\n    auto tBgB = thr_copy.partition_S(gB);\n    auto tBsB = thr_copy.partition_D(sB);\n\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                              make_coord(tile_m, tile_n));\n    auto tiled_mma = make_tiled_mma(MmaOp{});\n    auto thr_mma = tiled_mma.get_thread_slice(tid);\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n    clear(tCrC);\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n\n    using SmemLayoutA = decltype(tile_to_shape(\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n                                SmemLayoutA{});\n    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n\n    auto load_b = [&](int k_tile, int pipe) {\n        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n    };\n\n    auto load_compressed = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\n        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\n        if (tid < 96)\n            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n        #pragma unroll\n        for (int j = 0; j < 2; ++j) {\n            const int chunk = tid + j * 128;\n            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\n        }\n        if (tid < 16)\n            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\n    };\n\n    auto build_exception_map = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int begin = tile_offsets_g[tile_idx];\n        const int end = tile_offsets_g[tile_idx + 1];\n        smem.s_exc_mask[st][tid] = 0;\n        __syncthreads();\n        for (int e = begin + tid; e < end; e += 128) {\n            const int64_t group = static_cast<int64_t>(e) / 3;\n            const int slot = e - static_cast<int>(group * 3);\n            const uint32_t entry = static_cast<uint32_t>(\n                (entries20x3_g[group] >> (slot * 20)) & 0xfffffu);\n            const int pos = static_cast<int>(entry & 0xfffu);\n            const int m = pos >> 6;\n            const int k = pos & 63;\n            const int owner_thread =\n                (m >> 4) * 32 + ((m & 7) << 2) + ((k & 7) >> 1);\n            const int fragment =\n                (k >> 3) * 4 + ((m & 8) >> 2) + (k & 1);\n            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 12);\n            atomicOr(&smem.s_exc_mask[st][owner_thread], 1u << fragment);\n        }\n        __syncthreads();\n    };\n\n    auto decode_regA = [&](int st) {\n        const uint32_t lane_exception_mask = smem.s_exc_mask[st][tid];\n        const int row0 = (tid >> 5) * 16 + ((tid & 31) >> 2);\n        const int item_pair = (tid & 3) * 2;\n        CUTE_UNROLL\n        for (int chunk = 0; chunk < 4; ++chunk) {\n            C