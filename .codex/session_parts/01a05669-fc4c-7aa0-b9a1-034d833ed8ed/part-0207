{"timestamp":"2026-09-01T05:13:19.091Z","ordinal":9743,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05b62-d5f3-7953-90c4-dc902c02f24a","call_id":"call_04OcFNpESmyNBa37EJEPkZXB","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n        c_best = min(c_best, time.perf_counter() - t0)\n    comp_bytes = int(comp.total_compressed_size)\n\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\n\n    def _decomp_into():\n        return comp_obj.decompress(comp, out)\n\n    def _decomp_alloc():\n        return comp_obj.decompress(comp)\n\n    try:\n        dec = _decomp_into()\n        decomp = _decomp_into\n    except Exception:\n        dec = _decomp_alloc()\n        decomp = _decomp_alloc\n    for _ in range(warmup - 1):\n        dec = decomp()\n    torch.cuda.synchronize()\n\n    d_best = float(\"inf\")\n    for _ in range(runs):\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        dec = decomp()\n        torch.cuda.synchronize()\n        d_best = min(d_best, time.perf_counter() - t0)\n\n    ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatting\n# ════════════════════════════════════════════════════════════════════\n\n# Tables are emitted single-space-separated with single-token headers (no\n# internal spaces, no alignment padding) so they paste straight into Excel\n# (Text-to-Columns -> space delimiter, or \"treat consecutive delimiters as one\").\n\ndef _print_table(rows):\n    if not rows:\n        print(\"(no results)\"); return\n    print(\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\")\n    for r in rows:\n        print(f\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \"\n              f\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \"\n              f\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\")\n\n\ndef _print_summary(all_rows):\n    print(\"\\nSUMMARY (averaged across all weights)\")\n    by_codec = defaultdict(list)\n    for r in all_rows:\n        by_codec[r.codec].append(r)\n    print(\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\")\n    import statistics as st\n    for codec, rs in by_codec.items():\n        n = len(rs)\n        n_ok = sum(1 for r in rs if r.ok)\n        print(f\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \"\n              f\"{st.mean(r.c_ms for r in rs):.3f} \"\n              f\"{st.mean(r.d_ms for r in rs):.3f} \"\n              f\"{st.mean(r.c_gbps for r in rs):.2f} \"\n              f\"{st.mean(r.d_gbps for r in rs):.2f} \"\n              f\"{n_ok}/{n}\")\n\n            else:\n                msg = str(e).splitlines()[0] if str(e) else type(e).__name__\n            print(f\"    [{codec}] skipped: {msg}\")\n            torch.cuda.empty_cache()\n    _print_table(rows)\n    del w\n    torch.cuda.empty_cache()\n    return rows\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Main\n# ════════════════════════════════════════════════════════════════════\n\ndef main():\n    ap = argparse.ArgumentParser(\n        description=\"tiered-serve weight compress/decompress benchmark\")\n    ap.add_argument(\"model\", nargs=\"*\",\n                    help=\"HF model id (org/name, resolved from the hub cache) \"\n                         \"or explicit .safetensors path(s)\")\n    ap.add_argument(\"--synthetic\", action=\"store_true\",\n                    help=\"Use deterministic Llama-3.1-70B fused projection \"\n                         \"shapes with normal BF16 values (latency fallback \"\n                         \"when the real checkpoint is unavailable)\")\n    ap.add_argument(\"--synthetic-scale\", type=float, default=0.02,\n                    help=\"Standard deviation for --synthetic (default: 0.02)\")\n    ap.add_argument(\"--codec\", default=None,\n                    help=\"Comma-separated codec names, or 'all'. Default: \"\n                         f\"{','.join(_DEFAULT_BF16)} (BF16) / \"\n                         f\"{','.join(_DEFAULT_FP8)} (FP8)\")\n    ap.add_argument(\"--group\", \"-g\", default=None,\n                    help=\"Comma-separated fused groups to run \"\n                         f\"({', '.join(_GROUP_DEFS)}). Default: all\")\n    ap.add_argument(\"--layer\", \"-l\", type=int, default=None,\n                    help=\"Restrict to one transformer layer (e.g. 0)\")\n    ap.add_argument(\"--per-tensor\", action=\"store_true\",\n                    help=\"Benchmark raw per-projection weights (q/k/v/...) \"\n                         \"instead of the fused qkv/o/gateup/down\")\n    ap.add_argument(\"--key\", \"-k\", default=None,\n                    help=\"(--per-tensor) only weights whose name contains this\")\n    ap.add_argument(\"--all-weights\", action=\"store_true\",\n                    help=\"(--per-tensor) include non-projection weights\")\n    ap.add_argument(\"--max-weights\", type=int, default=0,\n                    help=\"Process at most this many weights (0 = all)\")\n    ap.add_argument(\"--runs\", type=int, default=5,\n                    help=\"Timed iterations per codec (best is reported)\")\n    ap.add_argument(\"--no-cast\", action=\"store_true\",\n                    help=\"Skip non-BF16/FP8 weights instead of casting fp16/\"\n                         \"fp32 to bf16\")\n    args = ap.parse_args()\n\n    if not torch.cuda.is_available():\n        sys.exit(\"CUDA is required (tiered-serve weight codecs run on GPU).\")\n\n    if args.synthetic and args.model:\n        sys.exit(\"Do not pass model paths together with --synthetic.\")\n    if not args.synthetic and not args.model:\n        sys.exit(\"Pass a model/checkpoint, or use --synthetic.\")\n    if args.synthetic and args.per_tensor:\n        sys.exit(\"--synthetic supports fused groups, not --per-tensor.\")\n    shards = [] if args.synthetic else _resolve_inputs(args.model)\n    if not args.synthetic and not shards:\n        sys.exit(\"No safetensors shards found.\")\n\n    registry = _build_registry()\n    selected = (None if args.codec is None\n                else list(registry) if args.codec == \"all\"\n                else [c.strip() for c in args.codec.split(\",\") if c.strip()])\n    if selected is not None:\n        for c in selected:\n            if c not in registry:\n                sys.exit(f\"Unknown codec {c!r}. Known: {', '.join(registry)}\")\n\n    group_filter = None\n    if args.group is not None:\n        group_filter = [g.strip() for g in args.group.split(\",\") if g.strip()]\n        for g in group_filter:\n            if g not in _GROUP_DEFS:\n                sys.exit(f\"Unknown group {g!r}. Known: {', '.join(_GROUP_DEFS)}\")\n\n    mode = \"per-tensor\" if args.per_tensor else \"fused (qkv/o/gateup/down)\"\n    print(\"=\" * 80)\n    print(\"  tiered-serve weight compression benchmark\")\n    print(\"=\" * 80)\n    source = (f\"synthetic Llama-70B shapes (std={args.synthetic_scale})\"\n              if args.synthetic else f\"{len(shards)} shard file(s)\")\n    print(f\"  Source : {source}\")\n    print(f\"  Mode   : {mode}\")\n    print(f\"  GPU    : {torch.cuda.get_device_name(0)}\")\n    print(f\"  Runs   : {args.runs}  (best-of)\")\n    print(\"=\" * 80 + \"\\n\")\n\n    stream = torch.cuda.Stream()\n    instances = {}   # codec name -> built compressor (or None if build failed)\n\n    def _get(codec):\n        if codec not in instances:\n            try:\n                instances[codec] = registry[codec][1](stream)\n            except Exception as e:\n                print(f\"  [build {codec}] FAILED: {e}\")\n                instances[codec] = None\n        return instances[codec]\n\n    all_rows = []\n    processed = 0\n\n    if args.synthetic:\n        synthetic_shapes = OrderedDict([\n            (\"qkv\", (10240, 8192)),\n            (\"o\", (8192, 8192)),\n--- kv codec full ---\n#!/usr/bin/env python3\n\"\"\"Direct production-codec benchmark on real cached K/V blocks.\n\nThe serving KV block layout [N, 16, 8, 128] is viewed as two dense\n[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\nrequired by P4Flat and ChunkDelta3 while exercising their normal compressor,\nhost-staging, and decompressor interfaces.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport time\n\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\n\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\nBLOCK_SHAPE = (16, 8, 128)\nROWS_PER_BLOCK = 128\nCOLS = 128\n\n\ndef _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\n    obj = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_key = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    if len(obj[k_key]) < n or len(obj[\"v_blocks\"]) < n:\n        raise ValueError(\n            f\"Requested {n} blocks, cache has K={len(obj[k_key])}, \"\n            f\"V={len(obj['v_blocks'])}\")\n    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\n    v = torch.stack([x.contiguous() for x in obj[\"v_blocks\"][:n]])\n    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\n\n\ndef _samples(fn, warmup: int, iterations: int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.comp