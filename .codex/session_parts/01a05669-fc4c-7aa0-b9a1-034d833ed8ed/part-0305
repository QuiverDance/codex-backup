penMP\n            # host_encode_blocks) variant of the p4flat codec — it always uses\n            # the cpu_after_raw_swap producer, regardless of the env default.\n            # p4flat's gpu_direct compress runs 3 device kernels\n            # (compress_lean) on comp_stream.  When weight compression is also\n            # active, those kernels contend with weight-decompress + fused-mm\n            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n            # default p4flat to the CPU encoder whenever weight comp is on (the\n            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n            # where the GPU has spare SMs and the two paths are on par\n            # (180 vs 176 ms).  An explicit env value below still overrides.\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\"):\n                _default_producer = \"cpu_after_raw_swap\"\n            elif kv_comp_backend == \"chunk_delta3\":\n                # CD3 GPU encode contends directly with fused weight decode/MM\n                # once KV offload begins.  The host encoder consumes the raw\n                # secondary copy asynchronously and is the serving default.\n                _default_producer = \"cpu_after_raw_swap\"\n            elif (kv_comp_backend == \"p4flat\"\n                    and DualMemoryLoader.use_weight_comp):\n                _default_producer = \"cpu_after_raw_swap\"\n            else:\n                _default_producer = \"gpu_direct\"\n            kv_comp_producer = os.getenv(\n                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n                    f\"'cpu_after_raw_swap'.\")\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\") and \\\n                    kv_comp_producer != \"cpu_after_raw_swap\":\n                logger.warning(\n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n                    f\"(backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent