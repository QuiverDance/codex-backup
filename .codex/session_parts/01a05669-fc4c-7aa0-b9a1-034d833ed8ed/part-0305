        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            elif kv_comp_backend == \"chunk_delta3\":\n                from tiered_serve.chunk_delta3_kv_compressor import (\n                    ChunkDelta3CPUKVCompressor,\n                    ChunkDelta3KVCompressor,\n                )\n                if kv_comp_producer == \"cpu_after_raw_swap\":\n                    self.kv_compressor = ChunkDelta3CPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 (CPU OpenMP encode, \"\n                        \"batched GPU decode)\")\n                else:\n                    self.kv_compressor = ChunkDelta3KVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 \"\n                        \"(batched GPU encode/decode)\")\n            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n                #                         nvcomp_bitcomp_compress_batch)\n                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n        if result != 0:\n            raise RuntimeError(\n                f\"cudaEventSynchronize failed for CD3 CPU encode: {result}\")\n    else:  # pragma: no cover - libcudart is present in serving containers\n        torch.cuda.synchronize()\n\n\nclass ChunkDelta3CPUKVCompressor(ChunkDelta3KVCompressor):\n    \"\"\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\n\n    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\n    that D2H event and encodes directly from the host tensor into persistent\n    physical slots, keeping encode kernels off the fused-MM critical path.\n    \"\"\"\n\n    _USES_GPU_COMPRESS = False\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n            raise RuntimeError(\n                \"ChunkDelta3CPUKVCompressor requires the CPU-enabled \"\n                \"tp3_cd3_ext\")\n        super().__init__(comp_stream)\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # Grace serving usually produces only eight newly-full blocks per\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n        # series; eight small teams instead pipeline independent layers across\n        # the same CPU budget.  Retain the established one-worker x86 default.\n        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        compression_cpu_count = len([\n            cpu for cpu in os.sched_getaffinity(0)\n            if cpu >= self._reserve_cores])\n        default_omp_threads = str(max(\n            1, (compression_cpu_count + self._n_workers - 1)\n            // self._n_workers))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._timing_raw_wait = 0.0\n        self._timing_decode_wait = 0.0\n        self._timing_encode = 0.0\n        self._timing_count = 0\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n            if self.kv_compressor is not None:\n                k_cache = DualMemoryLoader.primary_k_caches[0]\n                block_shape = tuple(k_cache.shape[1:])\n                block_size = k_cache.shape[1]  # tokens per block\n                # Host pools must cover ALL block_ids for persistent\n                # block_id-indexed compressed storage.\n                num_primary_blocks = k_cache.shape[0]\n                # GPU staging pools only need per-iteration capacity.\n                max_iter_blocks = (\n                    -(- self.max_num_batched_tokens // block_size)\n                    + self.batch_size\n                )\n                # Use pre-allocated hugepage pools from vllm cache engine\n                # if available (allocated before hugepages are exhausted).\n                pre_pools = getattr(DualMemoryLoader, 'zipserv_host_pools', None)\n                self.kv_compressor.warmup_kv_buffers(\n                    block_shape, num_primary_blocks, self.n_layers,\n                    max_gpu_blocks=max_iter_blocks,\n                    max_gpu_decomp_blocks=num_primary_blocks,\n                    huge_page_allocator=self.huge_page_allocator,\n                    pre_allocated_host_pools=pre_pools)\n                # Init C++ compress worker threads (D2H + compress)\n                n_compress_workers = int(os.getenv(\n                    \"TIERED_SERVE_KV_COMPRESS_WORKERS\", str(os.cpu_count() - 10)))\n                self.kv_compressor.init_kv_compress_workers(\n                    n_compress_workers, max_iter_blocks, self.n_layers)\n\n        # Startup has finished its CPU-heavy checkpoint copies and\n        # torch.compile work.  Constrain only the engine main thread's ATen\n        # OpenMP team now, before graph capture / the first serving KV encode.\n        # P4Flat's async worker is a different OpenMP master and explicitly\n        # installs its dedicated team size on its first encode, so it remains\n        # at TIERED_SERVE_KV_COMPRESS_OMP_THREADS (56 by default).\n        if os.getenv(\"TIERED_SERVE_OMP_PHASE_SWITCH\", \"0\") == \"1\":\n            main_threads = max(1, int(os.getenv(\n                \"TIERED_SERVE_MAIN_OMP_THREADS\", \"1\")))\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n                'cd': torch.empty(max_gpu_blocks * cdb, dtype=torch.uint8).pin_memory(),\n                # Device exception count, D2H'd with the payload (compress_lean\n                # returns it on-device so the call stays sync-free).\n                'ec': torch.empty(1, dtype=torch.int32).pin_memory(),\n            }\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            specs = {\n                'blob':       ((host_n, blob_stride), torch.uint8),\n                'total_size': ((host_n,),               torch.int32),\n                'exc_cnt':    ((host_n,),               torch.int32),\n                'is_raw':     ((host_n,),               torch.uint8),\n                # Occupancy: number of decoded rows for this slot (== M_b for a\n                # full block).  Read by decode to size comp.M / the raw view.\n                'valid_rows': ((host_n,),               torch.int32),\n            }\n            pool = {}\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(*shape, dtype=dtype,\n                                    device='cpu').pin_memory()\n                pool[name] = t\n            # Default to full-height decode; partial encodes overwrite per slot.\n            pool['valid_rows'].fill_(M_b)\n            # Zero the meta so an un-encoded / not-yet-written slot reads as a\n            # bounded empty block instead of torch.empty garbage.  The decode\n            # sizes the exception patch-kernel grid from int(exc_cnt[slots].max())\n            # and the blob length from total_size; garbage there → out-of-bounds\n            # grid → cudaErrorIllegalAddress (manifested on the slower CPU-encode\n            # path which can race the decode of a freshly-(re)assigned slot).\n            pool['exc_cnt'].zero_()\n            pool['is_raw'].zero_()\n            pool['total_size'].zero_()\n         