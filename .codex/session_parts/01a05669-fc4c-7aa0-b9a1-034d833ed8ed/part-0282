elf._decode_block_ids_np = None\n        self._decode_block_ids_gpu = None\n        self._decode_slots_np = {}\n        self._decode_slots_gpu = {}\n        self._decode_generation = {layer: 0 for layer in range(n_layers)}\n        self._decode_filter_active = None\n        self._decode_filter_limit = None\n        self._decode_filter_candidates = None\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        # The indexed decoder writes directly into the destination KV cache.\n        # Keeping a full raw-BF16 intermediate used to add another read+write\n        # of every decoded byte and a separate advanced-indexing kernel.\n        self._bf16_decomp_out = {}\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n            for layer in range(n_layers)}\n        self._kv_slot_np = {\n            layer: self._kv_slot[layer].numpy()\n            for layer in range(n_layers)}\n        self._kv_slot_block = {\n            layer: [-1] * host_n for layer in range(n_layers)}\n        self._kv_active_count = {\n            layer: 0 for layer in range(n_layers)}\n        self._kv_free_heap = {layer: [] for layer in range(n_layers)}\n        self._kv_free_slots = {layer: set() for layer in range(n_layers)}\n        self._kv_dec_h2d = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Give CPU workers a completed initial event for layers that have not\n        # loaded persistent compressed data yet.\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for event in self._kv_dec_h2d:\n                event.record(self.batch_decomp_stream)\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape