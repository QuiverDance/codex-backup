   layout = {}\n        offset = 0\n        for name, width, dtype, alignment in (\n            (\"codes\", self._code_bytes, torch.uint8, 1),\n            (\"sign_mantissa\", self._block_numel, torch.uint8, 1),\n            (\"thread_bases\", self._base_bytes, torch.uint8, 1),\n            (\"tile_exception_offsets\", self._tiles_per_block + 1,\n             torch.int32, 4),\n            (\"entries20x3\", self._packed_capacity, torch.int64, 8),\n            (\"num_exceptions\", 1, torch.int32, 4),\n        ):\n            offset = _align_up(offset, alignment)\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\n            layout[name] = (offset, nbytes, width, dtype)\n            offset += nbytes\n        self._blob_stride = _align_up(offset, 128)\n        self._blob_layout = layout\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            for page_type in (\"kv\", \"weight\"):\n                try:\n                    return huge_page_allocator.allocate(\n                        (numel,), (1,), dtype, page_type=page_type).view(shape)\n                except (MemoryError, ValueError):\n                    pass\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _pool(self, rows: int, device: str, huge_page_allocator=None,\n              blob_backed: bool = True) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        if not blob_backed and device == \"cuda\":\n            return {\n                name: torch.empty(shape, dtype=dtype, device=\"cuda\")\n                for name, (shape, dtype) in specs.items()\n            }\n        if not blob_backed:\n            return {\n                name: self._alloc_host_tensor(\n                    shape, dtype, huge_page_allocator)\n                for name, (shape, dtype) in specs.items()\n            }\n\n        if device == \"cuda\":\n            blob = torch.empty(\n                (rows, self._blob_stride), dtype=torch.uint8, device=\"cuda\")\n        else:\n            blob = self._alloc_host_tensor(\n                (rows, self._blob_stride), torch.uint8,\n                huge_page_allocator)\n        pool = {\"blob\": blob}\n        for name, (offset, nbytes, width, dtype) in self._blob_layout.items():\n            view = blob[:, offset:offset + nbytes]\n            if dtype != torch.uint8:\n                view = view.view(dtype)\n            pool[name] = view[:, 0] if name == \"num_exceptions\" else view\n            assert pool[name].shape == specs[name][0]\n        return pool\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._build_blob_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_comp_pool = (\n            {\n                \"k\": self._pool(\n                    max_gpu_blocks + 1, \"cuda\", blob_backed=False),\n                \"v\": self._pool(\n                    max_gpu_blocks + 1, \"cuda\", blob_backed=False),\n            }\n            if self._USES_GPU_COMPRESS else {}\n        )\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        self._identity_slots_gpu = torch.arange(\n            max_gpu_decomp_blocks + 1, dtype=torch.int32, device=\"cuda\")\n        self._decode_block_ids_np = None\n        self._decode_block_ids_gpu = None\n        self._decode_slots_np = {}\n        self._decode_slots_gpu = {}\n        self._decode_generation = {layer: 0 for layer in range(n_layers)}\n        self._decode_filter_active = None\n        self._decode_filter_limit = None\n        self._decode_filter_candidates = None\n        self._decode_filtered = {}\n        self._dec