lot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool[\"blob\"][dst_slot].copy_(pool[\"blob\"][src_slot])\n\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\n        self._decode_generation[layer_id] = (\n            self._decode_generation.get(layer_id, 0) + 1)\n        self._decode_filtered.pop(layer_id, None)\n        self._decode_plans.pop(layer_id, None)\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_table = self._kv_slot_np[layer_id]\n        previous = int(slot_table[bid])\n        if previous >= 0:\n            return previous\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot = -1\n        while heap:\n            candidate = heapq.heappop(heap)\n            if candidate in free_set:\n                free_set.discard(candidate)\n                slot = candidate\n                break\n        if slot < 0:\n            slot = self._kv_active_count[layer_id]\n            if slot >= len(self._kv_slot_block[layer_id]):\n                raise RuntimeError(\n                    f\"ChunkDelta3 KV persistent slot pool full for \"\n                    f\"layer={layer_id}\")\n            self._kv_active_count[layer_id] = slot + 1\n        slot_table[bid] = slot\n        self._kv_slot_block[layer_id][slot] = bid\n        self._invalidate_decode_plan(layer_id)\n        return slot\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    @staticmethod\n    def _slot_runs(slots: list[int]):\n        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n        if not slots:\n            return\n        row_begin = 0\n        slot_begin = slots[0]\n        previous = slot_begin\n        for row in range(1, len(slots)):\n            slot = slots[row]\n            if slot != previous + 1:\n                yield row_begin, row, slot_begin\n                row_begin = row\n                slot_begin = slot\n            previous = slot\n        yield row_begin, len(slots), slot_begin\n\n    def _batch_h2d(self, destinations: list[torch.Tensor],\n                   sources: list[torch.Tensor]) -> None:\n        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n        if not destinations:\n            return\n        if len(destinations) == 1:\n            destinations[0].copy_(sources[0], non_blocking=True)\n            return\n        extension = self._batch_ext\n        if extension is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as extension\n            except Exception:\n                extension = False\n            self._batch_ext = extension\n        if extension and hasattr(extension, \"batch_memcpy\"):\n            extension.batch_memcpy(\n                destinations, sources,\n                torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(\n                destinations, sources, non_blocking=True)\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        num_primary = gpu_k.shape[0]\n        block_ids = [int(bid) for bid in block_ids\n                     if 0 <= int(bid) < num_primary]\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV encode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_blocks}\")\n        slots = [self._assign_kv_slot(layer_id, bid) for bid in block_ids]\n        bid_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=gpu_k.device)\n\n        with torch.cuda.stream(self.comp_stream):\n            k_blocks = gpu_k[bid_gpu].reshape(\n                n, self._M_b, self._K_b).contiguous()\n            v_blocks = gpu_v[bid_gpu].reshape(\n                n, self._M_b, self._K_b).contiguous()\n            for kv, blocks in ((\"k\", k_blocks), (\"v\", v_blocks)):\n                pool = self._gpu_comp_pool[kv]\n                _cd3_ext.compress_chunk_delta3_batched(\n                    blocks,\n                    pool[\"codes\"][:n],\n                    pool[\"sign_mantissa\"][:n],\n                    pool[\"thread_bases\"][:n],\n                    pool[\"tile_exception_offsets\"][:n],\n                    pool[\"entries20x3\"][:n],\n                    pool[\"num_exceptions\"][:n],\n                )\n                host = self._host_pools[layer_id][kv]\n                # Physical slots are persistent and may contain holes.  Keep\n                # the copies asynchronous on comp_stream; the event below\n                # gates publication and later slot reuse.\n                for row_begin, row_end, slot_begin in self._slot_runs(slots):\n                    length = row_end - row_begin\n                    for name in self._FIELDS:\n  