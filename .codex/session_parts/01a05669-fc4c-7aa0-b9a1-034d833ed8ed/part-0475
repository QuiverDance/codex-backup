       return candidates\n\n        slots = self._kv_slot_np[layer_id][candidates]\n        slot_ok = slots >= 0\n        if not bool(slot_ok.any()):\n            return candidates\n        probe_positions = np.flatnonzero(slot_ok)\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        overflow = (\n            pools[\"k\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        overflow |= (\n            pools[\"v\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        if not bool(overflow.any()):\n            return candidates\n\n        fallback_positions = probe_positions[overflow]\n        fallback_ids = np.ascontiguousarray(\n            candidates[fallback_positions], dtype=np.int64)\n        self._decode_raw_from_secondary(\n            layer_id, fallback_ids, k_cache, v_cache)\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[fallback_positions] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(\n            self, layer_id: int, block_ids: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n        if layer_id >= len(DualMemoryLoader.kv_caches):\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no DualMemoryLoader cache\")\n        secondary = getattr(\n            DualMemoryLoader.kv_caches[layer_id], \"secondary_kv\", None)\n        if secondary is None:\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no secondary_kv\")\n\n        host_ids = torch.from_numpy(block_ids)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            device_ids = host_ids.to(k_cache.device, non_blocking=True)\n            k_cache.index_copy_(\n                0, device_ids,\n                secondary[0][host_ids].to(\n                    k_cache.device, non_blocking=True))\n            v_cache.index_copy_(\n                0, device_ids,\n                secondary[1][host_ids].to(\n                    v_cache.device, non_blocking=True))\n\n    def _build_decode_plan(self, layer_id: int,\n                           block_ids: np.ndarray,\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        slot_table = self._kv_slot_np[layer_id]\n        slots_np = np.ascontiguousarray(\n            slot_table[block_ids], dtype=np.int32)\n        if bool((slots_np < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        # The production steady state is dense: all active physical slots are\n        # requested.  Skip Python list conversion and run construction there.\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n        slot_runs = None\n        if dense:\n            packed_h2d = False\n        else:\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\n            max_runs = max(0, int(os.getenv(\n                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n            packed_h2d = (\n                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n                or hwm > self._max_gpu_decomp_blocks + 1)\n\n        slots_gpu = (\n            self._identity_slots_gpu[:n]\n            if packed_h2d else torch.as_tensor(\n                slots_np, dtype=torch.int32, device=k_cache.device))\n        block_ids_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=k_cache.device)\n        copy_destinations_ring =