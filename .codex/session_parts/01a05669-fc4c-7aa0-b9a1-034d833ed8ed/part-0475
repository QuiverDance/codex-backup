tch_ext = None      # cached zipserv_ext for batch_memcpy\n        # Decode-arg CPU-dispatch trims (the per-layer Python/torch op count is\n        # what stalls before_replay — ~20 dispatches x n_layers showed up as\n        # ~2 ms of forward-thread CPU before the blob batchmemcpy in nsys):\n        #  - grid sizing uses STATIC caps (M_b / exc_cap) instead of four\n        #    per-layer pinned .max() reductions; the per-block device arrays\n        #    still bound each block's work in-kernel.\n        #    TIERED_SERVE_KV_DECODE_VALIDATE=1 restores the exact maxes\n        #    (tighter grids + full corrupt-meta detection) for debugging.\n        #  - the block-id vector is identical for every layer of a step, so\n            # total_size[slot] bytes so the padding is harmless.  Meta writes are\n            # contiguous slice assignments (no fancy-index scatter).\n            # Compress staging rows are max_comp_size wide; the host pool uses the\n            # reduced blob_stride.  Copy only the first blob_stride bytes of each\n            # row (the blob lives in [0:total_size] <= blob_stride) — one strided\n            # DMA into the dense host rows.\n            host_pool['blob'][lo:lo + n].copy_(\n                c['blob'][:n, :host_pool['blob'].shape[1]], non_blocking=True)\n            ts_h.copy_(c['ts'][:n], non_blocking=True)\n            ec_h.copy_(c['ec'][:n], non_blocking=True)\n            ir_h.copy_(c['ir'][:n], non_blocking=True)\n            vr_h.copy_(c['vr'][:n], non_blocking=True)\n            self.comp_stream.synchronize()\n            overflow = ts_h.numpy() > self._blob_stride\n            host_pool['total_size'][lo:lo + n] = ts_h\n            host_pool['exc_cnt'][lo:lo + n] = ec_h\n            host_pool['is_raw'][lo:lo + n] = ir_h\n            host_pool['valid_rows'][lo:lo + n] = vr_h\n            if overflow.any():\n                rows = lo + np.flatnonzero(overflow)\n                host_pool['total_size'].numpy()[rows] = 0\n            