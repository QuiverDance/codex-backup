m.cuda_stream,\n        )\n\n    def _submit_split_plan(\n            self, layer_id: int, plan: Dict[str, Any],\n            k_cache: torch.Tensor, v_cache: torch.Tensor,\n            first_chunk: bool) -> None:\n        ring_slot = self._dec_blob_ring_idx & 1\n        self._dec_blob_ring_idx += 1\n        gpu_pool = self._gpu_decomp_pool_ring[ring_slot]\n        h2d_stream = self.load_kv_stream\n        h2d_stream.wait_event(self._dec_blob_consumed[ring_slot])\n        if self._tb and first_chunk:\n            self._kv_h2d_begin[layer_id].record(h2d_stream)\n        self._batch_h2d(\n            plan[\"copy_destinations_ring\"][ring_slot],\n            plan[\"copy_sources\"], h2d_stream)\n        self._kv_dec_h2d[layer_id].record(h2d_stream)\n\n        self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\n        if self._tb and first_chunk:\n            self._kv_decode_begin[layer_id].record(\n                self.batch_decomp_stream)\n        self._launch_decode(gpu_pool, plan, k_cache, v_cache)\n        self._dec_blob_consumed[ring_slot].record(\n            self.batch_decomp_stream)\n\n    def _decompress_blocks_pipelined(\n            self, layer_id: int, block_ids: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\n        \"\"\"Overlap each blob chunk's decode with the next chunk's H2D.\"\"\"\n        generation = self._decode_generation.get(layer_id, 0)\n        chunk_blocks = min(\n            self._kv_pipeline_chunk_blocks,\n            self._max_gpu_decomp_blocks)\n        cached = self._pipeline_decode_plans.get(layer_id)\n        if (cached is None or cached[\"block_ids\"] is not block_ids\n                or cached[\"generation\"] != generation\n                or cached[\"chunk_blocks\"] != chunk_blocks):\n            plans = []\n            with torch.cuda.stream(self.batch_decomp_stream):\n                for start in range(0, len(block_ids), chunk_blocks):\n                    chunk = block_ids[start:start