ta3 KV decode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_decomp_blocks}\")\n        if self._kv_active_count[layer_id] <= 0:\n            return\n        if not isinstance(block_ids, np.ndarray):\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n        plan = self._decode_plans.get(layer_id)\n        generation = self._decode_generation.get(layer_id, 0)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            if (plan is None or plan[\"block_ids\"] is not block_ids\n                    or plan[\"generation\"] != generation):\n                plan = self._build_decode_plan(\n                    layer_id, block_ids, k_cache)\n                self._decode_plans[layer_id] = plan\n            self._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n            storage_rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                self._gpu_decomp_pool[\"k\"][\"blob\"][:storage_rows],\n                self._gpu_decomp_pool[\"v\"][\"blob\"][:storage_rows],\n                plan[\"slots_gpu\"],\n                plan[\"block_ids_gpu\"],\n                k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n                v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n                self._packed_capacity,\n            )\n            # A CPU encoder may now overwrite persistent host slots only after\n            # every K/V H2D read queued above has retired.  Recording at the\n            # end is conservative (it also waits for decode) but remains off\n            # the forward thread and avoids any host synchronization.\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n\n_cudart_lib = None\n_cudart_lock = threading.Lock()\n\n\ndef _get_cudart():\n    global _cudart_lib\n    if _cudart_lib is not None:\n        return _cudart_lib\n    with _cudart_lock:\n        if _cudart_lib is None:\n            lib = None\n            candidates = sorted(glob.glob(os.path.join(\n                os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n            for candidate in candidates:\n                try:\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0, block_ids, (output_k, output_v))\n\n    # Populate device blobs, decode metadata, and the CD3 steady-state plan.\n    production()\n    torch.cuda.synchronize()\n\n    if args.codec == \"chunk_delta3\":\n        from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n        plan = compressor._decode_plans[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n\n        def resident_decode():\n            rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                compressor._gpu_decomp_pool[\"k\"][\"blob\"][:rows],\n                compressor._gpu_decomp_pool[\"v\"][\"blob\"][:rows],\n                plan[\"slots_gpu\"], plan[\"block_ids_gpu\"],\n                output_k.view(args.blocks, 128, 128),\n                output_v.view(args.blocks, 128, 128),\n                compressor._packed_capacity)\n    else:\n        blob_stride, block_numel, k_width, max_rows, max_exc = \\\n            compressor._fast_const\n        gi = compressor._gi_dev_ring[0]\n        gu = compressor._gu_dev_ring[0]\n        gb = compressor._gb_dev_ring[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                [compressor._gpu_dec_blob[:args.blocks],\n                 compressor._gpu_dec_blob_v[:args.blocks]],\n                [compressor._host_pools[0][\"k\"][\"blob\"][:args.blocks],\n                 compressor._host_pools[0][\"v\"][\"blob\"][:args.blocks]])\n\n        def resident_decode():\n            compressor._invoke_decode_layer(\n                compressor._gpu_dec_blob,\n                compressor._gpu_dec_blob_v,\n                blob_stride, gi, gu, gb, args.blocks,\n                output_k, output_v, block_numel, k_width,\n                max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbytes + host_v.nbytes) / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    print(\n        f\"codec={args.codec} blocks={args.blocks} cpu_encode={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n    compressor.stop_kv_compress_workers()\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05bf8-a0b0-7993-b9d1-be0e42e2d99f","create_time":1788249425.2119608}}}
