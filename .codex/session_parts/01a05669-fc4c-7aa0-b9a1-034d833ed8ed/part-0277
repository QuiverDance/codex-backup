    ``_decompress_blocks`` on ``batch_decomp_stream``.\n2060:        enqueued on ``batch_decomp_stream`` in ``start_kv_h2d_persistent``.\n2074:    \"\"\"Locate a libcudart to call cudaEventSynchronize from worker threads.\n2106:        lib.cudaEventSynchronize(ctypes.c_void_p(int(handle)))\n2111:class P4FlatCPUKVCompressor(P4FlatKVCompressor):\n2225:            done = threading.Event()\n2339:    # gpu_direct path is not supported on this subclass — it is the\n2596:        # Keep the pending entry visible while Event.wait() releases the GIL.\n2672:    def decompress_batch(self, layer_id: int, active_block_ids: list,\n        # the main thread is NOT host-synchronized and per-layer decodes pipeline\n        # (prefetch overlaps compute).  Double-buffering is GPU-HBM only.\n        self._gpu_dec_blob = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        self._gpu_dec_blob_v = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        # 2-slot blob ring for the load_kv_stream split (slot 0 reuses the\n        # buffers above; slot 1 is the extra double-buffer).  The H2D writes a\n        # slot on load_kv_stream and the decode reads it on batch_decomp_stream;\n        # the per-slot ``consumed`` event gates the NEXT reuse so the two\n        # streams overlap (H2D L+1 ∥ decode L) without racing the staging blob.\n        self._dec_blob_ring = [\n            self._gpu_dec_blob,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_v_ring = [\n            self._gpu_dec_blob_v,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for _e in self._dec_blob_consumed:\n            _e.record()\n        # Per-layer \"decode H2D of host['blob'] complete\" events — external=True\n        # so the C++ worker can wait on .cuda_event, enable_timing=True so the\n        # breakdown can elapsed_time() them.  Paired with _kv_h2d_begin (right\n        # before the blob H2D) to isolate the compressed-KV H2D from decode.\n        self._kv_dec_h2d = [torch.cuda.Event(enable_timing=True, external=True)\n                            for _ in range(n_layers)]\n        self._kv_h2d_begin = [torch.cuda.Event(enable_timing=True,\n                                               external=True)\n                              for _ in range(n_layers)]\n        # Tight decode-kernel begin.  _kv_dec_h2d is recorded on the H2D\n        # producer stream, so elapsed_time(_kv_dec_h2d, decode_end) also\n        # includes any older work / WAR wait already queued on\n        # batch_decomp_stream.  Record on the consumer stream after those waits\n        # and immediately before the codec kernels to measure KVDecomp itself.\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Pre-record once so elapsed_time() on a layer that doesn't decode this\n        # step sees a (stale, pre-init) recording instead of raising.\n        for _e in self._kv_dec_h2d:\n            _e.record()\n        for _e in self._kv_h2d_begin:\n            _e.record()\n        for _e in self._kv_decode_begin:\n            _e.record()\n\n        # Async metadata-staging ring (see __init__).  Each decode chunk gathers\n        # its per-block meta into one ring slot's pinned buffers (contiguous\n        # prefixes -> one valid async H2D per group, no stack, no pageable temp)\n        # and records an event; reusing a slot first waits on that event, so the\n        # CPU never overwrites a buffer whose H2D is still in flight (the\n        # documented torn-meta IMA).  ``cap`` = the GPU decomp staging width, so\n        #