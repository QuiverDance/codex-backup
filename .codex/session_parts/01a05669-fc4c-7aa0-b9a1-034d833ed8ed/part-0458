e raw sign|mantissa byte stream stays in HBM.  On a\n# GH200 (Addressing Mode: ATS) the fused decode+GEMM kernel then reads the\n# exponent payload straight from LPDDR over the NVLink-C2C link into the SMs —\n# no HBM staging copy.  This mirrors the \"Exp ATS\" placement of\n# ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py\n# (HugepagePool + device-pointer \"DHA\" tensors) and cpu_hbm_test.py's\n# numa_alloc_onnode + cudaHostRegister C2C path.\n#\n# Per-codec split: keep the mantissa attr in HBM, move every other compressed\n# buffer the fused kernel reads to ATS.  target_fn locates the object whose\n# attrs the kernel reads (the native struct for p4flat, the wrapper otherwise).\n_ATS_PLAN = {\n    \"p4flat\":    (lambda comp: comp._c, \"sign_mantissa\",\n                  (\"codes\", \"headers\", \"subtile_codec\",\n                   \"exc_indices\", \"exc_values\")),\n    \"ublb_flat\": (lambda comp: comp, \"lb_raw\",\n                  (\"code_stream\", \"palette\", \"exc_idx\", \"exc_ub\")),\n    \"zipserv\":   (lambda comp: comp, \"sign_mantissa\",\n                  (\"compressed_full\", \"bitmap1\", \"bitmap2\", \"bitmap3\",\n                   \"tile_offsets_median\", \"tile_offsets_global\")),\n    \"chunk_delta3\": (lambda comp: comp._c, \"sign_mantissa\",\n                     (\"codes\", \"thread_bases\", \"entries20x3\")),\n}\n\n_DHA_EXT = None\n\n\ndef _get_dha_ext():\n    \"\"\"JIT ext wrapping a raw CUDA device pointer as a (no-op-deleter) Tensor.\n\n    Lifted verbatim from ats-benchmarks' nvcomp_h2d_vs_ats._get_dha_ext: builds\n    a CUDA at::Tensor over an externally-owned device pointer so a hugepage /\n    NUMA LPDDR region (mapped to the GPU via cudaHostGetDevicePointer) can be\n    handed to the codec kernels exactly like an HBM tensor (.is_cuda == True).\n    \"\"\"\n    global _DHA_EXT\n    if _DHA_EXT is not None:\n        return _DHA_EXT\n    from torch.utils.cpp_extension import load_inline\n    cpp_src = r\"\"\"\n#include <pybind11/pybind11.h>\n#include <pybind11/stl.h>\n#include <torch/extension.h>\nnamespace py = pybind11;\nat::Tensor dha_allocate(\n    uint64_t ptr, int64_t nbytes,\n    const std::vector<int64_t>& sizes,\n    const std::vector<int64_t>& strides,\n    const at::ScalarType dtype) {\n  const at::Device device(at::kCUDA, 0);\n  auto noop_deleter = [](void*) {};\n  c10::DataPtr data_ptr(reinterpret_cast<void*>(ptr), nullptr, noop_deleter, device);\n  auto storage_impl = c10::make_intrusive<c10::StorageImpl>(\n      c10::StorageImpl::use_byte_size_t(), nbytes, std::move(data_ptr), nullptr, false);\n  at::Tensor tensor = at::empty({0}, at::TensorOptions().dtype(dtype).device(device));\n  tensor.set_(storage_impl, 0, sizes, strides);\n  return tensor;\n}\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n  m.def(\"dha_allocate\", &dha_allocate,\n        py::arg(\"ptr\"), py::arg(\"nbytes\"), py::arg(\"sizes\"),\n        py::arg(\"strides\"), py::arg(\"dtype\"));\n}\n\"\"\"\n    _DHA_EXT = load_inline(\n        name=\"fusegemm_dha_ext\", cpp_sources=[cpp_src],\n        extra_cflags=[\"-O3\", \"-std=gnu++17\"], verbose=False)\n    return _DHA_EXT\n\n\ndef _hugetlbfs_pagesize(path):\n    \"\"\"Return the hugetlbfs page size (bytes) backing ``path``, or None.\"\"\"\n    try:\n        with open(\"/proc/mounts\") as f:\n            best = None\n            for line in f:\n                parts = line.split()\n                if len(parts) < 3 or parts[2] != \"hugetlbfs\":\n                    continue\n                mnt = parts[1]\n                if not os.path.abspath(path).startswith(os.path.abspath(mnt)):\n                    continue\n                for opt in parts[3].split(\",\"):\n                    if opt.startswith(\"pagesize=\"):\n                        sz = opt.split(\"=\", 1)[1].upper()\n                        mult = {\"K\": 1 << 10, \"M\": 1 << 20, \"G\": 1 << 30}.get(\n                            sz[-1], 1)\n                        best = int(sz[:-1]) *