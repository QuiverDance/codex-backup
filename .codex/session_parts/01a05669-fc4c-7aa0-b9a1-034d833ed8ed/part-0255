dency layout, so the SAME codec has different thresholds in different\\n# configs. The values here are for the frozen_split configs (cao family);\\n# offload_compressed configs use _OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS.\\n#\\n# Two effects make frozen_split (e.g. cao) carry a HIGH threshold:\\n#   * frozen_split decode is EXP-ONLY (sm stays HBM) — far cheaper than the\\n#     offload full-blob decompress, so T_decomp is small.\\n#   * with all layers frozen_split, every layer loads raw (large T_load_raw).\\n#   => big slack => large threshold.\\n#   codec      thr    source\\n#   p4flat     1330   hand-calibrated 400ms cao-p4flat operating point\\n#                     (exp-only decomp 72 / load_raw 364 -> slack 292).\\n#   zipserv    1107   cao slack model: load_raw 364 / exp-only decomp 121 ->\\n#                     slack 243 -> 1330*243/292 = ~1107. zipserv's triple-\\n#                     bitmap exp decode is HEAVIER than p4flat's palette\\n#                     (121 vs 72ms), so it crosses over to raw_bf16 earlier.\\n#   ublb_flat  1367   } synthetic isolated bench (palette/data-independent);\\n#   p4d16      1206   } refine with the slack model if used under a real config.\\n#   dietgpu     670   STALE synthetic. ANS+data-dependent — re-derive.\\n_PREFILL_ALT_MAX_CHUNK_DEFAULTS = {\\n    \\\"p4flat\\\": 1330,\\n    \\\"ublb_flat\\\": 1367,\\n    \\\"p4d16\\\": 1206,\\n    \\\"zipserv\\\": 1107,   # cao (frozen_split): slack 243 (decomp 121) -> ~1107\\n    \\\"dietgpu\\\": 670,    # TODO: re-derive with the slack model on a real config\\n}\\n\\n# Codecs whose decompress is BIT-EXACT w.r.t. the original BF16 weight, so\\n# decoding them during prefill is lossless. FP8 cells (zipserv_fp8, dietgpu_fp8,\\n# p3flat_fp8) quantize, so offload_compressed prefill must keep their\\n# uncompressed copy (see the \\\"for accuracy\\\" branch in _get_weight_source).\\n_LOSSLESS_OFFLOAD_CODECS = frozenset({\\n    \\\"zipserv\\\", \\\"dietgpu\\\", \\\"zipserv_bf16\\\", \\\"dietgpu_bf16\\\",\\n    \\\"p4flat\\\", \\\"p4d16\\\", \\\"ublb_flat\\\",\\n    \\\"chunk_delta3\\\",\\n})\\n\\n# Phase-adaptive prefill for offload_compressed weights (see _get_weight_source).\\n# offload_compressed already keeps BOTH a compressed and an uncompressed LPDDR\\n# copy; today prefill ALWAYS H2Ds the uncompressed one (no chunk gating). Below\\n# this per-codec chunk threshold, prefill instead H2Ds + FULL-decompresses the\\n# compressed copy. Same slack model as the frozen_split knob\\n# (thr = (T_load_raw - T_decomp)/T_gemm_per_token) but with DISTINCT inputs:\\n# offload does the FULL-blob decompress (vs frozen_split's cheap exp-only), so\\n# T_decomp is much larger, AND offload configs (e.g. flexgen-comp) typically\\n# keep half the layers frozen_uncompressed, so fewer layers load -> smaller\\n# T_load_raw. Both shrink the slack -> a MUCH lower threshold than frozen_split.\\n#   codec    thr   source\\n#   zipserv  384   flexgen-comp slack model: load_raw 182 / full decomp 109 ->\\n#                  slack 73 -> 384 (vs cao's 1330 — same codec, different config).\\n# Codecs without an entry resolve to 0 (disabled = always-uncompressed prefill,\\n# i.e. unchanged behaviour). Per-config; override via\\n# TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK (same \\\"<codec>=<n>,...|<int>\\\" syntax).\\n_OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS = {\\n    \\\"zipserv\\\": 384,   # flexgen-comp (offload, full decompress -> small slack)\\n}\\n\\n_ENV_FROZEN_DETAILED_NVTX = (\\n    os.getenv(\\\"TIERED_SERVE_FROZEN_DETAILED_NVTX\\\", \\\"0\\\") == \\\"1\\\")\\n_ENV_WLOAD_GRAPH = os.getenv(\\\"TIERED_SERVE_WLOAD_GRAPH\\\", \\\"0\\\") == \\\"1\\\"\\n_ENV_WLOAD_GRAPH_SEPARATE = (\\n    os.getenv(\\\"TIERED_SERVE_WLOAD_GRAPH_SEPARATE\\\", \\\"0\\\") == \\\"1\\\")\\n_ENV_ANY_WLOAD_GRAPH = _ENV_WLOAD_GRAPH or _ENV_WLOAD_GRAPH_SEPARATE\\n\\n\\nclass FrozenSplitMixin:\\n\\n    def _shrink_dietgpu_decompress_workspaces(self) -> None:\\n        \\\"\\\"\\\"Shrink every DietGPU weight compressor's ANS workspace to the\\n        decompress-only size now that all weights are compressed.\\n\\n        The workspace is auto-sized for the compress peak (~1.4x the\\n        largest weight, e.g. ~627 MiB for Llama-70B's gate_up_proj).  ANS\\n        *decompress* only carves an O(numInBatch) decode table (~KB,\\n        independent of the stream size), so holding the compress-sized\\n        buffer for the whole serving run wastes ~0.6 GiB per DietGPU\\n        instance.  Reclaiming it before KV-cache / CUDA-graph allocation\\n        is often the difference between fitting and OOM on dietgpu-heavy\\n        plans.  ``compress`` self-restores the large workspace if a\\n        runtime reconfigure compresses again.\\n\\n        Tunable / disable via ``TIERED_SERVE_DIETGPU_DECOMPRESS_WS_MIB``\\n        (default 16 MiB; <= 0 disables the shrink).\\n        \\\"\\\"\\\"\\n        if not DualMemoryLoader.use_weight_comp:\\n            return\\n        target = int(\\n            os.getenv(\\\"TIERED_SERVE_DIETGPU_DECOMPRESS_WS_MIB\\\", \\\"16\\\")) << 20\\n        if target <= 0:\\n            return\\n        seen: set = set()\\n        candidates = [\\n            getattr(self, \\\"_compressor_split\\\", None),\\n            getattr(self, \\\"_compressor_offload\\\", None),\\n        ]\\n        candidates += list(\\n            getattr(self, \\\"_compressors_by_backend\\\", {}).values())\\n        total_freed = 0\\n        for comp in candidates:\\n            if comp is None or id(comp) in seen:\\n                continue\\n            seen.add(id(comp))\\n            fn = getattr(comp, \\\"shrink_workspace_for_decompress\\\", None)\\n            if fn is None:\\n                continue\\n            try:\\n                total_freed += fn(target)\\n            except Exception as e:  # never block startup on this optimisation\\n                logger.warning(\\n                    \\\"tiered-serve: DietGPU workspace shrink skipped for %s: %s\\\",\\n                    type(comp).__name__, e)\\n        if total_freed:\\n            gc.collect()\\n            torch.cuda.empty_cache()\\n            logger.info(\\n                \\\"tiered-serve: shrank DietGPU ANS workspace(s) to %d MiB \\\"\\n                \\\"(decompress-only), freed %.0f MiB HBM\\\",\\n                target >> 20, total_freed / (1 << 20))\\n\\n    # ------------------------------------------------------------------\\n    # frozen_split runtime transition helpers\\n    # ------------------------------------------------------------------\\n    # These reproduce the subset of _init_weights_per_layer's\\n    # frozen_split branch needed to introduce / tear down a frozen_split\\n    # cell at reconfigure time.  Split out so reconfigure_layer_residency\\n    # below stays readable.\\n    # ------------------------------------------------------------------\\n\\n    def _ensure_frozen_split_prereqs(self) -> None:\\n        \\\"\\\"\\\"Lazy-init the shared structures that init only creates when\\n        the initial YAML mentions frozen_split.\\\"\\\"\\\"\\n        if not hasattr(self, \\\"FROZEN_DECOMP_PARITY\\\"):\\n            self.FROZEN_DECOMP_PARITY = self.n_weight_buffers\\n        if not hasattr(self, \\\"FROZEN_STAGING_PARITY\\\"):\\n            self.FROZEN_STAGING_PARITY = self.FROZEN_DECOMP_PARITY\\n        if not hasattr(self, \\\"frozen_primary_buffer_pair\\\"):\\n            self.frozen_primary_buffer_pair = {}\\n        if not hasattr(self, \\\"frozen_primary_buffer\\\"):\\n            self.frozen_primary_buffer = {}\\n        if not hasattr(self, \\\"frozen_split_staging\\\"):\\n            self.frozen_split_staging = {}\\n        self._ensure_weight_compressor_lazy()\\n        if getattr(self, \\\"_compressor_split\\\", None) is None:\\n            self._compressor_split = (\\n                getattr(self, \\\"_compressor_offload\\\", None)\\n                or self.weight_compressor)\\n\\n    def _ensure_frozen_primary_buffer(self, name: str) -> None:\\n        \\\"\\\"\\\"Alias frozen_primary_buffer_pair[name] onto _temp_buffers so\\n        the per-(layer, name) decompress output lands in the same\\n        physical pool the offload path already uses.\\\"\\\"\\\"\\n        if name in self.frozen_primary_buffer_pair:\\n            return\\n        self.frozen_primary_buffer_pair[name] = [\\n            self._temp_buffers[p][name]\\n            for p in range(self.FROZEN_DECOMP_PARITY)\\n        ]\\n        self.frozen_primary_buffer[name] = self._temp_buffers[0][name]\\n\\n    def _ensure_frozen_split_staging(self, name: str, info) -> None:\\n        \\\"\\\"\\\"Allocate / grow frozen_split_staging[name] so that every\\n        codec attribute fits.  Init does this once with a max-size scan;\\n        we grow incrementally as transitions add new tensors.\\\"\\\"\\\"\\n        excluded = (\\\"raw_bf16\\\",)\\n        needed = {\\n            attr: (buf.numel(), buf.dtype)\\n            for attr, buf in info.lpddr_buffers.items()\\n            if attr not in excluded\\n        }\\n        cur = self.frozen_split_staging.get(name)\\n        if cur is None:\\n            self.frozen_split_staging[name] = [\\n                {\\n                    attr: torch.empty(numel, dtype=dtype,\\n                                      device=self.primary_device)\\n                    for attr, (numel, dtype) in needed.items()\\n                }\\n                for _ in range(self.FROZEN_STAGING_PARITY)\\n            ]\\n            return\\n        for parity_dict in cur:\\n            for attr, (numel, dtype) in needed.items():\\n                existing = parity_dict.get(attr)\\n                if existing is None or existing.numel() < numel:\\n                    parity_dict[attr] = torch.empty(\\n                        numel, dtype=dtype, device=self.primary_device)\\n\\n    @staticmethod\\n    def _frozen_split_backend_meta(comped):\\n        \\\"\\\"\\\"Return (backend, lpddr_attrs, metadata) for SplitStorageInfo.\\n\\n        Mirrors the 8-way isinstance dispatch in\\n        _init_weights_per_layer at lines ~1543-1613.\\\"\\\"\\\"\\n        if isinstance(comped, RawExpCompressed):\\n            return (\\\"raw_exp\\\", (\\\"raw_exp\\\",),\\n                    {\\\"M\\\": comped.M, \\\"K\\\": comped.K})\\n        if isinstance(comped, CompressedDietGPUTensor):\\n            dietgpu_attrs = (\\n                (\\\"raw_exp\\\",)\\n                if (os.getenv(\\\"TIERED_SERVE_FROZEN_RAW_EXP\\\", \\\"0\\\") == \\\"1\\\"\\n                    and comped.raw_exp is not None)\\n                else SplitStorageInfo._DIETGPU_LPDDR_ATTRS)\\n            return (\\\"dietgpu\\\",\\n                    dietgpu_attrs,\\n                    {\\\"exp_compressed_size\\\": comped.exp_compressed_size,\\n                     \\\"M\\\": comped.M, \\\"K\\\": comped.K})\\n        if isinstance(comped, CompressedDietGPUFP8Tensor):\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05bb1-d779-7b20-8017-732dcf739181","create_time":1788245856.786093}}}
