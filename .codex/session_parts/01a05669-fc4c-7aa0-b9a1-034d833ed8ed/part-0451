d >> 2;\n    const int local_column = (thread & 3) * kElementsPerThread;\n    uint16_t* destination = output\n        + static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n        + tile_column * kTileDim + local_column;\n    auto* vectors = reinterpret_cast<ulonglong2*>(destination);\n    vectors[0] = make_ulonglong2(output0, output1);\n    vectors[1] = make_ulonglong2(output2, output3);\n}\n\n__device__ __forceinline__ void patch_tile_exceptions20x3(\n    const uint64_t* entries20x3,\n    const uint8_t* sign_mantissa,\n    const int32_t* tile_exception_offsets,\n    uint16_t* output,\n    int tile,\n    int thread,\n    int columns)\n{\n    const int tiles_per_row = columns / kTileDim;\n    const int tile_row = tile / tiles_per_row;\n    const int tile_column = tile - tile_row * tiles_per_row;\n    const int exception_begin = tile_exception_offsets[tile];\n    const int exception_count =\n        tile_exception_offsets[tile + 1] - exception_begin;\n    for (int local_exception = thread;\n         local_exception < exception_count;\n         local_exception += blockDim.x) {\n        const int64_t stream_index = exception_begin + local_exception;\n        const int64_t group = stream_index / 3;\n        const int slot = static_cast<int>(stream_index - group * 3);\n        const uint64_t packed = entries20x3[group];\n        const uint32_t entry = static_cast<uint32_t>(\n            (packed >> (slot * 20)) & 0xfffffu);\n        const int tile_position = static_cast<int>(entry & 0xfffu);\n        const uint8_t exponent = static_cast<uint8_t>(entry >> 12);\n        const int local_row = tile_position >> 6;\n        const int local_column = tile_position & 63;\n        const uint8_t sm = sign_mantissa[\n            static_cast<int64_t>(tile) * kTileElements + tile_position];\n        const int64_t output_index =\n            static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n            + tile_column * kTileDim + local_column;\n        output[