c_cast<uint16_t>(sign_mantissa & 0x7fu);\n}\n\n__device__ __forceinline__ uint8_t sign_mantissa_byte(\n    const uint4& packed,\n    int item)\n{\n    uint32_t word;\n    switch (item >> 2) {\n        case 0: word = packed.x; break;\n        case 1: word = packed.y; break;\n        case 2: word = packed.z; break;\n        default: word = packed.w; break;\n    }\n    return static_cast<uint8_t>(word >> ((item & 3) * 8));\n}\n\n__device__ __forceinline__ void append_output(\n    uint16_t value,\n    int item,\n    uint64_t& output0,\n    uint64_t& output1,\n    uint64_t& output2,\n    uint64_t& output3)\n{\n    const int lane = item & 3;\n    if (item < 4) {\n        output0 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else if (item < 8) {\n        output1 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else if (item < 12) {\n        output2 |= static_cast<uint64_t>(value) << (lane * 16);\n    } else {\n        output3 |= static_cast<uint64_t>(value) << (lane * 16);\n    }\n}\n\n__device__ __forceinline__ void store_output(\n    uint16_t* output,\n    int tile,\n    int thread,\n    int columns,\n    uint64_t output0,\n    uint64_t output1,\n    uint64_t output2,\n    uint64_t output3)\n{\n    const int tiles_per_row = columns / kTileDim;\n    const int tile_row = tile / tiles_per_row;\n    const int tile_column = tile - tile_row * tiles_per_row;\n    const int local_row = thread >> 2;\n    const int local_column = (thread & 3) * kElementsPerThread;\n    uint16_t* destination = output\n        + static_cast<int64_t>(tile_row * kTileDim + local_row) * columns\n        + tile_column * kTileDim + local_column;\n    auto* vectors = reinterpret_cast<ulonglong2*>(destination);\n    vectors[0] = make_ulonglong2(output0, output1);\n    vectors[1] = make_ulonglong2(output2, output3);\n}\n\n__device__ __forceinline__ void patch_tile_exceptions20x3(\n    const uint64_t* entries20x3,\n    const uint8_t* sign_mantissa,\n    const int32_t* tile_exception_offsets,\n