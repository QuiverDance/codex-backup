)\n                    for layer_id in self.frozen_layers:\n                        if (layer_id >= len(begin_list)\n                                or layer_id >= len(end_list)):\n                            continue\n                        try:\n                            begin_t = init_event.elapsed_time(\n                                begin_list[layer_id])\n                            end_t = init_event.elapsed_time(\n                                end_list[layer_id])\n                        except RuntimeError:\n                            continue\n                        # Skip stale (pre-init) or zero-duration events.\n                        # Either side being pre-init means this layer\n                        # didn't actually decompress in this forward.\n                        if (begin_t < -0.01 or end_t < -0.01\n                                or end_t - begin_t < 0.001):\n                            continue\n                        frozen_decomp_intervals.append((begin_t, end_t))\n                frozen_decomp_intervals.sort(key=lambda x: x[0])\n\n            # frozen_split's per-(layer,name) decomp kernel uses its\n            # own lazy timing cache (the per-comp_key\n            # end_frozen_decomp_timing_events slots are written by the\n            # frozen_compressed paths, not by\n            # _decompress_frozen_split_for_name).\n            frozen_split_decomp_intervals = []\n            sd_begin_cache = getattr(\n                self,\n                \"_frozen_split_decomp_begin_timing_events_cache\",\n                None)\n            sd_end_cache = getattr(\n                self,\n                \"_frozen_split_decomp_end_timing_events_cache\",\n                None)\n            if sd_begin_cache and sd_end_cache:\n                for key, begin_ev in sd_begin_cache.items():\n                    end_ev = sd_end_cache.get(key)\n                    if end_ev is None:\n                        continue\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_decomp_intervals.append((b_t, e_t))\n                frozen_split_decomp_intervals.sort(key=lambda x: x[0])\n\n            all_weight_decomp_intervals = (\n                weight_decomp_intervals\n                + frozen_decomp_intervals\n                + frozen_split_decomp_intervals)\n            wdecomp_union: List[Tuple[float, float]] = []\n            wdecomp_brk = 0.0\n            if all_weight_decomp_intervals:\n                wdecomp_union = self._calc_exec_times(\n                    all_weight_decomp_intervals, [])\n                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\n\n            kvdecomp_union: List[Tuple[float, float]] = []\n            kvdecomp_brk = 0.0\n            if use_kv_comp and kv_decomp_intervals:\n                kvdecomp_union = self._calc_exec_times(\n                    kv_decomp_intervals, [])\n                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\n\n            # ── Separate Compute from WEIGHT Decomp ──\n            # The decode GEMM blocks on cur_stream until its WEIGHT\n            # decompression (on decomp_weight_stream) completes — the weight IS\n            # the GEMM operand, so the GEMM cannot start until decomp lands.\n            # Only ~6ms of that block surfaces as the in-graph _v1_wwait; the\n            # rest stays inside the exec window, which is why Compute(LLM) read\n            # ~= WDecomp ~= GPUFwd even though the real GEMM is tiny.  Carve the\n            # weight-decomp union out so Compute is GEMM+attention only.\n            #\n            # KV decode must NOT be carved (it used to be — that was a bug).\n            # It is prefetched one layer ahead (start_kv_decompress(L+1) in\n            # _before_replay(L), finish in _after_replay(L)) and runs on\n            # batch_decomp_stream CONCURRENTLY with the productive GEMM of the\n            # next graph piece — it does not block that GEMM.  Attention's real\n            # wait for its OWN layer's KV is the exec_attn_barrier, and that\n            # wait is ALREADY removed above via _v1_kv_wait (wait_intervals).\n            # Subtracting the decode interval a second time here removed real,\n            # concurrent GEMM from Compute, so Compute SHRANK when --kv-comp was\n            # enabled (C.A.O b128 165.6 → C.A.O+KVComp 139.0, exactly the ~22ms\n            # decode carved out) even though the real compute is unchanged.\n            # Leave KV decode in Compute and report it separately as KVDecomp,\n            # a concurrent stream-busy metric that overlaps Compute by design\n            # (so Compute + KVDecomp may exceed GPUFwd — that overlap is the\n            # decode being hidden under compute).  Stall is unaffected:\n            # compute_union below unions the decomp intervals back in anyway.\n            if wdecomp_union:\n                llm_active_intervals = self._subtract_intervals(\n                    llm_active_intervals, wdecomp_union)\n            llm_brk = sum(e - b for b, e in llm_active_intervals)\n\n            # Frozen_split mode H2D's the compressed-exp / aux LPDDR\n            # buffers every decode step on load_weight_stream (see\n            # _decompress_frozen_split_for_name).  These do NOT land in\n            # begin/end_memcpy_weight_events.  We pair the timing-only\n            # BEGIN/END cache (the sync _frozen_split_h2d_events is not\n            # enable_timing).\n            frozen_split_h2d_intervals = []\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06177-c553-7e50-9170-b6bd7a48d70f","create_time":1788341789.152168}}}
