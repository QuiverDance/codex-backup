t math as _math\n            num_blocks_total = kv_cache_config.num_blocks\n            n_kv_layers = len(kv_cache_config.kv_cache_tensors)\n            # Per-block raw bytes for one layer (from the first tensor)\n            first_tensor_size = kv_cache_config.kv_cache_tensors[0].size\n            per_block_bytes_raw = (first_tensor_size // num_blocks_total\n                                   if num_blocks_total > 0 else 0)\n\n            gpu_free, _ = torch.cuda.mem_get_info()\n            # Reserve must cover everything allocated AFTER this planner AND the\n            # runtime transients vLLM's profiling did NOT measure:\n            #   * the HBM decode buffer(s) (gpu_worker allocates these LATER —\n            #     up to ~3.6 GiB for the DOUBLE raw-KV parity buffer),\n            #   * the LARGE eager-prefill activations — vLLM profiles peak\n            #     activations at decode/captured sizes, so an 8192-token prefill\n            #     chunk's MLP intermediates (e.g. inductor's gate_up buf\n            #     N*57344*2 ≈ 0.9 GiB) + the fused-mm decomp output scratch\n            #     (~1.4 GiB) are NOT in gpu_free and must come out of here,\n            #   * CUDA graphs (~0.4-0.7 GiB), cuBLAS workspace, sampler\n            #     topk/topp sort buffers, caching-allocator fragmentation.\n            # 5 GiB was razor-thin for --fused-mm flexgen-comp at batch 128\n            # (OOM at ~1.2 GiB free on the gate_up prefill GEMM); 8 GiB gives\n            # margin.  Lower via TIERED_SERVE_GPU_RESERVE_GIB on tight-KV configs\n            # that don't run large eager prefill.\n            gpu_reserve = int(os.getenv(\n                \"TIERED_SERVE_GPU_RESERVE_GIB\", \"8\")) * (1 << 30)\n            gpu_avail = max(0, gpu_free - gpu_reserve)\n\n            # LPDDR5 capacity from hugepages\n            hp_kv_pages = hp_allocator.pages.get(\"kv\", [])\n            lpddr5_bytes = sum(\n                sum(b[\"size\"] for b in p[\"blocks\"] if b[\"free\"])\n    