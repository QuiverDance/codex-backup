yer_pipeline_cpp`` contract holds — mirrors ZipServ,\n        # whose ``wait_compress_async`` always populates ``_compressed_kv``.\n        self._compressed_kv[layer_id] = {\n            # int64 ndarray (or [] when nothing was scheduled) — popped+discarded\n            # on the p4flat/ublb decode path (no Python-list reader); avoids a\n            # per-layer list() materialization on the forward thread.\n            'buffer_ids': buffer_ids,\n            'block_shape': block_shape,\n            'n': len(buffer_ids),\n        }\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode this layer's KV.  WAIT-BASED ordering (no host synchronize):\n\n        Two read/write hazards on the host pool, both ordered without blocking\n        the main thread (so per-layer decodes pipeline / prefetch the forward):\n          1. decode reads pool data written by the PREVIOUS step's worker → join\n             that worker's future first (it finished a step ago, so ~0 cost).\n          2. THIS step's unload worker re-compresses + overwrites these same\n             slots → it must not clobber the decode's in-flight async H2D read.\n             Handled on the WORKER thread: it waits on this layer's decode-H2D\n             event (``_kv_dec_h2d[layer_id]``, recorded in _decompress_batched)\n             before writing — see ``_encode_chunk``.  No main-thread barrier, so\n             the KV-decode H2D+kernels overlap the forward.\n        \"\"\"\n        st = self._pending_compress.get(layer_id)\n        if st is not None:\n            if 'state' in st:\n                self._wait_worker_state(st['state'])\n            else:\n                for f in st.get('futures', ()):\n                    f.result()\n        super().decompress_batch(layer_id, active_block_ids, output_buffers)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05b75-7c66-7882-b2eb-faf8a147f792","create_time":