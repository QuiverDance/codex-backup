\n#include <cstdint>\n\n#include <cutlass/bfloat16.h>\n#include <cutlass/cutlass.h>\n#include <cute/arch/mma_sm90.hpp>\n#include <cute/tensor.hpp>\n\n// Slim double-buffered smem: just the WGMMA A/B operand tiles. No decode\n// scratch — the producer writes A elements straight into the swizzled tile.\n// Shared by the raw_pipe (E1) kernel and its launch helper.\ntemplate <int TileN, int Stages>\nstruct LabSmem {\n    using SmemLayoutA = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<64>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    using SmemLayoutB = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutA>> A;\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutB>> B;\n};\n\n// ============================================================================\n// B-1: deep multi-stage cp.async pipelined RAW GEMM (E1, cuBLAS-grade attempt).\n//\n// Replaces the 2-stage synchronous producer with an S-stage cp.async ring so\n// many weight loads are in flight (the prior kernel sat at ~14% HBM because\n// only 2 stages of synchronous loads were ever outstanding). A and B are both\n// dense BF16 here, so cp.async streams them straight into the swizzled smem\n// tiles via CuTe copy atoms. Single warpgroup; relies on memory-level\n// parallelism (deep pipeline) rather than warp specialization for now.\n// ============================================================================\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void raw_pipe_kernel(\n    const __nv_bfloat16* __restrict__ A_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    int M, int N, int K)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = LabSmem<TileN, Stages>;\n    using SmemLayoutA = typename Smem::SmemLayoutA;\n    using SmemLayoutB = typename Smem::SmemLayoutB;\n\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sA = make_tensor(make_smem_ptr(smem.A.begin()), SmemLayoutA{});\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), SmemLayoutB{});\n\n    const int tid     = static_cast<int>(threadIdx.x);\n    const int tile_n  = static_cast<int>(blockIdx.x);\n    const int tile_m  = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n\n    // Global operand tensors (row-major), tiled along K.\n    auto mA = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(A_g)),\n                          make_layout(make_shape(M, K), make_stride(K, Int<1>{})));\n    auto gA = local_tile(mA, make_shape(Int<kTileM>{}, Int<kTileK>{}),\n                         make_coord(tile_m, _));          // (64,64,tiles_k)\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n# ── RS-mode (register-A) fused decompress+GEMM extension ───────────────\n# Built from cpp_extensions/csrc/fused_gemm/{wgmma_lab.cu,wgmma_lab_binding.cpp}\n# (needs CUTLASS + sm_90a). Same module name as the experimental lab loader so\n# the JIT build is shared/cached. Referenced by absolute path so it works\n# regardless of sys.path (e.g. inside a vLLM worker process).\n_RS_EXT = None\n\n\ndef _get_rs_ext():\n    global _RS_EXT\n    if _RS_EXT is not None:\n        return _RS_EXT\n    from torch.utils.cpp_extension import load as _load\n    here = os.p