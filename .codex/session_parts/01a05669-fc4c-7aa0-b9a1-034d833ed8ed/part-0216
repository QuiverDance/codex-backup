{"timestamp":"2026-09-01T05:33:59.155Z","ordinal":10334,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05b75-7c66-7882-b2eb-faf8a147f792","item":{"type":"CommandExecution","id":"exec-9af43a7a-a582-4955-9880-a98d8ea3ed4d","process_id":"67556","command":["/bin/bash","-lc","docker exec tiered-serve bash -c 'cd /root/projects/tiered-serve && sed -n \"100,225p;225,330p;390,470p\" tiered_serve/chunk_delta3_kv_compressor.py && grep -R -n \"_gpu_decomp_pool\\|_host_pools.*\\[.*\\]\\[.*\\]\" tiered_serve/chunk_delta3_kv_compressor.py tests/test_chunk_delta3.py --include=\"*.py\" | sed -n \"1,260p\"'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -c 'cd /root/projects/tiered-serve && sed -n \"100,225p;225,330p;390,470p\" tiered_serve/chunk_delta3_kv_compressor.py && grep -R -n \"_gpu_decomp_pool\\|_host_pools.*\\[.*\\]\\[.*\\]\" tiered_serve/chunk_delta3_kv_compressor.py tests/test_chunk_delta3.py --include=\"*.py\" | sed -n \"1,260p\"'"}],"source":"unified_exec_startup","status":"completed","stdout":"    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        tiles = block_elements // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n        return (\n            tiles * 1536 + block_elements + tiles * 256\n            + (tiles + 1) * 4 + (entry_capacity // 3) * 8 + 4\n        )\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            for page_type in (\"kv\", \"weight\"):\n                try:\n                    return huge_page_allocator.allocate(\n                        (numel,), (1,), dtype, page_type=page_type).view(shape)\n                except (MemoryError, ValueError):\n                    pass\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _pool(self, rows: int, device: str,\n              huge_page_allocator=None) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        if device == \"cuda\":\n            return {\n                name: torch.empty(shape, dtype=dtype, device=\"cuda\")\n                for name, (shape, dtype) in specs.items()\n            }\n        return {\n            name: self._alloc_host_tensor(\n                shape, dtype, huge_page_allocator)\n            for name, (shape, dtype) in specs.items()\n        }\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_comp_pool = (\n            {\n                \"k\": self._pool(max_gpu_blocks + 1, \"cuda\"),\n                \"v\": self._pool(max_gpu_blocks + 1, \"cuda\"),\n            }\n            if self._USES_GPU_COMPRESS else {}\n        )\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        # The indexed decoder writes directly into the destination KV cache.\n        # Keeping a full raw-BF16 intermediate used to add another read+write\n        # of every decoded byte and a separate advanced-indexing kernel.\n        self._bf16_decomp_out = {}\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n            for layer in range(n_layers)}\n        self._kv_slot_np = {\n            layer: self._kv_slot[layer].numpy()\n            for layer in range(n_layers)}\n        self._kv_slot_block = {\n            layer: [-1] * host_n for layer in range(n_layers)}\n        self._kv_active_count = {\n            layer: 0 for layer in range(n_layers)}\n        self._kv_free_heap = {layer: [] for layer in range(n_layers)}\n        self._kv_free_slots = {layer: set() for layer in range(n_layers)}\n        self._kv_dec_h2d = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Give CPU workers a completed initial event for layers that have not\n        # loaded persistent compressed data yet.\n        # loaded persistent compressed data yet.\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for event in self._kv_dec_h2d:\n                event.record(self.batch_decomp_stream)\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            for name in self._FIELDS:\n                pool[name][dst_slot].copy_(pool[name][src_slot])\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_table = self._kv_slot_np[layer_id]\n        previous = int(slot_table[bid])\n        if previous >= 0:\n            return previous\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot = -1\n        while heap:\n            candidate = heapq.heappop(heap)\n            if candidate in free_set:\n                free_set.discard(candidate)\n                slot = candidate\n                break\n        if slot < 0:\n            slot = self._kv_active_count[layer_id]\n            if slot >= len(self._kv_slot_block[layer_id]):\n                raise RuntimeError(\n                    f\"ChunkDelta3 KV persistent slot pool full for \"\n                    f\"layer={layer_id}\")\n            self._kv_active_count[layer_id] = slot + 1\n        slot_table[bid] = slot\n        self._kv_slot_block[layer_id][slot] = bid\n        return slot\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    @staticmethod\n    def _slot_runs(slots: list[int]):\n        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n        if not slots:\n            return\n        row_begin = 0\n        slot_begin = slots[0]\n        previous = slot_begin\n        for row in range(1, len(slots)):\n            slot = slots[row]\n            if slot != previous + 1:\n                yield row_begin, row, slot_begin\n                row_begin =