ss_split_singlechunk(\n            self, layer_id, active, blob_stride, host_k, host_v, bid_arr,\n            bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n            M_b, K_b, block_numel, rsm, exc_cap):\n        \"\"\"Single-chunk KV decode with the compressed-blob H2D on\n        ``load_kv_stream`` and the decode kernels on ``batch_decomp_stream``.\n\n        A 2-slot blob ring double-buffers the staging blob so layer L+1's LOAD\n        (load_kv_stream) overlaps layer L's DECODE (batch_decomp_stream) — the\n        per-slot ``consumed`` event gates reuse so the two streams never race on\n        the blob.  ``load_kv_stream`` is gated by the graph wrapper on \"QKV\n        weights loaded\", so the H2D starts when the single copy engine is free\n        of weight H2D (otherwise the H2D queues behind weight and the\n        breakdown's KVLoad interval absorbs that wait).  Mirrors the common\n        async-ring single-chunk path of ``_decompress_batched_general``\n        (lo == 0, no per-block slot rebase).\"\"\"\n        n = active\n        if layer_id == 0:\n            self._splitcnt = getattr(self, \"_splitcnt\", 0) + 1\n            if self._splitcnt % 50 == 1:\n                logger.info(\n                    \"[KVStageDbg] L0 staging n=%d blocks (active_count) \"\n                    chunk_slots = pi[0]\n                    g_vrk = pi[1]; g_eck = pi[2]; g_rk = pu[0]\n                    g_vrv = pi[3]; g_ecv = pi[4]; g_rv = pu[1]\n                else:\n                    gi = pif[:5 * n].cuda(non_blocking=True)   # contiguous async\n                    gu = puf[:2 * n].cuda(non_blocking=True)\n                    if ids_cached and single_chunk:\n                        cbids = self._cbids_cache_gpu   # uploaded earlier this\n                        # step on this same stream -> ordering guaranteed\n                    else:\n                        cbids = bif[:n].cuda(non_blocking=True)\n                        if single_chunk:\n                      