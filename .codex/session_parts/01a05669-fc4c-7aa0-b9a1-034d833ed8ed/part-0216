             block_ids, dtype=torch.long, device=k_cache.device)\n            for kv, cache in ((\"k\", k_cache), (\"v\", v_cache)):\n                host = self._host_pools[layer_id][kv]\n                gpu = self._gpu_decomp_pool[kv]\n                if packed_h2d:\n                    for row_begin, row_end, slot_begin in slot_runs:\n                        length = row_end - row_begin\n                        for name in self._FIELDS[:-1]:\n                            gpu[name][row_begin:row_end].copy_(\n                                host[name][slot_begin:slot_begin + length],\n                                non_blocking=True)\n                    storage_rows = n\n                else:\n                    # A highly fragmented request is cheaper as five dense\n                    # prefix copies than as hundreds of tiny field copies.\n                    for name in self._FIELDS[:-1]:\n                        gpu[name][:hwm].copy_(\n                            host[name][:hwm], non_blocking=True)\n                    storage_rows = hwm\n                _cd3_ext.decompress_chunk_delta3_batched_indexed(\n                    gpu[\"codes\"][:storage_rows],\n                    gpu[\"sign_mantissa\"][:storage_rows],\n                    gpu[\"thread_bases\"][:storage_rows],\n                    gpu[\"tile_exception_offsets\"][:storage_rows],\n                    gpu[\"entries20x3\"][:storage_rows],\n                    slots_gpu,\n                    block_ids_gpu,\n                    cache.view(cache.shape[0], self._M_b, self._K_b),\n                )\n            # A CPU encoder may now overwrite persistent host slots only after\n            # every K/V H2D read queued above has retired.  Recording at the\n            # end is conservative (it also waits for decode) but remains off\n            # the forward thread and avoids any host synchronization.\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n\n_cudart_lib = None\n_cudart_lock = threading.Lock()\n\ntiered_serve/chunk_delta3_kv_compressor.py:82:        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\ntiered_serve/chunk_delta3_kv_compressor.py:198:        self._gpu_decomp_pool = {\ntiered_serve/chunk_delta3_kv_compressor.py:244:            pool = self._host_pools[layer_id][kv]\ntiered_serve/chunk_delta3_kv_compressor.py:349:                host = self._host_pools[layer_id][kv]\ntiered_serve/chunk_delta3_kv_compressor.py:376:            counts = self._host_pools[layer_id][kv][\"num_exceptions\"]\ntiered_serve/chunk_delta3_kv_compressor.py:434:                host = self._host_pools[layer_id][kv]\ntiered_serve/chunk_delta3_kv_compressor.py:435:                gpu = self._gpu_decomp_pool[kv]\ntiered_serve/chunk_delta3_kv_compressor.py:834:            pool = self._host_pools[layer_id][kv]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05b75-7c66-7882-b2eb-faf8a147f792","create_time":1788240839.1751437}}}
