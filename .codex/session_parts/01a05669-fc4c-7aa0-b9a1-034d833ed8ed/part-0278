p_stream)\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_pop()  # kv_decode_cpp\n\n    def _stage_blob_h2d(self, layer_id: int, lo: int, hi: int,\n                        host_k: dict, host_v: dict,\n                        gk: torch.Tensor = None, gv: torch.Tensor = None) -> None:\n        \"\"\"H2D the compressed K/V blobs for slot range [lo:hi) into the decode\n        staging buffer, preserving slot positions (gpu row = slot - lo).\n\n        ``gk``/``gv`` select the target staging blob (a blob-ring slot for the\n        load_kv_stream split); default to the slot-0 buffers.\n\n        Live slots are dense by construction (min-slot-first refills holes), but\n        a drain phase (frees with no intervening allocs) leaves holes in\n        [0:hwm).  Rather than copy the whole [lo:hi) span (dragging hole rows)\n                                if _captured.shape != _bids.shape:\n                                    raise RuntimeError(\n                                        \"P4Flat CPU KV pending id/slot shape \"\n                                        f\"mismatch: ids={_bids.shape}, \"\n                                        f\"slots={_captured.shape}\")\n                                _sl = self._kv_slot[\n                                    layer_id][torch.from_numpy(_bids)].numpy()\n                                _va = np.frombuffer(pv, dtype=np.uint8)\n                                _idx = _bids[\n                                    (_sl >= 0) & (_sl == _captured)]\n                                _va[_idx] = 1\n                        finally:\n                            self._pending_compress.pop(layer_id, None)\n                            deferred = self._deferred_slot_frees.pop(\n                                layer_id, set())\n                            for slot in deferred:\n                                self._release_quarantined_slot(layer_id, slot)\n        else:\n            buffer_ids = []\n        # Always publish a