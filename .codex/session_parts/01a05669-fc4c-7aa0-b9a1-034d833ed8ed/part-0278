        return\n\n        # C++ one-call decode prep (production shape): the valid filter,\n        # slot/meta gather, meta+blob H2D and event records all happen in\n        # ONE ext call; Python only launches the two codec kernels.  The\n        # blob H2D is hole-agnostic: the ext splits [0:active) into the\n        # contiguous REQUESTED-slot runs and submits them (with the meta\n        # copies) as one cudaMemcpyBatchAsync — dense sets degenerate to a\n        # single run, fragmented sets skip hole/unrequested bytes.\n        if getattr(self, \"_use_cpp_prep\", False):\n            active = self._kv_active_count[layer_id]\n            if (0 < active <= self._dec_cap\n                    and not self._meta_sync_fallback\n                    and not self._decode_validate):\n                # NOTE: NOT gated on self._tb — time-breakdown must measure the\n                # PRODUCTION fast path, not divert to the slow path.  The fast\n                # path records _kv_h2d_begin/_kv_dec_h2d + the kv.py\n                # begin/end_kv_decomp brackets, so KVLoad/KVDecomp still attribute\n                # correctly (the H2D and decode kernels are split by those events).\n                #\n                # When _restore_secondary_fallbacks returned the same array\n                # (no is_raw==2 blocks this step), reuse the step-level cached\n                # tensor instead of torch.from_numpy(cand) which allocates a\n                # new CPU tensor per layer → posix_memalign → mmap churn.\n                _cand_t = (self._decomp_filter_cand_t\n                           if cand is self._decomp_filter_cand\n                           else torch.from_numpy(cand))\n                return self._decode_layer_cpp(\n                    layer_id, active, k_cache, v_cache,\n                    _cand_t)\n\n        valid_arr = np.frombuffer(valid, dtype=np.uint8)  # bytearray view, no copy\n        filtered = cand[valid_arr[cand] != 0]\n        if filtered.size == 0:\n            return\n        # Defensive slot guard: drop any block marked persistent-valid whose\n        # slot is < 0 (valid=1 / slot=-1 desync).  The decode kernel indexes\n        # gpu_blob[slot*stride]; a single -1 → reads BEFORE the buffer → CUDA\n        # IMA, and the chunk's max-slot bounds check can't see it.  This was\n        # previously dropped for speed (assuming no desync), but offloading the\n        # whole prefill chunk re-exposes it.  ~µs numpy gather, decode-only.\n        _slot_np = self._kv_slot_np[layer_id]\n        _bad = _slot_np[filtered] < 0\n        if _bad.any():\n            _nbad = int(_bad.sum())\n            if (getattr(self, \"_slotwarn\", 0) % 200) == 0:\n                logger.warning(\n                    \"[kv-decode] L%d dropping %d/%d valid blocks with slot<0 \"\n                    \"(compress/free desync)\", layer_id, _nbad, filtered.size)\n            self._slotwarn = getattr(self, \"_slotwarn\", 0) + 1\n            filtered = filtered[~_bad]\n            if filtered.size == 0:\n                return\n        self._decompress_batched(layer_id, filtered, k_cache, v_cache)\n\n    def _restore_secondary_fallbacks(\n            self, layer_id: int, candidates: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\n        \"\"\"Restore tight-stride overflow blocks and remove them from codec decode.\n\n        ``is_raw==2`` means neither the compressed payload nor raw BF16 fit the\n        tight blob row, so the encoder intentionally stored no blob.  The C++\n        fast path used to pass those rows to the codec kernel, which interpreted\n        any nonzero ``is_raw`` as raw-in-row and read stale bytes.  Check both K\n        and V metadata, copy the exact pair from raw secondary, and let the codec\n        kernel handle only rows that have a real blob.\n        \"\"\"\n        if (self._blob_stride >= self._raw_bytes\n                or not self._secondary_fallback_possible.get(layer_id, False)\n                or candidates.size == 0):\n            return candidates\n\n        valid = np.frombuffer(\n            self._persistent_valid[layer_id], dtype=np.uint8)\n        valid_pos = np.flatnonzero(valid[candidates] != 0)\n        if valid_pos.size == 0:\n            return candidates\n\n        valid_ids = candidates[valid_pos]\n        slots = self._kv_slot_np[layer_id][valid_ids]\n        slot_ok = slots >= 0\n        if not slot_ok.any():\n            return candidates\n\n        probe_pos = valid_pos[slot_ok]\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        k_raw = pools['k']['is_raw'].numpy()[probe_slots]\n        v_raw = pools['v']['is_raw'].numpy()[probe_slots]\n        secondary = (k_raw >= 2) | (v_raw >= 2)\n        if not secondary.any():\n            return candidates\n\n        secondary_pos = probe_pos[secondary]\n        secondary_ids = np.ascontiguousarray(candidates[secondary_pos])\n        self._decode_raw_from_secondary(\n            layer_id, secondary_ids, k_cache, v_cache)\n\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[secondary_pos] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(self, layer_id, raw_bids, k_cache, v_cache,\n                                   stream=None):\n        \"\"\"Reconstruct over-stride (is_raw==2) blocks from the per-layer raw\n        secondary KV (which cpu_after_raw_swap already populated) — they have no\n        valid compressed blob, so copy the raw block straight into the decode\n        output.  Few blocks (only high-exception ones), so a gather + H2D\n        index_copy is fine.  ``stream`` selects the copy stream (default the\n        decode stream; the fused path passes its separate staging stream so the\n        copy overlaps compute like the rest of the staging).\"\"\"\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        if layer_id >= len(DualMemoryLoader.kv_caches):\n            raise RuntimeError(\n                \"P4Flat KV tight-stride fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no DualMemoryLoader cache.\")\n        kc = DualMemoryLoader.kv_caches[layer_id]\n        sec = getattr(kc, \"secondary_kv\", None)\n        if sec is None:\n            raise RuntimeError(\n                \"P4Flat KV tight-stride fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no secondary_kv.\")\n        idx = torch.from_numpy(np.ascontiguousarray(raw_bids))\n        with torch.cuda.stream(stream or self.batch_decomp_stream):\n            dev = idx.to(k_cache.device, non_blocking=True)\n            k_cache.index_copy_(\n                0, dev, sec[0][idx].to(k_cache.device, non_blocking=True))\n            v_cache.index_copy_(\n                0, dev, sec[1][idx].to(v_cache.device, non_blocking=True))\n\n    def _decode_layer_cpp(self, layer_id: int, active: int,\n                          k_cache: torch.Tensor,\n                          v_cache: torch.Tensor,\n                          candidates_t: torch.Tensor = None) -> None:\n        \"\"\"Per-layer KV decode via the C++ ``decode_layer_prep`` entry.\n\n        One pybind call stages everything (valid filter, slot/meta gather\n        into the pinned ring, meta + blob async H2D, ring/dec event\n        records); only the two codec decode kernels remain in Python (they\n        are codec-specific overrides — ``_invoke_decode_kernel``).\"\"\"\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_push(f\"kv_decode_cpp L{layer_id}\")\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        # H2D-on-load_kv_stream split: run the blob+meta H2D on load_kv_stream\n        # (aliased to load_weight_stream) so it is SERIAL with weight on the\n        # single GH200 copy engine — KVLoad's _kv_h2d_begin.._kv_dec_h2d bracket\n        # then measures pure transfer in its own engine slot, not the\n        # cross-stream engine-queue wait it absorbed on batch_decomp_stream\n        # (WLoad+KVLoad <= GPUFwd).  Decode kernels stay on batch_decomp_stream\n        # (what exec's attn barrier waits on) and gate on _kv_dec_h2d.  Two load\n        # buffers (_dec_blob_ring): layer L+1's H2D writes the OTHER slot than\n        # layer L's decode is reading, so H2D(L+1) overlaps decode(L); the\n        # per-slot ``consumed`` event gates reuse — the H2D waits the slot's\n        # previous decode before overwriting it.  Just the waits, no extra\n        # bookkeeping.\n        _split = (self.load_kv_stream is not None\n                  and self._kv_split_h2d_enabled)\n        if _split:\n            slot = self._dec_blob_ring_idx & 1\n            self._dec_blob_ring_idx += 1\n            blob_k = self._dec_blob_ring[slot]\n            blob_v = self._dec_blob_v_ring[slot]\n            h2d_stream = self.load_kv_stream\n            if self._dec_blob_consumed is not None:\n                h2d_stream.wait_event(self._dec_blob_consumed[slot])\n        else:\n            slot = 0\n            blob_k, blob_v = self._gpu_dec_blob, self._gpu_dec_blob_v\n            h2d_stream = self.batch_decomp_stream\n        # DEVICE meta buffers ride the SAME ring slot as the blob (see __init__):\n        # the meta H2D + the decode read use this slot's buffers, and\n        # _dec_blob_consumed[slot] already gates its reuse — so the split's\n        # cross-stream meta H2D can't overwrite a buffer the decode is reading.\n        gi_dev = self._gi_dev_ring[slot]\n        gu_dev = self._gu_dev_ring[slot]\n        gb_dev = self._gb_dev_ring[slot]\n        if self._tb:\n            # KVLoad bracket begin; on the H2D stream (matches _kv_dec_h2d).\n            self._kv_h2d_begin[layer_id].record(h2d_stream)\n        if candidates_t is None:\n            candidates_t = self._decomp_filter_cand_t\n        n = _p4f_ext.decode_layer_prep(\n            candidates_t, self._valid_t[layer_id], slot_tbl,\n            kvr, kec, kir, vvr, vec, vir,\n            self._meta_ring_pi[ri], self._meta_ring_pu[ri],\n            self._meta_ring_b[ri],\n            gi_dev, gu_dev, gb_dev,\n            hkb, hvb, blob_k, blob_v,\n            active, self._meta_ring_ev[ri].cuda_event,\n            self._kv_dec_h2d[layer_id].cuda_event,\n            h2d_stream.cuda_stream)\n        if n <= 0:\n            if n < 0:\n                logger.error(\n                    \"[kv-decode] SKIP L%d: valid/slot desync (a valid block \"\n                    \"maps outside [0:%d)) -- would CUDA-IMA\", layer_id,\n                    active)\n            if _ENV_KV_DETAILED_NVTX:\n                torch.cuda.nvtx.range_pop()  # kv_decode_cpp\n            return\n        gi, gu = gi_dev, gu_dev\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\n        rsm = self._row_major_sm\n        # Decode kernels on batch_decomp_stream (raw handle = no per-call\n        # `with torch.cuda.stream(...)` context).  When the H2D ran on\n        # load_kv_stream (split), gate the kernels on _kv_dec_h2d so they read\n        # the blob/meta only after the cross-stream H2D lands.\n        sh = self.batch_decomp_stream.cuda_stream\n        if _split:\n            self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\n        if self._tb:\n            self._kv_decode_begin[layer_id].record(\n                self.batch_decomp_stream)\n        # Fused K+V decode: pass the BASE gi/gu/gb tensors + n (the codec slices\n        # by pointer offset in C++) instead of building gi[0:n]/gi[2n:3n]/gu[0:n]\n        # ... CUDA views + 2 reshapes per launch — that view churn was the CPU\n        # gap between the blob H2D and the decode kernel.\n        self._invoke_decode_layer(\n            blob_k, blob_v, blob_stride,\n            gi, gu, gb_dev, n, k_cache, v_cache,\n            block_numel, K_b, M_b, exc_cap, rsm, sh)\n        if _split and self._dec_blob_consumed is not None:\n            # decode done reading this load buffer -> the next layer's H2D may\n            # reuse the slot (the consumed wait above gates it).\n            self._dec_blob_consumed[slot].record(self.batch_decomp_stream)\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_pop()  # kv_decode_cpp\n\n    def _stage_blob_h2d(self, layer_id: int, lo: int, hi: int,\n                        host_k: dict, host_v: dict,\n                        gk: torch.Tensor = None, gv: torch.Tensor = None) -> None:\n        \"\"\"H2D the compressed K/V blobs for slot range [lo:hi) into the decode\n        staging buffer, preserving slot positions (gpu row = slot - lo).\n\n        ``gk``/``gv`` select the target staging blob (a blob-ring slot for the\n        load_kv_stream split); default to the slot-0 buffers.\n\n        Live slots are dense by construction (min-slot-first refills holes), but\n        a drain phase (frees with no intervening allocs) leaves holes in\n        [0:hwm).  Rather than copy the whole [lo:hi) span (dragging hole rows)\n                                if _captured.shape != _bids.shape:\n                                    raise RuntimeError(\n                                        \"P4Flat CPU KV pending id/slot shape \"\n                                        f\"mismatch: ids={_bids.shape}, \"\n                                        f\"slots={_captured.shape}\")\n                                _sl = self._kv_slot[\n                                    layer_id][torch.from_numpy(_bids)].numpy()\n                                _va = np.frombuffer(pv, dtype=np.uint8)\n                                _idx = _bids[\n                                    (_sl >= 0) & (_sl == _captured)]\n                                _va[_idx] = 1\n                        finally:\n                            self._pending_compress.pop(layer_id, None)\n                            deferred = self._deferred_slot_frees.pop(\n                                layer_id, set())\n                            for slot in deferred:\n                                self._release_quarantined_slot(layer_id, slot)\n        else:\n            buffer_ids = []\n        # Always publish an entry (empty when no blocks were scheduled for\n        # this layer this iteration) so the shared\n        # ``wait_for_layer_pipeline_cpp`` contract holds — mirrors ZipServ,\n        # whose ``wait_compress_async`` always populates ``_compressed_kv``.\n        self._compressed_kv[layer_id] = {\n            # int64 ndarray (or [] when nothing was scheduled) — popped+discarded\n            # on the p4flat/ublb decode path (no Python-list reader); avoids a\n            # per-layer list() materialization on the forward thread.\n            'buffer_ids': buffer_ids,\n            'block_shape': block_shape,\n            'n': len(buffer_ids),\n        }\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode this layer's KV.  WAIT-BASED ordering (no host synchronize):\n\n        Two read/write hazards on the host pool, both ordered without blocking\n        the main thread (so per-layer decodes pipeline / prefetch the forward):\n          1. decode reads pool data written by the PREVIOUS step's worker → join\n             that worker's future first (it finished a step ago, so ~0 cost).\n          2. THIS step's unload worker re-compresses + overwrites these same\n             slots → it must not clobber the decode's in-flight async H2D read.\n             Handled on the WORKER thread: it waits on this layer's decode-H2D\n             event (``_kv_dec_h2d[layer_id]``, recorded in _decompress_batched)\n             before writing — see ``_encode_chunk``.  No main-thread barrier, so\n             the KV-decode H2D+kernels overlap the forward.\n        \"\"\"\n        st = self._pending_compress.get(layer_id)\n        if st is not None:\n            if 'state' in st:\n                self._wait_worker_state(st['state'])\n            else:\n                for f in st.get('futures', ()):\n                    f.result()\n        super().decompress_batch(layer_id, active_block_ids, output_buffers)\n#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3CPUKVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    if len(saved[k_name]) < count or len(saved[\"v_blocks\"]) < count:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    k = torch.stack(\n        [value.contiguous() for value in saved[k_name][:count]])\n    v = torch.stack(\n        [value.contiguous() for value in saved[\"v_blocks\"][:count]])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--blocks\", type=int, required=True)\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    codec_type = (ChunkDelta3CPUKVCompressor\n                  if args.codec == \"chunk_delta3\"\n                  else P4FlatCPUKVCompressor)\n    host_k, host_v = load_blocks(args.path, args.blocks)\n    compressor = codec_type(torch.cuda.Stream())\n    compressor.warmup_kv_buffers(\n        block_shape=BLOCK_SHAPE, max_n_blocks=args.blocks,\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0, block_ids, (output_k, output_v))\n\n    # Populate device blobs, decode metadata, and the CD3 steady-state plan.\n    production()\n    torch.cuda.synchronize()\n\n    if args.codec == \"chunk_delta3\":\n        from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n        plan = compressor._decode_plans[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n\n        def resident_decode():\n            rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                compressor._gpu_decomp_pool[\"k\"][\"blob\"][:rows],\n                compressor._gpu_decomp_pool[\"v\"][\"blob\"][:rows],\n                plan[\"slots_gpu\"], plan[\"block_ids_gpu\"],\n                output_k.view(args.blocks, 128, 128),\n                output_v.view(args.blocks, 128, 128),\n                compressor._packed_capacity)\n    else:\n        blob_stride, block_numel, k_width, max_rows, max_exc = \\\n            compressor._fast_const\n        gi = compressor._gi_dev_ring[0]\n        gu = compressor._gu_dev_ring[0]\n        gb = compressor._gb_dev_ring[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                [compressor._gpu_dec_blob[:args.blocks],\n                 compressor._gpu_dec_blob_v[:args.blocks]],\n                [compressor._host_pools[0][\"k\"][\"blob\"][:args.blocks],\n                 compressor._host_pools[0][\"v\"][\"blob\"][:args.blocks]])\n\n        def resident_decode():\n            compressor._invoke_decode_layer(\n                compressor._gpu_dec_blob,\n                compressor._gpu_dec_blob_v,\n                blob_stride, gi, gu, gb, args.blocks,\n                output_k, output_v, block_numel, k_width,\n                max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbytes + host_v.nbytes) / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    print(\n        f\"codec={args.codec} blocks={args.blocks} cpu_encode={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n    compressor.stop_kv_compress_workers()\n\n\nif __name__ == \"__main__\":\n    main()\n","stderr":"","aggregated_output":"        valid_tm = valid_rows // 64\n        hb = valid_tm * ntk * 16\n        cb = valid_rows * K_b // 2\n        smb = valid_rows * K_b\n        cdb = (valid_rows // 16) * (K_b // 16)\n        c = _p4f_ext.CompressedP4Flat()\n        off = 0\n        c.headers = gpu_row[off:off + hb]\n        off += hb\n        c.codes = gpu_row[off:off + cb]\n        off += cb\n        c.sign_mantissa = gpu_row[off:off + smb]\n        off += smb\n        c.subtile_codec = gpu_row[off:off + cdb]\n        off += cdb\n        if cnt > 0:\n            ib = cnt * self._idx_es\n            vb = cnt * self._val_es\n            c.exc_indices = gpu_row[off:off + ib].view(self._idx_dtype)\n            off += ib\n            c.exc_values = gpu_row[off:off + vb].view(self._val_dtype)\n        c.M = valid_rows\n        c.K = K_b\n        c.num_exceptions = cnt\n        c.num_groups = 0\n        c.row_major_sm = self._row_major_sm\n        return c\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Batched KV decode (overrides the base per-block-chunked path).\n\n        Filters to valid persistent blocks then hands the whole set to\n        :meth:`_decompress_batched`, which stages compressed blobs with a few\n        contiguous pinned H2Ds and decodes them with one GPU kernel per\n        slot-range chunk — eliminating the per-block Python launch loop that\n        dominated KV decode latency.\"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None:\n            return\n        num_primary = k_cache.shape[0]\n        lim = min(num_primary, len(valid))\n        # ``active_block_ids`` is identical across all layers of a step, so the\n        # in-range candidate set is too — build it once per step instead of\n        # re-running np.asarray over ~6.5k ids every layer (was ~6% of the\n        # CPU-bound dispatch).  Only the per-layer ``valid`` gate differs.\n        #\n        # Key on object IDENTITY (``is``) and HOLD a reference to the list.\n        # Keying on ``id(active_block_ids)`` was unsafe: once a step's list is\n        # freed, the next step's new list can reuse the same id, and if len+lim\n        # also match the stale candidate set is returned → wrong slots → decode\n        # kernel OOB (a CUDA illegal-memory-access seen only under serve's\n        # high-concurrency varying active sets; offline's monotonically-growing\n        # set never collides because len changes every step).  Holding the\n        # reference keeps the cached object alive so its identity can't be\n        # reused while cached.\n        if (getattr(self, \"_decomp_filter_ab\", None) is not active_block_ids\n                or getattr(self, \"_decomp_filter_lim\", None) != lim):\n            ab = np.asarray(active_block_ids, dtype=np.int64)\n            self._decomp_filter_cand = ab[(ab >= 0) & (ab < lim)]\n            self._decomp_filter_cand_t = torch.from_numpy(\n                self._decomp_filter_cand)\n            self._decomp_filter_ab = active_block_ids\n            self._decomp_filter_lim = lim\n        cand = self._restore_secondary_fallbacks(\n            layer_id, self._decomp_filter_cand, k_cache, v_cache)\n        if cand.size == 0:\n            return\n\n        # C++ one-call decode prep (production shape): the valid filter,\n        # slot/meta gather, meta+blob H2D and event records all happen in\n        # ONE ext call; Python only launches the two codec kernels.  The\n        # blob H2D is hole-agnostic: the ext splits [0:active) into the\n        # contiguous REQUESTED-slot runs and submits them (with the meta\n        # copies) as one cudaMemcpyBatchAsync — dense sets degenerate to a\n        # single run, fragmented sets skip hole/unrequested bytes.\n        if getattr(self, \"_use_cpp_prep\", False):\n            active = self._kv_active_count[layer_id]\n            if (0 < active <= self._dec_cap\n                    and not self._meta_sync_fallback\n                    and not self._decode_validate):\n                # NOTE: NOT gated on self._tb — time-breakdown must measure the\n                # PRODUCTION fast path, not divert to the slow path.  The fast\n                # path records _kv_h2d_begin/_kv_dec_h2d + the kv.py\n                # begin/end_kv_decomp brackets, so KVLoad/KVDecomp still attribute\n                # correctly (the H2D and decode kernels are split by those events).\n                #\n                # When _restore_secondary_fallbacks returned the same array\n                # (no is_raw==2 blocks this step), reuse the step-level cached\n                # tensor instead of torch.from_numpy(cand) which