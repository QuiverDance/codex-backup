t_buffers)\n#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3CPUKVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    if len(saved[k_name]) < count or len(saved[\"v_blocks\"]) < count:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    k = torch.stack(\n        [value.contiguous() for value in saved[k_name][:count]])\n    v = torch.stack(\n        [value.contiguous() for value in saved[\"v_blocks\"][:count]])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--blocks\", type=int, required=True)\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    codec_type = (ChunkDelta3CPUKVCompressor\n                  if args.codec == \"chunk_delta3\"\n                  else P4FlatCPUKVCompressor)\n    host_k, host_v = load_blocks(args.path, args.blocks)\n    compressor = codec_type(torch.cuda.Stream())\n    compressor.warmup_kv_buffers(\n        block_shape=BLOCK_SHAPE, max_n_blocks=args.blocks,\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0, block_ids, (output_k, output_v))\n\n    # Populate device blobs, decode metadata, and the CD3 steady-state plan.\n    production()\n    torch.cuda.synchronize()\n\n    if args.codec == \"chunk_delta3\":\n        from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n        plan = compressor._decode_plans[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n\n        def resident_decode():\n            rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                compressor._gpu_decomp_pool[\"k\"][\"blob\"][:rows],\n                compressor._gpu_decomp_pool[\"v\"][\"blob\"][:rows],\n                plan[\"slots_gpu\"], plan[\"block_ids_gpu\"],\n                output_k.view(args.blocks, 128, 128),\n                output_v.view(args.blocks, 128, 128),\n                compressor._packed_capacity)\n    else:\n        blob_stride, block_numel, k_width, max_rows, max_exc = \\\n            compressor._fast_const\n        gi = compressor._gi_dev_ring[0]\n        gu = compressor._gu_dev_ring[0]\n        gb = compressor._gb_dev_ring[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                [compressor._gpu_dec_blob[:args.blocks],\n                 compressor._gpu_dec_blob_v[:args.blocks]],\n                [compressor._host_pools[0][\"k\"][\"blob\"][:args.blocks],\n                 compressor._host_pools[0][\"v\"][\"blob\"][:args.blocks]])\n\n        def resident_decode():\n            compressor._invoke_decode_layer(\n                compressor._gpu_dec_blob,\n                compressor._gpu_dec_blob_v,\n                blob_stride, gi, gu, gb, args.blocks,\n                output_k, output_v, block_numel, k_width,\n                max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbyte