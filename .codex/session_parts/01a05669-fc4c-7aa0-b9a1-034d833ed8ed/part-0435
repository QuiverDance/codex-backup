press_batch(\n        self, layer_id: int,\n        active_block_ids: list,\n        output_buffers: \"tuple[torch.Tensor, torch.Tensor]\",\n    ) -> None:\n        \"\"\"KV-path batch decompress.\n\n        self.tail_lp_skip_local_ids = list(\n            lp_load_skip_local_ids(plan, d))\n        self._tail_steps += 1\n        self._tail_resident_block_steps += len(plan.resident_after)\n        self._tail_completed_full_blocks += len(plan.completed_full_ids)\n        self._tail_rollover_blocks += len(plan.rollovers)\n        if (\n            plan.rollovers\n            and not self._tail_logged_first_rollover_plan\n        ):\n            self._tail_logged_first_rollover_plan = True\n            logger.info(\n                \"[kv-full-block] first rollover planned: step=%d \"\n                \"rollovers=%d completed=%d resident_after=%d\",\n                self._tail_steps, len(plan.rollovers),\n                len(plan.completed_full_ids), len(plan.resident_after))\n\n    def _stage_tail_rollovers(\n        self,\n        layer_id: int,\n        stream: torch.cuda.Stream,\n    ) -> bool:\n        \"\"\"Copy completing partial prefixes from tail HBM to shared primary.\n\n        The completing block is routed to the normal shared buffer for the\n        current forward, while a new partial (if any) may reuse the same tail\n        slot. Copying the complete row is safe: attention overwrites every\n        position from pre_valid through token 16 before the block is unloaded.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return False\n        dst_ids = self.tail_rollover_local_ids\n        if not dst_ids:\n            return False\n\n        _np = DualMemoryLoader.kv_decode_n_parity or 1\n        stream.wait_event(\n            self.kv_unload_done[(layer_id - max(1, _np)) % self.n_layers])\n\n        d = int(self.num_dedicated_blocks)\n        src_ids = [d + slot for slot in self.tail_rollover_slots]\n        from tiered_serve.kv_cache import _get_zipserv\n        _get_zipserv().batch_kv_memcpy_indexed(\n            DualMemoryLoader.primary_k_caches[layer_id],\n            DualMemoryLoader.primary_v_caches[layer_id],\n            DualMemoryLoader.tail_k_caches[layer_id],\n            DualMemoryLoader.tail_v_caches[layer_id],\n            dst_ids,\n            src_ids,\n            stream.cuda_stream,\n        )\n        if layer_id == 0:\n            self._tail_rollover_d2d_l0_blocks += len(dst_ids)\n            if not self._tail_logged_first_rollover_d2d:\n                self._tail_logged_first_rollover_d2d = True\n                logger.info(\n                    \"[kv-full-block] first rollover D2D submitted: \"\n                    \"step=%d blocks=%d\",\n                    self._tail_steps, len(dst_ids))\n        return True\n\n    @classmethod\n    def _init_kv_caches(cls, n_layers: int):\n        cls.kv_caches = [vLLMKVCache(idx) for idx in range(n_layers)]\n\n    @classmethod\n    def append_unload_target(cls, blk_id: int):\n        cls.unload_targets.add(blk_id)\n\n    @classmethod\n    def clear_unload_targets(cls):\n        cls.unload_targets.clear()\n\n    def _uses_compressed_kv_load(self, layer_id: int) -> bool:\n        \"\"\"Whether this layer reconstructs active KV from compressed storage.\n\n        Prefill traditionally forced the raw secondary cache. The opt-in\n        mixed-prefill path instead passes the whole active set to the\n        compressor, whose persistent-valid filter reconstructs only historical\n        blocks; fresh prompt blocks are left untouched until the current\n        attention writes them.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a062a3-95f9-7b83-ac46-8ea003dd7eae","create_time":1788361352.3566508}}}
