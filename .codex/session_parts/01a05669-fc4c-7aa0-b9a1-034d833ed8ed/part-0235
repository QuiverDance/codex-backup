e common no-exception tile).\n    std::vector<std::vector<uint32_t>> t_gi((size_t)(B * TILES));\n    std::vector<std::vector<uint16_t>> t_gv((size_t)(B * TILES));\n    py::gil_scoped_release no_gil;\n\n    // Phase 1: per (block, tile) — headers, 4-bit codes, per-tile exceptions.\n    #pragma omp parallel for schedule(static)\n    for (int64_t u = 0; u < B * TILES; ++u) {\n        const int64_t b = u / TILES, ti = u % TILES;\n        const int64_t tm = ti / ntk, tk = ti % ntk;\n        const uint16_t* in = in_base + bid_p[b] * block_numel;\n        uint8_t* row = blob_base + slot_p[b] * row_stride;\n        uint8_t* hdr = row;\n        uint8_t* codes = row + hb_v;\n        const int64_t r0 = tm * 64, c0 = tk * 64;\n        int counts[256];\n        int8_t code_of[256];\n        uint8_t tile_code[64 * 64];\n        for (int i = 0; i < 256; ++i) counts[i] = 0;\n        for (int r = 0; r < 64; ++r) {\n            const uint16_t* rp = in + (r0 + r) * K_b + c0;\n            for (int c = 0; c < 64; ++c) counts[(rp[c] >> 7) & 0xFF]++;\n        }\n        for (int i = 0; i < 256; ++i) code_of[i] = -1;\n        for (int p = 0; p < 16; ++p) {\n            int best = 0, bestc = counts[0];\n            for (int e = 1; e < 256; ++e)\n                if (counts[e] > bestc) { bestc = counts[e]; best = e; }\n            hdr[ti * 16 + p] = (uint8_t)best;\n            code_of[best] = (int8_t)p;\n            counts[best] = -1;\n        }\n        std::vector<uint32_t>& gi = t_gi[u];\n        std::vector<uint16_t>& gv = t_gv[u];\n        for (int r = 0; r < 64; ++r) {\n            const uint16_t* rp = in + (r0 + r) * K_b + c0;\n            for (int c = 0; c < 64; ++c) {\n                uint16_t v = rp[c];\n                int code = code_of[(v >> 7) & 0xFF];\n                if (code < 0) {\n                    gi.push_back((uint32_t)((r0 + r) * K_b + (c0 + c)));\n                    gv.push_back(v);\n                    code = 0;\n                }\n","stderr":"","aggregated_output":"    __shared__ uint8_t  palette[16];\n    __shared__ int8_t   code_of_exp[256];\n\n    /* ---- Phase 1: zero hist + load tile + extract sm + build hist ---- */\n    if (tid < 256) hist[tid] = 0;\n    __syncthreads();\n\n    #pragma unroll 4\n    for (int local_idx = tid; local_idx < G * G; local_idx += blockDim.x) {\n        int r = local_idx / G;\n        int c = local_idx % G;\n        int64_t gidx = (int64_t)(tile_m * G + r) * K + (tile_k * G + c);\n        uint16_t v = in[gidx];\n        bf_tile[local_idx] = v;\n        uint8_t exp = (uint8_t)((v >> 7) & 0xffu);\n        uint8_t s_m = (uint8_t)(((v >> 15) & 0x1u) << 7)\n                    | (uint8_t)(v & 0x7fu);\n        sm[gidx] = s_m;\n        atomicAdd(&hist[exp], 1);\n    }\n    __syncthreads();\n\n    /* ---- Phase 2: thread 0 picks top-16 palette ---- */\n    if (tid == 0) {\n        #pragma unroll\n        for (int e = 0; e < 256; ++e) code_of_exp[e] = (int8_t)-1;\n        for (int p = 0; p < 16; ++p) {\n            int best = 0;\n            int best_cnt = hist[0];\n            for (int e = 1; e < 256; ++e) {\n                int c = hist[e];\n                if (c > best_cnt) { best = e; best_cnt = c; }\n            }\n            palette[p] = (uint8_t)best;\n            code_of_exp[best] = (int8_t)p;\n            hist[best] = -1;   /* mark used */\n        }\n    }\n    __syncthreads();\n\n    /* Write palette to global as one uint4 store (16 B). */\n    if (tid == 0) {\n        uint4 v;\n        v.x = ((uint32_t*)palette)[0];\n        v.y = ((uint32_t*)palette)[1];\n        v.z = ((uint32_t*)palette)[2];\n        v.w = ((uint32_t*)palette)[3];\n        *reinterpret_cast<uint4*>(&headers[tile].palette[0]) = v;\n    }\n\n    /* ---- Phase 3: encode codes + record exceptions ----\n     * Each thread handles pairs of adjacent elements so the two 4-bit\n     * codes pack into one byte without inter-thread aliasing. */\n    for (int local_idx = tid * 2; local_idx < G * G;\n         local_idx += blockDim.x * 2) {\n        int r = local_idx / G;\n        int c = local_idx % G;\n        int64_t gidx0 = (int64_t)(tile_m * G + r) * K + (tile_k * G + c);\n        int64_t gidx1 = gidx0 + 1;\n\n        uint16_t v0 = bf_tile[local_idx];\n        uint16_t v1 = bf_tile[local_idx + 1];\n        uint8_t exp0 = (uint8_t)((v0 >> 7) & 0xffu);\n        uint8_t exp1 = (uint8_t)((v1 >> 7) & 0xffu);\n        int code0 = (int)code_of_exp[exp0];\n        int code1 = (int)code_of_exp[exp1];\n\n        if (code0 < 0) {\n            code0 = 0;\n            int pos = atomicAdd(g_exc_count, 1);\n            if (pos < max_exc) {\n                exc_idx[pos] = (uint32_t)gidx0;\n                exc_val[pos] = v0;\n            }\n        }\n        if (code1 < 0) {\n            code1 = 0;\n            int pos = atomicAdd(g_exc_count, 1);\n            if (pos < max_exc) {\n                exc_idx[pos] = (uint32_t)gidx1;\n                exc_val[pos] = v1;\n            }\n        }\n        codes[gidx0 >> 1] = (uint8_t)(code0 | (code1 << 4));\n    }\n}\n\n/* ───────────────────────────────────────────────────────────────────\n *  Relayout: (M, K) row-major flat → tile-blocked\n *\n *  Compress writes codes/sm in flat (M, K) row-major.  Decompress\n *  reads in tile-blocked layout for ~5× better HBM cache-line\n *  utilisation.  This one-shot post-compress kernel does the\n *  reorganisation (one CTA per 64×64 palette tile).\n *\n *  Per CTA per tile:\n *    codes: 64 rows × 32 bytes (flat) → 4 BK-blocks × 64 × 8 (blocked)\n *    sm   : 64 × 64 bytes              → 4 × 64 × 16 bytes\n *\n *  Within the blocked layout, BK-block index advances slowest\n *  (BK0 ≡ K=0..15, BK1 ≡ K=16..31, …); rows are contiguous within a\n *  BK-block; columns are sequential within a row.\n * ─────────────────────────────────────────────────────────────────── */\n__global__ void BF16P4Flat_Relayout_Kernel(\n    const uint8_t* __restrict__ codes_flat,\n    const uint8_t* __restrict__ sm_flat,\n    uint8_t* __restrict__ codes_blocked,\n    uint8_t* __restrict__ sm_blocked,\n    int M, int K)\n{\n    constexpr int G = BF16_P4F_TILE_DIM;\n    constexpr int BK = BF16_P4F_BLOCK_BK;\n    constexpr int NUM_BK = G / BK;\n    int num_tiles_k = K / G;\n    int tile_m = blockIdx.y;\n    int tile_k = blockIdx.x;\n    int tile_idx = tile_m * num_tiles_k + tile_k;\n    int tid = threadIdx.x;\n\n    uint8_t* codes_tile = codes_blocked + (int64_t)tile_idx * (G * G / 2);\n    uint8_t* sm_tile    = sm_blocked    + (int64_t)tile_idx * (G * G);\n\n    /* codes: 8 bytes per (row, BK-block); LDG.u64 + STS.u64. */\n    constexpr int CHUNKS = NUM_BK * G;   /* 4 × 64 = 256 */\n    for (int c = tid; c < CHUNKS; c += blockDim.x) {\n        int bk_local = c / G;\n        int row      = c & (G - 1);\n        int m_global = tile_m * G + row;\n        int k_global = tile_k * G + bk_local * BK;\n        int64_t flat_off  = ((int64_t)m_global * K + k_global) >> 1;\n        int64_t block_off = (int64_t)bk_local * (G * BK / 2) + row * (BK / 2);\n        uint64_t w = *reinterpret_cast<const uint64_t*>(&codes_flat[flat_off]);\n        *reinterpret_cast<uint64_t*>(&codes_tile[block_off]) = w;\n    }\n    /* sm: 16 bytes per (row, BK-block); LDG.u128 + STS.u128. */\n    for (int c = tid; c < CHUNKS; c += blockDim.x) {\n        int bk_local = c / G;\n        int row      = c & (G - 1);\n        int m_global = tile_m * G + row;\n        int k_global = tile_k * G + bk_local * BK;\n        int64_t flat_off  = (int64_t)m_global * K + k_global;\n        int64_t block_off = (int64_t)bk_local * (G * BK) + row * BK;\n        uint4 v = *reinterpret_cast<const uint4*>(&sm_flat[flat_off]);\n        *reinterpret_cast<uint4*>(&sm_tile[block_off]) = v;\n    }\n}\n\nextern \"C\" cudaError_t BF16P4Flat_RelayoutToBlocked(\n    cudaStream_t stream,\n    const uint8_t* d_codes_flat,\n    const uint8_t* d_sm_flat,\n    uint8_t* d_codes_blocked,\n    uint8_t* d_sm_blocked,\n    int M, int K)\n{\n    constexpr int G = BF16_P4F_TILE_DIM;\n    if (M % G != 0 || K % G != 0) return cudaErrorInvalidValue;\n    dim3 grid((unsigned)(K / G), (unsigned)(M / G));\n    dim3 block(256);\n    BF16P4Flat_Relayout_Kernel<<<grid, block, 0, stream>>>(\n        d_codes_flat, d_sm_flat, d_codes_blocked, d_sm_blocked, M, K);\n    return cudaGetLastError();\n}\n\n/* ───────────────────────────────────────────────────────────────────\n *  Subtile codec classifier\n *\n *  One CTA per 64×64 palette tile, 4 warps × 4 subtiles each (16\n *  16×16 subtiles per palette tile).  Each warp:\n *    1. Reads its 16×16 subtile's codes (128 bytes contiguous in\n *       blocked layout) and decodes each code → exp via the palette.\n *    2. Warp-reduces (min, max) of exp.\n *    3. If max - min ≤ 15 (the delta-eligible case): re-encodes codes\n *       in-place as (exp - min) and writes marker = min to the\n *       subtile_codec tensor.  Otherwise marker = 0xFF and codes stay\n *       palette-indexed.\n *\n *  Decompress reads the marker and takes either the 1-ADD delta path\n *  or the 4-way palette select path.\n * ─────────────────────────────────────────────────────────────────── */\n__global__ void BF16P4Flat_BuildSubtileCodec_Kernel(\n    const BF16P4FlatHeader* __restrict__ headers,\n    uint8_t* __restrict__ codes,\n    uint8_t* __restrict__ subtile_codec,\n    int M, int K)\n{\n    constexpr int G = BF16_P4F_TILE_DIM;\n    constexpr int BK = BF16_P4F_BLOCK_BK;\n    constexpr int SUB = 16;\n    constexpr int SUBS_PER_TILE = (G / SUB) * (G / SUB);  /* 16 */\n    int num_tiles_k = K / G;\n    int tile_idx = blockIdx.y * num_tiles_k + blockIdx.x;\n    int tid = threadIdx.x;\n    int warp_id = tid >> 5;\n    int lane = tid & 31;\n\n *    C[m, n] += palette_decoded(m, k_global) * B[k_global, n]\n *  for all n. We need to add\n *    residual * B[k_global, n]  for all n\n *  where residual = true_val - palette_decoded(m, k_global).\n *\n *  To get palette_decoded(m, k_global), we re-run the per-element\n *  decompress logic using the same headers/codes/sm/subtile_codec.\n *\n *  Layout: one CTA per group (= per unique m row containing exceptions).\n *  Threads cooperate to scan that row's exceptions and add to C[m, :].\n *  Each thread covers a strip of N. ─────────────────────────────────── */\n__global__ __launch_bounds__(256, 4)\nvoid BF16P4Flat_FusedMM_PatchExceptions_Kernel(\n    const BF16P4FlatHeader* __restrict__ headers,\n    const uint8_t* __restrict__ codes,\n    const uint8_t* __restrict__ sign_mantissa,\n    const uint8_t* __restrict__ subtile_codec,\n    const uint32_t* __restrict__ exc_sorted_indices,\n    const uint16_t* __restrict__ exc_sorted_values,\n    const uint32_t* __restrict__ exc_group_m,\n    const uint32_t* __restrict__ exc_group_offsets,\n    const __nv_bfloat16* __restrict__ B,\n    __nv_bfloat16* __restrict__ C,\n    int M, int N, int K)\n{\n    constexpr int G = BF16_P4F_TILE_DIM;\n    constexpr int BK = BF16_P4F_BLOCK_BK;\n    int group = blockIdx.x;\n    int m = (int)exc_group_m[group];\n    int beg = (int)exc_group_offsets[group];\n    int end = (int)exc_group_offsets[group + 1];\n\n    int num_tiles_k = K / G;\n    int tile_m = m / G;\n    int row_in_tile = m & (G - 1);\n\n    /* For each exception in this row group, compute residual and\n     * add residual * B[k_global, n] into C[m, n].\n     * Each thread handles a different column n. */\n    for (int e = beg; e < end; ++e) {\n        uint32_t lin = exc_sorted_indices[e];\n        uint16_t true_val = exc_sorted_values[e];\n        int k_global = (int)(lin - (uint32_t)m * (uint32_t)K);\n        int tile_k = k_global / G;\n        int col_in_tile = k_global & (G - 1);\n        int tile_idx = tile_m * num_tiles_k + tile_k;\n\n        /* Recompute the palette-decoded bf16 at (m, k_global). */\n        int bk_local = col_in_tile / BK;\n        int k_in_bk  = col_in_tile & (BK - 1);\n        int64_t codes_byte_off = (int64_t)tile_idx * (G * G / 2)\n            + (int64_t)bk_local * (G * BK / 2)\n            + row_in_tile * (BK / 2)\n            + (k_in_bk / 2);\n        int64_t sm_byte_off    = (int64_t)tile_idx * (G * G)\n            + (int64_t)bk_local * (G * BK)\n            + row_in_tile * BK\n            + k_in_bk;\n\n        uint8_t code_byte = codes[codes_byte_off];\n        uint8_t code = (k_in_bk & 1) ? (code_byte >> 4) : (code_byte & 0xfu);\n        uint8_t sm = sign_mantissa[sm_byte_off];\n\n        int sub_m = row_in_tile >> 4;\n        int sub_k = col_in_tile >> 4;\n        int subtile_idx = sub_m * 4 + sub_k;\n        const uint8_t marker =\n            subtile_codec[(int64_t)tile_idx * 16 + subtile_idx];\n\n        uint8_t pexp;\n        if (marker != BF16_P4F_DELTA_PALETTE_MARKER) {\n            pexp = (uint8_t)(marker + code);\n        } else {\n            pexp = headers[tile_idx].palette[code];\n        }\n        uint16_t decoded_bits =\n            ((uint16_t)(sm & 0x80u) << 8) |\n            ((uint16_t)pexp << 7) |\n            (uint16_t)(sm & 0x7fu);\n\n        /* residual = true - decoded, in float space. */\n        __nv_bfloat16 true_bf = *reinterpret_cast<const __nv_bfloat16*>(&true_val);\n        __nv_bfloat16 dec_bf  = *reinterpret_cast<const __nv_bfloat16*>(&decoded_bits);\n        float residual = __bfloat162float(true_bf) - __bfloat162float(dec_bf);\n\n        if (residual == 0.0f) continue;\n}\n#else\nstatic inline void p4f_encode_tile(const uint16_t* in, int64_t r0, int64_t c0,\n        int64_t K_b, const int8_t* code_of, uint8_t* tile_code,\n        std::vector<uint32_t>& gi, std::vector<uint16_t>& gv) {\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int c = 0; c < 64; ++c) {\n            uint16_t v = rp[c];\n            int code = code_of[(v >> 7) & 0xFF];\n            if (code < 0) {\n                gi.push_back((uint32_t)((r0 + r) * K_b + (c0 + c)));\n                gv.push_back(v);\n                code = 0;\n            }\n            tile_code[r * 64 + c] = (uint8_t)code;\n        }\n    }\n}\n#endif\n\nvoid p4flat_host_encode_blocks(\n    torch::Tensor src,           // [n_src, M_b, K_b] int16/uint16, CPU contig\n    torch::Tensor block_ids,     // [B] int64 — source-block index per output\n    torch::Tensor slots,         // [B] int64 CPU — destination slot per block\n    torch::Tensor blob,          // [host_n, max_comp] uint8 CPU pool\n    torch::Tensor total_size,    // [host_n] int32 CPU\n    torch::Tensor exc_cnt,       // [host_n] int32 CPU\n    torch::Tensor is_raw,        // [host_n] uint8 CPU\n    torch::Tensor valid_rows_t,  // [host_n] int32 CPU\n    int64_t M_b, int64_t K_b, int64_t valid_tm) {\n    TORCH_CHECK(K_b % 64 == 0 && M_b % 64 == 0, \"M_b,K_b must be /64\");\n    const int64_t ntk = K_b / 64;\n    const int64_t ntm = M_b / 64;\n    if (valid_tm < 1) valid_tm = 1;\n    if (valid_tm > ntm) valid_tm = ntm;\n    const int64_t valid_rows = valid_tm * 64;\n    const int64_t hb_v = valid_tm * ntk * 16;\n    const int64_t cb_v = valid_rows * K_b / 2;\n    const int64_t smb_v = valid_rows * K_b;\n    const int64_t cdb_v = (valid_rows / 16) * (K_b / 16);\n    const int64_t fixed = hb_v + cb_v + smb_v + cdb_v;\n    const int64_t raw_v = valid_rows * K_b * 2;\n    const int64_t block_numel = M_b * K_b;\n    const int64_t B = slots.numel();\n\n    // Read source blocks directly by id (no host-side gather copy): the input\n    // block for output b is src[block_ids[b]].\n    const uint16_t* in_base =\n        reinterpret_cast<const uint16_t*>(src.data_ptr());\n    const int64_t* bid_p = block_ids.data_ptr<int64_t>();\n    uint8_t* blob_base = reinterpret_cast<uint8_t*>(blob.data_ptr());\n    const int64_t row_stride = blob.stride(0);\n    const int64_t* slot_p = slots.data_ptr<int64_t>();\n    int32_t* tot_p = total_size.data_ptr<int32_t>();\n    int32_t* ec_p = exc_cnt.data_ptr<int32_t>();\n    uint8_t* raw_p = is_raw.data_ptr<uint8_t>();\n    int32_t* vr_p = valid_rows_t.data_ptr<int32_t>();\n\n    py::gil_scoped_release no_gil;\n    #pragma omp parallel for schedule(static)\n    for (int64_t b = 0; b < B; ++b) {\n        const uint16_t* in = in_base + bid_p[b] * block_numel;\n        const int64_t slot = slot_p[b];\n        uint8_t* row = blob_base + slot * row_stride;\n        uint8_t* hdr = row;\n        uint8_t* codes = row + hb_v;\n        uint8_t* sm = row + hb_v + cb_v;\n        uint8_t* subt = sm + smb_v;\n\n        std::vector<uint32_t> gi;\n        std::vector<uint16_t> gv;\n        int counts[256];                              // exponent histogram\n        uint8_t nz_e[256]; int nz_c[256];             // nonzero exp buckets\n        int8_t code_of[256];\n        uint8_t tile_code[64 * 64];\n\n        for (int64_t tm = 0; tm < valid_tm; ++tm) {\n            for (int64_t tk = 0; tk < ntk; ++tk) {\n                const int64_t ti = tm * ntk + tk;\n                const int64_t r0 = tm * 64, c0 = tk * 64;\n                // SVE2-vectorised 256-bin exponent histogram (byte-exact).\n                p4f_hist64(in, r0, c0, K_b, counts);\n                // Collect nonzero exponent buckets (exp ascending) so the top-16\n                // selection scans the ~20-40 distinct exps, not all 256.\n                int nnz = 0;\n                for (int e = 0; e < 256; ++e)\n                    if (counts[e] > 0) {\n                        nz_e[nnz] = (uint8_t)e; nz_c[nnz] = counts[e]; ++nnz;\n                    }\n                for (int i = 0; i < 256; ++i) code_of[i] = -1;\n                // top-16 by freq (ties -> lowest exp, preserved by exp-asc order).\n                int npal = nnz < 16 ? nnz : 16;\n                for (int p = 0; p < npal; ++p) {\n                    int best = 0, bestc = nz_c[0];\n                    for (int j = 1; j < nnz; ++j)\n                        if (nz_c[j] > bestc) { bestc = nz_c[j]; best = j; }\n                    hdr[ti * 16 + p] = nz_e[best];\n                    code_of[nz_e[best]] = (int8_t)p;\n                    nz_c[best] = -1;\n                }\n                // <16 distinct exps: fill the rest with the lowest unused exps —\n                // byte-identical to the original 256-scan's zero-count fill.\n                for (int p = npal, e = 0; p < 16; ++p, ++e) {\n                    while (code_of[e] >= 0) ++e;\n                    hdr[ti * 16 + p] = (uint8_t)e;\n                    code_of[e] = (int8_t)p;\n                }\n                p4f_encode_tile(in, r0, c0, K_b, code_of, tile_code, gi, gv);\n                // pack 4-bit codes -> tile-blocked [bk(4), row(64), byte(8)]\n                uint8_t* tc = codes + ti * 2048;\n                for (int bk = 0; bk < 4; ++bk)\n                    for (int r = 0; r < 64; ++r) {\n                        const uint8_t* s = tile_code + r * 64 + bk * 16;\n                        uint8_t* d = tc + bk * 512 + r * 8;\n                        for (int j = 0; j < 8; ++j)\n                            d[j] = (s[2 * j] & 0xF) | ((s[2 * j + 1] & 0xF) << 4);\n                    }\n            }\n        }\n        // sign|mantissa, row-major over the valid rows\n        for (int64_t i = 0; i < smb_v; ++i) {\n            uint16_t v = in[i];\n            sm[i] = (uint8_t)((((v >> 15) & 1) << 7) | (v & 0x7F));\n        }\n        std::memset(subt, 0xFF, cdb_v);\n\n        const int64_t cnt = (int64_t)gi.size();\n        const int64_t total = fixed + cnt * 6;\n        // The blob ROW is row_stride bytes; never write past it.  Tight-stride\n        // pools deliberately make row_stride < raw_v so the common compressed\n        // case transfers fewer bytes.  A high-exception block can fit neither\n        // compressed nor raw in that row.  cpu_after_raw_swap already retains\n        // the authoritative raw block in secondary KV, so publish is_raw=2 and\n        // store no blob; the dense and fused decode paths restore that block\n        // from secondary instead of treating the tight row as corrupt.\n        if (total <= row_stride) {\n            uint8_t* ep = subt + cdb_v;\n            std::memcpy(ep, gi.data(), (size_t)cnt * 4);\n            std::memcpy(ep + cnt * 4, gv.data(), (size_t)cnt * 2);\n            tot_p[slot] = (int32_t)total;\n            ec_p[slot] = (int32_t)cnt;\n            raw_p[slot] = 0;\n        } else if (raw_v <= row_stride) {\n            std::memcpy(row, in, (size_t)raw_v);   // raw fallback (valid rows)\n            tot_p[slot] = (int32_t)raw_v;\n            ec_p[slot] = 0;\n            raw_p[slot] = 1;\n        } else {\n            tot_p[slot] = 0;\n            ec_p[slot] = 0;\n            raw_p[slot] = 2;  // restore from raw secondary KV during decode\n        }\n        vr_p[slot] = (int32_t)valid_rows;\n    }\n}\n\n// ─── TILE-PARALLEL variant of p4flat_host_encode_blocks ──────────────────\n// Byte-identical output, but the OpenMP parallelism is over (block x tile)\n// instead of over blocks only.  The block-parallel original starves when B <\n// thread count (e.g. weights: a few large blocks); tiles within a block are\n// independent (per-tile palette/codes/exceptions, fixed blob offsets), so\n// parallelising over B*TILES keeps every thread busy regardless of B.  The\n// only per-block serial bits — exception concatenation (in tile order, so the\n// blob stays identical), raw fallback and meta — run in a tiny phase-3 loop.\nvoid p4flat_host_encode_blocks_tp(\n    torch::Tensor src, torch::Tensor block_ids, torch::Tensor slots,\n    torch::Tensor blob, torch::Tensor total_size, torch::Tensor exc_cnt,\n    torch::Tensor is_raw, torch::Tensor valid_rows_t,\n    int64_t M_b, int64_t K_b, int64_t valid_tm) {\n    TORCH_CHECK(K_b % 64 == 0 && M_b % 64 == 0, \"M_b,K_b must be /64\");\n    const int64_t ntk = K_b / 64;\n    const int64_t ntm = M_b / 64;\n    if (valid_tm < 1) valid_tm = 1;\n    if (valid_tm > ntm) valid_tm = ntm;\n    const int64_t valid_rows = valid_tm * 64;\n    const int64_t hb_v = valid_tm * ntk * 16;\n    const int64_t cb_v = valid_rows * K_b / 2;\n    const int64_t