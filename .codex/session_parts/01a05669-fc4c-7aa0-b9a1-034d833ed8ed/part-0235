_global * K + k_global) >> 1;\n        int64_t block_off = (int64_t)bk_local * (G * BK / 2) + row * (BK / 2);\n        uint64_t w = *reinterpret_cast<const uint64_t*>(&codes_flat[flat_off]);\n        *reinterpret_cast<uint64_t*>(&codes_tile[block_off]) = w;\n    }\n    /* sm: 16 bytes per (row, BK-block); LDG.u128 + STS.u128. */\n    for (int c = tid; c < CHUNKS; c += blockDim.x) {\n        int bk_local = c / G;\n        int row      = c & (G - 1);\n        int m_global = tile_m * G + row;\n        int k_global = tile_k * G + bk_local * BK;\n        int64_t flat_off  = (int64_t)m_global * K + k_global;\n        int64_t block_off = (int64_t)bk_local * (G * BK) + row * BK;\n        uint4 v = *reinterpret_cast<const uint4*>(&sm_flat[flat_off]);\n        *reinterpret_cast<uint4*>(&sm_tile[block_off]) = v;\n    }\n}\n\nextern \"C\" cudaError_t BF16P4Flat_RelayoutToBlocked(\n    cudaStream_t stream,\n    const uint8_t* d_codes_flat,\n    const uint8_t* d_sm_flat,\n    uint8_t* d_codes_blocked,\n    uint8_t* d_sm_blocked,\n    int M, int K)\n{\n    constexpr int G = BF16_P4F_TILE_DIM;\n    if (M % G != 0 || K % G != 0) return cudaErrorInvalidValue;\n    dim3 grid((unsigned)(K / G), (unsigned)(M / G));\n    dim3 block(256);\n    BF16P4Flat_Relayout_Kernel<<<grid, block, 0, stream>>>(\n        d_codes_flat, d_sm_flat, d_codes_blocked, d_sm_blocked, M, K);\n    return cudaGetLastError();\n}\n\n/* ───────────────────────────────────────────────────────────────────\n *  Subtile codec classifier\n *\n *  One CTA per 64×64 palette tile, 4 warps × 4 subtiles each (16\n *  16×16 subtiles per palette tile).  Each warp:\n *    1. Reads its 16×16 subtile's codes (128 bytes contiguous in\n *       blocked layout) and decodes each code → exp via the palette.\n *    2. Warp-reduces (min, max) of exp.\n *    3. If max - min ≤ 15 (the delta-eligible case): re-encodes codes\n *       in-place as (exp - min) and writes marker = min to the\n *       subtile_codec tensor.  Otherwise marker = 0