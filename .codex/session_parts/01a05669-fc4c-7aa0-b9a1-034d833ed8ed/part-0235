 constexpr int BK = BF16_P4F_BLOCK_BK;\n    int group = blockIdx.x;\n    int m = (int)exc_group_m[group];\n    int beg = (int)exc_group_offsets[group];\n    int end = (int)exc_group_offsets[group + 1];\n\n    int num_tiles_k = K / G;\n    int tile_m = m / G;\n    int row_in_tile = m & (G - 1);\n\n    /* For each exception in this row group, compute residual and\n     * add residual * B[k_global, n] into C[m, n].\n     * Each thread handles a different column n. */\n    for (int e = beg; e < end; ++e) {\n        uint32_t lin = exc_sorted_indices[e];\n        uint16_t true_val = exc_sorted_values[e];\n        int k_global = (int)(lin - (uint32_t)m * (uint32_t)K);\n        int tile_k = k_global / G;\n        int col_in_tile = k_global & (G - 1);\n        int tile_idx = tile_m * num_tiles_k + tile_k;\n\n        /* Recompute the palette-decoded bf16 at (m, k_global). */\n        int bk_local = col_in_tile / BK;\n        int k_in_bk  = col_in_tile & (BK - 1);\n        int64_t codes_byte_off = (int64_t)tile_idx * (G * G / 2)\n            + (int64_t)bk_local * (G * BK / 2)\n            + row_in_tile * (BK / 2)\n            + (k_in_bk / 2);\n        int64_t sm_byte_off    = (int64_t)tile_idx * (G * G)\n            + (int64_t)bk_local * (G * BK)\n            + row_in_tile * BK\n            + k_in_bk;\n\n        uint8_t code_byte = codes[codes_byte_off];\n        uint8_t code = (k_in_bk & 1) ? (code_byte >> 4) : (code_byte & 0xfu);\n        uint8_t sm = sign_mantissa[sm_byte_off];\n\n        int sub_m = row_in_tile >> 4;\n        int sub_k = col_in_tile >> 4;\n        int subtile_idx = sub_m * 4 + sub_k;\n        const uint8_t marker =\n            subtile_codec[(int64_t)tile_idx * 16 + subtile_idx];\n\n        uint8_t pexp;\n        if (marker != BF16_P4F_DELTA_PALETTE_MARKER) {\n            pexp = (uint8_t)(marker + code);\n        } else {\n            pexp = headers[tile_idx].palette[code];\n        }\n        uint16_t decoded_bits =\n            ((uint16_t)(sm & 0x80u) << 8) |\n            ((uint16_t)pexp << 7) |\n            (uint16_t)(sm & 0x7fu);\n\n        /* residual = true - decoded, in float space. */\n        __nv_bfloat16 true_bf = *reinterpret_cast<const __nv_bfloat16*>(&true_val);\n        __nv_bfloat16 dec_bf  = *reinterpret_cast<const __nv_bfloat16*>(&decoded_bits);\n        float residual = __bfloat162float(true_bf) - __bfloat162float(dec_bf);\n\n        if (residual == 0.0f) continue;\n}\n#else\nstatic inline void p4f_encode_tile(const uint16_t* in, int64_t r0, int64_t c0,\n        int64_t K_b, const int8_t* code_of, uint8_t* tile_code,\n        std::vector<uint32_t>& gi, std::vector<uint16_t>& gv) {\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int c = 0; c < 64; ++c) {\n            uint16_t v = rp[c];\n            int code = code_of[(v >> 7) & 0xFF];\n            if (code < 0) {\n                gi.push_back((uint32_t)((r0 + r) * K_b + (c0 + c)));\n                gv.push_back(v);\n                code = 0;\n            }\n            tile_code[r * 64 + c] = (uint8_t)code;\n        }\n    }\n}\n#endif\n\nvoid p4flat_host_encode_blocks(\n    torch::Tensor src,           // [n_src, M_b, K_b] int16/uint16, CPU contig\n    torch::Tensor block_ids,     // [B] int64 — source-block index per output\n    torch::Tensor slots,         // [B] int64 CPU — destination slot per block\n    torch::Tensor blob,          // [host_n, max_comp] uint8 CPU pool\n    torch::Tensor total_size,    // [host_n] int32 CPU\n    torch::Tensor exc_cnt,       // [host_n] int32 CPU\n    torch::Tensor is_raw,        // [host_n] uint8 CPU\n    torch::Tensor valid_rows_t,  // [host_n] int32 CPU\n    int64_t M_b, int64_t K_b, int64_t valid_tm) {\n    TORCH_CHECK(K_b % 64 == 0 && M_b % 64 == 0, \"M_b,K_b must be /64\");\n    const int64_t ntk = K_b / 64;\n    const int64_t ntm = M_b / 64;\n    if (valid_tm < 1) valid_tm = 1;\n    if (valid_tm > ntm) valid_tm = ntm;\n    const int64_t valid_rows = valid_tm * 64;\n    const int64_t hb_v = valid_tm * ntk * 16;\n    const int64_t cb_v = valid_rows * K_b / 2;\n    const int64_t smb_v = valid_rows * K_b;\n    const int64_t cdb_v = (valid_rows / 16) * (K_b / 16);\n    const int64_t fixed = hb_v + cb_v + smb_v + cdb_v;\n    const int64_t raw_v = valid_rows * K_b * 2;\n    const int64_t block_numel = M_b * K_b;\n    const int64_t B = slots.numel();\n\n    // Read source blocks directly by id (no host-side gather copy): the input\n    // block for output b is src[block_ids[b]].\n    const uint16_t* in_base =\n        reinterpret_cast<const uint16_t*>(src.data_ptr());\n    const int64_t* bid_p = block_ids.data_ptr<int64_t>();\n    uint8_t* blob_base = reinterpret_cast<uint8_t*>(blob.data_ptr());\n    const int64_t row_stride = blob.stride(0);\n    const int64_t* slot_p = slots.data_ptr<int64_t>();\n    int32_t* tot_p = total_size.data_ptr<int32_t>();\n    int32_t* ec_p = exc_cnt.data_ptr<int32_t>();\n    uint8_t* raw_p = is_raw.data_ptr<uint8_t>();\n    int32_t* vr_p = valid_rows_t.data_ptr<int32_t>();\n\n    py::gil_scoped_release no_gil;\n    #pragma omp parallel for schedule(static)\n    for (int64_t b = 0; b < B; ++b) {\n        const uint16_t* in = in_base + bid_p[b] * block_numel;\n        const int64_t slot = slot_p[b];\n        uint8_t* row = blob_base + slot * row_stride;\n        uint8_t* hdr = row;\n        uint8_t* codes = row + hb_v;\n        uint8_t* sm = row + hb_v + cb_v;\n        uint8_t* subt = sm + smb_v;\n\n        std::vector<uint32_t> gi;\n        std::vector<uint16_t> gv;\n        int counts[256];                              // exponent histogram\n        uint8_t nz_e[256]; int nz_c[256];             // nonzero exp buckets\n        int8_t code_of[256];\n        uint8_t tile_code[64 * 64];\n\n        for (int64_t tm = 0; tm < valid_tm; ++tm) {\n            for (int64_t tk = 0; tk < ntk; ++tk) {\n                const int64_t ti = tm * ntk + tk;\n                const int64_t r0 = tm * 64, c0 = tk * 64;\n                // SVE2-vectorised 256-bin exponent histogram (byte-exact).\n                p4f_hist64(in, r0, c0, K_b, counts);\n                // Collect nonzero exponent buckets (exp ascending) so the top-16\n                // selection scans the ~20-40 distinct exps, not all 256.\n                int nnz = 0;\n                for (int e = 0; e < 256; ++e)\n                    if (counts[e] > 0) {\n                        nz_e[nnz] = (uint8_t)e; nz_c[nnz] = counts[e]; ++nnz;\n                    }\n                for (int i = 0; i < 256; ++i) code_of[i] = -1;\n                // top-16 by freq (ties -> lowest exp, preserved by exp-asc order).\n                int npal = nnz < 16 ? nnz : 16;\n                for (int p = 0; p < npal; ++p) {\n                    int best = 0, bestc = nz_c[0];\n                    for (int j = 1; j < nnz; ++j)\n                        if (nz_c[j] > bestc) { bestc = nz_c[j]; best = j; }\n                    hdr[ti * 16 + p] = nz_e[best];\n                    code_of[nz_e[best]] = (int8_t)p;\n                    nz_c[best] = -1;\n                }\n                // <16 distinct exps: fill the rest with the lowest unused exps —\n                // byte-identical to the original 256-scan's zero-count fill.\n                for (int p = npal, e = 0; p < 16; ++p, ++e) {\n                    while (code_of[e] >= 0) ++e;\n                    hdr[ti * 16 + p] = (uint8_t)e;\n                    code_of[e] = (int8_t)p;\n                }\n                p4f_encode_tile(in, r0, c0, K_b, code_of, tile_code, gi, gv);\n                // pack 4-bit codes -> tile-blocked [bk(4), row(64), byte(8)]\n                uint8_t* tc = codes + ti * 2048;\n                for (int bk = 0; bk < 4; ++bk)\n                    for (int r = 0; r < 64; ++r) {\n                        const uint8_t* s = tile_code + r * 64 + bk * 16;\n                        uint8_t* d = tc + bk * 512 + r * 8;\n                        for (int j = 0; j < 8; ++j)\n                            d[j] = (s[2 * j] & 0xF) | ((s[2 * j + 1] & 0xF) << 4);\n                    }\n            }\n        }\n        // sign|mantissa, row-major over the valid rows\n        for (int64_t i = 0; i < smb_v; ++i) {\n            uint16_t v = in[i];\n            sm[i] = (uint8_t)((((v >> 15) & 1) << 7) | (v & 0x7F));\n        }\n        std::memset(subt, 0xFF, cdb_v);\n\n        const int64_t cnt = (int64_t)gi.size();\n        const int64_t total = fixed + cnt * 6;\n        // The blob ROW is row_stride bytes; never write past it.  Tight-stride\n        // pools deliberately make row_stride < raw_v so the common compressed\n        // case transfers fewer bytes.  A high-exception block can fit neither\n        // compressed nor raw in that row.  cpu_after_raw_swap already retains\n        // the authoritative raw block in secondary KV, so publish is_raw=2 and\n        // store no blob; the dense and fused decode paths restore that block\n        // from secondary instead of treating the tight row as corrupt.\n        if (total <= row_stride) {\n            uint8_t* ep = subt + cdb_v;\n            std::memcpy(ep, gi.data(), (size_t)cnt * 4);\n            std::memcpy(ep + cnt * 4, gv.data(), (size_t)cnt * 2);\n            tot_p[slot] = (int32_t)total;\n            ec_p[slot] = (int32_t)cnt;\n            raw_p[slot] = 0;\n        } else if (raw_v <= row_stride) {\n            std::memcpy(row, in, (size_t)raw_v);   // raw fallback (valid rows)\n            tot_p[slot] = (int32_t)raw_v;\n            ec_p[slot] = 0;\n            raw_p[slot] = 1;\n        } else {\n            tot_p[slot] = 0;\n            ec_p[slot] = 0;\n            raw_p[slot] = 2;  // restore from raw secondary KV during decode\n        }\n        vr_p[slot] = (int32_t)valid_rows;\n    }\n}\n\n// ─── TILE-PARALLEL variant of p4flat_host_encode_blocks ──────────────────\n// Byte-identical output, but the OpenMP parallelism is over (block x tile)\n// instead of over blocks only.  The bl