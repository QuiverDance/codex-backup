          f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\\n                _cd3_ext, \\\"decompress_chunk_delta3_batched_blob_pair_stream\\\"):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the stream-aware batched decoder\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Two-stream event/ring overhead dominates very small copies.  Select\\n        # the pipelined path only once there is enough work to hide; the value\\n        # is deliberately exposed as a hardware-tuning knob.\\n        self._kv_split_min_blocks = max(1, int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BLOCKS\\\", \\\"256\\\")))\\n        self._dec_blob_ring_idx = 0\\n        self._gpu_decomp_pool_ring = []\\n        self._dec_blob_consumed = []\\n        self._tb = False\\n\\n        self._compressed_kv = {}\\n        self._persistent_valid = {}\\n        self._kv_slot = {}\\n        self._kv_slot_np = {}\\n        self._kv_slot_block = {}\\n   