 self._code_bytes, torch.uint8, 1),\\n            (\\\"sign_mantissa\\\", self._block_numel, torch.uint8, 1),\\n            (\\\"thread_bases\\\", self._base_bytes, torch.uint8, 1),\\n            (\\\"tile_exception_offsets\\\", self._tiles_per_block + 1,\\n             torch.int32, 4),\\n            (\\\"entries20x3\\\", self._packed_capacity, torch.int64, 8),\\n            (\\\"num_exceptions\\\", 1, torch.int32, 4),\\n        ):\\n            offset = _align_up(offset, alignment)\\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\\n            layout[name] = (offset, nbytes, width, dtype)\\n            offset += nbytes\\n        self._prepared_active_candidates = candidates\\n\\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= bid < table.size:\\n            return -1\\n        return int(table[bid])\\n\\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= block_id < table.size:\\n            return\\n        slot = int(table[block_id])\\n        if slot < 0:\\n            return\\n        self._invalidate_decode_plan(layer_id)\\n        table[block_id] = -1\\n        self._kv_slot_block[layer_id][slot] = -1\\n        free_set = self._kv_free_slots[layer_id]\\n        hwm = self._kv_active_count[layer_id]\\n        if slot == hwm - 1:\\n            hwm -= 1\\n            while hwm - 1 in free_set:\\n                free_set.discard(hwm - 1)\\n                hwm -= 1\\n            self._kv_active_count[layer_id] = hwm\\n        else:\\n            free_set.add(slot)\\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\\n\\n    @staticmethod\\n    def _slot_runs(slots: list[int]):\\n        \\\"\\\"\\\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\\\"\\\"\\\"\\n        if not slots:\\n            return\\n        row_begin = 0\\n        slot_begin = slots[0]\\n        previous = slot_begin\\n        for row in range(1, len(slots)):\\n            slot = slots[row]\\n            if slot != previous + 1:\\n                yield row_begin, row, slot_begin\\n                row_begin = row\\n                slot_begin = slot\\n            previous = slot\\n        yield row_begin, len(slots), slot_begin\\n\\n    def _batch_h2d(self, destinations: list[torch.Tensor],\\n                   sources: list[torch.Tensor],\\n                   stream: torch.cuda.Stream | None = None) -> None:\\n        \\\"\\\"\\\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\\\"\\\"\\\"\\n        if not destinations:\\n            return\\n        if len(destinations) == 1:\\n            if stream is None:\\n                destinations[0].copy_(sources[0], non_blocking=True)\\n            else:\\n                with torch.cuda.stream(stream):\\n                    destinations[0].copy_(sources[0], non_blocking=True)\\n            return\\n        from tiered_serve.cpp_exts import zipserv_ext\\n\\n        if not hasattr(zipserv_ext, \\\"batch_memcpy\\\"):\\n            raise RuntimeError(\\\"zipserv_ext.batch_memcpy is required for CD3 KV\\\")\\n        zipserv_ext.batch_memcpy(\\n            destinations, sources,\\n            (torch.cuda.current_stream().cuda_stream\\n             if stream is None else stream.cuda_stream))\\n\\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\\n                         output_buffers) -> None:\\n        \\\"\\\"\\\"Decode the active set published once at the forward boundary.\\\"\\\"\\\"\\n        k_cache, v_cache = output_buffers\\n        valid = self._persistent_valid.get(layer_id)\\n        if valid is None or len(active_block_ids) == 0:\\n            return\\n        if (active_block_ids is not self._prepared_active_list\\n                or self._prepared_active_candidates is None):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV active set was not prepared before decode\\\")\\n        candidates = self._prepared_active_candidates\\n        limit = min(int(k_cache.shape[0]), len(valid))\\n        if (candidates.size\\n                and (int(candidates[0]) < 0\\n                     or int(candidates[-1]) >= limit)):\\n            raise RuntimeError(\\\"ChunkDelta3 KV active block is out of range\\\")\\n        generation = self._decode_generation.get(layer_id, 0)\\n        version = self._prepared_active_version\\n        cached = self._decode_filtered.get(layer_id)\\n        if (cached is not None\\n                and cached[0] == generation\\n                and cached[3] == version):\\n            filtered = cached[2]\\n        else:\\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\\n            filtered = np.ascontiguousarray(\\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\\n            self._decode_filtered[layer_id] = (\\n                generation, candidates, filtered, version)\\n        if filtered.size == 0:\\n            return\\n\\n        capacity = self._max_gpu_decomp_blocks\\n        if filtered.size <= capacity:\\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\\n            return\\n        for start in range(0, filtered.size, capacity):\\n            self._decompress_blocks(\\n                layer_id, filtered[start:start + capacity],\\n                k_cache, v_cache)\\n\\n    def _build_decode_plan(self, layer_id: int,\\n                           block_ids: np.ndarray,\\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\\n        n = len(block_ids)\\n        hwm = self._kv_active_count[layer_id]\\n        slot_table = self._kv_slot_np[layer_id]\\n        slots_np = np.ascontiguousarray(\\n            slot_table[block_ids], dtype=np.int32)\\n        if bool((slots_np < 0).any()):\\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV has no slot for layer={layer_id} \\\"\\n                f\\\"block={missing}\\\")\\n\\n        # The production steady state is dense: all active physical slots are\\n        # requested.  Skip Python list conversion and run construction there.\\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\\n        slot_runs = None\\n        if dense:\\n            packed_h2d = False\\n        else:\\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\\n            max_runs = max(0, int(os.getenv(\\n                \\\"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\\\", \\\"8\\\")))\\n            packed_h2d = (\\n                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\\n                or hwm > self._max_gpu_decomp_blocks + 1)\\n\\n        slots_gpu = (\\n            self._identity_slots_gpu[:n]\\n            if packed_h2d else torch.as_tensor(\\n                slots_np, dtype=torch.int32, device=k_cache.device))\\n        block_ids_gpu = torch.as_tensor(\\n            block_ids, dtype=torch.long, device=k_cache.device)\\n        copy_destinations_ring = [[], []]\\n        copy_sources = []\\n        for kv in (\\\"k\\\", \\\"v\\\"):\\n            host_blob = self._host_pools[layer_id][kv][\\\"blob\\\"]\\n            if packed_h2d:\\n                for row_begin, row_end, slot_begin in slot_runs:\\n                    length = row_end - row_begin\\n                    for ring_index, gpu_pool in enumerate(\\n                            self._gpu_decomp_pool_ring):\\n                        copy_destinations_ring[ring_index].append(\\n                            gpu_pool[kv][\\\"blob\\\"][row_begin:row_end])\\n                    copy_sources.append(\\n                        host_blob[slot_begin:slot_begin + length])\\n            else:\\n                for ring_index, gpu_pool in enumerate(\\n                        self._gpu_decomp_pool_ring):\\n                    copy_destinations_ring[ring_index].append(\\n                        gpu_pool[kv][\\\"blob\\\"][:hwm])\\n                copy_sources.append(host_blob[:hwm])\\n        storage_rows = n if packed_h2d else hwm\\n        return {\\n            \\\"block_ids\\\": block_ids,\\n            \\\"generation\\\": self._decode_generation.get(layer_id, 0),\\n            \\\"slots_gpu\\\": slots_gpu,\\n            \\\"block_ids_gpu\\\": block_ids_gpu,\\n            \\\"copy_destinations_ring\\\": copy_destinations_ring,\\n            \\\"copy_sources\\\": copy_sources,\\n            \\\"storage_rows\\\": storage_rows,\\n        }\\n\\n    def _launch_decode(self, gpu_pool, plan, k_cache, v_cache) -> None:\\n        storage_rows = plan[\\\"storage_rows\\\"]\\n        _cd3_ext.decompress_chunk_delta3_batched_blob_pair_stream(\\n            gpu_pool[\\\"k\\\"][\\\"blob\\\"][:storage_rows],\\n            gpu_pool[\\\"v\\\"][\\\"blob\\\"][:storage_rows],\\n            plan[\\\"slots_gpu\\\"],\\n            plan[\\\"block_ids_gpu\\\"],\\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\\n            self._packed_capacity,\\n            self.batch_decomp_stream.cuda_stream,\\n        )\\n\\n    def _decompress_blocks(self, layer_id: int, block_ids,\\n                           k_cache: torch.Tensor,\\n                           v_cache: torch.Tensor) -> None:\\n        n = len(block_ids)\\n        if n == 0:\\n            return\\n        if n > self._max_gpu_decomp_blocks:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV decode batch {n} exceeds \\\"\\n                f\\\"capacity {self._max_gpu_decomp_blocks}\\\")\\n        if self._kv_active_count[layer_id] <= 0:\\n            return\\n        if not isinstance(block_ids, np.ndarray):\\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\\n        plan = self._decode_plans.get(layer_id)\\n        generation = self._decode_generation.get(layer_id, 0)\\n        if (plan is None or plan[\\\"block_ids\\\"] is not block_ids\\n                or plan[\\\"generation\\\"] != generation):\\n            # CUDA slot/output-index tensors created by plan construction are\\n            # consumed by the decode stream, so allocate/stage them there.\\n            with torch.cuda.stream(self.batch_decomp_stream):\\n                plan = self._build_decode_plan(\\n                    layer_id, block_ids, k_cache)\\n                self._decode_plans[layer_id] = plan\\n\\n        split = (self.load_kv_stream is not None\\n                 and self._kv_split_h2d_enabled\\n                 and n >= self._kv_split_min_blocks)\\n        if split:\\n            ring_slot = self._dec_blob_ring_idx & 1\\n            self._dec_blob_ring_idx += 1\\n            gpu_pool = self._gpu_decomp_pool_ring[ring_slot]\\n            h2d_stream = self.load_kv_stream\\n            h2d_stream.wait_event(self._dec_blob_consumed[ring_slot])\\n            if self._tb:\\n                self._kv_h2d_begin[layer_id].record(h2d_stream)\\n            self._batch_h2d(\\n                plan[\\\"copy_destinations_ring\\\"][ring_slot],\\n                plan[\\\"copy_sources\\\"], h2d_stream)\\n            # Host slots may be overwritten as soon as their pinned H2D reads\\n            # retire; they do not need to wait for GPU decode.\\n            self._kv_dec_h2d[layer_id].record(h2d_stream)\\n\\n            self.batch_decomp_stream.wait_event(\\n                self._kv_dec_h2d[layer_id])\\n            if self._tb:\\n                self._kv_decode_begin[layer_id].record(\\n                    self.batch_decomp_stream)\\n            self._launch_decode(gpu_pool, plan, k_cache, v_cache)\\n            self._dec_blob_consumed[ring_slot].record(\\n                self.batch_decomp_stream)\\n            return\\n\\n        gpu_pool = self._gpu_decomp_pool_ring[0]\\n        if self._tb:\\n            self._kv_h2d_begin[layer_id].record(\\n                self.batch_decomp_stream)\\n        self._batch_h2d(\\n            plan[\\\"copy_destinations_ring\\\"][0], plan[\\\"copy_sources\\\"],\\n            self.batch_decomp_stream)\\n        self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\\n        if self._tb:\\n            self._kv_decode_begin[layer_id].record(\\n                self.batch_decomp_stream)\\n        self._launch_decode(gpu_pool, plan, k_cache, v_cache)\\n\\n\\n_cudart_lib = None\\n_cudart_lock = threading.Lock()\\n\\n\\ndef _get_cudart():\\n    global _cudart_lib\\n    if _cudart_lib is not None:\\n        return _cudart_lib\\n    with _cudart_lock:\\n        if _cudart_lib is None:\\n            lib = None\\n            candidates = sorted(glob.glob(os.path.join(\\n                os.path.dirname(torch.__file__), \\\"lib\\\", \\\"libcudart*.so*\\\")))\\n            for candidate in candidates:\\n                try:\\n                    lib = ctypes.CDLL(candidate)\\n                    break\\n                except OSError:\\n                    continue\\n            if lib is None:\\n                try:\\n    return (numel // 64, 64)\\n\\n\\nclass P4FlatKVCompressor(DietGPUKVCompressor):\\n    \\\"\\\"\\\"BF16 P4-flat KV cache compressor (GPU-kernel backend).\\\"\\\"\\\"\\n\\n    # The GPU-encode path uses the batched-compress pinned staging; the\\n    # CPU-encode subclass overrides this to skip allocating it.\\n    _USES_GPU_COMPRESS = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_P4FLAT:\\n            raise RuntimeError(\\n                \\\"P4FlatKVCompressor requires tiered-serve's zipserv_p4flat_ext \\\"\\n                \\\"extension to build successfully.\\\")\\n        # Bypass DietGPUKVCompressor.__init__ (it loads DietGPU and allocates\\n        # an ANS workspace we don't need); initialise the shared state directly.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\\n        # the compute stream — used as a plain attribute, no per-call resolution.\\n        self._kv_decode_on_compute = os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_ON_COMPUTE\\\", \\\"0\\\") == \\\"1\\\"\\n        # KV-load stream separation: run the compressed-blob H2D on the\\n        # dedicated load_kv_stream (wired by the loader) instead of\\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\\n        # pipelines with layer L's decode.  load_kv_stream is gated on\\n        # \\\"QKV weights loaded\\\" by the graph wrapper, so the blob H2D starts\\n        # when the single copy engine is free of weight H2D — otherwise it\\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\\n        # loader wires one (it aliases it to load_weight_stream), and falls back\\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\\n        # wired (e.g. a standalone compressor with no loader).\\n        self.load_kv_stream = None   # wired by the loader after construction\\n        self._dec_blob_ring_idx = 0\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Set by the loader from time_breakdown.  When False, the decode skips\\n        # the breakdown-only event records (_kv_h2d_begin) — the per-step CUDA\\n        # event record() was ~12% of forward-thread CPU in profiling.\\n        self._tb = False\\n\\n        # Per-decode metadata (slots / valid_rows / exc_cnt / is_raw) H2D.\\n        # Default = async ring of pinned buffers, event-gated so a lagging\\n        # in-flight H2D is never overwritten on reuse — the exact failure that\\n        # forced the old synchronous ``torch.stack(...).cuda()`` (pageable ->\\n        # ~1 ms/graph CPU dispatch that starves the GPU).  Set\\n        # TIERED_SERVE_KV_META_SYNC=1 to restore that legacy sync path.\\n        self._meta_sync_fallback = os.getenv(\\n            \\\"TIERED_SERVE_KV_META_SYNC\\\", \\\"0\\\") == \\\"1\\\"\\n        self._meta_ring_n = 0\\n        self._meta_ring_pi = None   # list[pinned int32 [5*cap]]  (cs,vrk,eck,vrv,ecv)\\n        self._meta_ring_pu = None   # list[pinned uint8 [2*cap]]  (is_raw k,v)\\n        self._meta_ring_b = None    # list[pinned int64 [cap]]    (block_ids)\\n        self._meta_ring_ev = None   # list[cuda.Event] gating buffer reuse\\n        self._meta_ring_idx = 0\\n\\n        # Reused, codec-agnostic persistent-slot bookkeeping (see base class).\\n        self._compressed_kv: Dict[int, Any] = {}\\n        self._persistent_valid: Dict[int, bytearray] = {}\\n        self._kv_slot: Dict[int, torch.Tensor] = {}\\n        self._kv_slot_np: Dict[int, Any] = {}   # numpy authority (shared mem)\\n        self._kv_slot_block: Dict[int, List[int]] = {}\\n        # P4Flat free-list slot management (overrides the base dense\\n        # swap-with-last).  ``_kv_active_count`` is repurposed as the staging\\n        # HIGH-WATER-MARK (max-assigned-slot + 1 = the [0:hwm] extent the decode\\n        # H2D copies); freed slots go to a per-layer min-heap and are refilled\\n        # lowest-first so hwm — hence the decode over-copy — stays tight, and\\n        # top-of-range frees shrink hwm.  This makes ``free`` metadata-only (no\\n        # _move_host_slot host memcpy, no decode-stream sync) — see\\n        # ``_free_kv_slot`` and ``_kv_free_metadata_only`` below.\\n        self._kv_active_count: Dict[int, int] = {}   # == hwm per layer\\n        self._kv_free_heap: Dict[int, list] = {}     # min-heap of free slots\\n        self._kv_free_slots: Dict[int, set] = {}     # membership (lazy-delete)\\n        # Signals dual_memory_loader.kv.free_slot that this compressor's free path touches no\\n        # GPU/host pool memory, so the pre-free decode-stream sync is unneeded.\\n        self._kv_free_metadata_only = True\\n        # Decode staging H2D: copy only the occupied (live) slot RUNS in\\n        # [0:hwm), batching them into one cudaMemcpyBatchAsync so holes\\n        # (freed-not-yet-realloc'd slots — possible whenever frees outpace\\n        # allocs, e.g. a drain phase) aren't transferred.  ``free_set`` is the\\n        # sparse bitarray of holes, so runs come from a membership split (no\\n        # sort).  Below this hole count a single [0:hwm] copy is cheaper than\\n        # the scan, so we skip it (env-tunable; 0 = always batch).\\n        self._decode_hole_threshold = int(os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_HOLE_THRESHOLD\\\", \\\"32\\\"))\\n        self._batch_ext = None      # cached zipserv_ext for batch_memcpy\\n        # Decode-arg CPU-dispatch trims (the per-layer Python/torch op count is\\n        # what stalls before_replay — ~20 dispatches x n_layers showed up as\\n        # ~2 ms of forward-thread CPU before the blob batchmemcpy in nsys):\\n        #  - grid sizing uses STATIC caps (M_b / exc_cap) instead of four\\n        #    per-layer pinned .max() reductions; the per-block device arrays\\n        #    still bound each block's work in-kernel.\\n        #    TIERED_SERVE_KV_DECODE_VALIDATE=1 restores the exact maxes\\n        #    (tighter grids + full corrupt-meta detection) for debugging.\\n        #  - the block-id vector is identical for every layer of a step, so\\n        #    its CPU tensor + device upload are cached step-level\\n        #    (content-keyed) and reused by the remaining n_layers-1 decodes.\\n        self._decode_validate = os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_VALIDATE\\\", \\\"0\\\") == \\\"1\\\"\\n        self._cbids_cache_np = None    # np.int64 id vector (content key)\\n            v_cache.index_copy_(\\n                0, dev, sec[1][idx].to(v_cache.device, non_blocking=True))\\n\\n    def _decode_layer_cpp(self, layer_id: int, active: int,\\n                          k_cache: torch.Tensor,\\n                          v_cache: torch.Tensor,\\n                          candidates_t: torch.Tensor = None) -> None:\\n        \\\"\\\"\\\"Per-layer KV decode via the C++ ``decode_layer_prep`` entry.\\n\\n        One pybind call stages everything (valid filter, slot/meta gather\\n        into the pinned ring, meta + blob async H2D, ring/dec event\\n        records); only the two codec decode kernels remain in Python (they\\n        are codec-specific overrides — ``_invoke_decode_kernel``).\\\"\\\"\\\"\\n        if _ENV_KV_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_push(f\\\"kv_decode_cpp L{layer_id}\\\")\\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\\\\n            self._dec_fast[layer_id]\\n        ri = self._meta_ring_idx % self._meta_ring_n\\n        self._meta_ring_idx += 1\\n        # H2D-on-load_kv_stream split: run the blob+meta H2D on load_kv_stream\\n        # (aliased to load_weight_stream) so it is SERIAL with weight on the\\n        # single GH200 copy engine — KVLoad's _kv_h2d_begin.._kv_dec_h2d bracket\\n        # then measures pure transfer in its own engine slot, not the\\n        # cross-stream engine-queue wait it absorbed on batch_decomp_stream\\n        # (WLoad+KVLoad <= GPUFwd).  Decode kernels stay on batch_decomp_stream\\n        # (what exec's attn barrier waits on) and gate on _kv_dec_h2d.  Two load\\n        # buffers (_dec_blob_ring): layer L+1's H2D writes the OTHER slot than\\n        # layer L's decode is reading, so H2D(L+1) overlaps decode(L); the\\n        # per-slot ``consumed`` event gates reuse — the 