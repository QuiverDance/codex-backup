ng_idx % self._meta_ring_n\\n        self._meta_ring_idx += 1\\n        # H2D-on-load_kv_stream split: run the blob+meta H2D on load_kv_stream\\n        # (aliased to load_weight_stream) so it is SERIAL with weight on the\\n        # single GH200 copy engine — KVLoad's _kv_h2d_begin.._kv_dec_h2d bracket\\n        # then measures pure transfer in its own engine slot, not the\\n        # cross-stream engine-queue wait it absorbed on batch_decomp_stream\\n        # (WLoad+KVLoad <= GPUFwd).  Decode kernels stay on batch_decomp_stream\\n        # (what exec's attn barrier waits on) and gate on _kv_dec_h2d.  Two load\\n        # buffers (_dec_blob_ring): layer L+1's H2D writes the OTHER slot than\\n        # layer L's decode is reading, so H2D(L+1) overlaps decode(L); the\\n        # per-slot ``consumed`` event gates reuse — the H2D waits the slot's\\n        # previous decode before overwriting it.  Just the waits, no extra\\n        # bookkeeping.\\n        _split = (self.load_kv_stream is not None\\n                  and self._kv_split_h2d_enabled)\\n        if _split:\\n            slot = self._dec_blob_ring_idx & 1\\n            self._dec_blob_ring_idx += 1\\n            blob_k = self._dec_blob_ring[slot]\\n            blob_v = self._dec_blob_v_ring[slot]\\n            h2d_stream = self.load_kv_stream\\n            if self._dec_blob_consumed is not None:\\n                h2d_stream.wait_event(self._dec_blob_consumed[slot])\\n        else:\\n            slot = 0\\n            blob_k, blob_v = self._gpu_dec_blob, self._gpu_dec_blob_v\\n            h2d_stream = self.batch_decomp_stream\\n        # DEVICE meta buffers ride the SAME ring slot as the blob (see __init__):\\n        # the meta H2D + the decode read use this slot's buffers, and\\n        # _dec_blob_consumed[slot] already gates its reuse — so the split's\\n        # cross-stream meta H2D can't overwrite a buffer the decode is reading.\\n        gi_dev = self._gi_dev_ring[slot]\\n        gu_dev = self._gu_de