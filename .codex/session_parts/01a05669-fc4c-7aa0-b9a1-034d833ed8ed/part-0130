mpress_persistent(\n        self,\n        layer_id: int,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> None:\n        \"\"\"Complete the common split-phase API (work queued by ``start``).\"\"\"\n        return\n\n    # ------------------------------------------------------------------\n    #  Core decompress kernel\n    # ------------------------------------------------------------------\n\n    def _decompress_blocks(self, layer_id: int,\n                           block_ids: list,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            # Recurse via caller chunking; defensive guard\n            raise RuntimeError(\n                f\"DietGPU KV decompress: n={n} exceeds \"\n                f\"max_gpu_decomp_blocks={self._max_gpu_decomp_blocks}\")\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        decomp_k = self._gpu_decomp_pool['k']\n        decomp_v = self._gpu_decomp_pool['v']\n        B = self._block_numel\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            # 1. H2D compressed exp + sm rows per block (loop, async).\n            gpu_k_comp = decomp_k['comp_exp'][:n]\n            gpu_v_comp = decomp_v['comp_exp'][:n]\n            gpu_k_sm = decomp_k['sm'][:n]\n            gpu_v_sm = decomp_v['sm'][:n]\n            physical_slots = []\n            for i, bid in enumerate(block_ids):\n                slot = self._get_kv_slot(layer_id, bid)\n                if slot < 0:\n                    raise RuntimeError(\n                        f\"DietGPU KV: no compressed slot for \"\n                        f\"layer={layer_id} bid={bid}\")\n                physical_slots.append(slot)\n                gpu_k_comp[i].copy_(\n                    host_k['comp_exp'][slot], non_blocking=True)\n                gpu_v_comp[i].copy_(\n                    host_v['comp_exp'][slot], non_blocking=True)\n                gpu_k_sm[i].copy_(host_k['sm'][slot], non_blocking=True)\n                gpu_v_sm[i].copy_(host_v['sm'][slot], non_blocking=True)\n\n            # 2. Build per-block views sized by actual compressed length.\n            k_in_list: List[torch.Tensor] = []\n            v_in_list: List[torch.Tensor] = []\n            k_out_list: List[torch.Tensor] = []\n            v_out_list: List[torch.Tensor] = []\n            for i, slot in enumerate(physical_slots):\n                ksz = int(host_k['exp_sizes'][slot].item())\n                vsz = int(host_v['exp_sizes'][slot].item())\n                k_in_list.append(gpu_k_comp[i, :ksz])\n                v_in_list.append(gpu_v_comp[i, :vsz])\n                k_out_list.append(decomp_k['exp'][i])\n                v_out_list.append(decomp_v['exp'][i])\n\n            torch.ops.dietgpu.decompress_data(\n                False, k_in_list, k_out_list, False, self._workspace)\n            torch.ops.dietgpu.decompress_data(\n                False, v_in_list, v_out_list, False, self._workspace)\n\n            # 3. Reconstruct BF16 from exp + sm using fused Triton kernel.\n            k_bf16 = self._bf16_decomp_out['k'][:n]\n            v_bf16 = self._bf16_decomp_out['v'][:n]\n            dietgpu_reconstruct(\n                decomp_k['exp'][:n].view(n * B),\n                gpu_k_sm.view(n * B),\n                k_bf16.view(n * B))\n            dietgpu_reconstruct(\n                decomp_v['exp'][:n].view(n * B),\n                gpu_v_sm.view(n * B),\n                v_bf16.view(n * B))\n\n            # 4. Scatter into cache.\n            bid_gpu = torch.as_tensor(\n                block_ids, dtype=torch.long, device=k_cache.device)\n            k_cache[bid_gpu] = k_bf16.reshape(n, *self._block_shape)\n            v_cache[bid_gpu] = v_bf16.re