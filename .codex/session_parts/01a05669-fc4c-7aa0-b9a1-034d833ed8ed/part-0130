   self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._bf16_decomp_out = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._max_n_blocks = 0\n        self._max_gpu_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        tiles = block_elements // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n        return (\n            tiles * 1536 + block_elements + tiles * 256\n            + (tiles + 1) * 4 + (entry_capacity // 3) * 8 + 4\n        )\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            for page_type in (\"kv\", \"weight\"):\n                try:\n                    return huge_page_allocator.allocate(\n                        (numel,), (1,), dtype, page_type=page_type).view(shape)\n                except (MemoryError, ValueError):\n                    pass\n        return torch.empty(shape, dty