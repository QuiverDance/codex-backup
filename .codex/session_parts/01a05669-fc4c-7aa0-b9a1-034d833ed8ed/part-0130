umel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_comp_pool = {\n            \"k\": self._pool(max_gpu_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_blocks + 1, \"cuda\"),\n        }\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        self._bf16_decomp_out = {\n            \"k\": torch.empty(\n                max_gpu_decomp_blocks, M_b, K_b,\n                dtype=torch.bfloat16, device=\"cuda\"),\n            \"v\": torch.empty(\n                max_gpu_decomp_blocks, M_b, K_b,\n                dtype=torch.bfloat16, device=\"cuda\"),\n        }\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n            for layer in range(n_layers)}\n        self._kv_slot_np = {\n            layer: self._kv_slot[layer].numpy()\n            for layer in range(n_layers)}\n        self._kv_slot_block = {\n            layer: [-1] * host_n for layer in range(n_layers)}\n        self._kv_active_count = {\n            layer: 0 for layer in range(n_layers)}\n        self._kv_free_heap = {layer: [] for layer in range(n_layers)}\n        self._kv_free_slots = {layer: set() for layer in range(n_layers)}\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            for name in self._FIELDS:\n                pool[name][dst_slot].copy_(pool[name][src_slot])\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_table = self._kv_slot_np[layer_id]\n        previous = int(slot_table[bid])\n        if previous >= 0:\n            return previous\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot = -1\n        while heap:\n            candidate = heapq.heappop(heap)\n            if candidate in free_set:\n                free_set.discard(candidate)\n                slot = candidate\n                break\n        if slot < 0:\n            slot = self._kv_active_count[layer_id]\n            if slot >= len(self._kv_slot_block[layer_id]):\n                raise RuntimeError(\n                    f\"ChunkDelta3 KV persistent slot pool full for \"\n                    f\"layer={layer_id}\")\n            self._kv_active_count[layer_id] = slot + 1\n        slot_table[bid] = slot\n        self._kv_slot_block[layer_id][slot] = bid\n        return slot\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05763-68a2-74f2-a524-d67eb0eee000","create_time":1788172538.6915169}}}
