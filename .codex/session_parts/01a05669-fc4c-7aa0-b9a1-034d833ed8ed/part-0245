y lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n                if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                    self.end_frozen_decomp_timing_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path stays event-light.\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                # WDecomp timing for the split path is recorded tightly\n                # around each _frozen_split_run_decompress kernel below\n                # (AFTER its H2D wait_event), NOT here.  The old coarse\n                # per-comp_key begin/end straddled every tensor's (and\n                # pipelined group's) H2D wait_event, so WDecomp absorbed the\n                # LPDDR->HBM load-wait bubble — already counted in WLoad —\n                # and read ~= GPUFwd while Compute looked tiny.  Per-kernel\n                # intervals are unioned into WDecomp via\n                # frozen_split_decomp_intervals; the load-wait now correctly\n                # surfaces as Stall.  (begin/end_frozen_decomp_events stay\n                # for the frozen_compressed path, which has no separate H2D.)\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    info = split_data.get(name)\n                    if info is None:\n                        continue\n                    staging = self.frozen_split_staging[name][staging_parity]\n                    output = self.frozen_primary_buffer_pair[name][output_parity]\n                    backend_compressor = self._resolve_backend_compressor(\n                        info, layer_id, comp_key)\n\n                    if is_prefill:\n                        # Prefill weight path. Two sub-cases:\n                        #  * Chunk < PREFILL_ALT_MAX_CHUNK WITH an alt codec\n                        #    stored: H2D the compressed exp into alt staging and\n                        #    decode it (less H2D than raw_bf16). The alt is the\n                        #    primary codec reused (unified) or a distinct\n                        #    fast-decode codec (e.g. p4flat).\n                        #  * Larger chunk or no alt: the big GEMM amortises the\n                        #    H2D, so take the raw_bf16 fast path (full BF16 copy,\n                        #    no reconstruct kernel at all).\n                        if (info.alt is not None\n                                and self.cur_num_tokens\n                                < self._alt_max_chunk_for(info.alt.backend)):\n                            alt = info.alt\n                            # Unified alt (same codec as primary) reuses the\n                            # already-resolved concrete compressor — the\n                            # zipserv/dietgpu decode needs its ._ext / workspace\n                            # helpers, which the _AutoWeightCompressor wrapper\n                            # that _get_or_make_backend returns does not expose.\n                            alt_comp = (\n                                backend_compressor\n                                if alt.backend == info.backend\n                                else self._get_or_make_backend(alt.backend))\n                            self._materialize_frozen_split_prefill_alt(\n                                layer_id, name, alt, output, alt_comp)\n                        else:\n                            src = info.lpddr_buffers[\"raw_bf16\"]\n                            # H2D on load_weight_stream (copy stream) so the\n                            # LPDDR→HBM transfer overlaps exec_stream's GEMMs\n                            # instead of blocking the compute stream.\n                            # decomp_weight_stream == exec_stream; the wait\n                            # below ensures frozen_decomp_events recorded on\n                            # decomp_weight_stream (line ~880) fire after the H2D.\n                            with torch.cuda.stream(self.load_weight_stream):\n                                if tb:\n                                    self._frozen_split_h2d_begin_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                                output.view(src.shape).copy_(\n                                    src, non_blocking=True)\n                                if tb:\n                                    self._frozen_split_h2d_end_timing_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                            self.decomp_weight_stream.wait_stream(\n                                self.load_weight_stream)\n                    elif self._ats_decomp_frozen:\n                        # Decode path (ATS): the LPDDR hugepage memory is\n                        # already cudaHostRegister-mapped, so the GPU\n                        # kernel can dereference its host pointer directly\n                        # via ATS / NVLink-C2C UVA. Skip H2D into staging\n                        # and pass the LPDDR tensors straight to the\n                        # decompress kernel.\n                        if not getattr(self, \"_ats_decomp_logged\", False):\n                            sample = info.lpddr_buffers[info.lpddr_attrs[0]]\n                            logger.info(\n                                \"[ATS-decomp] frozen_split decode reading \"\n                                \"compressed bytes directly from LPDDR via ATS \"\n                                \"(no H2D staging): backend=%s first L%d.%s \"\n                                \"attr=%s device=%s ptr=0x%x\",\n                                info.backend, layer_id, name,\n                                info.lpddr_attrs[0], sample.device,\n                                sample.data_ptr())\n                            self._ats_decomp_logged = True\n                        # ATS reads LPDDR via UVA inside the kernel (no\n                        # separate H2D wait), so the kernel window IS the\n                        # decomp+load — time it directly.\n                        if tb:\n                            self._frozen_split_decomp_begin_timing_event(\n                                layer_id, name).record(\n                                    self.decomp_weight_stream)\n                        self._frozen_split_run_decompress(\n                            info,\n                            info.lpddr_buffers,\n                            info.lpddr_numels,\n                            output,\n                            backend_compressor)\n                        if tb:\n                            self._frozen_split_decomp_end_timing_event(\n                                layer_id, name).record(\n                                    self.decomp_weight_stream)\n        # frozen_compressed cells always launch a decoder on exec; unlike a\n        # sufficiently-large frozen_split cell they never turn into raw H2D.\n        # Raw's pre-before-eager scheduling is therefore unsafe for a mixed\n        # frozen_compressed + frozen_split placement even after every split cell\n        # crosses its alt cutoff.\n        frozen_comp_cells = sum(\n            len(layer) for layer in (\n                getattr(self, \"frozen_comp_buffers\", None) or ()) if layer\n        )\n\n        ceiling = int(getattr(self, \"_cudagraph_ceiling\", 0) or 0)\n        self._prefill_raw_lookahead_has_split = bool(split_cells)\n        self._prefill_raw_lookahead_split_cells = split_cells\n        self._prefill_raw_lookahead_frozen_comp_cells = frozen_comp_cells\n        self._prefill_raw_lookahead_min_tokens = (\n            max(ceiling + 1, max_alt_cutoff)\n            if split_cells and not frozen_comp_cells and ceiling > 0 else None\n        )\n\n    def _offload_prefill_max_chunk_for(self, backend):\n        \"\"\"Per-codec offload_compressed prefill threshold: chunks SMALLER than\n        this decode the compressed copy instead of H2D'ing the uncompressed one.\n\n        Resolution mirrors _alt_max_chunk_for (env per-codec -> env single int\n        -> built-in default), but the final fallback is 0 (DISABLED) rather than\n        a global default: offload prefill-compress is opt-in until its (mode-\n        distinct) crossover is calibrated. Returns 0 when nothing is set.\"\"\"\n        v = self._offload_prefill_max_chunk_by_backend.get(backend)\n        if v is not None:\n            return v\n        if self._offload_prefill_max_chunk is not None:\n            return self._offload_prefill_max_chunk\n        return _OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS.get(backend, 0)\n\n    def _offload_codec_name(self, layer_id, comp_key):\n        \"\"\"Backend name of the offload_compressed codec for one (layer,\n        component): the per-cell YAML override if present, else the configured\n        offload backend.\"\"\"\n        tm = getattr(self, \"torch_model\", None)\n        if tm is not None and comp_key is not None:\n            comps = getattr(tm, \"layer_weight_compressor\", None)\n            if comps is not None and 0 <= layer_id < len(comps):\n                be = comps[layer_id].get(comp_key)\n                if be:\n                    return be.lower()\n        return getattr(self, \"_offload_backend\", None) or \"zipserv\"\n\n    def _attach_prefill_alt(self, info, gpu_target, hbm_sm, name):\n        \"\"\"Compress ``gpu_target`` a second way with the prefill-alt codec and\n        attach it to ``info.alt`` as a full SplitStorageInfo that ALIASES the\n        primary's HBM ``sign_mantissa`` (only the compressed-exp side is new).\n\n        Only p4flat is supported as the alt codec for now (its decode is the\n        cheap branchless palette path). The alt's LPDDR buffers live under the\n        p4flat attr keys in their own dict, so there is no key collision with\n        the primary's buffers. Per-name GPU staging is allocated so the prefill\n        decode H2Ds LPDDR->GPU first (NO direct-LPDDR/ATS read).\n        \"\"\"\n        alt_name = self._prefill_alt_backend\n        comp = self._get_or_make_backend(alt_name)\n        try:\n            with torch.cuda.stream(self.decomp_weight_stream):\n                alt_comped = comp.compress(gpu_target)\n                torch.cuda.synchronize()\n        except Exception as e:\n            # e.g. p4flat requires dims multiple of 64; if a weight can't be\n            # alt-compressed, skip it — prefill keeps the raw_bf16 fast path\n            # for that tensor (info.alt stays None).\n            logger.warning(\"prefill-alt (%s) compress skipped for a weight \"\n                           \"(%s): %s\", alt_name, type(e).__name__, e)\n            return\n        if not isinstance(alt_comped, CompressedP4FlatTensor):\n            raise RuntimeError(\n                f\"prefill-alt backend '{alt_name}' unsupported \"\n                f\"(only p4flat); got {type(alt_comped).__name__}\")\n        # Canonical shared sm: the primary already stores ONE (M,K) row-major\n        # all-element sign|mantissa on HBM (``hbm_sm``). The p4flat alt SHARES\n        # it (no clone, no LPDDR sm) and decodes in row-major mode (its native\n        # tile-blocked sm from compress is dropped). Only the p4flat exp side\n        # (palette headers + codes + exceptions) ships to LPDDR.\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        metadata = {\n            \"M\": int(alt_comped.M), \"K\": int(alt_comped.K),\n            \"num_exceptions\": int(alt_comped.num_exceptions),\n            \"num_groups\": int(alt_comped.num_groups),\n        }\n        lpddr_bufs: Dict[str, torch.Tensor] = {}\n        for attr in lpddr_attrs:\n            gpu_buf = getattr(alt_comped, attr).contiguous()\n            hp_t