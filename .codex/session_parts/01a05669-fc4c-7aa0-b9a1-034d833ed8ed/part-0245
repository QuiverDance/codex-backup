ntimeError(\n                f\"prefill-alt backend '{alt_name}' unsupported \"\n                f\"(only p4flat); got {type(alt_comped).__name__}\")\n        # Canonical shared sm: the primary already stores ONE (M,K) row-major\n        # all-element sign|mantissa on HBM (``hbm_sm``). The p4flat alt SHARES\n        # it (no clone, no LPDDR sm) and decodes in row-major mode (its native\n        # tile-blocked sm from compress is dropped). Only the p4flat exp side\n        # (palette headers + codes + exceptions) ships to LPDDR.\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        metadata = {\n            \"M\": int(alt_comped.M), \"K\": int(alt_comped.K),\n            \"num_exceptions\": int(alt_comped.num_exceptions),\n            \"num_groups\": int(alt_comped.num_groups),\n        }\n        lpddr_bufs: Dict[str, torch.Tensor] = {}\n        for attr in lpddr_attrs:\n            gpu_buf = getattr(alt_comped, attr).contiguous()\n            hp_t = self.huge_page_allocator.allocate(\n                gpu_buf.shape, gpu_buf.stride(), gpu_buf.dtype,\n                page_type=\"weight\")\n            hp_t.copy_(gpu_buf)\n            lpddr_bufs[attr] = hp_t\n        info.alt = SplitStorageInfo(\n            hbm_sm, lpddr_bufs, metadata, backend=\"p4flat\")\n        info.alt._uses_canonical_sm = True   # p4flat decode reads row-major sm\n        self._ensure_frozen_split_alt_staging(name, info.alt)\n\n    def _attach_prefill_alt_same_codec(self, info, metadata, name):\n        \"\"\"Unified prefill-alt: reuse the PRIMARY frozen_split codec for the\n        small-chunk prefill decode instead of compressing a second time.\n\n        ``info.alt`` ALIASES the primary's HBM sign_mantissa, its HBM aux\n        buffers (e.g. zipserv tile_offsets) and its LPDDR compressed buffers,\n        so there is NO extra LPDDR/HBM cost — only a GPU decode-staging slot is\n        allocated.  Works for every backend the primary decode already\n        supports (zipserv, dietgpu, p4flat, ...): a prefill chunk below\n        TIERED_SERVE_PREFILL_ALT_MAX_CHUNK then decodes the compressed exp from\n        LPDDR (smaller H2D than raw_bf16) via the SAME kernel the decode path\n        uses, at the cost of the primary reconstruct.\n\n        ``metadata`` is the primary's metadata dict (M/K + backend-specific\n        scalars) so the aliasing info exposes the same decode attributes.\n        \"\"\"\n        # Share the codec buffers but drop raw_bf16 — the alt decode only needs\n        # the compressed-exp side, and including raw_bf16 would size a needless\n        # 2*M*K GPU staging slot.\n        codec_bufs = {k: v for k, v in info.lpddr_buffers.items()\n                      if k != \"raw_bf16\"}\n        alt = SplitStorageInfo(\n            info.sign_mantissa, codec_bufs, metadata,\n            backend=info.backend, lpddr_shared=True,\n            hbm_buffers=info.hbm_buffers)\n        # Inherit the primary's sm layout: unified attach only fires when the\n        # primary kept its normal (non-canonical) sm, so this is False here,\n        # but mirror it defensively in case that ever changes.\n        alt._uses_canonical_sm = bool(getattr(info, \"_uses_canonical_sm\", False))\n        info.alt = alt\n        self._ensure_frozen_split_alt_staging(name, alt)\n\n    @staticmethod\n    def _compute_canonical_sm(weight):\n        \"\"\"(M,K) row-major all-element sign|mantissa byte: (sign<<7)|mantissa7.\n        Shared verbatim by the zipserv decode and the p4flat alt decode.\"\"\"\n        u16 = weight.contiguous().view(torch.uint16).reshape(-1).to(torch.int32)\n        return (((u16 >> 8) & 0x80) | (u16 & 0x7F)).to(torch.uint8).contiguous()\n\n    def _frozen_split_run_decompress(self, info, src_bufs, ln, output,\n                                          backend_compressor,\n                                          gt_m_base=0, num_row_tiles=-1):\n        \"\"\"Backend-dispatched decompress for one frozen_split tensor.\n\n        ``src