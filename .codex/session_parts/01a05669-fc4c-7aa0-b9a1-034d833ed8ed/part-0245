ch only fires when the\n        # primary kept its normal (non-canonical) sm, so this is False here,\n        # but mirror it defensively in case that ever changes.\n        alt._uses_canonical_sm = bool(getattr(info, \"_uses_canonical_sm\", False))\n        info.alt = alt\n        self._ensure_frozen_split_alt_staging(name, alt)\n\n    @staticmethod\n    def _compute_canonical_sm(weight):\n        \"\"\"(M,K) row-major all-element sign|mantissa byte: (sign<<7)|mantissa7.\n        Shared verbatim by the zipserv decode and the p4flat alt decode.\"\"\"\n        u16 = weight.contiguous().view(torch.uint16).reshape(-1).to(torch.int32)\n        return (((u16 >> 8) & 0x80) | (u16 & 0x7F)).to(torch.uint8).contiguous()\n\n    def _frozen_split_run_decompress(self, info, src_bufs, ln, output,\n                                          backend_compressor,\n                                          gt_m_base=0, num_row_tiles=-1):\n        \"\"\"Backend-dispatched decompress for one frozen_split tensor.\n\n        ``src_bufs`` is the dict of attr -> tensor that holds the\n        compressed payload (either staging, post-H2D, or — under ATS —\n        the LPDDR hugepage tensor itself).  ``ln`` is the matching\n        attr -> numel map so we can ``narrow`` to the actual compressed\n        size.  ``output`` is the per-layer decompress destination\n        (BF16 or FP8 depending on the backend).\n        \"\"\"\n        backend = info.backend\n        if backend == \"raw_exp\":\n            # Compressor-independent path: raw exp was H2D'd into staging;\n            # just bit-merge with the HBM-resident sign|mantissa.  No ANS.\n            from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n            numel = info.M * info.K\n            exp_view = src_bufs[\"raw_exp\"].narrow(0, 0, numel)\n            dietgpu_reconstruct(\n                exp_view.view(info.M, info.K),\n                info.sign_mantissa.view(info.M, info.K),\n                output.view(info.M, 