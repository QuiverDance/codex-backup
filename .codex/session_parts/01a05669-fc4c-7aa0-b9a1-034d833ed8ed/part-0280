     or self._decode_filter_limit != limit):\n            candidates = (\n                active_block_ids\n                if isinstance(active_block_ids, np.ndarray)\n                else np.asarray(active_block_ids, dtype=np.int64))\n            candidates = candidates[\n                (candidates >= 0) & (candidates < limit)]\n            if candidates.size > 1 and bool(\n                    (candidates[1:] < candidates[:-1]).any()):\n                candidates = np.sort(candidates)\n            self._decode_filter_active = active_block_ids\n            self._decode_filter_limit = limit\n            self._decode_filter_candidates = np.ascontiguousarray(\n                candidates, dtype=np.int64)\n\n        generation = self._decode_generation.get(layer_id, 0)\n        cached = self._decode_filtered.get(layer_id)\n        if (cached is not None\n                and cached[0] == generation\n                and np.array_equal(cached[1],\n                                   self._decode_filter_candidates)):\n            filtered = cached[2]\n        else:\n            candidates = self._decode_filter_candidates\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\n            filtered = np.ascontiguousarray(\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\n            self._decode_filtered[layer_id] = (\n                generation, candidates, filtered)\n        if filtered.size == 0:\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _build_decode_plan(self, layer_id: int,\n                           block_ids: np.ndarray,\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        slot_table = self._kv_slot_np[layer_id]\n        slots_np = np.ascontiguousarray(\n            slot_table[block_ids], dtype=np.int32)\n        if bool((slots_np < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        # The production steady state is dense: all active physical slots are\n        # requested.  Skip Python list conversion and run construction there.\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n        slot_runs = None\n        if dense:\n            packed_h2d = False\n        else:\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\n            max_runs = max(0, int(os.getenv(\n                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n            packed_h2d = (\n                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n                or hwm > self._max_gpu_decomp_blocks + 1)\n\n        slots_gpu = (\n            self._identity_slots_gpu[:n]\n            if packed_h2d else torch.as_tensor(\n                slots_np, dtype=torch.int32, device=k_cache.device))\n        block_ids_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=k_cache.device)\n        copy_destinations = []\n        copy_sources = []\n        for kv in (\"k\", \"v\"):\n            host_blob = self._host_pools[layer_id][kv][\"blob\"]\n            gpu_blob = self._gpu_decomp_pool[kv][\"blob\"]\n            if packed_h2d:\n                for row_begin, row_end, slot_begin in slot_runs:\n                    length = row_end - row_begin\n                    copy_destinations.append(gpu_blob[row_begin:row_end])\n                    copy_sources.append(\n                        host_blob[slot_begin:slot_begin + length])\n            else:\n                copy_destinations.append(gpu_blob[:hwm])\n                copy_sources.append(host_blob[:hwm])\n        storage_rows = n if packed_h2d else hwm\n        return {\n            \"block_ids\": block_ids,\n            \"generation\": self._decode_generation.get(layer_id, 0),\n            \"slots_gpu\": slots_gpu,\n            \"block_ids_gpu\": block_ids_gpu,\n            \"copy_destinations\": copy_destinations,\n            \"copy_sources\": copy_sources,\n            \"storage_rows\": storage_rows,\n        }\n\n    def _decompress_blocks(self, layer_id: int, block_ids,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV decode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_decomp_blocks}\")\n        if self._kv_active_count[layer_id] <= 0:\n            return\n        if not isinstance(block_ids, np.ndarray):\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n        plan = self._decode_plans.get(layer_id)\n        generation = self._decode_generation.get(layer_id, 0)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            if (plan is None or plan[\"block_ids\"] is not block_ids\n                    or plan[\"generation\"] != generation):\n                plan = self._build_decode_plan(\n                    layer_id, block_ids, k_cache)\n                self._decode_plans[layer_id] = plan\n            self._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n            storage_rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                self._gpu_decomp_pool[\"k\"][\"blob\"][:storage_rows],\n                self._gpu_decomp_pool[\"v\"][\"blob\"][:storage_rows],\n                plan[\"slots_gpu\"],\n                plan[\"block_ids_gpu\"],\n                k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n                v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n                self._packed_capacity,\n            )\n            # A CPU encoder may now overwrite persistent host slots only after\n            # every K/V H2D read queued above has retired.  Recording at the\n            # end is conservative (it also waits for decode) but remains off\n            # the forward thread and avoids any host synchronization.\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n\n_cudart_lib = None\n_cudart_lock = threading.Lock()\n\n\ndef _get_cudart():\n    global _cudart_lib\n    if _cudart_lib is not None:\n        return _cudart_lib\n    with _cudart_lock:\n        if _cudart_lib is None:\n            lib = None\n            candidates = sorted(glob.glob(os.path.join(\n                os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n            for candidate in candidates:\n                try:\n                    lib = ctypes.CDLL(candidate)\n                    break\n                except OSError:\n                    continue\n            if lib is None:\n                try:\n                    lib = ctypes.CDLL(\"libcudart.so\")\n                except OSError:\n                    lib = False\n            _cudart_lib = lib\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same