===================================\ntemplate <int TileN, int Stages>\nstruct CD3RSSmem {\n    using SmemLayoutB = decltype(cute::tile_to_shape(\n        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n    alignas(16) uint8_t s_codes[Stages][1536];       // 4096 packed 3-bit codes\n    alignas(16) uint8_t s_sm[Stages][4096];          // raw sign|mantissa\n    alignas(16) uint8_t s_bases[Stages][256];        // base per 16-value chunk\n    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n    alignas(16) uint32_t s_exc_mask[Stages][128];    // one bit per tile value\n};\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void cd3_rs_kernel(\n    const uint8_t*       __restrict__ codes_g,\n    const uint8_t*       __restrict__ sm_g,\n    const uint8_t*       __restrict__ bases_g,\n    const int32_t*       __restrict__ tile_offsets_g,\n    const uint64_t*      __restrict__ entries20x3_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid = static_cast<int>(threadIdx.x);\n    const int tile_n = static_cast<int>(blockIdx.x);\n    const int tile_m = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);\n    const int tk_split = tiles_k / split_k;\n    const int k0 = split_idx * tk_split;\n\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n                         make_coord(tile_n, _));\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    auto tiled_copy = make_tiled_copy(G2S{},\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n    auto thr_copy = tiled_copy.get_slice(tid);\n    auto tBgB = thr_copy.partition_S(gB);\n    auto tBsB = thr_copy.partition_D(sB);\n\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                              make_coord(tile_m, tile_n));\n    auto tiled_mma = make_tiled_mma(MmaOp{});\n    auto thr_mma = tiled_mma.get_thread_slice(tid);\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n    clear(tCrC);\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n\n    using SmemLayoutA = decltype(tile_to_shape(\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n                                SmemLayoutA{});\n    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n    auto cA = make_identity_tensor(make_shape(Int<kTileM>{}, Int<kTileK>{}));\n    auto tCcA = thr_mma.partition_A(cA);\n\n    auto load_b = [&](int k_tile, int pipe) {\n        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n    };\n\n    auto load_compressed = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\n        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\n        if (tid < 96)\n            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n        #pragma unroll\n        for (int j = 0; j < 2; ++j) {\n            const int chunk = tid + j * 128;\n            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\n        }\n        if (tid < 16)\n            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\n    };\n\n    auto build_exception_map = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int begin = tile_offsets_g[tile_idx];\n        const int end = tile_offsets_g[tile_idx + 1];\n        smem.s_exc_mask[st][tid] = 0;\n        __syncthreads();\n        for (int e = begin + tid; e < end; e += 128) {\n            const int64_t group = static_cast<int64_t>(e) / 3;\n            const int slot = e - static_cast<int>(group * 3);\n            const uint32_t entry = static_cast<uint32_t>(\n                (entries20x3_g[group] >> (slot * 20)) & 0xfffffu);\n            const int pos = static_cast<int>(entry & 0xfffu);\n            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 12);\n            atomicOr(&smem.s_exc_mask[st][pos >> 5], 1u << (pos & 31));\n        }\n        __syncthreads();\n    };\n\n    auto decode_regA = [&](int st) {\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrA); ++i) {\n            auto c = tCcA(i);\n            const int m = get<0>(c), k = get<1>(c);\n            const int owner = m * 4 + (k >> 4);\n            const int item = k & 15;\n            const int bit = item * 3;\n            const int byte = owner * 6 + (bit >> 3);\n            const int shift = bit & 7;\n            uint16_t packed = smem.s_codes[st][byte];\n            if (shift > 5)\n                packed |= static_cast<uint16_t>(smem.s_codes[st][byte + 1]) << 8;\n            const uint8_t code = static_cast<uint8_t>((packed >> shift) & 7u);\n            const int pos = m * 64 + k;\n            const bool is_exception =\n                (smem.s_exc_mask[st][pos >> 5] >> (pos & 31)) & 1u;\n            const uint8_t exp = is_exception\n                ? smem.s_exc_exp[st][pos]\n                : static_cast<uint8_t>(smem.s_bases[st][owner] + code);\n            const uint8_t smv = smem.s_sm[st][owner * 16 + item];\n            const uint16_t bits = static_cast<uint16_t>(\n                (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                (static_cast<uint16_t>(exp) << 7) |\n                static_cast<uint16_t>(smv & 0x7fu));\n            const __nv_bfloat16 value = __ushort_as_bfloat16(bits);\n            tCrA(i) = reinterpret_cast<const bfloat16_t&>(value);\n        }\n    };\n\n    CUTE_UNROLL\n    for (int s = 0; s < Stages - 1; ++s) {\n        if (s < tk_split) {\n            load_b(k0 + s, s);\n            load_compressed(k0 + s, s);\n        }\n        cp_async_fence();\n    }\n\n    for (int kk = 0; kk < tk_split; ++kk) {\n        cp_async_wait<Stages - 2>();\n        __syncthreads();\n\n        const int st = kk % Stages;\n        build_exception_map(k0 + kk, st);\n        decode_regA(st);\n        warpgroup_fence_operand(tCrA);\n        warpgroup_arrive();\n        gemm(tiled_mma, tCrA, tCrB(_, _, _, st), tCrC);\n        warpgroup_commit_batch();\n\n        const int knext = kk + Stages - 1;\n        if (knext < tk_split) {\n            load_b(k0 + knext, knext % Stages);\n            load_compressed(k0 + knext, knext % Stages);\n        }\n        cp_async_fence();\n\n        warpgroup_wait<0>();\n        __syncthreads();\n    }\n\n    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchCD3RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint64_t* entries20x3,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    if (split_k < 1 || (K >> 6) % split_k != 0 ||\n        (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = CD3RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, bases, tile_offsets, entries20x3,\n        B, C, Cf32, M, N, K, split_k);\n    cudaError_t err = cudaGetLastError();\n    if (err != cudaSuccess || split_k <= 1) return err;\n    const int64_t MN = static_cast<int64_t>(M) * N;\n    const int t = 256;\n    const int64_t blocks = (MN + t - 1) / t;\n    splitk_reduce_kernel<<<static_cast<unsigned>(blocks), t, 0, stream>>>(\n        Cf32, C, MN, split_k);\n    return cudaGetLastError();\n}\n\nextern \"C\" cudaError_t cd3_rs_wgmma_launch(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* bases, const int32_t* tile_offsets,\n    const uint64_t* entries20x3,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<256, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<192, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<128, MMA, 3>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        return LaunchCD3RS<64, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// zipserv RS-mode fused decode + GEMM (Triple Bitmap Encoding).\n//\n// decode_regA reverses zipserv's swizzled bitmap layout (TILE 8x8, GLOBAL 64x64,\n// SMALL_PER_MEDIAN=16/_M=2; inverse of compress visit_pos_to_local) to read\n// element (m,k)'s 3-bit exponent code POSITIONALLY — validated bit-exact on real\n// LLaMA weights — then combines with the canonical row-major sign|mantissa and\n// packs bf16. Low-freq \"full\" elements (~2.5-3% of weights) carry no valid HF\n// code; they are decoded as 0 here and fixed by the exception-correction pass\n// (delta = exact value, since the approx is 0).  csm_g is the canonical (M,K)\n// row-major sign|mantissa shared with p4flat/frozen_split.\n// ============================================================================\ntemplate <int TileN, int Stages>\nstruct ZipRSSmem {\n    using SmemLayoutB = decltype(cute::tile_to_shape(\n        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n};\n\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void zip_rs_kernel(\n    const uint64_t*      __restrict__ bm1_g,    // [num_small_tiles] per-8x8-tile\n    const uint64_t*      __restrict__ bm2_g,\n    const uint64_t*      __restrict__ bm3_g,\n    const uint8_t*       __restrict__ csm_g,    // canonical [M*K] sign|mantissa\n    int start_exp,\n    const uint16_t*      __restrict__ fv_g,     // LF values, flat (tile,bit) order\n    const int*           __restrict__ fvoff_g,  // [num_small_tiles] LF prefix offset\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    int M, int N, int K)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = ZipRSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid     = static_cast<int>(threadIdx.x);\n// Torch bindings for the WGMMA fusion lab (raw / UBLB-flat producers).\n#include <torch/extension.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cuda_bf16.h>\n#include <cuda_runtime.h>\n#include <cstdint>\n\nextern \"C\" cudaError_t raw_pipe_wgmma_launch(\n    cudaStream_t, const __nv_bfloat16*, const __nv_bfloat16*,\n    __nv_bfloat16*, int, int, int);\nextern \"C\" cudaError_t u4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\nextern \"C\" cudaError_t p4_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*, const uint8_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int,\n    const int*, const uint16_t*, int, int, int, int);\nextern \"C\" cudaError_t cd3_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const int32_t*, const uint64_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\nextern \"C\" cudaError_t p4_exc_correct_launch(\n    cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n    const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n    int64_t, int, int, int);\nextern \"C\" cudaError_t zip_rs_wgmma_launch(\n    cudaStream_t, const uint64_t*, const uint64_t*, const uint64_t*,\n    const uint8_t*, int, const uint16_t*, const int*,\n    const __nv_bfloat16*, __nv_bfloat16*, int, int, int);\n\n// C is the COLUMN-major [M,N] output buffer (physically [N,M] row-major):\n// caller passes a contiguous [N, M] bf16 tensor; element (m,n) lands at n*M+m.\n// Ws (split_k>1) is an [split_k*M*N] f32 workspace; pass an empty tensor for\n// split_k==1 (direct bf16 write path).\n\nstatic float* ws_ptr(torch::Tensor Ws) {\n    return Ws.numel() ? reinterpret_cast<float*>(Ws.data_ptr()) : nullptr;\n}\n\nvoid raw_pipe_wgmma_mm(torch::Tensor A, torch::Tensor B, torch::Tensor C,\n                       int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = raw_pipe_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const __nv_bfloat16*>(A.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"raw_pipe_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K, \")\");\n}\n\nvoid u4_rs_wgmma_mm(torch::Tensor code_stream, torch::Tensor lb_raw,\n                    torch::Tensor palette, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = u4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(code_stream.data_ptr()),\n        reinterpret_cast<const uint8_t*>(lb_raw.data_ptr()),\n        reinterpret_cast<const uint8_t*>(palette.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k, (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"u4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\nvoid p4_rs_wgmma_mm(torch::Tensor codes, torch::Tensor sm, torch::Tensor headers,\n                    torch::Tensor codec, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = p4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm.data_ptr()),\n        reinterpret_cast<const uint8_t*>(headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(codec.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k,\n        nullptr, nullptr, 0,                       // no exception correction\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"p4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\nvoid cd3_rs_wgmma_mm(\n    torch::Tensor codes, torch::Tensor sm, torch::Tensor bases,\n    torch::Tensor tile_offsets, torch::Tensor entries20x3,\n    torch::Tensor B, torch::Tensor C,\n    torch::Tensor Cf32, int64_t split_k,\n    int64_t M, int64_t N, int64_t K) {\n    TORCH_CHECK(codes.is_cuda() && sm.is_cuda() && bases.is_cuda()\n                && tile_offsets.is_cuda() && entries20x3.is_cuda()\n                && B.is_cuda() && C.is_cuda(),\n                \"cd3_rs_wgmma_mm expects CUDA tensors\");\n    TORCH_CHECK(codes.scalar_type() == at::kByte\n                && sm.scalar_type() == at::kByte\n                && bases.scalar_type() == at::kByte\n                && tile_offsets.scalar_type() == at::kInt\n                && entries20x3.scalar_type() == at::kLong,\n                \"cd3_rs_wgmma_mm received invalid codec dtypes\");\n    TORCH_CHECK(B.scalar_type() == at::kBFloat16\n                && C.scalar_type() == at::kBFloat16,\n                \"cd3_rs_wgmma_mm expects BF16 activation/output\");\n    auto stream = c10::cuda::get