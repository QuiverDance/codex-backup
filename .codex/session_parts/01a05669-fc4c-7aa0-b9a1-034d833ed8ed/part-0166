n+\\n+\\n+def load_extension(path: Path):\\n+    spec = importlib.util.spec_from_file_location(\\\"tp3_cd3_ext\\\", path)\\n+    if spec is None or spec.loader is None:\\n+        raise RuntimeError(f\\\"cannot load extension: {path}\\\")\\n+    module = importlib.util.module_from_spec(spec)\\n+    spec.loader.exec_module(module)\\n+    return module\\n+\\n+\\n+def exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\\n+    return torch.equal(actual.view(torch.int16), expected.view(torch.int16))\\n+\\n+\\n+def time_call(call, warmups: int, runs: int) -> float:\\n+    for _ in range(warmups):\\n+        call()\\n+    torch.cuda.synchronize()\\n+    begin = torch.cuda.Event(enable_timing=True)\\n+    end = torch.cuda.Event(enable_timing=True)\\n+    samples: list[float] = []\\n+    for _ in range(runs):\\n+        begin.record()\\n+        call()\\n+        end.record()\\n+        end.synchronize()\\n+        samples.append(begin.elapsed_time(end))\\n+    return float(torch.tensor(samples).median().item())\\n+\\n+\\n+def all_bf16_patterns() -> torch.Tensor:\\n+    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\\n+    return bits.view(torch.bfloat16).reshape(256, 256).cuda()\\n+\\n+\\n+def main() -> None:\\n+    args = parse_args()\\n+    extension = load_extension(args.extension.resolve())\\n+    source = all_bf16_patterns()\\n+    tile_palette3 = extension.compress_tile_palette3(source)\\n+    chunk_delta3 = extension.compress_chunk_delta3(source)\\n+    tile_output = torch.empty_like(source)\\n+    chunk_output = torch.empty_like(source)\\n+\\n+    tile_call = lambda: extension.decompress_tile_palette3(\\n+        tile_palette3, tile_output\\n+    )\\n+    chunk_call = lambda: extension.decompress_chunk_delta3(\\n+        chunk_delta3, chunk_output\\n+    )\\n+    tile_call()\\n+    chunk_call()\\n+    torch.cuda.synchronize()\\n+    correctness = {\\n+        \\\"tile_palette3\\\": exact(tile_output, source),\\n+        \\\"chunk_delta3\\\": exact(chunk_output, source),\\n+    }\\n+    if not all(correctness.values()):\\n+        raise AssertionError(f\\\"bit-exact check failed: {correctness}\\\")\\n+\\n+    result = {\\n+        \\\"gpu\\\": torch.cuda.get_device_name(),\\n+        \\\"compute_capability\\\": list(torch.cuda.get_device_capability()),\\n+        \\\"torch\\\": torch.__version__,\\n+        \\\"cuda\\\": torch.version.cuda,\\n+        \\\"all_65536_bf16_patterns_bit_exact\\\": correctness,\\n+        \\\"tile_palette3\\\": {\\n+            \\\"compressed_bytes\\\": tile_palette3.nbytes,\\n+            \\\"compression_ratio_x\\\": source.nbytes / tile_palette3.nbytes,\\n+            \\\"num_exceptions\\\": tile_palette3.num_exceptions,\\n+            \\\"frozen_hbm_bytes\\\": tile_palette3.frozen_hbm_bytes,\\n+            \\\"frozen_transfer_bytes\\\": tile_palette3.frozen_transfer_bytes,\\n+            \\\"resident_decode_p50_ms\\\": time_call(\\n+                tile_call, args.warmups, args.runs\\n+            ),\\n+        },\\n+        \\\"chunk_delta3\\\": {\\n+            \\\"compressed_bytes\\\": chunk_delta3.nbytes,\\n+            \\\"compression_ratio_x\\\": source.nbytes / chunk_delta3.nbytes,\\n+            \\\"num_exceptions\\\": chunk_delta3.num_exceptions,\\n+            \\\"frozen_hbm_bytes\\\": chunk_delta3.frozen_hbm_bytes,\\n+            \\\"frozen_transfer_bytes\\\": chunk_delta3.frozen_transfer_bytes,\\n+            \\\"resident_decode_p50_ms\\\": time_call(\\n+                chunk_call, args.warmups, args.runs\\n+            ),\\n+        },\\n+    }\\n+    print(json.dumps(result, indent=2, sort_keys=True))\\n+\\n+\\n+if __name__ == \\\"__main__\\\":\\n+    main()\\nBENCHMARK REST\\n+\\n+def time_call(call: Callable[[], object], warmups: int, runs: int) -> dict[str, float]:\\n+    for _ in range(warmups):\\n+        call()\\n+    torch.cuda.synchronize()\\n+    begin = torch.cuda.Event(enable_timing=True)\\n+    end = torch.cuda.Event(enable_timing=True)\\n+    samples: list[float] = []\\n+    for _ in range(runs):\\n+        begin.record()\\n+        call()\\n+        end.record()\\n+        end.synchronize()\\n+        samples.append(begin.elapsed_time(end))\\n+    return summarize(samples)\\n+\\n+\\n+def pinned_payload(compressed, attributes: tuple[str, ...]) -> dict[str, torch.Tensor]:\\n+    return {\\n+        name: getattr(compressed, name).detach().cpu().pin_memory()\\n+        for name in attributes\\n+    }\\n+\\n+\\n+def copy_payload(\\n+    host: dict[str, torch.Tensor],\\n+    staged,\\n+    attributes: tuple[str, ...],\\n+) -> None:\\n+    for name in attributes:\\n+        getattr(staged, name).copy_(host[name], non_blocking=True)\\n+\\n+\\n+def stage_tile_palette3(extension, compressed):\\n+    staged = extension.CompressedTilePalette3()\\n+    for name in (\\n+        \\\"palettes8\\\",\\n+        \\\"sign_mantissa\\\",\\n+        \\\"tile_exception_offsets\\\",\\n+        \\\"warp_prefixes\\\",\\n+    ):\\n+        setattr(staged, name, getattr(compressed, name))\\n+    for name in (\\\"codes\\\", \\\"entries17\\\"):\\n+        setattr(staged, name, torch.empty_like(getattr(compressed, name)))\\n+    staged.M = compressed.M\\n+    staged.K = compressed.K\\n+    staged.num_exceptions = compressed.num_exceptions\\n+    return staged\\n+\\n+\\n+def stage_chunk_delta3(extension, compressed):\\n+    staged = extension.CompressedChunkDelta3()\\n+    for name in (\\n+        \\\"sign_mantissa\\\",\\n+        \\\"tile_exception_offsets\\\",\\n+        \\\"warp_prefixes\\\",\\n+    ):\\n+        setattr(staged, name, getattr(compressed, name))\\n+    for name in (\\\"codes\\\", \\\"thread_bases\\\", \\\"entries17\\\"):\\n+        setattr(staged, name, torch.empty_like(getattr(compressed, name)))\\n+    staged.M = compressed.M\\n+    staged.K = compressed.K\\n+    staged.num_exceptions = compressed.num_exceptions\\n+    return staged\\n+\\n+\\n+def benchmark_codec(\\n+    compressed,\\n+    staged,\\n+    transfer_att