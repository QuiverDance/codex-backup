OL=\"${REPO_ROOT}/etc/stack_pool.so\"\nHUGEPAGE_SYSFS=\"/sys/kernel/mm/hugepages/hugepages-16777216kB\"\n\nMETHODS=(\n  flexgen\n  flexgen-zipserv\n  flexgen-zipserv-fused\n  cao-zipserv\n  cao-zipserv-fused\n  cao-zipserv-fused-kvcomp\n  cao-p4flat-fused\n  cao-p4flat-fused-kvcomp\n  cao-cd3\n  cao-cd3-fused\n  cao-cd3-fused-kvcomp\n)\n\nusage() {\n  cat <<'EOF'\nUsage: bash scripts/offline/run_performance_suite.sh [OPTIONS]\n\nRuns the configured offline performance matrix. Every configuration and\nrepeat starts a fresh Python process. The next run starts only after the GPU,\n16 GiB HugePages, and tiered-serve processes return to an idle state.\n\nOptions:\n  --methods LIST          Comma/space-separated method IDs (default: all)\n  --batches LIST          Comma/space-separated batches (default: 1,16,32,64,96,128)\n  --repeats N             Fresh-process repeats per method (default: 3)\n  --input-seq-len N       Random input tokens per request (default: 1020)\n  --gen N                 Tokens generated per request (default: 129)\n  --warmup N              Initial TPOT samples excluded (default: 16)\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\n  --kv-backend NAME       KV codec for configurable kvcomp cells (default: p4flat)\n  --breakdown             Enable per-forward detailed timing and aggregated\n                          prefill/decode breakdown CSVs\n  --gpu-index N           Physical GPU used and checked (default: 0)\n  --numa-node N           NUMA memory node (default: 0)\n  --weight-huge-pages N   16 GiB pages assigned to weights (default: 14)\n  --max-idle-hbm-mib N    Maximum clean-state HBM use (default: 1024)\n  --cleanup-timeout SEC   Wait for clean state between runs (default: 120)\n  --output-root DIR       Suite logs/manifests directory\n  --start-from METHOD     Start at METHOD and run the remaining methods\n  --check-only            Run resource/config preflight and exit\n  --dry-run               Validate mappings an