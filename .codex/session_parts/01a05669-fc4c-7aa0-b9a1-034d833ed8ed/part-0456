   @staticmethod\n    def _pack_cpu_weight_entries(\n        packed_per_stripe: torch.Tensor,\n        counts: torch.Tensor,\n    ) -> torch.Tensor:\n        \"\"\"Compact stripe-local Packed20x3 words into one weight stream.\"\"\"\n        block_prefix = torch.zeros(\n            counts.numel() + 1, dtype=torch.int64, device=\"cpu\")\n        block_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n        total = int(block_prefix[-1].item())\n        if total == 0:\n            return torch.empty(0, dtype=torch.int64)\n\n        entries20 = torch.empty(total, dtype=torch.int32)\n        mask = (1 << 20) - 1\n        for stripe in range(counts.numel()):\n            count = int(counts[stripe].item())\n            if count == 0:\n                continue\n            begin = int(block_prefix[stripe].item())\n            words = packed_per_stripe[stripe, :(count + 2) // 3]\n            destination = entries20[begin:begin + count]\n            destination[0::3] = (words[:destination[0::3].numel()]\n                                  & mask).to(torch.int32)\n            if count > 1:\n                destination[1::3] = ((words[:destination[1::3].numel()] >> 20)\n                                      & mask).to(torch.int32)\n            if count > 2:\n                destination[2::3] = ((words[:destination[2::3].numel()] >> 40)\n                                      & mask).to(torch.int32)\n\n        num_words = (total + 2) // 3\n        padded = torch.zeros(num_words * 3, dtype=torch.int64)\n        padded[:total].copy_(entries20.to(torch.int64))\n        triples = padded.view(num_words, 3)\n        return (triples[:, 0]\n                | (triples[:, 1] << 20)\n                | (triples[:, 2] << 40)).contiguous()\n\n\n_submit(\n    \"zipserv_p4flat_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p4flat.cu\",\n        \"tiered_serve/compression/adapters/cuda/zips