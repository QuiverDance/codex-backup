t16_t*, int, int, int, int);\nextern \"C\" cudaError_t cd3_rs_wgmma_launch(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const int32_t*, const uint64_t*,\n    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\nextern \"C\" cudaError_t p4_exc_correct_launch(\n    cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n    const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n    int64_t, int, int, int);\nextern \"C\" cudaError_t zip_rs_wgmma_launch(\n    cudaStream_t, const uint64_t*, const uint64_t*, const uint64_t*,\n    const uint8_t*, int, const uint16_t*, const int*,\n    const __nv_bfloat16*, __nv_bfloat16*, int, int, int);\n\n// C is the COLUMN-major [M,N] output buffer (physically [N,M] row-major):\n// caller passes a contiguous [N, M] bf16 tensor; element (m,n) lands at n*M+m.\n// Ws (split_k>1) is an [split_k*M*N] f32 workspace; pass an empty tensor for\n// split_k==1 (direct bf16 write path).\n\nstatic float* ws_ptr(torch::Tensor Ws) {\n    return Ws.numel() ? reinterpret_cast<float*>(Ws.data_ptr()) : nullptr;\n}\n\nvoid raw_pipe_wgmma_mm(torch::Tensor A, torch::Tensor B, torch::Tensor C,\n                       int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = raw_pipe_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const __nv_bfloat16*>(A.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"raw_pipe_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K, \")\");\n}\n\nvoid u4_rs_wgmma_mm(torch::Tensor code_stream, torch::Tensor lb_raw,\n                    torch::Tensor palette, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = u4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(code_stream.data_ptr()),\n        reinterpret_cast<const uint8_t*>(lb_raw.data_ptr()),\n        reinterpret_cast<const uint8_t*>(palette.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k, (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"u4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\nvoid p4_rs_wgmma_mm(torch::Tensor codes, torch::Tensor sm, torch::Tensor headers,\n                    torch::Tensor codec, torch::Tensor B, torch::Tensor C,\n                    torch::Tensor Cf32, int64_t split_k,\n                    int64_t M, int64_t N, int64_t K) {\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t e = p4_rs_wgmma_launch(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm.data_ptr()),\n        reinterpret_cast<const uint8_t*>(headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(codec.data_ptr()),\n        reinterpret_cast<const __nv_bfloat16*>(B.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        ws_ptr(Cf32), (int)split_k,\n        nullptr, nullptr, 0,                       // no exception correction\n        (int)M, (int)N, (int)K);\n    TORCH_CHECK(e == cudaSuccess, \"p4_rs_wgmma_launch failed: \",\n                cudaGetErrorString(e), \" (M=\", M, \" N=\", N, \" K=\", K,\n                \" split_k=\", split_k, \")\");\n}\n\nvoid cd3_rs_wgmma_mm(\n    torch::Tensor codes, torch::Tensor sm, torch::Tensor bases,\n    torch::Tensor tile_offsets, torch::Tensor entries20x3,\n    torch::Tensor B, torch::Tensor C,\n