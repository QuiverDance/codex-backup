     triples = padded.view(num_words, 3)\n        return (triples[:, 0]\n                | (triples[:, 1] << 20)\n                | (triples[:, 2] << 40)).contiguous()\n\n\n_submit(\n    \"zipserv_p4flat_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_p4flat.cu\",\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_mm.cu\",\n        *_p4flat_wgmma_sources,\n    ],\n    with_cuda=True,\n    # CUTLASS include path needed for the WGMMA kernel's cute headers.\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir, _cutlass_include],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        # -mcpu=grace: target the GH200 Grace core (Neoverse V2, armv9-a + SVE2)\n        # for both ISA and pipeline tuning, so host_encode_blocks vectorises +\n        # schedules for V2.  -funroll-loops for the tight per-tile inner loops.\n        # (host integer encode -> byte-identical output.)\n        \"-mcpu=grace\", \"-funroll-loops\",\n        \"-fopenmp\",  # host_encode_blocks parallelises across KV blocks\n        *_wgmma_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n        *_wgmma_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\", \"-fopenmp\",\n    ],\n)\n\n_submit(\n    \"chunk_delta3_ext\",\n    sources=[\n        \"tiered_serve/compression/cuda/chunk_delta3_ext.cpp\",\n        \"tiered_serve/compression/cuda/chunk_delta3.cu\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        \"-funroll-loops\", \"-fopenmp\", *_cd3_host_tune_flags,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n      