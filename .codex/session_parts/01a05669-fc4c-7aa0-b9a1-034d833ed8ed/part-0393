             else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n                blob_np[sl, o:o + cdb] = dn[lo * cdb:hi * cdb].reshape(hi - lo, cdb)\n            if n >= self._asm_thread_thresh:\n                if self._asm_pool is None:\n                    self._asm_pool = ThreadPoolExecutor(\n                        max_workers=self._asm_nthreads,\n                        thread_name_prefix=\"p4flat-asm\")\n                nt = self._asm_nthreads\n                ch = (n + nt - 1) // nt\n                bounds = [(i * ch, min((i + 1) * ch, n))\n                          for i in range(nt) if i * ch < n]\n                list(self._asm_pool.map(lambda b: _scatter(*b), bounds))\n            else:\n                _scatter(0, n)\n\n        # Per-block exception counts (``fixed`` = 1.5x sm bytes < ``raw_bytes``\n        # = 2x, so a block only falls back to raw when exceptions blow the\n        # budget — effectively never for real KV).\n        per_es = idx_es + val_es\n        if cnt_total > 0:\n            cnt_arr = np.bincount(blk_h, minlength=n).astype(np.int64)\n        else:\n            cnt_arr = np.zeros(n, dtype=np.int64)\n        total_arr = fixed + cnt_arr * per_es\n        compressed_arr = total_arr <= min(raw_bytes, self._blob_stride)\n        raw_in_row_arr = (~compressed_arr) & (raw_bytes <= self._blob_stride)\n        secondary_arr = (~compressed_arr) & (~raw_in_row_arr)\n\n        # Splice exceptions only when the complete blob fits this physical row.\n        for b in np.nonzero(cnt_arr)[0]:\n            if not compressed_arr[b]:\n                continue\n            m = (blk_h == b)\n            cnt = int(cnt_arr[b])\n            ib, vb = cnt * idx_es, cnt * val_es\n            blob_np[slots_arr[b], fixed:fixed + ib] = loc_h[m].view(np.uint8)\n            blob_np[slots_arr[b], fixed + ib:fixed + ib + vb] = \\\n                val_h[m].view(np.uint8)\n\n        # Raw-in-row fallback is possible only with a raw-safe stride.  With a\n        # tight row, publish is_raw=2 below and restore from raw secondary KV.\n        for b in np.nonzero(raw_in_row_arr)[0]:\n            host_pool['blob'][slots_arr[b], :raw_bytes].copy_(\n                stack_2d[b * valid_rows:(b + 1) * valid_rows].reshape(-1)\n                .view(torch.uint8))\n\n        # Bulk meta writes.\n        host_pool['total_size'].numpy()[slots_arr] = np.where(\n            compressed_arr, total_arr,\n            np.where(raw_in_row_arr, raw_bytes, 0))\n        host_pool['exc_cnt'].numpy()[slots_arr] = np.where(\n            compressed_arr, cnt_arr, 0)\n        host_pool['is_raw'].numpy()[slots_arr] = np.where(\n            compressed_arr, 0, np.where(raw_in_row_arr, 1, 2)).astype(np.uint8)\n        host_pool['valid_rows'].numpy()[slots_arr] = valid_rows\n        return bool(secondary_arr.any())\n\n    def _store_stack_gpu(self, host_pool: Dict[str, torch.Tensor],\n                         slots: List[int], stack_2d: torch.Tensor,\n                         n: int, valid_rows: int) -> bool:\n        \"\"\"gpu_direct batched compress: one ``compress_batched`` kernel writes\n        the ``n`` per-block blobs into GPU staging (no host-side assembly),\n        then a single D2H scatter places them in the host pool by physical\n        slot.  ``stack_2d`` is ``[n*valid_rows, K_b]`` (one block = valid_rows\n        rows); the kernel encodes each ``[valid_rows, K_b]`` block.\"\"\"\n        K_b = self._K_b\n        dev = stack_2d.device\n        if self._gpu_cmp is None:\n            cap = self._max_gpu_blocks\n            self._gpu_cmp = {\n                'blob': torch.empty(cap, self._max_comp_size,\n                                    dtype=torch.uint8, device=dev),\n                'ts': torch.empty(cap, dtype=torch.int32, device=dev),\n                'ec': torch.empty(cap, dtype=torch.int32, device=dev),\n                'ir': torch.empty(cap, dtype=torch.uint8, device=dev),\n                'vr': torch.empty(cap, dtype=torch.int32, device=dev),\n                'ecnt': torch.empty(cap, dtype=torch.int32, device=dev),\n                'ei': torch.empty(cap, self._max_exc_pb,\n                                  dtype=torch.int32, device=dev),\n                'ev': torch.empty(cap, self._max_exc_pb,\n                                  dtype=torch.int16, device=dev),\n                # Pinned meta staging so the 4 meta D2Hs collapse to ONE stream\n                # sync per side (vs a sync per .cpu()).\n                'ts_h': torch.empty(cap, dtype=torch.int32).pin_memory(),\n                'ec_h': torch.empty(cap, dtype=torch.int32).pin_memory(),\n                'ir_h': torch.empty(cap, dtype=torch.uint8).pin_memory(),\n                'vr_h': torch.empty(cap, dtype=torch.int32).pin_memory(),\n            }\n        c = self._gpu_cmp\n        if self._iota_l is None:                         # cache arange (no per-call alloc)\n            cap = self._max_gpu_blocks\n            self._iota_l = torch.arange(cap, dtype=torch.long, device=dev)\n            self._iota_i = torch.arange(cap, dtype=torch.int32, device=dev)\n        bids, sg = self._iota_l[:n], self._iota_i[:n]\n        _p4f_ext.compress_batched(\n            stack_2d.reshape(-1), bids, sg, c['blob'], c['blob'].stride(0),\n            c['ts'], c['ec'], c['ir'], c['vr'],\n            c['ecnt'], c['ei'].view(torch.int32), c['ev'].view(torch.int16),\n            valid_rows * K_b, valid_rows, K_b, self._max_exc_pb)\n        # Blobs GPU staging -> host pool.  Meta (ts/ec/ir/vr) D2H'd into reusable\n        # pinned staging with non_blocking copies + ONE stream sync per side.\n        slots_arr = np.asarray(slots, dtype=np.int64)\n        ts_h, ec_h = c['ts_h'][:n], c['ec_h'][:n]\n        ir_h, vr_h = c['ir_h'][:n], c['vr_h'][:n]\n        lo = int(slots_arr[0])\n        contiguous = n == 1 or (int(slots_arr[-1]) - lo + 1 == n\n                                and bool((np.diff(slots_arr) == 1).all()))\n        if contiguous:\n            # Common fill case (incremental slots): ONE bulk D2H of the padded\n            # rows.  At ~300 GiB/s this beats n batched copies (~35 GiB/s, each\n            # only ~24 KB) despite copying the unused tail; decode reads only\n            # total_size[slot] bytes so the padding is harmless.  Meta writes are\n            # contiguous slice assignments (no fancy-index scatter).\n            # Compress staging rows are max_comp_size wide; the host pool uses the\n            # reduced blob_stride.  Copy only the first blob_stride bytes of each\n            # row (the blob lives in [0:total_size] <= blob_stride) — one strided\n            # DMA into the dense host rows.\n            host_pool['blob'][lo:lo + n].copy_(\n                c['blob'][:n, :host_pool['blob'].shape[1]], non_blocking=True)\n            ts_h.copy_(c['ts'][:n], non_blocking=True)\n            ec_h.copy_(c['ec'][:n], non_blocking=True)\n            ir_h.copy_(c['ir'][:n], non_blocking=True)\n            vr_h.copy_(c['vr'][:n], non_blocking=True)\n            self.comp_stream.synchronize()\n            overflow = ts_h.numpy() > self._blob_stride\n            host_pool['total_size'][lo:lo + n] = ts_h\n            host_pool['exc_cnt'][lo:lo + n] = ec_h\n            host_pool['is_raw'][lo:lo + n] = ir_h\n            host_pool['valid_rows'][lo:lo + n] = vr_h\n            if overflow.any():\n                rows = lo + np.flatnonzero(overflow)\n                host_pool['total_size'].numpy()[rows] = 0\n                host_pool['exc_cnt'].numpy()[rows] = 0\n                host_pool['is_raw'].numpy()[rows] = 2\n        else:\n            # Scattered slots (post-eviction): batched D2H of used bytes straight\n            # into the pinned slot rows — needs sizes (ts) host-side first.\n            slots_t = torch.from_numpy(slots_arr)\n            ts_h.copy_(c['ts'][:n], non_blocking=True)\n            ec_h.copy_(c['ec'][:n], non_blocking=True)\n            ir_h.copy_(c['ir'][:n], non_blocking=True)\n            vr_h.copy_(c['vr'][:n], non_blocking=True)\n            self.comp_stream.synchronize()\n            overflow = ts_h.numpy() > self._blob_stride\n            # Overflow rows have no valid host blob and will be is_raw=2.  A\n            # clamped, unused copy keeps cudaMemcpyBatchAsync within each row.\n            copy_sizes = ts_h.clone().clamp_max_(self._blob_stride)\n            _p4f_ext.blob_scatter_d2h(c['blob'], host_pool['blob'],\n                                      slots_t, copy_sizes, n)\n            self.comp_stream.synchronize()\n            host_pool['total_size'][slots_t] = ts_h\n            host_pool['exc_cnt'][slots_t] = ec_h\n            host_pool['is_raw'][slots_t] = ir_h\n            host_pool['valid_rows'][slots_t] = vr_h\n            if overflow.any():\n                rows = slots_arr[overflow]\n                host_pool['total_size'].numpy()[rows] = 0\n                host_pool['exc_cnt'].numpy()[rows] = 0\n                host_pool['is_raw'].numpy()[rows] = 2\n        return bool(overflow.any())\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        num_primary = gpu_k.shape[0]\n        # Step-level cache: block_ids is identical across all layers of a\n        # step, so np.asarray + in_range filter only need to run once —\n        # not ×80 layers (avoids per-layer numpy allocation churn).\n        if self._wc_bids_list is not block_ids:\n            self._wc_bids_np = np.asarray(block_ids, dtype=np.int64)\n            self._wc_bids_list = block_ids\n        bid_arr = self._wc_bids_np\n        in_range = (bid_arr >= 0) & (bid_arr < num_primary)\n        if not in_range.all():\n            bid_arr = bid_arr[in_range]\n        n = bid_arr.shape[0]\n        if n == 0:\n            return\n\n        physical_slots = self._assign_kv_slots(layer_id, bid_arr)  # numpy\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        ntm = self._M_b // 64\n\n        # Occupancy groups blocks by written tile-band count so partial blocks\n        # compress only their valid prefix.  The common case (occupancy off, or\n        # no per-step valid-token map yet) is ONE full-block group — fast-pathed\n        # here to skip the grouping loop + per-index list comprehensions.\n        secondary_fallback = False\n        with torch.cuda.stream(self.comp_stream):\n            if not self._occupancy_enabled or self._block_valid_tokens is None:\n                secondary_fallback = self._launch_group(\n                    host_k, host_v, gpu_k, gpu_v,\n                    bid_arr, physical_slots, ntm)\n            else:\n                # Cache vtm per step — bid_arr is identical across all\n                # layers, so bid_arr.tolist() + _valid_tm_for + np.asarray\n                # only need to run once (avoids ~12 MiB/step of per-layer\n                # Python list + numpy allocations → mimalloc → mmap/munmap).\n                if self._wc_bids_list is not block_ids or self._wc_vtm is None:\n                    vtm = np.asarray(\n                        self._valid_tm_for(bid_arr.tolist()),\n                        dtype=np.int64)\n                    self._wc_vtm = vtm\n                else:\n                    vtm = self._wc_vtm\n                for vt in np.unique(vtm):\n                    idxs = np.nonzero(vtm == vt)[0]\n                    secondary_fallback |= self._launch_group(\n                        host_k, host_v, gpu_k, gpu_v,\n                        bid_arr[idxs], physical_slots[idxs], int(vt))\n            event = self.comp_stream.record_event()\n        if secondary_fallback:\n            self._secondary_fallback_possible[layer_id] = True\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': bid_arr,\n            'physical_slots': physical_slots,\n        }\n\n    def _launch_group(self, host_k, host_v, gpu_k, gpu_v,\n                      gids_arr, gslots, valid_tm: int) -> bool:\n        \"\"\"Compress one occupancy group: gather its blocks' valid_rows prefix\n        into a stack and store K and V.  ``gids_arr``/``gslots`` are numpy.\"\"\"\n        M_b, K_b = self._M_b, self._K_b\n        valid_rows = valid_tm * 64\n        g = int(gids_arr.shape[0])\n        gids = torch.as_tensor(gids_arr, device=gpu_k.device)   # numpy -> GPU\n        k_stack = (gpu_k[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        v_stack = (gpu_v[gids].reshape(g, M_b, K_b)[:, :valid_rows]\n                   .reshape(g * valid_rows, K_b).contiguous())\n        k_secondary = self._store_stack(\n            host_k, gslots, k_stack, g, valid_tm)\n        v_secondary = self._store_stack(\n            host_v, gslots, v_stack, g, valid_tm)\n        return k_secondary or v_secondary\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n            return\n        num_primary = k_cache.shape[0]\n        lim = min(num_primary, len(valid))\n        # ``active_block_ids`` is identical across all layers of a step, so the\n        # in-range candidate set is too — build it once per step instead of\n        # re-running np.asarray over ~6.5k ids every layer (was ~6% of the\n        # CPU-bound dispatch).  Only the per-layer ``valid`` gate differs.\n        #\n        # Key on object IDENTITY (``is``) and HOLD a reference to the list.\n        # Keying on ``id(active_block_ids)`` was unsafe: once a step's list is\n        # freed, the next step's new list can reuse the same id, and if len+lim\n        # also match the stale candidate set is returned → wrong slots → decode\n        # kernel OOB (a CUDA illegal-memory-access seen only under serve's\n        # high-concurrency varying active sets; offline's monotonically-growing\n        # set never collides because len changes every step).  Holding the\n        # reference keeps the cached object alive so its identity can't be\n        # reused while cached.\n        if (getattr(self, \"_decomp_filter_ab\", None) is not active_block_ids\n                or getattr(self, \"_decomp_filter_lim\", None) != lim):\n            ab = np.asarray(active_block_ids, dtype=np.int64)\n            self._decomp_filter_cand = ab[(ab >= 0) & (ab < lim)]\n            self._decomp_filter_cand_t = torch.from_numpy(\n                self._decomp_filter_cand)\n            self._decomp_filter_ab = active_block_ids\n            self._decomp_filter_lim = lim\n        cand = self._restore_secondary_fallbacks(\n            layer_id, self._decomp_filter_cand, k_cache, v_cache)\n        if cand.size == 0:\n            return\n\n        # C++ one-call decode prep (production shape): the valid filter,\n        # slot/meta gather, meta+blob H2D and event records all happen in\n        # ONE ext call; Python only launches the two codec kernels.  The\n        # blob H2D is hole-agnostic: the ext splits [0:active) into the\n        # contiguous REQUESTED-slot runs and submits them (with the meta\n        # copies) as one cudaMemcpyBatchAsync — dense sets degenerate to a\n        # single run, fragmented sets skip hole/unrequested bytes.\n        if getattr(self, \"_use_cpp_prep\", False):\n            active = self._kv_active_count[layer_id]\n            if (0 < active <= self._dec_cap\n                    and not self._meta_sync_fallback\n                    and not self._decode_validate):\n                # NOTE: NOT gated on self._tb — time-breakdown must measure the\n                # PRODUCTION fast path, not divert to the slow path.  The fast\n                # path records _kv_h2d_begin/_kv_dec_h2d + the kv.py\n                # begin/end_kv_decomp brackets, so KVLoad/KVDecomp still attribute\n                # correctly (the H2D and decode kernels are split by those events).\n                #\n                # When _restore_secondary_fallbacks returned the same array\n                # (no is_raw==2 blocks this step), reuse the step-level cached\n                # tensor instead of torch.from_numpy(cand) which allocates a\n                # new CPU tensor per layer → posix_memalign → mmap churn.\n                _cand_t = (self._decomp_filter_cand_t\n                           if cand is self._decomp_filter_cand\n                           else torch.from_numpy(cand))\n                return self._decode_layer_cpp(\n                    layer_id, active, k_cache, v_cache,\n                    _cand_t)\n\n        valid_arr = np.frombuffer(valid, dtype=np.uint8)  # bytearray view, no copy\n        filtered = cand[valid_arr[cand] != 0]\n        if filtered.size == 0:\n            return\n        # Defensive slot guard: drop any block marked persistent-valid whose\n        # slot is < 0 (valid=1 / slot=-1 desync).  The decode kernel indexes\n        # gpu_blob[slot*stride]; a single -1 → reads BEFORE the buffer → CUDA\n        # IMA, and the chunk's max-slot bounds check can't see it.  This was\n        # previously dropped for speed (assuming no desync), but offloading the\n        # whole prefill chunk re-exposes it.  ~µs numpy gather, decode-only.\n        _slot_np = self._kv_slot_np[layer_id]\n        _bad = _slot_np[filtered] < 0\n        if _bad.any():\n            _nbad = int(_bad.sum())\n            if (getattr(self, \"_slotwarn\", 0) % 200) == 0:\n                logger.warning(\n                    \"[kv-decode] L%d dropping %d/%d valid blocks with slot<0 \"\n                    \"(compress/free desync)\", layer_id, _nbad, filtered.size)\n            self._slotwarn = getattr(self, \"_slotwarn\", 0) + 1\n            filtered = filtered[~_bad]\n            if filtered.size == 0:\n                return\n        self._decompress_batched(layer_id, filtered, k_cache, v_cache)\n\n    def _restore_secondary_fallbacks(\n            self, layer_id: int, candidates: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\n        \"\"\"Restore tight-stride overflow blocks and remove them from codec decode.\n\n        ``is_raw==2`` means neither the compressed payload nor raw BF16 fit the\n        tight blob row, so the encoder intentionally stored no blob.  The C++\n        fast path used to pass those rows to the codec kernel, which interpreted\n        any nonzero ``is_raw`` as raw-in-row and read stale bytes.  Check both K\n        and V metadata, copy the exact pair from raw secondary, and let the codec\n        kernel handle only rows that have a real blob.\n        \"\"\"\n        if (self._blob_stride >= self._raw_bytes\n                or not self._secondary_fallback_possible.get(layer_id, False)\n                or candidates.size == 0):\n            return candidates\n\n        valid = np.frombuffer(\n            self._persistent_valid[layer_id], dtype=np.uint8)\n        valid_pos = np.flatnonzero(valid[candidates] != 0)\n        if valid_pos.size == 0:\n            return candidates\n\n        valid_ids = candidates[valid_pos]\n        slots = self._kv_slot_np[layer_id][valid_ids]\n        slot_ok = slots >= 0\n        if not slot_ok.any():\n            return candidates\n\n        probe_pos = valid_pos[slot_ok]\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        k_raw = pools['k']['is_raw'].numpy()[probe_slots]\n        v_raw = pools['v']['is_raw'].numpy()[probe_slots]\n        secondary = (k_raw >= 2) | (v_raw >= 2)\n        if not secondary.any():\n            return candidates\n\n        secondary_pos = probe_pos[secondary]\n        secondary_ids = np.ascontiguousarray(candidates[secondary_pos])\n        self._decode_raw_from_secondary(\n            layer_id, secondary_ids, k_cache, v_cache)\n\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[secondary_pos] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(self, layer_id, raw_bids, k_cache, v_cache,\n                                   stream=None):\n        \"\"\"Reconstruct over-stride (is_raw==2) blocks from the per-layer raw\n        secondary KV (which cpu_after_raw_swap already populated) — they have no\n        valid compressed blob, so copy the raw block straight into the decode\n        output.  Few blocks (only high-exception ones), so a gather + H2D\n        index_copy is fine.  ``stream`` selects the copy stream (default the\n        decode stream; the fused path passes its separate staging stream so the\n        copy overlaps compute like the rest of the staging).\"\"\"\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        if layer_id >= len(DualMemoryLoader.kv_caches):\n            raise RuntimeError(\n                \"P4Flat KV tight-stride fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no DualMemoryLoader cache.\")\n        kc = DualMemoryLoader.kv_caches[layer_id]\n        sec = getattr(kc, \"secondary_kv\", None)\n        if sec is None:\n            raise RuntimeError(\n                \"P4Flat KV tight-stride fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no secondary_kv.\")\n        idx = torch.from_numpy(np.ascontiguousarray(raw_bids))\n        with torch.cuda.stream(stream or self.batch_decomp_stream):\n            dev = idx.to(k_cache.device, non_blocking=True)\n            k_cache.index_copy_(\n                0, dev, sec[0][idx].to(k_cache.device, non_blocking=True))\n            v_cache.index_copy_(\n                0, dev, sec[1][idx].to(v_cache.device, non_blocking=True))\n\n    def _decode_layer_cpp(self, layer_id: int, active: int,\n                          k_cache: torch.Tensor,\n                          v_cache: torch.Tensor,\n                          candidates_t: torch.Tensor = None) -> None:\n        \"\"\"Per-layer KV decode via the C++ ``decode_layer_prep`` entry.\n\n        One pybind call stages everything (valid filter, slot/meta gather\n        into the pinned ring, meta + blob async H2D, ring/dec event\n        records); only the two codec decode kernels remain in Python (they\n        are codec-specific overrides — ``_invoke_decode_kernel``).\"\"\"\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_push(f\"kv_decode_cpp L{layer_id}\")\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        # H2D-on-load_kv_stream split: run the blob+meta H2D on load_kv_stream\n        # (aliased to load_weight_stream) so it is SERIAL with weight on the\n","stderr":"","aggregated_output":"        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        del max_gpu_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._build_blob_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        # The loader wires load_kv_stream after construction.  Keep two HBM\n        # staging slots so H2D(L+1) can fill one while decode(L) reads the\n        # other.  This is the same general producer/consumer scheme used by\n        # P4Flat; standalone compressors simply stay on slot zero.\n        self._gpu_decomp_pool_ring = [\n            self._gpu_decomp_pool,\n            {\n                \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n                \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            },\n        ]\n        self._dec_blob_ring_idx = 0\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for event in self._dec_blob_consumed:\n            event.record()\n        self._identity_slots_gpu = torch.arange(\n            max_gpu_decomp_blocks + 1, dtype=torch.int32, device=\"cuda\")\n        self._decode_generation = {layer: 0 for layer in range(n_layers)}\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        self._prepared_active_list = None\n        self._prepared_active_candidates = None\n        self._prepared_active_version = 0\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n            for layer in range(n_layers)}\n        self._kv_slot_np = {\n            layer: self._kv_slot[layer].numpy()\n            for layer in range(n_layers)}\n        self._kv_slot_block = {\n            layer: [-1] * host_n for layer in range(n_layers)}\n        self._kv_active_count = {\n            layer: 0 for layer in range(n_layers)}\n        self._kv_free_heap = {layer: [] for layer in range(n_layers)}\n        self._kv_free_slots = {layer: set() for layer in range(n_layers)}\n        self._kv_dec_h2d = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        self._kv_h2d_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Give CPU workers a completed initial event for layers that have not\n        # loaded persistent compressed data yet.\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for event in self._kv_dec_h2d:\n                event.record(self.batch_decomp_stream)\n            for event in self._kv_h2d_begin:\n                event.record(self.batch_decomp_stream)\n            for event in self._kv_decode_begin:\n                event.record(self.batch_decomp_stream)\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool[\"blob\"][dst_slot].copy_(pool[\"blob\"][src_slot])\n\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\n        self._decode_generation[layer_id] = (\n            self._decode_generation.get(layer_id, 0) + 1)\n        self._decode_filtered.pop(layer_id, None)\n        self._decode_plans.pop(layer_id, None)\n\n    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\n        \"\"\"Publish the canonical active set once for the upcoming forward.\n\n        ``torch_hooks.before_model_forward`` already materializes a sorted\n        int64 NumPy array and its corresponding Python list once per step.\n        Holding both references lets every layer replace an O(N) content\n        comparison with an identity + integer-version check.  Direct users\n        that do not call this method continue through the original defensive\n        filter/content-compare path.\n        \"\"\"\n        if active_array is None:\n            active_array = active_block_ids\n        candidates = np.asarray(active_array, dtype=np.int64)\n        if not candidates.flags.c_contiguous:\n            candidates = np.ascontiguousarray(candidates)\n        if (candidates.size > 1\n                and bool((candidates[1:] < candidates[:-1]).any())):\n            candidates = np.sort(candidates)\n\n        previous = self._prepared_active_candidates\n        if previous is None or not np.array_equal(previous, candidates):\n            self._prepared_active_version += 1\n        # Keep the current step's objects alive.  The loader replaces rather\n        # than mutates them on the next step, so no per-step copy is needed.\n        self._prepared_active_list = active_block_ids\n        self._prepared_active_candidates = candidates\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n                    lib = ctypes.CDLL(candidate)\n                    break\n                except OSError:\n                    continue\n            if lib is None:\n                try:\n                    lib = ctypes.CDLL(\"libcudart.so\")\n                except OSError as error:\n                    raise RuntimeError(\n                        \"libcudart is required by the CD3 CPU encoder\") from error\n            _cudart_lib = lib\n    return _cudart_lib\n\n\ndef _sync_cuda_event(handle: int) -> None:\n    if not handle:\n        return\n    lib = _get_cudart()\n    result = lib.cudaEventSynchronize(ctypes.c_void_p(int(handle)))\n    if result != 0:\n        raise RuntimeError(\n            f\"cudaEventSynchronize failed for CD3 CPU encode: {result}\")\n\n\nclass ChunkDelta3KVCompressor(_ChunkDelta3KVStorage):\n    \"\"\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\n\n    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\n    that D2H event and encodes directly from the host tensor into persistent\n    physical slots, keeping encode kernels off the fused-MM critical path.\n    \"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n            raise RuntimeError(\n                \"ChunkDelta3KVCompressor requires the CPU host encoder\")\n        super().__init__(comp_stream)\n        _get_cudart()\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # Grace serving usually produces only eight newly-full blocks per\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n        # series; eight small teams instead pipeline independent layers across\n        # the same CPU budget.  Retain the established one-worker x86 default.\n        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        compression_cpu_count = len([\n            cpu for cpu in os.sched_getaffinity(0)\n            if cpu >= self._reserve_cores])\n        default_omp_threads = str(max(\n            1, (compression_cpu_count + self._n_workers - 1)\n            // self._n_workers))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state[\"done\"].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for CD3 KV CPU worker\")\n        error = state.get(\"error\")\n        if error is not None:\n            raise error\n\n    def _pin_worker_thread(self) -> None:\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        with self._pin_lock:\n            index = self._pin_counter % self._n_workers\n            self._pin_counter += 1\n        self._pin_tls.index = index\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_dynamic(0)\n        if self._pin_workers:\n            compression_cpus = [\n                cpu for cpu in allowed if cpu >= self._reserve_cores]\n            if len(compression_cpus) < self._n_workers:\n                compression_cpus = allowed\n            usable = compression_cpus[:min(\n                len(compression_cpus),\n                self._n_workers * self._omp_thread_cap)]\n            begin = len(usable) * index // self._n_workers\n            end = len(usable) * (index + 1) // self._n_workers\n            affinity = set(usable[begin:end])\n            if not affinity:\n                affinity = {allowed[index % len(allowed)]}\n            try:\n                os.sched_setaffinity(0, affinity)\n            except OSError as error:\n                logger.warning(\n                    \"CD3 compress worker %d affinity failed: %s\",\n                    index, error)\n        else:\n            affinity = set(allowed)\n        omp_threads = min(len(affinity), self._omp_thread_cap)\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(omp_threads))\n        ordered = tuple(sorted(affinity))\n        with self._pin_lock:\n            self._worker_affinities[index] = ordered\n            self._worker_omp_threads[index] = omp_threads\n        logger.info(\n            \"CD3 compress worker %d -> %d CPUs (%d-%d), OMP=%d\",\n            index, len(ordered), ordered[0], ordered[-1], omp_threads)\n\n    def compress_batch_async(self, layer_id: int, block_ids: list,\n                             gpu_k: torch.Tensor,\n                             gpu_v: torch.Tensor) -> None:\n        raise NotImplementedError(\n            \"ChunkDelta3 uses CPU encoding after the raw KV swap\")\n\n    def _assign_kv_slots(self, layer_id: int,\n                         block_ids: np.ndarray) -> np.ndarray:\n        # Match P4Flat's batched fast path.  The old list comprehension called\n        # into Python once per block and dominated the large-N microbenchmark\n        # even though the native CD3 encoder itself was already competitive.\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\n        slot_table = self._kv_slot_np[layer_id]\n        previous = slot_table[bid_arr]\n        new_mask = previous < 0\n        if not bool(new_mask.any()):\n            return np.ascontiguousarray(previous, dtype=np.int64)\n\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot_blocks = self._kv_slot_block[layer_id]\n        capacity = len(slot_blocks)\n        high_water = self._kv_active_count[layer_id]\n        new_block_ids = bid_arr[new_mask].tolist()\n        new_slots = []\n        for _ in new_block_ids:\n            slot = -1\n            while heap:\n                candidate = heapq.heappop(heap)\n                if candidate in free_set:\n                    free_set.discard(candidate)\n                    slot = candidate\n                    break\n            if slot < 0:\n                if high_water >= capacity:\n                    raise RuntimeError(\n                        \"ChunkDelta3 KV persistent slot pool full for \"\n                        f\"layer={layer_id}\")\n                slot = high_water\n                high_water += 1\n            new_slots.append(slot)\n\n        new_slots_array = np.asarray(new_slots, dtype=np.int64)\n        slot_table[bid_arr[new_mask]] = new_slots_array\n        result = previous.copy()\n        result[new_mask] = new_slots_array\n        for block_id, slot in zip(new_block_ids, new_slots):\n            slot_blocks[slot] = block_id\n        self._kv_active_count[layer_id] = high_water\n        self._invalidate_decode_plan(layer_id)\n        return np.ascontiguousarray(result, dtype=np.int64)\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        self._invalidate_decode_plan(layer_id)\n        free_set = self._kv_free_slots[layer_id]\n        high_water = self._kv_active_count[layer_id]\n        if slot == high_water - 1:\n            high_water -= 1\n            while high_water - 1 in free_set:\n                free_set.discard(high_water - 1)\n                high_water -= 1\n            self._kv_active_count[layer_id] = high_water\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get(\"buffer_ids\", ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64))\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_table = self._kv_slot_np.get(layer_id)\n                if slot_table is None or not 0 <= block_id < slot_table.size:\n                    return\n                slot = int(slot_table[block_id])\n                if slot < 0:\n                    return\n                self._invalidate_decode_plan(layer_id)\n                slot_table[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n            self._free_kv_slot(layer_id, block_id)\n\n    def compress_batch_async_from_host(\n        self,\n        layer_id: int,\n        block_ids: list,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        wait_event_handle: int = 0,\n    ) -> None:\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        num_source_blocks = host_k.shape[0]\n        block_array = np.asarray(block_ids, dtype=np.int64)\n        if block_array.size:\n            block_array = block_array[\n                (block_array >= 0) & (block_array < num_source_blocks)]\n        if block_array.size == 0:\n            return\n        decode_event_handle = int(\n            self._kv_dec_h2d[layer_id].cuda_event)\n        with self._slot_state_lock:\n            slots = self._assign_kv_slots(layer_id, block_array)\n            valid = self._persistent_valid[layer_id]\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\n            self._invalidate_decode_plan(layer_id)\n            state = self._worker_state_for_layer(layer_id)\n            state[\"error\"] = None\n            state[\"done\"].clear()\n            pending = {\n                \"state\": state,\n                \"buffer_ids\": block_array,\n                \"physical_slots\": slots,\n            }\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_queue.put((\n                    state,\n                    (layer_id, host_k, host_v, block_array, slots,\n                     int(wait_event_handle), decode_event_handle),\n                ))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state[\"done\"].set()\n                raise\n\n    def _encode_chunk(\n        self,\n        layer_id: int,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        block_ids: np.ndarray,\n        slots: np.ndarray,\n        raw_event_handle: int,\n        decode_event_handle: int,\n    ) -> None:\n        self._pin_worker_thread()\n        _sync_cuda_event(raw_event_handle)\n        _sync_cuda_event(decode_event_handle)\n        # A 56-thread team is counterproductive when only 8-64 fresh blocks\n        # exist (the normal serving case).  Shrink the team for small calls;\n        # default eight-worker serving already clamps each worker to seven\n        # CPUs, so this mainly fixes explicit workers=1 deployments.\n        worker_index = int(getattr(self._pin_tls, \"index\", 0))\n        maximum_threads = self._worker_omp_threads.get(\n            worker_index, self._omp_thread_cap)\n        block_count = int(block_ids.size)\n        if block_count <= 8:\n            omp_threads = min(maximum_threads, 8)\n        elif block_count <= 64:\n            omp_threads = min(maximum_threads, 16)\n        elif block_count <= 256:\n            omp_threads = min(maximum_threads, 32)\n        else:\n            omp_threads = maximum_threads\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(max(1, omp_threads)))\n        block_tensor = torch.from_numpy(block_ids)\n        slot_tensor = torch.from_numpy(slots)\n        for source, kv in ((host_k, \"k\"), (host_v, \"v\")):\n            pool = self._host_pools[layer_id][kv]\n            _cd3_ext.host_encode_chunk_delta3_blocks(\n                source.view(torch.int16), block_tensor, slot_tensor,\n                pool[\"codes\"], pool[\"sign_mantissa\"],\n                pool[\"thread_bases\"], pool[\"tile_exception_offsets\"],\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                self._M_b, self._K_b,\n            )\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        with self._slot_state_lock:\n            pending = self._pending_compress.get(layer_id)\n        buffer_ids = []\n        if pending is not None:\n            worker_retired = False\n            try:\n                self._wait_worker_state(pending[\"state\"], timeout_sec)\n                worker_retired = True\n                slots = np.asarray(\n                    pending[\"physical_slots\"], dtype=np.int64)\n                for kv in (\"k\", \"v\"):\n                    counts = self._host_pools[\n                        layer_id][kv][\"num_exceptions\"].numpy()[slots]\n                    overflow = np.flatnonzero(counts > self._entry_capacity)\n                    if overflow.size:\n                        index = int(overflow[0])\n                        raise RuntimeError(\n                            \"ChunkDelta3 KV exception capacity exceeded: \"\n                            f\"layer={layer_id} kv={kv} \"\n                            f\"b