n        if (self._blob_stride >= self._raw_bytes\n                or not self._secondary_fallback_possible.get(layer_id, False)\n                or candidates.size == 0):\n            return candidates\n\n        valid = np.frombuffer(\n            self._persistent_valid[layer_id], dtype=np.uint8)\n        valid_pos = np.flatnonzero(valid[candidates] != 0)\n        if valid_pos.size == 0:\n            return candidates\n\n        valid_ids = candidates[valid_pos]\n        slots = self._kv_slot_np[layer_id][valid_ids]\n        slot_ok = slots >= 0\n        if not slot_ok.any():\n            return candidates\n\n        probe_pos = valid_pos[slot_ok]\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        k_raw = pools['k']['is_raw'].numpy()[probe_slots]\n        v_raw = pools['v']['is_raw'].numpy()[probe_slots]\n        secondary = (k_raw >= 2) | (v_raw >= 2)\n        if not secondary.any():\n            return candidates\n\n        secondary_pos = probe_pos[secondary]\n        secondary_ids = np.ascontiguousarray(candidates[secondary_pos])\n        self._decode_raw_from_secondary(\n            layer_id, secondary_ids, k_cache, v_cache)\n\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[secondary_pos] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(self, layer_id, raw_bids, k_cache, v_cache,\n                                   stream=None):\n        \"\"\"Reconstruct over-stride (is_raw==2) blocks from the per-layer raw\n        secondary KV (which cpu_after_raw_swap already populated) — they have no\n        valid compressed blob, so copy the raw block straight into the decode\n        output.  Few blocks (only high-exception ones), so a gather + H2D\n        index_copy is fine.  ``stream`` selects the copy stream (default the\n        decode stream; the fused path passes its separate staging stream so the\n        copy overlaps compute like the rest of the