contiguousarray(\n            slot_table[block_ids], dtype=np.int32)\n        if bool((slots_np < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        # The production steady state is dense: all active physical slots are\n        # requested.  Skip Python list conversion and run construction there.\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n        slot_runs = None\n        if dense:\n            packed_h2d = False\n        else:\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\n            max_runs = max(0, int(os.getenv(\n                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n            packed_h2d = (\n                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n                or hwm > self._max_gpu_decomp_blocks + 1)\n\n        slots_gpu = (\n            self._identity_slots_gpu[:n]\n            if packed_h2d else torch.as_tensor(\n                slots_np, dtype=torch.int32, device=k_cache.device))\n        block_ids_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=k_cache.device)\n        copy_destinations_ring = [[], []]\n        copy_sources = []\n        for kv in (\"k\", \"v\"):\n            host_blob = self._host_pools[layer_id][kv][\"blob\"]\n            if packed_h2d:\n                for row_begin, row_end, slot_begin in slot_runs:\n                    length = row_end - row_begin\n                    for ring_index, gpu_pool in enumerate(\n                            self._gpu_decomp_pool_ring):\n                        copy_destinations_ring[ring_index].append(\n                            gpu_pool[kv][\"blob\"][row_begin:row_end])\n                    copy_sources.append(\n                        host_blob[slot_begin:slot_begin + length])\n            else:\n                for ring_index, gpu_pool in enumerate(\n                        self._gpu_decomp_pool_ring):\n                    copy_destinations_ring[ring_index].append(\n                        gpu_pool[kv][\"blob\"][:hwm])\n                copy_sources.append(host_blob[:hwm])\n        storage_rows = n if packed_h2d else hwm\n        return {\n            \"block_ids\": block_ids,\n            \"generation\": self._decode_generation.get(layer_id, 0),\n            \"slots_gpu\": slots_gpu,\n            \"block_ids_gpu\": block_ids_gpu,\n            \"copy_destinations_ring\": copy_destinations_ring,\n            \"copy_sources\": copy_sources,\n            \"storage_rows\": storage_rows,\n        }\n\n    def _launch_decode(self, gpu_pool, plan, k_cache, v_cache) -> None:\n        storage_rows = plan[\"storage_rows\"]\n        _cd3_ext.decompress_chunk_delta3_batched_blob_pair_stream(\n            gpu_pool[\"k\"][\"blob\"][:storage_rows],\n            gpu_pool[\"v\"][\"blob\"][:storage_rows],\n            plan[\"slots_gpu\"],\n            plan[\"block_ids_gpu\"],\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n            self._packed_capacity,\n            self.batch_decomp_stream.cuda_stream,\n        )\n\n    def _decompress_blocks(self, layer_id: int, block_ids,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV decode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_decomp_blocks}\")\n        if self._kv_active_count[layer_id] <= 0:\n            return\n        if not isinstance(block_ids, np.ndarray):\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n        plan = self._decode_plans.get(layer_id)\n        gener