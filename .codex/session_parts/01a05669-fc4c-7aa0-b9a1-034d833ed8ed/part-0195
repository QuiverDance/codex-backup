e\n                if args.max_weights and processed >= args.max_weights:\n                    break\n                if len(roles) == 1:\n                    gt = tensors[roles[0]]\n                else:\n                    gt = torch.cat([tensors[r] for r in roles], dim=0)\n                rows = _bench_weight(gt, f\"L{layer}.{gname}\", selected,\n                                     registry, _get, args.runs, args.no_cast)\n                all_rows.extend(rows)\n                if rows:\n                    processed += 1\n                print()\n    