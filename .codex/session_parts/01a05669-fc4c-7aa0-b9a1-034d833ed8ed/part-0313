             (57344, 8192): 1,\n   323\t                (8192, 28672): 4,\n   324\t            }.get((M, K), 1)\n   325\t        elif n_pad in (192, 256):\n   326\t            split_k = 4 if (M, K) == (10240, 8192) else 1\n   327\t        else:\n   328\t            split_k = 1\n   329\t        output = torch.empty(\n   330\t            n_pad, M, dtype=torch.bfloat16, device=device)\n   331\t        padded_input = torch.empty(\n   332\t            n_pad, K, dtype=torch.bfloat16, device=device)\n   333\t        partials = (\n   334\t            torch.empty(\n   335\t                split_k, n_pad, M, dtype=torch.float32, device=device)\n   336\t            if split_k > 1\n   337\t            else _empty_f32(device)\n   338\t        )\n   339\t        return {\n   340\t            \"key\": (M, K, N, device.index),\n   341\t            \"n_pad\": n_pad,\n   342\t            \"split_k\": split_k,\n   343\t            \"output\": output,\n   344\t            \"padded_input\": padded_input,\n   345\t            \"partials\": partials,\n   346\t        }\n   347\t\n   348\t    def alloc_fused_scratch(\n   349\t        self,\n   350\t        K: int,\n   351\t        M: int,\n   352\t        N: int,\n   353\t        dtype: torch.dtype,\n   354\t        device: torch.device,\n   355\t    ):\n   356\t        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n   357\t                or M % 64 or K % 64 or N <= 0):\n   358\t            return None\n   359\t        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n   360\t\n   361\t    def _linear_apply_impl(\n   362\t        self,\n   363\t        comp: CompressedChunkDelta3Tensor,\n   364\t        x: torch.Tensor,\n   365\t        scratch: Optional[dict],\n   366\t        wdecomp_events=None,\n   367\t    ) -> torch.Tensor:\n   368\t        import torch.nn.functional as F\n   369\t\n   370\t        M, K = int(comp.M), int(comp.K)\n   371\t        original_shape = x.shape\n   372\t        x2 = x.reshape(-1, K)\n   373\t        N = int(x2.shape[0])\n   374\t        use_fused = (\n   375\t            M % 64 == 0\n   376\t            and K % 64 == 0\n   377\t            and 0 < N <= self._fused_max_n_for(M, K)\n   378\t            and x2.dtype == torch.bfloat16\n   379\t            and x2.is_cuda\n   380\t            and comp._c.codes.is_cuda\n   381\t        )\n   382\t        if not use_fused:\n   383\t            wb, we = wdecomp_events if wdecomp_events else (None, None)\n   384\t            if wb is not None:\n   385\t                wb.record()\n   386\t            weight = self.decompress(comp)\n   387\t            if we is not None:\n   388\t                we.record()\n   389\t            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n   390\t\n   391\t        key = (M, K, N, x2.device.index)\n   392\t        if scratch is None or scratch.get(\"key\") != key:\n   393\t            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n   394\t            scratch = cache.get(key)\n   395\t            if scratch is None:\n   396\t                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n   397\t                cache[key] = scratch\n   398\t\n   399\t        n_pad = int(scratch[\"n_pad\"])\n   400\t        if n_pad == N and x2.is_contiguous():\n   401\t            activation = x2\n   402\t        else:\n   403\t            activation = scratch[\"padded_input\"]\n   404\t            activation[:N].copy_(x2)\n   405\t\n   406\t        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n   407\t\n   408\t        _get_rs_ext().cd3_rs_wgmma_mm(\n   409\t            comp._c.codes,\n   410\t            comp._c.sign_mantissa,\n   411\t            comp._c.thread_bases,\n   412\t            comp._c.tile_exception_offsets,\n   413\t            comp._c.entries20x3,\n   414\t            activation,\n   415\t            scratch[\"output\"],\n   416\t            scratch[\"partials\"],\n   417\t            int(scratch[\"split_k\"]),\n   418\t            M,\n   419\t            n_pad,\n   420\t            K,\n   421\t        )\n   422\t        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n   423\t\n   424\t    def linear_apply(self, comp, x, wdecomp_events=None):\n   425\t        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n   426\t\n   427\t    def linear_apply_into(self, comp, x, scratch):\n   428\t        return self._linear_apply_impl(comp, x, scratch)\n   429\t\n   430\t    @staticmethod\n   431\t    def _pack_cpu_weight_entries(\n   432\t        packed_per_stripe: torch.Tensor,\n   433\t        counts: torch.Tensor,\n   434\t    ) -> torch.Tensor:\n   435\t        \"\"\"Compact stripe-local Packed20x3 words into one weight stream.\"\"\"\n   436\t        block_prefix = torch.zeros(\n   437\t            counts.numel() + 1, dtype=torch.int64, device=\"cpu\")\n   438\t        block_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n   439\t        total = int(block_prefix[-1].item())\n   440\t        if total == 0:\n   441\t            return torch.empty(0, dtype=torch.int64)\n   442\t\n   443\t        entries20 = torch.empty(total, dtype=torch.int32)\n   444\t        mask = (1 << 20) - 1\n   445\t        for stripe in range(counts.numel()):\n   446\t            count = int(counts[stripe].item())\n   447\t            if count == 0:\n   448\t                continue\n   449\t            begin = int(block_prefix[stripe].item())\n   450\t            words = packed_per_stripe[stripe, :(count + 2) // 3]\n   451\t            destination = entries20[begin:begin + count]\n   452\t            destination[0::3] = (words[:destination[0::3].numel()]\n   453\t                                  & mask).to(torch.int32)\n   454\t            if count > 1:\n   455\t                destination[1::3] = ((words[:destination[1::3].numel()] >> 20)\n   456\t                                      & mask).to(torch.int32)\n   457\t            if count > 2:\n   458\t                destination[2::3] = ((words[:destination[2::3].numel()] >> 40)\n   459\t                                      & mask).to(torch.int32)\n   460\t\n   461\t        num_words = (total + 2) // 3\n   462\t        padded = torch.zeros(num_words * 3, dtype=torch.int64)\n   463\t        padded[:total].copy_(entries20.to(torch.int64))\n   464\t        triples = padded.view(num_words, 3)\n   465\t        return (triples[:, 0]\n   466\t                | (triples[:, 1] << 20)\n   467\t                | (triples[:, 2] << 40)).contiguous()\n   468\t\n   469\t    @classmethod\n   470\t    def _compress_cpu_native(cls, source: torch.Tensor):\n   471\t        \"\"\"Encode a row-major BF16 weight with the OpenMP host encoder.\n   472\t\n   473\t        The KV encoder owns whole blocks.  Treat each 64-row weight stripe as\n   474\t        one block, which exposes M/64 independent jobs while preserving the\n   475\t        exact tile order consumed by the standalone and fused GPU decoders.\n   476\t        \"\"\"\n   477\t        if source.device.type != \"cpu\":\n   478\t            raise ValueError(\"ChunkDelta3 CPU encode requires a CPU tensor\")\n   479\t        source = source.contiguous()\n   480\t        M, K = map(int, source.shape)\n   481\t        stripes = M // 64\n   482\t        tiles_per_stripe = K // 64\n   483\t        block_elements = 64 * K\n   484\t        code_bytes = tiles_per_stripe * (64 * 64 * 3 // 8)\n   485\t        base_bytes = tiles_per_stripe * 256\n   486\t\n   487\t        # Layer-0 QKV is exception-heavy (~6%).  Start at 12.5% capacity and\n   488\t        # retry at the measured maximum if an unusual checkpoint exceeds it.\n   489\t        requested = int(os.getenv(\n   490\t            \"TIERED_SERVE_CD3_WEIGHT_CPU_EXCEPTION_CAPACITY_PER_64_ROWS\",\n   491\t            \"65536\"))\n   492\t        entry_capacity = min(block_elements, max(3, requested))\n   493\t        entry_capacity = ((entry_capacity + 2) // 3) * 3\n   494\t        block_ids = torch.arange(stripes, dtype=torch.int64)\n   495\t        slots = block_ids.clone()\n   496\t\n   497\t        while True:\n   498\t            codes = torch.empty((stripes, code_bytes), dtype=torch.uint8)\n   499\t            sign_mantissa = torch.empty(\n   500\t                (stripes, block_elements), dtype=torch.uint8)\n   501\t            thread_bases = torch.empty(\n   502\t                (stripes, base_bytes), dtype=torch.uint8)\n   503\t            local_offsets = torch.empty(\n   504\t                (stripes, tiles_per_stripe + 1), dtype=torch.int32)\n   505\t            packed_per_stripe = torch.empty(\n   506\t                (stripes, entry_capacity // 3), dtype=torch.int64)\n   507\t            counts = torch.empty(stripes, dtype=torch.int32)\n   508\t            _cd3_ext.host_encode_chunk_delta3_blocks(\n   509\t                source.view(torch.int16).reshape(stripes, 64, K),\n   510\t                block_ids, slots, codes, sign_mantissa, thread_bases,\n   511\t                local_offsets, packed_per_stripe, counts, 64, K)\n   512\t            maximum = int(counts.max().item()) if stripes else 0\n   513\t            if maximum <= entry_capacity:\n   514\t                break\n   515\t            entry_capacity = min(\n   516\t                block_elements,\n   517\t                ((max(maximum, entry_capacity * 2) + 2) // 3) * 3)\n   518\t            if maximum > entry_capacity:\n   519\t                raise RuntimeError(\n   520\t                    \"ChunkDelta3 CPU weight exception count exceeds one \"\n   521\t                    f\"64-row stripe: {maximum} > {block_elements}\")\n   522\t\n   523\t        stripe_prefix = torch.zeros(stripes + 1, dtype=torch.int64)\n   524\t        stripe_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n   525\t        total = int(stripe_prefix[-1].item())\n   526\t        tile_offsets = torch.empty(\n   527\t            stripes * tiles_per_stripe + 1, dtype=torch.int32)\n   528\t        tile_offsets[:-1] = (\n   529\t            local_offsets[:, :-1].to(torch.int64)\n   530\t            + stripe_prefix[:-1, None]).reshape(-1).to(torch.int32)\n   531\t        tile_offsets[-1] = total\n   532\t\n   533\t        native = _cd3_ext.CompressedChunkDelta3()\n   534\t        native.codes = codes.reshape(-1)\n   535\t        native.sign_mantissa = sign_mantissa.reshape(-1)\n   536\t        native.thread_bases = thread_bases.reshape(-1)\n   537\t        native.tile_exception_offsets = tile_offsets\n   538\t        native.entries20x3 = cls._pack_cpu_weight_entries(\n   539\t            packed_per_stripe, counts)\n   540\t        native.M = M\n   541\t        native.K = K\n   542\t        native.num_exceptions = total\n   543\t        return native\n   544\t\n   545\t    @staticmethod\n   546\t    def _stage_native_to_cuda(native, device: torch.device, stream) -> None:\n   547\t        with torch.cuda.stream(stream):\n   548\t            for attr in CompressedChunkDelta3Tensor._BUFFER_ATTRS:\n   549\t                setattr(native, attr, getattr(native, attr).to(device))\n   550\t\n   551\t    def compress(\n   552\t        self,\n   553\t        weight: torch.Tensor,\n   554\t        decomp_output_tensor: Optional[torch.Tensor] = None,\n   555\t        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n   556\t        _sync: bool = True,\n   557\t    ) -> CompressedChunkDelta3Tensor:\n   558\t        del comp_output_tensor\n   559\t        if weight.dtype != torch.bfloat16:\n   560\t            raise TypeError(\n   561\t                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n   562\t        if weight.ndim != 2:\n   563\t            raise ValueError(\n   564\t                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n   565\t                f\"got {tuple(weight.shape)}\")\n   566\t        if weight.shape[0] % 64 or weight.shape[1] % 64:\n   567\t            raise ValueError(\n   568\t                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n   569\t                f\"got {tuple(weight.shape)}\")\n   570\t\n   571\t        if self._cpu_weight_encode or not weight.is_cuda:\n   572\t            host_source = getattr(weight, \"_tiered_serve_cpu_data\", None)\n   573\t            if (not isinstance(host_source, torch.Tensor)\n   574\t                    or host_source.device.type != \"cpu\"\n   575\t                    or tuple(host_source.shape) != tuple(weight.shape)):\n   576\t                host_source = (weight.detach().cpu() if weight.is_cuda\n   577\t                               else weight.detach())\n   578\t            native = self._compress_cpu_native(host_source)\n   579\t            if weight.is_cuda:\n   580\t                stream = (self.comp_stream\n   581\t                          or torch.cuda.current_stream(weight.device))\n   582\t                self._stage_native_to_cuda(native, weight.device, stream)\n   583\t                if _sync:\n   584\t                    stream.synchronize()\n   585\t        else:\n   586\t            source = weight.contiguous()\n   587\t            stream = self.comp_stream or torch.cuda.current_stream(weight.device)\n   588\t            producer_stream = torch.cuda.current_stream(weight.device)\n   589\t            if stream != producer_stream:\n   590\t                stream.wait_stream(producer_stream)\n   591\t            with torch.cuda.stream(stream):\n   592\t                native = _cd3_ext.compress_chunk_delta3(source)\n   593\t            if _sync:\n   594\t                # The packed-entry kernel is enqueued after a host-visible count\n   595\t                # readback.  Complete it before exposing the object cross-stream.\n   596\t                stream.synchronize()\n   597\t        compressed = CompressedChunkDelta3Tensor(native)\n   598\t        if decomp_output_tensor is not None:\n   599\t            compressed.output_tensor = decomp_output_tensor\n   600\t        if _sync:\n   601\t            ratio = weight.nbytes / max(1, compressed.nbytes)\n   602\t            logger.info(\n   603\t                \"ChunkDelta3 compress [%dx%d]: ratio=%.3fx nbytes=%d \"\n   604\t                \"exceptions=%d\", compressed.M, compressed.K, ratio,\n   605\t                compressed.nbytes, compressed.num_exceptions)\n   606\t        return compressed\n   607\t\n   608\t    def decompress(\n   609\t        self,\n   610\t        comp: CompressedChunkDelta3Tensor,\n   611\t        output: Optional[torch.Tensor] = None,\n   612\t    ) -> torch.Tensor:\n   613\t        if not isinstance(comp, CompressedChunkDelta3Tensor):\n   614\t            raise TypeError(\n   615\t                \"ChunkDelta3Compressor.decompress expects \"\n   616\t                f\"CompressedChunkDelta3Tensor, got {type(comp).__name__}\")\n   617\t        output = output if output is not None else comp.output_tensor\n   618\t        if output is None:\n   619\t            if comp.sign_mantissa.device.type != \"cuda\":\n   620\t                raise RuntimeError(\n   621\t                    \"Host-resident ChunkDelta3 data must be staged before \"\n   622\t                    \"decompression\")\n   623\t            output = torch.empty(\n   624\t                (comp.M, comp.K), dtype=torch.bfloat16,\n   625\t                device=comp.sign_mantissa.device)\n   626\t        return _cd3_ext.decompress_chunk_delta3(comp._c, output)\n   627\t\n   628\t    def compress_batch(self, *args, **kwargs):\n   629\t        return super().compress_batch(*args, **kwargs)\n   630\t\n   631\t    def decompress_batch(self, *args, **kwargs):\n   632\t        return super().decompress_batch(*args, **kwargs)\n   633\t\n   634\t    def build_split_shell(self, info, staging_dict):\n   635\t        if getattr(info, \"backend\", None) != \"chunk_delta3\":\n   636\t            raise NotImplementedError(\n   637\t                \"ChunkDelta3 build_split_shell requires chunk_delta3 data\")\n   638\t        native = _cd3_ext.CompressedChunkDelta3()\n   639\t        native.sign_mantissa = info.sign_mantissa\n   640\t        for attr in info.lpddr_attrs:\n   641\t            value = staging_dict.get(attr)\n   642\t            if value is None:\n   643\t                raise RuntimeError(\n   644\t                    f\"ChunkDelta3 staging slot missing {attr!r}\")\n   645\t            # FrozenSplit staging is allocated to the largest tensor of each\n   646\t            # projection/parity and reused by every layer.  Bind only this\n   647\t            # layer's live prefix: the native decoder validates exact buffer\n   648\t            # sizes (not capacity), especially for variable-size entries20x3.\n   649\t            numel = int(info.lpddr_numels[attr])\n   650\t            if value.numel() < numel:\n   651\t                raise RuntimeError(\n   652\t                    f\"ChunkDelta3 staging slot {attr!r} is too small: \"\n   653\t                    f\"{value.numel()} < {numel}\")\n   654\t            setattr(native, attr, value.reshape(-1).narrow(0, 0, numel))\n   655\t        for attr in info.hbm_attrs:\n   656\t            value = info.hbm_buffers.get(attr)\n   657\t            if value is None:\n   658\t                raise RuntimeError(f\"ChunkDelta3 HBM buffer missing {attr!r}\")\n   659\t            setattr(native, attr, value)\n   660\t        native.M = int(info.M)\n   661\t        native.K = int(info.K)\n   662\t        native.num_exceptions = int(info.num_exceptions)\n   663\t        return CompressedChunkDelta3Tensor(native)\n","exit_code":0,"duration":{"secs":0,"nanos":1696},"formatted_output":"     1\t\"\"\"Lossless BF16 ChunkDelta3 compressor.\n     2\t\n     3\tChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\n     4\t16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\n     5\tencodes exponent deltas in three bits.  Values outside the local 3-bit range\n     6\tare restored from tile-local 20-bit ``(exponent8, position12)`` exceptions,\n     7\tpacked three per aligned 64-bit word, making the codec bit exact.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport os\n    13\tfrom typing import Dict, Optional\n    14\t\n    15\timport torch\n    16\t\n    17\tfrom tiered_serve.compressor_base import TensorCompressor\n    18\t\n    19\t\n    20\tlogger = logging.getLogger(\"vllm\")\n    21\t\n    22\ttry:\n    23\t    from tiered_serve.cpp_exts import tp3_cd3_ext as _cd3_ext\n    24\t    _HAS_CHUNK_DELTA3 = True\n    25\texcept Exception as _error:\n    26\t    logger.warning(\n    27\t        \"ChunkDelta3Compressor disabled: failed to load tp3_cd3_ext \"\n    28\t        \"(%s: %s)\", type(_error).__name__, _error)\n    29\t    _cd3_ext = None\n    30\t    _HAS_CHUNK_DELTA3 = False\n    31\t\n    32\t\n    33\tclass CompressedChunkDelta3Tensor:\n    34\t    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n    35\t\n    36\t    _BUFFER_ATTRS = (\n    37\t        \"codes\",\n    38\t        \"sign_mantissa\",\n    39\t        \"thread_bases\",\n    40\t        \"tile_exception_offsets\",\n    41\t        \"entries20x3\",\n    42\t    )\n    43\t    _BUFFER_ATTR_D_PAIRS = tuple(\n    44\t        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n    45\t\n    46\t    def __init__(self, c_struct):\n    47\t        self._c = c_struct\n    48\t        self.output_tensor: Optional[torch.Tensor] = None\n    49\t        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n    50\t        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n    51\t        self._host_slab: Optional[torch.Tensor] = None\n    52\t        self._device_slab: Optional[torch.Tensor] = None\n    53\t        self._slab_layout: Optional[tuple[tuple, ...]] = None\n    54\t        self._copy_slab = False\n    55\t        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n    56\t            setattr(self, attr, getattr(c_struct, attr))\n    57\t            setattr(self, device_attr, None)\n    58\t\n    59\t    @property\n    60\t    def M(self) -> int:\n    61\t        return int(self._c.M)\n    62\t\n    63\t    @property\n    64\t    def K(self) -> int:\n    65\t        return int(self._c.K)\n    66\t\n    67\t    @property\n    68\t    def num_exceptions(self) -> int:\n    69\t        return int(self._c.num_exceptions)\n    70\t\n    71\t    @property\n    72\t    def nbytes(self) -> int:\n    73\t        return int(self._c.nbytes)\n    74\t\n    75\t    @property\n    76\t    def total_compressed_size(self) -> int:\n    77\t        return self.nbytes\n    78\t\n    79\t    @property\n    80\t    def original_size(self) -> int:\n    81\t        return self.M * self.K * 2\n    82\t\n    83\t    @property\n    84\t    def frozen_hbm_bytes(self) -> int:\n    85\t        return int(self._c.frozen_hbm_bytes)\n    86\t\n    87\t    @property\n    88\t    def frozen_transfer_bytes(self) -> int:\n    89\t        return int(self._c.frozen_transfer_bytes)\n    90\t\n    91\t    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n    92\t        for attr, view in zip(self._BUFFER_ATTRS, views):\n    93\t            setattr(self._c, attr, view)\n    94\t\n    95\t    def register_temp_d_tensor(\n    96\t        self,\n    97\t        temp_d: torch.Tensor,\n    98\t        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    99\t    ) -> None:\n   100\t        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n   101\t        self.output_tensor = temp_d\n   102\t        views = []\n   103\t        self._copy_slab = self._host_slab is not None and gpu_pool is None\n   104\t        if self._copy_slab:\n   105\t            self._device_slab = torch.empty_like(\n   106\t                self._host_slab, device=temp_d.device)\n   107\t            assert self._slab_layout is not None\n   108\t            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n   109\t                view = self._device_slab.narrow(0, offset, nbytes)\n   110\t                view = view.view(dtype).reshape(shape)\n   111\t                setattr(self, f\"_d_{attr}\", view)\n   112\t                views.append(view)\n   113\t        else:\n   114\t            self._device_slab = None\n   115\t            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n   116\t                source = getattr(self, attr)\n   117\t                destination = (\n   118\t                    gpu_pool[attr]\n   119\t                    if gpu_pool is not None and attr in gpu_pool\n   120\t                    else torch.empty_like(source, device=temp_d.device)\n   121\t                )\n   122\t                if destination.numel() < source.numel():\n   123\t                    raise ValueError(\n   124\t                        f\"GPU staging buffer {attr!r} is too small: \"\n   125\t                        f\"{destination.numel()} < {source.numel()}\")\n   126\t                view = destination.reshape(-1).narrow(0, 0, source.numel())\n   127\t                view = view.reshape(source.shape)\n   128\t                setattr(self, device_attr, destination)\n   129\t                views.append(view)\n   130\t        self._h2d_views = tuple(views)\n   131\t        self._h2d_sources = tuple(\n   132\t            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n   133\t        self._set_native_buffers(self._h2d_views)\n   134\t\n   135\t    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n   136\t        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n   137\t        sources = [getattr(self, attr).contiguous()\n   138\t                   for attr in self._BUFFER_ATTRS]\n   139\t        layout = []\n   140\t        offset = 0\n   141\t        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n   142\t            alignment = tensor.element_size()\n   143\t            offset = (offset + alignment - 1) // alignment * alignment\n   144\t            layout.append(\n   145\t                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n   146\t            offset += tensor.nbytes\n   147\t\n   148\t        if huge_page_allocator is not None:\n   149\t            try:\n   150\t                host_slab = huge_page_allocator.allocate(\n   151\t                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n   152\t            except (MemoryError, ValueError):\n   153\t                logger.warning(\n   154\t                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n   155\t                    \"pinned host memory\")\n   156\t                host_slab = torch.empty(offset, dtype=torch.uint8,\n   157\t                                        pin_memory=True)\n   158\t        else:\n   159\t            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n   160\t\n   161\t        host_views = []\n   162\t        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n   163\t            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n   164\t            view.copy_(source)\n   165\t            setattr(self, attr, view)\n   166\t            host_views.append(view)\n   167\t        self._host_slab = host_slab\n   168\t        self._slab_layout = tuple(layout)\n   169\t        self._device_slab = None\n   170\t        self._h2d_views = None\n   171\t        self._h2d_sources = None\n   172\t        self._copy_slab = False\n   173\t        self._set_native_buffers(tuple(host_views))\n   174\t        return self\n   175\t\n   176\t    def to(self, device=\"cuda\", non_blocking: bool = True):\n   177\t        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n   178\t        if torch.device(device).type != \"cuda\":\n   179\t            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n   180\t        if self._h2d_views is None:\n   181\t            raise RuntimeError(\n   182\t                \"CompressedChunkDelta3Tensor.to(): call \"\n   183\t                \"register_temp_d_tensor first\")\n   184\t        if self._copy_slab:\n   185\t            assert self._host_slab is not None and self._device_slab is not None\n   186\t            self._device_slab.copy_(self._host_slab,\n   187\t                                    non_blocking=non_blocking)\n   188\t        else:\n   189\t            assert self._h2d_sources is not None\n   190\t            for source, destination in zip(\n   191\t                    self._h2d_sources, self._h2d_views):\n   192\t                destination.copy_(source, non_blocking=non_blocking)\n   193\t        return self\n   194\t\n   195\t    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n   196\t        if self._h2d_views is None:\n   197\t            raise RuntimeError(\"GPU staging buffers have not been registered\")\n   198\t        return self._h2d_views\n   199\t\n   200\t\n   201\tclass ChunkDelta3Compressor(TensorCompressor):\n   202\t    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n   203\t\n   204\t    HAS_FUSED_MM = True\n   205\t    codec_name = \"chunk_delta3\"\n   206\t\n   207\t    # GH200/Llama-70B serving calibration covers the lossless Packed20x3\n   208\t    # kernels through N=128.  With concurrent weight H2D, all four projections\n   209\t    # win throughout N=65..128.  QKV wins on 79/80 real layers (layer 0 is the\n   210\t    # exception-heavy outlier) and still wins in the 80-layer aggregate.  At\n   211\t    # N=129 the activation tile expands from 128 to 192 and fused latency jumps\n   212\t    # by about 2x, so dense decompress+cuBLAS is the clear route above 128.\n   213\t    # Keep environment overrides for cross-GPU/model retuning.\n   214\t    _FUSED_MAX_N_TABLE = {\n   215\t        (10240, 8192): 128,\n   216\t        (8192, 8192): 128,\n   217\t        (57344, 8192): 128,\n   218\t        (8192, 28672): 128,\n   219\t    }\n   220\t\n   221\t    def __init__(\n   222\t        self,\n   223\t        comp_stream: Optional[torch.cuda.Stream] = None,\n   224\t        decomp_stream: Optional[torch.cuda.Stream] = None,\n   225\t    ):\n   226\t        super().__init__(comp_stream, decomp_stream)\n   227\t        if not _HAS_CHUNK_DELTA3:\n   228\t            raise RuntimeError(\n   229\t                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n   230\t                \"successfully\")\n   231\t        # Weight compression is an offline/load-time operation.  Keep its\n   232\t        # compute on the host so it never steals SM time from serving.  The\n   233\t        # completed compressed buffers are staged to CUDA only when the input\n   234\t        # itself is CUDA; CPU callers retain a host-resident result.\n   235\t        self._cpu_weight_encode = (\n   236\t            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n   237\t        self._fused_max_n_override: Optional[int] = None\n   238\t        self._fused_max_n_by_shape_override: dict[tuple[int, int], int] = {}\n   239\t        # Serving-level experiments can force the implemented fused path\n   240\t        # without changing the conservative production crossover table.\n   241\t        # Keeping this explicit matters because the current table is zero\n   242\t        # until end-to-end measurements justify enabling a shape by default.\n   243\t        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n   244\t        if fused_override is not None:\n   245\t            value = int(fused_override)\n   246\t            if value < 0:\n   247\t                raise ValueError(\n   248\t                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n   249\t            self._fused_max_n_override = value\n   250\t\n   251\t        # Projection-specific overrides make route calibration possible without\n   252\t        # rebuilding the extension or editing the production table.  A shape\n   253\t        # override takes precedence over the uniform override above.\n   254\t        projection_shapes = {\n   255\t            \"QKV\": (10240, 8192),\n   256\t            \"O\": (8192, 8192),\n   257\t            \"GATE_UP\": (57344, 8192),\n   258\t            \"DOWN\": (8192, 28672),\n   259\t        }\n   260\t        for projection, shape in projection_shapes.items():\n   261\t            env_name = f\"TIERED_SERVE_CD3_FUSED_MAX_N_{projection}\"\n   262\t            raw_value = os.getenv(env_name)\n   263\t            if raw_value is None:\n   264\t                continue\n   265\t            value = int(raw_value)\n   266\t            if value < 0:\n   267\t                raise ValueError(f\"{env_name} must be non-negative\")\n   268\t            self._fused_max_n_by_shape_override[shape] = value\n   269\t\n   270\t    def _fused_max_n_for(self, M: int, K: int) -> int:\n   271\t        shape_override = self._fused_max_n_by_shape_override.get((M, K))\n   272\t        if shape_override is not None:\n   273\t            return int(shape_override)\n   274\t        if self._fused_max_n_override is not None:\n   275\t            return int(self._fused_max_n_override)\n   276\t        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n   277\t\n   278\t    @staticmethod\n   279\t    def _allocate_fused_scratch(\n   280\t        M: int,\n   281\t        K: int,\n   282\t        N: int,\n   283\t        device: torch.device,\n   284\t    ) -> dict:\n   285\t        from tiered_serve.compression.core.ublb_tbe import (\n   286\t            _empty_f32,\n   287\t            _u4_split_k,\n   288\t        )\n   289\t\n   290\t        # CD3's TileN=128 kernel carries substantially more decode state than\n   291\t        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n   292\t        # it increases both WGMMA work and CD3 shared-memory pressure.\n   293\t        # Hopper WGMMA supports standard 64x{16,32} shapes.  Preserve the\n   294\t        # existing 64-wide path at N>32, but avoid doing 2-4x excess activation\n   295\t        # work in the latency-critical small-token regime.\n   296\t        if N <= 16:\n   297\t            n_pad = 16\n   298\t        elif N <= 32:\n   299\t            n_pad = 32\n   300\t        elif N <= 48:\n   301\t            n_pad = 48\n   302\t        else:\n   303\t            n_pad = ((N + 63) // 64) * 64\n   304\t        # Split-K is tuned per TileN regime after the reduced-shared-memory\n   305\t        # kernels raised TileN64/128 residency to five/four CTAs.  Split-4 wins\n   306\t        # throughout N<=64; at N=128 only GateUp's large grid stays unsplit.\n   307\t        if n_pad <= 32:\n   308\t            # The smaller B tile and single exception map allow enough\n   309\t            # resident CTAs that split-4 wins for every production projection.\n   310\t            split_k = 4\n   311\t        elif n_pad <= 64:\n   312\t            split_k = {\n   313\t                (10240, 8192): 4,\n   314\t                (8192, 8192): 4,\n   315\t                (57344, 8192): 4,\n   316\t                (8192, 28672): 4,\n   317\t            }.get((M, K), _u4_split_k(M, n_pad, K))\n   318\t        elif n_pad == 128:\n   319\t            split_k = {\n   320\t                (10240, 8192): 4,\n   321\t                (8192, 8192): 4,\n   322\t                (57344, 8192): 1,\n   323\t                (8192, 28672): 4,\n   324\t            }.get((M, K), 1)\n   325\t        elif n_pad in (192, 256):\n   326\t            split_k = 4 if (M, K) == (10240, 8192) else 1\n   327\t        else:\n   328\t            split_k = 1\n   329\t        output = torch.empty(\n   330\t            n_pad, M, dtype=torch.bfloat16, device=device)\n   331\t        padded_input = torch.empty(\n   332\t            n_pad, K, dtype=torch.bfloat16, device=device)\n   333\t        partials = (\n   334\t            torch.empty(\n   335\t                split_k, n_pad, M, dtype=torch.float32, device=device)\n   336\t            if split_k > 1\n   337\t            else _empty_f32(device)\n   338\t        )\n   339\t        return {\n   340\t            \"key\": (M, K, N, device.index),\n   341\t            \"n_pad\": n_pad,\n   342\t            \"split_k\": split_k,\n   343\t            \"output\": output,\n   344\t            \"padded_input\": padded_input,\n   345\t            \"partials\": partials,\n   346\t        }\n   347\t\n   348\t    def alloc_fused_scratch(\n   349\t        self,\n   350\t        K: int,\n   351\t        M: int,\n   352\t        N: int,\n   353\t        dtype: torch.dtype,\n   354\t        device: torch.device,\n   355\t    ):\n   356\t        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n   357\t                or M % 64 or K % 64 or N <= 0):\n   358\t            return None\n   359\t        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n   360\t\n   361\t    def _linear_apply_impl(\n   362\t        self,\n   363\t        comp: CompressedChunkDelta3Tensor,\n   364\t        x: torch.Tensor,\n   365\t        scratch: Optional[dict],\n   366\t        wdecomp_events=None,\n   367\t    ) -> torch.Tensor:\n   368\t        import torch.nn.functional as F\n   369\t\n   370\t        M, K = int(comp.M), int(comp.K)\n   371\t        original_shape = x.shape\n   372\t        x2 = x.reshape(-1, K)\n   373\t        N = int(x2.shape[0])\n   374\t        use_fused = (\n   375\t            M % 64 == 0\n   376\t            and K % 64 == 0\n   377\t            and 0 < N <= self._fused_max_n_for(M, K)\n   378\t            and x2.dtype == torch.bfloat16\n   379\t            and x2.is_cuda\n   380\t            and comp._c.codes.is_cuda\n   381\t        )\n   382\t        if not use_fused:\n   383\t            wb, we = wdecomp_events if wdecomp_events else (None, None)\n   384\t            if wb is not None:\n   385\t    