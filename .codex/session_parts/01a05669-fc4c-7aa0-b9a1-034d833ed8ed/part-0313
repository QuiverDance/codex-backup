\t            self._kv_active_count[layer_id] = slot + 1\n   419\t        slot_table[bid] = slot\n   420\t        self._kv_slot_block[layer_id][slot] = bid\n   421\t        self._invalidate_decode_plan(layer_id)\n   422\t        return slot\n   423\t\n   424\t    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n   425\t        table = self._kv_slot_np.get(layer_id)\n   426\t        if table is None or not 0 <= bid < table.size:\n   427\t            return -1\n   428\t        return int(table[bid])\n   429\t\n   430\t    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n   431\t        table = self._kv_slot_np.get(layer_id)\n   432\t        if table is None or not 0 <= block_id < table.size:\n   433\t            return\n   434\t        slot = int(table[block_id])\n   435\t        if slot < 0:\n   436\t            return\n   437\t        self._invalidate_decode_plan(layer_id)\n   438\t        table[block_id] = -1\n   439\t        self._kv_slot_block[layer_id][slot] = -1\n   440\t        free_set = self._kv_free_slots[layer_id]\n   441\t        hwm = self._kv_active_count[layer_id]\n   442\t        if slot == hwm - 1:\n   443\t            hwm -= 1\n   444\t            while hwm - 1 in free_set:\n   445\t                free_set.discard(hwm - 1)\n   446\t                hwm -= 1\n   447\t            self._kv_active_count[layer_id] = hwm\n   448\t        else:\n   449\t            free_set.add(slot)\n   450\t            heapq.heappush(self._kv_free_heap[layer_id], slot)\n   451\t\n   452\t    @staticmethod\n   453\t    def _slot_runs(slots: list[int]):\n   454\t        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n   455\t        if not slots:\n   456\t            return\n   457\t        row_begin = 0\n   458\t        slot_begin = slots[0]\n   459\t        previous = slot_begin\n   460\t        for row in range(1, len(slots)):\n   461\t            slot = slots[row]\n   462\t            if slot != previous + 1:\n   463\t                yield row_begin, row, slot_begin\n   464\t                row_begin = row\n   465\t                slot_begin = slot\n   466\t            previous = slot\n   467\t        yield row_begin, len(slots), slot_begin\n   468\t\n   469\t    def _batch_h2d(self, destinations: list[torch.Tensor],\n   470\t                   sources: list[torch.Tensor],\n   471\t                   stream: torch.cuda.Stream | None = None) -> None:\n   472\t        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n   473\t        if not destinations:\n   474\t            return\n   475\t        if len(destinations) == 1:\n   476\t            if stream is None:\n   477\t                destinations[0].copy_(sources[0], non_blocking=True)\n   478\t            else:\n   479\t                with torch.cuda.stream(stream):\n   480\t                    destinations[0].copy_(sources[0], non_blocking=True)\n   481\t            return\n   482\t        extension = self._batch_ext\n   483\t        if extension is None:\n   484\t            try:\n   485\t                from tiered_serve.cpp_exts import zipserv_ext as extension\n   486\t            except Exception:\n   487\t                extension = False\n   488\t            self._batch_ext = extension\n   489\t        if extension and hasattr(extension, \"batch_memcpy\"):\n   490\t            extension.batch_memcpy(\n   491\t                destinations, sources,\n   492\t                (torch.cuda.current_stream().cuda_stream\n   493\t                 if stream is None else stream.cuda_stream))\n   494\t        else:\n   495\t            if stream is None:\n   496\t                torch._foreach_copy_(\n   497\t                    destinations, sources, non_blocking=True)\n   498\t            else:\n   499\t                with torch.cuda.stream(stream):\n   500\t                    torch._foreach_copy_(\n   501\t                        destinations, sources, non_blocking=True)\n   502\t\n   503\t    def _launch