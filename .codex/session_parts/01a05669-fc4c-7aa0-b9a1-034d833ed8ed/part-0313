\n   345\t            for event in self._kv_decode_begin:\n   346\t                event.record(self.batch_decomp_stream)\n   347\t        self._kv_pools_ready = True\n   348\t\n   349\t        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n   350\t        logger.info(\n   351\t            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n   352\t            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n   353\t            \"max_blocks=%d layers=%d\",\n   354\t            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n   355\t            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n   356\t\n   357\t    def _move_host_slot(self, layer_id: int,\n   358\t                        dst_slot: int, src_slot: int) -> None:\n   359\t        if dst_slot == src_slot:\n   360\t            return\n   361\t        for kv in (\"k\", \"v\"):\n   362\t            pool = self._host_pools[layer_id][kv]\n   363\t            pool[\"blob\"][dst_slot].copy_(pool[\"blob\"][src_slot])\n   364\t\n   365\t    def _invalidate_decode_plan(self, layer_id: int) -> None:\n   366\t        self._decode_generation[layer_id] = (\n   367\t            self._decode_generation.get(layer_id, 0) + 1)\n   368\t        self._decode_filtered.pop(layer_id, None)\n   369\t        self._decode_plans.pop(layer_id, None)\n   370\t\n   371\t    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\n   372\t        \"\"\"Publish the canonical active set once for the upcoming forward.\n   373\t\n   374\t        ``torch_hooks.before_model_forward`` already materializes a sorted\n   375\t        int64 NumPy array and its corresponding Python list once per step.\n   376\t        Holding both references lets every layer replace an O(N) content\n   377\t        comparison with an identity + integer-version check.  Direct users\n   378\t        that do not call this method continue through the original defensive\n   379\t        filter/content-c