   Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n        c_best = min(c_best, time.perf_counter() - t0)\n    comp_bytes = int(comp.total_compressed_size)\n\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\n\n    def _decomp_into():\n        return comp_obj.decompress(comp, out)\n\n    def _decomp_alloc():\n        return comp_obj.decompress(comp)\n\n    try:\n        dec = _decomp_into()\n        decomp = _decomp_into\n    except Exception:\n        dec = _decomp_alloc()\n        decomp = _decomp_alloc\n    for _ in range(warmup - 1):\n        dec = decomp()\n    torch.cuda.synchronize()\n\n    d_best = float(\"inf\")\n    for _ in range(runs):\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        dec = decomp()\n        torch.cuda.synchronize()\n        d_best = min(d_best, time.perf_counter() - t0)\n\n    ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatt