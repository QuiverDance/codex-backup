          os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n            for candidate in candidates:\n                try:\n                    lib = ctypes.CDLL(candidate)\n                    break\n                except OSError:\n                    continue\n            if lib is None:\n                try:\n                    lib = ctypes.CDLL(\"libcudart.so\")\n                except OSError:\n                    lib = False\n            _cudart_lib = lib\n                free_set.discard(high_water - 1)\n                high_water -= 1\n            self._kv_active_count[layer_id] = high_water\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get(\"buffer_ids\", ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64))\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_table = self._kv_slot_np.get(layer_id)\n                if slot_table is None or not 0 <= block_id < slot_table.size:\n                    return\n                slot = int(slot_table[block_id])\n                if slot < 0:\n                    return\n                self._invalidate_decode_plan(layer_id)\n                slot_table[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n            self._free_kv_slot(layer_id, block_id)\n\n    def compress_batch_async_from_host(\n        self,\n        layer_id: int,\n        block_ids: list,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        wait_event_handle: int = 0,\n    ) -> None:\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        num_source_blocks = host_k.shape[0]\n        block_array = np.asarray(block_ids, dtype=np.int64)\n        if block_array.size:\n            block_array = block_array[\n                (block_array >= 0) & (block_array < num_source_blocks)]\n        if block_array.size == 0:\n            return\n        decode_event_handle = int(\n            self._kv_dec_h2d[layer_id].cuda_event)\n        with self._slot_state_lock:\n            slots = self._assign_kv_slots(layer_id, block_array)\n            valid = self._persistent_valid[layer_id]\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\n            self._invalidate_decode_plan(layer_id)\n            state = self._worker_state_for_layer(layer_id)\n            state[\"error\"] = None\n            state[\"done\"].clear()\n            pending = {\n                \"state\": state,\n                \"buffer_ids\": block_array,\n                \"physical_slots\": slots,\n            }\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_queue.put((\n                    state,\n                    (layer_id, host_k, host_v, block_array, slots,\n                     int(wait_event_handle), decode_event_handle),\n                ))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state[\"done\"].set()\n                raise\n\n    def _encode_chunk(\n        self,\n        layer_id: int,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        block_ids: np.ndarray,\n        slots: np.ndarray,\n        raw_event_handle: int,\n        decode_event_handle: int,\n    ) -> None:\n        self._pin_worker_thread()\n        start = time.perf_counter()\n        _sync_cuda_event(raw_event_handle)\n        raw_ready = time.perf_counter()\n        _sync_cuda_event(decode_event_handle)\n        encode_start = time.perf_counter()\n        # A 56-thread team is counterproductive when only 8-64 fresh blocks\n        # exist (the normal serving case).  Shrink the team for small calls;\n        # default eight-worker serving already clamps each worker to seven\n        # CPUs, so this mainly fixes explicit workers=1 deployments.\n        worker_index = int(getattr(self._pin_tls, \"index\", 0))\n        maximum_threads = self._worker_omp_threads.get(\n            worker_index, self._omp_thread_cap)\n        block_count = int(block_ids.size)\n        if block_count <= 8:\n            omp_threads = min(maximum_threads, 8)\n        elif block_count <= 64:\n            omp_threads = min(maximum_threads, 16)\n        elif block_count <= 256:\n            omp_threads = min(maximum_threads, 32)\n        else:\n            omp_threads = maximum_threads\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(max(1, omp_threads)))\n        block_tensor = torch.from_numpy(block_ids)\n        slot_tensor = torch.from_numpy(slots)\n        for source, kv in ((host_k, \"k\"), (host_v, \"v\")):\n            pool = self._host_pools[layer_id][kv]\n            _cd3_ext.host_encode_chunk_delta3_blocks(\n                source.view(torch.int16), block_tensor, slot_tensor,\n                pool[\"codes\"], pool[\"sign_mantissa\"],\n                pool[\"thread_bases\"], pool[\"tile_exception_offsets\"],\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                self._M_b, self._K_b,\n            )\n        finish = time.perf_counter()\n        with self._pin_lock:\n            self._timing_raw_wait += raw_ready - start\n            self._timing_decode_wait += encode_start - raw_ready\n            self._timing_encode += finish - encode_start\n            self._timing_count += 1\n            if self._timing_count >= 2000:\n                count = self._timing_count\n                logger.warning(\n                    \"[cd3-kv-compress] per-call: raw-D2H wait %.2f ms | \"\n                    \"decode wait %.2f ms | encode %.2f ms | %d calls\",\n                    self._timing_raw_wait / count * 1e3,\n                    self._timing_decode_wait / count * 1e3,\n                    self._timing_encode / count * 1e3, count)\n                self._timing_raw_wait = 0.0\n                self._timing_decode_wait = 0.0\n                self._timing_encode = 0.0\n                self._timing_count = 0\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        with self._slot_state_lock:\n            pending = self._pending_compress.get(layer_id)\n        buffer_ids = []\n        if pending is not None:\n            worker_retired = False\n            try:\n                self._wait_worker_state(pending[\"state\"], timeout_sec)\n                worker_retired = True\n                slots = np.asarray(\n                    pending[\"physical_slots\"], dtype=np.int64)\n                for kv in (\"k\", \"v\"):\n                    counts = self._host_pools[\n                        layer_id][kv][\"num_exceptions\"].numpy()[slots]\n                    overflow = np.flatnonzero(counts > self._entry_capacity)\n                    if overflow.size:\n                        index = int(overflow[0])\n                        raise RuntimeError(\n                            \"ChunkDelta3 KV exception capacity exceeded: \"\n                            f\"layer={layer_id} kv={kv} \"\n                            f\"block={int(pending['buffer_ids'][index])} \"\n                            f\"count={int(counts[index])} \"\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            else:  # zipserv\n                self.kv_compressor = ZipServCompressor(self.decomp_kv_stream)\n                logger.info(\n                    \"KV compressor: ZipServ (CPU encode, C++ worker pool, \"\n                    \"cpu_after_raw_swap)\")\n            DualMemoryLoader._kv_compressor_ref = self.kv_compressor\n            if DualMemoryLoader.kv_full_block_only:\n                # Every encode target is now structurally complete. Do not\n                # collect per-step occupancy or emit partial-tile blobs.\n                self.kv_compressor._occupancy_enabled = False\n                self.kv_compressor._block_valid_tokens = None\n                logger.info(\n                    \"[kv-full-block] ENABLED backend=%s: partial tails stay \"\n                    \"in HBM; encode targets are always 16-token blocks\",\n                    kv_comp_backend)\n\n            # Wire the KV-load stream into the compressor so the compressed-blob\n            # H2D runs on it (double-buffered with the decode on\n            # batch_decomp_stream).\n            #\n            # H2D-ON-WEIGHT-STREAM (default ON): the single GH200 copy engine is\n            # shared by weight H2D and KV H2D.  With the KV H2D on its OWN stream\n            # (load_kv_stream) the engine — favouring load_weight_stream —\n            # services the queued/prefetched weight transfers BEFORE the KV one,\n            # so the KV op's _kv_h2d_begin.._kv_dec_h2d interval (CUDA events\n            # fire at queue position, not transfer start) absorbs ~0.8 ms/layer\n            # of weight transfer → KVLoad reads ~4x the true transfer (80 vs\n            # 18 ms, batch 64).  Aliasing load_kv_stream to load_weight_stream\n            # puts the KV blob H2D in the engine's serial program order right\n            # after the QKV weight — the user's \"comp QKV → comp KVs → comp\n            # Gateup → comp Down\" pipeline — so the engine runs it in its own\n            # slot and KVLoad measures only the ~0.29 ms/layer transfer (23 ms).\n            # This used to cost +53 ms TPOT (weights queued behind the KV stalled\n            # when the KV waited), but that stall was the REDUNDANT kv-unload gate\n            # (skipped for kvcomp in the wrapper — see TIERED_SERVE_KV_UNLOAD_GATE);\n            # with it gone, serial is BOTH clean (23 ms) AND fast (211 ms = the\n            # separate-stream throughput).  Set =0 to fall back to the separate\n            # load_kv_stream (inflated KVLoad).\n            # Alias HERE for COMPRESSED blob H2D only.  ``raw_load_kv_stream``\n            # retains the construction-time dedicated stream for the default\n            # mixed/prefill raw-secondary route.  Compressed decode skips the\n            # raw load-stream unload gate, so no KV-dependent wait sits ahead of\n            # weight prefetch on this shared stream.\n            if os.getenv(\"TIERED_SERVE_KV_H2D_ON_WEIGHT\", \"1\") == \"1\":\n                self.load_kv_stream = self.load_weight_stream\n            if hasattr(self.kv_compressor, \"load_kv_stream\"):\n                self.kv_compressor.load_kv_stream = self.load_kv_stream\n                logger.info(\n                    \"[kv-decode] blob H2D on %s \"\n                    \"(2-slot double-buffer, decode on batch_decomp_stream)\",\n                    \"load_weight_stream (serial w/ weights, no engine \"\n                    \"contention)\"\n                    if self.load_kv_stream is self.load_weight_stream\n                    else \"load_kv_stream\")\n            if self.raw_load_kv_stream is not self.load_kv_stream:\n                logger.info(\n                    \"[kv-prefill] raw secondary H2D on dedicated \"\n                    \"load_kv_stream (isolated from weight prefetch)\")\n\n            logger.info(\n                \"KV compression producer mode: %s (backend=%s)\",\n                kv_comp_producer, kv_comp_backend)\n            if (kv_comp_backend == \"p4flat\"\n                    and kv_comp_producer == \"cpu_after_raw_swap\"\n                    and os.getenv(\"TIERED_SERVE_KV_COMP_PRODUCER\") is None):\n                logger.info(\n                    \"  (p4flat auto-switched to CPU encode: weight comp is \"\n                    \"active, avoiding GPU compress-kernel SM contention; set \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=gpu_direct to force GPU)\")\n\n        # ── RAW KV: alias load_kv_stream onto load_weight_stream (OPT-IN) ──\n        # Goal: put the raw KV H2D in the single GH200 copy engine's serial\n        # program order after the QKV weight (own slot → clean\n        # begin/end_memcpy_kv bracket) instead of on a separate stream where the\n        # engine services the prefetched weight first and the KV bracket absorbs\n        # it (WLoad+KVLoad>GPUFwd, the cao-p4 artifact).\n        #\n        # OFF BY DEFAULT — it cleans the bracket but REGRESSES TPOT +25–31%\n        # (A/B cao-p4 b1..128: 169→210, 177→233, 204→269, 261→342).  Aliasing\n        # serialises the KV onto the weight stream, where the KV's WAR gate\n        # ``load_kv_stream.wait_event(unloaded_kv[L-1])`` chains to unload(L-1) →\n        # attention(L-1); the weight prefetch queued behind it on the shared\n        # stream is then pinned to the attention frontier → the depth-2\n        # frozen-weight prefetch collapses to ~depth-1 (= the documented\n        # ~48 ms/step all-frozen-split stall).  Same failure as the abandoned\n        # _h2d_serial gate.  The old \"+95 ms\" warning was real.\n        #\n        # The real fix (TODO) is to BREAK the load↔unload↔attention coupling so\n        # the KV load no longer waits attention: e.g. copy the new-token tail\n        # aside to a small staging buffer right after reshape_and_cache (early in\n        # the layer), unload D2H from that staging asynchronously, and let\n        # load(L+1) wait only that early tiny D2D — then aliasing is execution-\n        # neutral and this can default ON.  Until then, opt-in for measurement.\n        if (os.getenv(\"TIERED_SERVE_RAW_KV_ALIAS\", \"0\") == \"1\"\n                and not DualMemoryLoader.use_kv_comp\n                and os.getenv(\"TIERED_SERVE_KV_H2D_ON_WEIGHT\", \"1\") == \"1\"\n                and os.getenv(\"TIERED_SERVE_KV_DOUBLE_BUFFER\", \"1\") == \"1\"\n                and self.n_layers % 2 == 0):\n            self.load_kv_stream = self.load_weight_stream\n            logger.info(\n                \"[kv-decode] RAW KV H2D aliased onto load_weight_stream \"\n                \"(opt-in; clean bracket but +25-31%% TPOT until tail-staging \"\n                \"decouple lands)\")\n\n        # Single timing flag: TIERED_SERVE_COLLECT_TIME enables both per-step\n        # CUDA-event collection AND the aggregated Exec/Load/Stall breakdown\n        # summary in calc_times() (they were two separate vars; unified).\n        self.collect_times = (os.getenv(\"TIERED_SERVE_COLLECT_TIME\", \"0\") == \"1\")\n        self.time_breakdown = self.collect_times\n        # Propagate to the KV compressor so it skips breakdown-only event\n        # records (per-step CUDA event record() was ~12% of forward CPU).\n        if getattr(self, \"kv_compressor\", None) is not None:\n            self.kv_compressor._tb = self.time_breakdown\n        self.kv_decode_load_backend = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_LOAD\", \"compressed\").lower()\n        if self.kv_decode_load_backend not in (\"compressed\", \"raw\"):\n            raise ValueError(\n                f\"Unknown TIERED_SERVE_KV_DECODE_LOAD: \"\n                f\"{self.kv_decode_load_backend!r}. Expected 'compressed' \"\n                \"or 'raw'.\")\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV decode load backend: %s\",\n                self.kv_decode_load_backend)\n        _prefill_comp_requested = (\n            os.getenv(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n            # tile_offsets_* are HBM-resident (info.hbm_buffers), exact\n            # size — they are not part of src_bufs / the per-decode H2D.\n            # When sign_mantissa is the canonical (M,K) row-major form, pass it\n            # as canonical_sm — the kernel reads HF sm there (no compacted SM\n            # staging). info.sign_mantissa is the same buffer in that case.\n            _canon = (info.sign_mantissa\n                      if getattr(info, \"_uses_canonical_sm\", False) else None)\n            backend_compressor._ext.decompress(\n                info.sign_mantissa,\n                src_bufs[\"compressed_full\"].narrow(0, 0, ln[\"compressed_full\"]),\n                src_bufs[\"bitmap1\"].narrow(0, 0, ln[\"bitmap1\"]),\n                src_bufs[\"bitmap2\"].narrow(0, 0, ln[\"bitmap2\"]),\n                src_bufs[\"bitmap3\"].narrow(0, 0, ln[\"bitmap3\"]),\n                info.hbm_buffers[\"tile_offsets_median\"],\n                info.hbm_buffers[\"tile_offsets_global\"],\n                info.max_high_freq_count,\n                info.max_full_count,\n                info.start_exp,\n                output,\n                info.M, info.K,\n                gt_m_base, num_row_tiles,\n                _canon)\n\n    def _ensure_prefill_war_events(self):\n        \"\"\"Lazily allocate per-(comp, parity) WAR events for the prefill\n        raw_bf16 path.\n\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\n        2*M*K H2D into the primary buffer moves OFF exec onto\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\n        GEMMs instead of serialising on exec, since\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\n        a cross-stream resource shared across parity-PARITY layers, so the\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\n        has finished reading it.  One event per (comp, parity); pre-recorded\n        so the first PARITY layers (fresh buffers) never block on a\n        never-recorded event.\n        \"\"\"\n        if getattr(self, \"_prefill_war_events\", None) is not None:\n            return\n        self._prefill_war_events = {\n            comp_key: [torch.cuda.Event(external=True)\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n        }\n        for events in self._prefill_war_events.values():\n            for ev in events:\n                ev.record()  # pre-signal\n\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\n                                          info, skip_kernel: bool = False,\n                                          h2d_ctx_held: bool = False,\n                                          collect_into=None\n                                          ) -> None:\n        \"\"\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\n        staging then backend-specific decompress + reconstruct.  The fused\n        H2D-only caller may hold ``load_weight_stream``; dense paths hold\n        ``decomp_weight_stream``.\n\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_s