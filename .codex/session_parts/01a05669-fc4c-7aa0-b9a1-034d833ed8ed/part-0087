n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, bitcomp, bitcompcpu) (backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent split: sm stays in HBM, exp is\n                # ANS-compressed and persisted in LPDDR (see\n                # tiered_serve/mantexp_kv_compressor.py).\n                if not self.mantexp_split_kv:\n                    logger.warning(\n                        \"KV backend 'mantexp' selected without \"\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n                #                         host_encode_blocks)\n                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n                # follows the producer mode (defaults to gpu_direct).\n                # See tiered_serve/p4flat_kv_compressor.py.\n                from tiered_serve.p4flat_kv_compressor import (\n                    P4FlatCPUKVCompressor,\n                    P4FlatKVCompressor,\n                )\n                if (kv_comp_backend == \"p4flatcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = P4FlatCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: P4Flat (CPU encode, \"\n                        \"C++ OpenMP host_encode_blocks)\")\n                else:\n                    self.kv_compressor = P4FlatKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n                #                         nvcomp_bitcomp_compress_batch)\n                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n                #                         compress, bitcompHostCompressLossless)\n                # ``bitcompcpu`` always selects the CPU encoder; bare\n                # ``bitcomp`` follows the producer mode (defaults to gpu_direct).\n                from tiered_serve.bitcomp_kv_compressor import (\n                    BitcompCPUKVCompressor,\n                    BitcompKVCompressor,\n    os.environ[\n        \"TIERED_SERVE_USE_WEIGHT_COMP\"] = \"1\" if weight_comp_requested else \"0\"\n    if args.weight_comp:\n        os.environ[\"TIERED_SERVE_WEIGHT_COMP_BACKEND\"] = args.weight_comp\n    if args.split_compressor:\n        os.environ[\"TIERED_SERVE_SPLIT_COMP_BACKEND\"] = args.split_compressor\n    if args.offload_compressor:\n        os.environ[\"TIERED_SERVE_OFFLOAD_COMP_BACKEND\"] = args.offload_compressor\n    if args.prefill_alt_comp is not None:\n        os.environ[\"TIERED_SERVE_PREFILL_ALT_BACKEND\"] = args.prefill_alt_comp\n    if args.prefill_alt_max_chunk is not None:\n        os.environ[\"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK\"] = args.prefill_alt_max_chunk\n    if args.offload_prefill_max_chunk is not None:\n        os.environ[\"TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK\"] = args.offload_prefill_max_chunk\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_FROZEN\"] = (\n        \"1\" if args.ats_decomp_frozen else \"0\")\n    os.environ[\"TIERED_SERVE_USE_FUSED_MM\"] = (\n        \"1\" if args.fused_mm else \"0\")\n    # NEVER reuse a c