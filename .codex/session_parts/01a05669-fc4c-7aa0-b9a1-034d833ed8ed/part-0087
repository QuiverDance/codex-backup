# directly were dealing with offload/frozen_compressed paths; we\n            # alias to the offload compressor so they keep behaving the\n            # same when the user supplies only the base flag.\n            self.weight_compressor = self._compressor_offload\n\n        env_var_value = os.getenv(\"TIERED_SERVE_USE_KV_COMP\")\n        use_kv_comp = env_var_value is not None and env_var_value == \"1\"\n        DualMemoryLoader.no_offload_kv = (\n            os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n        if DualMemoryLoader.no_offload_kv:\n            # KV stays fully resident in GPU HBM: disable offload + KV\n            # compression entirely (weights are still offloaded).\n            use_kv_comp = False\n        DualMemoryLoader.use_kv_comp = use_kv_comp\n        DualMemoryLoader.kv_full_block_only = False\n\n        self.kv_compressor = None\n        if DualMemoryLoader.use_kv_comp:\n            kv_comp_backend = os.getenv(\n                \"TIERED_SERVE_KV_COMP_BACKEND\", \"zipserv\").lower()\n            if kv_comp_backend not in (\n                    \"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\", \"p4flatcpu\",\n                    \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_BACKEND: \"\n                    f\"{kv_comp_backend!r}. Expected one of: \"\n                    f\"zipserv, dietgpu, mantexp, p4flat, p4flatcpu, \"\n                    f\"bitcomp, bitcompcpu, ublb_flat, ublb_tbe.\")\n\n            _full_block_only = (\n                os.getenv(\n                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\")\n            if _full_block_only and kv_comp_backend not in (\n                    \"p4flat\", \"p4flatcpu\"):\n                raise ValueError(\n                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY=1 currently requires \"\n                    \"the p4flat or p4flatcpu KV backend; got \"\n                    f\"{kv_comp_backend!r}\")\n            DualMemoryLoader.kv_full_block_only = _full_block_only\n\n            # ── KV compression producer mode ──\n            # Selects how the compressed KV copy is produced during unload.\n            # Both modes always store raw KV in LPDDR secondary so that\n            # prefill-containing phases load uncompressed without paying\n            # decompression latency.  Resolved *before* the backend is\n            # instantiated because p4flat picks its encode implementation\n            # (GPU vs CPU) from the producer mode below.\n            #\n            #   gpu_direct:\n            #       Backend's existing pipeline produces compressed KV on GPU\n            #       (DietGPU/MantExp/p4flat run compress kernels on\n            #       comp_stream).  Raw secondary unload runs in parallel.\n            #\n            #   cpu_after_raw_swap:\n            #       Avoid GPU compression entirely.  Raw KV is D2H'd to\n            #       LPDDR secondary first, then a CPU compressor reads\n            #       directly from secondary_kv (no extra D2H) and writes\n            #       into the persistent compressed host pool.  Supported only\n            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n            #       manager) and p4flat (Python worker pool).\n            # Default is backend-aware.  ZipServ is CPU-encode only in the\n            # serving path: raw KV is first swapped to secondary_kv and its C++\n            # worker manager compresses directly from that host tensor.  This\n            # is also enforced below so an inherited producer env cannot route\n            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n            # host_encode_blocks) variant of the p4flat codec — it always uses\n            # the cpu_after_raw_swap producer, re