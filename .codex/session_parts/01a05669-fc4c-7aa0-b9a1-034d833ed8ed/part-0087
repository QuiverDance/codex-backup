ht 25,600-byte default and their encoders\n        # publish is_raw=2 for an over-stride block.  An explicit\n        # TIERED_SERVE_KV_BLOB_STRIDE (0 selects raw-safe) still overrides it.\n    # Unified timing flag: COLLECT_TIME enables both event collection and the\n    # aggregated breakdown summary.  --collect-time and --time-breakdown both\n    # just turn it on.\n    collect_time = args.collect_time or args.time_breakdown\n    os.environ[\"TIERED_SERVE_COLLECT_TIME\"] = \"1\" if collect_time else \"0\"\n\n    engine_type = \"ts\"\n    if weight_comp_requested:\n        engine_type += \"_wc\"\n    if args.kv_comp:\n        engine_type += \"_kvc\"\n    if collect_time:\n        engine_type += \"_time\"\n    if args.time_breakdown:\n        engine_type += \"_brk\"\n\n    os.environ[\n        \"TIERED_SERVE_ENGINE_ID\"] = f\"{engine_type}_{model_id}\"\n\n    logger = logging.getLogger(\"vllm\")\n    logger.setLevel(log_level)\n    # NOTE: vLLM already attaches a formatted StreamHandler (the\n    # \"INFO <date> [file:line] ...\" console line) to the \"vllm\" logger at\n    # import time.  Adding a second, plain StreamHandler here printed every\n    # record twice on the console (once formatted, once bare).  The\n    # FileHandler below is the only extra sink we need.\n","stderr":"","aggregated_output":"        source.options().dtype(at::kShort));\n    compressed.entries17 = torch::empty(\n        {(compressed.num_exceptions * 17 + 7) / 8}, byte_options);\n    auto temporary_positions = torch::empty(\n        {compressed.num_exceptions}, source.options().dtype(at::kShort));\n    auto temporary_exponents = torch::empty(\n        {compressed.num_exceptions}, byte_options);\n    check_cuda_error(\n        TP3_BuildEntries(\n            current_stream(),\n            reinterpret_cast<const uint16_t*>(source.data_ptr()),\n            compressed.codes.data_ptr<uint8_t>(),\n            compressed.tile_exception_offsets.data_ptr<int32_t>(),\n            reinterpret_cast<uint16_t*>(\n                compressed.warp_prefixes.data_ptr<int16_t>()),\n            reinterpret_cast<uint16_t*>(\n                temporary_positions.data_ptr<int16_t>()),\n            temporary_exponents.data_ptr<uint8_t>(),\n            compressed.entries17.data_ptr<uint8_t>(),\n            compressed.num_exceptions,\n            static_cast<int>(num_tiles), static_cast<int>(columns)),\n        \"TP3_BuildEntries\");\n    compressed.M = rows;\n    compressed.K = columns;\n    return compressed;\n}\n\nCompressedChunkDelta3 compress_chunk_delta3(torch::Tensor source)\n{\n    check_source(source);\n    const c10::cuda::CUDAGuard device_guard(source.device());\n    const int64_t rows = source.size(0);\n    const int64_t columns = source.size(1);\n    const int64_t num_tiles =\n        (rows / kTileDim) * (columns / kTileDim);\n    const auto byte_options = source.options().dtype(at::kByte);\n    const auto int_options = source.options().dtype(at::kInt);\n\n    CompressedChunkDelta3 compressed;\n    compressed.codes = torch::empty(\n        {num_tiles * kCodeBytesPerTile}, byte_options);\n    compressed.thread_bases = torch::empty(\n        {num_tiles * kThreads}, byte_options);\n    compressed.sign_mantissa = torch::empty(\n        {num_tiles * kTileElements}, byte_options);\n    auto tile_counts = torch::empty({num_tiles}, int_options);\n    check_cuda_error(\n        CD3_CompressPass1(\n            current_stream(),\n            reinterpret_cast<const uint16_t*>(source.data_ptr()),\n            compressed.codes.data_ptr<uint8_t>(),\n            compressed.thread_bases.data_ptr<uint8_t>(),\n            compressed.sign_mantissa.data_ptr<uint8_t>(),\n            tile_counts.data_ptr<int32_t>(),\n            static_cast<int>(num_tiles), static_cast<int>(columns)),\n        \"CD3_CompressPass1\");\n\n    compressed.tile_exception_offsets =\n        build_exception_offsets(tile_counts);\n    compressed.num_exceptions =\n        read_num_exceptions(compressed.tile_exception_offsets);\n    compressed.entries20x3 = torch::empty(\n        {(compressed.num_exceptions + 2) / 3},\n        source.options().dtype(at::kLong));\n    auto temporary_entries20 = torch::empty(\n        {compressed.num_exceptions}, int_options);\n    check_cuda_error(\n        CD3_BuildEntries(\n            current_stream(),\n            reinterpret_cast<const uint16_t*>(source.data_ptr()),\n            compressed.thread_bases.data_ptr<uint8_t>(),\n            compressed.tile_exception_offsets.data_ptr<int32_t>(),\n            reinterpret_cast<uint32_t*>(\n                temporary_entries20.data_ptr<int32_t>()),\n            reinterpret_cast<uint64_t*>(\n                compressed.entries20x3.data_ptr<int64_t>()),\n            compressed.num_exceptions,\n            static_cast<int>(num_tiles), static_cast<int>(columns)),\n        \"CD3_BuildEntries\");\n    compressed.M = rows;\n    compressed.K = columns;\n    return compressed;\n}\n\nvoid check_tile_palette3(const CompressedTilePalette3& compressed)\n{\n    TORCH_CHECK(\n        compressed.M > 0 && compressed.K > 0\n            && compressed.M % kTileDim == 0\n            && compressed.K % kTileDim == 0,\n        \"invalid TilePalette3 shape\");\n    const int64_t num_tiles =\n        (compressed.M / kTileDim) * (compressed.K / kTileDim);\n    check_byte(compressed.palettes8, \"palettes8\");\n    check_byte(compressed.codes, \"codes\");\n    check_byte(compressed.sign_mantissa, \"sign_mantissa\");\n    check_int(compressed.tile_exception_offsets, \"tile_exception_offsets\");\n    check_short_storage(compressed.warp_prefixes, \"warp_prefixes\");\n    check_byte(compressed.entries17, \"entries17\");\n    TORCH_CHECK(compressed.palettes8.numel() == num_tiles * 8,\n                \"invalid palette size\");\n    TORCH_CHECK(compressed.codes.numel() == num_tiles * kCodeBytesPerTile,\n                \"invalid code size\");\n    TORCH_CHECK(compressed.sign_mantissa.numel() == compressed.M * compressed.K,\n                \"invalid sign/mantissa size\");\n    TORCH_CHECK(compressed.tile_exception_offsets.numel() == num_tiles + 1,\n                \"invalid exception offset size\");\n    TORCH_CHECK(compressed.warp_prefixes.numel() == num_tiles * kWarpsPerTile,\n                \"invalid warp prefix size\");\n    TORCH_CHECK(\n        compressed.entries17.numel()\n            == (compressed.num_exceptions * 17 + 7) / 8,\n        \"invalid exception entry size\");\n}\n\nvoid check_chunk_delta3(const CompressedChunkDelta3& compressed)\n{\n    TORCH_CHECK(\n        compressed.M > 0 && compressed.K > 0\n            && compressed.M % kTileDim == 0\n            && compressed.K % kTileDim == 0,\n        \"invalid ChunkDelta3 shape\");\n    const int64_t num_tiles =\n        (compressed.M / kTileDim) * (compressed.K / kTileDim);\n    check_byte(compressed.codes, \"codes\");\n    check_byte(compressed.sign_mantissa, \"sign_mantissa\");\n    check_byte(compressed.thread_bases, \"thread_bases\");\n    check_int(compressed.tile_exception_offsets, \"tile_exception_offsets\");\n    check_long(compressed.entries20x3, \"entries20x3\");\n    TORCH_CHECK(compressed.codes.numel() == num_tiles * kCodeBytesPerTile,\n                \"invalid code size\");\n    TORCH_CHECK(compressed.sign_mantissa.numel() == compressed.M * compressed.K,\n                \"invalid sign/mantissa size\");\n    TORCH_CHECK(compressed.thread_bases.numel() == num_tiles * kThreads,\n                \"invalid thread-base size\");\n    TORCH_CHECK(compressed.tile_exception_offsets.numel() == num_tiles + 1,\n        # threshold where the dispatch cost is amortised.\n        self._asm_pool = None\n        self._asm_nthreads = min(16, max(1, (os.cpu_count() or 8)))\n        self._asm_thread_thresh = 256\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        \"\"\"Worst-case host-pool bytes for one K (or one V) block.\n\n        Mirrors the per-block ``blob`` row stride reserved by\n        ``warmup_kv_buffers`` plus the per-block meta (``total_size`` /\n        ``exc_cnt`` / ``is_raw``).  A P4Flat block is stored either\n        compressed or — on raw fallback — as a full BF16 block, so the slot\n        is always reserved at ``align(raw_bytes, 128)`` (i.e. ~1x raw).\n\n        Use this from external callers (e.g. vLLM budget calculation) to\n        size the persistent compressed host pool without instantiating a\n        compressor.\n\n        Returns the byte size for ONE side (K or V).  Multiply by 2 for K+V.\n        \"\"\"\n        raw_bytes = block_elements * 2          # BF16\n        blob = _align(raw_bytes, 128)           # blob row stride\n        meta = 4 + 4 + 1                         # total_size + exc_cnt + is_raw\n        return blob + meta\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = in