     n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n  