_gpu_comp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_blocks + 1),\n        }\n        self._gpu_decomp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n        }\n\n        # Pinned sizes scratch for D2H of per-block compressed lengths.\n        self._sizes_pinned_k = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n        self._sizes_pinned_v = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n\n        # Pinned BF16 decompressed output (matching ZipServ's decomp output).\n        self._bf16_decomp_out = {\n            'k': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n            'v': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n        }\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._kv_slot = {\n            lid: torch.full((host_n,), -1, dtype=torch.int32)\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {\n            lid: [-1] * host_n for lid in range(n_layers)\n        }\n        self._kv_active_count = {\n            lid: 0 for lid in range(n_layers)\n        }\n\n        self._kv_pools_ready = True\n\n        host_bytes = 0\n        for layer_pools in self._host_pools.values():\n            for kv_pool in layer_pools.values():\n                for t in kv_pool.values():\n                    host_bytes += t.nbytes\n        gpu_bytes = 0\n        for p in list(self._gpu_comp_pool.values()) + list(\n                self._gpu_decomp_pool.values()):\n            for t in p.values():\n                gpu_bytes += t.nbytes\n        logger.info(\n            \"DietGPU KV buffers warmed up: block_shape=%s, block_numel=%d, \"\n            \"max_comp_size=%d, max_n_blocks=%d, max_gpu_comp=%d, \"\n            \"max_gpu_decomp=%d, n_layers=%d, host=%.1fMB, gpu_staging=%.1fMB\",\n            block_shape, block_numel, max_comp_size, max_n_blocks,\n            max_gpu_blocks, max_gpu_decomp_blocks, n_layers,\n            host_bytes / 1024**2, gpu_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  C++-style compress API (no-op worker pool, GPU-only compression)\n    # ------------------------------------------------------------------\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        \"\"\"No-op for DietGPU — compression runs synchronously on GPU.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n        logger.info(\n            \"DietGPU KV: skipping C++ worker init \"\n            \"(compression runs on GPU, n_workers=%d ignored)\", n_workers)\n\n    def stop_kv_compress_workers(self) -> None:\n        pass\n\n    def compress_batch_async(self, layer_id: int,\n                                 block_ids: list,\n                                 gpu_k: torch.Tensor,\n                                 gpu_v: torch.Tensor) -> None:\n        \"\"\"Launch async GPU compress + D2H for a layer's blocks.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async requires warmup_kv_buffers first\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(gpu_k.shape[1:]))\n        self._launch_compress(layer_id, block_ids, gpu_k, gpu_v)\n\n    def wait_compress_async(self, layer_id: int,\n                             block_shape: tuple,\n                             timeout_sec: float = -1.0) -> None:\n        \"\"\"Synchronise the launched compress/D2H and register persistent meta.\"\"\"\n        state = self._pending_compress.pop(layer_id, None)\n        if state is None:\n            return\n        event = state['event']\n        event.synchronize()\n\n        buffer_ids = state['buffer_ids']\n        physical_slots = state.get('physical_slots')\n        if physical_slots is None:\n            physical_slots = [\n                self._assign_kv_slot(layer_id, bid) for bid in buffer_ids\n            ]\n        n = len(buffer_ids)\n        if n == 0:\n            return\n        k_sizes_pinned = state['k_sizes_pinned']\n        v_sizes_pinned = state['v_sizes_pinned']\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        exp_sz_k = host_k['exp_sizes']\n        exp_sz_v = host_v['exp_sizes']\n        # Commit per-block exp sizes into host persistent metadata.\n        for i, slot in enumerate(physical_slots):\n            exp_sz_k[slot] = int(k_sizes_pinned[i].item())\n            exp_sz_v[slot] = int(v_sizes_pinned[i].item())\n\n        pv = self._persistent_valid[layer_id]\n        for bid in buffer_ids:\n            pv[bid] = 1\n\n        # Populate transient _compressed_kv for old-path compat\n        # (consumers pop this after their own use).\n        self._compressed_kv[layer_id] = {\n            'buffer_ids': list(buffer_ids),\n            'block_shape': block_shape,\n            'n': n,\n        }\n\n    # ------------------------------------------------------------------\n    #  Compress helpers\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        prev_slot = int(slot_tbl[bid].item())\n        if prev_slot >= 0:\n            return prev_slot\n\n        active = self._kv_active_count[layer_id]\n        if active >= len(self._kv_slot_block[layer_id]):\n            raise RuntimeError(\n                f\"DietGPU KV: persistent slot pool full for layer={layer_id}\")\n        slot_tbl[bid] = active\n        self._kv_slot_block[layer_id][active] = bid\n        self._kv_active_count[layer_id] = active + 1\n        return active\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        if not 0 <= bid < slot_tbl.numel():\n            return -1\n        return int(slot_tbl[bid].item())\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['comp_exp'][dst_slot].copy_(pool['comp_exp'][src_slot])\n            pool['exp_sizes'][dst_slot] = pool['exp_sizes'][src_slot]\n            if 'sm' in pool:\n                pool['sm'][dst_slot].copy_(pool['sm'][src_slot])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        slot_tbl = self._kv_slot.get(layer_id)\n        if slot_tbl is None or not 0 <= block_id < slot_tbl.numel():\n            return\n        slot = int(slot_tbl[block_id].item())\n        if slot < 0:\n            return\n\n        active = self._kv_active_count[layer_id]\n        if active <= 0:\n            slot_tbl[block_id] = -1\n            return\n\n        last_slot = active - 1\n        moved_bid = self._kv_slot_block[layer_id][last_slot]\n        if slot != last_slot and moved_bid >= 0:\n            self._move_host_slot(layer_id, slot, last_slot)\n            self._kv_slot_block[layer_id][slot] = moved_bid\n            slot_tbl[moved_bid] = slot\n        elif slot != last_slot:\n            self._kv_slot_block[layer_id][slot] = -1\n\n        self._kv_slot_block[layer_id][last_slot] = -1\n        self._kv_active_count[layer_id] = last_slot\n        slot_tbl[block_id] = -1\n\n    @staticmethod\n    def _extract_exp_sm(blocks_bf16: torch.Tensor,\n                        out_exp: torch.Tensor,\n                        out_sm: torch.Tensor) -> None:\n        \"\"\"Given a [N, numel] BF16 GPU tensor, write exp and sign|mantissa\n        uint8 representations into preallocated [N, numel] buffers.\"\"\"\n        # Bitcast view to uint16 so we can shift/mask.\n        u16 = blocks_bf16.view(torch.uint16)\n        i32 = u16.to(torch.int32)\n        exp = ((i32 >> 7) & 0xFF).to(torch.uint8)\n        sm = (((i32 >> 8) & 0x80) | (i32 & 0x7F)).to(torch.uint8)\n        out_exp.copy_(exp)\n        out_sm.copy_(sm)\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        \"\"\"Compress the given K/V blocks on GPU and D2H to host pools.\"\"\"\n        n = len(block_ids)\n        if n == 0:\n            return\n        num_primary = gpu_k.shape[0]\n        block_ids = [bid for bid in block_ids if 0 <= bid < num_primary]\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_blocks:\n            raise RuntimeError(\n                f\"DietGPU KV compress: n={n} exceeds max_gpu_blocks=\"\n                f\"{self._max_gpu_blocks}\")\n\n        comp_k = self._gpu_comp_pool['k']\n        comp_v = self._gpu_comp_pool['v']\n        B = self._block_numel\n\n        # GPU indices on device matching block_ids (int64 for indexing)\n        bid_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=gpu_k.device)\n        physical_slots = [\n            self._assign_kv_slot(layer_id, bid) for bid in block_ids\n        ]\n\n        with torch.cuda.stream(self.comp_stream):\n            # 1. Gather blocks and split into exp/sm\n            k_blocks = gpu_k[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            v_blocks = gpu_v[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            self._extract_exp_sm(k_blocks, comp_k['exp'][:n], comp_k['sm'][:n])\n            self._extract_exp_sm(v_blocks, comp_v['exp'][:n], comp_v['sm'][:n])\n\n            # 2. Batch compress exponents per block.\n            #    compress_data returns [N, max_out] contiguous tensor.\n            k_exp_list = list(comp_k['exp'][:n])\n            v_exp_list = list(comp_v['exp'][:n])\n            k_comp_out, k_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, k_exp_list, False, self._workspace,\n                comp_k['comp_exp'][:n], comp_k['sizes'][:n])\n            v_comp_out, v_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, v_exp_list, False, self._workspace,\n                comp_v['comp_exp'][:n], comp_v['sizes'][:n])\n\n            # 3. D2H sizes (small) — these are used on the wait path.\n            k_sizes_pinned = self._sizes_pinned_k[:n]\n            v_sizes_pinned = self._sizes_pinned_v[:n]\n            k_sizes_pinned.copy_(k_sizes, non_blocking=True)\n            v_sizes_pinned.copy_(v_sizes, non_blocking=True)\n\n            # 4. D2H compressed exp rows (full row copies — ~max_comp_size/block,\n            #    padding waste bounded).  Host target is indexed by block_id so\n            #    must be a gather-scatter copy: we loop (OK — async on stream).\n            host_k = self._host_pools[layer_id]['k']\n            host_v = self._host_pools[layer_id]['v']\n            gpu_k_comp = comp_k['comp_exp'][:n]\n            gpu_v_comp = comp_v['comp_exp'][:n]\n            gpu_k_sm = comp_k['sm'][:n]\n            gpu_v_sm = comp_v['sm'][:n]\n            for i, slot in enumerate(physical_slots):\n                host_k['comp_exp'][slot].copy_(\n                    gpu_k_comp[i], non_blocking=True)\n                host_v['comp_exp'][slot].copy_(\n                    gpu_v_comp[i], non_blocking=True)\n                host_k['sm'][slot].copy_(gpu_k_sm[i], non_blocking=True)\n                host_v['sm'][slot].copy_(gpu_v_sm[i], non_blocking=True)\n\n            event = self.comp_stream.record_event()\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': list(block_ids),\n            'physical_slots': physical_slots,\n            'k_sizes_pinned': k_sizes_pinned,\n            'v_sizes_pinned': v_sizes_pinned,\n        }\n\n    def has_compressed_kv(self, layer_id: int) -> bool:\n        return layer_id in self._compressed_kv\n\n    # Identity-keyed cache for the list->numpy conversion of the per-step\n    # active id list (the SAME list object is passed for every layer of a\n    # step).  Class-level defaults so subclasses that don't chain __init__\n    # (e.g. P4Flat) inherit them.  Holding the key keeps the cached list\n    # alive so its identity cannot be recycled.\n    _ids_np_key = None\n    _ids_np_val = None\n    # Per-step cache for the in-range filtered array in has_persistent_compressed_kv.\n    # Class-level defaults so subclasses (P4Flat etc.) inherit them.\n    _has_pk_ab = None\n    _has_pk_vlen = None\n    _has_pk_sel = None\n\n    def _ids_np(self, block_ids) -> \"np.ndarray\":\n        if block_ids is self._ids_np_key:\n            return self._ids_np_val\n        ab = (block_ids if isinstance(block_ids, np.ndarray)\n              else np.asarray(block_ids, dtype=np.int64))\n        self._ids_np_key = block_ids\n        self._ids_np_val = ab\n        return ab\n\n    def has_persistent_compressed_kv(self, layer_id: int,\n                                     block_ids: list) -> bool:\n        # Called once per layer per step with the full active set; the old\n        # ``any(valid[bid] for bid in block_ids)`` generator walked every id\n        # in Python (~300 µs at ~4k ids, inside the nsys decompress_persistent\n        # range).  Vectorized: one cached np view + fancy-index + .any().\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(block_ids) == 0:\n            return False\n        va = np.frombuffer(valid, dtype=np.uint8)   # bytearray view, no copy\n        ab = self._ids_np(block_ids)\n        # The in-range filtered set depends only on (block_ids, vlen) — both\n        # are identical across all ~80 layers per step.  Cache the filtered\n        # array so we don't allocate 3 numpy arrays (two bool + one int64)\n        # per layer (was ~240 numpy objects/step).\n        vlen = va.size\n        if (getattr(self, \"_has_pk_ab\", None) is ab\n                and getattr(self, \"_has_pk_vlen\", None) == vlen):\n            sel = self._has_pk_sel\n        else:\n            sel = ab[(ab >= 0) & (ab < vlen)]\n            self._has_pk_ab = ab\n            self._has_pk_vlen = vlen\n            self._has_pk_sel = sel\n        return bool(va[sel].any()) if sel.size else False\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._free_kv_slot(layer_id, block_id)\n\n    def decompress_batch(\n        self, layer_id: int,\n        active_block_ids: list,\n        output_buffers: \"tuple[torch.Tensor, torch.Tensor]\",\n    ) -> None:\n        \"\"\"KV-path batch decompress.\n\n        ``output_buffers`` is a 2-tuple ``(k_cache, v_cache)`` whose\n        ``[block_id]`` slots receive the decompressed BF16 results.\n\n        This class is KV-only and overrides the abstract\n        ``TensorCompressor.decompress_batch`` with this KV-specific\n        signature — calling with ``(comps, outputs)`` (the weight-path\n        signature) raises :class:`TypeError` from the unpacking below\n        rather than the abstract NotImplementedError stub.\n        \"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None:\n            return\n        num_primary = k_cache.shape[0]\n        vlen = len(valid)\n        filtered = [bid for bid in active_block_ids\n                    if 0 <= bid < num_primary and bid < vlen and valid[bid]]\n        if not filtered:\n            return\n        filtered.sort()\n        gpu_cap = self._max_gpu_decomp_blocks\n        for start in range(0, len(filtered), gpu_cap):\n            batch = filtered[start:start + gpu_cap]\n            self._decompress_blocks(layer_id, batch, k_cache, v_cache)\n\n    def start_kv_h2d_persistent(\n        self,\n        layer_id: int,\n        active_block_ids: list,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> bool:\n        \"\"\"Queue this backend's persistent H2D and dense decode work.\n\n        DietGPU-family codecs combine their H2D and decode in\n        ``decompress_batch`` on ``batch_decomp_stream``.  Exposing the common\n        split-phase loader contract lets the V1 wrapper use the same ordering\n        as P4Flat/ZipServ; the corresponding finish method is intentionally a\n        no-op because all work is already queued here.\n        \"\"\"\n        self.decompress_batch(\n            layer_id,\n            active_block_ids,\n            output_buffers=(k_cache, v_cache),\n        )\n        return True\n\n    def finish_kv_decompress_persistent(\n        self,\n        layer_id: int,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> None:\n        \"\"\"Complete the common split-phase API (work queued by ``start``).\"\"\"\n        return\n\n    # ------------------------------------------------------------------\n    #  Core decompress kernel\n    # ------------------------------------------------------------------\n\n    def _decompress_blocks(self, layer_id: int,\n                           block_ids: list,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            # Recurse via caller chunking; defensive guard\n            raise RuntimeError(\n                f\"DietGPU KV decompress: n={n} exceeds \"\n                f\"max_gpu_decomp_blocks={self._max_gpu_decomp_blocks}\")\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        decomp_k = self._gpu_decomp_pool['k']\n        decomp_v = self._gpu_decomp_pool['v']\n        B = self._block_numel\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            # 1. H2D compressed exp + sm rows per block (loop, async).\n            gpu_k_comp = decomp_k['comp_exp'][:n]\n            gpu_v_comp = decomp_v['comp_exp'][:n]\n            gpu_k_sm = decomp_k['sm'][:n]\n            gpu_v_sm = decomp_v['sm'][:n]\n            physical_slots = []\n            for i, bid in enumerate(block_ids):\n                slot = self._get_kv_slot(layer_id, bid)\n                if slot < 0:\n                    raise RuntimeError(\n                        f\"DietGPU KV: no compressed slot for \"\n                        f\"layer={layer_id} bid={bid}\")\n                physical_slots.append(slot)\n                gpu_k_comp[i].copy_(\n                    host_k['comp_exp'][slot], non_blocking=True)\n                gpu_v_comp[i].copy_(\n                    host_v['comp_exp'][slot], non_blocking=True)\n                gpu_k_sm[i].copy_(host_k['sm'][slot], non_blocking=True)\n                gpu_v_sm[i].copy_(host_v['sm'][slot], non_blocking=True)\n\n            # 2. Build per-block views sized by actual compressed length.\n            k_in_list: List[torch.Tensor] = []\n            v_in_list: List[torch.Tensor] = []\n            k_out_list: List[torch.Tensor] = []\n            v_out_list: List[torch.Tensor] = []\n            for i, slot in enumerate(physical_slots):\n                ksz = int(host_k['exp_sizes'][slot].item())\n                vsz = int(host_v['exp_sizes'][slot].item())\n                k_in_list.append(gpu_k_comp[i, :ksz])\n                v_in_list.append(gpu_v_comp[i, :vsz])\n                k_out_list.append(decomp_k['exp'][i])\n                v_out_list.append(decomp_v['exp'][i])\n\n            torch.ops.dietgpu.decompress_data(\n                False, k_in_list, k_out_list, False, self._workspace)\n            torch.ops.dietgpu.decompress_data(\n                False, v_in_list, v_out_list, False, self._workspace)\n\n            # 3. Reconstruct BF16 from exp + sm using fused Triton kernel.\n            k_bf16 = self._bf16_decomp_out['k'][:n]\n            v_bf16 = self._bf16_decomp_out['v'][:n]\n            dietgpu_reconstruct(\n                decomp_k['exp'][:n].view(n * B),\n                gpu_k_sm.view(n * B),\n                k_bf16.view(n * B))\n            dietgpu_reconstruct(\n                decomp_v['exp'][:n].view(n * B),\n                gpu_v_sm.view(n * B),\n                v_bf16.view(n * B))\n\n            # 4. Scatter into cache.\n            bid_gpu = torch.as_tensor(\n                block_ids, dtype=torch.long, device=k_cache.device)\n            k_cache[bid_gpu] = k_bf16.reshape(n, *self._block_shape)\n            v_cache[bid_gpu] = v_bf16.reshape(n, *self._block_shape)\n\n    # ------------------------------------------------------------------\n    #  TensorCompressor weight-path abstract methods (KV-only backend)\n    # ------------------------------------------------------------------\n    #\n    # This class is the ``kv_compressor`` of DualMemoryLoader and never\n    # plays the ``weight_compressor`` role; the weight-side methods are\n    # required by the abstract base but unused here.\n\n    def _weight_path_unsupported(self, name: str):\n        raise NotImplementedError(\n            f\"{type(self).__name__} is KV-only; the weight-path method \"\n            f\"{name!r} is not implemented.  Use a weight-side \"\n            \"TensorCompressor (e.g. DietGPUCompressor / ZipServCompressor) \"\n            \"for weight compression.\")\n\n    def compress(self, weight, decomp_output_tensor=None,\n                 comp_output_tensor=None, _sync=True):\n        self._weight_path_unsupported(\"compress\")\n\n    def decompress(self, comp, output=None):\n        self._weight_path_unsupported(\"decompress\")\n\n    def compress_batch(self, weights, decomp_output_tensors=None,\n                       comp_output_tensors=None, _sync=True):\n        self._weight_path_unsupported(\n            \"compress_batch (sync) — use compress_batch_async for the \"\n            \"KV pipeline path\")\n\n    # NB: ``decompress_batch`` is overridden above with a KV-specific\n    # signature (layer_id, block_ids, output_buffers).  No NotImplementedError\n    # stub here — the abstract requirement is satisfied by the KV impl.\n","stderr":"","aggregated_output":"\"\"\"DietGPU KV cache compressor.\n\nProvides a drop-in replacement for ``ZipServCompressor`` when used as the\n``kv_compressor`` in ``DualMemoryLoader``.  Uses the DietGPU raw ANS codec\n(exponent-only compression + raw sign|mantissa storage) for BF16 KV cache\nblocks.\n\nInterface parity with ZipServCompressor's KV methods (the subset that is\nexercised from ``DualMemoryLoader``, ``kv_offload_system`` and\n``v1_cuda_graph_wrapper``):\n\n- ``batch_decomp_stream`` attribute\n- ``warmup_kv_buffers(block_shape, max_n_blocks, n_layers, ...)``\n- ``init_kv_compress_workers(n_workers, max_blocks, n_layers)``\n- ``compress_batch_async(layer_id, block_ids, gpu_k, gpu_v)``\n- ``wait_compress_async(layer_id, block_shape, timeout_sec)``\n- ``stop_kv_compress_workers()``\n- ``has_compressed_kv(layer_id)`` / ``_compressed_kv`` dict\n- ``has_persistent_compressed_kv(layer_id, block_ids)``\n- ``decompress_batch(layer_id, block_ids, output_buffers=(k_cache, v_cache))``\n- ``free_persistent_block(layer_id, block_id)``\n\nUnlike ZipServ, there is no C++ worker thread pool — DietGPU compresses\nentirely on GPU, so ``compress_batch_async`` simply launches the\ncompress + D2H pipeline on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.\n\nStorage layout (per layer, per K and V):\n  - ``comp_exp`` : pinned [max_n_blocks, max_comp_size] uint8 row-major by\n    physical slot.  Actual per-block payload length tracked in ``exp_sizes``.\n  - ``sm``       : pinned [max_n_blocks, block_bytes] uint8 row-major by\n    physical slot.\n  - ``exp_sizes``: pinned [max_n_blocks] int32 — per-slot compressed size.\n  - ``_kv_slot`` : block_id -> physical slot.  Slots [0, active_count) are\n    kept dense via eager swap-with-last on free.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Any, Dict, List, Optional, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.tensor_compressor import _ensure_dietgpu_loaded\n\nlogger = logging.getLogger(__name__)\n\n\n# DietGPU ANS worst-case compressed size for a batch of equal-size inputs.\n# Mirrors ``getMaxCompressedSize`` from dietgpu/ans/GpuANSEncode.cu which is\n# roughly ``overhead + max_block_size_coalesced * ceil(N / 4096)`` where each\n# 4096-byte block can expand to ~2x of its input in the coalesced layout.\n# Use a conservative bound of ``2 * N + 16 KiB`` rounded to 128 B.\ndef _max_comp_size(uncompressed_bytes: int) -> int:\n    size = uncompressed_bytes * 2 + 16 * 1024\n    return (size + 127) & ~127\n\n\nclass DietGPUKVCompressor(TensorCompressor):\n    \"\"\"DietGPU-based KV cache compressor.\n\n    Inherits :class:`TensorCompressor` so that\n    :class:`tiered_serve.dual_memory_loader.DualMemoryLoader` can hold\n    ``weight_compressor`` and ``kv_compressor`` as uniformly-typed\n    :class:`TensorCompressor` instances.\n\n    The single-tensor weight API (``compress`` / ``decompress`` /\n    ``compress_batch`` / ``decompress_batch``) is **not** implemented —\n    this backend is KV-only and exposes its work through KV-specific\n    batch methods (``compress_batch_async`` / ``wait_compress_async`` /\n    ``decompress_batch``).  Calls to the weight API raise\n    :class:`NotImplementedError`.\n    \"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream,\n                 workspace_bytes: int = 384 * 1024 * 1024):\n        _ensure_dietgpu_loaded()\n        # TensorCompressor.__init__ sets up comp_stream/decomp_stream\n        # defaults; we overwrite comp_stream below with the caller's.\n        super().__init__(comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self._workspace = torch.empty(\n            [workspace_bytes], dtype=torch.uint8, device=\"cuda\")\n\n        # Per-layer transient state populated by ``compress_batch_async``\n        # and committed by ``wait_compress_async`` so downstream readers\n        # (e.g. DualMemoryLoader's persistent decompress path) can see\n        # which buffer_ids were just written into the host pool.\n        self._compressed_kv: Dict[int, Any] = {}\n\n        # Persistent compressed store bookkeeping.\n        # ``_persistent_valid[layer_id]`` is a bytearray of length max_n_blocks\n        # where 1 means \"this block has compressed data in the host pool\".\n        self._persistent_valid: Dict[int, bytearray] = {}\n        # Per-layer compressed-row slot mapping.  Unlike the logical vLLM block\n        # id, physical slots are compacted eagerly on free so the host store\n        # remains a dense prefix.\n        self._kv_slot: Dict[int, torch.Tensor] = {}\n        self._kv_slot_block: Dict[int, List[int]] = {}\n        self._kv_active_count: Dict[int, int] = {}\n\n        self._kv_pools_ready = False\n        # Per-layer host pools: {layer_id: {'k': pool_dict, 'v': pool_dict}}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        # GPU staging pools for compress output (shared across layers):\n        # {'k': ..., 'v': ...} each with comp_exp[N,S] uint8, sm[N,B] uint8,\n        # sizes[N] int32\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        # GPU staging pools for decompress input\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n\n        self._block_numel: int = 0              # elements per block (BF16)\n        self._block_bytes: int = 0              # bytes per block (uint8 view)\n        self._max_comp_size: int = 0            # per-block compressed stride\n        self._block_shape: Tuple[int, ...] = ()\n        self._max_n_blocks: int = 0\n        self._max_gpu_blocks: int = 0\n        self._max_gpu_decomp_blocks: int = 0\n        self._n_layers: int = 0\n\n        # Pending async compress state for wait_compress_async.\n        # {layer_id: {'event': CUDA event, 'buffer_ids': list, ...}}\n        self._pending_compress: Dict[int, Dict[str, Any]] = {}\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _compute_max_comp_size(self, block_bytes: int) -> int:\n        \"\"\"Worst-case compressed bytes for one ``block_bytes``-row.\n        Subclasses (e.g. MantExp with non-DietGPU codec) may override.\n        \"\"\"\n        _probe = torch.empty(block_bytes, dtype=torch.uint8, device='cuda')\n        _rows, mcs = torch.ops.dietgpu.max_any_compressed_output_size([_probe])\n        del _probe\n        return (int(mcs) + 127) & ~127\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        \"\"\"Pre-allocate flat per-block buffers for KV compress/decompress.\"\"\"\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        # BF16 -> 2 bytes per element; but we split into two uint8 streams\n        # (exp and sm), each ``block_numel`` bytes long.\n        block_bytes = block_numel\n        # Worst-case per-row compressed size.  Subclasses may override\n        # ``_compute_max_comp_size`` to use a different codec.\n        max_comp_size = self._compute_max_comp_size(block_bytes)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._block_bytes = block_bytes\n        self._max_comp_size = max_comp_size\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            \"\"\"Allocate a pinned host pool for one (layer, kv) slot.\"\"\"\n            pool = {}\n            specs = {\n                'comp_exp':  ((host_n, max_comp_size), torch.uint8),\n                'sm':        ((host_n, block_bytes),   torch.uint8),\n                'exp_sizes': ((host_n,),               torch.int32),\n            }\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            # flatten to 1-D to match allocator API\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(\n                        *shape, dtype=dtype, device='cpu').pin_memory()\n                pool[name] = t\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            # Accept pre-allocated pools (must match the DietGPU layout).\n            self._host_pools = pre_allocated_host_pools\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging pools (one set each for compress, decompress).\n        def _alloc_gpu_pool(n_blocks: int) -> Dict[str, torch.Tensor]:\n            return {\n                'comp_exp':  torch.empty(\n                    n_blocks, max_comp_size, dtype=torch.uint8,\n                    device='cuda'),\n                'sm':        torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'exp':       torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'sizes':     torch.empty(\n                    n_blocks, dtype=torch.int32, device='cuda'),\n            }\n\n        self._gpu_comp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_blocks + 1),\n        }\n        self._gpu_decomp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n        }\n\n        # Pinned sizes scratch for D2H of per-block compressed lengths.\n        self._sizes_pinned_k = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n        self._sizes_pinned_v = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n\n        # Pinned BF16 decompressed output (matching ZipServ's decomp output).\n        self._bf16_decomp_out = {\n            'k': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n            'v': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n        }\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._kv_slot = {\n            lid: torch.full((host_n,), -1, dtype=torch.int32)\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {\n            lid: [-1] * host_n for lid in range(n_layers)\n        }\n        self._kv_active_count = {\n            lid: 0 for lid in range(n_layers)\n        }\n\n        self._kv_pools_ready = True\n\n        host_bytes = 0\n        for layer_pools in self._host_pools.values():\n            for kv_pool in layer_pools.values():\n                for t in kv_pool.values():\n                    host_bytes += t.nbytes\n        gpu_bytes = 0\n        for p in list(self._gpu_comp_pool.values()) + list(\n                self._gpu_decomp_pool.values()):\n            for t in p.values():\n                gpu_bytes += t.nbytes\n        logger.info(\n            \"DietGPU KV buffers warmed up: block_shape=%s, block_numel=%d, \"\n            \"max_comp_size=%d, max_n_blocks=%d, max_gpu_comp=%d, \"\n            \"max_gpu_decomp=%d, n_layers=%d, host=%.1fMB, gpu_staging=%.1fMB\",\n            block_shape, block_numel, max_comp_size, max_n_blocks,\n            max_gpu_blocks, max_gpu_decomp_blocks, n_layers,\n            host_bytes / 1024**2, gpu_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  C++-style compress API (no-op worker pool, GPU-only compression)\n    # ------------------------------------------------------------------\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        \"\"\"No-op for DietGPU — compression runs synchronously on GPU.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n        logger.info(\n            \"DietGPU KV: skipping C++ worker init \"\n            \"(compression runs on GPU, n_workers=%d ignored)\", n_workers)\n\n    def stop_kv_compress_workers(self) -> None:\n        pass\n\n    def compress_batch_async(self, layer_id: int,\n                                 block_ids: list,\n                                 gpu_k: torch.Tensor,\n                                 gpu_v: torch.Tensor) -> None:\n        \"\"\"Launch async GPU compress + D2H for a layer's blocks.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async requires warmup_kv_buffers first\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(gpu_k.shape[1:]))\n        self._launch_compress(layer_id, block_ids, gpu_k, gpu_v)\n\n    def wait_compress_async(self, layer_id: int,\n                             block_shape: tuple,\n                             timeout_sec: float = -1.0) -> None:\n        \"\"\"Synchronise the launched compress/D2H and register persistent meta.\"\"\"\n        state = self._pending_compress.pop(layer_id, None)\n        if state is None:\n            return\n        event = state['event']\n        event.synchronize()\n\n        buffer_ids = state['buffer_ids']\n        physical_slots = state.get('physical_slots')\n        if physical_slots is None:\n            physical_slots = [\n                self._assign_kv_slot(layer_id, bid) for bid in buffer_ids\n            ]\n        n = len(buffer_ids)\n        if n == 0:\n            return\n        k_sizes_pinned = state['k_sizes_pinned']\n        v_sizes_pinned = state['v_sizes_pinned']\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        exp_sz_k = host_k['exp_sizes']\n        exp_sz_v = host_v['exp_sizes']\n        # Commit per-block exp sizes into host persistent metadata.\n        for i, slot in enumerate(physical_slots):\n            exp_sz_k[slot] = int(k_sizes_pinned[i].item())\n            exp_sz_v[slot] = int(v_sizes_pinned[i].item())\n\n        pv = self._persistent_valid[layer_id]\n        for bid in buffer_ids:\n            pv[bid] = 1\n\n        # Populate transient _compressed_kv for old-path compat\n        # (consumers pop this after their own use).\n        self._compressed_kv[layer_id] = {\n            'buffer_ids': list(buffer_ids),\n            'block_shape': block_shape,\n            'n': n,\n        }\n\n    # ------------------------------------------------------------------\n    #  Compress helpers\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        prev_slot = int(slot_tbl[bid].item())\n        if prev_slot >= 0:\n            return prev_slot\n\n        active = self._kv_active_count[layer_id]\n        if active >= len(self._kv_slot_block[layer_id]):\n            raise RuntimeError(\n                f\"DietGPU KV: persistent slot pool full for layer={layer_id}\")\n        slot_tbl[bid] = active\n        self._kv_slot_block[layer_id][active] = bid\n        self._kv_active_count[layer_id] = active + 1\n        return active\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        if not 0 <= bid < slot_tbl.numel():\n            return -1\n        return int(slot_tbl[bid].item())\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['comp_exp'][dst_slot].copy_(pool['comp_exp'][src_slot])\n            pool['exp_sizes'][dst_slot] = pool['exp_sizes'][src_slot]\n            if 'sm' in pool:\n                pool['sm'][dst_slot].copy_(pool['sm'][src_slot])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        slot_tbl = self._kv_slot.get(layer_id)\n        if slot_tbl is None or not 0 <= block_id < slot_tbl.numel():\n            return\n        slot = int(slot_tbl[block_id].item())\n        if slot < 0:\n            return\n\n        active = self._kv_active_count[layer_id]\n        if active <= 0:\n            slot_tbl[block_id] = -1\n            return\n\n        last_slot = active - 1\n        moved_bid = self._kv_slot_block[layer_id][last_slot]\n        if slot != last_slot and moved_bid >= 0:\n            self._move_host_slot(layer_id, slot, last_slot)\n            self._kv_slot_block[layer_id][slot] = moved_bid\n            slot_tbl[moved_bid] = slot\n        elif slot != last_slot:\n            self._kv_slot_block[layer_id][slot] = -1\n\n        self._kv_slot_block[layer_id][last_slot] = -1\n        self._kv_active_count[layer_id] = last_slot\n        slot_tbl[block_id] = -1\n\n    @staticmethod\n    def _extract_exp_sm(blocks_bf16: torch.Tensor,\n                        out_exp: torch.Tensor,\n                        out_sm: torch.Tensor) -> None:\n        \"\"\"Given a [N, numel] BF16 GPU tensor, write exp and sign|mantissa\n        uint8 representations into preallocated [N, numel] buffers.\"\"\"\n        # Bitcast view to uint16 so we can shift/mask.\n        u16 = blocks_bf16.view(torch.uint16)\n        i32 = u16.to(torch.int32)\n        exp = ((i32 >> 7) & 0xFF).to(torch.uint8)\n        sm = (((i32 >> 8) & 0x80) | (i32 & 0x7F)).to(torch.uint8)\n        out_exp.copy_(exp)\n        out_sm.copy_(sm)\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        \"\"\"Compress the given K/V blocks on GPU and D2H to host pools.\"\"\"\n        n = len(block_ids)\n        if n == 0:\n            return\n        num_primary = gpu_k.shape[0]\n        block_ids = [bid for bid in block_ids if 0 <= bid < num_primary]\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_blocks:\n            raise RuntimeError(\n                f\"DietGPU KV compress: n={n} exceeds max_gpu_blocks=\"\n                f\"{self._max_gpu_blocks}\")\n\n        comp_k = self._gpu_comp_pool['k']\n        comp_v = self._gpu_comp_pool['v']\n        B = self._block_numel\n\n        # GPU indices on device matching block_ids (int64 for indexing)\n        bid_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=gpu_k.device)\n        physical_slots = [\n            self._assign_kv_slot(layer_id, bid) for bid in block_ids\n        ]\n\n        with torch.cuda.stream(self.comp_stream):\n            # 1. Gather blocks and split into exp/sm\n            k_blocks = gpu_k[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            v_blocks = gpu_v[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            self._extract_exp_sm(k_blocks, comp_k['exp'][:n], comp_k['sm'][:n])\n            self._extract_exp_sm(v_blocks, comp_v['exp'][:n], comp_v['sm'][:n])\n\n            # 2. Batch compress exponents per block.\n            #    compress_data returns [N, max_out] contiguous tensor.\n            k_exp_list = list(comp_k['exp'][:n])\n            v_exp_list = list(comp_v['exp'][:n])\n            k_comp_out, k_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, k_exp_list, False, self._workspace,\n                comp_k['comp_exp'][:n], comp_k['sizes'][:n])\n            v_comp_out, v_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, v_exp_list, False, self._workspace,\n                comp_v['comp_exp'][:n], comp_v['sizes'][:n])\n\n            # 3. D2H sizes (small) — these are used on the wait path.\n            k_sizes_pinned = self._sizes_pinned_k[:n]\n            v_sizes_pinned = self._sizes_pinned_v[:n]\n            k_sizes_pinned.copy_(k_sizes, non_blocking=True)\n            v_sizes_pinned.copy_(v_sizes, non_blocking=True)\n\n            # 4. D2H compressed exp rows (full row copies — ~max_comp_size/block,\n            #    padding waste bounded).  Host target is indexed by block_id so\n            #    must be a gather-scatter copy: we loop (OK — async on stream).\n            host_k = self._host_pools[layer_id]['k']\n            host_v = self._host_pools[layer_id]['v']\n            gpu_k_comp = comp_k['comp_exp'][:n]\n            gpu_v_comp = comp_v['comp_exp'][:n]\n            gpu_k_sm = comp_k['sm'][:n]\n            gpu_v_sm = comp_v['sm'][:n]\n            for i, slot in enumerate(physical_slots):\n                host_k['comp_exp'][slot].copy_(\n                    gpu_k_comp[i], non_blocking=True)\n                host_v['comp_exp'][slot].copy_(\n                    gpu_v_comp[i], non_blocking=True)\n                host_k['sm'][slot].copy_(gpu_k_sm[i], non_blocking=True)\n                host_v['sm'][slot].copy_(gpu_v_sm[i], non_blocking=True)\n\n            event = self.comp_stream.record_event()\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': list(block_ids),\n            'physical_slots': physical_slots,\n            'k_sizes_pinned': k_sizes_pinned,\n            'v_sizes_pinned': v_sizes_pinned,\n        }\n\n    def has_compressed_kv(self, layer_id: int) -> bool:\n        return layer_id in self._compressed_kv\n\n    # Identity-keyed cache for the list->numpy conversion of the per-step\n    # active id list (the SAME list object is passed for every layer of a\n    # step).  Class-level defaults so subclasses that don't chain __init__\n    # (e.g. P4Flat) inherit them.  Holding the key keeps the cached list\n    # alive so its identity cannot be recycled.\n    _ids_np_key = None\n    _ids_np_val = None\n    # Per-step cache for the in-range filtered array in has_persistent_compressed_kv.\n    # Class-level defaults so subclasses (P4Flat etc.) inherit them.\n    _has_pk_ab = None\n    _has_pk_vlen = None\n    _has_pk_sel = None\n\n    def _ids_np(self, block_ids) -> \"np.ndarray\":\n        if block_ids is self._ids_np_key:\n            return self._ids_np_val\n        ab = (block_ids if isinstance(block_ids, np.ndarray)\n              else np.asarray(block_ids, dtype=np.int64))\n        self._ids_np_key = block_ids\n        self._ids_np_val = ab\n        return ab\n\n    def has_persistent_compressed_kv(self, layer_id: int,\n                                     block_ids: list) -> bool:\n        # Called once per layer per step with the full active set; the old\n        # ``any(valid[bid] for bid in block_ids)`` generator walked every id\n        # in Python (~300 µs at ~4k ids, inside the nsys decompress_persistent\n        # range).  Vectorized: one cached np view + fancy-index + .any().\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(block_ids) == 0:\n            return False\n        va = np.frombuffer(valid, dtype=np.uint8)   # bytearray view, no copy\n        ab = self._ids_np(block_ids)\n        # The in-range filtered set depends only on (block_ids, vlen) — both\n        # are identical across all ~80 layers per step.  Cache the filtered\n        # array so we don't allocate 3 numpy arrays (two bool + one int64)\n        # per layer (was ~240 numpy objects/step).\n        vlen = va.size\n        if (getattr(self, \"_has_pk_ab\", None) is ab\n                and getattr(self, \"_has_pk_vlen\", None) == vlen):\n            sel = self._has_pk_sel\n        else:\n            sel = ab[(ab >= 0) & (ab < vlen)]\n            self._has_pk_ab = ab\n            self._has_pk_vlen = vlen\n            self._has_pk_sel = sel\n        return bool(va[sel].any()) if sel.size else False\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._free_kv_slot(layer_id, block_id)\n\n    def decompress_batch(\n        self, layer_id: int,\n        active_block_ids: list,\n        output_buffers: \"tuple[torch.Tensor, torch.Tensor]\",\n    ) -> None:\n        \"\"\"KV-path batch decompress.\n\n        ``output_buffers`` is a 2-tuple ``(k_cache, v_cache)`` whose\n        ``[block_id]`` slots receive the decompressed BF16 results.\n\n        This class is KV-only and overrides the abstract\n        ``TensorCompressor.decompress_batch`` with this KV-specific\n        signature — calling with ``(comps, outputs)`` (the weight-path\n        signature) raises :class:`TypeError` from the unpacking below\n        rather than the abstract NotImplementedError stub.\n        \"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None:\n            return\n        num_primary = k_cache.shape[0]\n        vlen = len(valid)\n        filtered = [bid for bid in active_block_ids\n                    if 0 <= bid < num_primary and bid < vlen and valid[bid]]\n        if not filtered:\n            return\n        filtered.sort()\n        gpu_cap = self._max_gpu_decomp_blocks\n        for start in range(0, len(filtered), gpu_cap):\n            batch = filtered[start:start + gpu_cap]\n            self._decompress_blocks(layer_id, batch, k_cache, v_cache)\n\n    def start_kv_h2d_persistent(\n        self,\n        layer_id: int,\n        active_block_ids: list,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> bool:\n        \"\"\"Queue this backend's persistent H2D and dense decode work.\n\n        DietGPU-family codecs combine their H2D and decode in\n        ``decompress_batch`` on ``batch_decomp_stream``.  Exposing the common\n        split-phase loader contract lets the V1 wrapper use the same ordering\n        as P4Flat/ZipServ; the corresponding finish method is intentionally a\n        no-op because all work is already queued here.\n        \"\"\"\n        self.decompress_batch(\n            layer_id,\n            active_block_ids,\n            output_buffers=(k_cache, v_cache),\n        )\n        return True\n\n    def finish_kv_decompress_persistent(\n        self,\n        layer_id: int,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> None:\n        \"\"\"Complete the common split-phase API (work queued by ``start``).\"\"\"\n        return\n\n    # ------------------------------------------------------------------\n    #  Core decompress kernel\n    # ------------------------------------------------------------------\n\n    def _decompress_blocks(self, layer_id: int,\n                           block_ids: list,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            # Recurse via caller chunking; defensive guard\n            raise RuntimeError(\n                f\"DietGPU KV decompress: n={n} exceeds \"\n                f\"max_gpu_decomp_blocks={self._max_gpu_decomp_blocks}\")\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        decomp_k = self._gpu_decomp_pool['k']\n        decomp_v = self._gpu_decomp_pool['v']\n        B = self._block_numel\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            # 1. H2D compressed exp + sm rows per block (loop, async).\n            gpu_k_comp = decomp_k['comp_exp'][:n]\n            gpu_v_comp = decomp_v['comp_exp'][:n]\n            gpu_k_sm = decomp_k['sm'][:n]\n            gpu_v_sm = decomp_v['sm'][:n]\n            physical_slots = []\n            for i, bid in enumerate(block_ids):\n                slot = self._get_kv_slot(layer_id, bid)\n                if slot < 0:\n                    raise RuntimeError(\n                        f\"DietGPU KV: no compressed slot for \"\n                        f\"layer={layer_id} bid={bid}\")\n                physical_slots.append(slot)\n                gpu_k_comp[i].copy_(\n                    host_k['comp_exp'][slot], non_blocking=True)\n                gpu_v_comp[i].copy_(\n                    host_v['comp_exp'][slot], non_blocking=True)\n                gpu_k_sm[i].copy_(host_k['sm'][slot], non_blocking=True)\n                gpu_v_sm[i].copy_(host_v['sm'][slot], non_blocking=True)\n\n            # 2. Build per-block views sized by actual compressed length.\n            k_in_list: List[torch.Tensor] = []\n            v_in_list: List[torch.Tensor] = []\n            k_out_list: List[torch.Tensor] = []\n            v_out_list: List[torch.Tensor] = []\n            for i, slot in enumerate(physical_slots):\n                ksz = int(host_k['exp_sizes'][slot].item())\n                vsz = int(host_v['exp_sizes'][slot].item())\n                k_in_list.append(gpu_k_comp[i, :ksz])\n                v_in_list.append(gpu_v_comp[i, :vsz])\n                k_out_list.append(decomp_k['exp'][i])\n                v_out_list.append(decomp_v['exp'][i])\n\n            torch.ops.dietgpu.decompress_data(\n                False, k_in_list, k_out_list, False, self._workspace)\n            torch.ops.dietgpu.decompress_data(\n                False, v_in_list, v_out_list, False, self._workspace)\n\n            # 3. Reconstruct BF16 from exp + sm using fused Triton kernel.\n            k_bf16 = self._bf16_decomp_out['k'][:n]\n            v_bf16 = self._bf16_decomp_out['v'][:n]\n            dietgpu_reconstruct(\n                decomp_k['exp'][:n].view(n * B),\n                gpu_k_sm.view(n * B),\n                k_bf16.view(n * B))\n            dietgpu_reconstruct(\n                decomp_v['exp'][:n].view(n * B),\n                gpu_v_sm.view(n * B),\n                v_bf16.view(n * B))\n\n            # 4. Scatter into cache.\n            bid_gpu = torch.as_tensor(\n                block_ids, dtype=torch.long, device=k_cache.device)\n            k_cache[bid_gpu] = k_bf16.reshape(n, *self._block_shape)\n            v_cache[bid_gpu] = v_bf16.reshape(n, *self._block_shape)\n\n    # ------------------------------------------------------------------\n    #  TensorCompressor weight-path abstract methods (KV-only backend)\n    # ------------------------------------------------------------------\n    #\n    # This class is the ``kv_compressor`` of DualMemoryLoader and never\n    # plays the ``weight_compressor`` role; the weight-side methods are\n    # required by the abstract base but unused here.\n\n    def _weight_path_unsupported(self, name: str):\n        raise NotImplementedError(\n            f\"{type(self).__name__} is KV-only; the weight-path method \"\n            f\"{name!r} is not implemented.  Use a weight-side \"\n            \"TensorCompressor (e.g. DietGPUCompressor / ZipServCompressor) \"\n            \"for weight compression.\")\n\n    def compress(self, weight, decomp_output_tensor=None,\n                 comp_output_tensor=None, _sync=True):\n        self._weight_path_unsupported(\"compress\")\n\n    def decompress(self, comp, output=None):\n        self._weight_path_unsupported(\"decompress\")\n\n    def compress_batch(self, weights, decomp_output_tensors=None,\n                       comp_output_tensors=None, _sync=True):\n        self._weight_path_unsupported(\n            \"compress_batch (sync) — use compress_batch_async for the \"\n            \"KV pipeline path\")\n\n    # NB: ``decompress_batch`` is overridden above with a KV-specific\n    # signature (layer_id, block_ids, output_buffers).  No NotImplementedError\n    # stub here — the abstract requirement is satisfied by the KV impl.\n","exit_code":0,"duration":{"secs":0,"nanos":3168},"formatted_output":"\"\"\"DietGPU KV cache compressor.\n\nProvides a drop-in replacement for ``ZipServCompressor`` when used as the\n``kv_compressor`` in ``DualMemoryLoader``.  Uses the DietGPU raw ANS codec\n(exponent-only compression + raw sign|mantissa storage) for BF16 KV cache\nblocks.\n\nInterface parity with ZipServCompressor's KV methods (the subset that is\nexercised from ``DualMemoryLoader``, ``kv_offload_system`` and\n``v1_cuda_graph_wrapper``):\n\n- ``batch_decomp_stream`` attribute\n- ``warmup_kv_buffers(block_shape, max_n_blocks, n_layers, ...)``\n- ``init_kv_compress_workers(n_workers, max_blocks, n_layers)``\n- ``compress_batch_async(layer_id, block_ids, gpu_k, gpu_v)``\n- ``wait_compress_async(layer_id, block_shape, timeout_sec)``\n- ``stop_kv_compress_workers()``\n- ``has_compressed_kv(layer_id)`` / ``_compressed_kv`` dict\n- ``has_persistent_compressed_kv(layer_id, block_ids)``\n- ``decompress_batch(layer_id, block_ids, output_buffers=(k_cache, v_cache))``\n- ``free_persistent_block(layer_id, block_id)``\n\nUnlike ZipServ, there is no C++ worker thread pool — DietGPU compresses\nentirely on GPU, so ``compress_batch_async`` simply launches the\ncompress + D2H pipeline on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.\n\nStorage layout (per layer, per K and V):\n  - ``comp_exp`` : pinned [max_n_blocks, max_comp_size] uint8 row-major by\n    physical slot.  Actual per-block payload length tracked in ``exp_sizes``.\n  - ``sm``       : pinned [max_n_blocks, block_bytes] uint8 row-major by\n    physical slot.\n  - ``exp_sizes``: pinned [max_n_blocks] int32 — per-slot compressed size.\n  - ``_kv_slot`` : block_id -> physical slot.  Slots [0, active_count) are\n    kept dense via eager swap-with-last on free.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Any, Dict, List, Optional, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.tensor_compressor import _ensure_dietgpu_loaded\n\nlogger = logging.getLogger(__name__)\n\n\n# DietGPU ANS worst-case compressed size for a batch of equal-size inputs.\n# Mirrors ``getMaxCompressedSize`` from dietgpu/ans/GpuANSEncode.cu which is\n# roughly ``overhead + max_block_size_coalesced * ceil(N / 4096)`` where each\n# 4096-byte block can expand to ~2x of its input in the coalesced layout.\n# Use a conservative bound of ``2 * N + 16 KiB`` rounded to 128 B.\ndef _max_comp_size(uncompressed_bytes: int) -> int:\n    size = uncompressed_bytes * 2 + 16 * 1024\n    return (size + 127) & ~127\n\n\nclass DietGPUKVCompressor(TensorCompressor):\n    \"\"\"DietGPU-based KV cache compressor.\n\n    Inherits :class:`TensorCompressor` so that\n    :class:`tiered_serve.dual_memory_loader.DualMemoryLoader` can hold\n    ``weight_compressor`` and ``kv_compressor`` as uniformly-typed\n    :class:`TensorCompressor` instances.\n\n    The single-tensor weight API (``compress`` / ``decompress`` /\n    ``compress_batch`` / ``decompress_batch``) is **not** implemented —\n    this backend is KV-only and exposes its work through KV-specific\n    batch methods (``compress_batch_async`` / ``wait_compress_async`` /\n    ``decompress_batch``).  Calls to the weight API raise\n    :class:`NotImplementedError`.\n    \"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream,\n                 workspace_bytes: int = 384 * 1024 * 1024):\n        _ensure_dietgpu_loaded()\n        # TensorCompressor.__init__ sets up comp_stream/decomp_stream\n        # defaults; we overwrite comp_stream below with the caller's.\n        super().__init__(comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self._workspace = torch.empty(\n            [workspace_bytes], dtype=torch.uint8, device=\"cuda\")\n\n        # Per-layer transient state populated by ``compress_batch_async``\n        # and committed by ``wait_compress_async`` so downstream readers\n        # (e.g. DualMemoryLoader's persistent decompress path) can see\n        # which buffer_ids were just written into the host pool.\n        self._compressed_kv: Dict[int, Any] = {}\n\n        # Persistent compressed store bookkeeping.\n        # ``_persistent_valid[layer_id]`` is a bytearray of length max_n_blocks\n        # where 1 means \"this block has compressed data in the host pool\".\n        self._persistent_valid: Dict[int, bytearray] = {}\n        # Per-layer compressed-row slot mapping.  Unlike the logical vLLM block\n        # id, physical slots are compacted eagerly on free so the host store\n        # remains a dense prefix.\n        self._kv_slot: Dict[int, torch.Tensor] = {}\n        self._kv_slot_block: Dict[int, List[int]] = {}\n        self._kv_active_count: Dict[int, int] = {}\n\n        self._kv_pools_ready = False\n        # Per-layer host pools: {layer_id: {'k': pool_dict, 'v': pool_dict}}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        # GPU staging pools for compress output (shared across layers):\n        # {'k': ..., 'v': ...} each with comp_exp[N,S] uint8, sm[N,B] uint8,\n        # sizes[N] int32\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        # GPU staging pools for decompress input\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n\n        self._block_numel: int = 0              # elements per block (BF16)\n        self._block_bytes: int = 0              # bytes per block (uint8 view)\n        self._max_comp_size: int = 0            # per-block compressed stride\n        self._block_shape: Tuple[int, ...] = ()\n        self._max_n_blocks: int = 0\n        self._max_gpu_blocks: int = 0\n        self._max_gpu_decomp_blocks: int = 0\n        self._n_layers: int = 0\n\n        # Pending async compress state for wait_compress_async.\n        # {layer_id: {'event': CUDA event, 'buffer_ids': list, ...}}\n        self._pending_compress: Dict[int, Dict[str, Any]] = {}\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _compute_max_comp_size(self, block_bytes: int) -> int:\n        \"\"\"Worst-case compressed bytes for one ``block_bytes``-row.\n        Subclasses (e.g. MantExp with non-DietGPU codec) may override.\n        \"\"\"\n        _probe = torch.empty(block_bytes, dtype=torch.uint8, device='cuda')\n        _rows, mcs = torch.ops.dietgpu.max_any_compressed_output_size([_probe])\n        del _probe\n        return (int(mcs) + 127) & ~127\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        \"\"\"Pre-allocate flat per-block buffers for KV compress/decompress.\"\"\"\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        # BF16 -> 2 bytes per element; but we split into two uint8 streams\n        # (exp and sm), each ``block_numel`` bytes long.\n        block_bytes = block_numel\n        # Worst-case per-row compressed size.  Subclasses may override\n        # ``_compute_max_comp_size`` to use a different codec.\n        max_comp_size = self._compute_max_comp_size(block_bytes)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._block_bytes = block_bytes\n        self._max_comp_size = max_comp_size\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            \"\"\"Allocate a pinned host pool for one (layer, kv) slot.\"\"\"\n            pool = {}\n            specs = {\n                'comp_exp':  ((host_n, max_comp_size), torch.uint8),\n                'sm':        ((host_n, block_bytes),   torch.uint8),\n                'exp_sizes': ((host_n,),               torch.int32),\n            }\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            # flatten to 1-D to match allocator API\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(\n                        *shape, dtype=dtype, device='cpu').pin_memory()\n                pool[name] = t\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            # Accept pre-allocated pools (must match the DietGPU layout).\n            self._host_pools = pre_allocated_host_pools\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging pools (one set each for compress, decompress).\n        def _alloc_gpu_pool(n_blocks: int) -> Dict[str, torch.Tensor]:\n            return {\n                'comp_exp':  torch.empty(\n                    n_blocks, max_comp_size, dtype=torch.uint8,\n                    device='cuda'),\n                'sm':        torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'exp':       torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'sizes':     torch.empty(\n                    n_blocks, dtype=torch.int32, device='cuda'),\n            }\n\n        self._gpu_comp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_blocks + 1),\n        }\n        self._gpu_decomp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n        }\n\n        # Pinned sizes scratch for D2H of per-block compressed lengths.\n        self._sizes_pinned_k = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n        self._sizes_pinned_v = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n\n        # Pinned BF16 decompressed output (matching ZipServ's decomp output).\n        self._bf16_decomp_out = {\n            'k': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n            'v': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n        }\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._kv_slot = {\n            lid: torch.full((host_n,), -1, dtype=torch.int32)\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {\n            lid: [-1] * host_n for lid in range(n_layers)\n        }\n        self._kv_active_count = {\n            lid: 0 for lid in range(n_layers)\n        }\n\n        self._kv_pools_ready = True\n\n        host_bytes = 0\n        for layer_pools in self._host_pools.values():\n            for kv_pool in layer_pools.values():\n                for t in kv_pool.values():\n                    host_bytes += t.nbytes\n        gpu_bytes = 0\n        for p in list(self._gpu_comp_pool.values()) + list(\n                self._gpu_decomp_pool.values()):\n            for t in p.values():\n                gpu_bytes += t.nbytes\n        logger.info(\n            \"DietGPU KV buffers warmed up: block_shape=%s, block_numel=%d, \"\n            \"max_comp_size=%d, max_n_blocks=%d, max_gpu_comp=%d, \"\n            \"max_gpu_decomp=%d, n_layers=%d, host=%.1fMB, gpu_staging=%.1fMB\",\n            block_shape, block_numel, max_comp_size, max_n_blocks,\n            max_gpu_blocks, max_gpu_decomp_blocks, n_layers,\n            host_bytes / 1024**2, gpu_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  C++-style compress API (no-op worker pool, GPU-only compression)\n    # ------------------------------------------------------------------\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        \"\"\"No-op for DietGPU — compression runs synchronously on GPU.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n        logger.info(\n            \"DietGPU KV: skipping C++ worker init \"\n            \"(compression runs on GPU, n_workers=%d ignored)\", n_workers)\n\n    def stop_kv_compress_workers(self) -> None:\n        pass\n\n    def compress_batch_async(self, layer_id: int,\n                                 block_ids: list,\n                                 gpu_k: torch.Tensor,\n                                 gpu_v: torch.Tensor) -> None:\n        \"\"\"Launch async GPU compress + D2H for a layer's blocks.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async requires warmup_kv_buffers first\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(gpu_k.shape[1:]))\n        self._launch_compress(layer_id, block_ids, gpu_k, gpu_v)\n\n    def wait_compress_async(self, layer_id: int,\n                             block_shape: tuple,\n                             timeout_sec: float = -1.0) -> None:\n        \"\"\"Synchronise the launched compress/D2H and register persistent meta.\"\"\"\n        state = self._pending_compress.pop(layer_id, None)\n        if state is None:\n            return\n        event = state['event']\n        event.synchronize()\n\n        buffer_ids = state['buffer_ids']\n        physical_slots = state.get('physical_slots')\n        if physical_slots is None:\n            physical_slots = [\n                self._assign_kv_slot(layer_id, bid) for bid in buffer_ids\n            ]\n        n = len(buffer_ids)\n        if n == 0:\n            return\n        k_sizes_pinned = state['k_sizes_pinned']\n        v_sizes_pinned = state['v_sizes_pinned']\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        exp_sz_k = host_k['exp_sizes']\n        exp_sz_v = host_v['exp_sizes']\n        # Commit per-block exp sizes into host persistent metadata.\n        for i, slot in enumerate(physical_slots):\n            exp_sz_k[slot] = int(k_sizes_pinned[i].item())\n            exp_sz_v[slot] = int(v_sizes_pinned[i].item())\n\n        pv = self._persistent_valid[layer_id]\n        for bid in buffer_ids:\n            pv[bid] = 1\n\n        # Populate transient _compressed_kv for old-path compat\n        # (consumers pop this after their own use).\n        self._compressed_kv[layer_id] = {\n            'buffer_ids': list(buffer_ids),\n            'block_shape': block_shape,\n            'n': n,\n        }\n\n    # ------------------------------------------------------------------\n    #  Compress helpers\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        prev_slot = int(slot_tbl[bid].item())\n        if prev_slot >= 0:\n            return prev_slot\n\n        active = self._kv_active_count[layer_id]\n        if active >= len(self._kv_slot_block[layer_id]):\n            raise RuntimeError(\n                f\"DietGPU KV: persistent slot pool full for layer={layer_id}\")\n        slot_tbl[bid] = active\n        self._kv_slot_block[layer_id][active] = bid\n        self._kv_active_count[layer_id] = active + 1\n        return active\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        if not 0 <= bid < slot_tbl.numel():\n            return -1\n        return int(slot_tbl[bid].item())\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['comp_exp'][dst_slot].copy_(pool['comp_exp'][src_slot])\n            pool['exp_sizes'][dst_slot] = pool['exp_sizes'][src_slot]\n            if 'sm' in pool:\n                pool['sm'][dst_slot].copy_(pool['sm'][src_slot])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        slot_tbl = self._kv_slot.get(layer_id)\n        if slot_tbl is None or not 0 <= block_id < slot_tbl.numel():\n            return\n        slot = int(slot_tbl[block_id].item())\n        if slot < 0:\n            return\n\n        active = self._kv_active_count[layer_id]\n        if active <= 0:\n            slot_tbl[block_id] = -1\n            return\n\n        last_slot = active - 1\n        moved_bid = self._kv_slot_block[layer_id][last_slot]\n        if slot != last_slot and moved_bid >= 0:\n            self._move_host_slot(layer_id, slot, last_slot)\n            self._kv_slot_block[layer_id][slot] = moved_bid\n            slot_tbl[moved_bid] = slot\n        elif slot != last_slot:\n            self._kv_slot_block[layer_id][slot] = -1\n\n        self._kv_slot_block[layer_id][last_slot] = -1\n        self._kv_active_count[layer_id] = last_slot\n        slot_tbl[block_id] = -1\n\n    @staticmethod\n    def _extract_exp_sm(blocks_bf16: torch.Tensor,\n                        out_exp: torch.Tensor,\n                        out_sm: torch.Tensor) -> None:\n        \"\"\"Given a [N, numel] BF16 GPU tensor, write exp and sign|mantissa\n        uint8 representations into preallocated [N, numel] buffers.\"\"\"\n        # Bitcast view to uint16 so we can shift/mask.\n        u16 = blocks_bf16.view(torch.uint16)\n        i32 = u16.to(torch.int32)\n        exp = ((i32 >> 7) & 0xFF).to(torch.uint8)\n        sm = (((i32 >> 8) & 0x80) | (i32 & 0x7F)).to(torch.uint8)\n        out_exp.copy_(exp)\n        out_sm.copy_(sm)\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        \"\"\"Compress the given K/V blocks on GPU and D2H to host pools.\"\"\"\n        n = len(block_ids)\n        if n == 0:\n            return\n        num_primary = gpu_k.shape[0]\n        block_ids = [bid for bid in block_ids if 0 <= bid < num_primary]\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_blocks:\n            raise RuntimeError(\n                f\"DietGPU KV compress: n={n} exceeds max_gpu_blocks=\"\n                f\"{self._max_gpu_blocks}\")\n\n        comp_k = self._gpu_comp_pool['k']\n        comp_v = self._gpu_comp_pool['v']\n        B = self._block_numel\n\n        # GPU indices on device matching block_ids (int64 for indexing)\n        bid_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=gpu_k.device)\n        physical_slots = [\n            self._assign_kv_slot(layer_id, bid) for bid in block_ids\n        ]\n\n        with torch.cuda.stream(self.comp_stream):\n            # 1. Gather blocks and split into exp/sm\n            k_blocks = gpu_k[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            v_blocks = gpu_v[bid_gpu].reshape(n, B).contiguous().view(\n                torch.bfloat16)\n            self._extract_exp_sm(k_blocks, comp_k['exp'][:n], comp_k['sm'][:n])\n            self._extract_exp_sm(v_blocks, comp_v['exp'][:n], comp_v['sm'][:n])\n\n            # 2. Batch compress exponents per block.\n            #    compress_data returns [N, max_out] contiguous tensor.\n            k_exp_list = list(comp_k['exp'][:n])\n            v_exp_list = list(comp_v['exp'][:n])\n            k_comp_out, k_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, k_exp_list, False, self._workspace,\n                comp_k['comp_exp'][:n], comp_k['sizes'][:n])\n            v_comp_out, v_sizes, _ = torch.ops.dietgpu.compress_data(\n                False, v_exp_list, False, self._workspace,\n                comp_v['comp_exp'][:n], comp_v['sizes'][:n])\n\n            # 3. D2H sizes (small) — these are used on the wait path.\n            k_sizes_pinned = self._sizes_pinned_k[:n]\n            v_sizes_pinned = self._sizes_pinned_v[:n]\n            k_sizes_pinned.copy_(k_sizes, non_blocking=True)\n            v_sizes_pinned.copy_(v_sizes, non_blocking=True)\n\n            # 4. D2H compressed exp rows (full row copies — ~max_comp_size/block,\n            #    padding waste bounded).  Host target is indexed by block_id so\n            #    must be a gather-scatter copy: we loop (OK — async on stream).\n            host_k = self._host_pools[layer_id]['k']\n            host_v = self._host_pools[layer_id]['v']\n            gpu_k_comp = comp_k['comp_exp'][:n]\n            gpu_v_comp = comp_v['comp_exp'][:n]\n            gpu_k_sm = comp_k['sm'][:n]\n            gpu_v_sm = comp_v['sm'][:n]\n            for i, slot in enumerate(physical_slots):\n                host_k['comp_exp'][slot].copy_(\n                    gpu_k_comp[i], non_blocking=True)\n                host_v['comp_exp'][slot].copy_(\n                    gpu_v_comp[i], non_blocking=True)\n                host_k['sm'][slot].copy_(gpu_k_sm[i], non_blocking=True)\n                host_v['sm'][slot].copy_(gpu_v_sm[i], non_blocking=True)\n\n            event = self.comp_stream.record_event()\n\n        self._pending_compress[layer_id] = {\n            'event': event,\n            'buffer_ids': list(block_ids),\n            'physical_slots': physical_slots,\n            'k_sizes_pinned': k_sizes_pinned,\n            'v_sizes_pinned': v_sizes_pinned,\n        }\n\n    def has_compressed_kv(self, layer_id: int) -> bool:\n        return layer_id in self._compressed_kv\n\n    # Identity-keyed cache for the list->numpy conversion of the per-step\n    # active id list (the SAME list object is passed for every layer of a\n    # step).  Class-level defaults so subclasses that don't chain __init__\n    # (e.g. P4Flat) inherit them.  Holding the key keeps the cached list\n    # alive so its identity cannot be recycled.\n    _ids_np_key = None\n    _ids_np_val = None\n    # Per-step cache for the in-range filtered array in has_persistent_compressed_kv.\n    # Class-level defaults so subclasses (P4Flat etc.) inherit them.\n    _has_pk_ab = None\n    _has_pk_vlen = None\n    _has_pk_sel = None\n\n    def _ids_np(self, block_ids) -> \"np.ndarray\":\n        if block_ids is self._ids_np_key:\n            return self._ids_np_val\n        ab = (block_ids if isinstance(block_ids, np.ndarray)\n              else np.asarray(block_ids, dtype=np.int64))\n        self._ids_np_key = block_ids\n        self._ids_np_val = ab\n        return ab\n\n    def has_persistent_compressed_kv(self, layer_id: int,\n                                     block_ids: list) -> bool:\n        # Called once per layer per step with the full active set; the old\n        # ``any(valid[bid] for bid in block_ids)`` generator walked every id\n        # in Python (~300 µs at ~4k ids, inside the nsys decompress_persistent\n        # range).  Vectorized: one cached np view + fancy-index + .any().\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(block_ids) == 0:\n            return False\n        va = np.frombuffer(valid, dtype=np.uint8)   # bytearray view, no copy\n        ab = self._ids_np(block_ids)\n        # The in-range filtered set depends only on (block_ids, vlen) — both\n        # are identical across all ~80 layers per step.  Cache the filtered\n        # array so we don't allocate 3 numpy arrays (two bool + one int64)\n        # per layer (was ~240 numpy objects/step).\n        vlen = va.size\n        if (getattr(self, \"_has_pk_ab\", None) is ab\n                and getattr(self, \"_has_pk_vlen\", None) == vlen):\n            sel = self._has_pk_sel\n        else:\n            sel = ab[(ab >= 0) & (ab < vlen)]\n            self._has_pk_ab = ab\n            self._has_pk_vlen = vlen\n            self._has_pk_sel = sel\n        return bool(va[sel].any()) if sel.size else False\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        valid = self._persistent_valid.get(layer_id)\n        if valid is not None and 0 <= block_id < len(valid):\n            valid[block_id] = 0\n        self._free_kv_slot(layer_id, block_id)\n\n    def decompress_batch(\n        self, layer_id: int,\n        active_block_ids: list,\n        output_buffers: \"tuple[torch.Tensor, torch.Tensor]\",\n    ) -> None:\n        \"\"\"KV-path batch decompress.\n\n        ``output_buffers`` is a 2-tuple ``(k_cache, v_cache)`` whose\n        ``[block_id]`` slots receive the decompressed BF16 results.\n\n        This class is KV-only and overrides the abstract\n        ``TensorCompressor.decompress_batch`` with this KV-specific\n        signature — calling with ``(comps, outputs)`` (the weight-path\n        signature) raises :class:`TypeError` from the unpacking below\n        rather than the abstract NotImplementedError stub.\n        \"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None:\n            return\n        num_primary = k_cache.shape[0]\n        vlen = len(valid)\n        filtered = [bid for bid in active_block_ids\n                    if 0 <= bid < num_primary and bid < vlen and valid[bid]]\n        if not filtered:\n            return\n        filtered.sort()\n        gpu_cap = self._max_gpu_decomp_blocks\n        for start in range(0, len(filtered), gpu_cap):\n            batch = filtered[start:start + gpu_cap]\n            self._decompress_blocks(layer_id, batch, k_cache, v_cache)\n\n    def start_kv_h2d_persistent(\n        self,\n        layer_id: int,\n        active_block_ids: list,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> bool:\n        \"\"\"Queue this backend's persistent H2D and dense decode work.\n\n        DietGPU-family codecs combine their H2D and decode in\n        ``decompress_batch`` on ``batch_decomp_stream``.  Exposing the common\n        split-phase loader contract lets the V1 wrapper use the same ordering\n        as P4Flat/ZipServ; the corresponding finish method is intentionally a\n        no-op because all work is already queued here.\n        \"\"\"\n        self.decompress_batch(\n            layer_id,\n            active_block_ids,\n            output_buffers=(k_cache, v_cache),\n        )\n        return True\n\n    def finish_kv_decompress_persistent(\n        self,\n        layer_id: int,\n        k_cache: torch.Tensor,\n        v_cache: torch.Tensor,\n    ) -> None:\n        \"\"\"Complete the common split-phase API (work queued by ``start``).\"\"\"\n        return\n\n    # ------------------------------------------------------------------\n    #  Core decompress kernel\n    # ------------------------------------------------------------------\n\n    def _decompress_blocks(self, layer_id: int,\n                           block_ids: list,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            # Recurse via caller chunking; defensive guard\n            raise RuntimeError(\n                f\"DietGPU KV decompress: n={n} exceeds \"\n                f\"max_gpu_decomp_blocks={self._max_gpu_decomp_blocks}\")\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        decomp_k = self._gpu_decomp_pool['k']\n        decomp_v = self._gpu_decomp_pool['v']\n        B = self._block_numel\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            # 1. H2D compressed exp + sm rows per block (loop, async).\n            gpu_k_comp = decomp_k['comp_exp'][:n]\n            gpu_v_comp = decomp_v['comp_exp'][:n]\n            gpu_k_sm = decomp_k['sm'][:n]\n            gpu_v_sm = decomp_v['sm'][:n]\n            physical_slots = []\n            for i, bid in enumerate(block_ids):\n                slot = self._get_kv_slot(layer_id, bid)\n                if slot < 0:\n                    raise RuntimeError(\n                        f\"DietGPU KV: no compressed slot for \"\n                        f\"layer={layer_id} bid={bid}\")\n                physical_slots.append(slot)\n                gpu_k_comp[i].copy_(\n                    host_k['comp_exp'][slot], non_blocking=True)\n                gpu_v_comp[i].copy_(\n                    host_v['comp_exp'][slot], non_blocking=True)\n                gpu_k_sm[i].copy_(host_k['sm'][slot], non_blocking=True)\n                gpu_v_sm[i].copy_(host_v['sm'][slot], non_blocking=True)\n\n            # 2. Build per-block views sized by actual compressed length.\n            k_in_list: List[torch.Tensor] = []\n            v_in_list: List[torch.Tensor] = []\n            k_out_list: List[torch.Tensor] = []\n            v_out_list: List[torch.Tensor] = []\n            for i, slot in enumerate(physical_slots):\n                ksz = int(host_k['exp_sizes'][slot].item())\n                vsz = int(host_v['exp_sizes'][slot].item())\n                k_in_list.append(gpu_k_comp[i, :ksz])\n                v_in_list.append(gpu_v_comp[i, :vsz])\n                k_out_list.append(decomp_k['exp'][i])\n                v_out_list.append(decomp_v['exp'][i])\n\n            torch.ops.dietgpu.decompress_data(\n                False, k_in_list, k_out_list, False, self._workspace)\n            torch.ops.dietgpu.decompress_data(\n                False, v_in_list, v_out_list, False, self._workspace)\n\n            # 3. Reconstruct BF16 from exp + sm using fused Triton kernel.\n            k_bf16 = self._bf16_decomp_out['k'][:n]\n            v_bf16 = self._bf16_decomp_out['v'][:n]\n            dietgpu_reconstruct(\n                decomp_k['exp'][:n].view(n * B),\n                gpu_k_sm.view(n * B),\n                k_bf16.view(n * B))\n            dietgpu_reconstruct(\n                decomp_v['exp'][:n].view(n * B),\n                gpu_v_sm.view(n * B),\n                v_bf16.view(n * B))\n\n            # 4. Scatter into cache.\n            bid_gpu = torch.as_tensor(\n                block_ids, dtype=torch.long, device=k_cache.device)\n            k_cache[bid_gpu] = k_bf16.reshape(n, *self._block_shape)\n            v_cache[bid_gpu] = v_bf16.reshape(n, *self._block_shape)\n\n    # ------------------------------------------------------------------\n    #  TensorCompressor weight-path abstract methods (KV-only backend)\n    # ------------------------------------------------------------------\n    #\n    # This class is the ``kv_compressor`` of DualMemoryLoader and never\n    # plays the ``weight_compressor`` role; the weight-side methods are\n    # required by the abstract base but unused here.\n\n    def _weight_path_unsupported(self, name: str):\n        raise NotImplementedError(\n            f\"{type(self).__name__} is KV-only; the weight-path method \"\n            f\"{name!r} is not implemented.  Use a weight-side \"\n            \"TensorCompressor (e.g. DietGPUCompressor / ZipServCompressor) \"\n            \"for weight compression.\")\n\n    def compress(self, weight, decomp_output_tensor=None,\n                 comp_output_tensor=None, _sync=True):\n        self._weight_path_unsupported(\"compress\")\n\n    def decompress(self, comp, output=None):\n        self._weight_path_unsupported(\"decompress\")\n\n    def compress_batch(self, weights, decomp_output_tensors=None,\n                       comp_output_tensors=None, _sync=True):\n        self._weight_path_unsupported(\n            \"compress_batch (sync) — use compress_batch_async for the \"\n            \"KV pipeline path\")\n\n    # NB: ``decompress_batch`` is overridden above with a KV-specific\n    # signature (layer_id, block_ids, output_buffers).  No NotImplementedError\n    # stub here — the abstract requirement is satisfied by the KV impl.\n"},"started_at_ms":1788166660621,"completed_at_ms":1788166660621}}
{"timestamp":"2026-08-31T08:57:40.625Z","ordinal":4883,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05709-e211-76b0-9ffe-b866eea09efa","call_id":"call_yREwzj3iteHW9a9wbYy9Z0U4","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"DietGPU KV cache compressor.\n\nProvides a drop-in replacement for ``ZipServCompressor`` when used as the\n``kv_compressor`` in ``DualMemoryLoader``.  Uses the DietGPU raw ANS codec\n(exponent-only compression + raw sign|mantissa storage) for BF16 KV cache\nblocks.\n\nInterface parity with ZipServCompressor's KV methods (the subset that is\nexercised from ``DualMemoryLoader``, ``kv_offload_system`` and\n``v1_cuda_graph_wrapper``):\n\n- ``batch_decomp_stream`` attribute\n- ``warmup_kv_buffers(block_shape, max_n_blocks, n_layers, ...)``\n- ``init_kv_compress_workers(n_workers, max_blocks, n_layers)``\n- ``compress_batch_async(layer_id, block_ids, gpu_k, gpu_v)``\n- ``wait_compress_async(layer_id, block_shape, timeout_sec)``\n- ``stop_kv_compress_workers()``\n- ``has_compressed_kv(layer_id)`` / ``_compressed_kv`` dict\n- ``has_persistent_compressed_kv(layer_id, block_ids)``\n- ``decompress_batch(layer_id, block_ids, output_buffers=(k_cache, v_cache))``\n- ``free_persistent_block(layer_id, block_id)``\n\nUnlike ZipServ, there is no C++ worker thread pool — DietGPU compresses\nentirely on GPU, so ``compress_batch_async`` simply launches the\ncompress + D2H pipeline on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.\n\nStorage layout (per layer, per K and V):\n  - ``comp_exp`` : pinned [max_n_blocks, max_comp_size] uint8 row-major by\n    physical slot.  Actual per-block payload length tracked in ``exp_sizes``.\n  - ``sm``       : pinned [max_n_blocks, block_bytes] uint8 row-major by\n    physical slot.\n  - ``exp_sizes``: pinned [max_n_blocks] int32 — per-slot compressed size.\n  - ``_kv_slot`` : block_id -> physical slot.  Slots [0, active_count) are\n    kept dense via eager swap-with-last on free.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Any, Dict, List, Optional, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.tensor_compressor import _ensure_dietgpu_loaded\n\nlogger = logging.getLogger(__name__)\n\n\n# DietGPU ANS worst-case compressed size for a batch of equal-size inputs.\n# Mirrors ``getMaxCompressedSize`` from dietgpu/ans/GpuANSEncode.cu which is\n# roughly ``overhead + max_block_size_coalesced * ceil(N / 4096)`` where each\n# 4096-byte block can expand to ~2x of its input in the coalesced layout.\n# Use a conservative bound of ``2 * N + 16 KiB`` rounded to 128 B.\ndef _max_comp_size(uncompressed_bytes: int) -> int:\n    size = uncompressed_bytes * 2 + 16 * 1024\n    return (size + 127) & ~127\n\n\nclass DietGPUKVCompressor(TensorCompressor):\n    \"\"\"DietGPU-based KV cache compressor.\n\n    Inherits :class:`TensorCompressor` so that\n    :class:`tiered_serve.dual_memory_loader.DualMemoryLoader` can hold\n    ``weight_compressor`` and ``kv_compressor`` as uniformly-typed\n    :class:`TensorCompressor` instances.\n\n    The single-tensor weight API (``compress`` / ``decompress`` /\n    ``compress_batch`` / ``decompress_batch``) is **not** implemented —\n    this backend is KV-only and exposes its work through KV-specific\n    batch methods (``compress_batch_async`` / ``wait_compress_async`` /\n    ``decompress_batch``).  Calls to the weight API raise\n    :class:`NotImplementedError`.\n    \"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream,\n                 workspace_bytes: int = 384 * 1024 * 1024):\n        _ensure_dietgpu_loaded()\n        # TensorCompressor.__init__ sets up comp_stream/decomp_stream\n        # defaults; we overwrite comp_stream below with the caller's.\n        super().__init__(comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self._workspace = torch.empty(\n            [workspace_bytes], dtype=torch.uint8, device=\"cuda\")\n\n        # Per-layer transient state populated by ``compress_batch_async``\n        # and committed by ``wait_compress_async`` so downstream readers\n        # (e.g. DualMemoryLoader's persistent decompress path) can see\n        # which buffer_ids were just written into the host pool.\n        self._compressed_kv: Dict[int, Any] = {}\n\n        # Persistent compressed store bookkeeping.\n        # ``_persistent_valid[layer_id]`` is a bytearray of length max_n_blocks\n        # where 1 means \"this block has compressed data in the host pool\".\n        self._persistent_valid: Dict[int, bytearray] = {}\n        # Per-layer compressed-row slot mapping.  Unlike the logical vLLM block\n        # id, physical slots are compacted eagerly on free so the host store\n        # remains a dense prefix.\n        self._kv_slot: Dict[int, torch.Tensor] = {}\n        self._kv_slot_block: Dict[int, List[int]] = {}\n        self._kv_active_count: Dict[int, int] = {}\n\n        self._kv_pools_ready = False\n        # Per-layer host pools: {layer_id: {'k': pool_dict, 'v': pool_dict}}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        # GPU staging pools for compress output (shared across layers):\n        # {'k': ..., 'v': ...} each with comp_exp[N,S] uint8, sm[N,B] uint8,\n        # sizes[N] int32\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        # GPU staging pools for decompress input\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n\n        self._block_numel: int = 0              # elements per block (BF16)\n        self._block_bytes: int = 0              # bytes per block (uint8 view)\n        self._max_comp_size: int = 0            # per-block compressed stride\n        self._block_shape: Tuple[int, ...] = ()\n        self._max_n_blocks: int = 0\n        self._max_gpu_blocks: int = 0\n        self._max_gpu_decomp_blocks: int = 0\n        self._n_layers: int = 0\n\n        # Pending async compress state for wait_compress_async.\n        # {layer_id: {'event': CUDA event, 'buffer_ids': list, ...}}\n        self._pending_compress: Dict[int, Dict[str, Any]] = {}\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _compute_max_comp_size(self, block_bytes: int) -> int:\n        \"\"\"Worst-case compressed bytes for one ``block_bytes``-row.\n        Subclasses (e.g. MantExp with non-DietGPU codec) may override.\n        \"\"\"\n        _probe = torch.empty(block_bytes, dtype=torch.uint8, device='cuda')\n        _rows, mcs = torch.ops.dietgpu.max_any_compressed_output_size([_probe])\n        del _probe\n        return (int(mcs) + 127) & ~127\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        \"\"\"Pre-allocate flat per-block buffers for KV compress/decompress.\"\"\"\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        # BF16 -> 2 bytes per element; but we split into two uint8 streams\n        # (exp and sm), each ``block_numel`` bytes long.\n        block_bytes = block_numel\n        # Worst-case per-row compressed size.  Subclasses may override\n        # ``_compute_max_comp_size`` to use a different codec.\n        max_comp_size = self._compute_max_comp_size(block_bytes)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._block_bytes = block_bytes\n        self._max_comp_size = max_comp_size\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            \"\"\"Allocate a pinned host pool for one (layer, kv) slot.\"\"\"\n            pool = {}\n            specs = {\n                'comp_exp':  ((host_n, max_comp_size), torch.uint8),\n                'sm':        ((host_n, block_bytes),   torch.uint8),\n                'exp_sizes': ((host_n,),               torch.int32),\n            }\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            # flatten to 1-D to match allocator API\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(\n                        *shape, dtype=dtype, device='cpu').pin_memory()\n                pool[name] = t\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            # Accept pre-allocated pools (must match the DietGPU layout).\n            self._host_pools = pre_allocated_host_pools\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging pools (one set each for compress, decompress).\n        def _alloc_gpu_pool(n_blocks: int) -> Dict[str, torch.Tensor]:\n            return {\n                'comp_exp':  torch.empty(\n                    n_blocks, max_comp_size, dtype=torch.uint8,\n                    device='cuda'),\n                'sm':        torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'exp':       torch.empty(\n                    n_blocks, block_bytes, dtype=torch.uint8,\n                    device='cuda'),\n                'sizes':     torch.empty(\n                    n_blocks, dtype=torch.int32, device='cuda'),\n            }\n\n        self._gpu_comp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_blocks + 1),\n        }\n        self._gpu_decomp_pool = {\n            'k': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n            'v': _alloc_gpu_pool(max_gpu_decomp_blocks + 1),\n        }\n\n        # Pinned sizes scratch for D2H of per-block compressed lengths.\n        self._sizes_pinned_k = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n        self._sizes_pinned_v = torch.empty(\n            max_gpu_blocks + 1, dtype=torch.int32, device='cpu').pin_memory()\n\n        # Pinned BF16 decompressed output (matching ZipServ's decomp output).\n        self._bf16_decomp_out = {\n            'k': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n            'v': torch.empty(\n                max_gpu_decomp_blocks, block_numel,\n                dtype=torch.bfloat16, device='cuda'),\n        }\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._kv_slot = {\n            lid: torch.full((host_n,), -1, dtype=torch.int32)\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {\n            lid: [-1] * host_n for lid in range(n_layers)\n        }\n        self._kv_active_count = {\n            lid: 0 for lid in range(n_layers)\n        }\n\n        self._kv_pools_ready = True\n\n        host_bytes = 0\n        for layer_pools in self._host_pools.values():\n            for kv_pool in layer_pools.values():\n                for t in kv_pool.values():\n                    host_bytes += t.nbytes\n        gpu_bytes = 0\n        for p in list(self._gpu_comp_pool.values()) + list(\n                self._gpu_decomp_pool.values()):\n            for t in p.values():\n                gpu_bytes += t.nbytes\n        logger.info(\n            \"DietGPU KV buffers warmed up: block_shape=%s, block_numel=%d, \"\n            \"max_comp_size=%d, max_n_blocks=%d, max_gpu_comp=%d, \"\n            \"max_gpu_decomp=%d, n_layers=%d, host=%.1fMB, gpu_staging=%.1fMB\",\n            block_shape, block_numel, max_comp_size, max_n_blocks,\n            max_gpu_blocks, max_gpu_decomp_blocks, n_layers,\n            host_bytes / 1024**2, gpu_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  C++-style compress API (no-op worker pool, GPU-only compression)\n    # ------------------------------------------------------------------\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        \"\"\"No-op for DietGPU — compression runs synchronously on GPU.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n        logger.info(\n            \"DietGPU KV: skipping C++ worker init \"\n            \"(compression runs on GPU, n_workers=%d ignored)\", n_workers)\n\n    def stop_kv_compress_workers(self) -> None:\n        pass\n\n    def compress_batch_async(self, layer_id: int,\n                                 block_ids: list,\n                                 gpu_k: torch.Tensor,\n                                 gpu_v: torch.Tensor) -> None:\n        \"\"\"Launch async GPU compress + D2H for a layer's blocks.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async requires warmup_kv_buffers first\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(gpu_k.shape[1:]))\n        self._launch_compress(layer_id, block_ids, gpu_k, gpu_v)\n\n    def wait_compress_async(self, layer_id: int,\n                             block_shape: tuple,\n                             timeout_sec: float = -1.0) -> None:\n        \"\"\"Synchronise the launched compress/D2H and register persistent meta.\"\"\"\n        state = self._pending_compress.pop(layer_id, None)\n        if state is None:\n            return\n        event = state['event']\n        event.synchronize()\n\n        buffer_ids = state['buffer_ids']\n        physical_slots = state.get('physical_slots')\n        if physical_slots is None:\n            physical_slots = [\n                self._assign_kv_slot(layer_id, bid) for bid in buffer_ids\n            ]\n        n = len(buffer_ids)\n        if n == 0:\n            return\n        k_sizes_pinned = state['k_sizes_pinned']\n        v_sizes_pinned = state['v_sizes_pinned']\n\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n        exp_sz_k = host_k['exp_sizes']\n        exp_sz_v = host_v['exp_sizes']\n        # Commit per-block exp sizes into host persistent metadata.\n        for i, slot in enumerate(physical_slots):\n            exp_sz_k[slot] = int(k_sizes_pinned[i].item())\n            exp_sz_v[slot] = int(v_sizes_pinned[i].item())\n\n        pv = self._persistent_valid[layer_id]\n        for bid in buffer_ids:\n            pv[bid] = 1\n\n        # Populate transient _compressed_kv for old-path compat\n        # (consumers pop this after their own use).\n        self._compressed_kv[layer_id] = {\n            'buffer_ids': list(buffer_ids),\n            'block_shape': block_shape,\n            'n': n,\n        }\n\n    # ------------------------------------------------------------------\n    #  Compress helpers\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        prev_slot = int(slot_tbl[bid].item())\n        if prev_slot >= 0:\n            return prev_slot\n\n        active = self._kv_active_count[layer_id]\n        if active >= len(self._kv_slot_block[layer_id]):\n            raise RuntimeError(\n                f\"DietGPU KV: persistent slot pool full for layer={layer_id}\")\n        slot_tbl[bid] = active\n        self._kv_slot_block[layer_id][active] = bid\n        self._kv_active_count[layer_id] = active + 1\n        return active\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_tbl = self._kv_slot[layer_id]\n        if not 0 <= bid < slot_tbl.numel():\n            return -1\n        return int(slot_tbl[bid].item())\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['comp_exp'][dst_slot].copy_(pool['comp_exp'][src_slot])\n            pool['exp_sizes'][dst_slot] = pool['exp_sizes'][src_slot]\n            if 'sm' in pool:\n                pool['sm'][dst_slot].copy_(pool['sm'][src_slot])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        slot_tbl =