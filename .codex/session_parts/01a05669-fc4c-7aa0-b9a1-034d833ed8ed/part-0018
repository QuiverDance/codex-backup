ool_diag.so\\n?? tests/test_kv_prefill_load_policy.py\\n?? tests/test_prefill_weight_stream_policy.py\\n?? tests/test_tp3_cd3_weight_compression.py\\n?? tiered_serve/compression/core/tp3_cd3.py\\n?? tiered_serve/compression/cuda/tp3_cd3.cu\\n?? tiered_serve/compression/cuda/tp3_cd3_ext.cpp\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Unified codec decision benchmark for the tiered-serving weight path.\\n\\nFor each compressor codec (zipserv / p4flat / ublb_flat) and each Llama-3.1-70B\\nprojection (qkv, o, gate_up, down) this measures the data needed to calibrate\\nthe serving strategy, per token count N, between three choices:\\n\\n  1. fused             — decompress + GEMM in one kernel (no dense HBM write)\\n  2. decomp-then-GEMM  — decompress to a dense bf16 weight, then cuBLAS\\n  3. raw bf16 load     — skip compression, GEMM the dense bf16 weight directly\\n                         (the compute floor; its load cost = raw_bytes / BW is\\n                         estimated from the reported ratio)\\n\\nReported per (codec, proj):\\n  * compress time, decompress time, compression ratio + compressed bytes\\nReported per (codec, layer, proj, N), under TWO conditions — isolated and with a\\nconcurrent H2D memcpy running (mimicking the next layer's weight offload):\\n  * raw GEMM, decomp+GEMM, fused latency P50/P95\\n\\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\\nfused has no dense write and is contention-immune. An isolated sweep therefore\\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\\n\\nTo characterise the fused KERNEL at every N (so production thresholds can be\\ncalibrated), the per-codec production N-thresholds are forced wide open.\\n\\nUsage:\\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\\n  ... --synthetic --check --n-values 1,64,256\\n  ... --csv codec_decision.csv\\n  ... --codecs zipserv,p4flat --projs o,gate_up\\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\\n\\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\\nlink, adding two iso/h2d column groups:\\n\\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\\n                the SMs, no dense-weight HBM staging at all.\\n\\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\\nalike.  See\\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport ctypes\\nimport glob\\nimport logging\\nimport os\\nimport re\\nimport sys\\n\\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\nif _REPO_ROOT not in sys.path:\\n    sys.path.insert(0, _REPO_ROOT)\\n\\nimport torch\\n\\nfrom benchmarks.fused_bench_common import (\\n    H2DContender,\\n    LatencyStats,\\n    add_timing,\\n    bench_cuda,\\n    runtime_metadata,\\n    sha256_file,\\n    sha256_tensor,\\n    write_csv,\\n)\\n\\n# Silence per-compress codec INFO spam (logged once per timed iteration).\\nlogging.getLogger(\\\"tiered_serve\\\").setLevel(logging.WARNING)\\n\\n\\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\\nHIDDEN_SIZE = 8192\\nNUM_Q_HEADS = 64\\nNUM_KV_HEADS = 8\\nHEAD_DIM = 128\\nINTERMEDIATE_SIZE = 28672\\nN_LAYERS = 80\\n\\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\\n\\n\\ndef proj_shapes(tp):\\n    \\\"\\\"\\\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\\n\\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\\n    shard the contraction dim.\\n    \\\"\\\"\\\"\\n    return {\\n        \\\"qkv\\\":     (QKV_OUT // tp,    HIDDEN_SIZE),\\n        \\\"o\\\":       (HIDDEN_SIZE,      Q_DIM // tp),\\n        \\\"gate_up\\\": (GATEUP_OUT // tp, HIDDEN_SIZE),\\n        \\\"down\\\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\\n    }\\n\\n\\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\\n_l2_flush_buf = None\\n\\n\\ndef flush_l2_cache():\\n    global _l2_flush_buf\\n    if _l2_flush_buf is None:\\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\\n                                    device=\\\"cuda\\\")\\n    _l2_flush_buf.zero_()\\n\\n\\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\\n    \\\"\\\"\\\"P50/P95 per-iteration GPU time in an isolated stream.\\\"\\\"\\\"\\n    return bench_cuda(\\n        fn, warmup, iters,\\n        flush_fn=flush_l2_cache if flush else None,\\n    )\\n\\n\\ndef bench_gpu(fn, warmup, iters, flush):\\n    \\\"\\\"\\\"Backward-compatible P50-only wrapper used by older imports.\\\"\\\"\\\"\\n    return bench_gpu_stats(fn, warmup, iters, flush).p50_ms\\n\\n\\ndef bench_compute_stats(fn, warmup, iters, flush, contender=None,\\n                        copies_per_iter=8) -> LatencyStats:\\n    return bench_cuda(\\n        fn, warmup, iters,\\n        flush_fn=flush_l2_cache if flush else None,\\n        contender=contender,\\n        copies_per_iter=copies_per_iter,\\