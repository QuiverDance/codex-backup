{"timestamp":"2026-09-02T09:51:02.456Z","ordinal":17649,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a06186-6325-79b3-9454-03c11387a0a9","item":{"type":"CommandExecution","id":"exec-b01d7ce2-047c-428c-904a-44e4cbd027a7","process_id":"24060","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,240p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"360,640p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"930,1100p\" tiered_serve/chunk_delta3_kv_compressor.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,240p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"360,640p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"930,1100p\" tiered_serve/chunk_delta3_kv_compressor.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"ChunkDelta3 backend for persistent offloaded KV blocks.\n\nThe weight codec stores a variable number of Packed20 exceptions.  KV slots\nuse a fixed, configurable exception capacity so every block has a stable host\nrow and batched H2D/D2H remains possible.  A true count is retained per slot;\ncapacity overflow is detected before the block is published.\n\"\"\"\nfrom __future__ import annotations\n\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nfrom typing import Any, Dict, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    _HAS_CHUNK_DELTA3,\n    _cd3_ext,\n)\n\n\nlogger = logging.getLogger(__name__)\n\n\ndef _align_up(value: int, alignment: int) -> int:\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Choose a compact 64-aligned 2-D view for one KV block.\"\"\"\n    if numel <= 0 or numel % 4096:\n        raise ValueError(\n            f\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\")\n    root = int(numel ** 0.5)\n    for k in range((root // 64) * 64, 63, -64):\n        if numel % k == 0 and (numel // k) % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\n    \"\"\"Persistent CD3 KV storage and batched GPU decode implementation.\"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"decompress_chunk_delta3_batched_blob_pair_stream\"):\n            raise RuntimeError(\n                \"ChunkDelta3 requires the stream-aware batched decoder\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Two-stream event/ring overhead dominates very small copies.  Select\n        # the pipelined path only once there is enough work to hide; the value\n        # is deliberately exposed as a hardware-tuning knob.\n        self._kv_split_min_blocks = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BLOCKS\", \"256\")))\n        self._dec_blob_ring_idx = 0\n        self._gpu_decomp_pool_ring = []\n        self._dec_blob_consumed = []\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._blob_stride = 0\n        self._blob_layout = {}\n        self._max_n_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n        self._identity_slots_gpu = None\n        self._decode_generation = {}\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        # The loader computes one canonical active KV set per forward and then\n        # passes the same Python list to every layer.  Compare that set once at\n        # the step boundary instead of running np.array_equal in every layer's\n        # decompress_batch call.  The held list reference makes the identity\n        # check generation-safe (CPython cannot recycle its id while held).\n        self._prepared_active_list = None\n        self._prepared_active_candidates = None\n        self._prepared_active_version = 0\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\n\n        result = compressed_block_bytes(\"chunk_delta3\", block_elements)\n        assert result is not None\n        return result\n\n    def _build_blob_layout(self) -> None:\n        layout = {}\n        offset = 0\n        for name, width, dtype, alignment in (\n            (\"codes\", self._code_bytes, torch.uint8, 1),\n            (\"sign_mantissa\", self._block_numel, torch.uint8, 1),\n            (\"thread_bases\", self._base_bytes, torch.uint8, 1),\n            (\"tile_exception_offsets\", self._tiles_per_block + 1,\n             torch.int32, 4),\n            (\"entries20x3\", self._packed_capacity, torch.int64, 8),\n            (\"num_exceptions\", 1, torch.int32, 4),\n        ):\n            offset = _align_up(offset, alignment)\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\n            layout[name] = (offset, nbytes, width, dtype)\n            offset += nbytes\n        self._blob_stride = _align_up(offset, 128)\n        self._blob_layout = layout\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            # A configured serving allocator has already budgeted the CD3 KV\n            # pool.  Falling through to weight pages or a large pinned tensor\n            # hides planner errors and can OOM the host much later in warmup.\n            return huge_page_allocator.allocate(\n                (numel,), (1,), dtype, page_type=\"kv\").view(shape)\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _pool(self, rows: int, device: str, huge_page_allocator=None,\n              blob_backed: bool = True) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        if not blob_backed and device == \"cuda\":\n            return {\n                name: torch.empty(shape, dtype=dtype, device=\"cuda\")\n                for name, (shape, dtype) in specs.items()\n            }\n        if not blob_backed:\n            return {\n                name: self._alloc_host_tensor(\n                    shape, dtype, huge_page_allocator)\n                for name, (shape, dtype) in specs.items()\n            }\n\n        if device == \"cuda\":\n            blob = torch.empty(\n                (rows, self._blob_stride), dtype=torch.uint8, device=\"cuda\")\n        else:\n            blob = self._alloc_host_tensor(\n                (rows, self._blob_stride), torch.uint8,\n                huge_page_allocator)\n        pool = {\"blob\": blob}\n        for name, (offset, nbytes, width, dtype) in self._blob_layout.items():\n            view = blob[:, offset:offset + nbytes]\n            if dtype != torch.uint8:\n                view = view.view(dtype)\n            pool[name] = view[:, 0] if name == \"num_exceptions\" else view\n            assert pool[name].shape == specs[name][0]\n        return pool\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        del max_gpu_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._build_blob_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    @staticmethod\n    def _slot_runs(slots: list[int]):\n        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n        if not slots:\n            return\n        row_begin = 0\n        slot_begin = slots[0]\n        previous = slot_begin\n        for row in range(1, len(slots)):\n            slot = slots[row]\n            if slot != previous + 1:\n                yield row_begin, row, slot_begin\n                row_begin = row\n                slot_begin = slot\n            previous = slot\n        yield row_begin, len(slots), slot_begin\n\n    def _batch_h2d(self, destinations: list[torch.Tensor],\n                   sources: list[torch.Tensor],\n                   stream: torch.cuda.Stream | None = None) -> None:\n        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n        if not destinations:\n            return\n        if len(destinations) == 1:\n            if stream is None:\n                destinations[0].copy_(sources[0], non_blocking=True)\n            else:\n                with torch.cuda.stream(stream):\n                    destinations[0].copy_(sources[0], non_blocking=True)\n            return\n        from tiered_serve.cpp_exts import zipserv_ext\n\n        if not hasattr(zipserv_ext, \"batch_memcpy\"):\n            raise RuntimeError(\"zipserv_ext.batch_memcpy is required for CD3 KV\")\n        zipserv_ext.batch_memcpy(\n            destinations, sources,\n            (torch.cuda.current_stream().cuda_stream\n             if stream is None else stream.cuda_stream))\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode the active set published once at the forward boundary.\"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(active_block_ids) == 0:\n            return\n        if (active_block_ids is not self._prepared_active_list\n                or self._prepared_active_candidates is None):\n            raise RuntimeError(\n                \"ChunkDelta3 KV active set was not prepared before decode\")\n        candidates = self._prepared_active_candidates\n        limit = min(int(k_cache.shape[0]), len(valid))\n        if (candidates.size\n                and (int(candidates[0]) < 0\n                     or int(candidates[-1]) >= limit)):\n            raise RuntimeError(\"ChunkDelta3 KV active block is out of range\")\n        generation = self._decode_generation.get(layer_id, 0)\n        version = self._prepared_active_version\n        cached = self._decode_filtered.get(layer_id)\n        if (cached is not None\n                and cached[0] == generation\n                and cached[3] == version):\n            filtered = cached[2]\n        else:\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\n            filtered = np.ascontiguousarray(\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\n            self._decode_filtered[layer_id] = (\n                generation, candidates, filtered, version)\n        if filtered.size == 0:\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _build_decode_plan(self, layer_id: int,\n                           block_ids: np.ndarray,\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        slot_table = self._kv_slot_np[layer_id]\n        slots_np = np.ascontiguousarray(\n            slot_table[block_ids], dtype=np.int32)\n        if bool((slots_np < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        # The production steady state is dense: all active physical slots are\n        # requested.  Skip Python list conversion and run construction there.\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n        slot_runs = None\n        if dense:\n            packed_h2d = False\n        else:\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\n            max_runs = max(0, int(os.getenv(\n                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n            packed_h2d = (\n                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n                or hwm > self._max_gpu_decomp_blocks + 1)\n\n        slots_gpu = (\n            self._identity_slots_gpu[:n]\n            if packed_h2d else torch.as_tensor(\n                slots_np, dtype=torch.int32, device=k_cache.device))\n        block_ids_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=k_cache.device)\n        copy_destinations_ring = [[], []]\n        copy_sources = []\n        for kv in (\"k\", \"v\"):\n            host_blob = self._host_pools[layer_id][kv][\"blob\"]\n            if packed_h2d:\n                for row_begin, row_end, slot_begin in slot_runs:\n                    length = row_end - row_begin\n                    for ring_index, gpu_pool in enumerate(\n                            self._gpu_decomp_pool_ring):\n                        copy_destinations_ring[ring_index].append(\n                            gpu_pool[kv][\"blob\"][row_begin:row_end])\n                    copy_sources.append(\n                        host_blob[slot_begin:slot_begin + length])\n            else:\n                for ring_index, gpu_pool in enumerate(\n                        self._gpu_decomp_pool_ring):\n                    copy_destinations_ring[ring_index].append(\n                        gpu_pool[kv][\"blob\"][:hwm])\n                copy_sources.append(host_blob[:hwm])\n        storage_rows = n if packed_h2d else hwm\n        return {\n            \"block_ids\": block_ids,\n            \"generation\": self._decode_generation.get(layer_id, 0),\n            \"slots_gpu\": slots_gpu,\n            \"block_ids_gpu\": block_ids_gpu,\n            \"copy_destinations_ring\": copy_destinations_ring,\n            \"copy_sources\": copy_sources,\n            \"storage_rows\": storage_rows,\n        }\n\n    def _launch_decode(self, gpu_pool, plan, k_cache, v_cache) -> None:\n        storage_rows = plan[\"storage_rows\"]\n        _cd3_ext.decompress_chunk_delta3_batched_blob_pair_stream(\n            gpu_pool[\"k\"][\"blob\"][:storage_rows],\n            gpu_pool[\"v\"][\"blob\"][:storage_rows],\n            plan[\"slots_gpu\"],\n            plan[\"block_ids_gpu\"],\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n            self._packed_capacity,\n            self.batch_decomp_stream.cuda_stream,\n        )\n\n    def _decompress_blocks(self, layer_id: int, block_ids,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV decode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_decomp_blocks}\")\n        if self._kv_active_count[layer_id] <= 0:\n            return\n        if not isinstance(block_ids, np.ndarray):\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n        plan = self._decode_plans.get(layer_id)\n        generation = self._decode_generation.get(layer_id, 0)\n        if (plan is None or plan[\"block_ids\"] is not block_ids\n                or plan[\"generation\"] != generation):\n            # CUDA slot/output-index tensors created by plan construction are\n            # consumed by the decode stream, so allocate/stage them there.\n            with torch.cuda.stream(self.batch_decomp_stream):\n                plan = self._build_decode_plan(\n                    layer_id, bloc