orkers(self) -> None:\n        workers = list(getattr(self, \"_workers\", ()))\n        for _ in workers:\n            self._work_queue.put(None)\n        for worker in workers:\n            worker.join()\n        self._workers = []\n","exit_code":0,"duration":{"secs":0,"nanos":7712},"formatted_output":"\"\"\"ChunkDelta3 backend for persistent offloaded KV blocks.\n\nThe weight codec stores a variable number of Packed20 exceptions.  KV slots\nuse a fixed, configurable exception capacity so every block has a stable host\nrow and batched H2D/D2H remains possible.  A true count is retained per slot;\ncapacity overflow is detected before the block is published.\n\"\"\"\nfrom __future__ import annotations\n\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nfrom typing import Any, Dict, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    _HAS_CHUNK_DELTA3,\n    _cd3_ext,\n)\n\n\nlogger = logging.getLogger(__name__)\n\n\ndef _align_up(value: int, alignment: int) -> int:\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Choose a compact 64-aligned 2-D view for one KV block.\"\"\"\n    if numel <= 0 or numel % 4096:\n        raise ValueError(\n            f\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\")\n    root = int(numel ** 0.5)\n    for k in range((root // 64) * 64, 63, -64):\n        if numel % k == 0 and (numel // k) % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\n    \"\"\"Persistent CD3 KV storage and batched GPU decode implementation.\"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"decompress_chunk_delta3_batched_blob_pair_stream\"):\n            raise RuntimeError(\n                \"ChunkDelta3 requires the stream-aware batched decoder\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Two-stream event/ring overhead dominates very small copies.  Select\n        # the pipelined path only once there is enough work to hide; the value\n        # is deliberately exposed as a hardware-tuning knob.\n        self._kv_split_min_blocks = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BLOCKS\", \"256\")))\n        self._dec_blob_ring_idx = 0\n        self._gpu_decomp_pool_ring = []\n        self._dec_blob_consumed = []\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self