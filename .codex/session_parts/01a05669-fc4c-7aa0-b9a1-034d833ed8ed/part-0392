t():\n    global _cudart_lib\n    if _cudart_lib is not None:\n        return _cudart_lib\n    with _cudart_lock:\n        if _cudart_lib is None:\n            lib = None\n            candidates = sorted(glob.glob(os.path.join(\n                os.path.dirname(torch.__file__), \"lib\", \"libcudart*.so*\")))\n            for candidate in candidates:\n                try:\n                    lib = ctypes.CDLL(candidate)\n                    break\n                except OSError:\n                    continue\n            if lib is None:\n                try:\n                    lib = ctypes.CDLL(\"libcudart.so\")\n                except OSError as error:\n                    raise RuntimeError(\n                        \"libcudart is required by the CD3 CPU encoder\") from error\n            _cudart_lib = lib\n    return _cudart_lib\n\n\ndef _sync_cuda_event(handle: int) -> None:\n    if not handle:\n        return\n    lib = _get_cudart()\n    result = lib.cudaEventSynchronize(ctypes.c_void_p(int(handle)))\n    if result != 0:\n        raise RuntimeError(\n        self,\n        layer_id: int,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        block_ids: np.ndarray,\n        slots: np.ndarray,\n        raw_event_handle: int,\n        decode_event_handle: int,\n    ) -> None:\n        self._pin_worker_thread()\n        _sync_cuda_event(raw_event_handle)\n        _sync_cuda_event(decode_event_handle)\n        # A 56-thread team is counterproductive when only 8-64 fresh blocks\n        # exist (the normal serving case).  Shrink the team for small calls;\n        # default eight-worker serving already clamps each worker to seven\n        # CPUs, so this mainly fixes explicit workers=1 deployments.\n        worker_index = int(getattr(self._pin_tls, \"index\", 0))\n        maximum_threads = self._worker_omp_threads.get(\n            worker_index, self._omp_thread_cap)\n        block_count = int(block_ids.size)\n        if block_count <= 8:\n          