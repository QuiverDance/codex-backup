b_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    @staticmethod\n    def _slot_runs(slots: list[int]):\n        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n        if not slots:\n            return\n        row_begin = 0\n        slot_begin = slots[0]\n        previous = slot_begin\n        for row in range(1, len(slots)):\n            slot = slots[row]\n            if slot != previous + 1:\n                yield row_begin, row, slot_begin\n                row_begin = row\n                slot_begin = slot\n            previous = slot\n        yield row_begin, len(slots), slot_begin\n\n    def _batch_h2d(self, destinations: list[torch.Tensor],\n                   sources: list[torch.Tensor],\n                   stream: torch.cuda.Stream | None = None) -> None:\n        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n        if not destinations:\n            return\n        if len(destinations) == 1:\n            if stream is None:\n                destinations[0].copy_(sources[0], non_blocking=True)\n            else:\n                with torch.cuda.stream(stream):\n                    destinations[0].copy_(sources[0], non_blocking=True)\n            return\n        from tiered_serve.cpp_exts import zipserv_ext\n\n        if not hasattr(zipserv_ext, \"batch_memcpy\"):\n            raise RuntimeError(\"zipserv_ext.batch_memcpy is required for CD3 KV\")\n        zipserv_ext.batch_memcpy(\n            destinations, sources,\n            (torch.cuda.current_stream().cuda_stream\n             if stream is None else stream.cuda_stream))\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode the active set published once at the forward boundary.\"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(active_block_ids) == 0:\n            return\n        if (active_block_ids is not self._prepared_active_list\n                or self._prepared_active_candidates is None):\n            raise RuntimeError(\n                \"ChunkDelta3 KV active set was not prepared before decode\")\n        candidates = self._prepared_active_candidates\n        limit = min(int(k_cache.shape[0]), len(valid))\n        if (candidates.size\n                and (int(candidates[0]) < 0\n                     or int(candidates[-1]) >= limit)):\n            raise RuntimeError(\"ChunkDelta3 KV active block is out of range\")\n        generation = self._decode_generation.get(layer_id, 0)\n        version = self._prepared_active_version\n        cached = self._decode_filtered.get(layer_id)\n        if (cached is not None\n                and cached[0] == generation\n                and cached[3] == version):\n            filtered = cached[2]\n        else:\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\n            filtered = np.ascontiguousarray(\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\n            self._decode_filtered[layer_id] = (\n                generation, candidates, filtered, version)\n        if filtered.size == 0:\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _build_decode_plan(self, layer_id: int,\n                           block_ids: np.ndarray,\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        slot_table = self._kv_slot_np[layer_id]\n        slots_np = np.ascontiguousarray(\n            slot_table[block_ids], dtype=np.int32)\n        if bool((slots_np < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        # The production steady state is dense: all active physical slots are\n        # requested.  Skip Python list conversion and run construction there.\n        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n        slot_runs = None\n        if dense:\n            packed_h2d = False\n        else:\n            slot_runs = list(self._slot_runs(slots_np.tolist()))\n            max_runs = max(0, int(os.getenv(\n                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n            pack