ss_chunk_delta3_batched_blob_pair_stream(\n            gpu_pool[\"k\"][\"blob\"][:storage_rows],\n            gpu_pool[\"v\"][\"blob\"][:storage_rows],\n            plan[\"slots_gpu\"],\n            plan[\"block_ids_gpu\"],\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n            self._packed_capacity,\n            self.batch_decomp_stream.cuda_stream,\n        )\n\n    def _decompress_blocks(self, layer_id: int, block_ids,\n                           k_cache: torch.Tensor,\n                           v_cache: torch.Tensor) -> None:\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_decomp_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV decode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_decomp_blocks}\")\n        if self._kv_active_count[layer_id] <= 0:\n            return\n        if not isinstance(block_ids, np.ndarray):\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n        plan = self._decode_plans.get(layer_id)\n        generation = self._decode_generation.get(layer_id, 0)\n        if (plan is None or plan[\"block_ids\"] is not block_ids\n                or plan[\"generation\"] != generation):\n            # CUDA slot/output-index tensors created by plan construction are\n            # consumed by the decode stream, so allocate/stage them there.\n            with torch.cuda.stream(self.batch_decomp_stream):\n                plan = self._build_decode_plan(\n                    layer_id, block_ids, k_cache)\n                self._decode_plans[layer_id] = plan\n\n        split = (self.load_kv_stream is not None\n                 and self._kv_split_h2d_enabled\n                 and n >= self._kv_split_min_blocks)\n        if split:\n            ring_slot = self._dec_blob_ring_idx & 1\n            self._dec_blob_ring_idx += 1\n            gpu_pool = self._g