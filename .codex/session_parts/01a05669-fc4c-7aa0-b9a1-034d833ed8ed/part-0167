e)\\n    args = parser.parse_args()\\n    if args.layer != 40:\\n        raise ValueError(\\\"this benchmark currently records layer 40 only\\\")\\n\\n    shapes = proj_shapes(1)\\n    weights = load_real_projections(\\n        args.weights_dir, shapes, layer=args.layer)\\n    rows = []\\n    print(torch.cuda.get_device_name())\\n    print(\\\"CAO: exponent H2D -> fused GEMM; sign/mantissa resident in HBM\\\")\\n    for codec_name in (\\\"p4flat\\\", \\\"chunk_delta3\\\"):\\n        for proj in (\\\"qkv\\\", \\\"o\\\", \\\"gate_up\\\", \\\"down\\\"):\\n            row = _bench_one(\\n                codec_name, proj, weights[proj], args.n,\\n                args.warmup, args.iterations, not args.no_flush)\\n            rows.append(row)\\n            print(\\n                f\\\"{codec_name:12s} {proj:7s} exp={row['h2d_mib']:7.2f} MiB \\\"\\n                f\\\"H2D={row['h2d_p50_ms']:.3f} ms \\\"\\n                f\\\"fused={row['fused_p50_ms']:.3f} ms \\\"\\n                f\\\"total={row['h2d_fused_p50_ms']:.3f} ms \\\"\\n                f\\\"p95={row['h2d_fused_p95_ms']:.3f} ms\\\")\\n\\n    with open(args.csv, \\\"w\\\", newline=\\\"\\\") as f:\\n        writer = csv.DictWriter(f, fieldnames=list(rows[0]))\\n        writer.writeheader()\\n        writer.writerows(rows)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Shared, allocation-stable helpers for the fused-kernel benchmarks.\\n\\nThe benchmark entry points deliberately keep GEMM orchestration and metadata\\nhere so every run uses the same timing and provenance semantics.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport csv\\nimport gc\\nimport hashlib\\nimport os\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\nimport statistics\\nimport subprocess\\nfrom typing import Any, Callable, Iterable, Mapping, Optional\\n\\nimport torch\\n\\n\\n@dataclass(frozen=True)\\nclass LatencyStats:\\n    \\\"\\\"\\\"CUDA event latency samples and the two published percentiles.\\\"\\\"\\\"\\n\\n    p50_ms: float\\n    p95_ms: float\\n    samples_ms: tuple[float, ...]\\n\\n\\ndef _percentile(values: list[float], q: float) -> float:\\n    \\\"\\\"\\\"Linear percentile matching NumPy's default without adding a dependency.\\\"\\\"\\\"\\n    if not values:\\n        raise ValueError(\\\"cannot compute a percentile of an empty sample\\\")\\n    ordered = sorted(float(v) for v in values)\\n    if len(ordered) == 1:\\n        return ordered[0]\\n    pos = (len(ordered) - 1) * q\\n    lo = int(pos)\\n    hi = min(lo + 1, len(ordered) - 1)\\n    frac = pos - lo\\n    return ordered[lo] * (1.0 - frac) + ordered[hi] * frac\\n\\n\\nclass H2DContender:\\n    \\\"\\\"\\\"Saturate a copy engine without synchronizing the compute stream.\\\"\\\"\\\"\\n\\n    def __init__(self, nbytes: int, max_bytes: int = 256 * 1024 * 1024):\\n        self.nbytes = max(1 << 20, min(int(nbytes), int(max_bytes)))\\n        self.stream = torch.cuda.Stream()\\n        self.host = torch.empty(self.nbytes, dtype=torch.uint8, pin_memory=True)\\n        self.device = torch.empty(self.nbytes, dtype=torch.uint8, device=\\\"cuda\\\")\\n        self._closed = False\\n\\n    def refill(self, copies: int) -> None:\\n        if self._closed:\\n            raise RuntimeError(\\\"H2DContender is closed\\\")\\n        with torch.cuda.stream(self.stream):\\n            for _ in range(copies):\\n                self.device.copy_(self.host, non_blocking=True)\\n\\n    def drain(self) -> None:\\n        self.stream.synchronize()\\n\\n    def close(self) -> None:\\n        \\\"\\\"\\\"Release pinned storage between independently sized benchmark cells.\\n\\n        PyTorch's caching host allocator otherwise retains every differently\\n        sized contender buffer. A long scaling sweep can cross the GH200 pinned\\n        registration limit even though each individual cell fits, causing a\\n        later cudaMemcpyAsync to fail with cudaErrorInvalidValue. Drain before\\n        dropping the tensors, then empty only the host cache; this runs outside\\n        every timed region.\\n        \\\"\\\"\\\"\\n        if self._closed:\\n            return\\n        self.drain()\\n        self._closed = True\\n        self.host = None\\n        self.device = None\\n        self.stream = None\\n        gc.collect()\\n        empty_host_cache = getattr(torch._C, \\\"_host_emptyCache\\\", None)\\n        if empty_host_cache is not None:\\n            empty_host_cache()\\n\\n\\ndef bench_cuda(\\n    fn: Callable[[], Any],\\n    warmup: int,\\n    iters: int,\\n    *,\\n    flush_fn: Optional[Callable[[], None]] = None,\\n    contender: Optional[H2DContender] = None,\\n    copies_per_iter: int = 8,\\n) -> LatencyStats:\\n    \\\"\\\"\\\"Time ``fn`` on the current stream and return P50/P95 in milliseconds.\\n\\n    ``Event.synchronize`` waits only for the measured compute stream.  A global\\n    synchronize here would serialize the optional H2D stream and invalidate the\\n    contention experiment.\\n    \\\"\\\"\\\"\\n    if warmup < 0 or iters <= 0:\\n        raise ValueError(f\\\"warmup must be >=0 and iters >0, got {warmup}/{iters}\\\")\\n    if contender is not None:\\n        contender.refill(copies_per_iter * (warmup + 2))\\n    for _ in range(warmup):\\n        fn()\\n    torch.cuda.current_stream().synchronize()\\n\\n    samples: list[float] = []\\n    for _ in range(iters):\\n        if contender is not None:\\n            contender.refill(copies_per_iter)\\n        if flush_fn is not None:\\n            flush_fn()\\n        begin = torch.cuda.Event(enable_timing=True)\\n        end = torch.cuda.Event(enable_timing=True)\\n        begin.record()\\n        fn()\\n        end.record()\\n        end.synchronize()\\n        samples.append(float(begin.elapsed_time(end)))\\n    if contender is not None:\\n        contender.drain()\\n    return LatencyStats(\\n        p50_ms=float(statistics.median(samples)),\\n        p95_ms=_percentile(samples, 0.95),\\n        samples_ms=tuple(samples),\\n    )\\n\\n\\ndef sha256_file(path: str | os.PathLike[str]) -> str:\\n    digest = hashlib.sha256()\\n    with open(path, \\\"rb\\\") as handle:\\n        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\\\"\\\"):\\n            digest.update(chunk)\\n    return digest.hexdigest()\\n\\n\\ndef sha256_tensor(tensor: torch.Tensor) -> str:\\n    \\\"\\\"\\\"Hash a CPU tensor's exact bytes without changing its dtype or layout.\\\"\\\"\\\"\\n    value = tensor.detach().cpu().contiguous().view(torch.uint8).numpy()\\n    return hashlib.sha256(memoryview(value)).hexdigest()\\n\\n\\ndef _git(repo_root: Path, *args: str) -> bytes:\\n    proc = subprocess.run(\\n        [\\\"git\\\", *args], cwd=repo_root, check=True,\\n        stdout=subprocess.PIPE, stderr=subprocess.PIPE,\\n    )\\n    return proc.stdout\\n\\n\\ndef git_metadata(repo_root: str | os.PathLike[str]) -> dict[str, Any]:\\n    \\\"\\\"\\\"Return commit plus a content-complete, artifact-stable dirty hash.\\n\\n    Tracked modifications are represented by ``git diff HEAD``.  Untracked\\n    files are hashed by path, mode, and content instead of merely hashing the\\n    porcelain filename.  Generated benchmark/log/cache trees are excluded, as\\n    is the optional output root published by the orchestrators, so repeat 1\\n    does not change repeat 2's source identity just by writing artifacts.\\n    \\\"\\\"\\\"\\n    root = Path(repo_root).resolve()\\n    commit = _git(root, \\\"rev-parse\\\", \\\"HEAD\\\").decode().strip()\\n    tracked_status = _git(\\n        root, \\\"status\\\", \\\"--porcelain=v1\\\", \\\"-z\\\", \\\"--untracked-files=no\\\")\\n    tracked_diff = _git(root, \\\"diff\\\", \\\"--binary\\\", \\\"HEAD\\\")\\n    untracked_raw = _git(\\n        root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"-z\\\")\\n\\n    excluded_prefixes = [\\\"benchmark_results/\\\", \\\"logs/\\\", \\\".pytest_cache/\\\"]\\n    output