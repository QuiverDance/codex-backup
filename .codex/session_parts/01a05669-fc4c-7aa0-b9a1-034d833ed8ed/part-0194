    \"tp3_cd3_ext\")\n        super().__init__(comp_stream)\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # Grace serving usually produces only eight newly-full blocks per\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n        # series; eight small teams instead pipeline independent layers across\n        # the same CPU budget.  Retain the established one-worker x86 default.\n        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        compression_cpu_count = len([\n            cpu for cpu in os.sched_getaffinity(0)\n            if cpu >= self._reserve_cores])\n        default_omp_threads = str(max(\n            1, (compression_cpu_count + self._n_workers - 1)\n            // self._n_workers))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._timing_raw_wait = 0.0\n        self._timing_decode_wait = 0.0\n        self._timing_encode = 0.0\n        self._timing_count = 0\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state[\"done\"].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for CD3 KV CPU worker\")\n        error = state.get(\"error\")\n        if error is not None:\n            raise error\n\n    def _pin_worker_thread(self) -> None:\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        with self._pin_lock:\n            index = self._pin_counter % self._n_workers\n            self._pin_counter += 1\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_dynamic(0)\n        if self._pin_workers:\n            compression_cpus = [\n                cpu for cpu in allowed if cpu >= self._reserve_cores]\n            if len(compression_cpus) < self._n_workers:\n                compression_cpus = allowed\n            usable = compression_cpus[:min(\n                len(compression_cpus),\n                self._n_workers * self._omp_thread_cap)]\n            begin = len(usable) * index // self._n_workers\n            end = len(usable) * (index + 1) // self._n_workers\n            affinity = set(usable[begin:end])\n            if not affinity:\n                affinity = {allowed[index % len(allowed)]}\n            try:\n                os.sched_setaffinity(0, affinity)\n            except OSError as error:\n                logger.warning(\n                    \"CD3 compress worker %d affinity failed: %s\",\n                    index, error)\n        else:\n            affinity = set(allowed)\n        omp_threads = min(len(affinity), self._omp_thread_cap)\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(omp_threads))\n        ordered = tuple(sorted(affinity))\n        with self._pin_lock:\n            self._worker_affinities[index] = ordered\n            self._worker_omp_threads[index] = omp_threads\n        logger.info(\n            \"CD3 compress worker %d -> %d CPUs (%d-%d