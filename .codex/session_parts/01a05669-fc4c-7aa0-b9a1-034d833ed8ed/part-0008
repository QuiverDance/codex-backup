ssert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # The experimental benchmark force-opens the threshold.  Keep production\n    # routing disabled until a serving-level crossover has been calibrated.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 0,\n        (8192, 8192): 0,\n        (57344, 8192): 0,\n        (8192, 28672): 0,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is