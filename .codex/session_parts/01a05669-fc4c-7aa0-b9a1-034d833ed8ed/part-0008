    \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"warp_prefixes\",\n        \"entries17\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._