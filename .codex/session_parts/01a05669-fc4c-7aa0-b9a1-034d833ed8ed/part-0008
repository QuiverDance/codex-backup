__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.warp_prefixes,\n            comp._c.entries17,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\"ChunkDe