, cls: Any) -> None:\n    _external_loader[name] = cls\n\n\ndef get_external_loader(name: str) -> Any:\n    return _external_loader.get(name)\n=== NEW KV PROFILE ===\n# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\"\"\"\nKV Cache Exponent Distribution Profiler\n\nValidates whether ZipServ-style TCA-TBE lossless compression is applicable\nto KV cache by profiling BF16 exponent distributions per (layer, head).\n\nZipServ (ASPLOS'26) showed that weight exponents cluster in narrow contiguous\nwindows (~97% coverage with top-7 exponents). This script checks if KV cache\nexhibits the same property, and whether per-head BaseExp improves over\nZipServ's global per-layer BaseExp.\n\nUsage:\n    python -m vllm.benchmarks.kv_cache_exponent_profile \\\n        --model meta-llama/Llama-3.1-8B \\\n        --num-prompts 100 \\\n        --output-dir ./kv_exponent_analysis/\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom collections import defaultdict\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\n\n\ndef extract_layer_index(layer_name: str) -> int:\n    \"\"\"Extract numeric layer index from a module name like\n    'model.layers.5.self_attn.attn'.\"\"\"\n    match = re.search(r\"layers\\.(\\d+)\", layer_name)\n    if match:\n        return int(match.group(1))\n    return -1\n\n\ndef extract_exponents_bf16(tensor: torch.Tensor) -> torch.Tensor:\n    \"\"\"Extract the 8-bit exponent field from BF16 values.\n\n    BF16 layout: [sign(1) | exponent(8) | mantissa(7)]\n    \"\"\"\n    bits = tensor.contiguous().view(torch.int16)\n    return ((bits >> 7) & 0xFF).to(torch.int32)\n\n\ndef find_best_window(histogram: np.ndarray, window_size: int = 7):\n    \"\"\"Find the contiguous exponent window that covers the most values.\n\n    Returns (base_exp, coverage_ratio, window_start).\n    ZipServ defines BaseExp = window_start - 1.\n    \"\"\"\n    total = histogram.sum()\n    if total == 0:\n        return 0, 0.0, 0\n    best_start, best_count = 0, 0\n    for start in range(256 - window_size + 1):\n        count = histogram[start : start + window_size].sum()\n        if count > best_count:\n            best_start, best_count = start, count\n    base_exp = max(best_start - 1, 0)\n    return base_exp, best_count / total, best_start\n\n\ndef check_contiguity(histogram: np.ndarray, top_k: int = 7) -> bool:\n    \"\"\"Check if the top-k most frequent exponents are contiguous.\"\"\"\n    nonzero = np.where(histogram > 0)[0]\n    if len(nonzero) == 0:\n        return True\n    top_indices = np.argsort(histogram)[-top_k:]\n    top_indices_sorted = np.sort(top_indices)\n    # Check if they form a contiguous range\n    if len(top_indices_sorted) <= 1:\n        return True\n    return (top_indices_sorted[-1] - top_indices_sorted[0]) == (\n        len(top_indices_sorted) - 1\n    )\n\n\ndef compute_entropy(histogram: np.ndarray) -> float:\n    \"\"\"Compute Shannon entropy in bits of an exponent distribution.\"\"\"\n    total = histogram.sum()\n    if total == 0:\n        return 0.0\n    probs = histogram[histogram > 0] / total\n    return -np.sum(probs * np.log2(probs))\n\n\nclass KVExponentProfiler:\n    \"\"\"Collects per-(layer, head) exponent histograms from KV cache tensors\n    using PyTorch forward hooks on vLLM Attention modules.\"\"\"\n\n    def __init__(self):\n        # histograms[(layer_idx, head_idx, 'k'|'v')] = np.ndarray[256]\n        self.histograms: dict[tuple, np.ndarray] = defaultdict(\n            lambda: np.zeros(256, dtype=np.int64)\n        )\n        # position-bucketed histograms for massive activation analysis\n        # key: (layer_idx, head_idx, 'k'|'v', 'early'|'late')\n        self.pos_histograms: dict[tuple, np.ndarray] = defaultdict(\n            lambda: np.zeros(256, dtype=np.int64)\n        )\n        self._hooks = []\n        self._token_count = 0\n        self._position_threshold = 4  # tokens 0..3 = \"early\"\n\n    def register_hooks(self, model: nn.Module):\n        \"\"\"Register forward pre-hooks on all Attention modules.\"\"\"\n        from vllm.attention.layer import Attention\n\n        for name, module in model.named_modules():\n            if isinstance(module, Attention):\n                handle = module.register_forward_pre_hook(\n                    self._make_hook(module)\n                )\n                self._hooks.append(handle)\n        print(f\"Registered hooks on {len(self._hooks)} Attention layers\")\n\n    def _make_hook(self, attn_module):\n        \"\"\"Create a pre-hook closure for a specific Attention module.\"\"\"\n        layer_idx = extract_layer_index(attn_module.layer_name)\n        num_kv_heads = attn_module.num_kv_heads\n        head_size = attn_module.head_size\n\n        def hook_fn(module, args):\n            # Attention.forward(query, key, value, output_shape=None)\n            if len(args) < 3:\n                return\n            key = args[1]\n            value = args[2]\n            if key is None or value is None:\n                return\n\n            # key/value shape at this point: [num_tokens, num_kv_heads * head_size]\n            # or already reshaped to [num_tokens, num_kv_heads, head_size]\n            with torch.no_grad():\n                for tensor, kv_type in [(key, \"k\"), (value, \"v\")]:\n                    t = tensor.detach()\n                    if t.dim() == 2:\n                        # [num_tokens, num_kv_heads * head_size]\n                        num_tokens = t.shape[0]\n                        t = t.view(num_tokens, num_kv_heads, head_size)\n                    elif t.dim() == 3:\n                        num_tokens = t.shape[0]\n                    else:\n                        continue\n\n                    if t.dtype != torch.bfloat16:\n                        t = t.to(torch.bfloat16)\n\n                    for head in range(t.shape[1]):\n                        head_data = t[:, head, :]  # [num_tokens, head_size]\n                        exps = extract_exponents_bf16(head_data)\n                        exp_np = exps.cpu().numpy().flatten()\n                        hist, _ = np.histogram(\n                            exp_np, bins=256, range=(0, 256)\n                        )\n                        self.histograms[\n                            (layer_idx, head, kv_type)\n                        ] += hist\n\n                    self._token_count += num_tokens\n\n        return hook_fn\n\n    def remove_hooks(self):\n        for h in self._hooks:\n            h.remove()\n        self._hooks.clear()\n\n    def analyze(self) -> dict:\n        \"\"\"Run full analysis on collected histograms.\"\"\"\n        if not self.histograms:\n            return {\"error\": \"No data collected\"}\n\n        # Organize by layer\n        layers = set()\n        heads = set()\n        for layer_idx, head_idx, kv_type in self.histograms:\n            layers.add(layer_idx)\n            heads.add(head_idx)\n        num_layers = max(layers) + 1 if layers else 0\n        num_heads = max(heads) + 1 if heads else 0\n\n        results = {\n            \"model_info\": {\n                \"num_layers\": num_layers,\n                \"num_kv_heads\": num_heads,\n                \"total_hook_calls_tokens\": self._token_count,\n            },\n            \"per_head\": {},\n            \"per_layer_summary\": {},\n            \"global_summary\": {},\n        }\n\n        # Per-head analysis\n        all_coverages_perhead = []\n        all_coverages_global = []\n        all_entropies = []\n        contiguity_count = 0\n        total_count = 0\n\n        for layer_idx in sorted(layers):\n            layer_key = f\"layer_{layer_idx}\"\n            layer_results = {}\n            layer_hists_k = []\n            layer_hists_v = []\n\n            for head_idx in range(num_heads):\n                for kv_type in [\"k\", \"v\"]:\n                    key = (layer_idx, head_idx, kv_type)\n                    hist = s