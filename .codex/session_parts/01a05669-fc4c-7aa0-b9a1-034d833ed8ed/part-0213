{"timestamp":"2026-09-01T05:28:44.351Z","ordinal":10214,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05b70-f43f-7b52-9b7f-3cd6a145ff43","call_id":"call_9Vg6c4bLcGjVfI2SaDk2aU9F","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"BF16 P4-flat weight compressor.\n\nPer-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa byte.\nOut-of-palette exponents are stored as a separate (index, value) list and\nre-injected by a patch kernel during decompress — so the result is\nbit-exact-equivalent to the original BF16 weight.\n\nCompress runs on the GPU (one CTA per 64×64 tile).  Both compress and\ndecompress are delivered by the native PyTorch C++ extension\n``tiered_serve.cpp_exts.zipserv_p4flat_ext``.  No native fused\ndecompress+MM kernel: ``linear_apply`` falls through to the base class\ndefault (``decompress + F.linear``) which empirically beats every fused\nvariant on real LLM weights for decode-N shapes.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4FlatCompressor disabled: failed to load \"\n        f\"zipserv_p4flat_ext ({type(_e).__name__}: {_e})\")\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass CompressedP4FlatTensor:\n    \"\"\"Container around the native :class:`CompressedP4Flat` struct.\n\n    Mirrors GPU/host tensor fields onto Python instance attrs so the loader\n    can iterate ``_BUFFER_ATTRS`` and stage them through a pool, matching\n    the pattern used by :class:`CompressedZipServFP8GpuTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"headers\", \"codes\", \"sign_mantissa\",\n        \"subtile_codec\",\n        \"exc_indices\", \"exc_values\",\n        \"exc_sorted_indices\", \"exc_sorted_values\",\n        \"exc_group_m\", \"exc_group_offsets\",\n    )\n    # Pre-computed (attr, d_attr) pairs — avoids 10 f-string allocations\n    # per .to() / register_temp_d_tensor call (320 calls/step → 3200 fewer\n    # transient str objects per decode step).\n    _BUFFER_ATTR_D_PAIRS = tuple((a, f\"_d_{a}\") for a in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        # Cached narrow views into GPU staging buffers, created once in\n        # register_temp_d_tensor and reused by every .to() call.  Eliminates\n        # 10 view + 10 setattr(self._c, ...) per .to() call (320 calls/step\n        # → 6400 fewer transient Python objects per decode step).\n        self._h2d_views: Optional[tuple] = None\n        self._h2d_srcs: Optional[tuple] = None\n        self._gpu_buf_cache: Optional[tuple] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def num_groups(self) -> int:\n        return int(self._c.num_groups)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n                               gpu_pool: Optional[Dict[str, torch.Tensor]] = None\n                               ) -> None:\n        \"\"\"Bind decompress destination + per-attr GPU staging slots.\n\n        Pre-creates narrow views into the GPU staging buffers and pushes\n        them into the C struct once, so the per-decode ``.to()`` only does\n        ``copy_`` — no f-strings, no view creation, no per-call setattr.\n        \"\"\"\n        self.output_tensor = temp_d\n        device = temp_d.device\n        views = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            src = getattr(self, attr)\n            if gpu_pool is not None and attr in gpu_pool:\n                dst = gpu_pool[attr]\n            else:\n                dst = torch.empty_like(src, device=device)\n            setattr(self, d_attr, dst)\n            n = src.numel()\n            view = dst[:n] if n > 0 else dst\n            views.append(view)\n            # Set C struct tensor pointer once — the view object is reused\n            # across decode steps, so the pointer never changes.\n            setattr(self._c, attr, view)\n        self._h2d_views = tuple(views)\n        self._h2d_srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n        self._gpu_buf_cache = None  # invalidate get_gpu_buffers cache\n\n    def to_host(self, huge_page_allocator=None\n                ) -> \"CompressedP4FlatTensor\":\n        \"\"\"Move all compressed buffers to pinned/hugepage CPU memory.\"\"\"\n        for attr in self._BUFFER_ATTRS:\n            gpu_tensor = getattr(self, attr)\n            if gpu_tensor.numel() == 0:\n                cpu_tensor = gpu_tensor.to(\"cpu\")\n            elif huge_page_allocator is not None:\n                gpu_tensor = gpu_tensor.contiguous()\n                try:\n                    hp_tensor = huge_page_allocator.allocate(\n                        gpu_tensor.shape, gpu_tensor.stride(),\n                        gpu_tensor.dtype, page_type=\"weight\")\n                    hp_tensor.copy_(gpu_tensor)\n                    cpu_tensor = hp_tensor\n                except (MemoryError, ValueError):\n                    logger.warning(\n                        \"Hugepage exhausted for P4Flat to_host (attr=%s); \"\n                        \"falling back to pinned memory\", attr)\n                    cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            else:\n                cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            setattr(self, attr, cpu_tensor)\n            setattr(self._c, attr, cpu_tensor)\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n        self._h2d_views = None\n        self._h2d_srcs = None\n        self._gpu_buf_cache = None\n        import gc\n        gc.collect()\n        torch.cuda.empty_cache()\n        return self\n\n    def to(self, device=\"cuda\", non_blocking=True) -> None:\n        \"\"\"H2D copy CPU-resident buffers into pre-bound GPU staging slots.\n\n        Hot path: called ~320×/step (4 components × ~80 layers).  Uses\n        pre-cached narrow views and source tensors from\n        ``register_temp_d_tensor`` and dispatches ALL 10 copies in a single\n        C++ call (``batch_h2d``), eliminating 10 Python → C++ frame\n        transitions per call (~2880/step) that were the dominant source of\n        CPython frame data-stack 16 KiB boundary crossings (mmap/munmap).\n        \"\"\"\n        del device\n        views = self._h2d_views\n        if views is None:\n            raise RuntimeError(\n                \"CompressedP4FlatTensor.to(): call register_temp_d_tensor first\")\n        srcs = self._h2d_srcs\n        if srcs is None:\n            srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n            self._h2d_srcs = srcs\n        # Single C++ dispatch: copies all 10 (src, dst) pairs on the current\n        # CUDA stream without leaving this Python frame.\n        _p4f_ext.batch_h2d(srcs, views)\n\n    def get_gpu_buffers(self):\n        cache = self._gpu_buf_cache\n        if cache is not None: