0\t        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n     1\t// Torch bindings for the WGMMA fusion lab (raw / UBLB-flat producers).\n     2\t#include <torch/extension.h>\n     3\t#include <c10/cuda/CUDAStream.h>\n     4\t#include <cuda_bf16.h>\n     5\t#include <cuda_runtime.h>\n     6\t#include <cstdint>\n     7\t\n     8\textern \"C\" cudaError_t raw_pipe_wgmma_launch(\n     9\t    cudaStream_t, const __nv_bfloat16*, const __nv_bfloat16*,\n    10\t    __nv_bfloat16*, int, int, int);\n    11\textern \"C\" cudaError_t u4_rs_wgmma_launch(\n    12\t    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    13\t    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\n    14\textern \"C\" cudaError_t p4_rs_wgmma_launch(\n    15\t    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*, const uint8_t*,\n    16\t    const __nv_bfloat16*, __nv_bfloat16*, float*, int,\n    17\t    const int*, const uint16_t*, int, int, int, int);\n    18\textern \"C\" cudaError_t cd3_rs_wgmma_launch(\n    19\t    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    20\t    const int32_t*, const uint16_t*, const uint8_t*,\n    21\t    const __nv_bfloat16*, __nv_bfloat16*, float*, int, int, int, int);\n    22\textern \"C\" cudaError_t p4_exc_correct_launch(\n    23\t    cudaStream_t, const int*, const uint16_t*, const uint8_t*, const uint8_t*,\n    24\t    const uint8_t*, const uint8_t*, const __nv_bfloat16*, float*,\n    25\t    int64_t, int, int, int);\n    26\textern \"C\" cudaError_t zip_rs_wgmma_launch(\n    27\t    cudaStream_t, const uint64_t*, const uint64_t*, const uint64_t*,\n    28\t    const uint8_t*, int, const uint16_t*, const int*,\n    29\t    const __nv_bfloat16*, __nv_bfloat16*, int, int, int);\n    30\t\n    31\t// C is the COLUMN-major [M,N] output buffer (physically [N,M] row-major):\n    32\t// caller passes a contiguous [N, M] bf16 tensor; element (m,n) lands at n*M+m.\n    33\t// Ws (split_k>1) is an [split_