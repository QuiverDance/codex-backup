leM = 64, kTileK = 64;\n   786\t    using Smem = CD3RSSmem<TileN, Stages>;\n   787\t    extern __shared__ __align__(128) uint8_t raw_smem[];\n   788\t    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n   789\t    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n   790\t\n   791\t    const int tid = static_cast<int>(threadIdx.x);\n   792\t    const int tile_n = static_cast<int>(blockIdx.x);\n   793\t    const int tile_m = static_cast<int>(blockIdx.y);\n   794\t    const int tiles_k = K >> 6;\n   795\t    const int split_idx = static_cast<int>(blockIdx.z);\n   796\t    const int tk_split = tiles_k / split_k;\n   797\t    const int k0 = split_idx * tk_split;\n   798\t\n   799\t    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n   800\t                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n   801\t    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n   802\t                         make_coord(tile_n, _));\n   803\t    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n   804\t    auto tiled_copy = make_tiled_copy(G2S{},\n   805\t        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n   806\t    auto thr_copy = tiled_copy.get_slice(tid);\n   807\t    auto tBgB = thr_copy.partition_S(gB);\n   808\t    auto tBsB = thr_copy.partition_D(sB);\n   809\t\n   810\t    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n   811\t                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n   812\t    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n   813\t                              make_coord(tile_m, tile_n));\n   814\t    auto tiled_mma = make_tiled_mma(MmaOp{});\n   815\t    auto thr_mma = tiled_mma.get_thread_slice(tid);\n   816\t    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n   817\t    clear(tCrC);\n   818\t    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n   819\t\n   820\t    using SmemLayoutA = decltype(tile_to_shape(\n   821\t        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n   822\t        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n   823\t    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n   824\t                                SmemLayoutA{});\n   825\t    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n   826\t    auto cA = make_identity_tensor(make_shape(Int<kTileM>{}, Int<kTileK>{}));\n   827\t    auto tCcA = thr_mma.partition_A(cA);\n   828\t\n   829\t    auto load_b = [&](int k_tile, int pipe) {\n   830\t        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n   831\t    };\n   832\t\n   833\t    auto load_compressed = [&](int k_tile, int st) {\n   834\t        const int tile_idx = tile_m * tiles_k + k_tile;\n   835\t        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\n   836\t        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n   837\t        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\n   838\t        if (tid < 96)\n   839\t            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n   840\t        #pragma unroll\n   841\t        for (int j = 0; j < 2; ++j) {\n   842\t            const int chunk = tid + j * 128;\n   843\t            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\n   844\t        }\n   845\t        if (tid < 16)\n   846\t            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\n   847\t    };\n   848\t\n   849\t    auto build_exception_map = [&](int k_tile, int st) {\n   850\t        const int tile_idx = tile_m * tiles_k + k_tile;\n   851\t        const int begin = tile_offsets_g[tile_idx];\n   852\t        const int end = tile_offsets_g[tile_idx + 1];\n   853\t        smem.s_exc_mask[st][tid] = 0;\n   854\t        __syncthreads();\n   855\t        for (int e = begin + tid; e < end; e += 128) {\n   856\t            const int local = e - begin;\n   857\t            int warp = 0;\n   858\t            #pragma unroll\n   859\t            for (int w = 1; w < 8; ++w)\n   860\t                warp += local >= static_cast<int>(\n   861\t                    warp_prefixes_g[static_cast<int64_t>(tile_idx) * 8 + w]);\n   862\t            const uint32_t entry = cd3_unpack_entry17(entries17_g, e);\n   863\t            const int pos = warp * 512 + static_cast<int>(entry & 0x1ffu);\n   864\t            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 9);\n   865\t            atomicOr(&smem.s_exc_mask[st][pos >> 5], 1u << (pos & 31));\n   866\t        }\n   867\t        __syncthreads();\n   868\t    };\n   869\t\n   870\t    auto decode_regA = [&](int st) {\n   871\t        CUTE_UNROLL\n   872\t        for (int i = 0; i < size(tCrA); ++i) {\n   873\t            auto c = tCcA(i);\n   874\t            const int m = get<0>(c), k = get<1>(c);\n   875\t            const int owner = m * 4 + (k >> 4);\n   876\t            const int item = k & 15;\n   877\t            const int bit = item * 3;\n   878\t            const int byte = owner * 6 + (bit >> 3);\n   879\t            const int shift = bit & 7;\n   880\t            uint16_t packed = smem.s_codes[st][byte];\n   881\t            if (shift > 5)\n   882\t                packed |= static_cast<uint16_t>(smem.s_codes[st][byte + 1]) << 8;\n   883\t            const uint8_t code = static_cast<uint8_t>((packed >> shift) & 7u);\n   884\t            const int pos = m * 64 + k;\n   885\t            const bool is_exception =\n   886\t                (smem.s_exc_mask[st][pos >> 5] >> (pos & 31)) & 1u;\n   887\t            const uint8_t exp = is_exception\n   888\t                ? smem.s_exc_exp[st][pos]\n   889\t                : static_cast<uint8_t>(smem.s_bases[st][owner] + code);\n   890\t            const uint8_t smv = smem.s_sm[st][owner * 16 + item];\n   891\t            const uint16_t bits = static_cast<uint16_t>(\n   892\t                (static_cast<uint16_t>(smv & 0x80u) << 8) |\n   893\t                (static_cast<uint16_t>(exp) << 7) |\n   894\t                static_cast<uint16_t>(smv & 0x7fu));\n   895\t            const __nv_bfloat16 value = __ushort_as_bfloat16(bits);\n   896\t            tCrA(i) = reinterpret_cast<const bfloat16_t&>(value);\n   897\t        }\n   898\t    };\n   899\t\n   900\t    CUTE_UNROLL\n   901\t    for (int s = 0; s < Stages - 1; ++s) {\n   902\t        if (s < tk_split) {\n   903\t            load_b(k0 + s, s);\n   904\t            load_compressed(k0 + s, s);\n   905\t        }\n   906\t        cp_async_fence();\n   907\t    }\n   908\t\n   909\t    for (int kk = 0; kk < tk_split; ++kk) {\n   910\t        cp_async_wait<Stages - 2>();\n   911\t        __syncthreads();\n   912\t\n   913\t        const int st = kk % Stages;\n   914\t        build_exception_map(k0 + kk, st);\n   915\t        decode_regA(st);\n   916\t        warpgroup_fence_operand(tCrA);\n   917\t        warpgroup_arrive();\n   918\t        gemm(tiled_mma, tCrA, tCrB(_, _, _, st), tCrC);\n   919\t        warpgroup_commit_batch();\n   920\t\n   921\t        const int knext = kk + Stages - 1;\n   922\t        if (knext < tk_split) {\n   923\t            load_b(k0 + knext, knext % Stages);\n   924\t            load_compressed(k0 + knext, knext % Stages);\n   925\t        }\n   926\t        cp_async_fence();\n   927\t\n   928\t        warpgroup_wait<0>();\n   929\t        __syncthreads();\n   930\t    }\n   931\t\n   932\t    if (split_k <= 1) {\n   933\t        auto tCgC = thr_mma.partition_C(gC_tile);\n   934\t        CUTE_UNROLL\n   935\t        for (int i = 0; i < size(tCrC); ++i)\n   936\t            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n   937\t    } else {\n   938\t        auto gCf = make_tensor(\n   939\t            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n   940\t            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n   941\t        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n   942\t                                   make_coord(tile_m, tile_n));\n   943\t        auto tCgCf = thr_mma.partition_C(gCf_tile);\n   944\t        CUTE_UNROLL\n   945\t        for (int i = 0; i < size(tCrC); ++i)\n   946\t            tCgCf(i) = tCrC(i);\n   947\t    }\n   948\t#endif\n   949\t}\n   950\t\n   951\ttemplate <int TileN, class MmaOp, int Stages>\n   952\tstatic cudaError_t LaunchCD3RS(\n   953\t    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n   954\t    const uint8_t* bases, const int32_t* tile_offsets,\n   955\t    const uint16_t* warp_prefixes, const uint8_t* entries17,\n   956\t    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n   957\t    int M, int N, int K)\n   958\t{\n   959\t    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n   960\t    if (split_k < 1 || (K >> 6) % split_k != 0 ||\n   961\t        (split_k > 1 && Cf32 == nullptr))\n   962\t        split_k = 1;\n   963\t    using Smem = CD3RSSmem<TileN, Stages>;\n   964\t    const int smem_bytes = static_cast<int>(sizeof(Smem));\n   965\t    dim3 grid(N / TileN, M / 64, split_k);\n   966\t    auto kernel = cd3_rs_kernel<TileN, MmaOp, Stages>;\n   967\t    static int cfg = -1;\n   968\t    if (cfg != smem_bytes) {\n   969\t        cudaError_t e = cudaFuncSetAttribute(\n   970\t            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n   971\t        if (e != cudaSuccess) return e;\n   972\t        (void)cudaFuncSetAttribute(kernel,\n   973\t            cudaFuncAttributePreferredSharedMemoryCarveout,\n   974\t            cudaSharedmemCarveoutMaxShared);\n   975\t        cfg = smem_bytes;\n   976\t    }\n   977\t    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n   978\t        codes, sm, bases, tile_offsets, warp_prefixes, entries17,\n   979\t        B, C, Cf32, M, N, K, split_k);\n   980\t    cudaError_t err = cudaGetLastError();\n   981\t    if (err != cudaSuccess || split_k <= 1) return err;\n   982\t    const int64_t MN = static_cast<int64_t>(M) * N;\n   983\t    const int t = 256;\n   984\t    const int64_t blocks = (MN + t - 1) / t;\n   985\t    splitk_reduce_kernel<<<static_cast<unsigned>(blocks), t, 0, stream>>>(\n   986\t        Cf32, C, MN, split_k);\n   987\t    return cudaGetLastError();\n   988\t}\n   989\t\n   990\textern \"C\" cudaError_t cd3_rs_wgmma_launch(\n   991\t    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n   992\t    const uint8_t* bases, const int32_t* tile_offsets,\n   993\t    const uint16_t* warp_prefixes, const uint8_t* entries17,\n   994\t    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n   995\t    int M, int N, int K)\n   996\t{\n   997\t#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n   998\t    using namespace cute;\n   999\t    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n  1000\t    cudaError_t err;\n  1001\t    if (N % 256 == 0) {\n  1002\t        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n  1003\t        err = LaunchCD3RS<256, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n  1004\t            warp_prefixes, entries17, B, C, Cf32, split_k, M, N, K);\n  1005\t        if (err == cudaSuccess) return err;\n  1006\t        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n  1007\t        (void)cudaGetLastError();\n  1008\t    }\n  1009\t    if (N % 192 == 0) {\n  1010\t        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n  1011\t        err = LaunchCD3RS<192, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n  1012\t            warp_prefixes, entries17, B, C, Cf32, split_k, M, N, K);\n  1013\t        if (err == cudaSuccess) return err;\n  1014\t        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n  1015\t        (void)cudaGetLastError(