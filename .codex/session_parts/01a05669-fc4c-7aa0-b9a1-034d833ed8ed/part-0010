TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n   750\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n   751\t    alignas(16) uint8_t s_codes[Stages][1536];       // 4096 packed 3-bit codes\n   752\t    alignas(16) uint8_t s_sm[Stages][4096];          // raw sign|mantissa\n   753\t    alignas(16) uint8_t s_bases[Stages][256];        // base per 16-value chunk\n   754\t    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n   755\t    alignas(16) uint32_t s_exc_mask[Stages][128];    // one bit per tile value\n   756\t};\n   757\t\n   758\t__device__ __forceinline__ uint32_t cd3_unpack_entry17(\n   759\t    const uint8_t* entries, int64_t index)\n   760\t{\n   761\t    const int64_t bit = index * 17;\n   762\t    const int64_t byte = bit >> 3;\n   763\t    const int shift = static_cast<int>(bit & 7);\n   764\t    const uint32_t word = static_cast<uint32_t>(entries[byte])\n   765\t        | (static_cast<uint32_t>(entries[byte + 1]) << 8)\n   766\t        | (static_cast<uint32_t>(entries[byte + 2]) << 16);\n   767\t    return (word >> shift) & 0x1ffffu;\n   768\t}\n   769\t\n   770\ttemplate <int TileN, class MmaOp, int Stages>\n   771\t__global__ void cd3_rs_kernel(\n   772\t    const uint8_t*       __restrict__ codes_g,\n   773\t    const uint8_t*       __restrict__ sm_g,\n   774\t    const uint8_t*       __restrict__ bases_g,\n   775\t    const int32_t*       __restrict__ tile_offsets_g,\n   776\t    const uint16_t*      __restrict__ warp_prefixes_g,\n   777\t    const uint8_t*       __restrict__ entries17_g,\n   778\t    const __nv_bfloat16* __restrict__ B_g,\n   779\t    __nv_bfloat16*       __restrict__ C_g,\n   780\t    float*               __restrict__ Cf32_g,\n   781\t    int M, int N, int K, int split_k)\n   782\t{\n   783\t#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n   784\t    using namespace cute;\n   785\t    constexpr int kTileM = 64, kTileK = 64;\n   786\t    using Smem = C