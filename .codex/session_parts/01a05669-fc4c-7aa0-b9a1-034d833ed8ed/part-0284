h) -> None:\n        \"\"\"Apply this step's resident routes to the worker CPU block table.\n\n        The table permanently stores physical ids. New canonical offloadable\n        ids are shifted by BlockTable.append_row(); here we only patch the\n        current request tail to D+slot and restore a completing block to its\n        normal shared-buffer route b+S.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        manager = self.tail_manager\n        plan = manager.snapshot_plan()\n        self.tail_step_plan = plan\n\n        table = input_batch.block_table[0]\n        table_np = table.block_table.np\n        d = int(self.num_dedicated_blocks)\n        s = int(self.num_tail_slots)\n        from tiered_serve.kv_tail_residency import (\n            apply_plan_to_physical_block_table,\n            lp_load_skip_local_ids,\n        )\n        apply_plan_to_physical_block_table(\n            plan,\n            table_np,\n            input_batch.req_id_to_index,\n            canonical_dedicated=d,\n            tail_slots=s,\n        )\n\n        # Canonical offload ids become primary/secondary-local by subtracting\n        # D. Rollover source rows are physical tail rows D+slot.\n        self.tail_rollover_local_ids = [\n            rollover.old_block_id - d for rollover in plan.rollovers\n        ]\n        self.tail_rollover_slots = [\n            rollover.slot for rollover in plan.rollovers\n        ]\n        self.tail_resident_local_ids = sorted(\n            block_id - d for block_id in plan.resident_after)\n        self.tail_completed_local_ids = sorted(\n            block_id - d for block_id in plan.completed_full_ids)\n        # Every offloadable block completed by this step is either:\n        #   * a fresh block (pre_valid=0), overwritten in all 16 positions; or\n        #   * a resident rollover, whose prefix is staged tail->shared.\n        # Neither has prior LP data to load. Post-step partials stay in their\n  