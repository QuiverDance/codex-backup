an live past ``max_shards``.\n    \"\"\"\n    from safetensors import safe_open\n    files = sorted(glob.glob(os.path.join(weights_dir, \"*.safetensors\")))\n    if not files:\n        raise FileNotFoundError(f\"No safetensors in {weights_dir}\")\n    if layer is not None:\n        files_to_scan = files          # a specific layer may live past shard 6\n    else:\n        files_to_scan = files[:max_shards]\n\n    want = {proj: tuple(shape) for proj, shape in want_shapes.items()}\n    found = {}\n    # per-layer accumulators for fusion\n    qkv = {}      # layer -> {q,k,v}\n    gateup = {}   # layer -> {gate,up}\n\n    def try_fuse():\n        for li, g in list(qkv.items()):\n            if \"qkv\" not in found and {\"q\", \"k\", \"v\"} <= g.keys():\n                t = torch.cat([g[\"q\"], g[\"k\"], g[\"v\"]], dim=0)\n                if \"qkv\" in want and tuple(t.shape) == want[\"qkv\"]:\n                    found[\"qkv\"] = t.contiguous()\n        for li, g in list(gateup.items()):\n            if \"gate_up\" not in found and {\"gate\", \"up\"} <= g.keys():\n                t = torch.cat([g[\"gate\"], g[\"up\"]], dim=0)\n                if \"gate_up\" in want and tuple(t.shape) == want[\"gate_up\"]:\n                    found[\"gate_up\"] = t.contiguous()\n\n    for path in files_to_scan:\n        with safe_open(path, framework=\"pt\") as f:\n            for key in f.keys():\n                if all(p in found for p in want):\n                    break\n                if not (key.endswith(\".weight\")):\n                    continue\n                li = _layer_idx(key)\n                if li is None:\n                    continue\n                if layer is not None and li != layer:\n                    continue\n                t = f.get_tensor(key)\n                if t.dim() != 2 or t.dtype != torch.bfloat16:\n                    continue\n                shp = tuple(t.shape)\n                if \".q_proj.\" in key:\n                    qkv.setdefault(li, {})[\"q\"] = t\n                elif \".k_proj.\" in key:\n                    qkv.setdefault(li, {})[\"k\"] = t\n                elif \".v_proj.\" in key:\n                    qkv.setdefault(li, {})[\"v\"] = t\n                elif \".gate_proj.\" in key:\n                    gateup.setdefault(li, {})[\"gate\"] = t\n                elif \".up_proj.\" in key:\n                    gateup.setdefault(li, {})[\"up\"] = t\n                elif \".o_proj.\" in key and \"o\" in want and shp == want[\"o\"]:\n                    found.setdefault(\"o\", t.contiguous())\n                elif \".down_proj.\" in key and \"down\" in want and shp == want[\"down\"]:\n                    found.setdefault(\"down\", t.contiguous())\n                try_fuse()\n        if all(p in found for p in want):\n            break\n\n    missing = [p for p in want if p not in found]\n    if missing:\n        where = (f\"layer {layer}\" if layer is not None\n                 else f\"the first {max_shards} shards\")\n        hint = (\"check --layer is in range [0, 79]\" if layer is not None\n                else \"increase --shards or use --synthetic\")\n        raise RuntimeError(\n            f\"Could not find real weights for {missing} in {where} ({hint}).\")\n    return found\n\n\ndef make_synthetic(M, K, seed):\n    g = torch.Generator(device=\"cuda\").manual_seed(seed)\n    return (torch.randn(M, K, generator=g, device=\"cuda\",\n                        dtype=torch.float32) * 0.02).to(torch.bfloat16)\n\n\n# ── Codec registry + force-fuse ──────────────────────────────────────────────\ndef build_codec(name):\n    from tiered_serve.compression.core import (\n        ZipServCompressor, P4FlatCompressor, UBLBFlatCompressor,\n        ChunkDelta3Compressor)\ntiered_serve/compression/core/zipserv.py:2730:    # ``benchmarks/fuseGEMM.py`` (fused wins for N <= threshold;\ntiered_serve/compression/core/zipserv.py:2756:        \"\"\"Per-layer N threshold: use fused for N <= threshold, decomp+MM above.\ntie