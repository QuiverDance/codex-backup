oduce a plausible-looking CSV.\n            comp = codec.compress(W)\n            cbytes = compressed_bytes(comp)\n            if cbytes <= 0:\n                raise RuntimeError(\n                    f\"{codec_name}/{proj}/layer{layer_id}: compressed size is zero\")\n            ratio = (M * K * 2) / cbytes\n            comp_stats = bench_gpu_stats(\n                lambda: codec.compress(W), args.warmup, args.iters,\n                not args.no_flush)\n            W_dec = torch.empty(M, K, dtype=torch.bfloat16, device=\"cuda\")\n            codec.decompress(comp, W_dec)\n            torch.cuda.current_stream().synchronize()\n            if not torch.equal(W_dec, W):\n                raise RuntimeError(\n                    f\"{codec_name}/{proj}/layer{layer_id}: \"\n                    \"compress/decompress is not bit-exact\")\n            decomp_stats = bench_gpu_stats(\n                lambda: codec.decompress(comp, W_dec), args.warmup,\n                args.iters, not args.no_flush)\n            comp_ms = comp_stats.p50_ms\n            decomp_ms = decomp_stats.p50_ms\n\n            # ── ATS placement: relocate the compressed-exponent buffers to\n            # LPDDR (mantissa stays HBM) so the fused kernel reads them over\n            # C2C.  ensure_hbm/ensure_ats flip comp's live buffers between the\n            # two placements per measurement; both read identical bytes. ──\n            ats_on = False\n            ats_backend = \"\"\n            ensure_hbm = (lambda: None)\n            ensure_ats = (lambda: None)\n            if ats_pool is not None and codec_name in _ATS_PLAN:\n                try:\n                    ats_pool.reset()\n                    _tgt, _exp_attrs, _hbm_t, _ats_t = place_exponent_in_ats(\n                        codec_name, comp, ats_pool)\n                    _state = {\"cur\": None}\n\n                    def ensure_hbm(_t=_tgt, _a=_exp_attrs, _h=_hbm_t, _s=_state):\n                        if _s[\"cur\"] != \"hbm\":\n                            for _k in _a:\n                                setattr(_t, _k, _h[_k])\n                            _s[\"cur\"] = \"hbm\"\n\n                    def ensure_ats(_t=_tgt, _a=_exp_attrs, _v=_ats_t, _s=_state):\n                        if _s[\"cur\"] != \"ats\":\n                            for _k in _a:\n                                setattr(_t, _k, _v[_k])\n                            _s[\"cur\"] = \"ats\"\n\n                    ats_on = True\n                    ats_backend = ats_pool.backend\n                except Exception as ex:  # noqa: BLE001\n                    torch.cuda.empty_cache()\n                    print(f\"  [ats-skip {codec_name}/{proj}] \"\n                          f\"{type(ex).__name__}: {str(ex)[:90]}\", file=sys.stderr)\n\n            print(f\"\\n[{codec_name}] layer={layer_id} {proj} {M}x{K}  \"\n                  f\"compress={comp_ms:.3f}ms  decompress={decomp_ms:.3f}ms  \"\n                  f\"compressed={cbytes/1024**2:.1f}MiB  ratio={ratio:.3f}x\")\n            ats_hdr = (f\" {'decmpATS':>17} | {'fusedATS':>17} |\"\n                       if ats_on else \"\")\n            ats_sub = (f\" {'iso':>8} {'h2d':>8} | {'iso':>8} {'h2d':>8} |\"\n                       if ats_on else \"\")\n            print(f\"  {'N':>5} | {'rawGEMM':>17} | {'decomp+GEMM':>17} | \"\n                  f\"{'fused':>17} |{ats_hdr} {'best':>6} {'spd':>6}\")\n            print(f\"  {'':>5} | {'iso':>8} {'h2d':>8} | {'iso':>8} {'h2d':>8} | \"\n                  f\"{'iso':>8} {'h2d':>8} |{ats_sub}\")\n            print(\"  \" + \"-\" * (96 + (40 if ats_on else 0)))\n\n            h2d_bytes = args.h2d_bytes or cbytes or (M * K * 2)\n            contender = None if args.no_h2d else H2DContender(h2d_bytes)\n\n            for N in n_values:\n                proj_index = projs.index(proj)\n                activation_seed = (\n                    args.seed + max(layer_id, 0) * 100_000 +\n                    proj_index * 10_000 + N)\n                generator = torch.Generator(device=\"cuda\")\n                generator.manual_seed(activation_seed)\n                x = torch.randn(\n                    N, K, generator=generator, dtype=torch.bfloat16,\n                    device=\"cuda\")\n                Wt = W.t()\n                Y = torch.empty(N, M, dtype=torch.bfloat16, device=\"cuda\")\n                fused_scratch = codec.alloc_fused_scratch(\n                    K, M, N, x.dtype, x.device)\n                flops = 2.0 * M * N * K\n\n                def raw():\n                    torch.matmul(x, Wt, out=Y)\n\n                def decmm():\n                    ensure_hbm()\n                    codec.decompress(comp, W_dec)\n                    torch.matmul(x, W_dec.t(), out=Y)\n\n                def fused():\n                    ensure_hbm()\n                    return codec.linear_apply_into(comp, x, fused_scratch)\n\n                def decmm_ats():\n                    # decomp reads the exponent from LPDDR (mantissa from HBM),\n                    # writes the dense bf16 weight to HBM, then cuBLAS.\n                    ensure_ats()\n                    codec.decompress(comp, W_dec)\n                    torch.matmul(x, W_dec.t(), out=Y)\n\n                def fused_ats():\n                    # fused decode+GEMM: exponent streamed from LPDDR over C2C,\n                    # no dense-weight HBM write.\n                    ensure_ats()\n                    return codec.linear_apply_into(comp, x, fused_scratch)\n\n                def measure(fn, contend):\n                    return bench_compute_stats(\n                        fn, args.warmup, args.iters, not args.no_flush,\n                        contender=contend)\n\n                # Fused validity gate (always on unless --no-validate): forcing\n                # the fused kernel past a codec's native N-threshold can yield a\n                # numerically WRONG result (e.g. ublb_flat qkv).  A wrong kernel\n                # is never a usable strategy, so null its timing and flag it\n                # rather than report misleading garbage latency.\n                fused_check = \"unvalidated\"\n                if not args.no_validate:\n                    try:\n                        yf = fused().contiguous().float()\n                        codec.decompress(comp, W_dec)\n                        yref = torch.matmul(x, W_dec.t()).float()\n                        amax = yref.abs().max().item()\n                        ok = torch.allclose(yf, yref, atol=max(1.0, 0.02 * amax),\n                                            rtol=0.02)\n                        fused_check = \"ok\" if ok else \"invalid\"\n                    except RuntimeError as ex:\n                        raise RuntimeError(\n                            f\"fused validation failed for {codec_name}/\"\n                            f\"layer{layer_id}/{proj}/N={N}\") from ex\n                    if fused_check == \"invalid\":\n                        raise RuntimeError(\n                            f\"fused output mismatch for {codec_name}/\"\n                            f\"layer{layer_id}/{proj}/N={N}\")\n\n                # ATS reads identical bytes from LPDDR, so the result must match\n                # the HBM-fused reference bit-for-bit; validate to catch a broken\n                # DHA mapping rather than silently timing a wrong kernel.\n                ats_check = \"unvalidated\"\n                if ats_on and not args.no_validate and fused_check != \"invalid\":\n                    try:\n                        ya = fused_ats().contiguous().float()\n                        ensure_hbm()\n                        codec.decompress(comp, W_dec)\n                        yref2 = torch.matmul(x, W_dec.t()).float()\n                        amax2 = yref2.abs().max().item()\n                        ats_check = \"ok\" if torch.allclose(\n                            ya, yref2, atol=max(1.0, 0.02 * amax2), rtol=0.02) \\\n                            else \"invalid\"\n                    except RuntimeError:\n                        torch.cuda.empty_cache()\n                        ats_check = \"invalid\"\n\n                raw_i_stats = measure(raw, None)\n                dec_i_stats = measure(decmm, None)\n                fus_i_stats = measure(fused, None)\n                ats_runnable = (ats_on and fused_check != \"invalid\"\n                                and ats_check != \"invalid\")\n                da_i_stats = measure(decmm_ats, None) if ats_on else None\n                fa_i_stats = measure(fused_ats, None) if ats_runnable else None\n                if contender is not None:\n                    raw_h_stats = measure(raw, contender)\n                    dec_h_stats = measure(decmm, contender)\n                    fus_h_stats = measure(fused, contender)\n                    da_h_stats = measure(decmm_ats, contender) if ats_on else None\n                    fa_h_stats = measure(fused_ats, contender) if ats_runnable else None\n                else:\n                    raw_h_stats = dec_h_stats = fus_h_stats = None\n                    da_h_stats = fa_h_stats = None\n\n                raw_i = raw_i_stats.p50_ms\n                dec_i = dec_i_stats.p50_ms\n                fus_i = fus_i_stats.p50_ms\n                da_i = None if da_i_stats is None else da_i_stats.p50_ms\n                fa_i = None if fa_i_stats is None else fa_i_stats.p50_ms\n                raw_h = None if raw_h_stats is None else raw_h_stats.p50_ms\n                dec_h = None if dec_h_stats is None else dec_h_stats.p50_ms\n                fus_h = None if fus_h_stats is None else fus_h_stats.p50_ms\n                da_h = None if da_h_stats is None else da_h_stats.p50_ms\n                fa_h = None if fa_h_stats is None else fa_h_stats.p50_ms\n\n                # headline fuse-vs-decomp decision under contention (h2d) when\n                # available; fused only competes where it is valid.  fusedATS is\n                # reported as its own column, not folded into this decision.\n                d_dec = dec_h if dec_h is not None else dec_i\n                d_fus = fus_h if fus_h is not None else fus_i\n                if d_fus is not None and d_dec is not None:\n                    best = \"fused\" if d_fus <= d_dec else \"decmm\"\n                    spd = d_dec / d_fus\n                elif d_dec is not None:\n                    best, spd = \"decmm\", None\n                else:\n                    best, spd = \"n/a\", None\n\n                chk = \"\"\n                if args.check:\n                    chk = {\"ok\": \"  OK\", \"invalid\": \"  INVALID\",\n                           \"unvalidated\": \"\"}[fused_check]\n                    if ats_on:\n                        chk += {\"ok\": \" ATS:OK\", \"invalid\": \" ATS:INVALID\",\n                                \"unvalidated\": \"\"}[ats_check]\n\n                ats_cols = (f\" {fmt(da_i)} {fmt(da_h)} | {fmt(fa_i)} {fmt(fa_h)} |\"\n                            if ats_on else \"\")\n                print(f\"  {N:>5} | {fmt(raw_i)} {fmt(raw_h)} | \"\n                      f\"{fmt(dec_i)} {fmt(dec_h)} | {fmt(fus_i)} {fmt(fus_h)} |\"\n                      f\"{ats_cols} {best:>6} \"\n                      f\"{('' if spd is None else f'{spd:5.2f}x'):>6}{chk}\")\n\n                row = {\n                    **common_meta,\n                    \"codec\": codec_name, \"layer\": layer_id,\n                    \"proj\": proj, \"M\": M, \"K\": K, \"N\": N,\n                    \"weight_sha256\": weight_hashes[(layer_id, proj)],\n                    \"weight_bit_exact\": True,\n                    \"activation_seed\": activation_seed,\n                    \"compress_ms\": comp_ms, 