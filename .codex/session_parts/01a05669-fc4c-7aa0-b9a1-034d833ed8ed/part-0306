locks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        # 2-slot blob ring for the load_kv_stream split (slot 0 reuses the\n        # buffers above; slot 1 is the extra double-buffer).  The H2D writes a\n        # slot on load_kv_stream and the decode reads it on batch_decomp_stream;\n        # the per-slot ``consumed`` event gates the NEXT reuse so the two\n        # streams overlap (H2D L+1 ∥ decode L) without racing the staging blob.\n        self._dec_blob_ring = [\n            self._gpu_dec_blob,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_v_ring = [\n            self._gpu_dec_blob_v,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for _e in self._dec_blob_consumed:\n            _e.record()\n        # Per-layer \"decode H2D of host['blob'] complete\" events — external=True\n        # so the C++ worker can wait on .cuda_event, enable_timing=True so the\n        # breakdown can elapsed_time() them.  Paired with _kv_h2d_begin (right\n        # before the blob H2D) to isolate the compressed-KV H2D from decode.\n        self._kv_dec_h2d = [torch.cuda.Event(enable_timing=True, external=True)\n                            for _ in range(n_layers)]\n        self._kv_h2d_begin = [torch.cuda.Event(enable_timing=True,\n                                               external=True)\n                              for _ in range(n_layers)]\n        # Tight decode-kernel begin.  _kv_dec_h2d is recorded on the H2D\n        # producer stream, so elapsed_time(_kv_dec_h2d, decode_end) also\n        # includes any older work / WAR wait already queued on\n        # batch_decomp_stream.  Record on the consumer stream after those waits\n        # and immediately before the codec kernels to measure KVDecomp itself.\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Pre-record once so elapsed_time() on a layer that doesn't decode this\n        # step sees a (stale, pre-init) recording instead of raising.\n        for _e in self._kv_dec_h2d:\n            _e.record()\n        for _e in self._kv_h2d_begin:\n            _e.record()\n        for _e in self._kv_decode_begin:\n            _e.record()\n\n        # Async metadata-staging ring (see __init__).  Each decode chunk gathers\n        # its per-block meta into one ring slot's pinned buffers (contiguous\n        # prefixes -> one valid async H2D per group, no stack, no pageable temp)\n        # and records an event; reusing a slot first waits on that event, so the\n        # CPU never overwrites a buffer whose H2D is still in flight (the\n        # documented torn-meta IMA).  ``cap`` = the GPU decomp staging width, so\n        # a chunk's meta count never exceeds it.  R slots absorb the\n        # CPU-races-ahead window without actually blocking; event-gating keeps it\n        # correct for any lag.\n        if not self._meta_sync_fallback:\n            cap = max_gpu_decomp_blocks\n            R = int(os.getenv(\"TIERED_SERVE_META_RING_N\", \"16\"))\n            self._meta_ring_n = R\n            self._meta_ring_pi = [\n                torch.empty(5 * cap, dtype=torch.int32).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_pu = [\n                torch.empty(2 * cap, dtype=torch.uint8).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_b = [\n                torch.empty(cap, dtype=torch.int64).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_ev = [torch.cuda.Event() for _ in range(R)]\n            for _e in self._meta_ring_ev:\n                _e.record()\n            self._meta_ring_idx = 0\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._secondary_fallback_possible = {\n            lid: False for lid in range(n_layers)}\n        # int64 so a decode gather yields index_select-ready indices with no\n        # per-layer .long() cast (the int32 saved nothing — values are slots).\n        # The numpy array is the AUTHORITY and the torch tensor is a\n        # zero-copy ``from_numpy`` view of the SAME memory: the per-step\n        # assign path (compress submit) runs in numpy (~5 µs vs ~26 µs for\n        # the equivalent five torch CPU ops), while the decode path keeps\n        # gathering through the torch view unchanged.\n        self._kv_slot_np = {\n            lid: np.full(host_n, -1, dtype=np.int64)\n            for lid in range(n_layers)\n        }\n        self._kv_slot = {\n            lid: torch.from_numpy(self._kv_slot_np[lid])\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {lid: [-1] * host_n for lid in range(n_layers)}\n        self._kv_active_count = {lid: 0 for lid in range(n_layers)}  # hwm\n        self._kv_free_heap = {lid: [] for lid in range(n_layers)}\n        self._kv_free_slots = {lid: set() for lid in range(n_layers)}\n        # Decode fast-path pre-binding: the per-layer hot references are\n        # resolved ONCE here so the per-layer decode does a single tuple\n        # unpack instead of ~15 dict/attr lookups (every statement on the\n        # forward thread is GPU-idle gap).\n        self._dec_cap = max_gpu_decomp_blocks\n        # (row_major_sm is NOT baked in: gpu_direct warmup may flip it after\n        # this point — the fast path reads the attribute per call.)\n        self._fast_const = (blob_stride, block_numel, K_b, M_b,\n                            (blob_stride - fixed_bytes) // 6)\n        self._dec_fast = {}\n        for lid in range(n_layers):\n            hk = self._host_pools[lid]['k']\n            hv = self._host_pools[lid]['v']\n            self._dec_fast[lid] = (\n                self._kv_slot[lid], hk['blob'], hv['blob'],\n                hk['valid_rows'], hk['exc_cnt'], hk['is_raw'],\n                hv['valid_rows'], hv['exc_cnt'], hv['is_raw'])\n        # C++ decode prep (decode_layer_prep): one ext call replaces the\n        # per-layer Python staging (valid filter + slot/meta gather + meta &\n        # blob H2D + event records); only the two codec kernels stay in Python.\n        #\n        # DEVICE meta buffers are 2-slot RINGED, in lockstep with the blob ring\n        # (``_dec_blob_ring``), and indexed by the SAME ``slot``.  This is\n        # REQUIRED for the load_kv_stream split: there the meta H2D runs on\n        # load_kv_stream while the decode kernel reads the meta on\n        # batch_decomp_stream, so a SINGLE persistent meta buffer would be\n        # overwritten by layer L+1's H2D while layer L's decode still reads it\n        # (an async IMA seen only at high batch / serve concurrency, where the\n        # longer decode lets the next H2D overtake it).  The blob was already\n        # double-buffered + gated by ``_dec_blob_consumed[slot]``; the meta now\n        # rides the SAME slot + consumed gate, so both are protected.  Non-split\n        # always uses slot 0 (everything on batch_decomp_stream → stream order\n        # serialises → safe), so slot-0 == the old single-buffer behaviour.\n        self._gi_dev_ring = [\n            torch.empty(5 * max_gpu_decomp_blocks, dtype=torch.int32,\n                        device='cuda') for _ in range(2)]\n        self._gu_dev_ring = [\n            torch.empty(2 * max_gpu_decomp_blocks, dtype=torch.uint8,\n                        device='cuda') for _ in range(2)]\n        self._gb_dev_ring = [\n            torch.empty(max_gpu_decomp_blocks, dtype=torch.int64,\n                        device='cuda') for _ in range(2)]\n        # slot-0 aliases retained for any non-decode reader / back-compat.\n        self._gi_dev = self._gi_dev_ring[0]\n        self._gu_dev = self._gu_dev_ring[0]\n        self._gb_dev = self._gb_dev_ring[0]\n        # Zero-copy uint8 views of the persistent-valid bytearrays (the\n        # bytearray object is allocated once here and only mutated in place,\n        # so the view stays valid for the process lifetime).\n        self._valid_t = {\n            lid: torch.from_numpy(np.frombuffer(\n                self._persistent_valid[lid], dtype=np.uint8))\n            for lid in range(n_layers)\n        }\n        self._use_cpp_prep = (\n            _p4f_ext is not None\n            and hasattr(_p4f_ext, \"decode_layer_prep\")\n            and os.getenv(\"TIERED_SERVE_KV_DECODE_CPP\", \"1\") == \"1\")\n        self._kv_pools_ready = True\n        # gpu_direct encode: prefer the single-kernel batched GPU compress\n        # (compress_batched) — per-block blobs written on device in one launch,\n        # no host scatter_fixed.  It emits the row_major_sm=1 / 0xFF-subtile\n        # format, so set the decode flag to match.  Escape hatch:\n        # TIERED_SERVE_KV_P4FLAT_GPU_LEAN=1 keeps the compress_lean path.\n        self._use_gpu_batched = (\n            self._USES_GPU_COMPRESS and _p4f_ext is not None\n            and hasattr(_p4f_ext, \"compress_batched\")\n            and os.getenv(\"TIERED_SERVE_KV_P4FLAT_GPU_LEAN\", \"0\") != \"1\")\n        if self._use_gpu_batched:\n            self._row_major_sm = 1\n            full_fixed = ((self._M_b // 64) * (self._K_b // 64) * 16\n                          + self._M_b * self._K_b // 2 + self._M_b * self._K_b\n                          + (self._M_b // 16) * (self._K_b // 16))\n            self._max_exc_pb = max(8, (self._raw_bytes - full_fixed) // 6 + 8)\n            logger.info(\"P4Flat GPU KV encoder: compress_batched (single kernel)\")\n\n        host_bytes = sum(\n            t.nbytes\n            for layer_pools in self._host_pools.values()\n            for kv_pool in layer_pools.values()\n            for t in kv_pool.values())\n        logger.info(\n            \"P4Flat KV buffers warmed up: block_shape=%s block_numel=%d \"\n            \"(M_b=%d K_b=%d) fixed=%dB raw=%dB blob_stride=%dB max_comp=%dB \"\n            \"max_n_blocks=%d max_gpu_decomp=%d n_layers=%d host=%.1fMB\",\n            block_shape, block_numel, M_b, K_b, fixed_bytes, raw_bytes,\n            blob_stride, max_comp_size, max_n_blocks, max_gpu_decomp_blocks,\n            n_layers, host_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n","stderr":"","aggregated_output":"            #       directly from secondary_kv (no extra D2H) and writes\n            #       into the persistent compressed host pool.  Supported only\n            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n            #       manager), p4flat, and ChunkDelta3 (Python worker boundary\n            #       around an OpenMP C++ encoder).\n            # Default is backend-aware.  ZipServ is CPU-encode only in the\n            # serving path: raw KV is first swapped to secondary_kv and its C++\n            # worker manager compresses directly from that host tensor.  This\n            # is also enforced below so an inherited producer env cannot route\n            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n            # host_encode_blocks) variant of the p4flat codec — it always uses\n            # the cpu_after_raw_swap producer, regardless of the env default.\n            # p4flat's gpu_direct compress runs 3 device kernels\n            # (compress_lean) on comp_stream.  When weight compression is also\n            # active, those kernels contend with weight-decompress + fused-mm\n            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n            # default p4flat to the CPU encoder whenever weight comp is on (the\n            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n            # where the GPU has spare SMs and the two paths are on par\n            # (180 vs 176 ms).  An explicit env value below still overrides.\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\"):\n                _default_producer = \"cpu_after_raw_swap\"\n            elif kv_comp_backend == \"chunk_delta3\":\n                # CD3 GPU encode contends directly with fused weight decode/MM\n                # once KV offload begins.  The host encoder consumes the raw\n                # secondary copy asynchronously and is the serving default.\n                _default_producer = \"cpu_after_raw_swap\"\n            elif (kv_comp_backend == \"p4flat\"\n                    and DualMemoryLoader.use_weight_comp):\n                _default_producer = \"cpu_after_raw_swap\"\n            else:\n                _default_producer = \"gpu_direct\"\n            kv_comp_producer = os.getenv(\n                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n                    f\"'cpu_after_raw_swap'.\")\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\") and \\\n                    kv_comp_producer != \"cpu_after_raw_swap\":\n                logger.warning(\n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n                    f\"(backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent split: sm stays in HBM, exp is\n                # ANS-compressed and persisted in LPDDR (see\n                # tiered_serve/mantexp_kv_compressor.py).\n                if not self.mantexp_split_kv:\n                    logger.warning(\n                        \"KV backend 'mantexp' selected without \"\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n                #                         host_encode_blocks)\n                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n                # follows the producer mode (defaults to gpu_direct).\n                # See tiered_serve/p4flat_kv_compressor.py.\n                from tiered_serve.p4flat_kv_compressor import (\n                    P4FlatCPUKVCompressor,\n                    P4FlatKVCompressor,\n                )\n                if (kv_comp_backend == \"p4flatcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = P4FlatCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: P4Flat (CPU encode, \"\n                        \"C++ OpenMP host_encode_blocks)\")\n                else:\n                    self.kv_compressor = P4FlatKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            elif kv_comp_backend == \"chunk_delta3\":\n                from tiered_serve.chunk_delta3_kv_compressor import (\n                    ChunkDelta3CPUKVCompressor,\n                    ChunkDelta3KVCompressor,\n                )\n                if kv_comp_producer == \"cpu_after_raw_swap\":\n                    self.kv_compressor = ChunkDelta3CPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 (CPU OpenMP encode, \"\n                        \"batched GPU decode)\")\n                else:\n                    self.kv_compressor = ChunkDelta3KVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 \"\n                        \"(batched GPU encode/decode)\")\n            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n                #                         nvcomp_bitcomp_compress_batch)\n                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n        if result != 0:\n            raise RuntimeError(\n                f\"cudaEventSynchronize failed for CD3 CPU encode: {result}\")\n    else:  # pragma: no cover - libcudart is present in serving containers\n        torch.cuda.synchronize()\n\n\nclass ChunkDelta3CPUKVCompressor(ChunkDelta3KVCompressor):\n    \"\"\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\n\n    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\n    that D2H event and encodes directly from the host tensor into persistent\n    physical slots, keeping encode kernels off the fused-MM critical path.\n    \"\"\"\n\n    _USES_GPU_COMPRESS = False\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n            raise RuntimeError(\n                \"ChunkDelta3CPUKVCompressor requires the CPU-enabled \"\n                \"tp3_cd3_ext\")\n        super().__init__(comp_stream)\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # Grace serving usually produces only eight newly-full blocks per\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n        # series; eight small teams instead pipeline independent layers across\n        # the same CPU budget.  Retain the established one-worker x86 default.\n        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        compression_cpu_count = len([\n            cpu for cpu in os.sched_getaffinity(0)\n            if cpu >= self._reserve_cores])\n        default_omp_threads = str(max(\n            1, (compression_cpu_count + self._n_workers - 1)\n            // self._n_workers))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._timing_raw_wait = 0.0\n        self._timing_decode_wait = 0.0\n        self._timing_encode = 0.0\n        self._timing_count = 0\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n            if self.kv_compressor is not None:\n                k_cache = DualMemoryLoader.primary_k_caches[0]\n                block_shape = tuple(k_cache.shape[1:])\n                block_size = k_cache.shape[1]  # tokens per block\n                # Host pools must cover ALL block_ids for persistent\n                # block_id-indexed compressed storage.\n                num_primary_blocks = k_cache.shape[0]\n                # GPU staging pools only need per-iteration capacity.\n                max_iter_blocks = (\n                    -(- self.max_num_batched_tokens // block_size)\n                    + self.batch_size\n                )\n                # Use pre-allocated hugepage pools from vllm cache engine\n                # if available (allocated before hugepages are exhausted).\n                pre_pools = getattr(DualMemoryLoader, 'zipserv_host_pools', None)\n                self.kv_compressor.warmup_kv_buffers(\n                    block_shape, num_primary_blocks, self.n_layers,\n                    max_gpu_blocks=max_iter_blocks,\n                    max_gpu_decomp_blocks=num_primary_blocks,\n                    huge_page_allocator=self.huge_page_allocator,\n                    pre_allocated_host_pools=pre_pools)\n                # Init C++ compress worker threads (D2H + compress)\n                n_compress_workers = int(os.getenv(\n                    \"TIERED_SERVE_KV_COMPRESS_WORKERS\", str(os.cpu_count() - 10)))\n                self.kv_compressor.init_kv_compress_workers(\n                    n_compress_workers, max_iter_blocks, self.n_layers)\n\n        # Startup has finished its CPU-heavy checkpoint copies and\n        # torch.compile work.  Constrain only the engine main thread's ATen\n        # OpenMP team now, before graph capture / the first serving KV encode.\n        # P4Flat's async worker is a different OpenMP master and explicitly\n        # installs its dedicated team size on its first encode, so it remains\n        # at TIERED_SERVE_KV_COMPRESS_OMP_THREADS (56 by default).\n        if os.getenv(\"TIERED_SERVE_OMP_PHASE_SWITCH\", \"0\") == \"1\":\n            main_threads = max(1, int(os.getenv(\n                \"TIERED_SERVE_MAIN_OMP_THREADS\", \"1\")))\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n                'cd': torch.empty(max_gpu_blocks * cdb, dtype=torch.uint8).pin_memory(),\n                # Device exception count, D2H'd with the payload (compress_lean\n                # returns it on-device so the call stays sync-free).\n                'ec': torch.empty(1, dtype=torch.int32).pin_memory(),\n            }\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            specs = {\n                'blob':       ((host_n, blob_stride), torch.uint8),\n                'total_size': ((host_n,),               torch.int32),\n                'exc_cnt':    ((host_n,),               torch.int32),\n                'is_raw':     ((host_n,),               torch.uint8),\n                # Occupancy: number of decoded rows for this slot (== M_b for a\n                # full block).  Read by decode to size comp.M / the raw view.\n                'valid_rows': ((host_n,),               torch.int32),\n            }\n            pool = {}\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(*shape, dtype=dtype,\n                                    device='cpu').pin_memory()\n                pool[name] = t\n            # Default to full-height decode; partial encodes overwrite per slot.\n            pool['valid_rows'].fill_(M_b)\n            # Zero the meta so an un-encoded / not-yet-written slot reads as a\n            # bounded empty block instead of torch.empty garbage.  The decode\n            # sizes the exception patch-kernel grid from int(exc_cnt[slots].max())\n            # and the blob length from total_size; garbage there → out-of-bounds\n            # grid → cudaErrorIllegalAddress (manifested on the slower CPU-encode\n            # path which can race the decode of a freshly-(re)assigned slot).\n            pool['exc_cnt'].zero_()\n            pool['is_raw'].zero_()\n            pool['total_size'].zero_()\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            self._host_pools = pre_allocated_host_pools\n            # Externally-sized pools predate the occupancy field — add a\n            # full-height ``valid_rows`` mirror where missing so decode/encode\n            # can read it uniformly.\n            for layer_pools in self._host_pools.values():\n                for kv_pool in layer_pools.values():\n                    if 'valid_rows' not in kv_pool:\n                        vr = torch.empty(host_n, dtype=torch.int32,\n                                         device='cpu').pin_memory()\n                        vr.fill_(M_b)\n                        kv_pool['valid_rows'] = vr\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging blob pools for decode H2D — SEPARATE K and V buffers so\n        # both host-pool reads issue back-to-back and a per-layer event marks\n        # \"host['blob'] fully read\".  The CPU-encode unload WORKER waits on that\n        # event (wait-based, on its own thread) before overwriting the slots, so\n        # the main thread is NOT host-synchronized and per-layer decodes pipeline\n        # (prefetch overlaps compute).  Double-buffering is GPU-HBM only.\n        self._gpu_dec_blob = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        self._gpu_dec_blob_v = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        # 2-slot blob ring for the load_kv_stream split (slot 0 reuses the\n        # buffers above; slot 1 is the extra double-buffer).  The H2D writes a\n        # slot on load_kv_stream and the decode reads it on batch_decomp_stream;\n        # the per-slot ``consumed`` event gates the NEXT reuse so the two\n        # streams overlap (H2D L+1 ∥ decode L) without racing the staging blob.\n        self._dec_blob_ring = [\n            self._gpu_dec_blob,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_v_ring = [\n            self._gpu_dec_blob_v,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for _e in self._dec_blob_consumed:\n            _e.record()\n        # Per-layer \"decode H2D of host['blob'] complete\" events — external=True\n        # so the C++ worker can wait on .cuda_event, enable_timing=True so the\n        # breakdown can elapsed_time() them.  Paired with _kv_h2d_begin (right\n        # before the blob H2D) to isolate the compressed-KV H2D from decode.\n        self._kv_dec_h2d = [torch.cuda.Event(enable_timing=True, external=True)\n                            for _ in range(n_layers)]\n        self._kv_h2d_begin = [torch.cuda.Event(enable_timing=True,\n                                               external=True)\n                              for _ in range(n_layers)]\n        # Tight decode-kernel begin.  _kv_dec_h2d is recorded on the H2D\n        # producer stream, so elapsed_time(_kv_dec_h2d, decode_end) also\n        # includes any older work / WAR wait already queued on\n        # batch_decomp_stream.  Record on the consumer stream after those waits\n        # and immediately before the codec kernels to measure KVDecomp itself.\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Pre-record once so elapsed_time() on a layer that doesn't decode this\n        # step sees a (stale, pre-init) recording instead of raising.\n        for _e in self._kv_dec_h2d:\n            _e.record()\n        for _e in self._kv_h2d_begin:\n            _e.record()\n        for _e in self._kv_decode_begin:\n            _e.record()\n\n        # Async metadata-staging ring (see __init__).  Each decode chunk gathers\n        # its per-block meta into one ring slot's pinned buffers (contiguous\n        # prefixes -> one valid async H2D per group, no stack, no pageable temp)\n        # and records an event; reusing a slot first waits on that event, so the\n        # CPU never overwrites a buffer whose H2D is still in flight (the\n        # documented torn-meta IMA).  ``cap`` = the GPU decomp staging width, so\n        # a chunk's meta count never exceeds it.  R slots absorb the\n        # CPU-races-ahead window without actually blocking; event-gating keeps it\n        # correct for any lag.\n        if not self._meta_sync_fallback:\n            cap = max_gpu_decomp_blocks\n            R = int(os.getenv(\"TIERED_SERVE_META_RING_N\", \"16\"))\n            self._meta_ring_n = R\n            self._meta_ring_pi = [\n                torch.empty(5 * cap, dtype=torch.int32).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_pu = [\n                torch.empty(2 * cap, dtype=torch.uint8).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_b = [\n                torch.empty(cap, dtype=torch.int64).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_ev = [torch.cuda.Event() for _ in range(R)]\n            for _e in self._meta_ring_ev:\n                _e.record()\n            self._meta_ring_idx = 0\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._secondary_fallback_possible = {\n            lid: False for lid in range(n_layers)}\n        # int64 so a decode gather yields index_select-ready indices with no\n        # per-layer .long() cast (the int32 saved nothing — values are slots).\n        # The numpy array is the AUTHORITY and the torch tensor is a\n        # zero-copy ``from_numpy`` view of the SAME memory: the per-step\n        # assign path (compress submit) runs in numpy (~5 µs vs ~26 µs for\n        # the equivalent five torch CPU ops), while the decode path keeps\n        # gathering through the torch view unchanged.\n        self._kv_slot_np = {\n            lid: np.full(host_n, -1, dtype=np.int64)\n            for lid in range(n_layers)\n        }\n        self._kv_slot = {\n            lid: torch.from_numpy(self._kv_slot_np[lid])\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {lid: [-1] * host_n for lid in range(n_layers)}\n        self._kv_active_count = {lid: 0 for lid in range(n_layers)}  # hwm\n        self._kv_free_heap = {lid: [] for lid in range(n_layers)}\n        self._kv_free_slots = {lid: set() for lid in range(n_layers)}\n        # Decode fast-path pre-binding: the per-layer hot references are\n        # resolved ONCE here so the per-layer decode does a single tuple\n        # unpack instead of ~15 dict/attr lookups (every statement on the\n        # forward thread is GPU-idle gap).\n        self._dec_cap = max_gpu_decomp_blocks\n        # (row_major_sm is NOT baked in: gpu_direct warmup may flip it after\n        # this point — the fast path reads the attribute per call.)\n        self._fast_const = (blob_stride, block_numel, K_b, M_b,\n                            (blob_stride - fixed_bytes) // 6)\n        self._dec_fast = {}\n        for lid in range(n_layers):\n            hk = self._host_pools[lid]['k']\n            hv = self._host_pools[lid]['v']\n            self._dec_fast[lid] = (\n                self._kv_slot[lid], hk['blob'], hv['blob'],\n                hk['valid_rows'], hk['exc_cnt'], hk['is_raw'],\n                hv['valid_rows'], hv['exc_cnt'], hv['is_raw'])\n        # C++ decode prep (decode_layer_prep): one ext call replaces the\n        # per-layer Python staging (valid filter + slot/meta gather + meta &\n        # blob H2D + event records); only the two codec kernels stay in Python.\n        #\n        # DEVICE meta buffers are 2-slot RINGED, in lockstep with the blob ring\n        # (``_dec_blob_ring``), and indexed by the SAME ``slot``.  This is\n        # REQUIRED for the load_kv_stream split: there the meta H2D runs on\n        # load_kv_stream while the decode kernel reads the meta on\n        # batch_decomp_stream, so a SINGLE persistent meta buffer would be\n        # overwritten by layer L+1's H2D while layer L's decode still reads it\n        # (an async IMA seen only at high batch / serve concurrency, where the\n        # longer decode lets the next H2D overtake it).  The blob was already\n        # double-buffered + gated by ``_dec_blob_consumed[slot]``; the meta now\n        # rides the SAME slot + consumed gate, so both are protected.  Non-split\n        # always uses slot 0 (everything on batch_decomp_stream → stream order\n        # serialises → safe), so slot-0 == the old single-buffer behaviour.\n        self._gi_dev_ring = [\n            torch.empty(5 * max_gpu_decomp_blocks, dtype=torch.int32,\n                        device='cuda') for _ in range(2)]\n        self._gu_dev_ring = [\n            torch.empty(2 * max_gpu_decomp_blocks, dtype=torch.uint8,\n                        device='cuda') for _ in range(2)]\n        self._gb_dev_ring = [\n            torch.empty(max_gpu_decomp_blocks, dtype=torch.int64,\n                        device='cuda') for _ in range(2)]\n        # slot-0 aliases retained for any non-decode reader / back-compat.\n        self._gi_dev = self._gi_dev_ring[0]\n        self._gu_dev = self._gu_dev_ring[0]\n        self._gb_dev = self._gb_dev_ring[0]\n        # Zero-copy uint8 views of the persistent-valid bytearrays (the\n        # bytearray object is allocated once here and only mutated in place,\n        # so the view stays valid for the process lifetime).\n        self._valid_t = {\n            lid: torch.from_numpy(np.frombuffer(\n                self._persistent_valid[lid], dtype=np.uint8))\n            for lid in range(n_layers)\n        }\n        self._use_cpp_prep = (\n            _p4f_ext is not None\n            and hasattr(_p4f_ext, \"decode_layer_prep\")\n            and os.getenv(\"TIERED_SERVE_KV_DECODE_CPP\", \"1\") == \"1\")\n        self._kv_pools_ready = True\n        # gpu_direct encode: prefer the single-kernel batched GPU compress\n        # (compress_batched) — per-block blobs written on device in one launch,\n        # no host scatter_fixed.  It emits the row_major_sm=1 / 0xFF-subtile\n        # format, so set the decode flag to match.  Escape hatch:\n        # TIERED_SERVE_KV_P4FLAT_GPU_LEAN=1 keeps the compress_lean path.\n        self._use_gpu_batched = (\n            self._USES_GPU_COMPRESS and _p4f_ext is not None\n            and hasattr(_p4f_ext, \"compress_batched\")\n            and os.getenv(\"TIERED_SERVE_KV_P4FLAT_GPU_LEAN\", \"0\") != \"1\")\n        if self._use_gpu_batched:\n            self._row_major_sm = 1\n            full_fixed = ((self._M_b // 64) * (self._K_b // 64) * 16\n                          + self._M_b * self._K_b // 2 + self._M_b * self._K_b\n                          + (self._M_b // 16) * (self._K_b // 16))\n            self._max_exc_pb = max(8, (self._raw_bytes - full_fixed) // 6 + 8)\n            logger.info(\"P4Flat GPU KV encoder: compress_batched (single kernel)\")\n\n        host_bytes = sum(\n            t.nbytes\n            for layer_pools in self._host_pools.values()\n            for kv_pool in layer_pools.values()\n            for t in kv_pool.values())\n        logger.info(\n            \"P4Flat KV buffers warmed up: block_shape=%s block_numel=%d \"\n            \"(M_b=%d K_b=%d) fixed=%dB raw=%dB blob_stride=%dB max_comp=%dB \"\n            \"max_n_blocks=%d max_gpu_decomp=%d n_layers=%d host=%.1fMB\",\n            block_shape, block_numel, M_b, K_b, fixed_bytes, raw_bytes,\n            blob_stride, max_comp_size, max_n_blocks, max_gpu_decomp_blocks,\n            n_layers, host_bytes / 1024**2)\n\n    # ------------------------------------------------------------------\n    #  Slot move (override — single blob + meta layout)\n    # ------------------------------------------------------------------\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool['blob'][dst_slot].copy_(pool['blob'][src_slot])\n            pool['total_size'][dst_slot] = pool['total_size'][src_slot]\n            pool['exc_cnt'][dst_slot] = pool['exc_cnt'][src_slot]\n            pool['is_raw'][dst_slot] = pool['is_raw'][src_slot]\n            pool['valid_rows'][dst_slot] = pool['valid_rows'][src_slot]\n\n    # ------------------------------------------------------------------\n    #  Compress\n    # ------------------------------------------------------------------\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        \"\"\"Batched slot assignment: one indexed read of the slot table instead\n        of a per-block ``.item()`` (the latter cost ~0.2 ms for 128 blocks).\n        Most blocks in steady state already own a slot, so only genuinely new\n        blocks take the per-element write tail.  Accepts a list or int64 numpy\n        array and returns the physical slots as a numpy array (no list round\n","exit_code":0,"duration":{"secs":0,"nanos":7552},"formatted_output":"            #       directly from secondary_kv (no extra D2H) and writes\n            #       into the persistent compressed host pool.  Supported only\n            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n            #       manager), p4flat, and ChunkDelta3 (Python worker boundary\n            #       around an OpenMP C++ encoder).\n            # Default is backend-aware.  ZipServ is CPU-encode only in the\n            # serving path: raw KV is first swapped to secondary_kv and its C++\n            # worker manager compresses directly from that host tensor.  This\n            # is also enforced below so an inherited producer env cannot route\n            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n            # host_encode_blocks) variant of the p4flat codec — it always uses\n            # the cpu_after_raw_swap producer, regardless of the env default.\n            # p4flat's gpu_direct compress runs 3 device kernels\n            # (compress_lean) on comp_stream.  When weight compression is also\n            # active, those kernels contend with weight-decompress + fused-mm\n            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n            # default p4flat to the CPU encoder whenever weight comp is on (the\n            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n            # where the GPU has spare SMs and the two paths are on par\n            # (180 vs 176 ms).  An explicit env value below still overrides.\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\"):\n                _default_producer = \"cpu_after_raw_swap\"\n            elif kv_comp_backend == \"chunk_delta3\":\n                # CD3 GPU encode contends directly with fused weight decode/MM\n                # once KV offload begins.  The host encoder consumes the raw\n                # secondary copy asynchronously and is the serving default.\n                _default_producer = \"cpu_after_raw_swap\"\n            elif (kv_comp_backend == \"p4flat\"\n                    and DualMemoryLoader.use_weight_comp):\n                _default_producer = \"cpu_after_raw_swap\"\n            else:\n                _default_producer = \"gpu_direct\"\n            kv_comp_producer = os.getenv(\n                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n                    f\"'cpu_after_raw_swap'.\")\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\") and \\\n                    kv_comp_producer != \"cpu_after_raw_swap\":\n                logger.warning(\n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n                    f\"(backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent split: sm stays in HBM, exp is\n                # ANS-compressed and persisted in LPDDR (see\n                # tiered_serve/mantexp_kv_compressor.py).\n                if not self.mantexp_split_kv:\n                    logger.warning(\n                        \"KV backend 'mantexp' selected without \"\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n                #                         host_encode_blocks)\n                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n                # follows the producer mode (defaults to gpu_direct).\n                # See tiered_serve/p4flat_kv_compressor.py.\n                from tiered_serve.p4flat_kv_compressor import (\n                    P4FlatCPUKVCompressor,\n                    P4FlatKVCompressor,\n                )\n                if (kv_comp_backend == \"p4flatcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = P4FlatCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: P4Flat (CPU encode, \"\n                        \"C++ OpenMP host_encode_blocks)\")\n                else:\n                    self.kv_compressor = P4FlatKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            elif kv_comp_backend == \"chunk_delta3\":\n                from tiered_serve.chunk_delta3_kv_compressor import (\n                    ChunkDelta3CPUKVCompressor,\n                    ChunkDelta3KVCompressor,\n                )\n                if kv_comp_producer == \"cpu_after_raw_swap\":\n                    self.kv_compressor = ChunkDelta3CPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 (CPU OpenMP encode, \"\n                        \"batched GPU decode)\")\n                else:\n                    self.kv_compressor = ChunkDelta3KVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: ChunkDelta3 \"\n                        \"(batched GPU encode/decode)\")\n            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n                #                         nvcomp_bitcomp_compress_batch)\n                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n        if result != 0:\n            raise RuntimeError(\n                f\"cudaEventSynchronize failed for CD3 CPU encode: {result}\")\n    else:  # pragma: no cover - libcudart is present in serving containers\n        torch.cuda.synchronize()\n\n\nclass ChunkDelta3CPUKVCompressor(ChunkDelta3KVCompressor):\n    \"\"\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\n\n    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\n    that D2H event and encodes directly from the host tensor into persistent\n    physical slots, keeping encode kernels off the fused-MM critical path.\n    \"\"\"\n\n    _USES_GPU_COMPRESS = False\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n            raise RuntimeError(\n                \"ChunkDelta3CPUKVCompressor requires the CPU-enabled \"\n                \"tp3_cd3_ext\")\n        super().__init__(comp_stream)\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # Grace serving usually produces only eight newly-full blocks per\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n        # series; eight small teams instead pipeline independent layers across\n        # the same CPU budget.  Retain the established one-worker x86 default.\n        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        compression_cpu_count = len([\n            cpu for cpu in os.sched_getaffinity(0)\n            if cpu >= self._reserve_cores])\n        default_omp_threads = str(max(\n            1, (compression_cpu_count + self._n_workers - 1)\n            // self._n_workers))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._timing_raw_wait = 0.0\n        self._timing_decode_wait = 0.0\n        self._timing_encode = 0.0\n        self._timing_count = 0\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n            if self.kv_compressor is not None:\n                k_cache = DualMemoryLoader.primary_k_caches[0]\n                block_shape = tuple(k_cache.shape[1:])\n                block_size = k_cache.shape[1]  # tokens per block\n                # Host pools must cover ALL block_ids for persistent\n                # block_id-indexed compressed storage.\n                num_primary_blocks = k_cache.shape[0]\n                # GPU staging pools only need per-iteration capacity.\n                max_iter_blocks = (\n                    -(- self.max_num_batched_tokens // block_size)\n                    + self.batch_size\n                )\n                # Use pre-allocated hugepage pools from vllm cache engine\n                # if available (allocated before hugepages are exhausted).\n                pre_pools = getattr(DualMemoryLoader, 'zipserv_host_pools', None)\n                self.kv_compressor.warmup_kv_buffers(\n                    block_shape, num_primary_blocks, self.n_layers,\n                    max_gpu_blocks=max_iter_blocks,\n                    max_gpu_decomp_blocks=num_primary_blocks,\n                    huge_page_allocator=self.huge_page_allocator,\n                    pre_allocated_host_pools=pre_pools)\n                # Init C++ compress worker threads (D2H + compress)\n                n_compress_workers = int(os.getenv(\n                    \"TIERED_SERVE_KV_COMPRESS_WORKERS\", str(os.cpu_count() - 10)))\n                self.kv_compressor.init_kv_compress_workers(\n                    n_compress_workers, max_iter_blocks, self.n_layers)\n\n        # Startup has finished its CPU-heavy checkpoint copies and\n        # torch.compile work.  Constrain only the engine main thread's ATen\n        # OpenMP team now, before graph capture / the first serving KV encode.\n        # P4Flat's async worker is a different OpenMP master and explicitly\n        # installs its dedicated team size on its first encode, so it remains\n        # at TIERED_SERVE_KV_COMPRESS_OMP_THREADS (56 by default).\n        if os.getenv(\"TIERED_SERVE_OMP_PHASE_SWITCH\", \"0\") == \"1\":\n            main_threads = max(1, int(os.getenv(\n                \"TIERED_SERVE_MAIN_OMP_THREADS\", \"1\")))\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n                'cd': torch.empty(max_gpu_blocks * cdb, dtype=torch.uint8).pin_memory(),\n                # Device exception count, D2H'd with the payload (compress_lean\n                # returns it on-device so the call stays sync-free).\n                'ec': torch.empty(1, dtype=torch.int32).pin_memory(),\n            }\n\n        host_n = max_n_blocks + 1  # +1 safety row\n\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\n            specs = {\n                'blob':       ((host_n, blob_stride), torch.uint8),\n                'total_size': ((host_n,),               torch.int32),\n                'exc_cnt':    ((host_n,),               torch.int32),\n                'is_raw':     ((host_n,),               torch.uint8),\n                # Occupancy: number of decoded rows for this slot (== M_b for a\n                # full block).  Read by decode to size comp.M / the raw view.\n                'valid_rows': ((host_n,),               torch.int32),\n            }\n            pool = {}\n            for name, (shape, dtype) in specs.items():\n                t = None\n                if huge_page_allocator is not None:\n                    for page_type in (\"kv\", \"weight\"):\n                        try:\n                            numel = 1\n                            for s in shape:\n                                numel *= s\n                            t = huge_page_allocator.allocate(\n                                (numel,), (1,), dtype, page_type=page_type)\n                            t = t.view(shape)\n                            break\n                        except (MemoryError, ValueError):\n                            continue\n                if t is None:\n                    t = torch.empty(*shape, dtype=dtype,\n                                    device='cpu').pin_memory()\n                pool[name] = t\n            # Default to full-height decode; partial encodes overwrite per slot.\n            pool['valid_rows'].fill_(M_b)\n            # Zero the meta so an un-encoded / not-yet-written slot reads as a\n            # bounded empty block instead of torch.empty garbage.  The decode\n            # sizes the exception patch-kernel grid from int(exc_cnt[slots].max())\n            # and the blob length from total_size; garbage there → out-of-bounds\n            # grid → cudaErrorIllegalAddress (manifested on the slower CPU-encode\n            # path which can race the decode of a freshly-(re)assigned slot).\n            pool['exc_cnt'].zero_()\n            pool['is_raw'].zero_()\n            pool['total_size'].zero_()\n            return pool\n\n        if pre_allocated_host_pools is not None:\n            self._host_pools = pre_allocated_host_pools\n            # Externally-sized pools predate the occupancy field — add a\n            # full-height ``valid_rows`` mirror where missing so decode/encode\n            # can read it uniformly.\n            for layer_pools in self._host_pools.values():\n                for kv_pool in layer_pools.values():\n                    if 'valid_rows' not in kv_pool:\n                        vr = torch.empty(host_n, dtype=torch.int32,\n                                         device='cpu').pin_memory()\n                        vr.fill_(M_b)\n                        kv_pool['valid_rows'] = vr\n        else:\n            self._host_pools = {}\n            for layer_id in range(n_layers):\n                self._host_pools[layer_id] = {\n                    'k': _alloc_host_pool(),\n                    'v': _alloc_host_pool(),\n                }\n\n        # GPU staging blob pools for decode H2D — SEPARATE K and V buffers so\n        # both host-pool reads issue back-to-back and a per-layer event marks\n        # \"host['blob'] fully read\".  The CPU-encode unload WORKER waits on that\n        # event (wait-based, on its own thread) before overwriting the slots, so\n        # the main thread is NOT host-synchronized and per-layer decodes pipeline\n        # (prefetch overlaps compute).  Double-buffering is GPU-HBM only.\n        self._gpu_dec_blob = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        self._gpu_dec_blob_v = torch.empty(\n            max_gpu_decomp_blocks + 1, blob_stride,\n            dtype=torch.uint8, device='cuda')\n        # 2-slot blob ring for the load_kv_stream split (slot 0 reuses the\n        # buffers above; slot 1 is the extra double-buffer).  The H2D writes a\n        # slot on load_kv_stream and the decode reads it on batch_decomp_stream;\n        # the per-slot ``consumed`` event gates the NEXT reuse so the two\n        # streams overlap (H2D L+1 ∥ decode L) without racing the staging blob.\n        self._dec_blob_ring = [\n            self._gpu_dec_blob,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_v_ring = [\n            self._gpu_dec_blob_v,\n            torch.empty(max_gpu_decomp_blocks + 1, blob_stride,\n                        dtype=torch.uint8, device='cuda')]\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for _e in self._dec_blob_consumed:\n            _e.record()\n        # Per-layer \"decode H2D of host['blob'] complete\" events — external=True\n        # so the C++ worker can wait on .cuda_event, enable_timing=True so the\n        # breakdown can elapsed_time() them.  Paired with _kv_h2d_begin (right\n        # before the blob H2D) to isolate the compressed-KV H2D from decode.\n        self._kv_dec_h2d = [torch.cuda.Event(enable_timing=True, external=True)\n                            for _ in range(n_layers)]\n        self._kv_h2d_begin = [torch.cuda.Event(enable_timing=True,\n                                               external=True)\n                              for _ in range(n_layers)]\n        # Tight decode-kernel begin.  _kv_dec_h2d is recorded on the H2D\n        # producer stream, so elapsed_time(_kv_dec_h2d, decode_end) also\n        # includes any older work / WAR wait already queued on\n        # batch_decomp_stream.  Record on the consumer stream after those waits\n        # and immediately before the codec kernels to measure KVDecomp itself.\n        self._kv_decode_begin = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Pre-record once so elapsed_time() on a layer that doesn't decode this\n        # step sees a (stale, pre-init) recording instead of raising.\n        for _e in self._kv_dec_h2d:\n            _e.record()\n        for _e in self._kv_h2d_begin:\n            _e.record()\n        for _e in self._kv_decode_begin:\n            _e.record()\n\n        # Async metadata-staging ring (see __init__).  Each decode chunk gathers\n        # its per-block meta into one ring slot's pinned buffers (contiguous\n        # prefixes -> one valid async H2D per group, no stack, no pageable temp)\n        # and records an event; reusing a slot first waits on that event, so the\n        # CPU never overwrites a buffer whose H2D is still in flight (the\n        # documented torn-meta IMA).  ``cap`` = the GPU decomp staging width, so\n        # a chunk's meta count never exceeds it.  R slots absorb the\n        # CPU-races-ahead window without actually blocking; event-gating keeps it\n        # correct for any lag.\n        if not self._meta_sync_fallback:\n            cap = max_gpu_decomp_blocks\n            R = int(os.getenv(\"TIERED_SERVE_META_RING_N\", \"16\"))\n            self._meta_ring_n = R\n            self._meta_ring_pi = [\n                torch.empty(5 * cap, dtype=torch.int32).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_pu = [\n                torch.empty(2 * cap, dtype=torch.uint8).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_b = [\n                torch.empty(cap, dtype=torch.int64).pin_memory()\n                for _ in range(R)]\n            self._meta_ring_ev = [torch.cuda.Event() for _ in range(R)]\n            for _e in self._meta_ring_ev:\n                _e.record()\n            self._meta_ring_idx = 0\n\n        self._persistent_valid = {\n            lid: bytearray(host_n) for lid in range(n_layers)}\n        self._secondary_fallback_possible = {\n            lid: False for lid in range(n_layers)}\n        # int64 so a decode gather yields index_select-ready indices with no\n        # per-layer .long() cast (the int32 saved nothing — values are slots).\n        # The numpy array is the AUTHORITY and the torch tensor is a\n        # zero-copy ``from_numpy`` view of the SAME memory: the per-step\n        # assign path (compress submit) runs in numpy (~5 µs vs ~26 µs for\n        # the equivalent five torch CPU ops), while the decode path keeps\n        # gathering through the torch view unchanged.\n        self._kv_slot_np = {\n            lid: np.full(host_n, -1, dtype=np.int64)\n            for lid in range(n_layers)\n        }\n        self._kv_slot = {\n            lid: torch.from_numpy(self._kv_slot_np[lid])\n            for lid in range(n_layers)\n        }\n        self._kv_slot_block = {lid: [-1] * host_n for lid in range(n_layers)}\n        self._kv_active_count = {lid: 0 for lid in range(n_layers)}  # hwm\n        self._kv_free_heap = {lid: [] for lid in range(n_layers)}\n        self._kv_free_slots = {lid: set() for lid in range(n_layers)}\n        # Decode fast-path pre-binding: the per-layer hot references are\n        # resolved ONCE here so the per-layer decode does a single tuple\n        # unpack instead of ~15 dict/attr lookups (every statement on the\n        # forward