t(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Give CPU workers a completed initial event for layers that have not\n        # loaded persistent compressed data yet.\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for event in self._kv_dec_h2d:\n                event.record(self.batch_decomp_stream)\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            for name in self._FIELDS:\n                pool[name][dst_slot].copy_(pool[name][src_slot])\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_table = self._kv_slot_np[layer_id]\n        previous = int(slot_table[bid])\n        if previous >= 0:\n            return previous\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot = -1\n        while heap:\n            candidate = heapq.heappop(heap)\n            if candidate in free_set:\n                free_set.discard(candidate)\n                slot = candidate\n                break\n        if slot < 0:\n            slot = self._kv_active_count[layer_id]\n            if slot >= len(self._kv_slot_block[layer_id]):\n                raise RuntimeError(\n                    f\"ChunkDelta3 KV persistent slot pool full for \"\n                    f\"layer={layer_id