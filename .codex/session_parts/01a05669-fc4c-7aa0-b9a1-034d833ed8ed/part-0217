cks + 1)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            storage_slots = (\n                list(range(n)) if packed_h2d else slots)\n            slots_gpu = torch.as_tensor(\n                storage_slots, dtype=torch.int32, device=k_cache.device)\n            block_ids_gpu = torch.as_tensor(\n                block_ids, dtype=torch.long, device=k_cache.device)\n            for kv, cache in ((\"k\", k_cache), (\"v\", v_cache)):\n                host = self._host_pools[layer_id][kv]\n                gpu = self._gpu_decomp_pool[kv]\n                if packed_h2d:\n                    for row_begin, row_end, slot_begin in slot_runs:\n                        length = row_end - row_begin\n                        for name in self._FIELDS[:-1]:\n                            gpu[name][row_begin:row_end].copy_(\n                                host[name][slot_begin:slot_begin + length],\n                                non_blocking=True)\n                    storage_rows = n\n                else:\n                    # A highly fragmented request is cheaper as five dense\n                    # prefix copies than as hundreds of tiny field copies.\n                    for name in self._FIELDS[:-1]:\n                        gpu[name][:hwm].copy_(\n                            host[name][:hwm], non_blocking=True)\n                    storage_rows = hwm\n                _cd3_ext.decompress_chunk_delta3_batched_indexed(\n                    gpu[\"codes\"][:storage_rows],\n                    gpu[\"sign_mantissa\"][:storage_rows],\n                    gpu[\"thread_bases\"][:storage_rows],\n                    gpu[\"tile_exception_offsets\"][:storage_rows],\n                    gpu[\"entries20x3\"][:storage_rows],\n                    slots_gpu,\n                    block_ids_gpu,\n                    cache.view(cache.shape[0], self._M_b, self._K_b),\n                )\n            # A CPU encoder may now overwrite persistent host slots only after\n           