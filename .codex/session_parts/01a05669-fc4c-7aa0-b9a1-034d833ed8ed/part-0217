des\"][:n],\n                    pool[\"sign_mantissa\"][:n],\n                    pool[\"thread_bases\"][:n],\n                    pool[\"tile_exception_offsets\"][:n],\n                    pool[\"entries20x3\"][:n],\n                    pool[\"num_exceptions\"][:n],\n                )\n                host = self._host_pools[layer_id][kv]\n                # Physical slots are persistent and may contain holes.  Keep\n                # the copies asynchronous on comp_stream; the event below\n                # gates publication and later slot reuse.\n                for row_begin, row_end, slot_begin in self._slot_runs(slots):\n                    length = row_end - row_begin\n                    for name in self._FIELDS:\n                        host[name][slot_begin:slot_begin + length].copy_(\n                            pool[name][row_begin:row_end], non_blocking=True)\n            event = self.comp_stream.record_event()\n\n        self._pending_compress[layer_id] = {\n            \"event\": event,\n            \"buffer_ids\": block_ids,\n            \"physical_slots\": slots,\n        }\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        del timeout_sec\n        state = self._pending_compress.pop(layer_id, None)\n        if state is None:\n            return\n        state[\"event\"].synchronize()\n        block_ids = state[\"buffer_ids\"]\n        slots = state[\"physical_slots\"]\n        for kv in (\"k\", \"v\"):\n            counts = self._host_pools[layer_id][kv][\"num_exceptions\"]\n            for bid, slot in zip(block_ids, slots):\n                count = int(counts[slot].item())\n                if count > self._entry_capacity:\n                    raise RuntimeError(\n                        \"ChunkDelta3 KV exception capacity exceeded: \"\n                        f\"layer={layer_id} kv={kv} block={bid} \"\n                        f\"count={count} capacity={s