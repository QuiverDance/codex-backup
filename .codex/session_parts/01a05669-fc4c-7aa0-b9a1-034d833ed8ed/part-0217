 % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass ChunkDelta3KVCompressor(DietGPUKVCompressor):\n    \"\"\"KV-only CD3 codec with batched GPU encode/decode kernels.\"\"\"\n\n    _USES_GPU_COMPRESS = True\n\n    _FIELDS = (\n        \"codes\", \"sign_mantissa\", \"thread_bases\",\n        \"tile_exception_offsets\", \"entries20x3\", \"num_exceptions\",\n    )\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"compress_chunk_delta3_batched\"):\n            raise RuntimeError(\n                \"ChunkDelta3KVCompressor requires the batched tp3_cd3_ext\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._bf16_decomp_out = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._max_n_blocks = 0\n        self._max_gpu_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        tiles = block_elements // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n        return (\n            tiles * 1536 + block_elements + tiles * 256\n            + (tiles + 1) * 4 + (entry_capacity // 3) * 8 + 4\n        )\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            for page_type in (\"kv\", \"weight\"):\n                try:\n                    return huge_page_allocator.allocate(\n                        (numel,), (1,), dtype, page_type=page_type).view(shape)\n                except (MemoryError, ValueError):\n                    pass\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _pool(self, rows: int, device: str,\n              huge_page_allocator=None) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        if device == \"cuda\":\n            return {\n                name: torch.empty(shape, dtype=dtype, device=\"cuda\")\n                for name, (shape, dtype) in specs.