{"timestamp":"2026-09-04T10:46:31.212Z","ordinal":21158,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a06c06-af3b-7680-bace-8cea6329687a","item":{"type":"CommandExecution","id":"exec-aa5afdcf-5f97-4dee-a99d-cc2ceca5559d","process_id":"3322","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"295,445p\" tiered_serve/p4flat_kv_compressor.py && sed -n \"1550,1730p\" tiered_serve/p4flat_kv_compressor.py && sed -n \"1770,1940p\" tiered_serve/p4flat_kv_compressor.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"295,445p\" tiered_serve/p4flat_kv_compressor.py && sed -n \"1550,1730p\" tiered_serve/p4flat_kv_compressor.py && sed -n \"1770,1940p\" tiered_serve/p4flat_kv_compressor.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"        self._iota_i = None      # cached arange (int32) for staging slots\n        # Host-side blob assembly is a strided scatter that numpy runs single-\n        # threaded (~7 ms for 4096 blocks, dwarfing the 1.1 ms GPU compress).\n        # numpy releases the GIL during the copy, so a small thread pool\n        # parallelises it (~3.5x).  Lazy-created; only used above a block-count\n        # threshold where the dispatch cost is amortised.\n        self._asm_pool = None\n        self._asm_nthreads = min(16, max(1, (os.cpu_count() or 8)))\n        self._asm_thread_thresh = 256\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        \"\"\"Worst-case host-pool bytes for one K (or one V) block.\n\n        Mirrors the per-block ``blob`` row stride reserved by\n        ``warmup_kv_buffers`` plus the per-block meta (``total_size`` /\n        ``exc_cnt`` / ``is_raw``).  A P4Flat block is stored either\n        compressed or — on raw fallback — as a full BF16 block, so the slot\n        is always reserved at ``align(raw_bytes, 128)`` (i.e. ~1x raw).\n\n        Use this from external callers (e.g. vLLM budget calculation) to\n        size the persistent compressed host pool without instantiating a\n        compressor.\n\n        Returns the byte size for ONE side (K or V).  Multiply by 2 for K+V.\n        \"\"\"\n        raw_bytes = block_elements * 2          # BF16\n        blob = _align(raw_bytes, 128)           # blob row stride\n        meta = 4 + 4 + 1                         # total_size + exc_cnt + is_raw\n        return blob + meta\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n        # contiguous runs with a vectorised padded diff.\n        seg = np.ones(n_rows, dtype=np.int16)\n        for h in free_set:\n            if lo <= h < hi:\n                seg[h - lo] = 0\n        d = np.diff(seg, prepend=0, append=0)\n        starts = np.flatnonzero(d == 1).tolist()\n        ends = np.flatnonzero(d == -1).tolist()\n        dst, src = [], []\n        for s, e in zip(starts, ends):\n            dst.append(gk[s:e]); src.append(bk[lo + s:lo + e])\n            dst.append(gv[s:e]); src.append(bv[lo + s:lo + e])\n        self._batch_h2d(dst, src)\n\n    def _batch_h2d(self, dst: list, src: list) -> None:\n        \"\"\"Submit a list of H2D copies as one driver call\n        (cudaMemcpyBatchAsync via zipserv_ext.batch_memcpy on the current —\n        i.e. batch_decomp — stream), falling back to ``_foreach_copy_``.\"\"\"\n        if not dst:\n            return\n        if len(dst) == 1:\n            dst[0].copy_(src[0], non_blocking=True)\n            return\n        _zs = self._batch_ext\n        if _zs is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as _zs\n            except Exception:\n                _zs = False\n            self._batch_ext = _zs\n        if _zs and hasattr(_zs, \"batch_memcpy\"):\n            _zs.batch_memcpy(dst, src,\n                             torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(dst, src, non_blocking=True)\n\n    def _wait_meta_ring_slot(self, ri: int) -> None:\n        \"\"\"Gate pinned meta-ring reuse without a host wait on the common path.\"\"\"\n        ev = self._meta_ring_ev[ri]\n        if not ev.query():\n            ev.synchronize()\n\n    def _decompress_batched(self, layer_id: int, block_ids: list,\n                            k_cache: torch.Tensor,\n                            v_cache: torch.Tensor) -> None:\n        \"\"\"Production fast path — deliberately SHORT.\n\n        Runs once per layer per step on the forward thread, where every\n        Python statement / torch dispatch is GPU-idle gap (the nsys\n        before_replay stall).  Handles the production shape only: single\n        chunk (hwm <= staging cap), async meta ring, static grid bounds,\n        dense-ish slots.  Everything else (multi-chunk, sync-meta rollback,\n        VALIDATE=1 full checks, time-breakdown events, hole-heavy staging)\n        falls back to ``_decompress_batched_general``.\n        \"\"\"\n        active = self._kv_active_count[layer_id]\n        free_set = self._kv_free_slots.get(layer_id)\n        if (active > self._dec_cap or self._meta_sync_fallback\n                or self._decode_validate or self._tb\n                or (free_set and len(free_set) >= self._decode_hole_threshold)):\n            return self._decompress_batched_general(\n                layer_id, block_ids, k_cache, v_cache)\n        if active == 0:\n            return\n\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        _cc = self._cbids_cache_np\n        hit = (_cc is not None and _cc.shape == bid_arr.shape\n               and np.array_equal(_cc, bid_arr))\n        bids = self._cbids_cache_t if hit else torch.from_numpy(bid_arr)\n        slots = slot_tbl[bids]\n        n = slots.numel()\n        if n == 0:\n            return\n\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        self._wait_meta_ring_slot(ri)                # gate ring-slot reuse\n        pif[0:n].copy_(slots)\n        torch.index_select(kvr, 0, slots, out=pif[n:2 * n])\n        torch.index_select(kec, 0, slots, out=pif[2 * n:3 * n])\n        torch.index_select(vvr, 0, slots, out=pif[3 * n:4 * n])\n        torch.index_select(vec, 0, slots, out=pif[4 * n:5 * n])\n        torch.index_select(kir, 0, slots, out=puf[0:n])\n        torch.index_select(vir, 0, slots, out=puf[n:2 * n])\n\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\n        rsm = self._row_major_sm\n        with torch.cuda.stream(self.batch_decomp_stream):\n            gi = pif[:5 * n].cuda(non_blocking=True)\n            gu = puf[:2 * n].cuda(non_blocking=True)\n            if hit:\n                cbids = self._cbids_cache_gpu\n            else:\n                bif = self._meta_ring_b[ri]\n                bif[0:n].copy_(bids)\n                cbids = bif[:n].cuda(non_blocking=True)\n                self._cbids_cache_np = bid_arr\n                self._cbids_cache_t = bids\n                self._cbids_cache_gpu = cbids\n            self._meta_ring_ev[ri].record(self.batch_decomp_stream)\n            self._gpu_dec_blob[:active].copy_(hkb[:active], non_blocking=True)\n            self._gpu_dec_blob_v[:active].copy_(hvb[:active],\n                                                non_blocking=True)\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob, blob_stride, gi[0:n], cbids,\n                gi[n:2 * n], gi[2 * n:3 * n], gu[0:n], k_cache.reshape(-1),\n                block_numel, K_b, M_b, exc_cap, rsm)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob_v, blob_stride, gi[0:n], cbids,\n                gi[3 * n:4 * n], gi[4 * n:5 * n], gu[n:2 * n],\n                v_cache.reshape(-1), block_numel, K_b, M_b, exc_cap, rsm)\n\n    def _decompress_split_singlechunk(\n            self, layer_id, active, blob_stride, host_k, host_v, bid_arr,\n            bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n            M_b, K_b, block_numel, rsm, exc_cap):\n        \"\"\"Single-chunk KV decode with the compressed-blob H2D on\n        ``load_kv_stream`` and the decode kernels on ``batch_decomp_stream``.\n\n        A 2-slot blob ring double-buffers the staging blob so layer L+1's LOAD\n        (load_kv_stream) overlaps layer L's DECODE (batch_decomp_stream) — the\n        per-slot ``consumed`` event gates reuse so the two streams never race on\n        the blob.  ``load_kv_stream`` is gated by the graph wrapper on \"QKV\n        weights loaded\", so the H2D starts when the single copy engine is free\n        of weight H2D (otherwise the H2D queues behind weight and the\n        breakdown's KVLoad interval absorbs that wait).  Mirrors the common\n        async-ring single-chunk path of ``_decompress_batched_general``\n        (lo == 0, no per-block slot rebase).\"\"\"\n        n = active\n        if layer_id == 0:\n            self._splitcnt = getattr(self, \"_splitcnt\", 0) + 1\n            if self._splitcnt % 50 == 1:\n                logger.info(\n                    \"[KVStageDbg] L0 staging n=%d blocks (active_count) \"\n                    \"blob_stride=%d -> %.2f MB K+V this layer\",\n                    n, self._blob_stride, n * self._blob_stride * 2 / 1024**2)\n        ds = self.batch_decomp_stream\n        ls = self.load_kv_stream\n        slot = self._dec_blob_ring_idx & 1\n        self._dec_blob_ring_idx += 1\n        gk_blob = self._dec_blob_ring[slot]\n        gv_blob = self._dec_blob_v_ring[slot]\n\n        # ── CPU: gather per-block meta into one pinned ring slot ──\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        bif = self._meta_ring_b[ri]\n        self._wait_meta_ring_slot(ri)                # gate pinned reuse\n        orig_slots = slots_cpu.long()\n        pif[0:n].copy_(slots_cpu)                     # lo == 0 → no rebase\n        torch.index_select(host_k['valid_rows'], 0, orig_slots, out=pif[n:2 * n])\n        torch.index_select(host_k['exc_cnt'], 0, orig_slots, out=pif[2 * n:3 * n])\n        torch.index_select(host_v['valid_rows'], 0, orig_slots, out=pif[3 * n:4 * n])\n        torch.index_select(host_v['exc_cnt'], 0, orig_slots, out=pif[4 * n:5 * n])\n        torch.index_select(host_k['is_raw'], 0, orig_slots, out=puf[0:n])\n        torch.index_select(host_v['is_raw'], 0, orig_slots, out=puf[n:2 * n])\n        if not ids_cached:\n            bif[0:n].copy_(bids_cpu)\n        mvrk = mvrv = M_b\n        meck = mecv = exc_cap\n        _smax = int(pif[0:n].max())                   # slot-range guard (CPU)\n        if _smax >= n or _smax < 0:\n            logger.error(\n                \"[kv-decode] SKIP bad args L%d active=%d slot_max=%d \"\n                \"(M_b=%d exc_cap=%d) -- would CUDA-IMA\",\n                layer_id, active, _smax, M_b, exc_cap)\n            return\n\n        # ── LOAD: blob + meta H2D on load_kv_stream (copy engine free) ──\n        with torch.cuda.stream(ls):\n            if self._dec_blob_consumed is not None:\n                ls.wait_event(self._dec_blob_consumed[slot])   # gate slot reuse\n            if self._dec_blob_consumed is not None:\n                self._dec_blob_consumed[slot].record(ds)\n\n    def _decompress_batched_general(self, layer_id: int, block_ids: list,\n                                    k_cache: torch.Tensor,\n                                    v_cache: torch.Tensor) -> None:\n        M_b, K_b = self._M_b, self._K_b\n        block_numel = M_b * K_b\n        rsm = int(self._row_major_sm)\n        blob_stride = self._gpu_dec_blob.stride(0)          # bytes/row (uint8)\n        cap = self._gpu_dec_blob.shape[0] - 1               # staging rows\n        active = self._kv_active_count[layer_id]\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n\n        # Slot (compressed-pool row) for each requested block.  Active blocks\n        # occupy slots [0, active); stage a CONTIGUOUS slot range per chunk in\n        # one big pinned H2D and the kernel reads each block from its slot.\n        # NOTE: one contiguous copy_ (single DMA) measured ~2x faster than a\n        # per-block cudaMemcpyBatchAsync gather of used-bytes — small per-block\n        # copies can't saturate the copy engine, and the 25% padding saved is\n        # dwarfed by that penalty (kv_h2d 64ms vs 118ms in E2E).\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        # Step-level block-id cache: all layers of a step decode the SAME\n        # filtered active set (only the per-layer slot tables differ), so the\n        # id vector's CPU tensor + device upload are built once and reused by\n        # the other ~n_layers-1 calls.  Content-keyed (memcmp, ~µs for ~6k\n        # ids) so a changed active set is just a miss, never staleness.\n        _cc = self._cbids_cache_np\n        ids_cached = (_cc is not None and _cc.shape == bid_arr.shape\n                      and np.array_equal(_cc, bid_arr))\n        bids_cpu = (self._cbids_cache_t if ids_cached\n                    else torch.from_numpy(bid_arr))\n        slots_cpu = self._kv_slot[layer_id][bids_cpu]\n        k_flat = k_cache.reshape(-1)\n        v_flat = v_cache.reshape(-1)\n\n        single_chunk = active <= cap\n        sync_meta = self._meta_sync_fallback\n        _exc_cap = (blob_stride - self._fixed_bytes) // 6\n\n        # KV-load stream split: the blob H2D goes on load_kv_stream (free of\n        # weight H2D) and the decode on batch_decomp_stream, double-buffered so\n        # the two pipeline.  Only the common single-chunk async path is split;\n        # sync-meta / multi-chunk / VALIDATE keep the original single-stream\n        # path below (rare, and the split's slot bookkeeping assumes one chunk).\n        if (self.load_kv_stream is not None\n                and single_chunk and not sync_meta and not self._decode_validate):\n            return self._decompress_split_singlechunk(\n                layer_id, active, blob_stride, host_k, host_v, bid_arr,\n                bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n                M_b, K_b, block_numel, rsm, _exc_cap)\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for lo in range(0, active, cap):\n                hi = min(lo + cap, active)\n                if single_chunk:\n                    # Common case: every block's slot is < active <= cap, so the\n                    # whole set is one chunk — skip the >=lo/<hi mask + nonzero.\n                    orig_slots = slots_cpu.long()\n                    slots_chunk = slots_cpu                   # int32, lo == 0\n                    cbids_src = bids_cpu\n                else:\n                    sel = ((slots_cpu >= lo) & (slots_cpu < hi)).nonzero(\n                        as_tuple=True)[0]\n                    if sel.numel() == 0:\n                        continue\n                    orig_slots = slots_cpu[sel].long()\n                    slots_chunk = slots_cpu[sel]              # int32, subtract lo\n                    cbids_src = bids_cpu[sel]\n                n = orig_slots.numel()\n                if n == 0:\n                    continue\n\n                if sync_meta:\n                    # --- legacy synchronous path (TIERED_SERVE_KV_META_SYNC=1) ---\n                    # torch.stack(...).cuda() of pageable memory is SYNCHRONOUS\n                    # (~1 ms/graph CPU dispatch) but never reuses a buffer, so it\n                    # can't hit the torn-meta race.  Kept as a rollback.\n                    cs_cpu = (slots_chunk.to(torch.int32) if lo == 0\n                              else (slots_chunk - lo).to(torch.int32))\n                    vrk = host_k['valid_rows'][orig_slots]\n                    eck = host_k['exc_cnt'][orig_slots]\n                    vrv = host_v['valid_rows'][orig_slots]\n                    ecv = host_v['exc_cnt'][orig_slots]\n                    mvrk = int(vrk.max()); meck = int(eck.max()) if eck.numel() else 0\n                    mvrv = int(vrv.max()); mecv = int(ecv.max()) if ecv.numel() else 0\n                    _smax = int(cs_cpu.max()) if cs_cpu.numel() else -1\n                    ri = -1\n                else:\n                    # --- async ring path (default) ---\n                    # Gather each field into a CONTIGUOUS pinned prefix of one\n                    # ring slot, then issue ONE async H2D per group.  A [:k]\n                    # prefix of a pinned 1-D buffer is contiguous -> a valid async\n                    # transfer (unlike a [5,n] column-slice, which is\n                    # non-contiguous and raised cudaErrorInvalidValue before).\n                    ri = self._meta_ring_idx % self._meta_ring_n\n                    self._meta_ring_idx += 1\n                    pif = self._meta_ring_pi[ri]   # int32 [5*cap]\n                    puf = self._meta_ring_pu[ri]   # uint8 [2*cap]\n                    bif = self._meta_ring_b[ri]    # int64 [cap]\n                    # Gate reuse: block only if this slot's prior H2D is still\n                    # in flight (the lag that overwrote the single per-layer\n                    # buffer before).  With R slots this is ~never a real wait.\n                    self._wait_meta_ring_slot(ri)\n                    # cs = chunk-local slot (slot - lo); the rest are per-slot\n                    # gathers.  index_select writes straight into the pinned\n                    # prefix (no pageable intermediate).\n                    pif[0:n].copy_(slots_chunk)\n                    if lo:\n                        pif[0:n] -= lo\n                    torch.index_select(host_k['valid_rows'], 0, orig_slots,\n                                       out=pif[n:2 * n])\n                    torch.index_select(host_k['exc_cnt'], 0, orig_slots,\n                                       out=pif[2 * n:3 * n])\n                    torch.index_select(host_v['valid_rows'], 0, orig_slots,\n                                       out=pif[3 * n:4 * n])\n                    torch.index_select(host_v['exc_cnt'], 0, orig_slots,\n                                       out=pif[4 * n:5 * n])\n                    torch.index_select(host_k['is_raw'], 0, orig_slots,\n                                       out=puf[0:n])\n                    torch.index_select(host_v['is_raw'], 0, orig_slots,\n                                       out=puf[n:2 * n])\n                    if not (ids_cached and single_chunk):\n                        bif[0:n].copy_(cbids_src)\n                    # Kernel-grid bounds.  The per-block valid_rows/exc_cnt\n                    # device arrays bound each block's work IN-KERNEL, so the\n                    # grid only needs an upper bound — static caps replace\n                    # four per-layer pinned .max() reductions (forward-thread\n                    # CPU dispatch).  VALIDATE=1 restores the exact maxes\n                    # (tighter grids + corrupt-meta detection).\n                    if self._decode_validate:\n                        mvrk = int(pif[n:2 * n].max()); meck = int(pif[2 * n:3 * n].max())\n                        mvrv = int(pif[3 * n:4 * n].max()); mecv = int(pif[4 * n:5 * n].max())\n                    else:\n                        mvrk = mvrv = M_b\n                        meck = mecv = _exc_cap\n                    # Slot-range guard stays (one cheap reduction): a slot >=\n                    # staged rows is the one arg class the static caps can't\n                    # rule out and it would IMA the decode kernel.\n                    _smax = int(pif[0:n].max())\n\n                if self._tb:\n                    self._kv_h2d_begin[layer_id].record(\n                        self.batch_decomp_stream)\n                self._stage_blob_h2d(layer_id, lo, hi, host_k, host_v)\n                self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n                # Defensive bounds-check: serve's high block-free/reuse churn has\n                # produced decode args beyond the staged range (a slot >= the\n                # rows just copied, or a corrupt valid_rows / exc_cnt from a\n                # stale or torn pool slot) which makes BF16P4Flat_DecompressBatch\n                # read/write out of bounds -> CUDA IMA that takes down the\n                # engine.  Validate cheaply on the CPU args and SKIP + log this\n                # chunk's decode instead of crashing (the blob H2D + the worker's\n                # _kv_dec_h2d gate already ran, so this only drops the chunk's KV\n                # for the step).  The meta H2D below is skipped on a bad chunk, so\n                # the ring slot carries no in-flight read and needs no event.\n                _sn = hi - lo\n                if (_smax >= _sn or mvrk > M_b or mvrv > M_b\n                        or meck > _exc_cap or mecv > _exc_cap\n                        or _smax < 0):\n                    logger.error(\n                        \"[kv-decode] SKIP bad args L%d chunk[%d:%d] active=%d \"\n                        \"rows=%d slot_max=%d mvrk=%d mvrv=%d meck=%d mecv=%d \"\n                        \"(M_b=%d exc_cap=%d stride=%d fixed=%d) -- would CUDA-IMA\",\n                        layer_id, lo, hi, active, _sn, _smax, mvrk, mvrv,\n                        meck, mecv, M_b, _exc_cap, blob_stride,\n                        self._fixed_bytes)\n                    continue\n","stderr":"","aggregated_output":"        self._iota_i = None      # cached arange (int32) for staging slots\n        # Host-side blob assembly is a strided scatter that numpy runs single-\n        # threaded (~7 ms for 4096 blocks, dwarfing the 1.1 ms GPU compress).\n        # numpy releases the GIL during the copy, so a small thread pool\n        # parallelises it (~3.5x).  Lazy-created; only used above a block-count\n        # threshold where the dispatch cost is amortised.\n        self._asm_pool = None\n        self._asm_nthreads = min(16, max(1, (os.cpu_count() or 8)))\n        self._asm_thread_thresh = 256\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        \"\"\"Worst-case host-pool bytes for one K (or one V) block.\n\n        Mirrors the per-block ``blob`` row stride reserved by\n        ``warmup_kv_buffers`` plus the per-block meta (``total_size`` /\n        ``exc_cnt`` / ``is_raw``).  A P4Flat block is stored either\n        compressed or — on raw fallback — as a full BF16 block, so the slot\n        is always reserved at ``align(raw_bytes, 128)`` (i.e. ~1x raw).\n\n        Use this from external callers (e.g. vLLM budget calculation) to\n        size the persistent compressed host pool without instantiating a\n        compressor.\n\n        Returns the byte size for ONE side (K or V).  Multiply by 2 for K+V.\n        \"\"\"\n        raw_bytes = block_elements * 2          # BF16\n        blob = _align(raw_bytes, 128)           # blob row stride\n        meta = 4 + 4 + 1                         # total_size + exc_cnt + is_raw\n        return blob + meta\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n        # contiguous runs with a vectorised padded diff.\n        seg = np.ones(n_rows, dtype=np.int16)\n        for h in free_set:\n            if lo <= h < hi:\n                seg[h - lo] = 0\n        d = np.diff(seg, prepend=0, append=0)\n        starts = np.flatnonzero(d == 1).tolist()\n        ends = np.flatnonzero(d == -1).tolist()\n        dst, src = [], []\n        for s, e in zip(starts, ends):\n            dst.append(gk[s:e]); src.append(bk[lo + s:lo + e])\n            dst.append(gv[s:e]); src.append(bv[lo + s:lo + e])\n        self._batch_h2d(dst, src)\n\n    def _batch_h2d(self, dst: list, src: list) -> None:\n        \"\"\"Submit a list of H2D copies as one driver call\n        (cudaMemcpyBatchAsync via zipserv_ext.batch_memcpy on the current —\n        i.e. batch_decomp — stream), falling back to ``_foreach_copy_``.\"\"\"\n        if not dst:\n            return\n        if len(dst) == 1:\n            dst[0].copy_(src[0], non_blocking=True)\n            return\n        _zs = self._batch_ext\n        if _zs is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as _zs\n            except Exception:\n                _zs = False\n            self._batch_ext = _zs\n        if _zs and hasattr(_zs, \"batch_memcpy\"):\n            _zs.batch_memcpy(dst, src,\n                             torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(dst, src, non_blocking=True)\n\n    def _wait_meta_ring_slot(self, ri: int) -> None:\n        \"\"\"Gate pinned meta-ring reuse without a host wait on the common path.\"\"\"\n        ev = self._meta_ring_ev[ri]\n        if not ev.query():\n            ev.synchronize()\n\n    def _decompress_batched(self, layer_id: int, block_ids: list,\n                            k_cache: torch.Tensor,\n                            v_cache: torch.Tensor) -> None:\n        \"\"\"Production fast path — deliberately SHORT.\n\n        Runs once per layer per step on the forward thread, where every\n        Python statement / torch dispatch is GPU-idle gap (the nsys\n        before_replay stall).  Handles the production shape only: single\n        chunk (hwm <= staging cap), async meta ring, static grid bounds,\n        dense-ish slots.  Everything else (multi-chunk, sync-meta rollback,\n        VALIDATE=1 full checks, time-breakdown events, hole-heavy staging)\n        falls back to ``_decompress_batched_general``.\n        \"\"\"\n        active = self._kv_active_count[layer_id]\n        free_set = self._kv_free_slots.get(layer_id)\n        if (active > self._dec_cap or self._meta_sync_fallback\n                or self._decode_validate or self._tb\n                or (free_set and len(free_set) >= self._decode_hole_threshold)):\n            return self._decompress_batched_general(\n                layer_id, block_ids, k_cache, v_cache)\n        if active == 0:\n            return\n\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        _cc = self._cbids_cache_np\n        hit = (_cc is not None and _cc.shape == bid_arr.shape\n               and np.array_equal(_cc, bid_arr))\n        bids = self._cbids_cache_t if hit else torch.from_numpy(bid_arr)\n        slots = slot_tbl[bids]\n        n = slots.numel()\n        if n == 0:\n            return\n\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        self._wait_meta_ring_slot(ri)                # gate ring-slot reuse\n        pif[0:n].copy_(slots)\n        torch.index_select(kvr, 0, slots, out=pif[n:2 * n])\n        torch.index_select(kec, 0, slots, out=pif[2 * n:3 * n])\n        torch.index_select(vvr, 0, slots, out=pif[3 * n:4 * n])\n        torch.index_select(vec, 0, slots, out=pif[4 * n:5 * n])\n        torch.index_select(kir, 0, slots, out=puf[0:n])\n        torch.index_select(vir, 0, slots, out=puf[n:2 * n])\n\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\n        rsm = self._row_major_sm\n        with torch.cuda.stream(self.batch_decomp_stream):\n            gi = pif[:5 * n].cuda(non_blocking=True)\n            gu = puf[:2 * n].cuda(non_blocking=True)\n            if hit:\n                cbids = self._cbids_cache_gpu\n            else:\n                bif = self._meta_ring_b[ri]\n                bif[0:n].copy_(bids)\n                cbids = bif[:n].cuda(non_blocking=True)\n                self._cbids_cache_np = bid_arr\n                self._cbids_cache_t = bids\n                self._cbids_cache_gpu = cbids\n            self._meta_ring_ev[ri].record(self.batch_decomp_stream)\n            self._gpu_dec_blob[:active].copy_(hkb[:active], non_blocking=True)\n            self._gpu_dec_blob_v[:active].copy_(hvb[:active],\n                                                non_blocking=True)\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob, blob_stride, gi[0:n], cbids,\n                gi[n:2 * n], gi[2 * n:3 * n], gu[0:n], k_cache.reshape(-1),\n                block_numel, K_b, M_b, exc_cap, rsm)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob_v, blob_stride, gi[0:n], cbids,\n                gi[3 * n:4 * n], gi[4 * n:5 * n], gu[n:2 * n],\n                v_cache.reshape(-1), block_numel, K_b, M_b, exc_cap, rsm)\n\n    def _decompress_split_singlechunk(\n            self, layer_id, active, blob_stride, host_k, host_v, bid_arr,\n            bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n            M_b, K_b, block_numel, rsm, exc_cap):\n        \"\"\"Single-chunk KV decode with the compressed-blob H2D on\n        ``load_kv_stream`` and the decode kernels on ``batch_decomp_stream``.\n\n        A 2-slot blob ring double-buffers the staging blob so layer L+1's LOAD\n        (load_kv_stream) overlaps layer L's DECODE (batch_decomp_stream) — the\n        per-slot ``consumed`` event gates reuse so the two streams never race on\n        the blob.  ``load_kv_stream`` is gated by the graph wrapper on \"QKV\n        weights loaded\", so the H2D starts when the single copy engine is free\n        of weight H2D (otherwise the H2D queues behind weight and the\n        breakdown's KVLoad interval absorbs that wait).  Mirrors the common\n        async-ring single-chunk path of ``_decompress_batched_general``\n        (lo == 0, no per-block slot rebase).\"\"\"\n        n = active\n        if layer_id == 0:\n            self._splitcnt = getattr(self, \"_splitcnt\", 0) + 1\n            if self._splitcnt % 50 == 1:\n                logger.info(\n                    \"[KVStageDbg] L0 staging n=%d blocks (active_count) \"\n                    \"blob_stride=%d -> %.2f MB K+V this layer\",\n                    n, self._blob_stride, n * self._blob_stride * 2 / 1024**2)\n        ds = self.batch_decomp_stream\n        ls = self.load_kv_stream\n        slot = self._dec_blob_ring_idx & 1\n        self._dec_blob_ring_idx += 1\n        gk_blob = self._dec_blob_ring[slot]\n        gv_blob = self._dec_blob_v_ring[slot]\n\n        # ── CPU: gather per-block meta into one pinned ring slot ──\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        bif = self._meta_ring_b[ri]\n        self._wait_meta_ring_slot(ri)                # gate pinned reuse\n        orig_slots = slots_cpu.long()\n        pif[0:n].copy_(slots_cpu)                     # lo == 0 → no rebase\n        torch.index_select(host_k['valid_rows'], 0, orig_slots, out=pif[n:2 * n])\n        torch.index_select(host_k['exc_cnt'], 0, orig_slots, out=pif[2 * n:3 * n])\n        torch.index_select(host_v['valid_rows'], 0, orig_slots, out=pif[3 * n:4 * n])\n        torch.index_select(host_v['exc_cnt'], 0, orig_slots, out=pif[4 * n:5 * n])\n        torch.index_select(host_k['is_raw'], 0, orig_slots, out=puf[0:n])\n        torch.index_select(host_v['is_raw'], 0, orig_slots, out=puf[n:2 * n])\n        if not ids_cached:\n            bif[0:n].copy_(bids_cpu)\n        mvrk = mvrv = M_b\n        meck = mecv = exc_cap\n        _smax = int(pif[0:n].max())                   # slot-range guard (CPU)\n        if _smax >= n or _smax < 0:\n            logger.error(\n                \"[kv-decode] SKIP bad args L%d active=%d slot_max=%d \"\n                \"(M_b=%d exc_cap=%d) -- would CUDA-IMA\",\n                layer_id, active, _smax, M_b, exc_cap)\n            return\n\n        # ── LOAD: blob + meta H2D on load_kv_stream (copy engine free) ──\n        with torch.cuda.stream(ls):\n            if self._dec_blob_consumed is not None:\n                ls.wait_event(self._dec_blob_consumed[slot])   # gate slot reuse\n            if self._dec_blob_consumed is not None:\n                self._dec_blob_consumed[slot].record(ds)\n\n    def _decompress_batched_general(self, layer_id: int, block_ids: list,\n                                    k_cache: torch.Tensor,\n                                    v_cache: torch.Tensor) -> None:\n        M_b, K_b = self._M_b, self._K_b\n        block_numel = M_b * K_b\n        rsm = int(self._row_major_sm)\n        blob_stride = self._gpu_dec_blob.stride(0)          # bytes/row (uint8)\n        cap = self._gpu_dec_blob.shape[0] - 1               # staging rows\n        active = self._kv_active_count[layer_id]\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n\n        # Slot (compressed-pool row) for each requested block.  Active blocks\n        # occupy slots [0, active); stage a CONTIGUOUS slot range per chunk in\n        # one big pinned H2D and the kernel reads each block from its slot.\n        # NOTE: one contiguous copy_ (single DMA) measured ~2x faster than a\n        # per-block cudaMemcpyBatchAsync gather of used-bytes — small per-block\n        # copies can't saturate the copy engine, and the 25% padding saved is\n        # dwarfed by that penalty (kv_h2d 64ms vs 118ms in E2E).\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        # Step-level block-id cache: all layers of a step decode the SAME\n        # filtered active set (only the per-layer slot tables differ), so the\n        # id vector's CPU tensor + device upload are built once and reused by\n        # the other ~n_layers-1 calls.  Content-keyed (memcmp, ~µs for ~6k\n        # ids) so a changed active set is just a miss, never staleness.\n        _cc = self._cbids_cache_np\n        ids_cached = (_cc is not None and _cc.shape == bid_arr.shape\n                      and np.array_equal(_cc, bid_arr))\n        bids_cpu = (self._cbids_cache_t if ids_cached\n                    else torch.from_numpy(bid_arr))\n        slots_cpu = self._kv_slot[layer_id][bids_cpu]\n        k_flat = k_cache.reshape(-1)\n        v_flat = v_cache.reshape(-1)\n\n        single_chunk = active <= cap\n        sync_meta = self._meta_sync_fallback\n        _exc_cap = (blob_stride - self._fixed_bytes) // 6\n\n        # KV-load stream split: the blob H2D goes on load_kv_stream (free of\n        # weight H2D) and the decode on batch_decomp_stream, double-buffered so\n        # the two pipeline.  Only the common single-chunk async path is split;\n        # sync-meta / multi-chunk / VALIDATE keep the original single-stream\n        # path below (rare, and the split's slot bookkeeping assumes one chunk).\n        if (self.load_kv_stream is not None\n                and single_chunk and not sync_meta and not self._decode_validate):\n            return self._decompress_split_singlechunk(\n                layer_id, active, blob_stride, host_k, host_v, bid_arr,\n                bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n                M_b, K_b, block_numel, rsm, _exc_cap)\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for lo in range(0, active, cap):\n                hi = min(lo + cap, active)\n                if single_chunk:\n                    # Common case: every block's slot is < active <= cap, so the\n                    # whole set is one chunk — skip the >=lo/<hi mask + nonzero.\n                    orig_slots = slots_cpu.long()\n                    slots_chunk = slots_cpu                   # int32, lo == 0\n                    cbids_src = bids_cpu\n                else:\n                    sel = ((slots_cpu >= lo) & (slots_cpu < hi)).nonzero(\n                        as_tuple=True)[0]\n                    if sel.numel() == 0:\n                        continue\n                    orig_slots = slots_cpu[sel].long()\n                    slots_chunk = slots_cpu[sel]              # int32, subtract lo\n                    cbids_src = bids_cpu[sel]\n                n = orig_slots.numel()\n                if n == 0:\n                    continue\n\n                if sync_meta:\n                    # --- legacy synchronous path (TIERED_SERVE_KV_META_SYNC=1) ---\n                    # torch.stack(...).cuda() of pageable memory is SYNCHRONOUS\n                    # (~1 ms/graph CPU dispatch) but never reuses a buffer, so it\n                    # can't hit the torn-meta race.  Kept as a rollback.\n                    cs_cpu = (slots_chunk.to(torch.int32) if lo == 0\n                              else (slots_chunk - lo).to(torch.int32))\n                    vrk = host_k['valid_rows'][orig_slots]\n                    eck = host_k['exc_cnt'][orig_slots]\n                    vrv = host_v['valid_rows'][orig_slots]\n                    ecv = host_v['exc_cnt'][orig_slots]\n                    mvrk = int(vrk.max()); meck = int(eck.max()) if eck.numel() else 0\n                    mvrv = int(vrv.max()); mecv = int(ecv.max()) if ecv.numel() else 0\n                    _smax = int(cs_cpu.max()) if cs_cpu.numel() else -1\n                    ri = -1\n                else:\n                    # --- async ring path (default) ---\n                    # Gather each field into a CONTIGUOUS pinned prefix of one\n                    # ring slot, then issue ONE async H2D per group.  A [:k]\n                    # prefix of a pinned 1-D buffer is contiguous -> a valid async\n                    # transfer (unlike a [5,n] column-slice, which is\n                    # non-contiguous and raised cudaErrorInvalidValue before).\n                    ri = self._meta_ring_idx % self._meta_ring_n\n                    self._meta_ring_idx += 1\n                    pif = self._meta_ring_pi[ri]   # int32 [5*cap]\n                    puf = self._meta_ring_pu[ri]   # uint8 [2*cap]\n                    bif = self._meta_ring_b[ri]    # int64 [cap]\n                    # Gate reuse: block only if this slot's prior H2D is still\n                    # in flight (the lag that overwrote the single per-layer\n                    # buffer before).  With R slots this is ~never a real wait.\n                    self._wait_meta_ring_slot(ri)\n                    # cs = chunk-local slot (slot - lo); the rest are per-slot\n                    # gathers.  index_select writes straight into the pinned\n                    # prefix (no pageable intermediate).\n                    pif[0:n].copy_(slots_chunk)\n                    if lo:\n                        pif[0:n] -= lo\n                    torch.index_select(host_k['valid_rows'], 0, orig_slots,\n                                       out=pif[n:2 * n])\n                    torch.index_select(host_k['exc_cnt'], 0, orig_slots,\n                                       out=pif[2 * n:3 * n])\n                    torch.index_select(host_v['valid_rows'], 0, orig_slots,\n                                       out=pif[3 * n:4 * n])\n                    torch.index_select(host_v['exc_cnt'], 0, orig_slots,\n                                       out=pif[4 * n:5 * n])\n                    torch.index_select(host_k['is_raw'], 0, orig_slots,\n                                       out=puf[0:n])\n                    torch.index_select(host_v['is_raw'], 0, orig_slots,\n                                       out=puf[n:2 * n])\n                    if not (ids_cached and single_chunk):\n                        bif[0:n].copy_(cbids_src)\n                    # Kernel-grid bounds.  The per-block valid_rows/exc_cnt\n                    # device arrays bound each block's work IN-KERNEL, so the\n                    # grid only needs an upper bound — static caps replace\n                    # four per-layer pinned .max() reductions (forward-thread\n                    # CPU dispatch).  VALIDATE=1 restores the exact maxes\n                    # (tighter grids + corrupt-meta detection).\n                    if self._decode_validate:\n                        mvrk = int(pif[n:2 * n].max()); meck = int(pif[2 * n:3 * n].max())\n                        mvrv = int(pif[3 * n:4 * n].max()); mecv = int(pif[4 * n:5 * n].max())\n                    else:\n                        mvrk = mvrv = M_b\n                        meck = mecv = _exc_cap\n                    # Slot-range guard stays (one cheap reduction): a slot >=\n                    # staged rows is the one arg class the static caps can't\n                    # rule out and it would IMA the decode kernel.\n                    _smax = int(pif[0:n].max())\n\n                if self._tb:\n                    self._kv_h2d_begin[layer_id].record(\n                        self.batch_decomp_stream)\n                self._stage_blob_h2d(layer_id, lo, hi, host_k, host_v)\n                self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n                # Defensive bounds-check: serve's high block-free/reuse churn has\n                # produced decode args beyond the staged range (a slot >= the\n                # rows just copied, or a corrupt valid_rows / exc_cnt from a\n                # stale or torn pool slot) which makes BF16P4Flat_DecompressBatch\n                # read/write out of bounds -> CUDA IMA that takes down the\n                # engine.  Validate cheaply on the CPU args and SKIP + log this\n                # chunk's decode instead of crashing (the blob H2D + the worker's\n                # _kv_dec_h2d gate already ran, so this only drops the chunk's KV\n                # for the step).  The meta H2D below is skipped on a bad chunk, so\n                # the ring slot carries no in-flight read and needs no event.\n                _sn = hi - lo\n                if (_smax >= _sn or mvrk > M_b or mvrv > M_b\n                        or meck > _exc_cap or mecv > _exc_cap\n                        or _smax < 0):\n                    logger.error(\n                        \"[kv-decode] SKIP bad args L%d chunk[%d:%d] active=%d \"\n                        \"rows=%d slot_max=%d mvrk=%d mvrv=%d meck=%d mecv=%d \"\n                        \"(M_b=%d exc_cap=%d stride=%d fixed=%d) -- would CUDA-IMA\",\n                        layer_id, lo, hi, active, _sn, _smax, mvrk, mvrv,\n                        meck, mecv, M_b, _exc_cap, blob_stride,\n                        self._fixed_bytes)\n                    continue\n","exit_code":0,"duration":{"secs":0,"nanos":11968},"formatted_output":"        self._iota_i = None      # cached arange (int32) for staging slots\n        # Host-side blob assembly is a strided scatter that numpy runs single-\n        # threaded (~7 ms for 4096 blocks, dwarfing the 1.1 ms GPU compress).\n        # numpy releases the GIL during the copy, so a small thread pool\n        # parallelises it (~3.5x).  Lazy-created; only used above a block-count\n        # threshold where the dispatch cost is amortised.\n        self._asm_pool = None\n        self._asm_nthreads = min(16, max(1, (os.cpu_count() or 8)))\n        self._asm_thread_thresh = 256\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        \"\"\"Worst-case host-pool bytes for one K (or one V) block.\n\n        Mirrors the per-block ``blob`` row stride reserved by\n        ``warmup_kv_buffers`` plus the per-block meta (``total_size`` /\n        ``exc_cnt`` / ``is_raw``).  A P4Flat block is stored either\n        compressed or — on raw fallback — as a full BF16 block, so the slot\n        is always reserved at ``align(raw_bytes, 128)`` (i.e. ~1x raw).\n\n        Use this from external callers (e.g. vLLM budget calculation) to\n        size the persistent compressed host pool without instantiating a\n        compressor.\n\n        Returns the byte size for ONE side (K or V).  Multiply by 2 for K+V.\n        \"\"\"\n        raw_bytes = block_elements * 2          # BF16\n        blob = _align(raw_bytes, 128)           # blob row stride\n        meta = 4 + 4 + 1                         # total_size + exc_cnt + is_raw\n        return blob + meta\n\n    # ------------------------------------------------------------------\n    #  Warmup\n    # ------------------------------------------------------------------\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\n        block to read the exact buffer sizes the codec produces.\"\"\"\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\"cuda\")\n        pc = _p4f_ext.compress(probe)\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\n        cb = int(pc.codes.numel())\n        smb = int(pc.sign_mantissa.numel())\n        cdb = int(pc.subtile_codec.numel())\n        self._idx_dtype = pc.exc_indices.dtype\n        self._val_dtype = pc.exc_values.dtype\n        self._idx_es = pc.exc_indices.element_size()\n        self._val_es = pc.exc_values.element_size()\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\n        # sm); the decode struct must report the same so the kernel reads it\n        # back correctly.\n        self._row_major_sm = int(getattr(pc, \"row_major_sm\", 0))\n        del probe, pc\n        torch.cuda.empty_cache()\n        return hb, cb, smb, cdb\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_gpu_blocks\n\n        block_numel = 1\n        for s in block_shape:\n            block_numel *= s\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\n        # Token geometry for occupancy-aware band skipping.  block_shape is\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\n        self._hd = block_numel // self._block_size if self._block_size else 0\n\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\n        # the CPU variant overrides this with an analytic computation so\n        # warmup touches no GPU).\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\n\n        if smb != block_numel:\n            raise RuntimeError(\n                f\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \"\n                f\"({block_numel}); unexpected codec layout.\")\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\n            raise RuntimeError(\n                f\"P4Flat KV: fixed buffer sizes not 4-aligned \"\n                f\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \"\n                f\"misaligned.\")\n\n        fixed_bytes = hb + cb + smb + cdb\n        raw_bytes = block_numel * 2  # BF16\n        # The blob row must hold either the compressed payload or a raw block.\n        # A compressed payload is only kept when it is <= raw_bytes (else we\n        # fall back to raw), so the stored size never exceeds raw_bytes.\n        max_comp_size = _align(raw_bytes, 128)\n        # Dense packing: use a 25,600-byte row by default so the contiguous\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\n        # worst case.  A blob that does not fit the tight row is published as\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\n        # neither producer writes past the row.  Clamp the default/override to\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\n        # geometries remain valid.  An explicit value <= 0 selects the old\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\n        _stride_env = os.getenv(\"TIERED_SERVE_KV_BLOB_STRIDE\")\n        _slack = int(os.getenv(\"TIERED_SERVE_KV_BLOB_SLACK\", \"-1\"))\n        if _stride_env is not None:\n            _req = int(_stride_env)\n            blob_stride = (max_comp_size if _req <= 0\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\n        elif _slack >= 0:\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\n        else:\n            blob_stride = min(\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\n        logger.info(\n            \"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \"\n            \"stride_env=%s slack=%d pre_alloc_pools=%s)\",\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\n            pre_allocated_host_pools is not None)\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._raw_bytes = raw_bytes\n        self._M_b, self._K_b = M_b, K_b\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\n        self._fixed_bytes = fixed_bytes\n        self._max_comp_size = max_comp_size\n        self._blob_stride = blob_stride\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\n        # only).  Done here — outside any CUDA stream context — so the hot path\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\n        # codec buffer-type for a whole block-stack into these, then assembles\n        # the per-slot blob rows host-side.\n        if self._USES_GPU_COMPRESS:\n            self._cmp_stage = {\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\n        # contiguous runs with a vectorised padded diff.\n        seg = np.ones(n_rows, dtype=np.int16)\n        for h in free_set:\n            if lo <= h < hi:\n                seg[h - lo] = 0\n        d = np.diff(seg, prepend=0, append=0)\n        starts = np.flatnonzero(d == 1).tolist()\n        ends = np.flatnonzero(d == -1).tolist()\n        dst, src = [], []\n        for s, e in zip(starts, ends):\n            dst.append(gk[s:e]); src.append(bk[lo + s:lo + e])\n            dst.append(gv[s:e]); src.append(bv[lo + s:lo + e])\n        self._batch_h2d(dst, src)\n\n    def _batch_h2d(self, dst: list, src: list) -> None:\n        \"\"\"Submit a list of H2D copies as one driver call\n        (cudaMemcpyBatchAsync via zipserv_ext.batch_memcpy on the current —\n        i.e. batch_decomp — stream), falling back to ``_foreach_copy_``.\"\"\"\n        if not dst:\n            return\n        if len(dst) == 1:\n            dst[0].copy_(src[0], non_blocking=True)\n            return\n        _zs = self._batch_ext\n        if _zs is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as _zs\n            except Exception:\n                _zs = False\n            self._batch_ext = _zs\n        if _zs and hasattr(_zs, \"batch_memcpy\"):\n            _zs.batch_memcpy(dst, src,\n                             torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(dst, src, non_blocking=True)\n\n    def _wait_meta_ring_slot(self, ri: int) -> None:\n        \"\"\"Gate pinned meta-ring reuse without a host wait on the common path.\"\"\"\n        ev = self._meta_ring_ev[ri]\n        if not ev.query():\n            ev.synchronize()\n\n    def _decompress_batched(self, layer_id: int, block_ids: list,\n                            k_cache: torch.Tensor,\n                            v_cache: torch.Tensor) -> None:\n        \"\"\"Production fast path — deliberately SHORT.\n\n        Runs once per layer per step on the forward thread, where every\n        Python statement / torch dispatch is GPU-idle gap (the nsys\n        before_replay stall).  Handles the production shape only: single\n        chunk (hwm <= staging cap), async meta ring, static grid bounds,\n        dense-ish slots.  Everything else (multi-chunk, sync-meta rollback,\n        VALIDATE=1 full checks, time-breakdown events, hole-heavy staging)\n        falls back to ``_decompress_batched_general``.\n        \"\"\"\n        active = self._kv_active_count[layer_id]\n        free_set = self._kv_free_slots.get(layer_id)\n        if (active > self._dec_cap or self._meta_sync_fallback\n                or self._decode_validate or self._tb\n                or (free_set and len(free_set) >= self._decode_hole_threshold)):\n            return self._decompress_batched_general(\n                layer_id, block_ids, k_cache, v_cache)\n        if active == 0:\n            return\n\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        _cc = self._cbids_cache_np\n        hit = (_cc is not None and _cc.shape == bid_arr.shape\n               and np.array_equal(_cc, bid_arr))\n        bids = self._cbids_cache_t if hit else torch.from_numpy(bid_arr)\n        slots = slot_tbl[bids]\n        n = slots.numel()\n        if n == 0:\n            return\n\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        self._wait_meta_ring_slot(ri)                # gate ring-slot reuse\n        pif[0:n].copy_(slots)\n        torch.index_select(kvr, 0, slots, out=pif[n:2 * n])\n        torch.index_select(kec, 0, slots, out=pif[2 * n:3 * n])\n        torch.index_select(vvr, 0, slots, out=pif[3 * n:4 * n])\n        torch.index_select(vec, 0, slots, out=pif[4 * n:5 * n])\n        torch.index_select(kir, 0, slots, out=puf[0:n])\n        torch.index_select(vir, 0, slots, out=puf[n:2 * n])\n\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\n        rsm = self._row_major_sm\n        with torch.cuda.stream(self.batch_decomp_stream):\n            gi = pif[:5 * n].cuda(non_blocking=True)\n            gu = puf[:2 * n].cuda(non_blocking=True)\n            if hit:\n                cbids = self._cbids_cache_gpu\n            else:\n                bif = self._meta_ring_b[ri]\n                bif[0:n].copy_(bids)\n                cbids = bif[:n].cuda(non_blocking=True)\n                self._cbids_cache_np = bid_arr\n                self._cbids_cache_t = bids\n                self._cbids_cache_gpu = cbids\n            self._meta_ring_ev[ri].record(self.batch_decomp_stream)\n            self._gpu_dec_blob[:active].copy_(hkb[:active], non_blocking=True)\n            self._gpu_dec_blob_v[:active].copy_(hvb[:active],\n                                                non_blocking=True)\n            self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob, blob_stride, gi[0:n], cbids,\n                gi[n:2 * n], gi[2 * n:3 * n], gu[0:n], k_cache.reshape(-1),\n                block_numel, K_b, M_b, exc_cap, rsm)\n            self._invoke_decode_kernel(\n                self._gpu_dec_blob_v, blob_stride, gi[0:n], cbids,\n                gi[3 * n:4 * n], gi[4 * n:5 * n], gu[n:2 * n],\n                v_cache.reshape(-1), block_numel, K_b, M_b, exc_cap, rsm)\n\n    def _decompress_split_singlechunk(\n            self, layer_id, active, blob_stride, host_k, host_v, bid_arr,\n            bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n            M_b, K_b, block_numel, rsm, exc_cap):\n        \"\"\"Single-chunk KV decode with the compressed-blob H2D on\n        ``load_kv_stream`` and the decode kernels on ``batch_decomp_stream``.\n\n        A 2-slot blob ring double-buffers the staging blob so layer L+1's LOAD\n        (load_kv_stream) overlaps layer L's DECODE (batch_decomp_stream) — the\n        per-slot ``consumed`` event gates reuse so the two streams never race on\n        the blob.  ``load_kv_stream`` is gated by the graph wrapper on \"QKV\n        weights loaded\", so the H2D starts when the single copy engine is free\n        of weight H2D (otherwise the H2D queues behind weight and the\n        breakdown's KVLoad interval absorbs that wait).  Mirrors the common\n        async-ring single-chunk path of ``_decompress_batched_general``\n        (lo == 0, no per-block slot rebase).\"\"\"\n        n = active\n        if layer_id == 0:\n            self._splitcnt = getattr(self, \"_splitcnt\", 0) + 1\n            if self._splitcnt % 50 == 1:\n                logger.info(\n                    \"[KVStageDbg] L0 staging n=%d blocks (active_count) \"\n                    \"blob_stride=%d -> %.2f MB K+V this layer\",\n                    n, self._blob_stride, n * self._blob_stride * 2 / 1024**2)\n        ds = self.batch_decomp_stream\n        ls = self.load_kv_stream\n        slot = self._dec_blob_ring_idx & 1\n        self._dec_blob_ring_idx += 1\n        gk_blob = self._dec_blob_ring[slot]\n        gv_blob = self._dec_blob_v_ring[slot]\n\n        # ── CPU: gather per-block meta into one pinned ring slot ──\n        ri = self._meta_ring_idx % self._meta_ring_n\n        self._meta_ring_idx += 1\n        pif = self._meta_ring_pi[ri]\n        puf = self._meta_ring_pu[ri]\n        bif = self._meta_ring_b[ri]\n        self._wait_meta_ring_slot(ri)                # gate pinned reuse\n        orig_slots = slots_cpu.long()\n        pif[0:n].copy_(slots_cpu)                     # lo == 0 → no rebase\n        torch.index_select(host_k['valid_rows'], 0, orig_slots, out=pif[n:2 * n])\n        torch.index_select(host_k['exc_cnt'], 0, orig_slots, out=pif[2 * n:3 * n])\n        torch.index_select(host_v['valid_rows'], 0, orig_slots, out=pif[3 * n:4 * n])\n        torch.index_select(host_v['exc_cnt'], 0, orig_slots, out=pif[4 * n:5 * n])\n        torch.index_select(host_k['is_raw'], 0, orig_slots, out=puf[0:n])\n        torch.index_select(host_v['is_raw'], 0, orig_slots, out=puf[n:2 * n])\n        if not ids_cached:\n            bif[0:n].copy_(bids_cpu)\n        mvrk = mvrv = M_b\n        meck = mecv = exc_cap\n        _smax = int(pif[0:n].max())                   # slot-range guard (CPU)\n        if _smax >= n or _smax < 0:\n            logger.error(\n                \"[kv-decode] SKIP bad args L%d active=%d slot_max=%d \"\n                \"(M_b=%d exc_cap=%d) -- would CUDA-IMA\",\n                layer_id, active, _smax, M_b, exc_cap)\n            return\n\n        # ── LOAD: blob + meta H2D on load_kv_stream (copy engine free) ──\n        with torch.cuda.stream(ls):\n            if self._dec_blob_consumed is not None:\n                ls.wait_event(self._dec_blob_consumed[slot])   # gate slot reuse\n            if self._dec_blob_consumed is not None:\n                self._dec_blob_consumed[slot].record(ds)\n\n    def _decompress_batched_general(self, layer_id: int, block_ids: list,\n                                    k_cache: torch.Tensor,\n                                    v_cache: torch.Tensor) -> None:\n        M_b, K_b = self._M_b, self._K_b\n        block_numel = M_b * K_b\n        rsm = int(self._row_major_sm)\n        blob_stride = self._gpu_dec_blob.stride(0)          # bytes/row (uint8)\n        cap = self._gpu_dec_blob.shape[0] - 1               # staging rows\n        active = self._kv_active_count[layer_id]\n        host_k = self._host_pools[layer_id]['k']\n        host_v = self._host_pools[layer_id]['v']\n\n        # Slot (compressed-pool row) for each requested block.  Active blocks\n        # occupy slots [0, active); stage a CONTIGUOUS slot range per chunk in\n        # one big pinned H2D and the kernel reads each block from its slot.\n        # NOTE: one contiguous copy_ (single DMA) measured ~2x faster than a\n        # per-block cudaMemcpyBatchAsync gather of used-bytes — small per-block\n        # copies can't saturate the copy engine, and the 25% padding saved is\n        # dwarfed by that penalty (kv_h2d 64ms vs 118ms in E2E).\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        # Step-level block-id cache: all layers of a step decode the SAME\n        # filtered active set (only the per-layer slot tables differ), so the\n        # id vector's CPU tensor + device upload are built once and reused by\n        # the other ~n_layers-1 calls.  Content-keyed (memcmp, ~µs for ~6k\n        # ids) so a changed active set is just a miss, never staleness.\n        _cc = self._cbids_cache_np\n        ids_cached = (_cc is not None and _cc.shape == bid_arr.shape\n                      and np.array_equal(_cc, bid_arr))\n        bids_cpu = (self._cbids_cache_t if ids_cached\n                    else torch.from_numpy(bid_arr))\n        slots_cpu = self._kv_slot[layer_id][bids_cpu]\n        k_flat = k_cache.reshape(-1)\n        v_flat = v_cache.reshape(-1)\n\n        single_chunk = active <= cap\n        sync_meta = self._meta_sync_fallback\n        _exc_cap = (blob_stride - self._fixed_bytes) // 6\n\n        # KV-load stream split: the blob H2D goes on load_kv_stream (free of\n        # weight H2D) and the decode on batch_decomp_stream, double-buffered so\n        # the two pipeline.  Only the common single-chunk async path is split;\n        # sync-meta / multi-chunk / VALIDATE keep the original single-stream\n        # path below (rare, and the split's slot bookkeeping assumes one chunk).\n        if (self.load_kv_stream is not None\n                and single_chunk and not sync_meta and not self._decode_validate):\n            return self._decompress_split_singlechunk(\n                layer_id, active, blob_stride, host_k, host_v, bid_arr,\n                bids_cpu, slots_cpu, ids_cached, k_flat, v_flat,\n                M_b, K_b, block_numel, rsm, _exc_cap)\n\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for lo in range(0, active, cap):\n                hi = min(lo + cap, active)\n                if single_chunk:\n                    # Common case: every block's slot is < active <= cap, so the\n                    # whole set is one chunk — skip the >=lo/<hi mask + nonzero.\n                    orig_slots = slots_cpu.long()\n                    slots_chunk = slots_cpu                   # int32, lo == 0\n                    cbids_src = bids_cpu\n                else:\n                    sel = ((slots_cpu >= lo) & (slots_cpu < hi)).nonzero(\n                        as_tuple=True)[0]\n                    if sel.numel() == 0:\n                        continue\n                    orig_slots = slots_cpu[sel].long()\n                    slots_chunk = slots_cpu[sel]              # int32, subtract lo\n                    cbids_src = bids_cpu[sel]\n                n = orig_slots.numel()\n                if n == 0:\n                    continue\n\n                if sync_meta:\n                    # --- legacy synchronous path (TIERED_SERVE_KV_META_SYNC=1) ---\n                    # torch.stack(...).cuda() of pageable memory is SYNCHRONOUS\n                    # (~1 ms/graph CPU dispatch) but never reuses a buffer, so it\n                    # can't hit the torn-meta race.  Kept as a rollback.\n                    cs_cpu = (slots_chunk.to(torch.int32) if lo == 0\n                              else (slots_chunk - lo).to(torch.int32))\n                    vrk = host_k['valid_rows'][orig_slots]\n                    eck = host_k['exc_cnt'][orig_slots]\n                    vrv = host_v['valid_rows'][orig_slots]\n                    ecv = host_v['exc_cnt'][orig_slots]\n                    mvrk = int(vrk.max()); meck = int(eck.max()) if eck.numel() else 0\n                    mvrv = int(vrv.max()); mecv = int(ecv.max()) if ecv.numel() else 0\n                    _smax = int(cs_cpu.max()) if cs_cpu.numel() else -1\n                    ri = -1\n                else:\n                    # --- async ring path (default) ---\n                    # Gather each field into a CONTIGUOUS pinned prefix of one\n                    # ring slot, then issue ONE async H2D per group.  A [:k]\n                    # prefix of a pinned 1-D buffer is contiguous -> a valid async\n                    # transfer (unlike a [5,n] column-slice, which is\n                    # non-contiguous and raised cudaErrorInvalidValue before).\n                    ri = self._meta_ring_idx % self._meta_ring_n\n                    self._meta_ring_idx += 1\n                    pif = self._meta_ring_pi[ri]   # int32 [5*cap]\n                    puf = self._meta_ring_pu[ri]   # uint8 [2*cap]\n                    bif = self._meta_ring_b[ri]    # int64 [cap]\n                    # Gate reuse: block only if this slot's prior H2D is still\n                    # in flight (the lag that overwrote the single per-layer\n                    # buffer before).  With R slots this is ~never a real wait.\n                    self._wait_meta_ring_slot(ri)\n                    # cs = chunk-local slot (slot - lo); the rest are per-slot\n                    # gathers.  index_select writes straight into the pinned\n                    # prefix (no pageable intermediate).\n                    pif[0:n].copy_(slots_chunk)\n                    if lo:\n                        pif[0:n] -= lo\n                    torch.index_select(host_k['valid_rows'], 0, orig_slots,\n                                       out=pif[n:2 * n])\n                    torch.index_select(host_k['exc_cnt'], 0, orig_slots,\n                                       out=pif[2 * n:3 * n])\n                    torch.index_select(host_v['valid_rows'], 0, orig_slots,\n                                       out=pif[3 * n:4 * n])\n                    torch.index_select(host_v['exc_cnt'], 0, orig_slots,\n                                       out=pif[4 * n:5 * n])\n                    torch.index_select(host_k['is_raw'], 0, orig_slots,\n                                       out=puf[0:n])\n                    torch.index_select(host_v['is_raw'], 0, orig_slots,\n                                       out=puf[n:2 * n])\n                    if not (ids_cached and single_chunk):\n                        bif[0:n].copy_(cbids_src)\n                    # Kernel-grid bounds.  The per-block valid_rows/exc_cnt\n                    # device arrays bound each block's work IN-KERNEL, so the\n                    # grid only needs an upper bound — static caps replace\n                    # four per-layer pinned .max() reductions (forward-thread\n                    # CPU dispatch).  VALIDATE=1 restores the exact maxes\n                    # (tighter grids + corrupt-meta detection).\n                    if self._decode_validate:\n                        mvrk = int(pif[n:2 * n].max()); meck = int(pif[2 * n:3 * n].max())\n                        mvrv = int(pif[3 * n:4 * n].max()); mecv = int(pif[4 * n:5 * n].max())\n                    else:\n                        mvrk = mvrv = M_b\n                        meck = mecv = _exc_cap\n                    # Slot-range guard stays (one cheap reduction): a slot >=\n                    # staged rows is the one arg class the static caps can't\n                    # rule out and it would IMA the decode kernel.\n                    _smax = int(pif[0:n].max())\n\n                if self._tb:\n                    self._kv_h2d_begin[layer_id].record(\n                        self.batch_decomp_stream)\n                self._stage_blob_h2d(layer_id, lo, hi, host_k, host_v)\n                self._kv_dec_h2d[layer_id].record(self.batch_decomp_stream)\n\n                # Defensive bounds-check: serve's high block-free/reuse churn has\n                # produced decode args beyond the staged range (a slot >= the\n                # rows just copied, or a corrupt valid_rows / exc_cnt from a\n                # stale or torn pool slot) which makes BF16P4Flat_DecompressBatch\n                # read/write out of bounds -> CUDA IMA that takes down the\n                # engine.  Validate cheaply on the CPU args and SKIP + log this\n                # chunk's decode instead of crashing (the blob H2D + the worker's\n                # _kv_dec_h2d gate already ran, so this only drops the chunk's KV\n                # for the step).  The meta H2D below is skipped on a bad chunk, so\n                # the ring slot carries no in-flight read and needs no event.\n                _sn = hi - lo\n                if (_smax >= _sn or mvrk > M_b or mvrv > M_b\n                        or meck > _exc_cap or mecv > _exc_cap\n       