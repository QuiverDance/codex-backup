;\\n\\nstruct CompressedChunkDelta3 {\\n    torch::Tensor codes;\\n    torch::Tensor sign_mantissa;\\n    torch::Tensor thread_bases;\\n    torch::Tensor tile_exception_offsets;\\n    torch::Tensor warp_prefixes;\\n    torch::Tensor entries17;\\n    int64_t M = 0;\\n    int64_t K = 0;\\n    int64_t num_exceptions = 0;\\n\\n    int64_t nbytes() const\\n    {\\n        return tensor_bytes(codes)\\n            + tensor_bytes(sign_mantissa)\\n            + tensor_bytes(thread_bases)\\n            + tensor_bytes(tile_exception_offsets)\\n            + tensor_bytes(warp_prefixes)\\n            + tensor_bytes(entries17);\\n    }\\n\\n    int64_t frozen_hbm_bytes() const\\n    {\\n        return tensor_bytes(sign_mantissa)\\n            + tensor_bytes(tile_exception_offsets)\\n            + tensor_bytes(warp_prefixes);\\n    }\\n\\n    int64_t frozen_transfer_bytes() const\\n    {\\n        return tensor_bytes(codes)\\n            + tensor_bytes(thread_bases)\\n            + tensor_bytes(entries17);\\n    }\\n};\\n\\nCompressedTilePalette3 compress_tile_palette3(torch::Tensor source)\\n{\\n    check_source(source);\\n    const c10::cuda::CUDAGuard device_guard(source.device());\\n    const int64_t rows = source.size(0);\\n    const int64_t columns = source.size(1);\\n    const int64_t num_tiles =\\n        (rows / kTileDim) * (columns / kTileDim);\\n    const auto byte_options = source.options().dtype(at::kByte);\\n\\\"\\\"\\\"Lossless BF16 ChunkDelta3 compressor.\\n\\nChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\\n16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\\nencodes exponent deltas in three bits.  Values outside the local 3-bit range\\nare restored from a packed 17-bit exception stream, making the codec bit exact.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport logging\\nfrom typing import Dict, Optional\\n\\nimport torch\\n\\nfrom tiered_serve.compressor_base import TensorCompressor\\n\\n\\n