kv_pipeline_chunk_blocks > 0\n                and filtered.size >= self._kv_pipeline_min_blocks):\n            self._decompress_blocks_pipelined(\n                layer_id, filtered, k_cache, v_cache)\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _restore_secondary_fallbacks(\n            self, layer_id: int, candidates: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\n        \"\"\"Restore exception-overflow rows from authoritative raw KV.\n\n        The host encoder retains the true exception count while safely\n        truncating Packed20 writes at the fixed row capacity.  If either side\n        of a K/V pair overflowed, restore both sides from ``secondary_kv`` and\n        remove that block from the CD3 launch.  Normal rows pay no per-step\n        metadata scan until a layer has observed an overflow.\n        \"\"\"\n        if (not self._secondary_fallback_possible.get(layer_id, False)\n                or candidates.size == 0):\n            return candidates\n\n        slots = self._kv_slot_np[layer_id][candidates]\n        slot_ok = slots >= 0\n        if not bool(slot_ok.any()):\n            return candidates\n        probe_positions = np.flatnonzero(slot_ok)\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        overflow = (\n            pools[\"k\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        overflow |= (\n            pools[\"v\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        if not bool(overflow.any()):\n            return candidates\n\n        fallback_positions = probe_positions[overflow]\n        fallback_ids = np.ascontiguousarray(\n            candidates[fallback_positions], dtype=np.int64)\n        self._decode_raw_from_secondary(\n            layer_id, fallback_ids, k_cache, v_cache)\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[fallback_positions] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(\n            self, layer_id: int, block_ids: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n        if layer_id >= len(DualMemoryLoader.kv_caches):\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no DualMemoryLoader cache\")\n        secondary = getattr(\n            DualMemoryLoader.kv_caches[layer_id], \"secondary_kv\", None)\n        if secondary is None:\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no secondary_kv\")\n\n        host_ids = torch.from_numpy(block_ids)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            device_ids = host_ids.to(k_cache.device, non_blocking=True)\n            k_cache.index_copy_(\n                0, device_ids,\n                secondary[0][host_ids].to(\n                    k_cache.device, non_blocking=True))\n            v_cache.index_copy_(\n                0, device_ids,\n                secondary[1][host_ids].to(\n                    v_cache.device, non_blocking=True))\n\n    def _build_decode_plan(self, layer_id: int,\n                           block_ids: np.ndarray,\n                           k_cache: torch.Tensor) -> Dict[str, Any]:\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        slot_table = self._kv_slot