])\n            else:\n                for ring_index, gpu_pool in enumerate(\n                        self._gpu_decomp_pool_ring):\n                    copy_destinations_ring[ring_index].append(\n                        gpu_pool[kv][\"blob\"][:hwm])\n                copy_sources.append(host_blob[:hwm])\n        storage_rows = n if packed_h2d else hwm\n        return {\n            \"block_ids\": block_ids,\n            \"generation\": self._decode_generation.get(layer_id, 0),\n            \"slots_gpu\": slots_gpu,\n            \"block_ids_gpu\": block_ids_gpu,\n            \"copy_destinations_ring\": copy_destinations_ring,\n            \"copy_sources\": copy_sources,\n            \"storage_rows\": storage_rows,\n        }\n\n    def _launch_decode(self, gpu_pool, plan, k_cache, v_cache) -> None:\n        storage_rows = plan[\"storage_rows\"]\n        _cd3_ext.decompress_chunk_delta3_batched_blob_pair_stream(\n            gpu_pool[\"k\"][\"blob\"][:storage_rows],\n            gpu_pool[\"v\"][\"blob\"][:storage_rows],\n            plan[\"slots_gpu\"],\n            plan[\"block_ids_gpu\"],\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\n            self._packed_capacity,\n            self.batch_decomp_stream.cuda_stream,\n        )\n\n    def _submit_split_plan(\n            self, layer_id: int, plan: Dict[str, Any],\n            k_cache: torch.Tensor, v_cache: torch.Tensor,\n            first_chunk: bool) -> None:\n        ring_slot = self._dec_blob_ring_idx & 1\n        self._dec_blob_ring_idx += 1\n        gpu_pool = self._gpu_decomp_pool_ring[ring_slot]\n        h2d_stream = self.load_kv_stream\n        h2d_stream.wait_event(self._dec_blob_consumed[ring_slot])\n        if self._tb and first_chunk:\n            self._kv_h2d_begin[layer_id].record(h2d_stream)\n        self._batch_h2d(\n            plan[\"copy_destinations_ring\"][ring_slot],\n            plan[\"copy_sources\"], h2d_stream)\n        self._kv_dec_h2d[layer_id].record(h2d_stream)\n\n        self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\n        if self._tb and first_chunk:\n            self._kv_decode_begin[layer_id].record(\n                self.batch_decomp_stream)\n        self._launch_decode(gpu_pool, plan, k_cache, v_cache)\n        self._dec_blob_consumed[ring_slot].record(\n            self.batch_decomp_stream)\n\n    def _decompress_blocks_pipelined(\n            self, layer_id: int, block_ids: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\n        \"\"\"Overlap each blob chunk's decode with the next chunk's H2D.\"\"\"\n        generation = self._decode_generation.get(layer_id, 0)\n        chunk_blocks = min(\n            self._kv_pipeline_chunk_blocks,\n            self._max_gpu_decomp_blocks)\n        cached = self._pipeline_decode_plans.get(layer_id)\n        if (cached is None or cached[\"block_ids\"] is not block_ids\n                or cached[\"generation\"] != generation\n                or cached[\"chunk_blocks\"] != chunk_blocks):\n            plans = []\n            chunks = []\n            with torch.cuda.stream(self.batch_decomp_stream):\n                for start in range(0, len(block_ids), chunk_blocks):\n                    chunk = block_ids[start:start + chunk_blocks]\n                    chunks.append(chunk)\n                    plans.append(self._build_decode_plan(\n                        layer_id, chunk, k_cache))\n            cached = {\n                \"block_ids\": block_ids,\n                \"generation\": generation,\n                \"chunk_blocks\": chunk_blocks,\n                # Hold the NumPy views that identify each plan's metadata.\n                \"chunks\": chunks,\n                \"plans\": plans,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06186-6325-79b3-9454-03c11387a0a9","create_time":1788343059.4435976}}}
