d + 1; else hi = mid; }\n        const int e0 = lo; hi = num_exc;\n        while (lo < hi) { int mid = (lo + hi) >> 1;\n            if (static_cast<int64_t>(static_cast<unsigned>(exc_idx[mid])) < khi) lo = mid + 1; else hi = mid; }\n        const int e1 = lo;\n        if (e1 > e0) {\n            auto cC = make_identity_tensor(make_shape(Int<kTileM>{}, Int<TileN>{}));\n            auto tCcC = thr_mma.partition_C(cC);\n            for (int e = e0; e < e1; ++e) {\n                const int64_t gidx = static_cast<unsigned>(exc_idx[e]);\n                const int m = static_cast<int>(gidx / K), k = static_cast<int>(gidx % K);\n                const int lm = m - r0;\n                // clean (code-0) decode of W at (m,k) from GMEM, tile-blocked.\n                const int64_t ti = static_cast<int64_t>(m >> 6) * tiles_k + (k >> 6);\n                const int row = m & 63, col = k & 63, bk = col >> 4, kb = col & 15;\n                const uint8_t cby = codes_g[ti * 2048 + bk * 512 + row * 8 + (kb >> 1)];\n                const uint8_t code = (kb & 1) ? (cby >> 4) : (cby & 0xF);\n                const uint8_t smv = sm_g[ti * 4096 + bk * 1024 + row * 16 + kb];\n                const uint8_t mk = codec_g[ti * 16 + (row >> 4) * 4 + (col >> 4)];\n                const uint8_t exp = (mk != 0xFFu) ? static_cast<uint8_t>(mk + code)\n                                                  : headers_g[ti * 16 + code];\n                const uint16_t ab = static_cast<uint16_t>(\n                    (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                    (static_cast<uint16_t>(exp) << 7) | static_cast<uint16_t>(smv & 0x7Fu));\n                const float delta = __bfloat162float(__ushort_as_bfloat16(exc_val[e]))\n                                  - __bfloat162float(__ushort_as_bfloat16(ab));\n                CUTE_UNROLL\n                for (int i = 0; i < size(tCrC); ++i) {\n                    auto cc = tCcC(i);\n                    if (get<0>(cc) == lm) {\n                        const int nn = tile_n * TileN + get<1>(cc);  // global n\n                        tCrC(i) += delta * __bfloat162float(B_g[static_cast<int64_t>(nn) * K + k]);\n                    }\n                }\n            }\n        }\n    }\n\n    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchP4RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* headers, const uint8_t* codec,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    const int* exc_idx, const uint16_t* exc_val, int num_exc,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    // In-epilogue exception correction is over the full K range, so split-K is\n    // only valid when exceptions are NOT corrected in-kernel (exc==null path).\n    if (num_exc > 0 || exc_idx != nullptr) split_k = 1;\n    if (split_k < 1 || (K >> 6) % split_k != 0 || (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = P4RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = p4_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, headers, codec, B, C, Cf32, exc_idx, exc_val, num_exc,\n        M, N, K, split_k);\n    cudaError_t err = cudaGetLastError();\n    if (err != cudaSuccess || split_k <= 1) return err;\n    const int64_t MN = static_cast<int64_t>(M) * N;\n    const int t = 256;\n    const int64_t blk = (MN + t - 1) / t;\n    splitk_reduce_kernel<<<static_cast<unsigned>(blk), t, 0, stream>>>(\n        Cf32, C, MN, split_k);\n    return cudaGetLastError();\n}\n\nextern \"C\" cudaError_t p4_rs_wgmma_launch(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* headers, const uint8_t* codec,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    const int* exc_idx, const uint16_t* exc_val, int num_exc,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<256, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<192, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<128, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<64, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        return err;\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// ChunkDelta3 RS-mode fused decode + GEMM.\n//\n// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n// The matching base exponent is one byte per logical thread and sign/mantissa\n","exit_code":0,"duration":{"secs":0,"nanos":3008},"formatted_output":"    #   batch 128: O/GU/Down fused, QKV decomp = 189.65ms (all-fused incl QKV\n    #     192.30 -> QKV's RS kernel is too slow even with contention; decomp\n    #     O/Down per isolated-optimal = 194.20 -> WORSE, contention dominates).\n    #   batch 256: GU/Down fused (256) = 321.67 vs GU/Down decomp (192) = 331.11\n    #     -> fusing wins by 9.4ms even at N=256 (isolated bench says decomp here,\n    #     but the engine HBM-write contention flips it).\n    # That measurement supported fusing O/GateUp/Down broadly, but keep the\n    # live table scoped to the batch-128 serving range we are validating now;\n    # N>256 (prefill) decompresses anyway via fallback.\n    # The isolated+H2D benchmark below crossed over to decompress+cuBLAS earlier\n    # for O/Down, but the batch-128 serving trace regressed in exactly that\n    # region: dense materialization pushes the frozen-weight scheduling gap into\n    # every decode graph.  Keep QKV conservative, but restore O/Down to the\n    # in-engine batch-128 fused range.\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused WINS or is a noise-level TIE (<=2%) vs decmp\n        # under H2D -- a tie favours fused anyway (no dense-weight HBM write).\n        #\n        # QKV fuses (=64) like the rest.  The fused path is the RS kernel (approx) + a\n        # SEPARATE p4_exc_correct kernel (one block per out-of-palette exception);\n        # decompress pays no exception cost, so a HIGH-exception layer can flip\n        # fused below decomp.  But a PER-LAYER, real-weight sweep (all 80 Llama-70B\n        # layers @ N=64, H2D) showed fused WINS 78/80 QKV layers (~1.13x); only the\n        # 2 extreme early layers lose (layer0 314k exc -> 0.44x, layer1 39k ->\n        # 0.96x).  O 77/80 (3 are noise-level ~1.0x), GateUp 80/80 (even layer0\n        # 113k exc wins 1.31x -- its 940MB avoided write swamps exceptions), Down\n        # 80/80.  We accept the 1-2 extreme-outlier layers (e.g. QKV layer0)\n        # being slower rather than gate per layer -- aggregate TPOT cost ~0.1%.\n        # (Earlier QKV=0 was a layer-0 sampling artifact: the isolated bench's\n        # real-weight loader only ever sees layer 0, the 314k outlier.  Most QKV\n        # layers have ~1.6k exceptions and fuse-win.)\n        # best-N re-derived by an 8-step N sweep on a representative (median-exc)\n        # real layer (layer 40, N=8..256, H2D).  Cliff is structural: at N>64 the\n        # small-M shapes (QKV/O/Down) remap to the slow Npad=192 WGMMA tile\n        # (_pad_n), so they lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n                Bpb[:N].copy_(x2)\n                Bp = Bpb\n            # Cbuf[n, m] = sum_k W[m,k]*x[n,k] = F.linear(x, W)[n, m].\n            # Split-K fills the GPU at decode N (see ublb _u4_split_k); the\n            # production p4 path passes no in-kernel exceptions so split-K is safe.\n            sk = _u4_split_k(M, Npad, K)\n            # Split-K fp32 partials: pool like Cbuf/Bpb (keyed by sk too) instead\n            # of torch.empty every call -- the kernel overwrites all sk*Npad*M\n            # partials before the in-launch reduce, so reuse is safe, and at\n            # decode-N this churned the caching allocator (size scales with M, so\n            # QKV/GateUp were worst).\n            if sk > 1:\n                ckey = (\"cf32\", sk, Npad, M, x2.device.index)\n                cf32 = sc.get(ckey)\n                if cf32 is None:\n                    cf32 = torch.empty(sk, Npad, M, dtype=torch.float32, device=x2.device)\n                    sc[ckey] = cf32\n            else:\n                cf32 = _empty_f32(x2.device)\n            ext.p4_rs_wgmma_mm(codes, sm, headers, codec, Bp, Cbuf, cf32, sk, M, Npad, K)\n            if n_exc > 0:\n                # Sum exception corrections in an fp32 scratch and fold into the\n                # bf16 output with a SINGLE rounding -- accumulating directly in\n                # bf16 is non-associative and raced to out-of-tolerance error on\n                # collision-heavy shapes (many exceptions per output row).\n                ycorr = torch.zeros(M, Npad, dtype=torch.float32, device=x2.device)\n        if old is not None:\n            os.environ[\"TORCH_CUDA_ARCH_LIST\"] = old\n        else:\n            os.environ.pop(\"TORCH_CUDA_ARCH_LIST\", None)\n    return _RS_EXT\n\n\n_EMPTY_F32 = {}\n\n\ndef _empty_f32(device):\n    t = _EMPTY_F32.get(device)\n    if t is None:\n        t = torch.empty(0, dtype=torch.float32, device=device)\n        _EMPTY_F32[device] = t\n    return t\n\n\ndef _pad_n(N, M=0):\n    \"\"\"Pad N to a WGMMA N-tile, M-awarely avoiding the slow 64x128 tile: it holds\n    2 blocks/SM but a single warpgroup each, so for SMALL M (few M-tiles, can't\n    fill the device) the wider 64x192 tile wins despite more work.  Used by the\n    p4flat RS fused linear_apply.\"\"\"\n    base = ((N + 63) // 64) * 64\n    if base == 128 and (M >> 6) < 256:\n        return 192\n    return base\n\n\ndef _u4_split_k(M, Npad, K):\n    \"\"\"Pick split-K so the u4_rs grid (M/64 x Npad/tileN) fills the GPU at decode\n    N.  split_k must divide tiles_k (=K/64).  Split-K helps only in the\n    latency-bound decode regime (small N): at larger N the per-block WGMMA work\n    already keeps the SMs busy, so the extra blocks + reduction regress\n    (measured: down/o N>=256 ~0.9x).  Cap split_k by N accordingly.\"\"\"\n    tn = (256 if Npad % 256 == 0 else 192 if Npad % 192 == 0\n          else 128 if Npad % 128 == 0 else 64)\n    tiles_k = K // 64\n    base = (M // 64) * (Npad // tn)\n    # Only split at the smallest decode tile (Npad==64): there the grid is most\n    # undersubscribed and split-K wins big (~1.2-1.25x).  At Npad>=128 the\n    # per-block work already fills the SMs, so splitting regresses (measured:\n    # p4 down N=96/128 flipped fused->decmm); leave those unsplit.\n    max_sk = 4 if Npad <= 64 else 1   # sk=2 @Npad128 measured no gain (enough work/block)\n    sk = 1\n    while sk < max_sk and base * sk * 2 <= 768 and tiles_k % (sk * 2) == 0:\n        sk *= 2\n    return sk\n\n\nclass CompressedUBLBTBETensor:\n    \"\"\"Compressed BF16 tensor: triple-bitmap upper byte + raw lower byte.\"\"\"\n\n    def __init__(self, buffers: Dict[str, Any]):\n        self.bm1: torch.Tensor = buffers[\"bm1\"]          # [num_tiles] uint64\n        self.bm2: torch.Tensor = buffers[\"bm2\"]\n        self.bm3: torch.Tensor = buffers[\"bm3\"]\n        self.lb_raw: torch.Tensor = buffers[\"lb_raw\"]    # [n] uint8\n        self.fallback: torch.Tensor = buffers[\"fallback\"]  # [n_oob] uint8\n        self.palette: torch.Tensor = buffers[\"palette\"]  # [8] uint8\n        # two-level fallback offset: superblock base (int32) + per-tile rel (int16)\n        self.oob_base: torch.Tensor = buffers[\"oob_base\"]   # [ceil(num_tiles/256)] int32\n        self.oob_rel: torch.Tensor = buffers[\"oob_rel\"]     # [num_tiles] int16\n        self.M: int = int(buffers[\"M\"])\n        self.K: int = int(buffers[\"K\"])\n        self.output_tensor: Optional[torch.Tensor] = None\n    const uint8_t*       __restrict__ sm_g,       // [num_tiles*4096]\n    const uint8_t*       __restrict__ headers_g,  // [num_tiles*16] palettes\n    const uint8_t*       __restrict__ codec_g,    // [num_tiles*16] subtile markers\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    float*               __restrict__ Cf32_g,   // split-K partials [split_k,M,N]\n    const int*           __restrict__ exc_idx,    // sorted by m*K+k, or nullptr\n    const uint16_t*      __restrict__ exc_val,    // exact bf16 for each exception\n    int num_exc,\n    int M, int N, int K, int split_k)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = P4RSSmem<TileN, Stages>;\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\n\n    const int tid     = static_cast<int>(threadIdx.x);\n    const int tile_n  = static_cast<int>(blockIdx.x);\n    const int tile_m  = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n    const int split_idx = static_cast<int>(blockIdx.z);   // split-K (see u4_rs)\n    const int tk_split  = tiles_k / split_k;\n    const int k0        = split_idx * tk_split;\n\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\n                         make_coord(tile_n, _));\n    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\n    auto tiled_copy = make_tiled_copy(G2S{},\n        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\n    auto thr_copy = tiled_copy.get_slice(tid);\n    auto tBgB = thr_copy.partition_S(gB);\n    auto tBsB = thr_copy.partition_D(sB);\n\n    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\n                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                              make_coord(tile_m, tile_n));\n    auto tiled_mma = make_tiled_mma(MmaOp{});\n    auto thr_mma   = tiled_mma.get_thread_slice(tid);\n    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\n    clear(tCrC);\n    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\n\n    using SmemLayoutA = decltype(tile_to_shape(\n        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\n        make_shape(Int<kTileM>{}, Int<kTileK>{})));\n    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\n                                SmemLayoutA{});\n    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\n    auto cA   = make_identity_tensor(make_shape(Int<kTileM>{}, Int<kTileK>{}));\n    auto tCcA = thr_mma.partition_A(cA);\n\n    auto decode_regA = [&](int st) {\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrA); ++i) {\n            auto c = tCcA(i);\n            const int m = get<0>(c), k = get<1>(c);\n            const int bk = k >> 4, kb = k & 15;\n            const uint8_t cbyte = smem.s_codes[st][bk * 512 + m * 8 + (kb >> 1)];\n            const uint8_t code  = (kb & 1) ? (cbyte >> 4) : (cbyte & 0xF);\n            const uint8_t smv   = smem.s_sm[st][bk * 1024 + m * 16 + kb];\n            const uint8_t mk    = smem.s_marker[st][(m >> 4) * 4 + (k >> 4)];\n            const uint8_t exp   = (mk != 0xFFu)\n                ? static_cast<uint8_t>(mk + code) : smem.s_pal[st][code];\n            const uint16_t bits = static_cast<uint16_t>(\n                (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                (static_cast<uint16_t>(exp) << 7) |\n                static_cast<uint16_t>(smv & 0x7Fu));\n            const __nv_bfloat16 v = __ushort_as_bfloat16(bits);\n            tCrA(i) = reinterpret_cast<const bfloat16_t&>(v);\n        }\n    };\n\n    auto load_b = [&](int k_tile, int pipe) {\n        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\n    };\n\n    // p4flat tile data is contiguous per tile (tile-blocked) -> simple copies.\n    auto load_compressed = [&](int k_tile, int st) {\n        const int tile_idx = tile_m * tiles_k + k_tile;\n        const int64_t cbase = static_cast<int64_t>(tile_idx) * 2048;\n        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\n        cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\n        #pragma unroll\n        for (int j = 0; j < 2; ++j) {\n            const int c = tid + j * 128;\n            cp_async_16(&smem.s_sm[st][c << 4], sm_g + sbase + (c << 4));\n        }\n        if (tid == 0) cp_async_16(&smem.s_pal[st][0], headers_g + tile_idx * 16);\n        if (tid == 1) cp_async_16(&smem.s_marker[st][0], codec_g + tile_idx * 16);\n    };\n\n    CUTE_UNROLL\n    for (int s = 0; s < Stages - 1; ++s) {\n        if (s < tk_split) { load_b(k0 + s, s); load_compressed(k0 + s, s); }\n        cp_async_fence();\n    }\n\n    for (int kk = 0; kk < tk_split; ++kk) {\n        cp_async_wait<Stages - 2>();\n        __syncthreads();\n\n        decode_regA(kk % Stages);\n        warpgroup_fence_operand(tCrA);\n        warpgroup_arrive();\n        gemm(tiled_mma, tCrA, tCrB(_, _, _, kk % Stages), tCrC);\n        warpgroup_commit_batch();\n\n        const int knext = kk + Stages - 1;\n        if (knext < tk_split) { load_b(k0 + knext, knext % Stages);\n                                load_compressed(k0 + knext, knext % Stages); }\n        cp_async_fence();\n\n        warpgroup_wait<0>();\n        __syncthreads();\n    }\n\n    // ── Fused exact exception correction (no separate kernel, no atomics) ──\n    // Only runs for the (production-unused) exc!=null path; split_k is forced to\n    // 1 there, so the row-range correction over the full K stays correct.\n    // Each block owns output rows [r0, r0+64); add the exact delta for the\n    // out-of-palette exceptions in that row range directly into the f32\n    // accumulator before the bf16 write. exc_idx is sorted by m*K+k, so this\n    // block's exceptions form a contiguous range found by two binary searches.\n    if (num_exc > 0 && exc_idx != nullptr) {\n        const int r0 = tile_m * 64;\n        const int64_t klo = static_cast<int64_t>(r0) * K;\n        const int64_t khi = static_cast<int64_t>(r0 + 64) * K;\n        int lo = 0, hi = num_exc;\n        while (lo < hi) { int mid = (lo + hi) >> 1;\n            if (static_cast<int64_t>(static_cast<unsigned>(exc_idx[mid])) < klo) lo = mid + 1; else hi = mid; }\n        const int e0 = lo; hi = num_exc;\n        while (lo < hi) { int mid = (lo + hi) >> 1;\n            if (static_cast<int64_t>(static_cast<unsigned>(exc_idx[mid])) < khi) lo = mid + 1; else hi = mid; }\n        const int e1 = lo;\n        if (e1 > e0) {\n            auto cC = make_identity_tensor(make_shape(Int<kTileM>{}, Int<TileN>{}));\n            auto tCcC = thr_mma.partition_C(cC);\n            for (int e = e0; e < e1; ++e) {\n                const int64_t gidx = static_cast<unsigned>(exc_idx[e]);\n                const int m = static_cast<int>(gidx / K), k = static_cast<int>(gidx % K);\n                const int lm = m - r0;\n                // clean (code-0) decode of W at (m,k) from GMEM, tile-blocked.\n                const int64_t ti = static_cast<int64_t>(m >> 6) * tiles_k + (k >> 6);\n                const int row = m & 63, col = k & 63, bk = col >> 4, kb = col & 15;\n                const uint8_t cby = codes_g[ti * 2048 + bk * 512 + row * 8 + (kb >> 1)];\n                const uint8_t code = (kb & 1) ? (cby >> 4) : (cby & 0xF);\n                const uint8_t smv = sm_g[ti * 4096 + bk * 1024 + row * 16 + kb];\n                const uint8_t mk = codec_g[ti * 16 + (row >> 4) * 4 + (col >> 4)];\n                const uint8_t exp = (mk != 0xFFu) ? static_cast<uint8_t>(mk + code)\n                                                  : headers_g[ti * 16 + code];\n                const uint16_t ab = static_cast<uint16_t>(\n                    (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                    (static_cast<uint16_t>(exp) << 7) | static_cast<uint16_t>(smv & 0x7Fu));\n                const float delta = __bfloat162float(__ushort_as_bfloat16(exc_val[e]))\n                                  - __bfloat162float(__ushort_as_bfloat16(ab));\n                CUTE_UNROLL\n                for (int i = 0; i < size(tCrC); ++i) {\n                    auto cc = tCcC(i);\n                    if (get<0>(cc) == lm) {\n                        const int nn = tile_n * TileN + get<1>(cc);  // global n\n                        tCrC(i) += delta * __bfloat162float(B_g[static_cast<int64_t>(nn) * K + k]);\n                    }\n                }\n            }\n        }\n    }\n\n    if (split_k <= 1) {\n        auto tCgC = thr_mma.partition_C(gC_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgC(i) = static_cast<bfloat16_t>(tCrC(i));\n    } else {\n        auto gCf = make_tensor(\n            make_gmem_ptr(Cf32_g + static_cast<int64_t>(split_idx) * M * N),\n            make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\n        auto gCf_tile = local_tile(gCf, make_shape(Int<kTileM>{}, Int<TileN>{}),\n                                   make_coord(tile_m, tile_n));\n        auto tCgCf = thr_mma.partition_C(gCf_tile);\n        CUTE_UNROLL\n        for (int i = 0; i < size(tCrC); ++i)\n            tCgCf(i) = tCrC(i);\n    }\n#endif\n}\n\ntemplate <int TileN, class MmaOp, int Stages>\nstatic cudaError_t LaunchP4RS(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* headers, const uint8_t* codec,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    const int* exc_idx, const uint16_t* exc_val, int num_exc,\n    int M, int N, int K)\n{\n    if ((M & 63) || (N % TileN) || (K & 63)) return cudaErrorNotSupported;\n    // In-epilogue exception correction is over the full K range, so split-K is\n    // only valid when exceptions are NOT corrected in-kernel (exc==null path).\n    if (num_exc > 0 || exc_idx != nullptr) split_k = 1;\n    if (split_k < 1 || (K >> 6) % split_k != 0 || (split_k > 1 && Cf32 == nullptr))\n        split_k = 1;\n    using Smem = P4RSSmem<TileN, Stages>;\n    const int smem_bytes = static_cast<int>(sizeof(Smem));\n    dim3 grid(N / TileN, M / 64, split_k);\n    auto kernel = p4_rs_kernel<TileN, MmaOp, Stages>;\n    static int cfg = -1;\n    if (cfg != smem_bytes) {\n        cudaError_t e = cudaFuncSetAttribute(\n            kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem_bytes);\n        if (e != cudaSuccess) return e;\n        (void)cudaFuncSetAttribute(kernel,\n            cudaFuncAttributePreferredSharedMemoryCarveout,\n            cudaSharedmemCarveoutMaxShared);\n        cfg = smem_bytes;\n    }\n    kernel<<<grid, dim3(128), smem_bytes, stream>>>(\n        codes, sm, headers, codec, B, C, Cf32, exc_idx, exc_val, num_exc,\n        M, N, K, split_k);\n    cudaError_t err = cudaGetLastError();\n    if (err != cudaSuccess || split_k <= 1) return err;\n    const int64_t MN = static_cast<int64_t>(M) * N;\n    const int t = 256;\n    const int64_t blk = (MN + t - 1) / t;\n    splitk_reduce_kernel<<<static_cast<unsigned>(blk), t, 0, stream>>>(\n        Cf32, C, MN, split_k);\n    return cudaGetLastError();\n}\n\nextern \"C\" cudaError_t p4_rs_wgmma_launch(\n    cudaStream_t stream, const uint8_t* codes, const uint8_t* sm,\n    const uint8_t* headers, const uint8_t* codec,\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    const int* exc_idx, const uint16_t* exc_val, int num_exc,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 63)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<256, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<192, MMA, 4>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = SM90_64x128x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<128, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    {\n        using MMA = SM90_64x64x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchP4RS<64, MMA, 3>(stream, codes, sm, headers, codec, B, C, Cf32, split_k, exc_idx, exc_val, num_exc, M, N, K);\n        return err;\n    }\n#else\n    return cudaErrorNotSupported;\n#endif\n}\n\n// ============================================================================\n// ChunkDelta3 RS-mode fused decode + GEMM.\n//\n// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n// The matching base exponent is one byte per logical thread and sign/mantissa\n"},"started_at_ms":1788165404011,"completed_at_ms":1788165404011}}
{"timestamp":"2026-08-31T08:36:44.016Z","ordinal":4198,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a056f6-b570-7000-8422-824132785115","call_id":"call_uXECzrwne1GMa3YVBkQU4oQz","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    #   batch 128: O/GU/Down fused, QKV decomp = 189.65ms (all-fused incl QKV\n    #     192.30 -> QKV's RS kernel is too slow even with contention; decomp\n    #     O/Down per isolated-optimal = 194.20 -> WORSE, contention dominates).\n    #   batch 256: GU/Down fused (256) = 321.67 vs GU/Down decomp (192) = 331.11\n    #     -> fusing wins by 9.4ms even at N=256 (isolated bench says decomp here,\n    #     but the engine HBM-write contention flips it).\n    # That measurement supported fusing O/GateUp/Down broadly, but keep the\n    # live table scoped to the batch-128 serving range we are validating now;\n    # N>256 (prefill) decompresses anyway via fallback.\n    # The isolated+H2D benchmark below crossed over to decompress+cuBLAS earlier\n    # for O/Down, but the batch-128 serving trace regressed in exactly that\n    # region: dense materialization pushes the frozen-weight scheduling gap into\n    # every decode graph.  Keep QKV conservative, but restore O/Down to the\n    # in-engine batch-128 fused range.\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused WINS or is a noise-level TIE (<=2%) vs decmp\n        # under H2D -- a tie favours fused anyway (no dense-weight HBM write).\n        #\n        # QKV fuses (=64) like the rest.  The fused path is the RS kernel (approx) + a\n        # SEPARATE p4_exc_correct kernel (one block per out-of-palette exception);\n        # decompress pays no exception cost, so a HIGH-exception layer can flip\n        # fused below decomp.  But a PER-LAYER, real-weight sweep (all 80 Llama-70B\n        # layers @ N=64, H2D) showed fused WINS 78/80 QKV layers (~1.13x); only the\n        # 2 extreme early layers lose (layer0 314k exc -> 0.44x, layer1 39k ->\n        # 0.96x).  O 77/80 (3 are noise-level ~1.0x), GateUp 80/80 (even layer0\n        # 113k exc wins 1.31x -- its 940MB avoided write swamps exceptions), Down\n        # 80/80.  We accept the 1-2 extreme-outlier layers (e.g. QKV layer0)\n        # being slower rather than gate per layer -- aggregate TPOT cost ~0.1%.\n        # (Earlier QKV=0 was a layer-0 sampling artifact: the isolated bench's\n        # real-weight loader only ever sees layer 0, the 314k outlier.  Most QKV\n        # layers have ~1.6k exceptions and fuse-win.)\n        # best-N re-derived by an 8-step N sweep on a representative (median-exc)\n        # real layer (layer 40, N=8..256, H2D).  Cliff is structural: at N>64 the\n        # small-M shapes (QKV/O/Down) remap to the slow Npad=192 WGMMA tile\n        # (_pad_n), so they lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n                Bpb[:N].copy_(x2)\n                Bp = Bpb\n            # Cbuf[n, m] = sum_k W[m,k]*x[n,k] = F.linear(x, W)[n, m].\n            # Split-K fills the GPU at decode N (see ublb _u4_split_k); the\n            # production p4 path passes no in-kernel exceptions so split-K is safe.\n            sk = _u4_split_k(M, Npad, K)\n            # Split-K fp32 partials: pool like Cbuf/Bpb (keyed by sk too) instead\n            # of torch.empty every call -- the kernel overwrites all sk*Npad*M\n            # partials before the in-launch reduce, so reuse is safe, and at\n            # decode-N this churned the caching allocator (size scales with M, so\n            # QKV/GateUp were worst).\n            if sk > 1:\n                ckey = (\"cf32\", sk, Npad, M, x2.device.index)\n                cf32 = sc.get(ckey)\n                if cf32 is None:\n                    cf32 = torch.empty(sk, Npad, M, dtype=torch.float32, device=x2.device)\n                    sc[ckey] = cf32\n            else:\n                cf32 = _empty_f32(x2.device)\n        