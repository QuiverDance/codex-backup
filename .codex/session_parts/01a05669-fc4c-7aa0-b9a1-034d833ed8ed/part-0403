(aliased to load_weight_stream) so it is SERIAL with weight on the\n        # single GH200 copy engine — KVLoad's _kv_h2d_begin.._kv_dec_h2d bracket\n        # then measures pure transfer in its own engine slot, not the\n        # cross-stream engine-queue wait it absorbed on batch_decomp_stream\n        # (WLoad+KVLoad <= GPUFwd).  Decode kernels stay on batch_decomp_stream\n        # (what exec's attn barrier waits on) and gate on _kv_dec_h2d.  Two load\n        # buffers (_dec_blob_ring): layer L+1's H2D writes the OTHER slot than\n        # layer L's decode is reading, so H2D(L+1) overlaps decode(L); the\n        # per-slot ``consumed`` event gates reuse — the H2D waits the slot's\n        # previous decode before overwriting it.  Just the waits, no extra\n        # bookkeeping.\n        _split = (self.load_kv_stream is not None\n                  and self._kv_split_h2d_enabled)\n        if _split:\n            slot = self._dec_blob_ring_idx & 1\n            self._dec_blob_ring_idx += 1\n            blob_k = self._dec_blob_ring[slot]\n            blob_v = self._dec_blob_v_ring[slot]\n            h2d_stream = self.load_kv_stream\n            if self._dec_blob_consumed is not None:\n                h2d_stream.wait_event(self._dec_blob_consumed[slot])\n        else:\n            slot = 0\n            blob_k, blob_v = self._gpu_dec_blob, self._gpu_dec_blob_v\n            h2d_stream = self.batch_decomp_stream\n        # DEVICE meta buffers ride the SAME ring slot as the blob (see __init__):\n        # the meta H2D + the decode read use this slot's buffers, and\n        # _dec_blob_consumed[slot] already gates its reuse — so the split's\n        # cross-stream meta H2D can't overwrite a buffer the decode is reading.\n        gi_dev = self._gi_dev_ring[slot]\n        gu_dev = self._gu_dev_ring[slot]\n        gb_dev = self._gb_dev_ring[slot]\n        if self._tb:\n            # KVLoad bracket begin; on the H2D stream (matches _kv_dec_h2d).\n            self._kv_h2d_begin[layer_id].record(h2d_stream)\n        if candidates_t is None:\n            candidates_t = self._decomp_filter_cand_t\n        n = _p4f_ext.decode_layer_prep(\n            candidates_t, self._valid_t[layer_id], slot_tbl,\n            kvr, kec, kir, vvr, vec, vir,\n            self._meta_ring_pi[ri], self._meta_ring_pu[ri],\n            self._meta_ring_b[ri],\n            gi_dev, gu_dev, gb_dev,\n            hkb, hvb, blob_k, blob_v,\n            active, self._meta_ring_ev[ri].cuda_event,\n            self._kv_dec_h2d[layer_id].cuda_event,\n            h2d_stream.cuda_stream)\n        if n <= 0:\n            if n < 0:\n                logger.error(\n                    \"[kv-decode] SKIP L%d: valid/slot desync (a valid block \"\n                    \"maps outside [0:%d)) -- would CUDA-IMA\", layer_id,\n                    active)\n            if _ENV_KV_DETAILED_NVTX:\n                torch.cuda.nvtx.range_pop()  # kv_decode_cpp\n            return\n        gi, gu = gi_dev, gu_dev\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\n        rsm = self._row_major_sm\n        # Decode kernels on batch_decomp_stream (raw handle = no per-call\n        # `with torch.cuda.stream(...)` context).  When the H2D ran on\n        # load_kv_stream (split), gate the kernels on _kv_dec_h2d so they read\n        # the blob/meta only after the cross-stream H2D lands.\n        sh = self.batch_decomp_stream.cuda_stream\n        if _split:\n            self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\n        if self._tb:\n            self._kv_decode_begin[layer_id].record(\n                self.batch_decomp_stream)\n        # Fused K+V decode: pass the BASE gi/gu/gb tensors + n (the codec slices\n        # by pointer offset in C++) instead of building gi[0:n]/gi[2n:3n]/gu[0:n]\n        # ... CUDA views + 2 reshapes per launch — that view churn was the CPU\n        # gap between the blob H2D and the decode kernel.\n        self._invoke_decode_layer(\n            blob_k, blob_v, blob_stride,\n            gi, gu, gb_dev, n, k_cache, v_cache,\n            block_numel, K_b, M_b, exc_cap, rsm, sh)\n        if _split and self._dec_blob_consumed is not None:\n            # decode done reading this load buffer -> the next layer's H2D may\n            # reuse the slot (the consumed wait above gates it).\n            self._dec_blob_consumed[slot].record(self.batch_decomp_stream)\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_pop()  # kv_decode_cpp\n\n    def _stage_blob_h2d(self, layer_id: int, lo: int, hi: int,\n                        host_k: dict, host_v: dict,\n                        gk: torch.Tensor = None, gv: torch.Tensor = None) -> None:\n        \"\"\"H2D the compressed K/V blobs for slot range [lo:hi) into the decode\n        staging buffer, preserving slot positions (gpu row = slot - lo).\n\n        ``gk``/``gv`` select the target staging blob (a blob-ring slot for the\n        load_kv_stream split); default to the slot-0 buffers.\n\n        Live slots are dense by construction (min-slot-first refills holes), but\n        a drain phase (frees with no intervening allocs) leaves holes in\n        [0:hwm).  Rather than copy the whole [lo:hi) span (dragging hole rows)\n        or sort the requested slots, we split the span at the free-list holes\n        (a membership scan — no sort) and submit the live runs as ONE\n        cudaMemcpyBatchAsync.  Mirrors the uncompressed KV-offload batch path.\n        Below ``_decode_hole_threshold`` holes a single contiguous copy is\n        cheaper than the run scan.\"\"\"\n        n_rows = hi - lo\n        if gk is None:\n            gk = self._gpu_dec_blob\n        if gv is None:\n            gv = self._gpu_dec_blob_v\n        bk, bv = host_k['blob'], host_v['blob']\n        free_set = self._kv_free_slots.get(layer_id)\n        # free_set holds exactly the holes in [0:hwm); for the (production)\n        # single chunk [0:hwm] every hole is in range, so