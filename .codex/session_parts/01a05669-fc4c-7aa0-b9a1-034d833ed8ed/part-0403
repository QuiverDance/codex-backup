     self._batch_ext = _zs\n        if _zs and hasattr(_zs, \"batch_memcpy\"):\n            _zs.batch_memcpy(dst, src,\n                             torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(dst, src, non_blocking=True)\n\n    def _wait_meta_ring_slot(self, ri: int) -> None:\n        \"\"\"Gate pinned meta-ring reuse without a host wait on the common path.\"\"\"\n        ev = self._meta_ring_ev[ri]\n        if not ev.query():\n            ev.synchronize()\n\n    def _decompress_batched(self, layer_id: int, block_ids: list,\n                            k_cache: torch.Tensor,\n                            v_cache: torch.Tensor) -> None:\n        \"\"\"Production fast path — deliberately SHORT.\n\n        Runs once per layer per step on the forward thread, where every\n        Python statement / torch dispatch is GPU-idle gap (the nsys\n        before_replay stall).  Handles the production shape only: single\n        chunk (hwm <= staging cap), async meta ring, static grid bounds,\n        dense-ish slots.  Everything else (multi-chunk, sync-meta rollback,\n        VALIDATE=1 full checks, time-breakdown events, hole-heavy staging)\n        falls back to ``_decompress_batched_general``.\n        \"\"\"\n        active = self._kv_active_count[layer_id]\n        free_set = self._kv_free_slots.get(layer_id)\n        if (active > self._dec_cap or self._meta_sync_fallback\n                or self._decode_validate or self._tb\n                or (free_set and len(free_set) >= self._decode_hole_threshold)):\n            return self._decompress_batched_general(\n                layer_id, block_ids, k_cache, v_cache)\n        if active == 0:\n            return\n\n        slot_tbl, hkb, hvb, kvr, kec, kir, vvr, vec, vir = \\\n            self._dec_fast[layer_id]\n        bid_arr = (block_ids if isinstance(block_ids, np.ndarray)\n                   else np.asarray(block_ids, dtype=np.int64))\n        _cc = self._cbids_cache_np\n     