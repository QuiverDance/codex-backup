host_k, host_v,\n                                 gk_blob, gv_blob)\n            gi = pif[:5 * n].cuda(non_blocking=True)\n            gu = puf[:2 * n].cuda(non_blocking=True)\n            if ids_cached:\n                cbids = self._cbids_cache_gpu\n            else:\n                cbids = bif[:n].cuda(non_blocking=True)\n                self._cbids_cache_np = bid_arr\n                self._cbids_cache_t = bids_cpu\n                self._cbids_cache_gpu = cbids\n            self._meta_ring_ev[ri].record(ls)\n            self._kv_dec_h2d[layer_id].record(ls)\n\n        # ── DECODE on batch_decomp_stream (waits for the load) ──\n        with torch.cuda.stream(ds):\n            ds.wait_event(self._kv_dec_h2d[layer_id])\n            # gi/gu/cbids were allocated by .cuda() on load_kv_stream but are\n            # READ by the decode here on batch_decomp_stream.  Without telling\n            # the caching allocator that ds uses them, it frees them when this\n            # call returns (last use recorded on load_kv_stream) and recycles\n            # the memory on load_kv_stream's next .cuda() — while ds's decode,\n            # which overlaps under double-buffering, is still reading it → IMA.\n            # record_stream pins their lifetime to ds.  (The blob ring slots are\n            # persistent, so they need no such guard.)\n            gi.record_stream(ds)\n            gu.record_stream(ds)\n            cbids.record_stream(ds)\n            chunk_slots = gi[0:n]\n            self._invoke_decode_kernel(\n                gk_blob, blob_stride, chunk_slots, cbids,\n                gi[n:2 * n], gi[2 * n:3 * n], gu[0:n], k_flat,\n                block_numel, K_b, mvrk, meck, rsm)\n            self._invoke_decode_kernel(\n                gv_blob, blob_stride, chunk_slots, cbids,\n                gi[3 * n:4 * n], gi[4 * n:5 * n], gu[n:2 * n], v_flat,\n                block_numel, K_b, mvrv, mecv, rsm)\n            if self._dec_blob_consumed is not None:\n                sel