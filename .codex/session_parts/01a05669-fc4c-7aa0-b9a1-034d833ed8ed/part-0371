           llm_intervals = self._calc_exec_times(kernel_intervals, [])\n        llm_time = sum(e - b for b, e in llm_intervals)\n\n        # ── Weight decompression intervals (only when compressed) ──\n        weight_decomp_time = 0.0\n        overlap_time = 0.0\n        weight_decomp_intervals = []\n        if use_weight_comp and load_comp_weight:\n            # Include all not-frozen layers' decomp events.\n            # Stale events (from layers that didn't actually decompress)\n            # are filtered by the begin_time / duration checks below.\n            weight_decomp_intervals = self._calc_intervals(\n                init_event,\n                [e for i, e in enumerate(self.begin_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n                [e for i, e in enumerate(self.end_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n            )\n            weight_decomp_time = sum(\n                e - b for b, e in weight_decomp_intervals)\n            overlap_time = self._calculate_total_overlap(\n                llm_intervals, weight_decomp_intervals)\n\n        # ── KV comp / decomp (only when KV compression enabled) ──\n        kv_comp_time = 0.0\n        kv_decomp_time = 0.0\n        # Compressed-KV H2D split out of decomp and folded into KVLoad below\n        # (directly summed with the load_kv_stream copies, no overlap accounting).\n        kv_comp_h2d_time = 0.0\n        kv_h2d_intervals: List[Tuple[float, float]] = []\n        if use_kv_comp:\n            kv_comp_intervals = self._calc_intervals(\n                init_event,\n                self.begin_kv_comp_events,\n                self.end_kv_comp_events)\n            kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\n\n            # KVDecomp must be the DECODE KERNEL only.  The loader's interval\n            # [begin_kv_decomp, end_kv_decomp] covers H2D and stream waits.\n            # _kv_dec_h2d is the H2D-producer event; using it as the decode\n            # begin still absorbs older work / the decode-buffer WAR wait\n            # already queued on batch_decomp_stream.  The compressor therefore\n            # records _kv_decode_begin on the consumer stream after every wait\n            # and immediately before the codec launch.  H2D remains measured by\n            # _kv_h2d_begin .. _kv_dec_h2d and is attributed to KVLoad.\n            _kc = getattr(self, \"kv_compressor\", None)\n            h2d_b = getattr(_kc, \"_kv_h2d_begin\", None)\n            h2d_e = getattr(_kc, \"_kv_dec_h2d\", None)\n            kernel_b = getattr(_kc, \"_kv_decode_begin\", None)\n            _n = len(self.begin_kv_decomp_events)\n            if h2d_b is not None and h2d_e is not None \\\n                    and len(h2d_b) == _n and len(h2d_e) == _n:\n                kv_h2d_intervals = self._calc_intervals(\n                    init_event, h2d_b, h2d_e)\n                kv_comp_h2d_time = sum((e - b) for b, e in kv_h2d_intervals)\n            if kernel_b is not None and len(kernel_b) == _n:\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event, kernel_b, self.end_kv_decomp_events)\n            elif h2d_e is not None and len(h2d_e) == _n:\n                # Older compressors expose only the producer-side H2D-done\n                # event.  This is less precise but still excludes the copy.\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event, h2d_e, self.end_kv_decomp_events)\n            else:\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event,\n                    self.begin_kv_decomp_events,\n                    self.end_kv_decomp_events)\n            kv_decomp_time = sum((e - b) for b, e in kv_decomp_intervals)\n\n        # ── Memcpy intervals (only recorded in compressed load path) ──\n        weight_load_time = 0.0\n        kv_load_time = 0.0\n\n        weight_memcpy_times = self._calc_interval