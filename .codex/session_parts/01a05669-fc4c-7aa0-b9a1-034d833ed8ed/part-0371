reams finish.\n        # synchronize() is cheap relative to the per-step work and only\n        # runs in collect_times mode (off by default).\n        try:\n            total_time = self.begin_forward_event.elapsed_time(\n                self.end_forward_event)\n        except RuntimeError:\n            torch.cuda.synchronize()\n            total_time = self.begin_forward_event.elapsed_time(\n                self.end_forward_event)\n        idx_to_weight_name = [\n            \"self_attn.qkv_proj.weight\", \"self_attn.o_proj.weight\",\n            \"mlp.gate_up_proj.weight\", \"mlp.down_proj.weight\"\n        ]\n\n        init_event = self.begin_forward_event\n        use_weight_comp = DualMemoryLoader.use_weight_comp\n        load_comp_weight = DualMemoryLoader.load_comp_weight\n        use_kv_comp = DualMemoryLoader.use_kv_comp\n\n        # ── Compute intervals ──\n        # The V1 wrapper records begin_exec/end_exec around every graph piece\n        # for BOTH prefill and decode.  These are the source of truth: module\n        # hooks are baked out of captured/compiled pieces, so their per-kernel\n        # events can remain stale during mixed prefill and previously produced\n        # overlapping intervals whose raw sum exceeded GPUFwd.\n        llm_intervals = self._calc_intervals(\n            init_event, self.begin_exec_events, self.end_exec_events)\n        if llm_intervals:\n            llm_intervals = self._calc_exec_times(llm_intervals, [])\n        elif self.batch_has_prefill:\n            # V0 fallback: eager module hooks still provide kernel intervals.\n            # Merge their union before summing because nested/duplicate hooks\n            # are legal and must never count the same GPU time twice.\n            kernel_intervals = self._calc_intervals(\n                init_event, self.begin_kernel_events, self.end_kernel_events)\n            if kernel_intervals:\n                total_end = init_event.elapsed_time(self.end_forward_event)\n                first_start = min(total_end, kernel_intervals[0][0])\n                last_end = min(\n                    total_end, max(e for _, e in kernel_intervals))\n                if first_start > 0.001:\n                    kernel_intervals.append((0.0, first_start))\n                if total_end > last_end + 0.001:\n                    kernel_intervals.append((last_end, total_end))\n                llm_intervals = self._calc_exec_times(kernel_intervals, [])\n        llm_time = sum(e - b for b, e in llm_intervals)\n\n        # ── Weight decompression intervals (only when compressed) ──\n        weight_decomp_time = 0.0\n        overlap_time = 0.0\n        weight_decomp_intervals = []\n        if use_weight_comp and load_comp_weight:\n            # Include all not-frozen layers' decomp events.\n            # Stale events (from layers that didn't actually decompress)\n            # are filtered by the begin_time / duration checks below.\n            weight_decomp_intervals = self._calc_intervals(\n                init_event,\n                [e for i, e in enumerate(self.begin_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n                [e for i, e in enumerate(self.end_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n            )\n            weight_decomp_time = sum(\n                e - b for b, e in weight_decomp_intervals)\n            overlap_time = self._calculate_total_overlap(\n                llm_intervals, weight_decomp_intervals)\n\n        # ── KV comp / decomp (only when KV compression enabled) ──\n        kv_comp_time = 0.0\n        kv_decomp_time = 0.0\n        # Compressed-KV H2D split out of decomp and folded into KVLoad below\n        # (directly summed with the load_kv_stream copies, no overlap accounting).\n        kv_comp_h2d_time = 0.0\n        kv_h2d_intervals: List[Tuple[float, float]] = []\n        if use_kv_comp:\n            kv_comp_intervals = self._calc_intervals(\n                init_event,\n                self.begin_kv_comp_events,\n                self.end_kv_comp_events)\n            kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\n\n            # KVDecomp must be the DECODE KERNEL only.  The loader's interval\n            # [begin_kv_decomp, end_kv_decomp] covers H2D and stream waits.\n            # _kv_dec_h2d is the H2D-producer event; using it as the decode\n            # begin still absorbs older work / the decode-buffer WAR wait\n            # already queued on batch_decomp_stream.  The compressor therefore\n            # records _kv_decode_begin on the consumer stream after every wait\n            # and immediately before the codec launch.  H2D remains measured by\n            # _kv_h2d_begin .. _kv_dec_h2d and is attributed to KVLoad.\n            _kc = getattr(self, \"kv_compressor\", None)\n            h2d_b = getattr(_kc, \"_kv_h2d_begin\", None)\n            h2d_e = getattr(_kc, \"_kv_dec_h2d\", None)\n            kernel_b = getattr(_kc, \"_kv_decode_begin\", None)\n            _n = len(self.begin_kv_decomp_events)\n            if h2d_b is not None and h2d_e is not None \\\n                    and len(h2d_b) == _n and len(h2d_e) == _n:\n                kv_h2d_intervals = self._calc_intervals(\n                    init_event, h2d_b, h2d_e)\n                kv_comp_h2d_time = sum((e - b) for b, e in kv_h2d_intervals)\n            if kernel_b is not None and len(kernel_b) == _n:\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event, kernel_b, self.end_kv_decomp_events)\n            elif h2d_e is not None and len(h2d_e) == _n:\n                # Older compressors expose only the producer-side H2D-done\n                # event.  This is less precise but still excludes the copy.\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event, h2d_e, self.end_kv_decomp_events)\n            else:\n                kv_decomp_intervals = self._calc_intervals(\n                    init_event,\n                    self.begin_kv_decomp_events,\n                    self.end_kv_decomp_events)\n            kv_decomp_time = sum((e - b) for b, e in kv_decomp_intervals)\n\n        # ── Memcpy intervals (only recorded in compressed load path) ──\n        weight_load_time = 0.0\n        kv_load_time = 0.0\n\n        weight_memcpy_times = self._calc_intervals(init_event, [\n            e for i, e in enumerate(self.begin_memcpy_weight_events)\n            if (i // 4) in self.not_frozen_layers\n        ], [\n            e for i, e in enumerate(self.end_memcpy_weight_events)\n            if (i // 4) in self.not_frozen_layers\n        ])\n        # frozen_split layers ride the SAME load_weight_stream but record\n        # their LPDDR→staging H2D through separate per-(layer,name) timing\n        # events (frozen layers are excluded from the offload filter above),\n        # so the memcpy aggregation misses them entirely.  Fold those\n        # intervals in here, then merge the union so overlapping/back-to-back\n        # copies on the one stream aren't double-counted.\n        fs_begin = getattr(self, \"_frozen_split_h2d_begin_events_cache\", None)\n        fs_end = getattr(self, \"_frozen_split_h2d_end_timing_events_cache\",\n                         None)\n        if fs_begin and fs_end:\n            _fs_keys = [k for k in fs_begin if k in fs_end]\n            weight_memcpy_times = weight_memcpy_times + self._calc_intervals(\n                init_event,\n                [fs_begin[k] for k in _fs_keys],\n                [fs_end[k] for k in _fs_keys])\n        # Merge overlapping intervals before summing (all on load_weight_stream).\n        weight_load_time = self._merge_union(weight_memcpy_times)\n\n        kv_memcpy_times = self._calc_intervals(init_event,\n                                               self.begin_memcpy_kv_events,\n                                               self.end_memcpy_kv_events)\n        if kv_comp_h2d_time > 0.0:\n            # Compressed KV: the real per-layer KV load is the blob H2D on\n            # batch_decomp_stream, bracketed by the tight _kv_h2d_begin ..\n            # _kv_dec_h2d events (kv_comp_h2d_time).  Use that alone — the\n            # begin/end_memcpy_kv brackets on load_kv_stream (aliased to\n            # load_weight_stream under KV_H2D_ON_WEIGHT) re-measure the weight\n            # H2D in the decode window and would double-count it.\n            kv_load_time = kv_comp_h2d_time\n        else:\n            # Raw KV on a SEPARATE load_kv_stream (the default; KV_H2D_ON_WEIGHT\n            # aliases only the kvcomp path).  On the shared C2C link the per-\n            # stream begin/end_memcpy_kv bracket fires at STREAM-queue position\n            # while the engine is still draining the prefetched weight, so it\n            # ABSORBS that weight (KVLoad >> real — the dirty artifact).  Do NOT\n            # trust that bracket as a standalone value.  Recover the clean KV\n            # engine-time as  engine_busy_union − weight :\n            #   • the UNION of weight ∪ KV intervals is INFLATION-IMMUNE — the\n            #     absorbed weight is double-counted (it lives in both the inflated\n            #     KV interval AND the clean weight intervals), and the union-merge\n            #     cancels that overlap → the union equals the true H2D engine-busy\n            #     span (validated disjoint vs the nsys copy-engine timeline).\n            #   • weight_load_time is the CLEAN head-of-queue weight union (weight\n            #     is prefetched first, never queued behind KV → never absorbed).\n            # KVLoad = union − weight is then exact, additive by construction\n            # (WLoad+KVLoad = union ≤ GPUFwd), zero schedule perturbation (pure\n            # post-hoc arithmetic on the fast baseline's recorded events), and a\n            # real measurement (a genuine KV slowdown grows the union → the\n            # residual).  Validated: union 150.79 − weight 112.92 = 37.87 ≈ nsys\n            # KV 37.86 @b64.  (Stream-ordering fixes — weight-waits-KV / alias /\n            # KV-waits-weight — were all rejected: they change the schedule and\n            # collapse the depth-2 weight prefetch, +25-31% TPOT.)\n            engine_busy_union = self._merge_union(\n                weight_memcpy_times + kv_memcpy_times)\n            kv_load_time = max(0.0, engine_busy_union - weight_load_time)\n\n        # ── Stall computation ──\n        if not self.batch_has_prefill:\n            # Decode: measure stalls from exec event gaps and barrier\n            # wait events recorded in V1 wrapper.\n            #\n            # Exec intervals span [begin_exec → end_exec] per graph\n            # piece.  They include the KV barrier wait (exec_attn_barriers\n            # wait in _after_replay) which delays attention start.\n            #\n            # The KV barrier wait is NOT caused by slow KV loading — it's\n            # caused by the weight→KV dependency chain: load_kv_stream\n            # waits for load_weight_stream, so the barrier is delayed.\n            #\n            # We report a single TotalStall = total_time - pure_exec.\n            # The barrier wait events give additional breakdown.\n\n            # Measure barrier waits inside exec intervals\n            attn_barrier_wait = 0.0\n            valid_exec_set = set()\n            n_exec = len(self.begin_exec_events)  # n_layers + 1\n            for i in range(n_exec):\n                begin_time = init_event.elapsed_time(\n                    self.begin_exec_events[i])\n                end_time = init_event.elapsed_time(\n                    self.end_exec_events[i])\n                if begin_time >= -0.01 and end_time > begin_time + 0.001:\n                    valid_exec_set.add(i)\n\n            for i in range(self.n_layers):\n                if i not in valid_exec_set:\n                    continue\n                wait_ms = self._v1_kv_wait_begin_events[i].elapsed_time(\n                    self._v1_kv_wait_end_events[i])\n                if wait_ms > 0.001:\n                    attn_barrier_wait += wait_ms\n\n            # ── Per-component stall (the \"where\") ──\n            # Each projection GEMM waits for its own weight at the in-graph\n            # ``wait_frozen_weight`` op (timed by _v1_wwait_*); attention waits\n            # for KV at the _v1_kv_wait op.  ALL of these waits live on\n            # cur_stream and run sequentially, so the per-component sums\n            # partition the step's stall with no double-counting.  Filter by\n            # absolute timestamp (begin inside this step's window) to drop\n            # stale events from frozen/resident layers that did not wait.\n            comp_stall = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_stall_by_layer = {}\n            wwb = getattr(self, \"_v1_wwait_begin_events\", None)\n            wwe = getattr(self, \"_v1_wwait_end_events\", None)\n            if wwb and wwe:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = L * 4 + c\n                        try:\n                            b = init_event.elapsed_time(wwb[j])\n                            e = init_event.elapsed_time(wwe[j])\n                        except RuntimeError:\n                            continue\n                        if b > -0.01 and b < total_time and e - b > 0.001:\n                            comp_stall[c] += e - b\n                            comp_stall_by_layer.setdefault(\n                                L, [0.0, 0.0, 0.0, 0.0])[c] = e - b\n            weight_stall = sum(comp_stall)\n\n            # pure exec = exec intervals minus ALL barrier waits inside them\n            # (attention KV wait + per-component in-graph weight waits).\n            exec_time = max(0.0, llm_time - attn_barrier_wait - weight_stall)\n            weight_barrier_wait = max(0.0, total_time - llm_time)\n            total_stall_time = total_time - exec_time\n\n            # Per-component stall breakdown — where cur_stream IDLES (compute\n            # side).  In a load-bound pipeline this lands on whichever barrier\n            # sits at the per-layer load-slot end (usually attn), which is the\n            # OBSERVATION point, not the cause.\n            # Under time_breakdown the per-step line is suppressed; the driver\n            # (offline_offload_kvweight.py) prints one batch-averaged line from\n            # the barrier-wait/comp_load values stashed into decode_breakdowns.\n            if not self.time_breakdown:\n                logger.info(\n                    \"  BarrierWait(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                    \"down=%.2f attn=%.2f | weight=%.2f direct=%.2f\",\n                    comp_stall[0], comp_stall[1], comp_stall[2], comp_stall[3],\n                    attn_barrier_wait, weight_stall,\n                    weight_stall + attn_barrier_wait)\n\n            # ── Per-component LOAD time (the copy-engine critical path) ──\n            # The CAUSE of the stall: in a load-bound pipeline the bottleneck\n            # is the H2D copy engine, and the stall is driven by whichever\n            # component's load takes longest.  Measure per-component H2D\n            # duration (begin→end memcpy), summed over the layers that load\n            # this step.  The largest component IS where the stall lives.\n            comp_load = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_to_slot = {\"qkv\": 0, \"o\": 1, \"gate_up\": 2, \"down\": 3}\n            bmw = getattr(self, \"begin_memcpy_weight_events\", None)\n            emw = getattr(self, \"end_memcpy_weight_events\", None)\n            if bmw and emw:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = 4 * L + c\n                        if j >= len(emw):\n                            continue\n                        try:\n                            b = init_event.elapsed_time(bmw[j])\n                            e = init_event.elapsed_time(emw[j])\n                        except RuntimeError:\n                            continue\n                        if b > -0.01 and b < total_time and e - b > 0.001:\n                            comp_load[c] += e - b\n            # Frozen_split compressed-exp / aux H2D is timed through a\n            # per-(layer, tensor_name) cache, not begin_memcpy_weight_events.\n            # WLoad already folds these intervals into the total; mirror that\n            # attribution here so ComponentLoad does not report zero weight\n            # load in frozen_split/fused-mm decode runs.\n            fs_begin = getattr(\n                self, \"_frozen_split_h2d_begin_events_cache\", None)\n            fs_end = getattr(\n                self, \"_frozen_split_h2d_end_timing_events_cache\", None)\n            if fs_begin and fs_end:\n                for k_ev, b_ev in fs_begin.items():\n                    e_ev = fs_end.get(k_ev)\n                    if e_ev is None:\n                        continue\n                    try:\n                        b = init_event.elapsed_time(b_ev)\n                        e = init_event.elapsed_time(e_ev)\n                    except RuntimeError:\n                        continue\n                    if b < -0.01 or b >= total_time or e - b <= 0.001:\n                        continue\n                    try:\n                        _layer_id, name = k_ev\n                    except (TypeError, ValueError):\n                        continue\n                    comp = getattr(self, \"tensor_to_component\", {}).get(name)\n                    c = comp_to_slot.get(comp)\n                    if c is not None:\n                        comp_load[c] += e - b\n            # Keep ComponentLoad on the same canonical definition as KVLoad:\n            # compressed KV uses the tight blob-H2D events, while raw KV uses\n            # copy-engine union minus WLoad.  The broad begin/end_memcpy_kv\n            # bracket includes queue waits and badly inflates raw KV here.\n            kv_load_ms = kv_load_time\n            if not self.time_breakdown:\n                logger.info(\n                    \"  ComponentLoad(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                    \"down=%.2f kv=%.2f | total=%.2f  \"\n                    \"(copy-engine; bottleneck=slowest)\",\n                    comp_load[0], comp_load[1], comp_load[2], comp_load[3],\n                    kv_load_ms, sum(comp_load) + kv_load_ms)\n\n            # Per-layer breakdown (DEBUG level)\n            for cur_id in range(min(\n                    self.n_layers,\n                    len(self.begin_exec_events) - 1)):\n                attn_wait = self._v1_kv_wait_begin_events[\n                    cur_id].elapsed_time(\n                        self._v1_kv_wait_end_events[cur_id])\n                wcw = comp_stall_by_layer.get(cur_id)\n                if attn_wait > 0.01 or wcw:\n                    wstr = (\"\" if not wcw else\n                            \" W[qkv=%.2f o=%.2f gu=%.2f dn=%.2f]\" % tuple(wcw))\n                    logger.debug(\n                        f\"  Layer {cur_id}: attn={attn_wait:.2f}ms{wstr}\")\n        else:\n            # Prefill: use overlap-based stall calculation\n            if not use_weight_comp:\n                exec_times = llm_intervals\n                exec_time = llm_time\n            else:\n                exec_times = self._calc_exec_times(llm_intervals,\n                                                   weight_decomp_intervals)\n                exec_time = sum((e - b) for b, e in exec_times)\n\n            weight_barrier_wait = self._calc_stalls(\n                init_event, exec_times, weight_memcpy_times)\n            attn_barrier_wait = self._calc_stalls(\n                init_event, exec_times, kv_memcpy_times)\n            total_stall_time = total_time - exec_time\n\n        prefix = \"P\" if self.batch_has_prefill else \"D\"\n        msg = (f\"{prefix} Total: {total_time:.4f} Exec: {exec_time:.4f} \"\n               f\"Stall: {total_stall_time:.4f} \"\n               f\"(WeightBarrier: {weight_barrier_wait:.4f} \"\n               f\"AttnBarrier: {attn_barrier_wait:.4f})\")\n        if weight_load_time > 0.001:\n            msg += f\" WeightH2D: {weight_load_time:.4f}\"\n        if weight_decomp_time > 0.001:\n            msg += f\" WeightDecomp: {weight_decomp_time:.4f}\"\n        if kv_load_time > 0.001:\n            msg += f\" KVH2D: {kv_load_time:.4f}\"\n        if kv_comp_time > 0.001:\n            msg += f\" KVComp: {kv_comp_time:.4f}\"\n        if kv_decomp_time > 0.001:\n            msg += f\" KVDecomp: {kv_decomp_time:.4f}\"\n        if overlap_time > 0.001:\n            msg += f\" DecompOverlap: {overlap_time:.4f}\"\n        # The legacy \"{P,D} Total: ...\" console line is intentionally not\n        # logged (redundant with the [Breakdown] line below); the full\n        # string is still written to the time-log file and nvtx trace.\n        if self._time_log_file is not None:\n            self._time_log_file.write(msg + \"\\n\")\n            self._time_log_file.flush()\n        torch.cuda.nvtx.mark(msg)\n\n        # ── Per-stream breakdown: LLM / WDecomp / KVDecomp / WLoad /\n        #    KVLoad / Stall ──\n        # Each metric is the wall-clock union of the recorded CUDA\n        # events on that stream (events overlap across streams, so we\n        # de-dupe via _calc_exec_times rather than summing).\n        #\n        # Notes on what this CAN'T see:\n        # 1) frozen_compressed layers don't H2D during decode (the\n        #    compressed bytes already live in HBM).  frozen_split\n        #    layers DO H2D the compressed-exp/aux LPDDR buffers every\n        #    decode step on load_weight_stream; those are captured via\n        #    _frozen_split_h2d_(begin|end_timing)_events_cache below.\n        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\n        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\n        #    into the decomp kernel (LPDDR is read directly via\n        #    into the decomp kernel (LPDDR is read directly via\n        #    host-mapped UVA), so those H2D bytes don't surface as a\n        #    separate event — they are folded into the WDecomp time\n        #    instead.\n        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\n        #    → end_forward).  Python-loop TPOT additionally includes\n        #    scheduler / sampling / output assembly on CPU.  See the\n        #    [Step] StepLatency log emitted by\n        #    offline_offload_kvweight.py for the perf_counter step time.\n        if self.time_breakdown:\n            # ── Subtract in-graph cur_stream waits from LLM intervals ──\n            # Two distinct barriers block cur_stream INSIDE the\n            # [begin_exec, end_exec] window — during either, cur_stream is\n            # stalled, NOT running GEMM/attention:\n            #   1. KV-barrier wait: the wrapper's `_after_replay` does\n            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\n            #      (see v1_cuda_graph_wrapper.py) before eager attention.\n            #      Timed by `_v1_kv_wait_*`.\n            #   2. In-graph weight-ready wait: the FX-injected\n            #      `wait_frozen_weight` op blocks each projection GEMM until\n            #      its weight H2D/decomp lands (see graph_wait_ops.py).\n            #      Timed per (layer, component) by `_v1_wwait_*`.\n            # Counting either as LLM busy inflates ComputeUnion and hides\n            # stall.  The legacy \"Exec\" line subtracts BOTH (via\n            # attn_barrier_wait + weight_stall), so LLM here must subtract\n            # both too — otherwise the breakdown LLM reads high by the\n            # weight-wait time.  Subtract the union of all wait sub-intervals\n            # so LLM reflects actual compute on cur_stream and the stall calc\n            # treats wait time as compute-idle.\n            wait_intervals: List[Tuple[float, float]] = []\n            for wbe, wee in (\n                    (getattr(self, '_v1_kv_wait_begin_events', None),\n                     getattr(self, '_v1_kv_wait_end_events', None)),\n                    (getattr(self, '_v1_wwait_begin_events', None),\n                     getattr(self, '_v1_wwait_end_events', None))):\n                if not wbe or not wee:\n                    continue\n                for i in range(min(len(wbe), len(wee))):\n                    try:\n                        wb = init_event.elapsed_time(wbe[i])\n                        we = init_event.elapsed_time(wee[i])\n                    except RuntimeError:\n                        continue\n                    if wb < -0.01 or we < -0.01 or we - wb < 0.001:\n                        continue\n                    wait_intervals.append((wb, we))\n            # KV and weight waits all live on cur_stream and run sequentially,\n            # so they are already non-overlapping — a sort is enough to meet\n            # _subtract_intervals' \"sorted AND non-overlapping\" precondition\n            # (no union-merge needed).  Likewise llm_intervals: the per-kernel\n            # exec intervals don't overlap (single cur_stream), so subtract\n            # directly without unioning first.\n            wait_intervals.sort(key=lambda x: x[0])\n            # Compute = exec minus cur_stream waits; decomp is carved out\n            # further down (once its intervals are built).  llm_brk is\n            # computed there, NOT here.\n            llm_active_intervals = self._subtract_intervals(\n                llm_intervals, wait_intervals)\n\n            # Frozen weight decomp uses a separate event pair\n            # (begin_frozen_decomp_events /\n            #  end_frozen_decomp_timing_events) keyed by\n            # (comp_key, layer_id), distinct from the sync-only\n            # frozen_decomp_events used for cross-stream waits and from\n            # the per-layer begin/end_decomp_events used by the offload\n            # path.  Collect intervals for frozen layers so WDecomp\n            # reflects both modes.\n            frozen_decomp_intervals = []\n            if (use_weight_comp\n                    and hasattr(self, \"begin_frozen_decomp_events\")\n                    and hasattr(self, \"end_frozen_decomp_timing_events\")):\n                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                    begin_list = self.begin_frozen_decomp_events.get(\n                        comp_key, [])\n                    end_list = self.end_frozen_decomp_timing_events.get(\n                        comp_key, [])\n                    for layer_id in self.frozen_layers:\n                        if (layer_id >= len(begin_list)\n                                or layer_id >= len(end_list)):\n                            continue\n                        try:\n                            begin_t = init_event.elapsed_time(\n                                begin_list[layer_id])\n                            end_t = init_event.elapsed_time(\n                                end_list[layer_id])\n                        except RuntimeError:\n                            continue\n                        # Skip stale (pre-init) or zero-duration events.\n                        # Either side being pre-init means this layer\n                        # didn't actually decompress in this forward.\n                        if (begin_t < -0.01 or end_t < -0.01\n                                or end_t - begin_t < 0.001):\n                            continue\n                        frozen_decomp_intervals.append((begin_t, end_t))\n                frozen_decomp_intervals.sort(key=lambda x: x[0])\n\n            # frozen_split's per-(layer,name) decomp kernel uses its\n            # own lazy timing cache (the per-comp_key\n            # end_frozen_decomp_timing_events slots are written by the\n            # frozen_compressed paths, not by\n            # _decompress_frozen_split_for_name).\n            frozen_split_decomp_intervals = []\n            sd_begin_cache = getattr(\n                self,\n                \"_frozen_split_decomp_begin_timing_events_cache\",\n                None)\n            sd_end_cache = getattr(\n                self,\n                \"_frozen_split_decomp_end_timing_events_cache\",\n                None)\n            if sd_begin_cache and sd_end_cache:\n                for key, begin_ev in sd_begin_cache.items():\n                    end_ev = sd_end_cache.get(key)\n                    if end_ev is None:\n                        continue\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_decomp_intervals.append((b_t, e_t))\n                frozen_split_decomp_intervals.sort(key=lambda x: x[0])\n\n            all_weight_decomp_intervals = (\n                weight_decomp_intervals\n                + frozen_decomp_intervals\n                + frozen_split_decomp_intervals)\n            wdecomp_union: List[Tuple[float, float]] = []\n            wdecomp_brk = 0.0\n            if all_weight_decomp_intervals:\n                wdecomp_union = self._calc_exec_times(\n                    all_weight_decomp_intervals, [])\n                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\n\n            kvdecomp_union: List[Tuple[float, float]] = []\n            kvdecomp_brk = 0.0\n            if use_kv_comp and kv_decomp_intervals:\n                kvdecomp_union = self._calc_exec_times(\n                    kv_decomp_intervals, [])\n                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\n\n            # ── Separate Compute from WEIGHT Decomp ──\n            # The decode GEMM blocks on cur_stream until its WEIGHT\n            # decompression (on decomp_weight_stream) completes — the weight IS\n            # the GEMM operand, so the GEMM cannot start until decomp lands.\n            # Only ~6ms of that block surfaces as the in-graph _v1_wwait; the\n            # rest stays inside the exec window, which is why Compute(LLM) read\n            # ~= WDecomp ~= GPUFwd even though the real GEMM is tiny.  Carve the\n            # weight-decomp union out so Compute is GEMM+attention only.\n            #\n            # KV decode must NOT be carved (it used to be — that was a bug).\n            # It is prefetched one layer ahead (start_kv_decompress(L+1) in\n            # _before_replay(L), finish in _after_replay(L)) and runs on\n            # batch_decomp_stream CONCURRENTLY with the productive GEMM of the\n            # next graph piece — it does not block that GEMM.  Attention's real\n            # wait for its OWN layer's KV is the exec_attn_barrier, and that\n            # wait is ALREADY removed above via _v1_kv_wait (wait_intervals).\n            # Subtracting the decode interval a second time here removed real,\n            # concurrent GEMM from Compute, so Compute SHRANK when --kv-comp was\n            # enabled (C.A.O b128 165.6 → C.A.O+KVComp 139.0, exactly the ~22ms\n            # decode carved out) even though the real compute is unchanged.\n            # Leave KV decode in Compute and report it separately as KVDecomp,\n            # a concurrent stream-busy metric that overlaps Compute by design\n            # (so Compute + KVDecomp may exceed GPUFwd — that overlap is the\n            # decode being hidden under compute).  Stall is unaffected:\n            # compute_union below unions the decomp intervals back in anyway.\n            if wdecomp_union:\n                llm_active_intervals = self._subtract_intervals(\n                    llm_active_intervals, wdecomp_union)\n            llm_brk = sum(e - b for b, e in llm_active_intervals)\n\n            # Frozen_split mode H2D's the compressed-exp / aux LPDDR\n            # buffers every decode step on load_weight_stream (see\n            # _decompress_frozen_split_for_name).  These do NOT land in\n            # begin/end_memcpy_weight_events.  We pair the timing-only\n            # BEGIN/END cache (the sync _frozen_split_h2d_events is not\n            # enable_timing).\n            frozen_split_h2d_intervals = []\n            begin_cache = getattr(\n                self, \"_frozen_split_h2d_begin_events_cache\", None)\n            end_cache = getattr(\n                self, \"_frozen_split_h2d_end_timing_events_cache\", None)\n            if begin_cache and end_cache:\n                for key, begin_ev in begin_cache.items():\n                    end_ev = end_cache.get(key)\n                    if end_ev is None:\n                        continue\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_h2d_intervals.append((b_t, e_t))\n                frozen_split_h2d_intervals.sort(key=lambda x: x[0])\n\n            all_weight_load_intervals = (\n                weight_memcpy_times + frozen_split_h2d_intervals)\n            wload_union: List[Tuple[float, float]] = []\n            wload_brk = 0.0\n            if all_weight_load_intervals:\n                wload_union = self._calc_exec_times(\n                    all_weight_load_intervals, [])\n                wload_brk = sum(e - b for b, e in wload_union)\n\n            # Diagnostic: count how many intervals reached each bucket so\n            # we can tell whether wload_brk is low because intervals were\n            # filtered (stale events) or because the union truly is small.\n            if not self.batch_has_prefill and os.getenv(\n                    \"TIERED_SERVE_BREAKDOWN_VERBOSE\", \"0\") == \"1\":\n                wmt_sum = sum(e - b for b, e in weight_memcpy_times)\n                fsi_sum = sum(e - b for b, e in frozen_split_h2d_intervals)\n                logger.info(\n                    \"[WLoadDbg] weight_memcpy: n=%d sum=%.2fms | \"\n                    \"frozen_split_h2d: n=%d sum=%.2fms | \"\n                    \"union=%.2fms (cache_size begin=%d end=%d)\",\n                    len(weight_memcpy_times), wmt_sum,\n                    len(frozen_split_h2d_intervals), fsi_sum,\n                    wload_brk,\n                    len(begin_cache or {}),\n                    len(end_cache or {}))\n\n            kvload_union: List[Tuple[float, float]] = []\n            kvload_brk = 0.0\n            # KVLoad = the wall-clock the KV stream actually spends moving KV\n            # H2D, measured DIRECTLY by the CUDA events that bracket each\n            # layer's transfer: the raw load_kv_stream memcpys (begin/\n            # end_memcpy_kv) plus the compressed-blob H2D on batch_decomp_stream\n            # (_kv_h2d_begin .. _kv_dec_h2d).  Union-merge so back-to-back\n            # intervals on the one stream aren't double-counted, then sum.\n            # NO weight-overlap subtraction: KV H2D and weight H2D serialise on\n            # the single GH200 copy engine, so they never overlap in wall-clock\n            # and there is nothing to attribute away.\n            # Compressed-KV path: the H2D is the dedicated load_kv_stream blob\n            # transfer, bracketed TIGHTLY by _kv_h2d_begin .. _kv_dec_h2d.  Use\n            # that alone — the loader's begin/end_memcpy_kv span ALSO covers the\n            # double-buffer consumed-wait that precedes the H2D, which would\n            # inflate KVLoad with the previous layer's decode time.  Raw KV has\n            # no _kv_h2d events, so fall back to the load_kv_stream memcpys.\n            if kv_h2d_intervals:\n                # KVLoad = Σ each layer's KV H2D begin..end elapsed_time, read\n                # DIRECTLY from the tight _kv_h2d_begin.._kv_dec_h2d events — the\n                # real per-transfer engine time.  NO union-merge: the per-layer\n                # intervals are disjoint on the load stream (union == sum), and\n                # the raw event elapsed_time is the source of truth.  Under the\n                # single-stream (H2D-on-weight) layout each layer's KV H2D runs\n                # in its own engine slot, so this reads the clean ~raw/ratio\n                # transfer (~0.29 ms/layer) instead of the inflated value the KV\n                # op showed when it queued behind weight on a separate stream.\n                kvload_brk = sum(e - b for b, e in kv_h2d_intervals)\n            else:\n                # Raw KV on a separate stream: the begin/end_memcpy_kv bracket is\n                # inflated (absorbs prefetched weight on the shared link).  Don't\n                # use it directly.  KVLoad = engine_busy_union − WLoad: the union\n                # of weight ∪ KV intervals is inflation-immune (the absorbed\n                # weight is double-counted and the merge cancels it → true H2D\n                # engine-busy), and wload_brk is the clean head-of-queue weight\n                # union.  Additive by construction, zero perturbation, validated\n                # vs nsys (union 150.79 − weight 112.92 = 37.87 ≈ KV 37.86 @b64).\n                # (Same recovery as kv_load_time above; see that comment.)\n                engine_busy_union = sum(\n                    e - b for b, e in self._calc_exec_times(\n                        all_weight_load_intervals + kv_memcpy_times, []))\n                kvload_brk = max(0.0, engine_busy_union - wload_brk)\n\n            # Stall = wall-clock time when Load (weight or KV) is\n            # active but NO compute is running on the GPU — neither\n            # Compute (GEMM + Attention) nor WDecomp nor KVDecomp.  Decomp\n            # counts as compute, so Stream 16 gaps in nsight that are filled\n            # by Stream 37 decomp do NOT count as stall.  llm_active_intervals\n            # here had both the cur_stream waits AND the decomp overlap\n            # carved out (so it's pure GEMM+attention); re-adding the decomp\n            # intervals via compute_intervals restores the full compute\n            # timeline — (A − decomp) ∪ decomp == A ∪ decomp, so this Stall is\n            # identical to using the pre-decomp-subtraction intervals.\n            compute_intervals = (\n                all_weight_decomp_intervals\n                + (kv_decomp_intervals if use_kv_comp else []))\n            if llm_active_intervals or compute_intervals:\n                compute_union = self._calc_exec_times(\n                    llm_active_intervals, compute_intervals)\n            else:\n                compute_union = []\n            # Compressed begin/end_memcpy_kv includes the decode-buffer/ring\n            # waits around the transfer.  Stall must use the same tight H2D\n            # interval as KVLoad, otherwise waits are counted as load-active.\n            canonical_kv_load_intervals = (\n                kv_h2d_intervals if kv_h2d_intervals else kv_memcpy_times)\n            load_union_all = self._calc_exec_times(\n                all_weight_load_intervals, canonical_kv_load_intervals)\n            load_total = sum(e - b for b, e in load_union_all)\n            load_in_compute = self._calculate_total_overlap(\n                load_union_all, compute_union)\n            stall_brk = max(0.0, load_total - load_in_compute)\n\n            # GPUFwd here is wall time between begin_forward_event and\n            # end_forward_event — pure GPU forward.  Python-side TPOT\n            # (engine.step()) additionally includes scheduler, sampling,\n            # logits processing and output assembly running on CPU\n            # serially after the GPU forward finishes; that gap is\n            # visible by comparing this line to the [Step] StepLatency\n            # line emitted by offline_offload_kvweight.py.\n            # Reported metrics (per-step wall-clock on GPU):\n            #   Compute  — GEMM + Attention on cur_stream (exec union).\n            #              A fused decode+GEMM kernel (``--fused-mm``) runs\n            #              ON cur_stream, so its decompression is folded\n            #              into Compute, NOT WDecomp.  WDecomp only sees\n            #              decompression that runs on the separate\n            #              decomp_weight_stream.\n            #   WDecomp  — weight decompression on decomp_weight_stream\n            #   KVDecomp — KV decompression on the KV decomp stream(s).  This\n            #              runs CONCURRENTLY with Compute (it is prefetched a\n            #              layer ahead), so it is NOT carved out of Compute and\n            #              is NOT part of the additive GPUFwd tiling — it is a\n            #              standalone stream-busy figure that overlaps Compute.\n            #              When --kv-comp is toggled Compute therefore stays\n            #              ~constant and KVDecomp simply appears on top.\n            #   WLoad    — weight H2D on load_weight_stream\n            #   KVLoad   — KV H2D on load_kv_stream\n            #   Stall    — Load-active wall time that NO compute\n            #              (Compute / WDecomp / KVDecomp) was overlapping;\n            #              i.e. we paid memory bandwidth but the model\n            #              didn't advance.\n            brk_msg = (\n                f\"{prefix} [Breakdown] \"\n                f\"GPUFwd: {total_time:.4f} | \"\n                f\"Compute: {llm_brk:.4f} \"\n                f\"WDecomp: {wdecomp_brk:.4f} \"\n                f\"KVDecomp: {kvdecomp_brk:.4f} \"\n                f\"WLoad: {wload_brk:.4f} \"\n                f\"KVLoad: {kvload_brk:.4f} \"\n                f\"Stall: {stall_brk:.4f}\")\n            # Both phases' breakdowns are accumulated (see below) and logged\n            # once per batch by the benchmark driver\n            # (offline_offload_kvweight.py); the per-step console line is\n            # suppressed for BOTH so the console isn't spammed one line per\n            # step.  File + nvtx keep the full per-step record regardless.\n            if self._time_log_file is not None:\n                self._time_log_file.write(brk_msg + \"\\n\")\n                self._time_log_file.flush()\n            torch.cuda.nvtx.mark(brk_msg)\n\n            # Expose the breakdown as a plain dict for the benchmark driver\n            # and diagnostics.  Overwritten each calc_times call; prefill /\n            # decode are distinguishable via the \"is_prefill\" field.\n            self.last_breakdown = {\n                \"is_prefill\": self.batch_has_prefill,\n                \"gpu_fwd_ms\": total_time,\n                \"compute_ms\": llm_brk,\n                \"wdecomp_ms\": wdecomp_brk,\n                \"kvdecomp_ms\": kvdecomp_brk,\n                \"wload_ms\": wload_brk,\n                \"kvload_ms\": kvload_brk,\n                \"stall_ms\": stall_brk,\n            }\n            if (not self.batch_has_prefill and use_kv_comp\n                    and getattr(_kc, \"_cpu_profile_enabled\", False)):\n                _join_total = float(getattr(\n                    _kc, \"_step_cpu_join_total_ms\", 0.0))\n                _worker_wait = float(getattr(\n                    _kc, \"_step_cpu_worker_wait_ms\", 0.0))\n                self.last_breakdown.update({\n                    \"kv_cpu_join_ms\": _join_total,\n                    \"kv_cpu_worker_wait_ms\": _worker_wait,\n                    \"kv_cpu_publish_ms\": max(\n                        0.0, _join_total - _worker_wait),\n                    \"kv_cpu_join_calls\": int(getattr(\n                        _kc, \"_step_cpu_join_calls\", 0)),\n                    \"kv_cpu_join_blocks\": int(getattr(\n                        _kc, \"_step_cpu_join_blocks\", 0)),\n                    \"kv_cpu_join_max_ms\": float(getattr(\n                        _kc, \"_step_cpu_join_max_ms\", 0.0)),\n                    \"kv_cpu_fast_commit_ms\": float(getattr(\n                        _kc, \"_step_cpu_fast_commit_ms\", 0.0)),\n                    \"kv_cpu_fast_finalize_ms\": float(getattr(\n                        _kc, \"_step_cpu_fast_finalize_ms\", 0.0)),\n                    \"kv_cpu_legacy_get_ms\": float(getattr(\n                        _kc, \"_step_cpu_legacy_get_ms\", 0.0)),\n                    \"kv_cpu_legacy_finalize_ms\": float(getattr(\n                        _kc, \"_step_cpu_legacy_finalize_ms\", 0.0)),\n                    \"kv_cpu_fast_candidates\": int(getattr(\n                        _kc, \"_step_cpu_fast_candidates\", 0)),\n                    \"kv_cpu_fast_hits\": int(getattr(\n                        _kc, \"_step_cpu_fast_hits\", 0)),\n                    \"kv_cpu_fast_fallbacks\": int(getattr(\n                        _kc, \"_step_cpu_fast_fallbacks\", 0)),\n                    \"kv_cpu_raw_blocks\": int(getattr(\n                        _kc, \"_step_cpu_raw_blocks\", 0)),\n                })\n            if self.batch_has_prefill:\n                DualMemoryLoader.prefill_breakdowns.append(self.last_breakdown)\n            else:\n                # Stash the per-component stall/load arrays computed in the\n                # decode stall block above so the driver can print one\n                # batch-averaged BarrierWait / ComponentLoad line.\n                self.last_breakdown[\"comp_stall\"] = list(comp_stall)\n                self.last_breakdown[\"attn_barrier_wait\"] = attn_barrier_wait\n                self.last_breakdown[\"weight_stall\"] = weight_stall\n                self.last_breakdown[\"comp_load\"] = list(comp_load)\n                self.last_breakdown[\"kv_load_ms\"] = kv_load_ms\n                DualMemoryLoader.decode_breakdowns.append(self.last_breakdown)\n\n        self.reset_events()\n\n    def _subtract_intervals(\n        self,\n","stderr":"","aggregated_output":"import os\n\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\n\nclass TimingMixin:\n\n    def calc_times(self, total_time: float):\n        if not self.collect_times:\n            return\n\n        # Idempotency guard.  In V1 piecewise-CUDA-graph mode this\n        # function is called twice per forward — once from\n        # _do_after_model_forward (inside the last graph piece) and\n        # again from after_model_forward (the model's forward_hook).\n        # The first call's reset_events() invalidates the per-layer\n        # exec/decomp event timestamps, and the second call re-records\n        # end_forward_event on a different stream, so the second\n        # invocation produces garbage (negative Exec, doubled Total).\n        # Run only once per forward; the flag is cleared in\n        # before_model_forward at the start of the next forward.\n        if getattr(self, \"_calc_times_done\", False):\n            return\n        self._calc_times_done = True\n\n        # Guard against the \"Both events must be completed\" race we saw\n        # when calc_times runs before the recording streams finish.\n        # synchronize() is cheap relative to the per-step work and only\n        # runs in collect_times mode (off by default).\n        try:\n            total_time = self.begin_forward_event.elapsed_time(\n                self.end_forward_event)\n        except RuntimeError:\n            torch.cuda.synchronize()\n            total_time = self.begin_forward_event.elapsed_