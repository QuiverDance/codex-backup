cation) \"\n   353\t            \"max_blocks=%d layers=%d\",\n   354\t            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n   355\t            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n   356\t\n   357\t    def _move_host_slot(self, layer_id: int,\n   358\t                        dst_slot: int, src_slot: int) -> None:\n   359\t        if dst_slot == src_slot:\n   360\t            return\n   361\t        for kv in (\"k\", \"v\"):\n   362\t            pool = self._host_pools[layer_id][kv]\n   363\t            pool[\"blob\"][dst_slot].copy_(pool[\"blob\"][src_slot])\n   364\t\n   365\t    def _invalidate_decode_plan(self, layer_id: int) -> None:\n   366\t        self._decode_generation[layer_id] = (\n   367\t            self._decode_generation.get(layer_id, 0) + 1)\n   368\t        self._decode_filtered.pop(layer_id, None)\n   369\t        self._decode_plans.pop(layer_id, None)\n   370\t\n   371\t    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\n   372\t        \"\"\"Publish the canonical active set once for the upcoming forward.\n   373\t\n   374\t        ``torch_hooks.before_model_forward`` already materializes a sorted\n   375\t        int64 NumPy array and its corresponding Python list once per step.\n   376\t        Holding both references lets every layer replace an O(N) content\n   377\t        comparison with an identity + integer-version check.  Direct users\n   378\t        that do not call this method continue through the original defensive\n   379\t        filter/content-compare path.\n   380\t        \"\"\"\n   381\t        if active_array is None:\n   382\t            active_array = active_block_ids\n   383\t        candidates = np.asarray(active_array, dtype=np.int64)\n   384\t        if not candidates.flags.c_contiguous:\n   385\t            candidates = np.ascontiguousarray(candidates)\n   386\t        if (candidates.size > 1\n   387\t                and bool((candidates[1:] < candidates[:-1]).any())):\n   388\t            candidates = np.sort(candidates)\n   389\t\n   390\t        previous = self._prepared_active_candidates\n   391\t        if previous is None or not np.array_equal(previous, candidates):\n   392\t            self._prepared_active_version += 1\n   393\t        # Keep the current step's objects alive.  The loader replaces rather\n   394\t        # than mutates them on the next step, so no per-step copy is needed.\n   395\t        self._prepared_active_list = active_block_ids\n   396\t        self._prepared_active_candidates = candidates\n   397\t\n   398\t    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n   399\t        slot_table = self._kv_slot_np[layer_id]\n   400\t        previous = int(slot_table[bid])\n   401\t        if previous >= 0:\n   402\t            return previous\n   403\t        heap = self._kv_free_heap[layer_id]\n   404\t        free_set = self._kv_free_slots[layer_id]\n   405\t        slot = -1\n   406\t        while heap:\n   407\t            candidate = heapq.heappop(heap)\n   408\t            if candidate in free_set:\n   409\t                free_set.discard(candidate)\n   410\t                slot = candidate\n   411\t                break\n   412\t        if slot < 0:\n   413\t            slot = self._kv_active_count[layer_id]\n   414\t            if slot >= len(self._kv_slot_block[layer_id]):\n   415\t                raise RuntimeError(\n   416\t                    f\"ChunkDelta3 KV persistent slot pool full for \"\n   417\t                    f\"layer={layer_id}\")\n   418\t            self._kv_active_count[layer_id] = slot + 1\n   419\t        slot_table[bid] = slot\n   420\t        self._kv_slot_block[layer_id][slot] = bid\n   421\t        self._invalidate_decode_plan(layer_id)\n   422\t        return slot\n   423\t\n   424\t    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n   425\t        table = self._kv_slot_np.get(layer_id)\n   426\t        if table is None or not 0 <= bid < table.size:\n   427\t            return -1\n   428\t        return int(table[bid])\n   429\t\n   430\t    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n   431\t        table = self._kv_slot_np.get(layer_id)\n   432\t        if table is None or not 0 <= block_id < table.size:\n   433\t            return\n   434\t        slot = int(table[block_id])\n   435\t        if slot < 0:\n   436\t            return\n   437\t        self._invalidate_decode_plan(layer_id)\n   438\t        table[block_id] = -1\n   439\t        self._kv_slot_block[layer_id][slot] = -1\n   440\t        free_set = self._kv_free_slots[layer_id]\n   441\t        hwm = self._kv_active_count[layer_id]\n   442\t        if slot == hwm - 1:\n   443\t            hwm -= 1\n   444\t            while hwm - 1 in free_set:\n   445\t                free_set.discard(hwm - 1)\n   446\t                hwm -= 1\n   447\t            self._kv_active_count[layer_id] = hwm\n   448\t        else:\n   449\t            free_set.add(slot)\n   450\t            heapq.heappush(self._kv_free_heap[layer_id], slot)\n   451\t\n   452\t    @staticmethod\n   453\t    def _slot_runs(slots: list[int]):\n   454\t        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n   455\t        if not slots:\n   456\t            return\n   457\t        row_begin = 0\n   458\t        slot_begin = slots[0]\n   459\t        previous = slot_begin\n   460\t        for row in range(1, len(slots)):\n   461\t            slot = slots[row]\n   462\t            if slot != previous + 1:\n   463\t                yield row_begin, row, slot_begin\n   464\t                row_begin = row\n   465\t                slot_begin = slot\n   466\t            previous = slot\n   467\t        yield row_begin, len(slots), slot_begin\n   468\t\n   469\t    def _batch_h2d(self, destinations: list[torch.Tensor],\n   470\t                   sources: list[torch.Tensor],\n   471\t                   stream: torch.cuda.Stream | None = None) -> None:\n   472\t        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n   473\t        if not destinations:\n   474\t            return\n   475\t        if len(destinations) == 1:\n   476\t            if stream is None:\n   477\t                destinations[0].copy_(sources[0], non_blocking=True)\n   478\t            else:\n   479\t                with torch.cuda.stream(stream):\n   480\t                    destinations[0].copy_(sources[0], non_blocking=True)\n   481\t            return\n   482\t        extension = self._batch_ext\n   483\t        if extension is None:\n   484\t            try:\n   485\t                from tiered_serve.cpp_exts import zipserv_ext as extension\n   486\t            except Exception:\n   487\t                extension = False\n   488\t            self._batch_ext = extension\n   489\t        if extension and hasattr(extension, \"batch_memcpy\"):\n   490\t            extension.batch_memcpy(\n   491\t                destinations, sources,\n   492\t                (torch.cuda.current_stream().cuda_stream\n   493\t                 if stream is None else stream.cuda_stream))\n   494\t        else:\n   495\t            if stream is None:\n   496\t                torch._foreach_copy_(\n   497\t                    destinations, sources, non_blocking=True)\n   498\t            else:\n   499\t                with torch.cuda.stream(stream):\n   500\t                    torch._foreach_copy_(\n   501\t                        destinations, sources, non_blocking=True)\n   502\t\n   503\t    def _launch_compress(self, layer_id: int, block_ids: list,\n   504\t                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n   505\t        num_primary = gpu_k.shape[0]\n   506\t        block_ids = [int(bid) for bid in block_ids\n   507\t                     if 0 <= int(bid) < num_primary]\n   508\t        n = len(block_ids)\n   509\t        if n == 0:\n   510\t            return\n   511\t        if n > self._max_gpu_blocks:\n   512\t            raise RuntimeError(\n   513\t                f\"ChunkDelta3 KV encode batch {n} exceeds \"\n   514\t                f\"capacity {self._max_gpu_blocks}\")\n   515\t        slots = [self._assign_kv_slot(layer_id, bid) for bid in block_ids]\n   516\t        bid_gpu = torch.as_tensor(\n   517\t            block_ids, dtype=torch.long, device=gpu_k.device)\n   518\t\n   519\t        with torch.cuda.stream(self.comp_stream):\n   520\t            k_blocks = gpu_k[bid_gpu].reshape(\n   521\t                n, self._M_b, self._K_b).contiguous()\n   522\t            v_blocks = gpu_v[bid_gpu].reshape(\n   523\t                n, self._M_b, self._K_b).contiguous()\n   524\t            for kv, blocks in ((\"k\", k_blocks), (\"v\", v_blocks)):\n   525\t                pool = self._gpu_comp_pool[kv]\n   526\t                _cd3_ext.compress_chunk_delta3_batched(\n   527\t                    blocks,\n   528\t                    pool[\"codes\"][:n],\n   529\t                    pool[\"sign_mantissa\"][:n],\n   530\t                    pool[\"thread_bases\"][:n],\n   531\t                    pool[\"tile_exception_offsets\"][:n],\n   532\t                    pool[\"entries20x3\"][:n],\n   533\t                    pool[\"num_exceptions\"][:n],\n   534\t                )\n   535\t                host = self._host_pools[layer_id][kv]\n   536\t                # Physical slots are persistent and may contain holes.  Keep\n   537\t                # the copies asynchronous on comp_stream; the event below\n   538\t                # gates publication and later slot reuse.\n   539\t                for row_begin, row_end, slot_begin in self._slot_runs(slots):\n   540\t                    length = row_end - row_begin\n   541\t                    for name in self._FIELDS:\n   542\t                        host[name][slot_begin:slot_begin + length].copy_(\n   543\t                            pool[name][row_begin:row_end], non_blocking=True)\n   544\t            event = self.comp