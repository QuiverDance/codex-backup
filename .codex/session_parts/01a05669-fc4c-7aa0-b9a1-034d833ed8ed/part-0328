he default implementation\n    69\t    decompresses then calls :func:`torch.mm`.\n    70\t\n    71\t    Two CUDA streams are provided so compress and decompress can run\n    72\t    concurrently (e.g. compressing layer N+1 while decompressing layer\n    73\t    N for matmul):\n    74\t\n    75\t    * ``self.comp_stream``   — used by :meth:`compress`.\n    76\t    * ``self.decomp_stream`` — used by :meth:`decompress` /\n    77\t      :meth:`fused_mm`.\n    78\t\n    79\t    Both default to freshly allocated :class:`torch.cuda.Stream` instances\n    80\t    on CUDA hosts and ``None`` on CPU-only hosts.  Either may be passed\n    81\t    explicitly by the caller (e.g. to share a stream with an upstream\n    82\t    pipeline stage).\n    83\t    \"\"\"\n    84\t\n    85\t    def __init__(\n    86\t        self,\n    87\t        comp_stream: Optional[torch.cuda.Stream] = None,\n    88\t        decomp_stream: Optional[torch.cuda.Stream] = None,\n    89\t    ):\n    90\t        cuda_available = torch.cuda.is_available()\n    91\t        self.comp_stream = comp_stream or (\n    92\t            torch.cuda.Stream() if cuda_available else None\n    93\t        )\n    94\t        self.decomp_stream = decomp_stream or (\n    95\t            torch.cuda.Stream() if cuda_available else None\n    96\t        )\n    97\t\n    98\t    # ------------------------------------------------------------------\n    99\t    #  Required API\n   100\t    # ------------------------------------------------------------------\n   101\t\n   102\t    @abstractmethod\n   103\t    def compress(\n   104\t        self,\n   105\t        weight: torch.Tensor,\n   106\t        decomp_output_tensor: Optional[torch.Tensor] = None,\n   107\t        comp_output_tensor: Optional[CompressedTensor] = None,\n   108\t        _sync: bool = True,\n   109\t    ) -> CompressedTensor:\n   110\t        \"\"\"Compress ``weight`` and return a :class:`CompressedTensor`.\"\"\"\n   111\t\n   112\t    @abstractmethod\n   113\t    def decompress(\n   114\t        self,\n   115\t        comp: CompressedTensor,\n   116\t        output: Optional[torch.Tensor] = None,\n   117\t    ) -> torch.Tensor:\n   118\t        \"\"\"Decompress ``comp`` into ``output`` (allocated when ``None``).\"\"\"\n   119\t\n   120\t    # ------------------------------------------------------------------\n   121\t    #  Batched API (override for truly-batched kernels)\n   122\t    # ------------------------------------------------------------------\n   123\t\n   124\t    @abstractmethod\n   125\t    def compress_batch(\n   126\t        self,\n   127\t        weights: \"list[torch.Tensor]\",\n   128\t        decomp_output_tensors: \"Optional[list[torch.Tensor]]\" = None,\n   129\t        comp_output_tensors: \"Optional[list[CompressedTensor]]\" = None,\n   130\t        _sync: bool = True,\n   131\t    ) -> \"list[CompressedTensor]\":\n   132\t        \"\"\"Compress a batch of weights in a single launch.\n   133\t\n   134\t        Subclasses with a true batched primitive (e.g. nvcomp's\n   135\t        ``BatchedXXXCompressAsync``) should override this to avoid the\n   136\t        per-tensor host sync incurred by the default fallback.  The base\n   137\t        implementation (callable via ``super().compress_batch(...)``)\n   138\t        loops over :meth:`compress`.\n   139\t        \"\"\"\n   140\t        n = len(weights)\n   141\t        decomp_outs = decomp_output_tensors or [None] * n\n   142\t        comp_outs = comp_output_tensors or [None] * n\n   143\t        results: \"list[CompressedTensor]\" = []\n   144\t        for w, d_out, c_out in zip(weights, decomp_outs, comp_outs):\n   145\t            results.append(self.compress(w, d_out, c_out, _sync=_sync))\n   146\t        return results\n   147\t\n   148\t    @abstractmethod\n   149\t    def decompress_batch(\n   150\t        self,\n   151\t        comps: \"list[CompressedTensor]\",\n   152\t        outputs: \"Optional[list[torch.Tensor]]\" = None,\n   153\t    