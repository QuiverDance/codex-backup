sm layout: unified attach only fires when the\n        # primary kept its normal (non-canonical) sm, so this is False here,\n        # but mirror it defensively in case that ever changes.\n        alt._uses_canonical_sm = bool(getattr(info, \"_uses_canonical_sm\", False))\n        info.alt = alt\n        self._ensure_frozen_split_alt_staging(name, alt)\n\n    @staticmethod\n    def _compute_canonical_sm(weight):\n        \"\"\"(M,K) row-major all-element sign|mantissa byte: (sign<<7)|mantissa7.\n        Shared verbatim by the zipserv decode and the p4flat alt decode.\"\"\"\n        u16 = weight.contiguous().view(torch.uint16).reshape(-1).to(torch.int32)\n        return (((u16 >> 8) & 0x80) | (u16 & 0x7F)).to(torch.uint8).contiguous()\n\n    def _frozen_split_run_decompress(self, info, src_bufs, ln, output,\n                                          backend_compressor,\n                                          gt_m_base=0, num_row_tiles=-1):\n        \"\"\"Backend-dispatched decompress for one frozen_split tensor.\n\n        ``src_bufs`` is the dict of attr -> tensor that holds the\n        compressed payload (either staging, post-H2D, or — under ATS —\n        the LPDDR hugepage tensor itself).  ``ln`` is the matching\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n#!/usr/bin/env python3\n\"\"\"Split frozen-split weight latency into H2D, resident decode, and total.\n\nBoth codecs are encoded from CPU BF16 weights.  Encode/setup is deliberately\noutside the CUDA-event measurements.  As in production frozen-split storage,\nsign|mantissa remains resident in HBM; CD3 tile exception offsets are resident\ntoo.  Only each codec's LPDDR-side exponent representation is copied per run.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.weight_compress import (\n    _GROUP_DEFS,\n    _build_layer_index,\n    _load_layer,\n    _resolve_inputs,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    ChunkDelta3Compressor,\n    _cd3_ext,\n)\nfrom tiered_serve.compression.core.p4flat import (\n    P4FlatCompressor,\n    _p4f_ext,\n)\n\n\ndef _percentile(values, fraction):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef _measure(stream, operation, warmup, iterations):\n    begin = torch.cuda.Event(enable_timing=True)\n    end = torch.cuda.Event(enable_timing=True)\n\n    def once():\n        with torch.cuda.stream(stream):\n            begin.record(stream)\n            operation()\n            end.record(stream)\n        end.synchronize()\n        return begin.elapsed_time(end)\n\n    for _ in range(warmup):\n        once()\n    return [once() for _ in range(iterations)]\n\n\ndef _prepare(weight, codec_name, stream):\n    \"\"\"CPU-encode and return (h2d, decode, transfer_bytes, output, comp).\"\"\"\n    if codec_name == \"chunk_delta3\":\n        compressor = ChunkDelta3Compressor(stream, stream)\n        comp = compressor.compress(weight)\n        # Pin the complete CPU result once, then split exactly like serving.\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        hbm_offsets = comp.tile_exception_offsets.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.sign_mantissa = hbm_sm\n        native.tile_exception_offsets = hbm_offsets\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _cd3_ext.decompress_chunk_delta3(native, output)\n    else:\n        compressor = P4FlatCompressor(stream)\n        # CPU input selects the host palette/code encoder.  The native call\n        # only stages the completed representation to CUDA; to_host moves it\n        # into the same pinned LPDDR-side form used by frozen_split serving.\n        comp = compressor.compress(weight)\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _p4f_ext.CompressedP4Flat()\n        native.sign_mantissa = hbm_sm\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        native.num_groups = comp.num_groups\n        native.row_major_sm = False\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _p4f_ext.decompress(native, output)\n\n    # cudaMemcpyBatchAsync through the same native helper used by P4Flat's\n    # weight staging.  It is dtype-agnostic and therefore gives both codecs\n    # the same one-dispatch multi-buffer H2D policy.\n    def h2d():\n        _p4f_ext.batch_h2d(sources, destinations)\n\n    def total():\n        h2d()\n        decode()\n\n    transfer_bytes = sum(t.nbytes for t in sources)\n    # Keep all buffers and native structs alive through the timed region.\n    keepalive = (comp, compressor, native, sources, destinations, hbm_sm)\n    if codec_name == \"chunk_delta3\":\n        keepalive += (hbm_offsets,)\n    return h2d, decode, total, transfer_bytes, output, keepalive\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"model\")\n    parser.add_argument(\"--layer\", type=int, default=40)\n    parser.add_argument(\"--group\", default=\"qkv,o,gateup,down\")\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    wanted = [x.strip() for x in args.group.split(\",\") if x.strip()]\n    unknown = [x for x in wanted if x not in _GROUP_DEFS]\n    if unknown:\n        raise ValueError(f\"unknown groups: {unknown}\")\n    shards = _resolve_inputs([args.model])\n    index = _build_layer_index(shards, args.layer)\n    if args.layer not in index:\n        raise ValueError(f\"layer {args.layer} not found\")\n    tensors = _load_layer(index[args.layer])\n    stream = torch.cuda.Stream()\n    rows = []\n    # Keep completed per-group GPU state alive until all groups finish.  The\n    # native P4 batch-copy call is asynchronous and its pybind struct owns the\n    # destination views; retaining them also avoids allocator reuse between\n    # back-to-back 100s-of-MiB projection measurements.\n    retained = []\n\n    print(f\"gpu={torch.cuda.get_device_name(0)} layer={args.layer} \"\n          f\"codec={args.codec} cpu_encode=true\")\n    for group in wanted:\n        roles = _GROUP_DEFS[group]\n        weight = (tensors[roles[0]] if len(roles) == 1 else\n                  torch.cat([tensors[r] for r in roles], dim=0))\n        weight = weight.contiguous()\n        h2d, decode, total, transfer_bytes, output, keepalive = _prepare(\n            weight, args.codec, stream)\n\n        # Populate staging before the resident-decode timing.\n        with torch.cuda.stream(stream):\n            h2d()\n            decode()\n        stream.synchronize()\n\n        h2d_samples = _measure(\n            stream, h2d, args.warmup, args.iterations)\n        decode_samples = _measure(\n            stream, decode, args.warmup, args.iterations)\n        total_samples = _measure(\n            stream, total, args.warmup, args.iterations)\n        with torch.cuda.stream(stream):\n            total()\n        stream.synchronize()\n        exact = torch.equal(\n            output.cpu().view(torch.uint16), weight.view(torch.uint16))\n\n        hm = statistics.median(h2d_samples)\n        dm = statistics.median(decode_samples)\n        tm = statistics.median(total_samples)\n        rows.append((group, hm, dm, tm, transfer_bytes))\n        print(\n            f\"group={group} shape={weight.shape[0]}x{weight.shape[1]} \"\n            f\"transfer_mib={transfer_bytes / 2**20:.3f} \"\n            f\"h2d_min_med_p95={min(h2d_samples):.4f}/{hm:.4f}/\"\n            f\"{_percentile(h2d_samples, .95):.4f} ms \"\n            f\"decode_min_med_p95={min(decode_samples):.4f}/{dm:.4f}/\"\n            f\"{_percentile(decode_samples, .95):.4f} ms \"\n            f\"total_min_med_p95={min(total_samples):.4f}/{tm:.4f}/\"\n            f\"{_percentile(total_samples, .95):.4f} ms bit_exact={exact}\")\n\n        retained.append((output, keepalive))\n        del h2d, decode, total, output, keepalive, weight\n        gc.collect()\n\n    print(\"sum_medians \"\n          f\"h2d={sum(x[1] for x in rows):.4f} \"\n          f\"decode={sum(x[2] for x in rows):.4f} \"\n          f\"total={sum(x[3] for x in rows):.4f} ms \"\n          f\"transfer_mib={sum(x[4] for x in rows) / 2**20:.3f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"duration":{"secs":0,"nanos":3520},"formatted_output":"                comp = self._compressor_for_cell(\n                    layer_id, comp_key, mode=\"frozen_compressed\")\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    comped = comp_data.get(name)\n                    if comped is not None:\n                        comp.decompress(comped)\n                self.frozen_decomp_events[comp_key][layer_id].record(\n                    self.decomp_weight_stream)\n                if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                    self.end_frozen_decomp_timing_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path stays event-light.\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                # WDecomp timing for the split path is recorded tightly\n                # around each _frozen_split_run_decompress kernel below\n                # (AFTER its H2D wait_event), NOT here.  The old coarse\n                # per-comp_key begin/end straddled every tensor's (and\n                # pipelined group's) H2D wait_event, so WDecomp absorbed the\n                # LPDDR->HBM load-wait bubble — already counted in WLoad —\n                # and read ~= GPUFwd while Compute looked tiny.  Per-kernel\n                # intervals are unioned into WDecomp via\n                # frozen_split_decomp_intervals; the load-wait now correctly\n                # surfaces as Stall.  (begin/end_frozen_decomp_events stay\n                # for the frozen_compressed path, which has no separate H2D.)\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    info = split_data.get(name)\n                    if info is None:\n                        continue\n                    staging = self.frozen_split_staging[name][staging_parity]\n                    output = self.frozen_primary_buffer_pair[name][output_parity]\n                    backend_compressor = self._resolve_backend_compressor(\n                        info, layer_id, comp_key)\n\n                    if is_prefill:\n                        # Prefill weight path. Two sub-cases:\n                        #  * Chunk < PREFILL_ALT_MAX_CHUNK WITH an alt codec\n                        #    stored: H2D the compressed exp into alt staging and\n                        #    decode it (less H2D than raw_bf16). The alt is the\n                        #    primary codec reused (unified) or a distinct\n                        #    fast-decode codec (e.g. p4flat).\n                        #  * Larger chunk or no alt: the big GEMM amortises the\n                        #    H2D, so take the raw_bf16 fast path (full BF16 copy,\n                        #    no reconstruct kernel at all).\n                        if (info.alt is not None\n                                and self.cur_num_tokens\n                                < self._alt_max_chunk_for(info.alt.backend)):\n                            alt = info.alt\n                            # Unified alt (same codec as primary) reuses the\n                            # already-resolved concrete compressor — the\n                            # zipserv/dietgpu decode needs its ._ext / workspace\n                            # helpers, which the _AutoWeightCompressor wrapper\n                            # that _get_or_make_backend returns does not expose.\n                            alt_comp = (\n                                backend_compressor\n                                if alt.backend == info.backend\n                                else self._get_or_make_backend(alt.backend))\n                            self._materialize_frozen_split_prefill_alt(\n                                layer_id, name, alt, output, alt_comp)\n                        else:\n                            src = info.lpddr_buffers[\"raw_bf16\"]\n                            # H2D on load_weight_stream (copy stream) so the\n                            # LPDDR→HBM transfer overlaps exec_stream's GEMMs\n                            # instead of blocking the compute stream.\n                            # decomp_weight_stream == exec_stream; the wait\n                            # below ensures frozen_decomp_events recorded on\n                            # decomp_weight_stream (line ~880) fire after the H2D.\n                            with torch.cuda.stream(self.load_weight_stream):\n                                if tb:\n                                    self._frozen_split_h2d_begin_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                                output.view(src.shape).copy_(\n                                    src, non_blocking=True)\n                                if tb:\n                                    self._frozen_split_h2d_end_timing_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                            self.decomp_weight_stream.wait_stream(\n                                self.load_weight_stream)\n            free_by_name = self._frozen_split_alt_staging_free_events = {}\n        h2d_by_name = getattr(\n            self, \"_frozen_split_alt_h2d_done_events\", None)\n        if h2d_by_name is None:\n            h2d_by_name = self._frozen_split_alt_h2d_done_events = {}\n\n        free_events = free_by_name.setdefault(name, [])\n        h2d_events = h2d_by_name.setdefault(name, [])\n        while len(free_events) < self.FROZEN_STAGING_PARITY:\n            free = torch.cuda.Event(external=True)\n            free.record()  # first occupant has no prior decoder to wait for\n            free_events.append(free)\n            h2d_events.append(torch.cuda.Event(external=True))\n\n    def _materialize_frozen_split_prefill_alt(\n            self, layer_id, name, alt, output, alt_comp):\n        \"\"\"Stage one eager-prefill alt weight without blocking compute H2D.\n\n        The wrapper schedules a future NONE-path piece after the current piece\n        has been submitted. Putting only these copies on load_weight_stream lets\n        them overlap that current compute. The H2D-done wait and decoder remain\n        on exec afterwards, ordered before the future component-ready event and\n        consuming GEMM.\n        \"\"\"\n        parity = layer_id % self.FROZEN_STAGING_PARITY\n        alt_staging = self.frozen_split_alt_staging[name][parity]\n        staging_free = self._frozen_split_alt_staging_free_events[name][parity]\n        h2d_done = self._frozen_split_alt_h2d_done_events[name][parity]\n\n        # Do not overwrite this parity slot while its previous P4 decoder is\n        # still reading it.\n        self.load_weight_stream.wait_event(staging_free)\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.load_weight_stream):\n            if tb:\n                self._frozen_split_h2d_begin_event(\n                    layer_id, name).record(self.load_weight_stream)\n            for attr in alt.lpddr_attrs:\n                ne = alt.lpddr_numels[attr]\n                alt_staging[attr][:ne].copy_(\n                    alt.lpddr_buffers[attr], non_blocking=True)\n            if tb:\n                self._frozen_split_h2d_end_timing_event(\n                    layer_id, name).record(self.load_weight_stream)\n            h2d_done.record(self.load_weight_stream)\n\n        # Keep P4 decode and its dense output on exec/current. Moving the decoder\n        # itself would add SM contention and a second cross-stream WAR on the\n        # parity-shared dense primary buffer.\n        self.decomp_weight_stream.wait_event(h2d_done)\n        if tb:\n            self._frozen_split_decomp_begin_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        self._frozen_split_run_decompress(\n            alt, alt_staging, alt.lpddr_numels, output, alt_comp)\n        if tb:\n            self._frozen_split_decomp_end_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        staging_free.record(self.decomp_weight_stream)\n\n    @staticmethod\n    def _parse_prefill_alt_max_chunk(raw, default=None):\n        \"\"\"Parse TIERED_SERVE_PREFILL_ALT_MAX_CHUNK into (per_backend, fallback).\n\n        Accepts a single int (one global override for every codec) or a comma\n        list of \"<codec>=<n>\" entries plus an optional bare int that overrides\n        the default for codecs not explicitly named. Codec