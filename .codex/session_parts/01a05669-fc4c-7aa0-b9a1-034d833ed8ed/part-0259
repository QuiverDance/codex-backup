 # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_