eps that ran any prefill tokens\n+    n_decode = 0                  # decode-only steps\n+    year = window_end.year\n+    try:\n+        with open(server_log, \"r\", errors=\"ignore\") as f:\n+            for line in f:\n+                if \"Schedule Info:\" not in line:\n+                    continue\n+                # Timestamp lives before the \"[scheduler.py:..]\" tag, as\n+                # \"<logger> MM-DD HH:MM:SS\". Find the MM-DD HH:MM:SS pair.\n+                head = line.split(\"[\", 1)[0].split()\n+                ts = None\n+                for i in range(len(head) - 1):\n+                    try:\n+                        ts = datetime.strptime(\n+                            head[i] + \" \" + head[i + 1], \"%m-%d %H:%M:%S\"\n+                        ).replace(year=year)\n+                        break\n+                    except ValueError:\n+                        continue\n+                if ts is None or ts < window_start or ts > window_end:\n+                    continue\n+                info = line.split(\"Schedule Info:\", 1)[1]\n+                pre_bar = info.split(\"|\", 1)[0].split()  # step_idx running waiting\n+                if len(pre_bar) >= 2:\n+                    try:\n+                        batch_sizes.append(int(pre_bar[1]))\n+                    except ValueError:\n+                        pass\n+                prefill_tok = 0\n+                for kv in info.replace(\"|\", \" \").split():\n+                    if kv.startswith(\"prefill_tok=\"):\n+                        try:\n+                            prefill_tok = int(kv.split(\"=\", 1)[1])\n+                        except ValueError:\n+                            prefill_tok = 0\n+                        break\n+                if prefill_tok > 0:\n+                    n_prefill += 1\n+                else:\n+                    n_decode += 1\n+    except OSError:\n+        return None\n+    n_batches = n_prefill + n_decode\n+    if n_batches == 0:\n+        retu