;\n        const uint16_t* irow = in + r * K_b;\n        # re-recording, so the worker always observes the correct (this-step)\n        # H2D completion (no main-thread block, no stale-event hazard).\n        dec_h2d = int(self._kv_dec_h2d[layer_id].cuda_event)\n        # Snapshot the per-step occupancy map at schedule time.  The hook\n        # *replaces* (never mutates) this dict each step, so capturing the\n        # reference here keeps a pipelined late encode reading its own step's\n        # counts even after the next step publishes a new map.\n        bvt = self._block_valid_tokens\n        # One task: the C++ encoder parallelises across blocks with OpenMP\n        # internally (splitting across Python workers would nest the pool x\n        # OMP threads and oversubscribe).\n        with self._slot_state_lock:\n            if layer_id in self._pending_compress:\n                raise RuntimeError(\n                    \"P4Flat CPU KV layer still has a pending task after join: \"\n                    f\"layer={layer_id}\")\n            slots_arr = np.asarray(\n                self._assign_kv_slots(layer_id, bid_arr), dtype=np.int64)\n            # A recompress may overwrite an already-valid row. Make it\n            # unavailable before the worker can start; success republishes\n            # only ids that still own these exact captured slots.\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None:\n                valid_np = np.frombuffer(valid, dtype=np.uint8)\n                valid_np[bid_arr] = 0\n\n            state = self._worker_state_for_layer(layer_id)\n            state['error'] = None\n            state['done'].clear()\n            pending = {\n                'state': state,\n                # Keep the int64 ndarray (no per-layer tolist() on the forward\n                # thread). wait_compress_async consumes it via np.asarray.\n                'buffer_ids': bid_arr,\n                # The async worker writes th