ide is\nkv_cpu_encode.py.\n\nRun from tiered-serve:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmarks/kv_gpu_decode.py [--limit N]\n\"\"\"\nimport argparse\nimport time\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048]            # decodes N of a 2N pool (scatter test needs 2x slots)\n\n\ndef load(n_max):\n    obj = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns):\n    comp = cls(torch.cuda.Stream())\n    pool = 2 * max(ns)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=pool, n_layers=1,\n                           max_gpu_blocks=pool, max_gpu_decomp_blocks=pool)\n    print(f\"  {name}\")\n    for N in ns:\n        # Compress 2N blocks (slots 0..2N-1), then decode N of them two ways:\n        #   contig  = block ids [0..N-1]      -> slots 0..N-1   (sequential reads)\n        #   scatter = block ids [0,2,..,2N-2] -> slots 0,2,..   (paged/fragmented,\n        #             the production pattern where block_table is non-contiguous)\n        # decompress_batch writes output id-indexed (kc[id]=block id), so kc is\n        # sized 2N and we compare/measure only the decoded subset.\n        M = 2 * N\n        comp._kv_active_count[0] = 0; comp._kv_slot[0].fill_(-1)\n        comp.compress_batch_async_from_host(0, list(range(M)), hk[:M].contiguous(),\n                                            hv[:M].contiguous(), 0)\n        comp.wait_compress_async(0, BS)\n        kc = torch.zeros(M, *BS, dtype=torch.bfloat16, device=\"cuda\")\n        vc = torch.zeros_like(kc)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        for label, dids in [(\"contig\", list(range(N))),\n                            (\"scatter\", list(range(0, M, 2)))]:\n            comp.decompress_batch(0, dids, (kc, vc)); torch.cuda.synchronize()\n            sel = torch.tensor(dids)\n            ke = (kc[sel].cpu() - hk[sel]).abs().max().item()\n            ve = (vc[sel].cpu() - hv[sel]).abs().max().item()\n            best = 1e9\n            for _ in range(20):\n                torch.cuda.synchronize(); t0 = time.perf_counter()\n                comp.decompress_batch(0, dids, (kc, vc))\n                torch.cuda.synchronize(); best = min(best, time.perf_counter() - t0)\n            print(f\"     N={N:>4} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\"\n                  f\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\")\n        del kc, vc; torch.cuda.empty_cache()\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--limit\", type=int, default=max(NS))\n    args = ap.parse_args()\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\n    hk, hv = load(2 * max(ns))\n    for cls, name in [(P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\")]:\n        bench(cls, name, hk, hv, ns)\n\n\nif __name__ == \"__main__\":\n    main()\n}\n#else\nstatic inline void p4f_encode_tile(const uint16_t* in, int64_t r0, int64_t c0,\n        int64_t K_b, const int8_t* code_of, uint8_t* tile_code,\n        std::vector<uint32_t>& gi, std::vector<uint16_t>& gv) {\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int c = 0; c < 64; ++c) {\n            uint16_t v = rp[c];\n            int code = code_of[(v >> 7) & 0xFF];\n            if (code < 0) {\n                gi.push_back((uint32_t)((r0 + r) * K_b + (c0 + c)));\n                gv.push_back(v);\n                code = 0;\n            }\n            tile_code[r * 64 + c] = (uint8_t)code;\n        }\n    }\n}\n#endif\n\nvoid p4flat_host_encode_blocks(\n    torch::Tensor src,           // [n_src, M_b, K_b] int16/uint16, CPU contig\n    torch::Tensor block_ids,     // [B] int64 — source-block index per output\n    torch::Tensor slots,         // [B] int64 CPU — destination slot per block\n    torch::Tensor blob,          // [host_n, max_comp] uint8 CPU pool\n    torch::Tensor total_size,    // [host_n] int32 CPU\n    torch::Tensor exc_cnt,       // [host_n] int32 CPU\n    torch::Tensor is_raw,        // [host_n] uint8 CPU\n    torch::Tensor valid_rows_t,  // [host_n] int32 CPU\n    int64_t M_b, int64_t K_b, int64_t valid_tm) {\n    TORCH_CHECK(K_b % 64 == 0 && M_b % 64 == 0, \"M_b,K_b must be /64\");\n    const int64_t ntk = K_b / 64;\n    const int64_t ntm = M_b / 64;\n    if (valid_tm < 1) valid_tm = 1;\n    if (valid_tm > ntm) valid_tm = ntm;\n    const int64_t valid_rows = valid_tm * 64;\n    const int64_t hb_v = valid_tm * ntk * 16;\n    const int64_t cb_v = valid_rows * K_b / 2;\n    const int64_t smb_v = valid_rows * K_b;\n    const int64_t cdb_v = (valid_rows / 16) * (K_b / 16);\n    const int64_t fixed = hb_v + cb_v + smb_v + cdb_v;\n    const int64_t raw_v = valid_rows * K_b * 2;\n    const int64_t block_numel = M_b * K_b;\n    const int64_t B = slots.numel();\n\n    // Read source blocks directly by id (no host-side gather copy): the input\n    // block for output b is src[block_ids[b]].\n    const uint16_t* in_base =\n        reinterpret_cast<const uint16_t*>(src.data_ptr());\n    const int64_t* bid_p = block_ids.data_ptr<int64_t>();\n    uint8_t* blob_base = reinterpret_cast<uint8_t*>(blob.data_ptr());\n    const int64_t row_stride = blob.stride(0);\n    const int64_t* slot_p = slots.data_ptr<int64_t>();\n    int32_t* tot_p = total_size.data_ptr<int32_t>();\n    int32_t* ec_p = exc_cnt.data_ptr<int32_t>();\n    uint8_t* raw_p = is_raw.data_ptr<uint8_t>();\n    int32_t* vr_p = valid_rows_t.data_ptr<int32_t>();\n\n    py::gil_scoped_release no_gil;\n    #pragma omp parallel for schedule(static)\n    for (int64_t b = 0; b < B; ++b) {\n        const uint16_t* in = in_base + bid_p[b] * block_numel;\n        const int64_t slot = slot_p[b];\n        uint8_t* row = blob_base + slot * row_stride;\n        uint8_t* hdr = row;\n        uint8_t* codes = row + hb_v;\n        uint8_t* sm = row + hb_v + cb_v;\n        uint8_t* subt = sm + smb_v;\n\n        std::vector<uint32_t> gi;\n        std::vector<uint16_t> gv;\n        int counts[256];                              // exponent histogram\n        uint8_t nz_e[256]; int nz_c[256];             // nonzero exp buckets\n        int8_t code_of[256];\n        uint8_t tile_code[64 * 64];\n\n        for (int64_t tm = 0; tm < valid_tm; ++tm) {\n            for (int64_t tk = 0; tk < ntk; ++tk) {\n                const int64_t ti = tm * ntk + tk;\n                const int64_t r0 = tm * 64, c0 = tk * 64;\n                // SVE2-vectorised 256-bin exponent histogram (byte-exact).\n                p4f_hist64(in, r0, c0, K_b, counts);\n                // Collect nonzero exponent buckets (exp ascending) so the top-16\n                // selection scans the ~20-40 distinct exps, not all 256.\n                int nnz = 0;\n                for (int e = 0; e < 256; ++e)\n                    if (counts[e] > 0) {\n                        nz_e[nnz] = (uint8_t)e; nz_c[nnz] = counts[e]; ++nnz;\n                    }\n                for (int i = 0; i < 256; ++i) code_of[i] = -1;\n                // top-16 by freq (ties -> lowest exp, preserved by exp-asc order).\n                int npal = nnz < 16 ? nnz : 16;\n                for (int p = 0; p < npal; ++p) {\n                    int best = 0, bestc = nz_c[0];\n                    for (int j = 1; j < nnz; ++j)\n                        if (nz_c[j] > bestc) { bestc = nz_c[j]; best = j; }\n                    hdr[ti * 16 + p] = nz_e[best];\n                    code_of[nz_e[best]] = (int8_t)p;\n                    nz_c[best] = -1;\n                }\n                // <16 distinct exps: fill the rest with the lowest unused exps —\n                // byte-identical to the original 256-scan's zero-count fill.\n                for (int p = npal, e = 0; p < 16; ++p, ++e) {\n                    while (code_of[e] >= 0) ++e;\n                    hdr[ti * 16 + p] = (uint8_t)e;\n                    code_of[e] = (int8_t)p;\n                }\n                p4f_encode_tile(in, r0, c0, K_b, code_of, tile_code, gi, gv);\n                // pack 4-bit codes -> tile-blocked [bk(4), row(64), byte(8)]\n                uint8_t* tc = codes + ti * 2048;\n                for (int bk = 0; bk < 4; ++bk)\n                    for (int r = 0; r < 64; ++r) {\n                        const uint8_t* s = tile_code + r * 64 + bk * 16;\n                        uint8_t* d = tc + bk * 512 + r * 8;\n                        for (int j = 0; j < 8; ++j)\n                            d[j] = (s[2 * j] & 0xF) | ((s[2 * j + 1] & 0xF) << 4);\n                    }\n            }\n        }\n        // sign|mantissa, row-major over the valid rows\n        for (int64_t i = 0; i < smb_v; ++i) {\n            uint16_t v = in[i];\n            sm[i] = (uint8_t)((((v >> 15) & 1) << 7) | (v & 0x7F));\n        }\n        std::memset(subt, 0xFF, cdb_v);\n\n        const int64_t cnt = (int64_t)gi.size();\n        const int64_t total = fixed + cnt * 6;\n        // The blob ROW is row_stride bytes; never write past it.  Tight-stride\n        // pools deliberately make row_stride < raw_v so the common compressed\n        // case transfers fewer bytes.  A high-exception block can fit neither\n        // compressed nor raw in that row.  cpu_after_raw_swap already retains\n        // the authoritative raw block in secondary KV, so publish is_raw=2 and\n        // store no blob; the dense and fused decode paths restore that block\n        // from secondary instead of treating the tight row as corrupt.\n        if (total <= row_stride) {\n            uint8_t* ep = subt + cdb_v;\n            std::memcpy(ep, gi.data(), (size_t)cnt * 4);\n            std::memcpy(ep + cnt * 4, gv.data(), (size_t)cnt * 2);\n            tot_p[slot] = (int32_t)total;\n            ec_p[slot] = (int32_t)cnt;\n            raw_p[slot] = 0;\n        } else if (raw_v <= row_stride) {\n            std::memcpy(row, in, (size_t)raw_v);   // raw fallback (valid rows)\n            tot_p[slot] = (int32_t)raw_v;\n            ec_p[slot] = 0;\n            raw_p[slot] = 1;\n        } else {\n            tot_p[slot] = 0;\n            ec_p[slot] = 0;\n            raw_p[slot] = 2;  // restore from raw secondary KV during decode\n        }\n        vr_p[slot] = (int32_t)valid_rows;\n    }\n}\n\n// ─── TILE-PARALLEL variant of p4flat_host_encode_blocks ──────────────────\n// Byte-identical output, but the OpenMP parallelism is over (block x tile)\n// instead of over blocks only.  The block-parallel original starves when B <\n// thread count (e.g. weights: a few large blocks); tiles within a block are\n// independent (per-tile palette/codes/exceptions, fixed blob offsets), so\n// parallelising over B*TILES keeps every thread busy regardless of B.  The\n// only per-block serial bits — exception concatenation (in tile order, so the\n// blob stays identical), raw fallback and meta — run in a tiny phase-3 loop.\nvoid p4flat_host_encode_blocks_tp(\n    torch::Tensor src, torch::Tensor block_ids, torch::Tensor slots,\n    torch::Tensor blob, torch::Tensor total_size, torch::Tensor exc_cnt,\n    torch::Tensor is_raw, torch::Tensor valid_rows_t,\n    int64_t M_b, int64_t K_b, int64_t valid_tm) {\n    TORCH_CHECK(K_b % 64 == 0 && M_b % 64 == 0, \"M_b,K_b must be /64\");\n    const int64_t ntk = K_b / 64;\n    const int64_t ntm = M_b / 64;\n    if (valid_tm < 1) valid_tm = 1;\n    if (valid_tm > ntm) valid_tm = ntm;\n    const int64_t valid_rows = valid_tm * 64;\n    const int64_t hb_v = valid_tm * ntk * 16;\n    const int64_t cb_v = valid_rows * K_b / 2;\n    const int64_t smb_v = valid_rows * K_b;\n    const int64_t cdb_v = (valid_rows / 16) * (K_b / 16);\n    const int64_t fixed = hb_v + cb_v + smb_v + cdb_v;\n    const int64_t raw_v = valid_rows * K_b * 2;\n    const int64_t block_numel = M_b * K_b;\n    const int64_t B = slots.numel();\n    const int64_t TILES = valid_tm * ntk;\n\n    const uint16_t* in_base =\n        reinterpret_cast<const uint16_t*>(src.data_ptr());\n    const int64_t* bid_p = block_ids.data_ptr<int64_t>();\n    uint8_t* blob_base = reinterpret_cast<uint8_t*>(blob.data_ptr());\n    const int64_t row_stride = blob.stride(0);\n    const int64_t* slot_p = slots.data_ptr<int64_t>();\n    int32_t* tot_p = total_size.data_ptr<int32_t>();\n    int32_t* ec_p = exc_cnt.data_ptr<int32_t>();\n    uint8_t* raw_p = is_raw.data_ptr<uint8_t>();\n    int32_t* vr_p = valid_rows_t.data_ptr<int32_t>();\n\n    // Per-tile exception buffers (empty for the common no-exception tile).\n    std::vector<std::vector<uint32_t>> t_gi((size_t)(B * TILES));\n    std::vector<std::vector<uint16_t>> t_gv((size_t)(B * TILES));\n    py::gil_scoped_release no_gil;\n\n    // Phase 1: per (block, tile) — headers, 4-bit codes, per-tile exceptions.\n    #pragma omp parallel for schedule(static)\n    for (int64_t u = 0; u < B * TILES; ++u) {\n        const int64_t b = u / TILES, ti = u % TILES;\n        const int64_t tm = ti / ntk, tk = ti % ntk;\n        const uint16_t* in = in_base + bid_p[b] * block_numel;\n        uint8_t* row = blob_base + slot_p[b] * row_stride;\n        uint8_t* hdr = row;\n        uint8_t* codes = row + hb_v;\n        const int64_t r0 = tm * 64, c0 = tk * 64;\n        int counts[256];\n        int8_t code_of[256];\n        uint8_t tile_code[64 * 64];