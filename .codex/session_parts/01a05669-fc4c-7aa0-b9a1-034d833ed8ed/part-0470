ONS\n#!/usr/bin/env python3\n\"\"\"Split frozen-split weight latency into H2D, resident decode, and total.\n\nBoth codecs are encoded from CPU BF16 weights.  Encode/setup is deliberately\noutside the CUDA-event measurements.  As in production frozen-split storage,\nsign|mantissa remains resident in HBM; CD3 tile exception offsets are resident\ntoo.  Only each codec's LPDDR-side exponent representation is copied per run.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.weight_compress import (\n    _GROUP_DEFS,\n    _build_layer_index,\n    _load_layer,\n    _resolve_inputs,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    ChunkDelta3Compressor,\n    _cd3_ext,\n)\nfrom tiered_serve.compression.core.p4flat import (\n    P4FlatCompressor,\n    _p4f_ext,\n)\n\n\ndef _percentile(values, fraction):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef _measure(stream, operation, warmup, iterations):\n    begin = torch.cuda.Event(enable_timing=True)\n    end = torch.cuda.Event(enable_timing=True)\n\n    def once():\n        with torch.cuda.stream(stream):\n            begin.record(stream)\n            operation()\n            end.record(stream)\n        end.synchronize()\n        return begin.elapsed_time(end)\n\n    for _ in range(warmup):\n        once()\n    return [once() for _ in range(iterations)]\n\n\ndef _prepare(weight, codec_name, stream):\n    \"\"\"CPU-encode and return (h2d, decode, transfer_bytes, output, comp).\"\"\"\n    if codec_name == \"chunk_delta3\":\n        compressor = ChunkDelta3Compressor(stream, stream)\n        comp = compressor.compress(weight)\n        # Pin the complete CPU result once, then split exactly like serving.\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        hbm_offsets = comp.tile_exception_offsets.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.sign_mantissa = hbm_sm\n        native.tile_exception_offsets = hbm_offsets\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _cd3_ext.decompress_chunk_delta3(native, output)\n    else:\n        compressor = P4FlatCompressor(stream)\n        # CPU input selects the host palette/code encoder.  The native call\n        # only stages the completed representation to CUDA; to_host moves it\n        # into the same pinned LPDDR-side form used by frozen_split serving.\n        comp = compressor.compress(weight)\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _p4f_ext.CompressedP4Flat()\n        native.sign_mantissa = hbm_sm\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        native.num_groups = comp.num_groups\n        native.row_major_sm = False\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _p4f_ext.decompress(native, output)\n\n    # cudaMemcpyBatchAsync through the same native helper used by P4Flat's\n    # weight staging.  It is dtype-agnostic and therefore gives both codecs\n    # the same one-dispatch multi-buffer H2D policy.\n    def h2d():\n        _p4f_ext.batch_h2d(sources, destinations)\n\n    def total():\n        h2d()\n        decode()\n\n    transfer_bytes = sum(t.nbytes for t in sources)\n    # Keep all buffers and native structs alive through the timed region.\n    keepalive = (comp, compressor, native, sources, destinations, hbm_sm)\n    if codec_name == \"chunk_delta3\":\n        keepalive += (hbm_offsets,)\n    return h2d, decode, total, transfer_bytes, output, keepalive\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"model\")\n    parser.add_argument(\"--layer\", type=int, default=40)\n    parser.add_argument(\"--group\", default=\"qkv,o,gateup,down\")\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    wanted = [x.strip() for x in args.group.split(\",\") if x.strip()]\n    unknown = [x for x in wanted if x not in _GROUP_DEFS]\n    if unknown:\n        raise ValueError(f\"unknown groups: {unknown}\")\n    shards = _resolve_inputs([args.model])\n    index = _build_layer_index(shards, args.layer)\n    if args.layer not in index:\n        raise ValueError(f\"layer {args.layer} not found\")\n    tensors = _load_layer(index[args.layer])\n    stream = torch.cuda.Stream()\n    rows = []\n    # Keep completed per-group GPU state alive until all groups finish.  The\n    # native P4 batch-copy call is asynchronous and its pybind struct owns the\n    # destination views; retaining them also avoids allocator reuse between\n    # back-to-back 100s-of-MiB projection measurements.\n    retained = []\n\n    print(f\"gpu={torch.cuda.get_device_name(0)} layer={args.layer} \"\n          f\"codec={args.codec} cpu_encode=true\")\n    for group in wanted:\n        roles = _GROUP_DEFS[group]\n        weight = (tensors[roles[0]] if len(roles) == 1 else\n                  torch.cat([tensors[r] for r in roles], dim=0))\n        weight = weight.contiguous()\n        h2d, decode, total, transfer_bytes, output, keepalive = _prepare(\n            weight, args.codec, stream)\n\n        # Populate staging before the resident-decode timing.\n        with torch.cuda.stream(stream):\n            h2d()\n            decode()\n        stream.synchronize()\n\n        h2d_samples = _measure(\n            stream, h2d, args.warmup, args.iterations)\n        decode_samples = _measure(\n            stream, decode, args.warmup, args.iterations)\n        total_samples = _measure(\n            stream, total, args.warmup, args.iterations)\n        with torch.cuda.stream(stream):\n            total()\n        stream.synchronize()\n        exact = torch.equal(\n            output.cpu().view(torch.uint16), weight.view(torch.uint16))\n\n        hm = statistics.median(h2d_samples)\n        dm = statistics.median(decode_samples)\n        tm = statistics.median(total_samples)\n        rows.append((group, hm, dm, tm, transfer_bytes))\n        print(\n            f\"group={group} shape={weight.shape[0]}x{weight.shape[1]} \"\n            f\"transfer_mib={transfer_bytes / 2**20:.3f} \"\n            f\"h2d_min_med_p95={min(h2d_samples):.4f}/{hm:.4f}/\"\n            f\"{_percentile(h2d_samples, .95):.4f} ms \"\n            f\"decode_min_med_p95={min(decode_samples):.4f}/{dm:.4f}/\"\n            f\"{_percentile(decode_samples, .95):.4f} ms \"\n            f\"total_min_med_p95={min(total_samples):.4f}/{tm:.4f}/\"\n            f\"{_percentile(total_samples, .95):.4f} ms bit_exact={exact}\")\n\n        retained.append((output, keepalive))\n        del h2d, decode, total, output, keepalive, weight\n        gc.collect()\n\n    print(\"sum_medians \"\n          f\"h2d={sum(x[1] for x in rows):.4f} \"\n          f\"decode={sum(x[2] for x in rows):.4f} \"\n          f\"total={sum(x[3] for x in rows):.4f} ms \"\n          f\"transfer_mib={sum(x[4] for x in rows) / 2**20:.3f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06be1-18a5-78a2-b543-38190b7d0bd3","create_time":1788517855.863378}},{"type":"reasoning","id":"rs_0cbf047068a7e973016a9a9de1c5d087d283e1fe7133c13006","summary":[],"encrypted_content":"gAAAAABqmp3mJ7Xtzvo7U6T2dSkvoWVP-s9JeZtLhJWjKEddUoll9fRcZ1NZ2QdWWGuU0dKDlJK-dZGiXui_-TFrbfuNI54jMPMUgvmxOUbVC6mMZdSapRDkQHk-SDN5MiRlGFYF-hz5YZrhBgCWKiFXR_CfBDrPL9PjfrTbik28IqcltRxinkV74oF5tLmsfzfy--OrR1nj0ayJY9H9ySyqgGSfIKbaK6iN6x5EU_rYcIxmhydlAV0z6GTiSLrkGftQx9xLy8RECI4nbDEQcXphOXH08vg7X656638gxn7ZL6JMek5FzT7_xZglzEhCWH0nyQn4e2un-139Vs_DpJCnNlIGr26N2e3WztnzDx9XsUsudxgpNJYnse4pzgNKPP2_EU-O2dbgAWnQLApqFrDrWS82PHOHudONVOXE3n09gQ0SR-0s3rFVGdSVraVsfl9PD5jyDVqchx58apbMHXTFRqYA12oWsad1921htqLYNLJBY6fuP82z2vAzgL7PZM3iLqUA5QgXGHKJQLQOWYtj5AVVKZmzzlxEJxl4z_bL5ZycGuKInbEVRg6_hQv3x4gMfranytEQXDsQZtPdgIYmQ7xRCuUfJ59_2ZGbELncFHwVKrC1bPRgAawt8A7k_j05KfMFHhi9qqqMXIKIuAJAdkanajhNhu3g3TIqiwaviNquf5KRAvTwg-lNLK78lKb1pFcYFstBPj6gaTIiG7Yl4aDW0qVVFTgFfqCWiAaY5lozBrVHR957ZEYVv-wZeX9B1YxJmm7RLy8CY5KpEaWmBdJIvsHp-FZghMoTCNYmeIznfjfrpcKFrBZX4DIwjcNIpZZCcUB5O-473pOaFBC8QXB7R6VAF32naFq5Ev9R6eAlJSd-qqoQ3xV5wC_DrzLx4wqHmu7wWQiFDIImeU7CirQFfup7FiONNrYsvqm1gt_b2UP_8JJYLabaBEPBQlv4l6dVBssXfkmahZw2Hd2yWV4Gq4lsQvpqDsDWdZ6ZDaM4gt2fsZBfswiPw9Mkon1fb4evUqjRk_bBZr1LCdaNyxqI9rnQo019oKzPsF5FFfEEzuZybAuU0BVBi2Cj2BqNj9CzLmk7SjEE_y9MewnW0ppc_p5k9o6mckUBuhYtHwDDFPbqRpMX_eGOHjHIfZ7q-fToqG_rU2CNC1jTisHh9-3V_wQLRnWM2pIi7wu6jkX9ZrIZqi2Xgbejiau9ktS8k2r_nuKyuJg_Q_5jrNRnBBZRrZfcuKbJkHFZ-A7_TYg9SUg7JsjF1IvKh703CV3WFqUkyybg5j2PK8aqx_nHQXJKUvh_RNdeBW1Oi7GryOynRToriyfRoqW7hda