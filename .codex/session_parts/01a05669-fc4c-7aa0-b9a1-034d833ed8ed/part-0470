t, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    parser.add_argument(\n        \"--cycle-input\", action=\"store_true\",\n        help=\"cycle the saved real-KV sample when --blocks exceeds its size\")\n    args = parser.parse_args()\n\n    codec_type = (ChunkDelta3KVCompressor\n                  if args.codec == \"chunk_delta3\"\n                  else P4FlatCPUKVCompressor)\n    host_k, host_v = load_blocks(args.path, args.blocks, args.cycle_input)\n    compressor = codec_type(torch.cuda.Stream())\n    compressor.warmup_kv_buffers(\n        block_shape=BLOCK_SHAPE, max_n_blocks=args.blocks,\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0,