} hbm=${hbm_used}MiB util=${gpu_util}% hugepages=${hp_free}/${hp_total}\"\n  return 0\n}\n\nwait_for_clean_state() {\n  local context=\"$1\"\n  local deadline=$((SECONDS + CLEANUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ! capture_clean_state; do\n    if ((SECONDS >= deadline)); then\n      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n      next_report=$((SECONDS + 15))\n    fi\n    sleep 2\n  done\n  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n}\n\nsanitize_id() {\n  local value=\"$1\"\n  value=\"${value//./p}\"\n  value=\"${value//\\//_}\"\n  printf '%s' \"$value\"\n}\n\nquote_command() {\n  printf '%q ' \"$@\"\n  printf '\\n'\n}\n\nCMD=()\nbuild_server_command() {\n  local mode=\"$1\"\n  local chunk=\"$2\"\n  local config\n  local -a mode_args=()\n  local -a breakdown_args=()\n\n  if [[ \"$mode\" == kvcomp ]]; then\n    config=\"$KVCOMP_CONFIG\"\n    mode_args=(--kv-comp \"$KV_BACKEND\")\n  else\n    config=\"$RAW_CONFIG\"\n  fi\n  if ((BREAKDOWN)); then\n    # Serving calls the detailed per-forward breakdown mode --collect-time.\n    # It records both the legacy timing line and the granular [Breakdown] line.\n    breakdown_args=(--collect-time)\n  fi\n\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n    \"LD_PRELOAD=${STACK_POOL_SO}\"\n    \"VLLM_DISABLE_COMPILE_CACHE=1\"\n    \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\"\n    \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n    \"TIERED_SERVE_N_WEIGHT_BUFFERS=${WEIGHT_BUFFERS}\"\n    \"TIERED_SERVE_DEDICATED_KV_BLOCKS=${DEDICATED_KV_BLOCKS}\"\n    \"TIERED_SERVE_GPU_RESERVE_GIB=${GPU_RESERVE_GIB}\"\n    \"TIERED_SERVE_KV_ADDR_ORDER=${KV_ADDR_ORDER}\"\n    \"TIE