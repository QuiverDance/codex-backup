  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  grep -Eq 'compressor:[[:space:]]*p4flat' \"$RAW_CONFIG\" 2>/dev/null || problems+=(\"raw-config-is-not-p4flat=${RAW_CONFIG}\")\n  grep -Eq 'compressor:[[:space:]]*p4flat' \"$KVCOMP_CONFIG\" 2>/dev/null || problems+=(\"kvcomp-config-is-not-p4flat=${KVCOMP_CONFIG}\")\n\n  if ((${#problems[@]})); then\n    printf '[suite] ERROR: preflight failed: %s\\n' \"$(IFS='; '; echo \"${problems[*]}\")\" >&2\n    return 1\n  fi\n  fi\n}\n\nmapfile -t INHERITED_TIERED_ENV < <(compgen -e | awk '/^TIERED_SERVE_/ { print }' | sort)\nCLEAN_ENV=(env -u LD_PRELOAD -u RESULT_DIR -u CUDA_VISIBLE_DEVICES \\\n  -u VLLM_DISABLE_COMPILE_CACHE -u PYTORCH_CUDA_ALLOC_CONF)\nfor inherited_var in \"${INHERITED_TIERED_ENV[@]}\"; do\n  CLEAN_ENV+=(-u \"$inherited_var\")\ndone\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type port_hex\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+=(\"nvidia-smi-query-failed\")\n    gpu_line=\",\"\n  fi\n  IFS=',' read -r hbm_used gpu_util <<<\"$gpu_line\"\n  if [[ ! \"$hbm_used\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-hbm=${hbm_used:-empty}\")\n  elif ((hbm_used > MAX_I