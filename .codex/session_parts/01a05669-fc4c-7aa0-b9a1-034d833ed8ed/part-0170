\\\",\\n                        default=None,\\n                        metavar=\\\"N|MAP\\\",\\n                        help=\\\"Override the prefill-alt chunk threshold: a single \\\"\\n                             \\\"int (one threshold for every codec) or a per-codec \\\"\\n                             \\\"map 'p4flat=1330,zipserv=830,...'. Unset uses the \\\"\\n                             \\\"calibrated built-in per-codec defaults \\\"\\n                             \\\"(see runs/bench_prefill_alt_crossover.py). Sets \\\"\\n                             \\\"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK.\\\")\\n    parser.add_argument(\\\"--offload-prefill-max-chunk\\\",\\n                        default=None,\\n                        metavar=\\\"N|MAP\\\",\\n                        help=\\\"Phase-adaptive prefill for OFFLOAD_COMPRESSED \\\"\\n                             \\\"weights (distinct from --prefill-alt-*, which is \\\"\\n                             \\\"frozen_split). Prefill chunks below this threshold \\\"\\n                             \\\"decode the compressed LPDDR copy (less H2D) \\\"\\n                             \\\"instead of H2D'ing the uncompressed one; larger \\\"\\n                             \\\"chunks keep uncompressed. Single int or per-codec \\\"\\n                             \\\"map 'zipserv=600,...'. Lossless codecs only; OFF by \\\"\\n                             \\\"default. Sets TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK.\\\")\\n    parser.add_argument(\\\"--fused-mm\\\",\\n                        action=\\\"store_true\\\",\\n                        help=\\\"Request the weight compressor's \\\"\\n                             \\\"decompress+GEMM execution path. An override is \\\"\\n                             \\\"installed only for compressor/residency pairs \\\"\\n                             \\\"that support it; other cells keep dense \\\"\\n                             \\\"decompress+matmul. P4Flat frozen_compressed and \\\"\\n                             \\\"frozen_split install overrides, while P4Flat \\\"\\n                             \\\"offload_compressed keeps the dense path. This \\\"\\n                             \\\"flag does not enable weight compression.\\\")\\n    parser.add_argument(\\\"--ats-decomp-frozen\\\",\\n                        action=\\\"store_true\\\",\\n                        help=\\\"frozen_split decode reads compressed bytes \\\"\\n                             \\\"directly from LPDDR via host-mapped UVA, \\\"\\n                             \\\"skipping the H2D copy into GPU staging. \\\"\\n                             \\\"Recommended on GH200.\\\")\\n    parser.add_argument(\\\"--ats-decomp-offload\\\",\\n                        action=\\\"store_true\\\",\\n                        help=\\\"offload_compressed load+decompress reads \\\"\\n                             \\\"compressed bytes directly from LPDDR via \\\"\\n                             \\\"host-mapped UVA, skipping the H2D copy \\\"\\n                             \\\"into GPU staging. Recommended on GH200.\\\")\\n    parser.add_argument(\\\"--kv-comp\\\",\\n                        nargs=\\\"?\\\",\\n                        const=\\\"zipserv\\\",\\n                        default=None,\\n                        choices=[\\\"zipserv\\\", \\\"dietgpu\\\", \\\"mantexp\\\", \\\"p4flat\\\",\\n                                 \\\"p4flatcpu\\\", \\\"ublb_flat\\\", \\\"ublb_tbe\\\"],\\n                        help=\\\"Enable KV Compression. Optional value selects \\\"\\n                             \\\"backend (default: zipserv when flag is given \\\"\\n                             \\\"without value). 'zipserv' uses the accelerated \\\"\\n                             \\\"C++ CPU worker pool after raw KV is swapped to \\\"\\n                             \\\"host memory. 'mantexp' selects the \\\"\\n                             \\\"sign+mantissa / compressed-exponent split \\\"\\n                             \\\"backend (equivalent to --mantexp-split-kv). \\\"\\n                             \\\"'p4flat' selects the BF16 P4-flat per-tile \\\"\\n        os.environ[\\\"TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK\\\"] = args.offload_prefill_max_chunk\\n    os.environ[\\\"TIERED_SERVE_USE_FUSED_MM\\\"] = (\\n        \\\"1\\\" if args.fused_mm else \\\"0\\\")\\n    # NEVER reuse a compiled/cudagraph cache.  The tiered-serve runtime flags\\n    # (--fused-mm, --kv-comp, residency config) change the traced graph but are\\n    # NOT part of vLLM's torch.compile cache key, so a stale cached graph from a\\n    # prior run with different flags would be silently reused → wrong weights /\\n    # IMA.  Force a fresh compile every run (skips both cache load and save).\\n    os.environ[\\\"VLLM_DISABLE_COMPILE_CACHE\\\"] = \\\"1\\\"\\n    os.environ[\\\"TIERED_SERVE_ATS_DECOMP_FROZEN\\\"] = (\\n        \\\"1\\\" if args.ats_decomp_frozen else \\\"0\\\")\\n    os.environ[\\\"TIERED_SERVE_ATS_DECOMP_OFFLOAD\\\"] = (\\n        \\\"1\\\" if args.ats_decomp_offload else \\\"0\\\")\\n    os.environ[\\\"TIERED_SERVE_USE_KV_COMP\\\"] = \\\"1\\\" if args.kv_comp else \\\"0\\\"\\n    if args.kv_comp:\\n        os.environ[\\\"TIERED_SERVE_KV_COMP_BACKEND\\\"] = args.kv_comp\\n        # Keep an offloadable block's partial tail in a request-private HBM\\n        # slot and publish/compress it only after all 16 tokens are written.\\n        # Cache the choice before model/KV allocation; the serving hot path\\n        # never reads this environment variable.  Set it to 0 for a legacy\\n        # same-code A/B run.\\n        if args.kv_comp in (\\\"p4flat\\\", \\\"p4flatcpu\\\"):\\n            os.environ.setdefault(\\n                \\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"1\\\")\\n        if args.kv_comp == \\\"zipserv\\\":\\n            # ``--kv-comp zipserv`` is an explicit request for the accelerated\\n            # host encoder.  Overwrite a stale inherited producer setting so\\n            # serving always runs raw D2H -> C++ CPU worker compression.\\n            os.environ[\\\"TIERED_SERVE_KV_COMP_PRODUCER\\\"] = \\\\\\n                \\\"cpu_after_raw_swap\\\"\\n        # P4Flat/UBLB own the tight 25,600-byte default and their encoders\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05786-3ba1-7b13-a968-6043bd7438ba","create_time":1788174967.2872531}}}
