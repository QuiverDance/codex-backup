 2 && source.size(0) > 0\n                    && source.numel() == source.size(0) * block_elements,\n                \"source shape is incompatible with rows*columns\");\n    const int64_t tiles_per_block =\n        (rows / kTileDim) * (columns / kTileDim);\n    const int64_t code_bytes = tiles_per_block * kCodeBytesPerTile;\n    const int64_t base_bytes = tiles_per_block * kThreads;\n    const int64_t host_slots = codes.size(0);\n\n    auto check_cpu_byte_2d = [host_slots](\n            const torch::Tensor& tensor, int64_t width, const char* name) {\n        TORCH_CHECK(!tensor.is_cuda()\n                        && tensor.scalar_type() == at::kByte\n                        && tensor.dim() == 2\n                        && tensor.size(0) == host_slots\n                        && tensor.size(1) == width\n                        && tensor.stride(1) == 1\n                        && tensor.stride(0) >= width,\n                    \"invalid host ChunkDelta3 \", name, \" buffer\");\n    };\n    check_cpu_byte_2d(codes, code_bytes, \"codes\");\n    check_cpu_byte_2d(\n        sign_mantissa, block_elements, \"sign_mantissa\");\n    check_cpu_byte_2d(thread_bases, base_bytes, \"thread_bases\");\n    TORCH_CHECK(!tile_exception_offsets.is_cuda()\n                    && tile_exception_offsets.scalar_type() == at::kInt\n                    && tile_exception_offsets.dim() == 2\n                    && tile_exception_offsets.size(0) == host_slots\n                    && tile_exception_offsets.size(1)\n                        == tiles_per_block + 1\n                    && tile_exception_offsets.stride(1) == 1\n                    && tile_exception_offsets.stride(0)\n                        >= tiles_per_block + 1,\n                \"invalid host ChunkDelta3 tile_exception_offsets buffer\");\n    TORCH_CHECK(!entries20x3.is_cuda()\n                    && entries20x3.scalar_type() == at::kLong\n                    && entries20x3.dim() == 2\n                    && entries20x3.size(0) ==