 offset_stride = tile_exception_offsets.stride(0);\n    const int64_t entry_stride = entries20x3.stride(0);\n    const int64_t count_stride = num_exceptions.stride(0);\n    const int tiles_per_row = static_cast<int>(columns / kTileDim);\n\n    py::gil_scoped_release no_gil;\n#pragma omp parallel for schedule(static)\n    for (int64_t block = 0; block < blocks; ++block) {\n        const int64_t source_block = bid_ptr[block];\n        const int64_t destination_slot = slot_ptr[block];\n        int32_t* offsets = offset_out\n            + destination_slot * offset_stride;\n        uint64_t* destination = entry_out\n            + destination_slot * entry_stride;\n        int32_t total = 0;\n\n        // A single OpenMP owner completes one block.  This preserves the\n        // tile/thread/item exception order without prefix buffers or barriers\n        // and reads every source value only once.\n        for (int tile = 0; tile < tiles_per_block; ++tile) {\n            offsets[tile] = total;\n            const int tile_row = tile / tiles_per_row;\n            const int tile_column = tile - tile_row * tiles_per_row;\n            for (int thread = 0; thread < kThreads; ++thread) {\n                const int local_row = thread >> 2;\n                const int column_group = thread & 3;\n                const int64_t source_base =\n                    source_block * block_elements\n                    + static_cast<int64_t>(\n                        tile_row * kTileDim + local_row) * columns\n                    + tile_column * kTileDim\n                    + column_group * 16;\n\n                uint16_t values[16];\n                alignas(16) uint8_t exponents[16];\n#if defined(__aarch64__)\n                const uint16x8_t values_lo =\n                    vld1q_u16(input + source_base);\n                const uint16x8_t values_hi =\n                    vld1q_u16(input + source_base + 8);\n                const uint8x16_t exponent_vector = vcombine_u8(\n                   