two uint64 accumulators\n * live lets ptxas schedule each half independently while each ulonglong2\n * assignment still emits one 128-bit global store. */\ntemplate<int Start>\n__device__ __forceinline__ void decode_and_store_half(\n    uint64_t code_word,\n    const uint4& sm,\n    uint8_t base,\n    ulonglong2* destination)\n{\n    uint64_t output0 = 0;\n    uint64_t output1 = 0;\n#pragma unroll\n    for (int offset = 0; offset < 8; ++offset) {\n        const int item = Start + offset;\n        const uint8_t code =\n            static_cast<uint8_t>((code_word >> (item * 3)) & 7u);\n        const uint16_t value = compose_bf16(\n            static_cast<uint8_t>(base + code),\n            sign_mantissa_byte(sm, item));\n        const int lane = offset & 3;\n        if (offset < 4) {\n            output0 |= static_cast<uint64_t>(value) << (lane * 16);\n        } else {\n            output1 |= static_cast<uint64_t>(value) << (lane * 16);\n        }\n    }\n    *destination = make_ulonglong2(output0, output1);\n}\n\n__global__ __launch_bounds__(kDecodeThreads, 8)\nvoid DecompressChunkDelta3Kernel(\n    const uint8_t* __restrict__ codes,\n    const uint8_t* __restrict__ sign_mantissa,\n    const uint8_t* __restrict__ thread_bases,\n    const int32_t* __restrict__ tile_exception_offsets,\n    const uint64_t* __restrict__ entries20x3,\n    uint16_t* __restrict__ output,\n    int columns)\n{\n    const int tile = blockIdx.x;\n    const int physical_thread = threadIdx.x;\n#pragma unroll\n    for (int group = 0; group < kThreads / kDecodeThreads; ++group) {\n        const int thread = physical_thread + group * kDecodeThreads;\n        const uint8_t base =\n            thread_bases[static_cast<int64_t>(tile) * kThreads + thread];\n        const uint64_t code_word = load_code_word(codes, tile, thread);\n        const uint4 sm = *reinterpret_cast<const uint4*>(\n            sign_mantissa + static_cast<int64_t>(tile) * kTileElements\n            + thread * kElementsPerThread);\n\