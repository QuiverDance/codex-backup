{"timestamp":"2026-09-02T15:04:03.659Z","ordinal":19235,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a062a6-094b-71f0-8f80-b93cbea548a1","call_id":"call_LeXfEB5rGXjvASFetZgwThHe","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"                # then shrinks below num_blocks_total and the leftover blocks\n                # stay UNALLOCATED (empty HBM/LPDDR is fine).  Without it, keep\n                # the default (force dedicated up so offloadable == o_max and\n                # the full block budget is used).\n                _env_ded = None\n                if os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"):\n                    _env_ded = int(\n                        os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"))\n                elif os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"):\n                    _gb = float(\n                        os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"))\n                    if _gb > 0 and per_block_bytes_raw > 0 and n_kv_layers > 0:\n                        _env_ded = int(_gb * 1024**3\n                                       // (n_kv_layers * per_block_bytes_raw))\n                if _env_ded is not None:\n                    num_dedicated_hbm = max(\n                        MIN_DED,\n                        min(_env_ded, d_max_hbm, num_blocks_total - 1))\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n                else:\n                    num_dedicated_hbm = max(\n                        MIN_DED,\n                        min(d_max_hbm,\n                            num_blocks_total - o_max,\n                            num_blocks_total - 1))\n                    # Determinism: vLLM's profiling measures gpu_avail with a few\n                    # MB of run-to-run jitter -> num_dedicated_hbm flips by +-1\n                    # block run-to-run, which SHIFTS the dedicated/offloadable\n                    # boundary (block_id >= num_dedicated => offloadable).  With\n                    # the KV-offload pipeline that changes WHICH blocks are\n                    # offloaded+recompressed and makes the decode nondeterministic\n                    # (a boundary request's tokens diverge run-to-run).  Round the\n                    # boundary DOWN to a stable granularity so the jitter is\n                    # absorbed; the few reclaimed blocks just become offloadable.\n                    _g = int(os.getenv(\n                        \"TIERED_SERVE_KV_DEDICATED_GRANULARITY\", \"16\"))\n                    if _g > 1:\n                        num_dedicated_hbm = max(\n                            MIN_DED, (num_dedicated_hbm // _g) * _g)\n                    # Cap offloadable at o_max (physical hugepage/LPDDR\n                    # capacity).  The granularity round-down above lowers\n                    # num_dedicated_hbm, which would otherwise push\n                    # (num_blocks_total - num_dedicated_hbm) ABOVE o_max -- and\n                    # since num_dedicated was already pinned by the\n                    # (num_blocks_total - o_max) term, offloadable was sitting\n                    # exactly at o_max before rounding.  Without the cap each\n                    # per-layer secondary_kv requests > o_max_frag blocks and\n                    # overflows its hugepage block -> MemoryError.  The few\n                    # blocks reclaimed by the round-down just stay UNALLOCATED\n                    # (handled by the usable-shrink below), they cannot become\n                    # offloadable when offloadable is already at its physical\n                    # maximum.\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n\n            logger.info(\n                \"Tiered-serve hugepage alloc: total=%d, dedicated=%d \"\n                \"(HBM), offloadable=%d (buffer+LPDDR5), \"\n                \"per_block_raw=%d, per_block_lpddr=%d bytes, \"\n                \"gpu_avail=%.2f GiB, lpddr5=%.2f GiB, \"\n                \"o_max_lpddr=%d, o_max_frag=%d\",\n                num_blocks_total, num_dedicated_hbm, num_offloadable_lpddr,\n                per_block_bytes_raw, per_block_bytes_lpddr,\n                gpu_avail / 1024**3,\n                lpddr5_bytes / 1024**3,\n                o_max_lpddr if per_block_bytes_raw > 0 else 0,\n                o_max_frag if per_block_bytes_raw > 0 else 0)\n\n            if tail_slots:\n                min_general_dedicated = 16\n                if num_dedicated_hbm < tail_slots + min_general_dedicated:\n                    raise RuntimeError(\n                        \"Tiered-serve full-block KV compression needs one \"\n                        \"resident-tail HBM row per max_num_reqs plus at least \"\n                        f\"{min_general_dedicated} normal dedicated rows, but \"\n                        f\"the HBM planner produced {num_dedicated_hbm} rows \"\n                        f\"for max_num_reqs={tail_slots}. Lower --max-num-seqs \"\n                        \"or increase the KV HBM budget.\"\n                    )\n\n            # Store the split for gpu_worker. The raw tensors below retain all\n            # physical HBM rows; only the canonical scheduler boundary excludes\n            # the reserved tail rows.\n            self._ts_num_hbm_kv_rows = num_dedicated_hbm\n            self._ts_num_tail_slots = tail_slots\n            self._ts_num_dedicated_blocks = num_dedicated_hbm - tail_slots\n            self._ts_num_offloadable_blocks = num_offloadable_lpddr\n\n        for kv_cache_tensor in kv_cache_config.kv_cache_tensors:\n            if kv_offload:\n                # Hugepage: allocate only dedicated blocks on HBM.\n                # The offloadable region (buffer + LPDDR5 secondary) is\n                # set up later in gpu_worker._maybe_init_tiered_serv