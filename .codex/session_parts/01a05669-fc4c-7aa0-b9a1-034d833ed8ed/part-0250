r\\\"\\\\[fused-mm\\\\] ENABLED: (\\\\d+) Linear overrides installed (\\\\{[^\\\\n]+?\\\\})\\\\. \\\"\\n    r\\\"Per-component fused-N threshold (\\\\{[^\\\\n]+?\\\\})\\\\.\\\")\\n_WEIGHT_COMP_RE = re.compile(\\n    r\\\"\\\\[fused-bench\\\\] weight-compression codec=(\\\\w+) tensors=(\\\\d+) \\\"\\n    r\\\"raw_bytes=(\\\\d+) compressed_bytes=(\\\\d+) ratio=([0-9.eE+-]+) \\\"\\n    r\\\"exception_count=(\\\\d+)\\\")\\n_KV_BACKEND_RE = re.compile(\\n    r\\\"##### Using KV Compression \\\\(backend=(\\\\w+), producer=([^)]+)\\\\)\\\")\\n_TOKEN_HASH_FAILURE_REASON = (\\n    \\\"generated_token_sha256_mismatch_vs_same_codec_no_fused_mm\\\")\\n\\n\\ndef cells() -> list[tuple[str, bool]]:\\n    return [(codec, fused_mm)\\n            for codec in CODECS\\n            for fused_mm in (False, True)]\\n\\n\\ndef cell_name(codec: str, fused_mm: bool) -> str:\\n    return f\\\"{codec}.mm{int(fused_mm)}\\\"\\n\\n\\ndef command_for(\\n    codec: str,\\n    fused_mm: bool,\\n    *,\\n    breakdown: bool,\\n    gpu_memory_utilization: float | None = None,\\n) -> list[str]:\\n    command = [\\n        str(NUMACTL), \\\"-m\\\", \\\"0\\\", str(PYTHON), str(DRIVER),\\n        \\\"--model\\\", MODEL,\\n        \\\"--no-enable-prefix-caching\\\",\\n        \\\"--chunked-prefill\\\",\\n        \\\"--weight-comp\\\", codec,\\n        \\\"--kv-comp\\\", codec,\\n        \\\"--batch\\\", *map(str, BATCHES),\\n        \\\"--inputseqlen\\\", str(INPUT_LEN),\\n        \\\"--gen\\\", str(GENERATION_TOKENS),\\n        \\\"--fixed-generation-length\\\",\\n        \\\"--prefill-chunk\\\", str(PREFILL_CHUNK),\\n        \\\"--tensor-parallel-size\\\", \\\"1\\\",\\n        \\\"--warmup\\\", str(WARMUP),\\n        \\\"--ts-configs\\\", str(CONFIGS[codec]),\\n    ]\\n    if gpu_memory_utilization is not None:\\n        command.extend([\\n            \\\"--gpu-memory-utilization\\\",\\n            str(gpu_memory_utilization),\\n        ])\\n    if fused_mm:\\n        command.append(\\\"--fused-mm\\\")\\n    if breakdown:\\n        command.append(\\\"--time-breakdown\\\")\\n    return command\\n\\n\\ndef _sha(path: Path) -> str:\\n    return sha256_file(path)\\n\\n\\ndef _token_metadata(token_path: Path, batch: int) -> dict[str, Any]:\\n    payload = json.loads(token_path.read_text())\\n    if not isinstance(payload, list) or len(payload) != batch:\\n        raise RuntimeError(\\n            f\\\"generated-token dump has {len(payload) if isinstance(payload, list) else 'non-list'} \\\"\\n            f\\\"sequences, expected batch={batch}: {token_path}\\\")\\n    actual = [len(tokens) if isinstance(tokens, list) else -1\\n              for tokens in payload]\\n    expected = [GENERATION_TOKENS] * batch\\n    if actual != expected:\\n        raise RuntimeError(\\n            f\\\"generated-token lengths are not exactly {GENERATION_TOKENS}: \\\"\\n            f\\\"batch={batch} expected={expected} actual={actual}\\\")\\n    return {\\n        \\\"generation_tokens\\\": GENERATION_TOKENS,\\n        \\\"generation_length_policy\\\": \\\"fixed_per_request\\\",\\n        \\\"prefill_chunk_tokens\\\": PREFILL_CHUNK,\\n        \\\"generated_tokens_path\\\": str(token_path),\\n        \\\"generated_tokens_sha256\\\": _sha(token_path),\\n    }\\n\\n\\ndef _model_source_metadata() -> dict[str, Any]:\\n    \\\"\\\"\\\"Resolve the exact local HF snapshot and fingerprint its shard manifest.\\n\\n    Reading every 70B shard merely to re-hash content would add hundreds of GB\\n    of I/O before each orchestration run.  Hugging Face stores LFS weights under\\n    their content SHA256 blob names, so we validate those names and hash the\\n    deterministic ``filename:blob-sha:size`` manifest together with the index.\\n    \\\"\\\"\\\"\\n    hf_home = Path(os.environ.get(\\n        \\\"HF_HOME\\\", str(Path.home() / \\\".cache\\\" / \\\"huggingface\\\")))\\n    hub = Path(os.environ.get(\\\"HF_HUB_CACHE\\\", str(hf_home / \\\"hub\\\")))\\n    repo = hub / \\\"models--meta-llama--Llama-