_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path