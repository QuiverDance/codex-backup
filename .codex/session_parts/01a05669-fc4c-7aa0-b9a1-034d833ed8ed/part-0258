                  self._frozen_split_h2d_begin_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                                output.view(src.shape).copy_(\n                                    src, non_blocking=True)\n                                if tb:\n                                    self._frozen_split_h2d_end_timing_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                            self.decomp_weight_stream.wait_stream(\n                                self.load_weight_stream)\n            free_by_name = self._frozen_split_alt_staging_free_events = {}\n        h2d_by_name = getattr(\n            self, \"_frozen_split_alt_h2d_done_events\", None)\n        if h2d_by_name is None:\n            h2d_by_name = self._frozen_split_alt_h2d_done_events = {}\n\n        free_events = free_by_name.setdefault(name, [])\n        h2d_events = h2d_by_name.setdefault(name, [])\n        while len(free_events) < self.FROZEN_STAGING_PARITY:\n            free = torch.cuda.Event(external=True)\n            free.record()  # first occupant has no prior decoder to wait for\n            free_events.append(free)\n            h2d_events.append(torch.cuda.Event(external=True))\n\n    def _materialize_frozen_split_prefill_alt(\n            self, layer_id, name, alt, output, alt_comp):\n        \"\"\"Stage one eager-prefill alt weight without blocking compute H2D.\n\n        The wrapper schedules a future NONE-path piece after the current piece\n        has been submitted. Putting only these copies on load_weight_stream lets\n        them overlap that current compute. The H2D-done wait and decoder remain\n        on exec afterwards, ordered before the future component-ready event and\n        consuming GEMM.\n        \"\"\"\n        parity = layer_id % self.FROZEN_STAGING_PARITY\n        alt_staging = self.frozen_split_alt_staging[name][parity]\n        staging_free = self._frozen_split_alt_staging_free_events[name][parity]\n        h2d_done = self._frozen_split_alt_h2d_done_events[name][parity]\n\n        # Do not overwrite this parity slot while its previous P4 decoder is\n        # still reading it.\n        self.load_weight_stream.wait_event(staging_free)\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.load_weight_stream):\n            if tb:\n                self._frozen_split_h2d_begin_event(\n                    layer_id, name).record(self.load_weight_stream)\n            for attr in alt.lpddr_attrs:\n                ne = alt.lpddr_numels[attr]\n                alt_staging[attr][:ne].copy_(\n                    alt.lpddr_buffers[attr], non_blocking=True)\n            if tb:\n                self._frozen_split_h2d_end_timing_event(\n                    layer_id, name).record(self.load_weight_stream)\n            h2d_done.record(self.load_weight_stream)\n\n        # Keep P4 decode and its dense output on exec/current. Moving the decoder\n        # itself would add SM contention and a second cross-stream WAR on the\n        # parity-shared dense primary buffer.\n        self.decomp_weight_stream.wait_event(h2d_done)\n        if tb:\n            self._frozen_split_decomp_begin_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        self._frozen_split_run_decompress(\n            alt, alt_staging, alt.lpddr_numels, output, alt_comp)\n        if tb:\n            self._frozen_split_decomp_end_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        staging_free.record(self.decomp_weight_stream)\n\n    @staticmethod\n    def _parse_prefill_alt_max_chunk(raw, default=None):\n        \"\"\"Parse TIERED_SERVE_PREFILL_ALT_MAX_CHUNK into (per_backend, fallback).\n\n        Accepts a single int (one global override for every codec) or a comma\n        list of \"<codec>=<n>\" entries plus an optional bare int that overrides\n        the default for codecs not explicitly named. Codec keys are lower-cased\n        to match SplitStorageInfo.backend. Whitespace around tokens is ignored.\n\n        ``fallback`` stays ``None`` unless the env contained a bare int. None\n        signals \"unset\", so ``_alt_max_chunk_for`` then consults the built-in\n        per-codec defaults (_PREFILL_ALT_MAX_CHUNK_DEFAULTS) instead of forcing\n        a single threshold on every codec.\n        \"\"\"\n        by_backend: Dict[str, int] = {}\n        fallback = default\n        for tok in (raw or \"\").split(\",\"):\n            tok = tok.strip()\n            if not tok:\n                continue\n            if \"=\" in tok:\n                key, _, val = tok.partition(\"=\")\n                by_backend[key.strip().lower()] = int(val.strip())\n            else:\n                fallback = int(tok)\n        return by_backend, fallback\n\n    def _alt_max_chunk_for(self, backend):\n        \"\"\"Per-compressor prefill-alt chunk threshold for ``backend`` (the\n        alt's SplitStorageInfo.backend).\n\n        Resolution order: env per-codec map -> env single-int override ->\n        built-in per-codec default -> global default. The built-in tier lets\n        each codec carry its own measured crossover (see\n        _PREFILL_ALT_MAX_CHUNK_DEFAULTS) without forcing the user to set the\n        env, while any explicit env value still wins.\"\"\"\n        v = self._prefill_alt_max_chunk_by_backend.get(backend)\n        if v is not None:\n            return v\n        if self._prefill_alt_max_chunk is not None:\n            return self._prefill_alt_max_chunk\n        v = _PREFILL_ALT_MAX_CHUNK_DEFAULTS.get(backend)\n        if v is not None:\n            return v\n        return _PREFILL_ALT_MAX_CHUNK_GLOBAL_DEFAULT\n\n    def _refresh_prefill_raw_lookahead_policy(self):\n        \"\"\"Cache the first token count where every frozen-split cell is raw.\n\n        A cell with an alt codec uses it while ``N < alt_max_chunk`` and becomes\n        raw at ``N >= alt_max_chunk``. Taking the maximum cutoff across the\n        static placement proves that all scheduled split cells use raw BF16 with\n        one integer comparison per forward. Fold in the CUDA-graph boundary so\n        captured-size prefills can never enable the raw-only early-lookahead\n        protocol. Recompute only after initialization or reconfiguration.\n        \"\"\"\n        split_cells = 0\n        max_alt_cutoff = 0\n        for layer in (getattr(self, \"frozen_split_info\", None) or ()):\n            if not layer:\n                continue\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        metadata = {\n            \"M\": int(alt_comped.M), \"K\": int(alt_comped.K),\n            \"num_exceptions\": int(alt_comped.num_exceptions),\n            \"num_groups\": int(alt_comped.num_groups),\n        }\n        lpddr_bufs: Dict[str, torch.Tensor] = {}\n        for attr in lpddr_attrs:\n            gpu_buf = getattr(alt_comped, attr).contiguous()\n            hp_t = self.huge_page_allocator.allocate(\n                gpu_buf.shape, gpu_buf.stride(), gpu_buf.dtype,\n                page_type=\"weight\")\n            hp_t.copy_(gpu_buf)\n            lpddr_bufs[attr] = hp_t\n        info.alt = SplitStorageInfo(\n            hbm_sm, lpddr_bufs, metadata, backend=\"p4flat\")\n        info.alt._uses_canonical_sm = True   # p4flat decode reads row-major sm\n        self._ensure_frozen_split_alt_staging(name, info.alt)\n\n    def _attach_prefill_alt_same_codec(self, info, metadata, name):\n        \"\"\"Unified prefill-alt: reuse the PRIMARY frozen_split codec for the\n        small-chunk prefill decode instead of compressing a second time.\n\n        ``info.alt`` ALIASES the primary's HBM sign_mantissa, its HBM aux\n        buffers (e.g. zipserv tile_offsets) and its LPDDR compressed buffers,\n        so there is NO extra LPDDR/HBM cost — only a