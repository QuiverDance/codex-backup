 self.use_prefill_raw_bf16\ntiered_serve/dual_memory_loader/frozen_split.py:2625:                # done, never before).  The raw_bf16 prefill branch already\ntests/test_feature_matrix_e2e.py:182:    \"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK\",\ntests/test_prefill_weight_stream_policy.py:94:    loader.use_prefill_raw_bf16 = True\ntests/test_prefill_weight_stream_policy.py:157:def test_prefill_alt_h2d_and_staging_reuse_event_order():\ntests/test_prefill_weight_stream_policy.py:161:        \"_materialize_frozen_split_prefill_alt\",\ntests/test_prefill_weight_stream_policy.py:251:    loader._materialize_frozen_split_prefill_alt(\ntests/test_prefill_weight_stream_policy.py:291:        use_prefill_raw_bf16=True,\n#!/usr/bin/env python3\n\"\"\"Measure CAO exponent H2D followed by exact fused GEMM.\n\nThe codec's sign/mantissa payload stays resident in HBM.  Every other codec\nbuffer is copied from LPDDR-backed host memory into preallocated HBM staging.\nThe fused GEMM runs on a compute stream after waiting for that copy, matching\nthe frozen_split all-fused dependency chain.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport gc\nimport logging\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.fuseGEMM import (\n    DEFAULT_WEIGHTS_DIR,\n    flush_l2_cache,\n    load_real_projections,\n    proj_shapes,\n)\nfrom tiered_serve.compression.core import (\n    ChunkDelta3Compressor,\n    P4FlatCompressor,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.cpp_exts import zipserv_ext\nfrom tiered_serve.huge_page_allocator import allocator as huge_page_allocator\n\n\nlogging.getLogger().setLevel(logging.WARNING)\nlogging.getLogger(\"vllm\").setLevel(logging.WARNING)\n\n_EXP_ATTRS = {\n    \"p4flat\": SplitStorageInfo._P4FLAT_LPDDR_ATTRS,\n    \"chunk_delta3\": SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS,\n}\n\n\ndef _percentile(values: list[float], q: float) -> float:\n    ordered = sorted(values)\n    return ordered[int(q * (len(ordered) - 1))]\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    return min(values), statistics.median(values), _percentile(values, 0.95)\n\n\ndef _make_codec(name: str):\n    if name == \"p4flat\":\n        codec = P4FlatCompressor()\n    elif name == \"chunk_delta3\":\n        codec = ChunkDelta3Compressor(torch.cuda.current_stream())\n    else:\n        raise ValueError(name)\n    codec._fused_max_n_override = 10**9\n    return codec\n\n\ndef _stage_exponent(comp, attrs: tuple[str, ...]):\n    \"\"\"Build the same LPDDR sources and HBM staging used by frozen_split.\"\"\"\n    target = comp._c\n    host_sources = []\n    device_staging = []\n    for attr in attrs:\n        source = getattr(target, attr).contiguous()\n        if source.numel() == 0:\n            setattr(target, attr, torch.empty_like(source))\n            continue\n        host = huge_page_allocator.allocate(\n            source.shape, source.stride(), source.dtype, page_type=\"weight\")\n        host.copy_(source)\n        staging = torch.empty_like(source, device=source.device)\n        staging.copy_(source)\n        setattr(target, attr, staging)\n        host_sources.append(host)\n        device_staging.append(staging)\n    torch.cuda.synchronize()\n    ptrs = (\n        [dst.data_ptr() for dst in device_staging],\n        [src.data_ptr() for src in host_sources],\n        [src.numel() * src.element_size() for src in host_sources],\n    )\n    return tuple(host_sources), tuple(device_staging), ptrs\n\n\ndef _batch_h2d(ptrs, stream: torch.cuda.Stream):\n    if not ptrs[0]:\n        return\n    zipserv_ext.batch_memcpy_ptrs(\n        ptrs[0], ptrs[1], ptrs[2],\n        stream.cuda_stream,\n    )\n\n\ndef _bench_one(codec_name, proj, weight_cpu, n, warmup, iterations, flush):\n    weight = weight_cpu.cuda()\n    M, K = weight.shape\n    codec = _make_codec(codec_name)\n    comp = codec.compress(weight)\n    attrs = tuple(_EXP_ATTRS[codec_name])\n    host_sources, device_staging, ptrs = _stage_exponent(comp, attrs)\n    h2d_bytes = sum(t.numel() * t.element_size() for t in host_sources)\n\n    generator = torch.Generator(device=\"cuda\").manual_seed(20250827 + n)\n    x = torch.randn(n, K, generator=generator, dtype=torch.bfloat16,\n                    device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(K, M, n, x.dtype, x.device)\n\n    def fused():\n        return codec.linear_apply_into(comp, x, scratch)\n\n    # First-use compilation and scratch allocations are outside the samples.\n    actual = fused()\n    expected = torch.nn.functional.linear(x, weight)\n    torch.cuda.synchronize()\n    amax = expected.float().abs().max().item()\n    if not torch.allclose(actual.float(), expected.float(),\n                          atol=max(1.0, 0.02 * amax), rtol=0.02):\n        raise RuntimeError(f\"fused mismatch: {codec_name}/{proj}/N={n}\")\n\n    copy_stream = torch.cuda.Stream()\n    compute_stream = torch.cuda.current_stream()\n    ready = torch.cuda.Event()\n\n    def run_once(timed: bool):\n        if flush:\n            flush_l2_cache()\n            compute_stream.synchronize()\n        start = torch.cuda.Event(enable_timing=timed)\n        copy_end = torch.cuda.Event(enable_timing=timed)\n        kernel_begin = torch.cuda.Event(enable_timing=timed)\n        end = torch.cuda.Event(enable_timing=timed)\n        with torch.cuda.stream(copy_stream):\n            start.record(copy_stream)\n            _batch_h2d(ptrs, copy_stream)\n            copy_end.record(copy_stream)\n            ready.record(copy_stream)\n        with torch.cuda.stream(compute_stream):\n            compute_stream.wait_event(ready)\n            kernel_begin.record(compute_stream)\n            output = fused()\n            end.record(compute_stream)\n        end.synchronize()\n        if not timed:\n            return output, None\n        return output, (\n            start.elapsed_time(copy_end),\n            kernel_begin.elapsed_time(end),\n            start.elapsed_time(end),\n        )\n\n    for _ in range(warmup):\n        run_once(False)\n    copies, kernels, totals = [], [], []\n    for _ in range(iterations):\n        _, sample = run_once(True)\n        copies.append(sample[0])\n        kernels.append(sample[1])\n        totals.append(sample[2])\n\n    result = {\n        \"codec\": codec_name,\n        \"projection\": proj,\n        \"layer\": 40,\n        \"N\": n,\n        \"M\": M,\n        \"K\": K,\n        \"h2d_bytes\": h2d_bytes,\n        \"h2d_mib\": h2d_bytes / 2**20,\n        \"h2d_p50_ms\": _stats(copies)[1],\n        \"h2d_p95_ms\": _stats(copies)[2],\n        \"fused_p50_ms\": _stats(kernels)[1],\n        \"fused_p95_ms\": _stats(kernels)[2],\n        \"h2d_fused_p50_ms\": _stats(totals)[1],\n        \"h2d_fused_p95_ms\": _stats(totals)[2],\n        \"correctness\": True,\n    }\n    del comp, codec, weight, x, actual, expected, scratch\n    for host in host_sources:\n        huge_page_allocator.free(host)\n    del host_sources, device_staging, ptrs\n    gc.collect()\n    torch.cuda.empty_cache()\n    return result\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    parser.add_argument(\"--layer\", type=int, default=40)\n    parser.add_argument(\"--n\", type=int, default=64)\n    parser.add_argument(\"--warmup\", type=int, default=20)\n    parser.add_argument(\"--iterations\", type=int, default=200)\n    parser.add_argument(\"--no-flush\", action=\"store_true\")\n    parser.add_argument(\"--csv\", required=True)\n    args = parser.parse_args()\n    if args.layer != 40:\n        raise ValueError(\"this benchmark currently records layer 40 only\")\n\n    shapes = proj_shapes(1)\n    weights = load_real_projections(\n        args.weights_dir, shapes, layer=args.layer)\n    rows = []\n    print(torch.cuda.get_device_name())\n    print(\"CAO: exponent H2D -> fused GEMM; sign/mantissa resident in HBM\")\n    for codec_name in (\"p4flat\", \"chunk_delta3\"):\n        for proj in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n            row = _bench_one(\n                codec_name, proj, weights[proj], args.n,\n                args.warmup, args.iterations, not args.no_flush)\n            rows.append(row)\n            print(\n                f\"{codec_name:12s} {proj:7s} exp={row['h2d_mib']:7.2f} MiB \"\n                f\"H2D={row['h2d_p50_ms']:.3f} ms \"\n                f\"fused={row['fused_p50_ms']:.3f} ms \"\n                f\"total={row['h2d_fused_p50_ms']:.3f} ms \"\n                f\"p95={row['h2d_fused_p95_ms']:.3f} ms\")\n\n    with open(args.csv, \"w\", newline=\"\") as f:\n        writer = csv.DictWriter(f, fieldnames=list(rows[0]))\n        writer.writeheader()\n        writer.writerows(rows)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"CPU-only checks for eager-prefill frozen-weight stream policy.\n\nThe production loader imports CUDA extensions at module import time.  Extract\nthe small policy/helpers from their source AST so cutoff and event ordering can\nbe validated without a GPU or extension build.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nFROZEN_SOURCE = (\n    REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"frozen_split.py\"\n)\nINIT_SOURCE = REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"init.py\"\nWRAPPER_SOURCE = REPO_ROOT / \"tiered_serve\" / \"v1_cuda_graph_wrapper.py\"\n\n\ndef _class_method(source: Path, class_name: str, method_name: str) -> ast.AST:\n    tree = ast.parse(source.read_text())\n    cls = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef) and node.name == class_name\n    )\n    return next(\n        node for node in cls.body\n        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))\n        and node.name == method_name\n    )\n\n\ndef _policy_class(methods, namespace=None):\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=list(methods),\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {} if namespace is None else dict(namespace)\n    exec(compile(module, str(FROZEN_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"], namespace\n\n\ndef _alt(backend: str):\n    return SimpleNamespace(backend=backend)\n\n\ndef _info(backend: str | None):\n    return SimpleNamespace(alt=None if backend is None else _alt(backend))\n\n\ndef test_actual_raw_lookahead_uses_cached_all_cell_cutoff():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    predicate = _class_method(\n        WRAPPER_SOURCE,\n        \"TieredServeCUDAGraphWrapper\",\n        \"_prefill_raw_weight_lookahead\",\n    )\n    policy_cls, namespace = _policy_class((refresh, predicate))\n    namespace[\"TieredServeCUDAGraphWrapper\"] = policy_cls\n    policy_cls._uses_component_weight_waits_for = staticmethod(\n        lambda dm: dm.component_weight_waits)\n\n    loader = policy_cls()\n    loader._cudagraph_ceiling = 512\n    loader.frozen_comp_buffers = []\n    loader._alt_max_chunk_for = lambda backend: {\n        \"p4flat\": 1330,\n        \"zipserv\": 1107,\n    }[backend]\n    loader.frozen_split_info = [\n        {\"qkv\": _info(\"p4flat\"), \"o\": _info(None)},\n        {\"down\": _info(\"zipserv\")},\n        None,\n    ]\n    loader._refresh_prefill_raw_lookahead_policy()\n\n    assert loader._prefill_raw_lookahead_split_cells == 3\n    assert loader._prefill_raw_lookahead_min_tokens == 1330\n\n    loader.frozen_decomp_event = object()\n    loader.FROZEN_DECOMP_PARITY = 2\n    loader.batch_has_prefill = True\n    loader.use_prefill_raw_bf16 = True\n    loader.component_weight_waits = True\n\n    for n in (512, 513, 1329):\n        loader.cur_num_tokens = n\n        assert not loader._prefill_raw_weight_lookahead(loader)\n    for n in (1330, 1331):\n        loader.cur_num_tokens = n\n        assert loader._prefill_raw_weight_lookahead(loader)\n\n    loader.batch_has_prefill = False\n    assert not loader._prefill_raw_weight_lookahead(loader)\n    loader.batch_has_prefill = True\n    loader.component_weight_waits = False\n    assert not loader._prefill_raw_weight_lookahead(loader)\n\n\ndef test_actual_raw_cutoff_respects_ceiling_and_empty_placement():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    policy_cls, _ = _policy_class((refresh,))\n    loader = policy_cls()\n    loader.frozen_comp_buffers = []\n    loader._alt_max_chunk_for = lambda backend: 128\n    loader._cudagraph_ceiling = 512\n    loader.frozen_split_info = [{\"qkv\": _info(\"p4flat\")}]\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert loader._prefill_raw_lookahead_min_tokens == 513\n\n    loader.frozen_split_info = []\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert not loader._prefill_raw_lookahead_has_split\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n    loader.frozen_split_info = [{\"qkv\": _info(None)}]\n    loader._cudagraph_ceiling = 0\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n\ndef test_mixed_frozen_compressed_disables_raw_early_lookahead():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    policy_cls, _ = _policy_class((refresh,))\n    loader = policy_cls()\n    loader._cudagraph_ceiling = 512\n    loader._alt_max_chunk_for = lambda backend: 1330\n    loader.frozen_split_info = [{\"qkv\": _info(\"p4flat\")}]\n    loader.frozen_comp_buffers = [None, {\"o\": object()}]\n\n    loader._refresh_prefill_raw_lookahead_policy()\n\n    assert loader._prefill_raw_lookahead_split_cells == 1\n    assert loader._prefill_raw_lookahead_frozen_comp_cells == 1\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n\ndef test_prefill_alt_h2d_and_staging_reuse_event_order():\n    materialize = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_materialize_frozen_split_prefill_alt\",\n    )\n    trace = []\n    current = [None]\n\n    class FakeStream:\n        def __init__(self, name):\n            self.name = name\n\n        def wait_event(self, event):\n            trace.append((\"wait\", self.name, event.name))\n\n    class FakeEvent:\n        def __init__(self, name):\n            self.name = name\n\n        def record(self, stream=None):\n            trace.append((\"record\", self.name, stream.name))\n\n    class FakeStreamCtx:\n        def __init__(self, stream):\n            self.stream = stream\n            self.previous = None\n\n        def __enter__(self):\n            self.previous = current[0]\n            current[0] = self.stream\n\n        def __exit__(self, *exc):\n            current[0] = self.previous\n\n    class FakeTensor:\n        def __init__(self, attr):\n            self.attr = attr\n\n        def __getitem__(self, key):\n            return self\n\n        def copy_(self, source, non_blocking=False):\n            assert non_blocking\n            trace.append((\"copy\", current[0].name, self.attr))\n\n    class FakeCudaModule:\n        stream = FakeStreamCtx\n\n    class FakeTorch:\n        cuda = FakeCudaModule\n\n    policy_cls, _ = _policy_class(\n        (materialize,), {\"torch\": FakeTorch})\n    loader = policy_cls()\n    load = loader.load_weight_stream = FakeStream(\"load\")\n    decomp = loader.decomp_weight_str