         gt_m_base=0, num_row_tiles=-1):\n        \"\"\"Backend-dispatched decompress for one frozen_split tensor.\n\n        ``src_bufs`` is the dict of attr -> tensor that holds the\n        compressed payload (either staging, post-H2D, or — under ATS —\n        the LPDDR hugepage tensor itself).  ``ln`` is the matching\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n#!/usr/bin/env python3\n\"\"\"Split frozen-split weight latency into H2D, resident decode, and total.\n\nBoth codecs are encoded from CPU BF16 weights.  Encode/setup is deliberately\noutside the CUDA-event measurements.  As in production frozen-split storage,\nsign|mantissa remains resident in HBM; CD3 tile exception offsets are resident\ntoo.  Only each codec's LPDDR-side exponent representation is copied per run.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.weight_compress import (\n    _GROUP_DEFS,\n    _build_layer_index,\n    _load_layer,\n    _resolve_inputs,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    ChunkDelta3Compressor,\n    _cd3_ext,\n)\nfrom tiered_serve.compression.core.p4flat import (\n    P4FlatCompressor,\n    _p4f_ext,\n)\n\n\ndef _percentile(values, fraction):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef _measure(stream, operation, warmup, iterations):\n    begin = torch.cuda.Event(enable_timing=True)\n    end = torch.cuda.Event(enable_timing=True)\n\n    def once():\n        with torch.cuda.stream(stream):\n            begin.record(stream)\n            operation()\n            end.record(stream)\n        end.synchronize()\n        return begin.elapsed_time(end)\n\n    for _ in range(warmup):\n        once()\n    return [once() for _ in range(iterations)]\n\n\ndef _prepare(weight, codec_name, stream):\n    \"\"\"CPU-encode and return (h2d, decode, transfer_bytes, output, comp).\"\"\"\n    if codec_name == \"chunk_delta3\":\n        compressor = ChunkDelta3Compresso