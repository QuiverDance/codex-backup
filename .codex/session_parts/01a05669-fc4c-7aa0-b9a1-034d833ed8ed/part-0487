ree(\n        split_h2d: bool) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        if split_h2d:\n            compressor.load_kv_stream = torch.cuda.Stream()\n            compressor._kv_pipeline_chunk_blocks = 2\n            compressor._kv_pipeline_min_blocks = 3\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        # Freeing an ID after enqueue must quarantine its captured slot; the\n        # retiring worker may finish writing it but must not republish it.\n        compressor.free_persistent_block(0, 1)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        prepared = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared, torch.tensor(prepared).numpy())\n        initial_active_version = compressor._prepared_active_version\n        compressor.decompress_batch(\n            0, prepared, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # A newly materialized list with identical content keeps the version;\n        # the held identity still proves that per-layer fast-path calls belong\n        # to the currently prepared step.\n        prepared_same = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared_same, torch.tensor(prepared_same).numpy())\n        assert compressor._prepared_active_version == initial_active_version\n        assert compressor._prepared_active_list is prepared_same\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        active = [2, 3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        assert compressor._prepared_active_version == initial_active_version + 2\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        if split_h2d:\n            assert len(compressor._pipeline_decode_plans[0][\"plans\"]) == 2\n\n        compressor.free_persistent_block(0, 6)\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(v_cache[2].cpu(), host_v[2])\n        assert torch.count_nonzero(k_cache[6]).item() == 0\n        assert torch.count_nonzero(v_cache[6]).item() == 0\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\ndef test_cpu_kv_compact_row_matches_planner(monkeypatch) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n    from tiered_serve.kv_codec_spec import compressed_block_bytes\n\n    monkeypatch.delenv(\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", raising=False)\n    monkeypatch.delenv(\n        \"TIERED_SERVE_KV_CD3_PIPELINE_CHUNK_BLOCKS\", raising=False)\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=1, n_layers=1,\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\n        assert compressor._entry_capacity == 420\n        assert compressor._blob_stride == 24704\n        assert compressor._kv_pipeline_chunk_blocks == 0\n        assert compressed_block_bytes(\"chunk_delta3\", 16384) == 24704\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\ndef test_cpu_kv_exception_overflow_restores_raw_secondary(\n        monkeypatch) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n    monkeypatch.setenv(\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"3\")\n    block_shape = (16, 8, 128)\n    # Transposition makes each 16-value encoder chunk span many exponents,\n    # deterministically overflowing a three-entry test row.\n    bits = torch.arange(16384, dtype=torch.int32).to(torch.int16)\n    host_k = (bits.view(torch.bfloat16).reshape(128, 128).t()\n              .contiguous().reshape(1, *block_shape).pin_memory())\n    host_v = torch.randn(\n        1, *block_shape, generator=torch.Generator().manual_seed(73),\n        dtype=torch.float32).to(torch.bfloat16).contiguous().pin_memory()\n    monkeypatch.setattr(\n        DualMemoryLoader, \"kv_caches\",\n        [SimpleNamespace(secondary_kv=(host_k, host_v))])\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=1, n_layers=1,\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\n        compressor.compress_batch_async_from_host(\n            0, [0], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._secondary_fallback_possible[0]\n        assert int(compressor._host_pools[0][\"k\"][\n            \"num_exceptions\"][0]) > compressor._entry_capacity\n\n        output_k = torch.zeros(\n            1, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        output_v = torch.zeros_like(output_k)\n        active = [0]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(output_k, output_v))\n        torch.cuda.synchronize()\n        _assert_bit_exact(output_k.cpu(), host_k)\n        _assert_bit_exact(output_v.cpu(), host_v)\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 16, 32, 40, 48, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    ass