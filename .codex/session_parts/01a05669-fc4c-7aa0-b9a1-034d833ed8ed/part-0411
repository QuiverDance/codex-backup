 contiguous\nwindows (~97% coverage with top-7 exponents). This script checks if KV cache\nexhibits the same property, and whether per-head BaseExp improves over\nZipServ's global per-layer BaseExp.\n\nUsage:\n    python -m vllm.benchmarks.kv_cache_exponent_profile \\\n        --model meta-llama/Llama-3.1-8B \\\n        --num-prompts 100 \\\n        --output-dir ./kv_exponent_analysis/\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom collections import defaultdict\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\n\n\ndef extract_layer_index(layer_name: str) -> int:\n    \"\"\"Extract numeric layer index from a module name like\n    'model.layers.5.self_attn.attn'.\"\"\"\n    match = re.search(r\"layers\\.(\\d+)\", layer_name)\n    if match:\n        return int(match.group(1))\n    return -1\n\n\ndef extract_exponents_bf16(tensor: torch.Tensor) -> torch.Tensor:\n    \"\"\"Extract the 8-bit exponent field from BF16 values.\n\n    BF16 layout: [sign(1) | exponent(8) | mantissa(7)]\n    \"\"\"\n    bits = tensor.contiguous().view(torch.int16)\n    return ((bits >> 7) & 0xFF).to(torch.int32)\n\n\ndef find_best_window(histogram: np.ndarray, window_size: int = 7):\n    \"\"\"Find the contiguous exponent window that covers the most values.\n\n    Returns (base_exp, coverage_ratio, window_start).\n    ZipServ defines BaseExp = window_start - 1.\n    \"\"\"\n    total = histogram.sum()\n    if total == 0:\n        return 0, 0.0, 0\n    best_start, best_count = 0, 0\n    for start in range(256 - window_size + 1):\n        count = histogram[start : start + window_size].sum()\n        if count > best_count:\n            best_start, best_count = start, count\n    base_exp = max(best_start - 1, 0)\n    return base_exp, best_count / total, best_start\n\n\ndef check_contiguity(histogram: np.ndarray, top_k: int = 7) -> bool:\n    \"\"\"Check if the top-k most frequent exponents are contiguous.\"\"\"\n    nonzero = np.where(histogram > 0)[0]\n    if len(nonzero) == 0:\n        return True\n    top_indices = np.argsort(histogram)[-top_k:]\n    top_indices_sorted = np.sort(top_indices)\n    # Check if they form a contiguous range\n    if len(top_indices_sorted) <= 1:\n        return True\n    return (top_indices_sorted[-1] - top_indices_sorted[0]) == (\n        len(top_indices_sorted) - 1\n    )\n\n\ndef compute_entropy(histogram: np.ndarray) -> float:\n    \"\"\"Compute Shannon entropy in bits of an exponent distribution.\"\"\"\n    total = histogram.sum()\n    if total == 0:\n        return 0.0\n    probs = histogram[histogram > 0] / total\n    return -np.sum(probs * np.log2(probs))\n\n\nclass KVExponentProfiler:\n    \"\"\"Collects per-(layer, head) exponent histograms from KV cache tensors\n    using PyTorch forward hooks on vLLM Attention modules.\"\"\"\n\n    def __init__(self):\n        # histograms[(layer_idx, head_idx, 'k'|'v')] = np.ndarray[256]\n        self.histograms: dict[tuple, np.ndarray] = defaultdict(\n            lambda: np.zeros(256, dtype=np.int64)\n        )\n        # position-bucketed histograms for massive activation analysis\n        # key: (layer_idx, head_idx, 'k'|'v', 'early'|'late')\n        self.pos_histograms: dict[tuple, np.ndarray] = defaultdict(\n            lambda: np.zeros(256, dtype=np.int64)\n        )\n        self._hooks = []\n        self._token_count = 0\n        self._position_threshold = 4  # tokens 0..3 = \"early\"\n\n    def register_hooks(self, model: nn.Module):\n        \"\"\"Register forward pre-hooks on all Attention modules.\"\"\"\n        from vllm.attention.layer import Attention\n\n        for name, module in model.named_modules():\n            if isinstance(module, Attention):\n                handle = module.register_forward_pre_hook(\n                    self._make_hook(module)\n                )\n                self._hooks.append(handle)\n        print(f\"Registered hooks on {len(self._hooks)} Attention layers\")\n\n    def _make_hook(self, attn_module):\n        \"\"\"Create a pre-hook closure for a specific Attention module.\"\"\"\n        layer_idx = extract_layer_index(attn_module.layer_name)\n        num_kv_heads = attn_module.num_kv_heads\n        head_size = attn_module.head_size\n\n        def hook_fn(module, args):\n            # Attention.forward(query, key, value, output_shape=None)\n            if len(args) < 3:\n                return\n            key = args[1]\n            value = args[2]\n            if key is None or value is None:\n                return\n\n            # key/value shape at this point: [num_tokens, num_kv_heads * head_size]\n            # or already reshaped to [num_tokens, num_kv_heads, head_size]\n            with torch.no_grad():\n                for tensor, kv_type in [(key, \"k\"), (value, \"v\")]:\n                    t = tensor.detach()\n                    if t.dim() == 2:\n                        # [num_tokens, num_kv_heads * head_size]\n                        num_tokens = t.shape[0]\n                        t = t.view(num_tokens, num_kv_heads, head_size)\n                    elif t.dim() == 3:\n                        num_tokens = t.shape[0]\n                    else:\n                        continue\n\n                    if t.dtype != torch.bfloat16:\n                        t = t.to(torch.bfloat16)\n\n                    for head in range(t.shape[1]):\n                        head_data = t[:, head, :]  # [num_tokens, head_size]\n                        exps = extract_exponents_bf16(head_data)\n                        exp_np = exps.cpu().numpy().flatten()\n                        hist, _ = np.histogram(\n                            exp_np, bins=256, range=(0, 256)\n                        )\n                        self.histograms[\n                            (layer_idx, head, kv_type)\n                        ] += hist\n\n                    self._token_count += num_tokens\n\n        return hook_fn\n\n    def remove_hooks(self):\n        for h in self._hooks:\n            h.remove()\n        self._hooks.clear()\n\n    def analyze(self) -> dict:\n        \"\"\"Run full analysis on collected histograms.\"\"\"\n        if not self.histograms:\n            return {\"error\": \"No data collected\"}\n\n        # Organize by layer\n        layers = set()\n        heads = set()\n        for layer_idx, head_idx, kv_type in self.histograms:\n            layers.add(layer_idx)\n            heads.add(head_idx)\n        num_layers = max(layers) + 1 if layers else 0\n        num_heads = max(heads) + 1 if heads else 0\n\n        results = {\n            \"model_info\": {\n                \"num_layers\": num_layers,\n                \"num_kv_heads\": num_heads,\n                \"total_hook_calls_tokens\": self._token_count,\n            },\n            \"per_head\": {},\n            \"per_layer_summary\": {},\n            \"global_summary\": {},\n        }\n\n        # Per-head analysis\n        all_coverages_perhead = []\n        all_coverages_global = []\n        all_entropies = []\n        contiguity_count = 0\n        total_count = 0\n\n        for layer_idx in sorted(layers):\n            layer_key = f\"layer_{layer_idx}\"\n            layer_results = {}\n            layer_hists_k = []\n            layer_hists_v = []\n\n            for head_idx in range(num_heads):\n                for kv_type in [\"k\", \"v\"]:\n                    key = (layer_idx, head_idx, kv_type)\n                    hist = self.histograms.get(key)\n                    if hist is None:\n                        hist = np.zeros(256, dtype=np.int64)\n\n                    base_exp, coverage, win_start = find_best_window(hist)\n                    entropy = compute_entropy(hist)\n                    contiguous = check_contiguity(hist)\n\n                    head_key = f\"head_{head_idx}_{kv_type}\"\n                    layer_results[head_key] = {\n                        \"base_exp\": int(base_exp),\n                        \"window_start\": int(win_start),\n                        \"coverage\": round(float(coverage), 6),\n                        \"entropy_bits\": round(float(entropy), 4),\n                        \"contiguous_top7\": bool(contiguous),\n                        \"total_elements\": int(hist.sum()),\n                    }\n\n                    all_coverages_perhead.append(coverage)\n                    all_entropies.append(entropy)\n                    if contiguous:\n                        contiguity_count += 1\n                    total_count += 1\n\n                    if kv_type == \"k\":\n                        layer_hists_k.append(hist)\n                    else:\n                        layer_hists_v.append(hist)\n\n            results[\"per_head\"][layer_key] = layer_results\n\n            # Global per-layer BaseExp (ZipServ style): merge all heads\n            for kv_type, layer_hists in [(\"k\", layer_hists_k),\n                                          (\"v\", layer_hists_v)]:\n                if not layer_hists:\n                    continue\n                merged = sum(layer_hists)\n                g_base, g_cov, g_win = find_best_window(merged)\n                g_entropy = compute_entropy(merged)\n\n                # Per-head coverages using the global window\n                head_covs_with_global = []\n                for h_hist in layer_hists:\n                    h_total = h_hist.sum()\n                    if h_total > 0:\n                        h_cov = h_hist[g_win : g_win + 7].sum() / h_total\n                    else:\n                        h_cov = 0.0\n                    head_covs_with_global.append(h_cov)\n\n                all_coverages_global.extend(head_covs_with_global)\n\n                lkey = f\"layer_{layer_idx}\"\n                if lkey not in results[\"per_layer_summary\"]:\n                    results[\"per_layer_summary\"][lkey] = {}\n                results[\"per_layer_summary\"][lkey][f\"global_{kv_type}\"] = {\n                    \"global_base_exp\": int(g_base),\n                    \"global_coverage\": round(float(g_cov), 6),\n                    \"global_entropy_bits\": round(float(g_entropy), 4),\n                    \"min_head_coverage_with_global_window\": round(\n                        float(min(head_covs_with_global))\n                        if head_covs_with_global\n                        else 0.0,\n                        6,\n                    ),\n=== TEST DIFF ===\ndiff --git a/tests/v1/core/test_prefix_caching.py b/tests/v1/core/test_prefix_caching.py\nindex 0880a17c7..c50e10a23 100644\n--- a/tests/v1/core/test_prefix_caching.py\n+++ b/tests/v1/core/test_prefix_caching.py\n@@ -19,7 +19,11 @@ from vllm.multimodal.inputs import (\n from vllm.sampling_params import SamplingParams\n from vllm.utils.hashing import sha256, sha256_cbor\n from vllm.v1.core.block_pool import BlockHashToBlockMap, BlockPool\n-from vllm.v1.core.kv_cache_manager import KVCacheManager, Request\n+from vllm.v1.core.kv_cache_manager import (\n+    KVBlockWrite,\n+    KVCacheManager,\n+    Request,\n+)\n from vllm.v1.core.kv_cache_utils import (\n     BlockHash,\n     BlockHashWithGroupId,\n@@ -127,6 +131,58 @@ def make_kv_cache_config_hybrid_model(\n     )\n \n \n+def test_kv_block_write_metadata_across_tail_boundary():\n+    block_size = 16\n+    manager = KVCacheManager(\n+        make_kv_cache_config(block_size, 8),\n+        max_model_len=128,\n+        enable_caching=False,\n+        hash_block_size=block_size,\n+    )\n+    request = make_request(\"req\", list(range(33)), block_size, sha256)\n+    observed: list[KVBlockWrite] = []\n+    manager.on_blocks_written = observed.extend\n+\n+    assert manager.allocate_slots(request, 15) is not None\n+    assert observed == [\n+        KVBlockWrite(\"req\", 1, 0, 0, 15, block_size)\n+    ]\n+\n+    observed.clear()\n+    request.num_computed_tokens = 15\n+    assert manager.allocate_slots(request, 1) is not None\n+    assert observed == [\n+        KVBlockWrite(\"req\", 1, 0, 15, 16, block_size)\n+    ]\n+\n+    observed.clear()\n+    request.num_computed_tokens = 16\n+    assert manager.allocate_slots(request, 1) is not None\n+    assert observed == [\n+        KVBlockWrite(\"req\", 2, 1, 0, 1, block_size)\n+    ]\n+\n+\n+def test_kv_block_write_metadata_for_multiblock_prefill():\n+    block_size = 16\n+    manager = KVCacheManager(\n+        make_kv_cache_config(block_size, 8),\n+        max_model_len=128,\n+        enable_caching=False,\n+        hash_block_size=block_size,\n+    )\n+    request = make_request(\"prefill\", list(range(33)), block_size, sha256)\n+    observed: list[KVBlockWrite] = []\n+    manager.on_blocks_written = observed.extend\n+\n+    assert manager.allocate_slots(request, 33) is not None\n+    assert observed == [\n+        KVBlockWrite(\"prefill\", 1, 0, 0, 16, block_size),\n+        KVBlockWrite(\"prefill\", 2, 1, 0, 16, block_size),\n+        KVBlockWrite(\"prefill\", 3, 2, 0, 1, block_size),\n+    ]\n+\n+\n @pytest.mark.parametrize(\"hash_fn\", [sha256, sha256_cbor])\n def test_prefill(hash_fn):\n     block_size = 16\n"},"started_at_ms":1788356509965,"completed_at_ms":1788356509965}}
