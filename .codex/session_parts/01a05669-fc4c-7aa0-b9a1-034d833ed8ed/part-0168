ure CAO exponent H2D followed by exact fused GEMM.\n+\n+The codec's sign/mantissa payload stays resident in HBM.  Every other codec\n+buffer is copied from LPDDR-backed host memory into preallocated HBM staging.\n+The fused GEMM runs on a compute stream after waiting for that copy, matching\n+the frozen_split all-fused dependency chain.\n+\"\"\"\n+from __future__ import annotations\n+\n+import argparse\n+import csv\n+import gc\n+import logging\n+import os\n+import statistics\n+import sys\n+\n+_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n+if _ROOT not in sys.path:\n+    sys.path.insert(0, _ROOT)\n+\n+import torch\n+\n+from benchmarks.fuseGEMM import (\n+    DEFAULT_WEIGHTS_DIR,\n+    flush_l2_cache,\n+    load_real_projections,\n+    proj_shapes,\n+)\n+from tiered_serve.compression.core import (\n+    ChunkDelta3Compressor,\n+    P4FlatCompressor,\n+)\n+from tiered_serve.compression.core.base import SplitStorageInfo\n+from tiered_serve.cpp_exts import zipserv_ext\n+from tiered_serve.huge_page_allocator import allocator as huge_page_allocator\n+\n+\n+logging.getLogger().setLevel(logging.WARNING)\n+logging.getLogger(\"vllm\").setLevel(logging.WARNING)\n+\n+_EXP_ATTRS = {\n+    \"p4flat\": SplitStorageInfo._P4FLAT_LPDDR_ATTRS,\n+    \"chunk_delta3\": SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS,\n+}\n+\n+\n+def _percentile(values: list[float], q: float) -> float:\n+    ordered = sorted(values)\n+    return ordered[int(q * (len(ordered) - 1))]\n+\n+\n+def _stats(values: list[float]) -> tuple[float, float, float]:\n+    return min(values), statistics.median(values), _percentile(values, 0.95)\n+\n+\n+def _make_codec(name: str):\n+    if name == \"p4flat\":\n+        codec = P4FlatCompressor()\n+    elif name == \"chunk_delta3\":\n+        codec = ChunkDelta3Compressor(torch.cuda.current_stream())\n+    else:\n+        raise ValueError(name)\n+    codec._fused_max_n_override = 10**9\n+    return codec\n+\n+\n+def _stage_exponent(comp, attrs: tuple[str, ...]):\n+    \"\"\"Build the same LPDDR sources and HBM staging used by frozen_split.\"\"\"\n+    target = comp._c\n+    host_sources = []\n+    device_staging = []\n+    for attr in attrs:\n+        source = getattr(target, attr).contiguous()\n+        if source.numel() == 0:\n+            setattr(target, attr, torch.empty_like(source))\n+            continue\n+        host = huge_page_allocator.allocate(\n+            source.shape, source.stride(), source.dtype, page_type=\"weight\")\n+        host.copy_(source)\n+        staging = torch.empty_like(source, device=source.device)\n+        staging.copy_(source)\n+        setattr(target, attr, staging)\n+        host_sources.append(host)\n+        device_staging.append(staging)\n+    torch.cuda.synchronize()\n+    ptrs = (\n+        [dst.data_ptr() for dst in device_staging],\n+        [src.data_ptr() for src in host_sources],\n+        [src.numel() * src.element_size() for src in host_sources],\n+    )\n+    return tuple(host_sources), tuple(device_staging), ptrs\n+\n+\n+def _batch_h2d(ptrs, stream: torch.cuda.Stream):\n+    if not ptrs[0]:\n+        return\n+    zipserv_ext.batch_memcpy_ptrs(\n+        ptrs[0], ptrs[1], ptrs[2],\n+        stream.cuda_stream,\n+    )\n+\n+\n+def _bench_one(codec_name, proj, weight_cpu, n, warmup, iterations, flush):\n+    weight = weight_cpu.cuda()\n+    M, K = weight.shape\n+    codec = _make_codec(codec_name)\n+    comp = codec.compress(weight)\n+    attrs = tuple(_EXP_ATTRS[codec_name])\n+    host_sources, device_staging, ptrs = _stage_exponent(comp, attrs)\n+    h2d_bytes = sum(t.numel() * t.element_size() for t in host_sources)\n+\n+    generator = torch.Generator(device=\"cuda\").manual_seed(20250827 + n)\n+    x = torch.randn(n, K, generator=generator, dtype=torch.bfloat16,\n+                    device=\"cuda\")\n+    scratch = codec.alloc_fused_scratch(K, M, n, x.dtype, x.device)\n+\n+    def fused():\n+        return codec.linear_apply_into(comp, x, scratch)\n+\n+    # Fir