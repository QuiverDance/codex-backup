  for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"bit-exact={resident_exact and staged_exact}\")\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--blocks\", default=\"1024,2048\")\n    parser.add_argument(\"--codec\", default=\"p4flat,chunk_delta3\")\n    parser.add_argument(\"--warmup\", type=int, default=5)\n    parser.add_argument(\"--iterations\", type=int, default=20)\n    parser.add_argument(\"--single-process\", action=\"store_true\",\n                        help=argparse.SUPPRESS)\n    args = parser.parse_args()\n    block_counts = [int(value) for value in args.blocks.split(\",\")]\n    codec_names = [value.strip() for value in args.codec.split(\",\")]\n    if len(block_counts) > 1 and not args.single_process:\n        # P4Flat's pinned multi-buffer batch_h2d path is not safely reusable\n        # after changing the matrix size in one process on GH200.  Isolating\n        # sweep points also prevents allocator history from biasing timings.\n        for n in block_counts:\n            subprocess.run([\n                sys.executable, os.path.abspath(__file__),\n                \"--path\", args.path,\n                \"--blocks\", str(n),\n                \"--codec\", args.codec,\n                \"--warmup\", str(args.warmup),\n                \"--iterations\", str(args.iterations),\n                \"--single-process\",\n            ], check=True)\n        return\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n        host_k, host_v = _load(args.path, n)\n        print(f\"\\nKV blocks={n}, matrix=[{n * ROWS_PER_BLOCK}, {COLS}] x K/V\")\n        for name in codec_names:\n            _bench(name, host_k, host_v, args.warmup, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05707-953f-7740-b541-b3122741c3a1","create_time":1788166738.8912237}}}
