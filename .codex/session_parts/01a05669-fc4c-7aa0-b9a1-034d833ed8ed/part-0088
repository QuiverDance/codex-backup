e_guard(source.device());\n        if not do_cpu_comp:\n            if _ENV_KV_DETAILED_NVTX:\n                torch.cuda.nvtx.range_push(\"schedule_unload_uncompressed_only\")\n            self.kv_offload_scheduler.schedule_unload_uncompressed(\n                kv_sys, layer_id, self.kv_buffer_ids,\n                self.kv_unload_done[layer_id].cuda_event,\n                already_sorted=True, wait_event=self.unload_kv_barriers[layer_id])\n            if _ENV_KV_DETAILED_NVTX:\n                torch.cuda.nvtx.range_pop()\n        # Current layer is a KV-comp target.  Producer mode selects whether\n        # compression consumes the primary GPU tensor or the raw host copy.\n        #\n        # Producer mode semantics (TIERED_SERVE_KV_COMP_PRODUCER):\n        #   gpu_direct:\n        #     For ZipServ → schedule_pipeline_offload feeds the C++\n        #     KVCompressWorkerManager (private D2H + CPU compress).\n        #     For DietGPU/MantExp → GPU compress kernels run on\n        #     comp_stream (uses GPU SMs for compression).\n        #     schedule_unload_uncompressed runs in parallel to populate\n        #     raw secondary_kv for prefill reads.\n        #\n        #   cpu_after_raw_swap (forced for ZipServ and CPU-only backends):\n        #     First populate secondary_kv with the normal raw D2H, then\n        #     have the backend's CPU workers wait on kv_unload_done and read\n        #     directly from secondary_kv.  For ZipServ this selects the\n        #     accelerated C++ host-zero-copy worker path, skipping its private\n        #     primary→staging D2H while keeping raw secondary available for\n        #     chunked-prefill/mixed batches.\n        else:\n            if _ENV_KV_DETAILED_NVTX:\n                torch.cuda.nvtx.range_push(\"valid_ids_filter\")\n            num_primary = DualMemoryLoader.primary_k_caches[layer_id].shape[0]\n            # valid_ids is IDENTICAL for every layer in a step: kv_buffer_ids is\n            # rebuilt once per 