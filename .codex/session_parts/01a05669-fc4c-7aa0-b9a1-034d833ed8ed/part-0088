, uint16_t*, int, int);\nextern \"C\" cudaError_t CD3_Decompress(\n    cudaStream_t, const uint8_t*, const uint8_t*, const uint8_t*,\n    const int32_t*, const uint64_t*, uint16_t*, int, int);\n\nnamespace {\n\nconstexpr int kTileDim = 64;\nconstexpr int kTileElements = kTileDim * kTileDim;\nconstexpr int kThreads = 256;\nconstexpr int kCodeBytesPerTile = kTileElements * 3 / 8;\nconstexpr int kWarpsPerTile = kThreads / 32;\n\nint64_t tensor_bytes(const torch::Tensor& tensor)\n{\n    return tensor.numel() * tensor.element_size();\n}\n\nvoid check_cuda_error(cudaError_t error, const char* operation)\n{\n    TORCH_CHECK(\n        error == cudaSuccess,\n        operation, \" failed: \", cudaGetErrorString(error));\n}\n\ncudaStream_t current_stream()\n{\n    return c10::cuda::getCurrentCUDAStream().stream();\n}\n\nvoid check_cuda_contiguous(const torch::Tensor& tensor, const char* name)\n{\n    TORCH_CHECK(tensor.is_cuda(), name, \" must be a CUDA tensor\");\n    TORCH_CHECK(tensor.is_contiguous(), name, \" must be contiguous\");\n}\n\nvoid check_byte(const torch::Tensor& tensor, const char* name)\n{\n    check_cuda_contiguous(tensor, name);\n    TORCH_CHECK(tensor.scalar_type() == at::kByte, name, \" must be uint8\");\n}\n\nvoid check_short_storage(const torch::Tensor& tensor, const char* name)\n{\n    check_cuda_contiguous(tensor, name);\n    TORCH_CHECK(\n        tensor.scalar_type() == at::kShort,\n        name, \" must use int16 storage\");\n}\n\nvoid check_int(const torch::Tensor& tensor, const char* name)\n{\n    check_cuda_contiguous(tensor, name);\n    TORCH_CHECK(tensor.scalar_type() == at::kInt, name, \" must be int32\");\n}\n\nvoid check_long(const torch::Tensor& tensor, const char* name)\n{\n    check_cuda_contiguous(tensor, name);\n    TORCH_CHECK(tensor.scalar_type() == at::kLong, name, \" must be int64\");\n}\n\nvoid check_source(const torch::Tensor& source)\n{\n    check_cuda_contiguous(source, \"source\");\n    TORCH_CHECK(source.dim() == 2, \"source must be two-dimensional\");\n    TORCH_CHECK(\n        source.scalar_type() == at::kBFloat16,\n        \"source must be bfloat16\");\n    TORCH_CHECK(\n        source.size(0) > 0 && source.size(1) > 0\n            && source.size(0) % kTileDim == 0\n            && source.size(1) % kTileDim == 0,\n        \"source dimensions must be positive multiples of 64\");\n}\n\nvoid check_output(\n    const torch::Tensor& output,\n    int64_t rows,\n    int64_t columns)\n{\n    check_cuda_contiguous(output, \"output\");\n    TORCH_CHECK(\n        output.scalar_type() == at::kBFloat16,\n        \"output must be bfloat16\");\n    TORCH_CHECK(\n        output.dim() == 2 && output.size(0) == rows\n            && output.size(1) == columns,\n        \"output must have shape [\", rows, \", \", columns, \"]\");\n}\n\ntorch::Tensor build_exception_offsets(torch::Tensor tile_counts)\n{\n    check_int(tile_counts, \"tile_exception_counts\");\n    auto zero = torch::zeros({1}, tile_counts.options());\n    auto cumulative = torch::cumsum(tile_counts, 0, at::kInt);\n    return torch::cat({zero, cumulative}, 0).contiguous();\n}\n\nint64_t read_num_exceptions(const torch::Tensor& offsets)\n{\n    return static_cast<int64_t>(\n        offsets.index({offsets.numel() - 1}).item<int32_t>());\n}\n\nstruct CompressedTilePalette3 {\n    torch::Tensor palettes8;\n    torch::Tensor codes;\n    torch::Tensor sign_mantissa;\n    torch::Tensor tile_exception_offsets;\n    torch::Tensor warp_prefixes;\n    torch::Tensor entries17;\n    int64_t M = 0;\n    int64_t K = 0;\n    int64_t num_exceptions = 0;\n\n    int64_t nbytes() const\n    {\n        return tensor_bytes(palettes8)\n            + tensor_bytes(codes)\n            + tensor_bytes(sign_mantissa)\n            + tensor_bytes(tile_exception_offsets)\n            + tensor_bytes(warp_prefixes)\n            + tensor_bytes(entries17);\n    }\n\n    int64_t frozen_hbm_bytes() const\n    {\n        return tensor_bytes(sign_mantissa)\n            + tensor_bytes(palettes8)\n            + tensor_bytes(tile_exception_offsets)\n            + tensor_bytes(warp_prefixes);\n    }\n\n    int64_t frozen_transfer_bytes() const\n    {\n        return tensor_bytes(codes) + tensor_bytes(entries17);\n    }\n};\n\nstruct CompressedChunkDelta3 {\n    torch::Tensor codes;\n    torch::Tensor sign_mantissa;\n    torch::Tensor thread_bases;\n    torch::Tensor tile_exception_offsets;\n    torch::Tensor entries20x3;\n    int64_t M = 0;\n    int64_t K = 0;\n    int64_t num_exceptions = 0;\n\n    int64_t nbytes() const\n    {\n        return tensor_bytes(codes)\n            + tensor_bytes(sign_mantissa)\n            + tensor_bytes(thread_bases)\n            + tensor_bytes(tile_exception_offsets)\n            + tensor_bytes(entries20x3);\n    }\n\n    int64_t frozen_hbm_bytes() const\n    {\n        return tensor_bytes(sign_mantissa)\n            + tensor_bytes(tile_exception_offsets);\n    }\n\n    int64_t frozen_transfer_bytes() const\n    {\n        return tensor_bytes(codes)\n            + tensor_bytes(thread_bases)\n            + tensor_bytes(entries20x3);\n    }\n};\n\nCompressedTilePalette3 compress_tile_palette3(torch::Tensor source)\n{\n    check_source(source);\n    const c10::cuda::CUDAGuard device_guard(source.device());\n    const int64_t rows = source.size(0);\n    const int64_t columns = source.size(1);\n    const int64_t num_tiles =\n        (rows / kTileDim) * (columns / kTileDim);\n    const auto byte_options = source.options().dtype(at::kByte);\n    const auto int_options = source.options().dtype(at::kInt);\n\n    CompressedTilePalette3 compressed;\n    compressed.palettes8 = torch::empty({num_tiles * 8}, byte_options);\n    compressed.codes = torch::empty(\n        {num_tiles * kCodeBytesPerTile}, byte_options);\n    compressed.sign_mantissa = torch::empty(\n        {num_tiles * kTileElements}, byte_options);\n    auto tile_counts = torch::empty({num_tiles}, int_options);\n    check_cuda_error(\n        TP3_CompressPass1(\n  