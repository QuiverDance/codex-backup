turn err;\n   724\t    }\n   725\t#else\n   726\t    return cudaErrorNotSupported;\n   727\t#endif\n   728\t}\n   729\t\n   730\t// ============================================================================\n   731\t// ChunkDelta3 RS-mode fused decode + GEMM.\n   732\t//\n   733\t// One 64x64 CD3 tile stores 3-bit exponent deltas in thread-major order:\n   734\t// 256 logical encoder threads, each owning one contiguous 16-value row chunk.\n   735\t// The matching base exponent is one byte per logical thread and sign/mantissa\n   736\t// is one raw byte per value.  Decode writes the reconstructed BF16 values\n   737\t// directly into the WGMMA register-A fragment, so no dense weight is emitted.\n   738\t//\n   739\t// CD3 exceptions are frequent enough on real weights that a sparse output\n   740\t// correction pass is a poor fit.  Instead each block expands only the current\n   741\t// tile's packed 17-bit exception records into a shared exponent override map\n   742\t// before constructing register A.  The WGMMA therefore consumes the exact\n   743\t// lossless weight, and split-K remains valid.\n   744\t// ============================================================================\n   745\ttemplate <int TileN, int Stages>\n   746\tstruct CD3RSSmem {\n   747\t    using SmemLayoutB = decltype(cute::tile_to_shape(\n   748\t        cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n   749\t        cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{}, cute::Int<Stages>{})));\n   750\t    alignas(128) cute::ArrayEngine<cute::bfloat16_t, cute::cosize_v<SmemLayoutB>> B;\n   751\t    alignas(16) uint8_t s_codes[Stages][1536];       // 4096 packed 3-bit codes\n   752\t    alignas(16) uint8_t s_sm[Stages][4096];          // raw sign|mantissa\n   753\t    alignas(16) uint8_t s_bases[Stages][256];        // base per 16-value chunk\n   754\t    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\n   755\t    alignas(16) uint32_t s_exc_mask[Stages