uences, expected batch={batch}: {token_path}\\\")\\n    actual = [len(tokens) if isinstance(tokens, list) else -1\\n              for tokens in payload]\\n    expected = [GENERATION_TOKENS] * batch\\n    if actual != expected:\\n        raise RuntimeError(\\n            f\\\"generated-token lengths are not exactly {GENERATION_TOKENS}: \\\"\\n            f\\\"batch={batch} expected={expected} actual={actual}\\\")\\n    return {\\n        \\\"generation_tokens\\\": GENERATION_TOKENS,\\n        \\\"generation_length_policy\\\": \\\"fixed_per_request\\\",\\n        \\\"prefill_chunk_tokens\\\": PREFILL_CHUNK,\\n        \\\"generated_tokens_path\\\": str(token_path),\\n        \\\"generated_tokens_sha256\\\": _sha(token_path),\\n    }\\n\\n\\ndef _model_source_metadata() -> dict[str, Any]:\\n    \\\"\\\"\\\"Resolve the exact local HF snapshot and fingerprint its shard manifest.\\n\\n    Reading every 70B shard merely to re-hash content would add hundreds of GB\\n    of I/O before each orchestration run.  Hugging Face stores LFS weights under\\n    their content SHA256 blob names, so we validate those names and hash the\\n    deterministic ``filename:blob-sha:size`` manifest together with the index.\\n    \\\"\\\"\\\"\\n    hf_home = Path(os.environ.get(\\n        \\\"HF_HOME\\\", str(Path.home() / \\\".cache\\\" / \\\"huggingface\\\")))\\n    hub = Path(os.environ.get(\\\"HF_HUB_CACHE\\\", str(hf_home / \\\"hub\\\")))\\n    repo = hub / \\\"models--meta-llama--Llama-3.1-70B-Instruct\\\"\\n    ref = repo / \\\"refs\\\" / \\\"main\\\"\\n    if not ref.is_file():\\n        raise FileNotFoundError(\\n            f\\\"cannot resolve the local checkpoint revision: {ref}\\\")\\n    revision = ref.read_text().strip()\\n    if not re.fullmatch(r\\\"[0-9a-f]{40}\\\", revision):\\n        raise RuntimeError(f\\\"invalid Hugging Face revision in {ref}: {revision!r}\\\")\\n    snapshot = repo / \\\"snapshots\\\" / revision\\n    index = snapshot / \\\"model.safetensors.index.json\\\"