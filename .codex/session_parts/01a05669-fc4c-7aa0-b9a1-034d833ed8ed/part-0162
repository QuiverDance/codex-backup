\\n            for attr in info.lpddr_attrs:\\n                setattr(c, attr, src_bufs[attr].narrow(0, 0, ln[attr]))\\n            c.M = info.M\\n            c.K = info.K\\n            c.num_exceptions = info.num_exceptions\\n            _p3f_ext.decompress(c, output)\\n        else:  # zipserv (BF16)\\n            # tile_offsets_* are HBM-resident (info.hbm_buffers), exact\\n            # size — they are not part of src_bufs / the per-decode H2D.\\n            # When sign_mantissa is the canonical (M,K) row-major form, pass it\\n            # as canonical_sm — the kernel reads HF sm there (no compacted SM\\n            # staging). info.sign_mantissa is the same buffer in that case.\\n            _canon = (info.sign_mantissa\\n                      if getattr(info, \\\"_uses_canonical_sm\\\", False) else None)\\n            backend_compressor._ext.decompress(\\n                info.sign_mantissa,\\n                src_bufs[\\\"compressed_full\\\"].narrow(0, 0, ln[\\\"compressed_full\\\"]),\\n                src_bufs[\\\"bitmap1\\\"].narrow(0, 0, ln[\\\"bitmap1\\\"]),\\n                src_bufs[\\\"bitmap2\\\"].narrow(0, 0, ln[\\\"bitmap2\\\"]),\\n                src_bufs[\\\"bitmap3\\\"].narrow(0, 0, ln[\\\"bitmap3\\\"]),\\n                info.hbm_buffers[\\\"tile_offsets_median\\\"],\\n                info.hbm_buffers[\\\"tile_offsets_global\\\"],\\n                info.max_high_freq_count,\\n                info.max_full_count,\\n                info.start_exp,\\n                output,\\n                info.M, info.K,\\n                gt_m_base, num_row_tiles,\\n                _canon)\\n\\n    def _ensure_prefill_war_events(self):\\n        \\\"\\\"\\\"Lazily allocate per-(comp, parity) WAR events for the prefill\\n        raw_bf16 path.\\n\\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\\n        2*M*K H2D into the primary buffer moves OFF exec onto\\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\\n        GEMMs instead of serialising on exec, since\\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\\n        a cross-stream resource shared across parity-PARITY layers, so the\\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\\n        has finished reading it.  One event per (comp, parity); pre-recorded\\n        so the first PARITY layers (fresh buffers) never block on a\\n        never-recorded event.\\n        \\\"\\\"\\\"\\n        if getattr(self, \\\"_prefill_war_events\\\", None) is not None:\\n            return\\n        self._prefill_war_events = {\\n            comp_key: [torch.cuda.Event(external=True)\\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\\n            for comp_key in (\\\"qkv\\\", \\\"o\\\", \\\"gate_up\\\", \\\"down\\\")\\n        }\\n        for events in self._prefill_war_events.values():\\n            for ev in events:\\n                ev.record()  # pre-signal\\n\\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\\n                                          info, skip_kernel: bool = False,\\n                                          h2d_ctx_held: bool = False,\\n                                          collect_into=None\\n                                          ) -> None:\\n        \\\"\\\"\\\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\\n        staging then backend-specific decompress + reconstruct.  The fused\\n        H2D-only caller may hold ``load_weight_stream``; dense paths hold\\n        ``decomp_weight_stream``.\\n\\n        Picks the layer's parity-specific staging + output buffer so\\n        adjacent layers can run their H2D + kernel in parallel against\\n        physically disjoint memory.  staging and output may use\\n        different parity depths (see FROZEN_*_PARITY init).\\n\\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\\n        H2D into staging still runs (fused_mm reads from the same\\n        staging slot at forward time) but the dense reconstruct kernel\\n        is skipped.  The staging-slot serialisation is then handled by\\n        ``kernel_done_event`` recorded inside the fused custom op\\n        after it reads the slot, rather than here after the kernel.\\n        \\\"\\\"\\\"\\n        if not getattr(DualMemoryLoader, \\\"_logged_dfs_entry\\\", False):\\n            DualMemoryLoader._logged_dfs_entry = True\\n            logger.info(\\n                \\\"[DFS first-call] layer_id=%d name=%s \\\"\\n                \\\"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\\\",\\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\\n                self._ats_decomp_frozen, skip_kernel)\\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\\n        staging = self.frozen_split_staging[name][staging_parity]\\n        output = self.frozen_primary_buffer_pair[name][output_parity]\\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\\n        # graph still use the phase policy. For eager chunks this selects\\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\\n        # retain the fused compressed-staging path through ``skip_kernel``.\\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\\n        # through to the primary split reconstruct path below.\\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\\n        # event itself (on load_weight_stream); this flag tells the caller to\\n        # skip its default exec-stream record for that case.\\n        self._last_prefill_raw_recorded = False\\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\\n        # returns right after the H2D without using it, so skip this\\n        # per-projection, per-layer resolution (a getattr chain +\\n        # _get_or_make_backend) on that hot path.\\n        backend_compressor = (\\n            None if (skip_kernel and not is_prefill\\n                     and not self._ats_decomp_frozen)\\n            else self._resolve_backend_compressor(\\n                info, layer_id, self.tensor_to_component.get(name)))\\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\\n\\n        if is_prefill and not skip_kernel:\\n            # Large eager prefill weight materialization: the fused custom op\\n            # reads the leaf's dense primary weight for N above the CUDA graph\\n            # ceiling, so populate that buffer here.  Native non-fused prefill\\n            # reads the same output.\\n            #\\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\\n            # staging exactly like decode; only eager large prefill comes here.\\n            if (info.alt is not None and self.cur_num_tokens\\n                    < self._alt_max_chunk_for(info.alt.backend)):\\n                if detailed_nvtx:\\n                    torch.cuda.nvtx.range_push(\\n                        f\\\"frozen_split_prefill_alt L{layer_id}.{name}\\\")\\n                alt = info.alt\\n                # Unified alt reuses the resolved concrete compressor (the\\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\\n                alt_comp = (backend_compressor\\n                            if alt.backend == info.backend\\n                            else self._get_or_make_backend(alt.backend))\\n                self._materialize_frozen_split_prefill_alt(\\n                    layer_id, name, alt, output, alt_comp)\\n                if detailed_nvtx:\\n                    torch.cuda.nvtx.range_pop()\\n                return\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_push(\\n                    f\\\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\\\")\\n            src = info.lpddr_buffers[\\\"raw_bf16\\\"]\\n            comp_key = self.tensor_to_component.get(name)\\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\\n            # on exec (decomp_weight_stream == exec_stream).  This is only\\n            # correct when the consuming graph has a per-component readiness\\n            # wait, either from the FX pass or directly in the fused custom op.\\n            _component_waits = (\\n                (getattr(type(self), \\\"_v1_weight_waits_active\\\", False)\\n                 or getattr(self, \\\"_v1_fused_weight_waits_complete\\\", False))\\n                and comp_key is not None\\n                and hasattr(self, \\\"frozen_decomp_events\\\")\\n            )\\n            if _component_waits:\\n                # The primary buffer `output` is now written cross-stream, so\\n                # guard it with the WAR events.\\n                self._ensure_prefill_war_events()\\n                war = self._prefill_war_events.get(comp_key)\\n                P = self.FROZEN_DECOMP_PARITY\\n                if war is not None:\\n                    # Default path: free the prior layer's slot for this comp\\n                    # inline.  V1 prefill eager lookahead disables this record\\n                    # and lets the wrapper mark slots free after the eager piece\\n                    # actually consumes them; otherwise scheduling graph K+1\\n                    # before graph K would falsely free graph K's qkv slot.\\n                    if not getattr(self, \\\"_v1_prefill_raw_external_war\\\",\\n                                   False):\\n                        war[(layer_id - 1) % P].record(self.exec_stream)\\n                    # WAR: this H2D overwrites slot L%P, last read by layer\\n                    # (L-PARITY)'s GEMM.  Layers < PARITY are first occupants\\n                    # (fresh buffer) → no prior reader → skip.\\n                    if layer_id >= P:\\n                        self.load_weight_stream.wait_event(war[layer_id % P])\\n                with torch.cuda.stream(self.load_weight_stream):\\n                    output.view(src.shape).copy_(src, non_blocking=True)\\n                # RAW: record weight-ready on load_weight_stream so the FX\\n                # wait_frozen_weight makes the GEMM wait for THIS H2D.  Suppress\\n                # the caller's default exec-stream record (it would shadow this\\n                # with an already-complete event → torn weight read).\\n                self.frozen_decomp_events[comp_key][layer_id].record(\\n                    self.load_weight_stream)\\n                self._last_prefill_raw_recorded = True\\n            else:\\n                # Fallback: move H2D off exec_stream onto load_weight_stream\\n                # so the copy overlaps compute instead of blocking the GEMM\\n                # stream.  The caller records frozen_decomp_events on\\n                # decomp_weight_stream after this returns; the wait_stream\\n                # below ensures that event fires only after the H2D completes.\\n                with torch.cuda.stream(self.load_weight_stream):\\n                    output.view(src.shape).copy_(src, non_blocking=True)\\n                self.decomp_weight_stream.wait_stream(\\n                    self.load_weight_stream)\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_pop()\\n            return\\n\\n        # Decode path: H2D on load_weight_stream, decompress kernel on\\n        # decomp_weight_stream, fused via per-(layer,name) events.\\n        #\\n        # Sync model:\\n        #   * H2D waits on kernel_done[name, parity] from the previous\\n        #     use of the same physical staging slot so it doesn't overwrite\\n        #     `staging` while the prior kernel is still reading it.\\n        #   * Kernel waits on h2d_event[layer,name] for *this* H2D only,\\n        #     so the next tensor's H2D can run concurrently with this\\n        #     kernel on the decompress stream.\\n        kernel_done_event = self._frozen_split_kernel_done_event(\\n            layer_id, name)\\n        # Timing events (h2d_begin/end, split_decomp begin/end) are consumed\\n        # only by the --time-breakdown diagnostic.  Fetch + record them only\\n        # when it's enabled so the decode hot path stays event-light.\\n        tb = self.time_breakdown\\n\\n        if self._ats_decomp_frozen:\\n            # ATS path: the LPDDR hugepage is already cudaHostRegister-\\n            # mapped, so the GPU kernel dereferences the host pointer\\n            # directly via ATS / NVLink-C2C UVA. No H2D, no staging.\\n            if not getattr(self, \\\"_ats_decomp_logged\\\", False):\\n                sample = info.lpddr_buffers[info.lpddr_attrs[0]]\\n                logger.info(\\n                    \\\"[ATS-decomp] first decompress L%d.%s src device=%s \\\"\\n                    \\\"ptr=0x%x\\\",\\n                    layer_id, name, sample.device, sample.data_ptr())\\n                self._ats_decomp_logged = True\\n\\n            if skip_kernel:\\n                # ATS + fused_mm: there is no GPU staging slot to populate\\n                # (the kernel was going to read straight from LPDDR via\\n                # ATS).  fused_mm reads the same LPDDR buffers via the\\n                # shell built at install time, so nothing happens here.\\n                # ``kernel_done_event`` is recorded by the custom op\\n                # after fused_mm completes.\\n                return\\n\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_push(\\n                    f\\\"frozen_split_{info.backend}_decomp_ats \\\"\\n                    f\\\"frozen_split_{info.backend}_decomp_ats \\\"\\n                    f\\\"L{layer_id}.{name}\\\")\\n            # Timing BEGIN/END around the decompress kernel for the\\n            # time-breakdown only.  Caller already set decomp_weight_stream\\n            # as current; record on that stream explicitly to match\\n            # H2D-side instrumentation semantics.\\n            if tb:\\n                self._frozen_split_decomp_begin_timing_event(\\n                    layer_id, name).record(self.decomp_weight_stream)\\n            self._frozen_split_run_decompress(\\n                info, info.lpddr_buffers, info.lpddr_numels,\\n                output, backend_compressor)\\n            if tb:\\n                self._frozen_split_decomp_end_timing_event(\\n                    layer_id, name).record(self.decomp_weight_stream)\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_pop()\\n            kernel_done_event.record(self.decomp_weight_stream)\\n            return\\n\\n        h2d_event = self._frozen_split_h2d_event(layer_id, name)\\n        # Block this H2D against the previous use of the same physical\\n        # staging slot.  DIAGNOSTIC (WLOAD_GRAPH): skip during cudagraph capture\\n        # — waiting on an external event (kernel_done, recorded outside this\\n        # capture) can detach load_weight from the capture so the H2D below is\\n        # not recorded into the graph (replay then never loads -> stale weights).\\n        if (not _ENV_ANY_WLOAD_GRAPH\\n                or not torch.cuda.is_current_stream_capturing()):\\n            self.load_weight_stream.wait_event(kernel_done_event)\\n        if tb:\\n            h2d_begin = self._frozen_split_h2d_begin_event(layer_id, name)\\n            h2d_end_timing = self._frozen_split_h2d_end_timing_event(\\n                layer_id, name)\\n        # Pipeline the (zipserv BF16) H2D + decode in row-tile groups so\\n        # group g+1's H2D overlaps group g's decode.  Disabled for the\\n        # fused_mm (skip_kernel) path, which needs the whole staging slot\\n        # populated for the matmul to read; QKV/O are left whole.\\n        plan = None if skip_kernel else self._zipserv_pipeline_plan(\\n            info, self.tensor_to_component.get(name))\\n\\n        if plan is None and collect_into is not None:\\n            # #8 batched H2D: defer the copy + h2d_event.record + decomp\\n            # wait_event to the caller, which issues ONE batch_memcpy for ALL\\n            # projections then records each event.  The WAR guard\\n            # (load_weight_stream.wait_event(kernel_done_event)) already ran\\n            # above, so the staging slot is safe to overwrite.\\n            single = getattr(info, \\\"_zs_single_slices\\\", None)\\n            if single is None:\\n                single = (\\n                    [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\\n                     for attr in info.lpddr_attrs],\\n                    [info.lpddr_buffers[attr]\\n                     for attr in info.lpddr_attrs])\\n                info._zs_single_slices = single\\n            collect_into.append((single[0], single[1], h2d_event))\\n            return\\n\\n        if plan is None:\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_push(\\n                    f\\\"frozen_split_h2d L{layer_id}.{name}\\\")\\n            # When the caller (decompress_frozen_tensors, all-fused decode path)\\n            # already holds the load_weight_stream context for the whole\\n            # projection loop, stream(None) is a no-op — the copy below\\n            # reads current_stream() = load_weight_stream and the records are\\n            # explicit, so we skip the per-projection stream-context churn.\\n            with torch.cuda.stream(None if h2d_ctx_held else self.load_weight_stream):\\n                # BEGIN/END timing markers for the time-breakdown\\n                # diagnostic, paired with the sync h2d_event below.\\n                # frozen_split keeps sign_mantissa on HBM but H2D's the\\n                # compressed-exp/aux buffers every decode step, so this is\\n                # the dominant Weight Load source in frozen_split configs\\n                # and was being missed by the per-layer\\n                # begin_memcpy_weight_events filter.  Two separate END\\n                # events because the sync one (h2d_event) must have\\n                # enable_timing=False for cross-stream wait semantics.\\n                if tb:\\n                    h2d_begin.record(self.load_weight_stream)\\n                # Single coalesced H2D for all codec buffers (QKV/O and any\\n                # non-pipelined tensor load in one dispatch, not one-per-attr).\\n                # dst/src views are fixed across decode steps (parity-stable\\n                # staging, fixed lpddr_buffers, fixed numels), so build them\\n                # once and cache on info instead of re-slicing every step.\\n                single = getattr(info, \\\"_zs_single_slices\\\", None)\\n                if single is None:\\n                    single = (\\n                        [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\\n                         for attr in info.lpddr_attrs],\\n                        [info.lpddr_buffers[attr]\\n                         for attr in info.lpddr_attrs])\\n                    info._zs_single_slices = single\\n                    # Cache the raw dst/src/size arrays alongside the views so\\n                    # the batched H2D goes through batch_memcpy_ptrs (no per-call\\n                    # tensor->ptr rebuild).  Stable for the same reason the views\\n                    # are (parity-fixed staging, immutable LPDDR buffers/numels).\\n                    info._zs_ptr_arrays = (\\n                        [d.data_ptr() for d in single[0]],\\n                        [s.data_ptr() for s in single[1]],\\n                        [s.numel() * s.element_size() for s in single[1]])\\n                # h2d_ctx_held => caller holds torch.cuda.stream(load_weight_stream),\\n                # so current_stream() == load_weight_stream: pass its cached raw\\n                # handle and skip the per-call current_stream() driver lookup.\\n                _sh = self._lw_stream_handle() if h2d_ctx_held else None\\n                self._coalesced_h2d(single[0], single[1],\\n                                    info._zs_ptr_arrays, _sh)\\n                h2d_event.record(self.load_weight_stream)\\n                if tb:\\n                    h2d_end_timing.record(self.load_weight_stream)\\n            if detailed_nvtx:\\n                torch.cuda.nvtx.range_pop()  # frozen_split_h2d\\n            if skip_kernel:\\n                # fused_mm path: H2D is enough — the kernel that consumes\\n                # the staging slot is the fused matmul, fired by the\\n                # rewritten Linear forward on exec_stream.  The\\n                # ``frozen_decomp_events`` recorded by the caller after we\\n …2043 tokens truncated…     \\\"h2d_mib\\\": h2d_bytes / 2**20,\\n        \\\"h2d_p50_ms\\\": _stats(copies)[1],\\n        \\\"h2d_p95_ms\\\": _stats(copies)[2],\\n        \\\"fused_p50_ms\\\": _stats(kernels)[1],\\n        \\\"fused_p95_ms\\\": _stats(kernels)[2],\\n        \\\"h2d_fused_p50_ms\\\": _stats(totals)[1],\\n        \\\"h2d_fused_p95_ms\\\": _stats(totals)[2],\\n        \\\"correctness\\\": True,\\n    }\\n    del comp, codec, weight, x, actual, expected, scratch\\n    del host_sources, device_staging, host_slab, ptrs\\n    gc.collect()\\n    torch.cuda.empty_cache()\\n    return result\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\\"--weights-dir\\\", default=DEFAULT_WEIGHTS_DIR)\\n    parser.add_argument(\\\"--layer\\\", type=int, default=40)\\n    parser.add_argument(\\\"--n\\\", type=int, default=64)\\n    parser.add_argument(\\\"--warmup\\\", type=int, default=20)\\n    parser.add_argument(\\\"--iterations\\\", type=int, default=200)\\n    parser.add_argument(\\\"--no-flush\\\", action=\\\"store_true\\\")\\n    parser.add_argument(\\\"--csv\\\", required=True)\\n    args = parser.parse_args()\\n    if args.layer != 40:\\n        raise ValueError(\\\"this benchmark currently records layer 40 only\\\")\\n\\n    shapes = proj_shapes(1)\\n    weights = load_real_projections(\\n        args.weights_dir, shapes, layer=args.layer)\\n    rows = []\\n    print(torch.cuda.get_device_name())\\n    print(\\\"CAO: exponent H2D -> fused GEMM; sign/mantissa resident in HBM\\\")\\n    for codec_name in (\\\"p4flat\\\", \\\"chunk_delta3\\\"):\\n        for proj in (\\\"qkv\\\", \\\"o\\\", \\\"gate_up\\\", \\\"down\\\"):\\n            row = _bench_one(\\n                codec_name, proj, weights[proj], args.n,\\n                args.warmup, args.iterations, not args.no_flush)\\n            rows.append(row)\\n            print(\\n                f\\\"{codec_name:12s} {proj:7s} exp={row['h2d_mib']:7.2f} MiB \\\"\\n                f\\\"H2D={row['h2d_p50_ms']:.3f} ms \\\"\\n                f\\\"fused={row['fused_p50_ms']:.3f} ms \\\"\\n                f\\\"total={row['h2d_fused_p50_ms']:.3f} ms \\\"\\n                f\\\"p95={row['h2d_fused_p95_ms']:.3f} ms\\\")\\n\\n    with open(args.csv, \\\"w\\\", newline=\\\"\\\") as f:\\n        writer = csv.DictWriter(f, fieldnames=list(rows[0]))\\n        writer.writeheader()\\n        writer.writerows(rows)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Shared, allocation-stable helpers for the fused-kernel benchmarks.\\n\\nThe benchmark entry points deliberately keep GEMM orchestration and metadata\\nhere so every run uses the same timing and provenance semantics.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport csv\\nimport gc\\nimport hashlib\\nimport os\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\nimport statistics\\nimport subprocess\\nfrom typing import Any, Callable, Iterable, Mapping, Optional\\n\\nimport torch\\n\\n\\n@dataclass(frozen=True)\\nclass LatencyStats:\\n    \\\"\\\"\\\"CUDA event latency samples and the two published percentiles.\\\"\\\"\\\"\\n\\n    p50_ms: float\\n    p95_ms: float\\n    samples_ms: tuple[float, ...]\\n\\n\\ndef _percentile(values: list[float], q: float) -> float:\\n    \\\"\\\"\\\"Linear percentile matching NumPy's default without adding a dependency.\\\"\\\"\\\"\\n    if not values:\\n        raise ValueError(\\\"cannot compute a percentile of an empty sample\\\")\\n    ordered = sorted(float(v) for v in values)\\n    if len(ordered) == 1:\\n        return ordered[0]\\n    pos = (len(ordered) - 1) * q\\n    lo = int(pos)\\n    hi = min(lo + 1, len(ordered) - 1)\\n    frac = pos - lo\\n    return ordered[lo] * (1.0 - frac) + ordered[hi] * frac\\n\\n\\nclass H2DContender:\\n    \\\"\\\"\\\"Saturate a copy engine without synchronizing the compute stream.\\\"\\\"\\\"\\n\\n    def __init__(self, nbytes: int, max_bytes: int = 256 * 1024 * 1024):\\n        self.nbytes = max(1 << 20, min(int(nbytes), int(max_bytes)))\\n        self.stream = torch.cuda.Stream()\\n        self.host = torch.empty(self.nbytes, dtype=torch.uint8, pin_memory=True)\\n        self.device = torch.empty(self.nbytes, dtype=torch.uint8, device=\\\"cuda\\\")\\n        self._closed = False\\n\\n    def refill(self, copies: int) -> None:\\n        if self._closed:\\n            raise RuntimeError(\\\"H2DContender is closed\\\")\\n        with torch.cuda.stream(self.stream):\\n            for _ in range(copies):\\n                self.device.copy_(self.host, non_blocking=True)\\n\\n    def drain(self) -> None:\\n        self.stream.synchronize()\\n\\n    def close(self) -> None:\\n        \\\"\\\"\\\"Release pinned storage between independently sized benchmark cells.\\n\\n        PyTorch's caching host allocator otherwise retains every differently\\n        sized contender buffer. A long scaling sweep can cross the GH200 pinned\\n        registration limit even though each individual cell fits, causing a\\n        later cudaMemcpyAsync to fail with cudaErrorInvalidValue. Drain before\\n        dropping the tensors, then empty only the host cache; this runs outside\\n        every timed region.\\n        \\\"\\\"\\\"\\n        if self._closed:\\n            return\\n        self.drain()\\n        self._closed = True\\n        self.host = None\\n        self.device = None\\n        self.stream = None\\n        gc.collect()\\n        empty_host_cache = getattr(torch._C, \\\"_host_emptyCache\\\", None)\\n        if empty_host_cache is not None:\\n            empty_host_cache()\\n\\n\\ndef bench_cuda(\\n    fn: Callable[[], Any],\\n    warmup: int,\\n    iters: int,\\n    *,\\n    flush_fn: Optional[Callable[[], None]] = None,\\n    contender: Optional[H2DContender] = None,\\n    copies_per_iter: int = 8,\\n) -> LatencyStats:\\n    \\\"\\\"\\\"Time ``fn`` on the current stream and return P50/P95 in milliseconds.\\n\\n    ``Event.synchronize`` waits only for the measured compute stream.  A global\\n    synchronize here would serialize the optional H2D stream and invalidate the\\n    contention experiment.\\n    \\\"\\\"\\\"\\n    if warmup < 0 or iters <= 0:\\n        raise ValueError(f\\\"warmup must be >=0 and iters >0, got {warmup}/{iters}\\\")\\n    if contender is not None:\\n        contender.refill(copies_per_iter * (warmup + 2))\\n    for _ in range(warmup):\\n        fn()\\n    torch.cuda.current_stream().synchronize()\\n\\n    samples: list[float] = []\\n    for _ in range(iters):\\n        if contender is not None:\\n            contender.refill(copies_per_iter)\\n        if flush_fn is not None:\\n            flush_fn()\\n        begin = torch.cuda.Event(enable_timing=True)\\n        end = torch.cuda.Event(enable_timing=True)\\n        begin.record()\\n        fn()\\n        end.record()\\n        end.synchronize()\\n        samples.append(float(begin.elapsed_time(end)))\\n    if contender is not None:\\n        contender.drain()\\n    return LatencyStats(\\n        p50_ms=float(statistics.median(samples)),\\n        p95_ms=_percentile(samples, 0.95),\\n        samples_ms=tuple(samples),\\n    )\\n\\n\\ndef sha256_file(path: str | os.PathLike[str]) -> str:\\n    digest = hashlib.sha256()\\n    with open(path, \\\"rb\\\") as handle:\\n        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\\\"\\\"):\\n            digest.update(chunk)\\n    return digest.hexdigest()\\n\\n\\ndef sha256_tensor(tensor: torch.Tensor) -> str:\\n    \\\"\\\"\\\"Hash a CPU tensor's exact bytes without changing its dtype or layout.\\\"\\\"\\\"\\n    value = tensor.detach().cpu().contiguous().view(torch.uint8).numpy()\\n    return hashlib.sha256(memoryview(value)).hexdigest()\\n\\n\\ndef _git(repo_root: Path, *args: str) -> bytes:\\n    proc = subprocess.run(\\n        [\\\"git\\\", *args], cwd=repo_root, check=True,\\n        stdout=subprocess.PIPE, stderr=subprocess.PIPE,\\n    )\\n    return proc.stdout\\n\\n\\ndef git_metadata(repo_root: str | os.PathLike[str]) -> dict[str, Any]:\\n    \\\"\\\"\\\"Return commit plus a content-complete, artifact-stable dirty hash.\\n\\n    Tracked modifications are represented by ``git diff HEAD``.  Untracked\\n    files are hashed by path, mode, and content instead of merely hashing the\\n    porcelain filename.  Generated benchmark/log/cache trees are excluded, as\\n    is the optional output root published by the orchestrators, so repeat 1\\n    does not change repeat 2's source identity just by writing artifacts.\\n    \\\"\\\"\\\"\\n    root = Path(repo_root).resolve()\\n    commit = _git(root, \\\"rev-parse\\\", \\\"HEAD\\\").decode().strip()\\n    tracked_status = _git(\\n        root, \\\"status\\\", \\\"--porcelain=v1\\\", \\\"-z\\\", \\\"--untracked-files=no\\\")\\n    tracked_diff = _git(root, \\\"diff\\\", \\\"--binary\\\", \\\"HEAD\\\")\\n    untracked_raw = _git(\\n        root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"-z\\\")\\n\\n    excluded_prefixes = [\\\"benchmark_results/\\\", \\\"logs/\\\", \\\".pytest_cache/\\\"]\\n    output_root = os.environ.get(\\\"TIERED_SERVE_BENCH_OUTPUT_ROOT\\\")\\n    if output_root:\\n        try:\\n            output_rel = Path(output_root).resolve().relative_to(root).as_posix()\\n        except ValueError:\\n            pass\\n        else:\\n            excluded_prefixes.append(output_rel.rstrip(\\\"/\\\") + \\\"/\\\")\\n\\n    def include(relative: str) -> bool:\\n        normalized = relative.replace(os.sep, \\\"/\\\")\\n        while normalized.startswith(\\\"./\\\"):\\n            normalized = normalized[2:]\\n        if any(normalized.startswith(prefix) for prefix in excluded_prefixes):\\n            return False\\n        if normalized == \\\"core\\\" or normalized.startswith(\\\"core.\\\"):\\n            return False\\n        parts = normalized.split(\\\"/\\\")\\n        return (\\\"__pycache__\\\" not in parts and\\n                not normalized.endswith((\\\".pyc\\\", \\\".pyo\\\")))\\n\\n    untracked = sorted(\\n        os.fsdecode(item) for item in untracked_raw.split(b\\\"\\\\0\\\")\\n        if item and include(os.fsdecode(item)))\\n    digest = hashlib.sha256()\\n    digest.update(b\\\"tracked-status\\\\0\\\")\\n    digest.update(tracked_status)\\n    digest.update(b\\\"\\\\0tracked-diff\\\\0\\\")\\n    digest.update(tracked_diff)\\n    for relative in untracked:\\n        path = root / relative\\n        digest.update(b\\\"\\\\0untracked\\\\0\\\")\\n        digest.update(os.fsencode(relative))\\n        try:\\n            stat = path.lstat()\\n            digest.update(f\\\"\\\\0mode={stat.st_mode & 0o7777:o}\\\\0\\\".encode())\\n            if path.is_symlink():\\n                digest.update(b\\\"symlink\\\\0\\\")\\n                digest.update(os.fsencode(os.readlink(path)))\\n            elif path.is_file():\\n                digest.update(b\\\"file\\\\0\\\")\\n                with path.open(\\\"rb\\\") as handle:\\n                    for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\\\"\\\"):\\n                        digest.update(chunk)\\n            else:\\n                digest.update(b\\\"special\\\\0\\\")\\n        except FileNotFoundError:\\n            digest.update(b\\\"vanished\\\\0\\\")\\n    fingerprint = digest.hexdigest()\\n    return {\\n        \\\"git_commit\\\": commit,\\n        \\\"git_dirty\\\": bool(tracked_status or untracked),\\n        \\\"git_dirty_hash\\\": fingerprint,\\n        \\\"git_untracked_content_files\\\": len(untracked),\\n    }\\n\\n\\ndef runtime_metadata(repo_root: str | os.PathLike[str]) -> dict[str, Any]:\\n    meta: dict[str, Any] = {\\n        **git_metadata(repo_root),\\n        \\\"torch_version\\\": torch.__version__,\\n        \\\"cuda_runtime\\\": torch.version.cuda or \\\"\\\",\\n        \\\"cudnn_version\\\": torch.backends.cudnn.version() or \\\"\\\",\\n        \\\"gpu_driver_version\\\": \\\"\\\",\\n    }\\n    if torch.cuda.is_available():\\n        dev = torch.cuda.current_device()\\n        props = torch.cuda.get_device_properties(dev)\\n        meta.update({\\n            \\\"gpu_name\\\": props.name,\\n            \\\"gpu_compute_capability\\\": f\\\"{props.major}.{props.minor}\\\",\\n            \\\"gpu_total_memory_bytes\\\": props.total_memory,\\n            \\\"gpu_index\\\": dev,\\n        })\\n    else:\\n        meta.update({\\n            \\\"gpu_name\\\": \\\"\\\",\\n            \\\"gpu_compute_capability\\\": \\\"\\\",\\n            \\\"gpu_total_memory_bytes\\\": \\\"\\\",\\n            \\\"gpu_index\\\": \\\"\\\",\\n        })\\n    try:\\n        proc = subprocess.run(\\n            [\\\"nvidia-smi\\\", \\\"--query-gpu=driver_version\\\",\\n             \\\"--format=csv,noheader,nounits\\\", \\\"--id=0\\\"],\\n            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\\n            text=True)\\n        meta[\\\"gpu_driver_version\\\"] = proc.stdout.splitlines()[0].strip()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Run the matched-codec FusedMM offline E2E matrix.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport ast\\nfrom datetime import datetime, timezone\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport re\\nimport shutil\\nimport statistics\\nimport subprocess\\nimport sys\\nfrom typing import Any\\n\\nimport torch\\n\\n_REPO_ROOT = Path(__file__).resolve().parents[1]\\nif str(_REPO_ROOT) not in sys.path:\\n    sys.path.insert(0, str(_REPO_ROOT))\\n\\nfrom benchmarks.fused_bench_common import git_metadata, sha256_file, write_csv\\n\\n\\nPYTHON = _REPO_ROOT / \\\".venv\\\" / \\\"bin\\\" / \\\"python\\\"\\nNUMACTL = Path(shutil.which(\\\"numactl\\\") or \\\"/usr/bin/numactl\\\")\\nDRIVER = _REPO_ROOT / \\\"offline_offload_kvweight.py\\\"\\nMODEL = \\\"meta-llama/Llama-3.1-70B-Instruct\\\"\\nBATCHES = (1, 16, 32, 64, 96, 128)\\nINPUT_LEN = 1020\\nGENERATION_TOKENS = 129\\nPREFILL_CHUNK = 8192\\nWARMUP = 8\\nCODECS = (\\\"zipserv\\\", \\\"p4flat\\\")\\nDEDICATED_KV_BLOCKS = {\\\"zipserv\\\": 3040, \\\"p4flat\\\": 2624}\\nN_LAYERS = 80\\nWEIGHT_PROJECTIONS = (\\\"qkv\\\", \\\"o\\\", \\\"gate_up\\\", \\\"down\\\")\\nCONFIGS = {\\n    codec: _REPO_ROOT / \\\"tiered_serve\\\" / \\\"model_configs\\\" / \\\"meta-llama\\\" /\\n    \\\"Llama-3.1-70B-Instruct\\\" / f\\\"cao-{'zs' if codec == 'zipserv' else 'p4'}.yaml\\\"\\n    for codec in CODECS\\n}\\n_CSV_RE = re.compile(r\\\"CSV:\\\\s+([^\\\\s]+\\\\.csv)\\\")\\n_MM_START_RE = re.compile(\\n    r\\\"\\\\[fused-mm\\\\] ENABLED: (\\\\d+) Linear overrides installed (\\\\{[^\\\\n]+?\\\\})\\\\. \\\"\\n    r\\\"Per-component fused-N threshold (\\\\{[^\\\\n]+?\\\\})\\\\.\\\")\\n_WEIGHT_COMP_RE = re.compile(\\n    r\\\"\\\\[fused-bench\\\\] weight-compression codec=(\\\\w+) tensors=(\\\\d+) \\\"\\n    r\\\"raw_bytes=(\\\\d+) compressed_bytes=(\\\\d+) ratio=([0-9.eE+-]+) \\\"\\n    r\\\"exception_count=(\\\\d+)\\\")\\n_KV_BACKEND_RE = re.compile(\\n    r\\\"##### Using KV Compression \\\\(backend=(\\\\w+), p