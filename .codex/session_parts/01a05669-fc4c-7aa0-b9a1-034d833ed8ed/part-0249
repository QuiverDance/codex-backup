nto LPDDR has landed\n    return target, exp_attrs, hbm, ats\n\n\n# ── CLI ──────────────────────────────────────────────────────────────────────\ndef parse_args():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--codecs\", default=\"zipserv,p4flat\")\n    ap.add_argument(\"--projs\", default=\"qkv,o,gate_up,down\")\n    ap.add_argument(\"--n-values\",\n                    default=\"1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,160,192,256,512,1024\")\n    ap.add_argument(\"--tp\", type=int, default=1,\n                    help=\"tensor-parallel degree (shards shapes; needs --synthetic for tp>1)\")\n    ap.add_argument(\"--synthetic\", action=\"store_true\",\n                    help=\"random bf16 weights instead of the real checkpoint\")\n    ap.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    ap.add_argument(\"--shards\", type=int, default=6,\n                    help=\"max safetensor shards to scan for real weights\")\n    ap.add_argument(\"--layers\", default=\"0,40\",\n                    help=\"comma-separated real checkpoint layers; official \"\n                         \"scaling run uses the outlier-heavy 0 and representative 40\")\n    ap.add_argument(\"--layer\", type=int, default=None,\n                    help=\"legacy single-layer override for --layers\")\n    ap.add_argument(\"--repeat-id\", type=int, default=0,\n                    help=\"independent-process repeat recorded in every CSV row\")\n    ap.add_argument(\"--seed\", type=int, default=2025010215,\n                    help=\"base seed for reproducible BF16 activations\")\n    ap.add_argument(\"--warmup\", type=int, default=5)\n    ap.add_argument(\"--iters\", type=int, default=50)\n    ap.add_argument(\"--no-flush\", action=\"store_true\",\n                    help=\"disable L2 flush between iters\")\n    ap.add_argument(\"--no-h2d\", action=\"store