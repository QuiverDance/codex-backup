dex requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --breakdown)\n      BREAKDOWN=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor codec in \"${CODECS[@]}\"; do\n  [[ \"$codec\" == p4flat || \"$codec\" == cd3 ]] \\\n    || die \"unsupported codec: ${codec}\"\ndone\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\n    numactl --cpunodebind=\"$NUMA_NODE\" --membind=\"$NUMA_NODE\"\n    \"$PYTHON_BIN\" \"$SERVER_SCRIPT\"\n    --model \"$MODEL_PATH\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --no-enable-prefix-caching\n    --chunked-prefill\n    --max-context-len \"$MAX_CONTEXT_LEN\"\n    --max-num-batched-tokens \"$chunk\"\n    --max-num-seqs \"$MAX_NUM_SEQS\"\n    --weight-comp \"$weight_codec\"\n    --fused-mm\n    \"${mode_args[@]}\"\n    \"${breakdown_args[@]}\"\n    --ts-configs \"$config\"\n    --host 127.0.0.1\n    --port \"$PORT\"\n  )\n}\n\nbuild_client_command() {\n  local result_dir=\"$1\"\n  local label=\"$2\"\n  local rate=\"$3\"\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=\"\n    \"PATH=${REPO_ROOT}/.venv/bin:${PATH}\"\n    \"RESULT_DIR=${result_dir}\"\n    bash \"$CLIENT_SCRIPT\" \"$MODEL_ALIAS\" \"$label\" \"$rate\"\n  )\n}\n\nwait_for_server() {\n  local pid=\"$1\"\n  local deadline=$((SECONDS + STARTUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ((SECONDS < deadline)); do\n    if curl -fsS \"http://127.0.0.1:${PORT}/health\" >/dev/null 2>&1; then\n      echo \"[suite] server is ready\"\n      return 0\n    fi\n    if ! kill -0 \"$pid\" 2>/dev/null; then\n      echo \"[suite] ERROR: server exited before becoming ready\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for server readiness\"\n      next_report=$((SECONDS + 30))\n    fi\n    sleep 2\n  done\n  echo \"[suite] ERROR: server readiness timed out after ${STARTUP_TIMEOUT}s\" >&2\n  return 1\n}\n\nprocess_group_alive() {\n  local pgid=\"$1\"\n  ps -eo pgid=,stat= | awk -v pgid=\"$pgid\" '$1 == pgid && $2 !~ /^Z/ { found=1 } END { exit !found }'\n}\n\nwait_for_group_exit() {\n  local pgid=\"$1\"\n  local timeout=\"$2\"\n  local deadline=$((SECONDS + timeout))\n  while process_group_alive \"$pgid\"; do\n    ((SECONDS < deadline)) || return 1\n    sleep 1\n  done\n  return 0\n}\n\nSERVER_PGID=\"\"\nCLIENT_PGID=\"\"\nSERVER_EXIT_STATUS=\"-\"\nSERVER_STOP_KIND=\"not-started\"\n\nstop_server() {\n  local pgid=\"$SERVER_PGID\"\n  [[ -n \"$pgid\" ]] || return 0\n\n  if process_group_alive \"$pgid\"; then\n    SERVER_STOP_KIND=\"interrupt\"\n    echo \"[suite] stopping server process group ${pgid} with SIGINT\"\n    kill -INT -- \"-${pgid}\" 2>/dev/null || true\n    if ! wait_for_group_exit \"$pgid\" \"$SHUTDOWN_TIMEOUT\"; then\n      SERVER_STOP_KIND=\"term\"\n      echo \"[suite] server did not stop after SIGINT; sending SIGTERM\" >&2\n      kill -TERM -- \"-${pgid}\" 2>/dev/null || true\n      if ! wait_for_group_exit \"$pgid\" 30; then\n        SERVER_STOP_KIND=\"kill\"\n        echo \"[suite] server did not stop after SIGTERM; sending SIGKILL\" >&2\n        kill -KILL -- \"-${pgid}\" 2>/dev/null || true\n        wait_for_group_exit \"$pgid\" 15 || true\n      fi\n    fi\n  else\n    SERVER_STOP_KIND=\"already-exited\"\n  fi\n\n  set +e\n  wait \"$pgid\" 2>/dev/null\n  SERVER_EXIT_STATUS=$?\n  set -e\n  SERVER_PGID=\"\"\n}\n\nstop_client() {\n  local pgid=\"$CLIENT_PGID\"\n  [[ -n \"$pgid\" ]] || return 0\n  if process_group_alive \"$pgid\"; then\n    echo \"[suite] stopping client process group ${pgid}\" >&2\n    kill -TERM -- \"-${pgid}\" 2>/dev/null || true\n    if ! wait_for_group_exit \"$pgid\" 30; then\n      kill -KILL -- \"-${pgid}\" 2>/dev/null || true\n      wait_for_group_exit \"$pgid\" 15 || true\n    fi\n  fi\n  set +e\n  wait \"$pgid\" 2>/dev/null\n  set -e\n  CLIENT_PGID=\"\"\n}\n\ncleanup_active_groups() {\n  set +e\n  stop_client\n  stop_server\n  set -e\n}\n\non_signal() {\n  local signal=\"$1\"\n  trap - INT TERM\n  echo \"[suite] received ${signal}; cleaning only this suite's active process groups\" >&2\n  cleanup_active_groups\n  exit 130\n}\n\ntrap 'on_signal INT' INT\ntrap 'on_signal TERM' TERM\ntrap cleanup_active_groups EXIT\n\npreflight\n\nCELLS=()\nfor codec in \"${CODECS[@]}\"; do\n  for chunk in \"${CHUNKS[@]}\"; do\n    for rate in \"${REQUEST_RATES[@]}\"; do\n      for mode in \"${MODES[@]}\"; do\n        CELLS+=(\"${codec}|${mode}|${chunk}|${rate}\")\n      done\n    done\n  done\ndone\n\nif ((DRY_RUN)); then\n  echo \"[suite] dry-run: ${#CELLS[@]} cells x ${REPEATS} repeats\"\n  for ((round = 1; round <= REPEATS; round++)); do\n    if ((round % 2 == 1)); then\n      indices=()\n      for ((i = 0; i < ${#CELLS[@]}; i++)); do indices+=(\"$i\"); done\n    else\n      indices=()\n      for ((i = ${#CELLS[@]} - 1; i >= 0; i--)); do indices+=(\"$i\"); done\n    fi\n    for i in \"${indices[@]}\"; do\n      IFS='|' read -r codec mode chunk rate <<<\"${CELLS[$i]}\"\n      rate_id=\"$(sanitize_id \"$rate\")\"\n      label=\"r$(printf '%02d' \"$round\")-${codec}-${mode}-c${chunk}-q${rate_id}\"\n      result_dir=\"<suite-dir>/${label}/client\"\n      echo \"[suite] cell ${label}\"\n      build_server_command \"$codec\" \"$mode\" \"$chunk\"\n      quote_command \"${CMD[@]}\"\n      build_client_command \"$result_dir\" \"$label\" \"$rate\"\n      quote_command \"${CMD[@]}\"\n    done\n  done\n  exit 0\nfi\n\nif ((CHECK_ONLY)); then\n  wait_for_clean_state check-only\n  echo \"[suite] preflight and clean-state checks passed\"\n  exit 0\nfi\n\ncd \"$REPO_ROOT\"\nmkdir -p \"$OUTPUT_ROOT\"\nSUITE_STAMP=\"$(date -u +%Y%m%dT%H%M%SZ)\"\nSUITE_DIR=\"${OUTPUT_ROOT}/${SUITE_STAMP}\"\nsuffix=0\nwhile [[ -e \"$SUITE_DIR\" ]]; do\n  ((suffix += 1))\n  SUITE_DIR=\"${OUTPUT_ROOT}/${SUITE_STAMP}-${suffix}\"\ndone\nmkdir -p \"$SUITE_DIR\"\n\nSUMMARY_FILE=\"${SUITE_DIR}/summary.tsv\"\nMANIFEST_FILE=\"${SUITE_DIR}/manifest.txt\"\nprintf 'round\\tcell\\tcode