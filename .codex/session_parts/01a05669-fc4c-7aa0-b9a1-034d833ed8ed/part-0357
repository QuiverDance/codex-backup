        #\n        # The real fix (TODO) is to BREAK the load↔unload↔attention coupling so\n        # the KV load no longer waits attention: e.g. copy the new-token tail\n        # aside to a small staging buffer right after reshape_and_cache (early in\n        # the layer), unload D2H from that staging asynchronously, and let\n        # load(L+1) wait only that early tiny D2D — then aliasing is execution-\n        # neutral and this can default ON.  Until then, opt-in for measurement.\n        if (os.getenv(\"TIERED_SERVE_RAW_KV_ALIAS\", \"0\") == \"1\"\n                and not DualMemoryLoader.use_kv_comp\n                and os.getenv(\"TIERED_SERVE_KV_H2D_ON_WEIGHT\", \"1\") == \"1\"\n                and os.getenv(\"TIERED_SERVE_KV_DOUBLE_BUFFER\", \"1\") == \"1\"\n                and self.n_layers % 2 == 0):\n            self.load_kv_stream = self.load_weight_stream\n            logger.info(\n                \"[kv-decode] RAW KV H2D aliased onto load_weight_stream \"\n                \"(opt-in; clean bracket but +25-31%% TPOT until tail-staging \"\n                \"decouple lands)\")\n\n        # Single timing flag: TIERED_SERVE_COLLECT_TIME enables both per-step\n        # CUDA-event collection AND the aggregated Exec/Load/Stall breakdown\n        # summary in calc_times() (they were two separate vars; unified).\n        self.collect_times = (os.getenv(\"TIERED_SERVE_COLLECT_TIME\", \"0\") == \"1\")\n        self.time_breakdown = self.collect_times\n        # Propagate to the KV compressor so it skips breakdown-only event\n        # records (per-step CUDA event record() was ~12% of forward CPU).\n        if getattr(self, \"kv_compressor\", None) is not None:\n            self.kv_compressor._tb = self.time_breakdown\n        self.kv_decode_load_backend = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_LOAD\", \"compressed\").lower()\n        if self.kv_decode_load_backend not in (\"compressed\", \"raw\"):\n            raise ValueError(\n                f\"Unknown TIERED_SERVE_KV_DECODE_LOAD: \"\n                f\"{self.kv_decode_load_backend!r}. Expected 'compressed' \"\n                \"or 'raw'.\")\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV decode load backend: %s\",\n                self.kv_decode_load_backend)\n        _prefill_comp_requested = (\n            os.getenv(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if _prefill_comp_requested and not DualMemoryLoader.use_kv_comp:\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 requires \"\n                \"TIERED_SERVE_USE_KV_COMP=1\"\n            )\n        if (\n            _prefill_comp_requested\n            and self.kv_decode_load_backend != \"compressed\"\n        ):\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 conflicts with \"\n                \"TIERED_SERVE_KV_DECODE_LOAD=raw\"\n            )\n        self.kv_comp_prefill_load = bool(_prefill_comp_requested)\n        DualMemoryLoader.kv_comp_prefill_load = (\n            self.kv_comp_prefill_load\n        )\n        # A mixed prefill needs current-layer KV materialisation: a preceding\n        # decode may have left a different parity-sharing layer in the dense\n        # staging cache.  The offline benchmark enables this for both its raw\n        # and compressed arms so they use the same safe schedule.  Resolve the\n        # policy once here; the per-piece wrapper only reads the cached bool.\n        self.kv_prefill_jit_current = (\n            os.getenv(\n                \"TIERED_SERVE_KV_PREFILL_JIT_CURRENT\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV prefill load backend: %s\",\n                (\n                    \"compressed\"\n                