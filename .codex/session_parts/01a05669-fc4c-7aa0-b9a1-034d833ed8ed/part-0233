ust hands the same\n        # tensors to ``_foreach_copy_`` with no further slicing.\n        group_slices = getattr(info, \"_zs_group_slices\", None)\n        if group_slices is None:\n            group_slices = []\n            for grp in plan:\n                dsts = []\n                srcs = []\n                for attr in info.lpddr_attrs:\n                    lo, hi = grp[\"ranges\"][attr]\n                    if hi <= lo:\n                        continue\n                    dsts.append(staging[attr][lo:hi])\n                    srcs.append(info.lpddr_buffers[attr][lo:hi])\n                group_slices.append((dsts, srcs))\n            info._zs_group_slices = group_slices\n        for g, grp in enumerate(plan):\n            gev = self._zipserv_group_h2d_event(layer_id, name, g)\n            with torch.cuda.stream(self.load_weight_stream):\n                dsts, srcs = group_slices[g]\n                self._coalesced_h2d(dsts, srcs)\n                gev.record(self.load_weight_stream)\n            self.decomp_weight_stream.wait_event(gev)\n            self._frozen_split_run_decompress(\n                info, staging, info.lpddr_numels,\n                output, backend_compressor,\n                gt_m_base=grp[\"gt_m_base\"],\n                num_row_tiles=grp[\"num_row_tiles\"])\n        # NB: no h2d_event.record here — in the pipelined path the decode\n        # stream already synced per-group on ``gev``; the single per-tensor\n        # h2d_event is only consumed by the single-shot branch.\n        if tb:\n            with torch.cuda.stream(self.load_weight_stream):\n                h2d_end_timing.record(self.load_weight_stream)\n            self._frozen_split_decomp_end_timing_event(\n                layer_id, name).record(self.decomp_weight_stream)\n        if detailed_nvtx:\n            torch.cuda.nvtx.range_pop()\n        kernel_done_event.record(self.decomp_weight_stream)\n\n    def _wload_graph_dispatch(self, layer_id, tensor_names, split_data,\n    