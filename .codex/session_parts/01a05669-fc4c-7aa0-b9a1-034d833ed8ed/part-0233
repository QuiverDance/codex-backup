m    = torch::empty({n}, i8);\n    CUDA_CHECK_THROW(BF16P4Flat_RelayoutToBlocked(\n        stream.stream(),\n        reinterpret_cast<const uint8_t*>(codes_flat.data_ptr()),\n        reinterpret_cast<const uint8_t*>(sm_flat.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<uint8_t*>(sm.data_ptr()),\n        M, K));\n\n    int64_t subtile_bytes = (int64_t)(M / 16) * (int64_t)(K / 16);\n    auto subtile = torch::empty({subtile_bytes}, i8);\n    CUDA_CHECK_THROW(BF16P4Flat_BuildSubtileCodec(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(headers.data_ptr()),\n        reinterpret_cast<uint8_t*>(codes.data_ptr()),\n        reinterpret_cast<uint8_t*>(subtile.data_ptr()),\n        M, K));\n\n    return std::make_tuple(headers, codes, sm, subtile,\n                           exc_idx, exc_val, exc_count);\n}\n\nCompressedP4Flat p4flat_compress(torch::Tensor weight) {\n    TORCH_CHECK(weight.dim() == 2, \"weight must be 2D\");\n    TORCH_CHECK(weight.scalar_type() == at::kBFloat16,\n                \"weight dtype must be bfloat16\");\n    int M = (int)weight.size(0);\n    int K = (int)weight.size(1);\n    TORCH_CHECK(M % BF16_P4F_TILE_DIM == 0 && K % BF16_P4F_TILE_DIM == 0,\n                \"M and K must be multiples of \", BF16_P4F_TILE_DIM,\n                \" (got \", M, \"x\", K, \")\");\n\n    if (weight.is_cuda()) {\n        return p4flat_compress_gpu(weight);\n    }\n\n    /* CPU fallback: kept for CPU-resident inputs (e.g. weights still on\n     * pinned host memory before any H2D). Same algorithm, just single-\n     * threaded — for performance, prefer the GPU path. */\n    torch::Tensor w_host = weight.contiguous();\n    const uint16_t* bf16 =\n        reinterpret_cast<const uint16_t*>(w_host.data_ptr());\n\n    constexpr int G = BF16_P4F_TILE_DIM;\n    int64_t n = (int64_t)M * K;\n    int num_tiles_m = M / G;\n    int num_tiles_k = K / G;\n    int num_tiles = num_tiles_m * num_tiles_k;\n    size_t code_bytes = (size_t)((n + 1) / 2);\n\n    std::vector<BF16P4FlatHeader> headers(num_tiles);\n    std::vector<uint8_t> codes(code_bytes, 0);\n    std::vector<uint8_t> sm((size_t)n);\n    std::vector<uint32_t> exc_idx;\n    std::vector<uint16_t> exc_val;\n    exc_idx.reserve((size_t)(n / 200));\n    exc_val.reserve((size_t)(n / 200));\n\n    for (int tm = 0; tm < num_tiles_m; ++tm) {\n        for (int tk = 0; tk < num_tiles_k; ++tk) {\n            int tile = tm * num_tiles_k + tk;\n            int hist[256] = {0};\n\n            for (int r = 0; r < G; ++r) {\n                int64_t base = (int64_t)(tm * G + r) * K + tk * G;\n                for (int c = 0; c < G; ++c) {\n                    uint16_t v = bf16[base + c];\n                    uint8_t exp = (uint8_t)((v >> 7) & 0xffu);\n                    hist[exp]++;\n                }\n            }\n\n            int8_t code_of_exp[256];\n            std::memset(code_of_exp, -1, sizeof(code_of_exp));\n            bool used[256] = {false};\n            for (int p = 0; p < BF16_P4F_PALETTE_SIZE; ++p) {\n                int best = -1;\n                for (int e = 0; e < 256; ++e) {\n                    if (!used[e] && (best < 0 || hist[e] > hist[best])) {\n                        best = e;\n                    }\n                }\n                used[best] = true;\n                headers[tile].palette[p] = (uint8_t)best;\n                code_of_exp[best] = (int8_t)p;\n            }\n\n            for (int r = 0; r < G; ++r) {\n                int64_t base = (int64_t)(tm * G + r) * K + tk * G;\n                for (int c = 0; c < G; ++c) {\n                    int64_t idx = base + c;\n                    uint16_t v = bf16[idx];\n                    uint8_t exp = (uint8_t)((v >> 7) & 0xffu);\n                    uint8_t s = (uint8_t)((v >> 15) & 0x1u);\n                    uint8_t mant = (uint8_t)(v & 0x7fu);\n                    sm[(size_t)idx] = (uint8_t)((s << 7) | mant);\n\n                    int code = (int)code_of_exp[exp];\n                    if (code < 0) {\n                        code = 0;\n                        exc_idx.push_back((uint32_t)idx);\n                        exc_val.push_back(v);\n                    }\n                    if (idx & 1) {\n                        codes[(size_t)(idx >> 1)] |= (uint8_t)(code << 4);\n                    } else {\n                        codes[(size_t)(idx >> 1)] |= (uint8_t)code;\n                    }\n                }\n            }\n        }\n    }\n\n    int64_t num_exceptions = (int64_t)exc_idx.size();\n\n    /* Build sorted-by-m exception metadata for the rank-1 MM patch path. */\n    std::vector<uint32_t> sorted_idx;\n    std::vector<uint16_t> sorted_val;\n    std::vector<uint32_t> group_m;\n    std::vector<uint32_t> group_offsets;\n    if (!exc_idx.empty()) {\n        std::vector<size_t> order(exc_idx.size());\n        for (size_t i = 0; i < order.size(); ++i) order[i] = i;\n        std::sort(order.begin(), order.end(),\n                  [&exc_idx](size_t a, size_t b) {\n                      return exc_idx[a] < exc_idx[b];\n                  });\n        sorted_idx.resize(exc_idx.size());\n        sorted_val.resize(exc_val.size());\n        for (size_t i = 0; i < order.size(); ++i) {\n            sorted_idx[i] = exc_idx[order[i]];\n            sorted_val[i] = exc_val[order[i]];\n        }\n        group_offsets.push_back(0);\n        uint32_t cur_m = (uint32_t)(sorted_idx[0] / (uint32_t)K);\n        group_m.push_back(cur_m);\n        for (size_t i = 1; i < sorted_idx.size(); ++i) {\n            uint32_t mi = (uint32_t)(sorted_idx[i] / (uint32_t)K);\n            if (mi != cur_m) {\n                group_offsets.push_back((uint32_t)i);\n                group_m.push_back(mi);\n                cur_m = mi;\n            }\n        }\n        group_offsets.push_back((uint32_t)sorted_idx.size());\n    }\n    int64_t num_groups = (int64_t)group_m.size();\n\n    /* Stage host buffers onto CUDA. uint32 → int32 storage, uint16 →\n     * int16; kernels reinterpret_cast<uint32_t*> off data_ptr(). Keeping\n     * natural widths means the GPU compress path produces identical\n     * dtype layouts so the frozen_split staging dtype scan is uniform. */\n    auto i8_opts  = torch::TensorOptions().dtype(at::kByte).device(torch::kCUDA);\n    auto i32_opts = torch::TensorOptions().dtype(at::kInt).device(torch::kCUDA);\n    auto i16_opts = torch::TensorOptions().dtype(at::kShort).device(torch::kCUDA);\n\n    auto make_byte_buf = [&](const void* src, int64_t bytes) {\n        auto t = torch::empty({bytes}, i8_opts);\n        if (bytes > 0) {\n            CUDA_CHECK_THROW(cudaMemcpy(t.data_ptr(), src, (size_t)bytes,\n                                        cudaMemcpyHostToDevice));\n        }\n        return t;\n    };\n\n    CompressedP4Flat out;\n    out.headers = make_byte_buf(\n        headers.data(),\n        (int64_t)num_tiles * sizeof(BF16P4FlatHeader));\n    /* CPU compress produces flat layout in host vectors.  Stage as\n     * CUDA flat buffers, then relayout + classify subtiles. */\n    auto codes_flat_t = make_byte_buf(codes.data(), (int64_t)code_bytes);\n    auto sm_flat_t    = make_byte_buf(sm.data(),    n);\n    out.codes         = torch::empty({(int64_t)code_bytes}, i8_opts);\n    out.sign_mantissa = torch::empty({n},                    i8_opts);\n    int64_t subtile_codec_bytes_cpu = (int64_t)(M / 16) * (int64_t)(K / 16);\n    out.subtile_codec = torch::empty({subtile_codec_bytes_cpu}, i8_opts);\n    {\n        auto stream = c10::cuda::getCurrentCUDAStream();\n        cudaError_t err = BF16P4Flat_RelayoutToBlocked(\n            stream.stream(),\n            reinterpret_cast<const uint8_t*>(codes_flat_t.data_ptr()),\n            reinterpret_cast<const uint8_t*>(sm_flat_t.data_ptr()),\n            reinterpret_cast<uint8_t*>(out.codes.data_ptr()),\n            reinterpret_cast<uint8_t*>(out.sign_mantissa.data_ptr()),\n            M, K);\n        TORCH_CHECK(err == cudaSuccess,\n                    \"BF16P4Flat_RelayoutToBlocked (CPU path) failed: \",\n                    cudaGetErrorString(err));\n        err = BF16P4Flat_BuildSubtileCodec(\n            stream.stream(),\n            reinterpret_cast<const BF16P4FlatHeader*>(out.headers.data_ptr()),\n            reinterpret_cast<uint8_t*>(out.codes.data_ptr()),\n            reinterpret_cast<uint8_t*>(out.subtile_codec.data_ptr()),\n            M, K);\n        TORCH_CHECK(err == cudaSuccess,\n                    \"BF16P4Flat_BuildSubtileCodec (CPU path) failed: \",\n                    cudaGetErrorString(err));\n    }\n\n    auto pack_u32 = [&](const std::vector<uint32_t>& v) {\n        int64_t elems = std::max<int64_t>((int64_t)v.size(), 1);\n        auto t = torch::zeros({elems}, i32_opts);\n        if (!v.empty()) {\n            CUDA_CHECK_THROW(cudaMemcpy(t.data_ptr(), v.data(),\n                                        v.size() * sizeof(uint32_t),\n                                        cudaMemcpyHostToDevice));\n        }\n        return t;\n    };\n    auto pack_u16 = [&](const std::vector<uint16_t>& v) {\n        int64_t elems = std::max<int64_t>((int64_t)v.size(), 1);\n        auto t = torch::zeros({elems}, i16_opts);\n        if (!v.empty()) {\n            CUDA_CHECK_THROW(cudaMemcpy(t.data_ptr(), v.data(),\n                                        v.size() * sizeof(uint16_t),\n                                        cudaMemcpyHostToDevice));\n        }\n        return t;\n    };\n\n    out.exc_indices = pack_u32(exc_idx);\n    out.exc_values  = pack_u16(exc_val);\n    out.exc_sorted_indices = pack_u32(sorted_idx);\n    out.exc_sorted_values  = pack_u16(sorted_val);\n    out.exc_group_m        = pack_u32(group_m);\n    out.exc_group_offsets  = pack_u32(group_offsets);\n\n    out.M = M;\n    out.K = K;\n    out.num_exceptions = num_exceptions;\n    out.num_groups = num_groups;\n    return out;\n}\n\n/* Fused decompress + GEMM: C = A_decoded @ B where A is p4flat-compressed.\n *  - comp:    CompressedP4Flat for the (M, K) weight matrix A.\n *  - B:       CUDA bfloat16 (K, N) row-major.\n *  - output:  optional CUDA bfloat16 (M, N) row-major; allocated if absent.\n *\n * Returns the output tensor.  Exceptions (rare bf16 values that didn't fit\n * the per-tile palette) are corrected by a follow-up rank-1 patch kernel\n * driven by the compressor's (group_m, group_offsets) CSR. */\nstatic torch::Tensor p4flat_fused_mm(\n    const CompressedP4Flat& comp,\n    torch::Tensor B,\n    c10::optional<torch::Tensor> output_opt)\n{\n    TORCH_CHECK(comp.M > 0 && comp.K > 0, \"compressed object has invalid shape\");\n    TORCH_CHECK(B.is_cuda(),                           \"B must be on CUDA\");\n    TORCH_CHECK(B.scalar_type() == at::kBFloat16,      \"B must be bfloat16\");\n    TORCH_CHECK(B.dim() == 2,                          \"B must be 2D\");\n    TORCH_CHECK(B.size(0) == comp.K,\n                \"B shape mismatch: expected (\", comp.K, \", N), got (\",\n                B.size(0), \", \", B.size(1), \")\");\n    auto B_c = B.is_contiguous() ? B : B.contiguous();\n    int N = (int)B_c.size(1);\n\n    torch::Tensor C;\n    if (output_opt.has_value()) {\n        C = output_opt.value();\n        TORCH_CHECK(C.is_cuda(),                        \"output must be on CUDA\");\n        TORCH_CHECK(C.scalar_type() == at::kBFloat16,   \"output must be bfloat16\");\n        TORCH_CHECK(C.size(0) == comp.M && C.size(1) == N,\n                    \"output shape mismatch: expected (\", comp.M, \", \", N,\n                    \"), got (\", C.size(0), \", \", C.size(1), \")\");\n        TORCH_CHECK(C.is_contiguous(),                  \"output must be contiguous\");\n    } else {\n        C = torch::zeros(\n            {comp.M, (int64_t)N},\n            torch::TensorOptions().dtype(at::kBFloat16).device(torch::kCUDA));\n    }\n    /* Caller-supplied C is assumed pre-cleared: the fused kernel writes\n     * the GEMM result via straight stores (no atomic accumulate). */\n\n    TORCH_CHECK(comp.headers.is_cuda() && comp.codes.is_cuda() &&\n                comp.sign_mantissa.is_cuda() && comp.subtile_codec.is_cuda(),\n                \"compressed buffers must be on CUDA for fused_mm\");\n\n    auto stream = c10::cuda::getCurrentCUDAStream();\n\n    /* Exception buffers may be missing/empty.  Pass null pointers + 0\n     * groups in that case so the patch kernel is skipped. */\n    const uint32_t* exc_sorted_idx_ptr = nullptr;\n    const uint16_t* exc_sorted_val_ptr = nullptr;\n    const uint32_t* exc_group_m_ptr    = nullptr;\n    const uint32_t* exc_group_off_ptr  = nullptr;\n    if (comp.num_groups > 0 && comp.num_exceptions > 0) {\n        exc_sorted_idx_ptr =\n            reinterpret_cast<const uint32_t*>(comp.exc_sorted_indices.data_ptr());\n        exc_sorted_val_ptr =\n            reinterpret_cast<const uint16_t*>(comp.exc_sorted_values.data_ptr());\n        exc_group_m_ptr =\n            reinterpret_cast<const uint32_t*>(comp.exc_group_m.data_ptr());\n        if (not _ENV_ANY_WLOAD_GRAPH\n                or not torch.cuda.is_current_stream_capturing()):\n            self.load_weight_stream.wait_event(kernel_done_event)\n        if tb:\n            h2d_begin = self._frozen_split_h2d_begin_event(layer_id, name)\n            h2d_end_timing = self._frozen_split_h2d_end_timing_event(\n                layer_id, name)\n        # Pipeline the (zipserv BF16) H2D + decode in row-tile groups so\n        # group g+1's H2D overlaps group g's decode.  Disabled for the\n        # fused_mm (skip_kernel) path, which needs the whole staging slot\n        # populated for the matmul to read; QKV/O are left whole.\n        plan = None if skip_kernel else self._zipserv_pipeline_plan(\n            info, self.tensor_to_component.get(name))\n\n        if plan is None and collect_into is not None:\n            # #8 batched H2D: defer the copy + h2d_event.record + decomp\n            # wait_event to the caller, which issues ONE batch_memcpy for ALL\n            # projections then records each event.  The WAR guard\n            # (load_weight_stream.wait_event(kernel_done_event)) already ran\n            # above, so the staging slot is safe to overwrite.\n            single = getattr(info, \"_zs_single_slices\", None)\n            if single is None:\n                single = (\n                    [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\n                     for attr in info.lpddr_attrs],\n                    [info.lpddr_buffers[attr]\n                     for attr in info.lpddr_attrs])\n                info._zs_single_slices = single\n            collect_into.append((single[0], single[1], h2d_event))\n            return\n\n        if plan is None:\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_h2d L{layer_id}.{name}\")\n            # When the caller (decompress_frozen_tensors, all-fused decode path)\n            # already holds the load_weight_stream context for the whole\n            # projection loop, stream(None) is a no-op — the copy below\n            # reads current_stream() = load_weight_stream and the records are\n            # explicit, so we skip the per-projection stream-context churn.\n            with torch.cuda.stream(None if h2d_ctx_held else self.load_weight_stream):\n                # BEGIN/END timing markers for the time-breakdown\n                # diagnostic, paired with the sync h2d_event below.\n                # frozen_split keeps sign_mantissa on HBM but H2D's the\n                # compressed-exp/aux buffers every decode step, so this is\n                # the dominant Weight Load source in frozen_split configs\n                # and was being missed by the per-layer\n                # begin_memcpy_weight_events filter.  Two separate END\n                # events because the sync one (h2d_event) must have\n                # enable_timing=False for cross-stream wait semantics.\n                if tb:\n                    h2d_begin.record(self.load_weight_stream)\n                # Single coalesced H2D for all codec buffers (QKV/O and any\n                # non-pipelined tensor load in one dispatch, not one-per-attr).\n                # dst/src views are fixed across decode steps (parity-stable\n                # staging, fixed lpddr_buffers, fixed numels), so build them\n                # once and cache on info instead of re-slicing every step.\n                single = getattr(info, \"_zs_single_slices\", None)\n                if single is None:\n                    single = (\n                        [staging[attr].narrow(0, 0, info.lpddr_numels[attr])\n                         for attr in info.lpddr_attrs],\n                        [info.lpddr_buffers[attr]\n                         for attr in info.lpddr_attrs])\n                    info._zs_single_slices = single\n                    # Cache the raw dst/src/size arrays alongside the views so\n                    # the batched H2D goes through batch_memcpy_ptrs (no per-call\n                    # tensor->ptr rebuild).  Stable for the same reason the views\n                    # are (parity-fixed staging, immutable LPDDR buffers/numels).\n                    info._zs_ptr_arrays = (\n                        [d.data_ptr() for d in single[0]],\n                        [s.data_ptr() for s in single[1]],\n                        [s.numel() * s.element_size() for s in single[1]])\n                # h2d_ctx_held => caller holds torch.cuda.stream(load_weight_stream),\n                # so current_stream() == load_weight_stream: pass its cached raw\n                # handle and skip the per-call current_stream() driver lookup.\n                _sh = self._lw_stream_handle() if h2d_ctx_held else None\n                self._coalesced_h2d(single[0], single[1],\n                                    info._zs_ptr_arrays, _sh)\n                h2d_event.record(self.load_weight_stream)\n                if tb:\n                    h2d_end_timing.record(self.load_weight_stream)\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_pop()  # frozen_split_h2d\n            if skip_kernel:\n                # fused_mm path: H2D is enough — the kernel that consumes\n                # the staging slot is the fused matmul, fired by the\n                # rewritten Linear forward on exec_stream.  The\n                # ``frozen_decomp_events`` recorded by the caller after we\n                # return is therefore recorded directly on load_weight_stream.\n                # No wait is inserted on exec_stream here; the custom op waits\n                # that component event at the actual point of use.  The reciprocal\n                # ``kernel_done_event`` that gates the *next* H2D writing\n                # this staging slot is recorded by the custom op after\n                # fused_mm completes, not here.\n                return\n\n            # Dense reconstruct runs outside the custom op and therefore needs\n            # the H2D dependency on its execution stream.\n            self.decomp_weight_stream.wait_event(h2d_event)\n\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_{info.backend}_decomp L{layer_id}.{name}\")\n            # Timing BEGIN/END around the decompress kernel for the\n            # time-breakdown only (see ATS path above for rationale).\n            if tb:\n                self._frozen_split_decomp_begin_timing_event(\n                    layer_id, name).record(self.decomp_weight_stream)\n            self._frozen_split_run_decompress(\n                info, staging, info.lpddr_numels,\n                output, backend_compressor)\n            if tb:\n                self._frozen_split_decomp_end_timing_event(\n                    layer_id, name).record(self.decomp_weight_stream)\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_pop()\n            # Record kernel completion on decomp_weight