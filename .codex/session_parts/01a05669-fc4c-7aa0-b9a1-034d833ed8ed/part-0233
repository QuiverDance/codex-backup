a_ptr()),\n        reinterpret_cast<uint16_t*>(output.data_ptr()),\n        (int)comp.M, (int)comp.K, (int)mode);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_DecodeBench_API failed: \", cudaGetErrorString(err));\n    return output;\n}\n\n// ---------------------------------------------------------------------------\n//  Host (CPU) P4-flat batch encoder.\n//\n//  Byte-identical to the NumPy reference ``_p4flat_cpu_encode_block`` (palette\n//  mode, row_major_sm=1, subtile_codec all-0xFF), but written in C++ and\n//  parallelised across blocks with OpenMP under a released GIL — so it scales\n//  linearly across cores instead of bottlenecking on the Python GIL.  Each\n//  block writes only into its own (unique) pool slot, so the parallel loop\n//  needs no synchronisation.\n//\n//  Layout per slot row: [headers | codes | sm | subtile_codec(0xFF) |\n//  exc_idx(u32 LE) | exc_val(u16 LE)], or raw BF16 of the valid rows on\n//  fallback.  ``valid_tm`` (occupancy) restricts encoding to the first\n//  valid_tm 64-row tile bands; the rest of the block is left untouched.\n// ---------------------------------------------------------------------------\n// 256-bin exponent histogram of one 64x64 tile.  4 interleaved sub-histograms\n// break the counts[x]++ read-after-write chain (spatially-correlated KV exps hit\n// the same bucket back-to-back).  Measured fastest on Grace/V2 — an SVE2\n// gather+HISTCNT+scatter version was byte-exact but ~25% SLOWER (gather/scatter\n// is expensive on V2), and the histogram is not the encoder bottleneck anyway.\nstatic inline void p4f_hist64(const uint16_t* in, int64_t r0, int64_t c0,\n                              int64_t K_b, int* counts) {\n    int c0h[256], c1h[256], c2h[256], c3h[256];\n    for (int e = 0; e < 256; ++e) { c0h[e]=c1h[e]=c2h[e]=c3h[e]=0; }\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int x = 0; x < 64; x += 4) {\n            c0h[(rp[x]     >> 7) & 0xFF]++;\n            c1h[(rp[x + 1] >> 7) & 0xFF]++;\n            c2h[(rp[x + 2] >> 7) & 0xFF]++;\n            c3h[(rp[x + 3] >> 7) & 0xFF]++;\n        }\n    }\n    for (int e = 0; e < 256; ++e) counts[e] = c0h[e] + c1h[e] + c2h[e] + c3h[e];\n}\n\n\"\"\"Lossless BF16 ChunkDelta3 compressor.\n\nChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\n16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\nencodes exponent deltas in three bits.  Values outside the local 3-bit range\nare restored from tile-local 20-bit ``(exponent8, position12)`` exceptions,\npacked three per aligned 64-bit word, making the codec bit exact.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\ntry:\n    from tiered_serve.cpp_exts import tp3_cd3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load tp3_cd3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n            alignment = tensor.element_size()\n            offset = (offset + alignment - 1) // alignment * alignment\n            layout.append(\n                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n            offset += tensor.nbytes\n\n        if huge_page_allocator is not None:\n            try:\n                host_slab = huge_page_allocator.allocate(\n                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n            except (MemoryError, ValueError):\n                logger.warning(\n                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n                    \"pinned host memory\")\n                host_slab = torch.empty(offset, dtype=torch.uint8,\n                                        pin_memory=True)\n        else:\n            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n\n        host_views = []\n        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n            view.copy_(source)\n            setattr(self, attr, view)\n            host_views.append(view)\n        self._host_slab = host_slab\n        self._slab_layout = tuple(layout)\n        self._device_slab = None\n        self._h2d_views = None\n        self._h2d_sources = None\n        self._copy_slab = False\n        self._set_native_buffers(tuple(host_views))\n        return self\n\n    def to(self, device=\"cuda\", non_blocking: bool = True):\n        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n        if torch.device(device).type != \"cuda\":\n            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n        if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # GH200 serving calibration covers the lossless Packed20x3 kernels through\n    # N=128.  Above that point the normal dense decompress+cuBLAS route wins.\n    # Keep the environment override for cross-GPU/model retuning.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 128,\n        (8192, 8192): 128,\n        (57344, 8192): 128,\n        (8192, 28672): 128,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        # Weight compression is an offline/load-time operation.  Keep its\n        # compute on the host so it never steals SM time from serving.  The\n        # completed compressed buffers are staged to CUDA only when the input\n        # itself is CUDA; CPU callers retain a host-resident result.\n        self._cpu_weight_encode = (\n            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n\"\"\"BF16 P4-flat weight compressor.\n\nPer-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa byte.\nOut-of-palette exponents are stored as a separate (index, value) list and\nre-injected by a patch kernel during decompress — so the result is\nbit-exact-equivalent to the original BF16 weight.\n\nCompress runs on the GPU (one CTA per 64×64 tile).  Both compress and\ndecompress are delivered by the native PyTorch C++ extension\n``tiered_serve.cpp_exts.zipserv_p4flat_ext``.  No native fused\ndecompress+MM kernel: ``linear_apply`` falls through to the base class\ndefault (``decompress + F.linear``) which empirically beats every fused\nvariant on real LLM weights for decode-N shapes.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4FlatCompressor disabled: failed to load \"\n        f\"zipserv_p4flat_ext ({type(_e).__name__}: {_e})\")\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass CompressedP4FlatTensor:\n    \"\"\"Container around the native :class:`CompressedP4Flat` struct.\n\n    Mirrors GPU/host tensor fields onto Python instance attrs so the loader\n    can iterate ``_BUFFER_ATTRS`` and stage them through a pool, matching\n    the pattern used by :class:`CompressedZipServFP8GpuTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"headers\", \"codes\", \"sign_mantissa\",\n        \"subtile_codec\",\n        \"exc_indices\", \"exc_values\",\n        \"exc_sorted_indices\", \"exc_sorted_values\",\n        \"exc_group_m\", \"exc_group_offsets\",\n    )\n    # Pre-computed (attr, d_attr) pairs — avoids 10 f-string allocations\n    # per .to() / register_temp_d_tensor call (320 calls/step → 3200 fewer\n    # transient str objects per decode step).\n    _BUFFER_ATTR_D_PAIRS = tuple((a, f\"_d_{a}\") for a in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        # Cached narrow views into GPU staging buffers, created once in\n        # register_temp_d_tensor and reused by every .to() call.  Eliminates\n        # 10 view + 10 setattr(self._c, ...) per .to() call (320 calls/step\n        # → 6400 fewer transient Python objects per decode step).\n        self._h2d_views: Optional[tuple] = None\n        self._h2d_srcs: Optional[tuple] = None\n        self._gpu_buf_cache: Optional[tuple] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def num_groups(self) -> int:\n        return int(self._c.num_groups)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n                               gpu_pool: Optional[Dict[str, torch.Tensor]] = None\n                               ) -> None:\n        \"\"\"Bind decompress destination + per-attr GPU staging slots.\n\n        Pre-creates narrow views into the GPU staging buffers and pushes\n        them into the C struct once, so the per-decode ``.to()`` only does\n        ``copy_`` — no f-strings, no view creation, no per-call setattr.\n        \"\"\"\n        self.output_tensor = temp_d\n        device = temp_d.device\n        views = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            src = getattr(self, attr)\n            if gpu_pool is not None and attr in gpu_pool:\n                dst = gpu_pool[attr]\n            else:\n                dst = torch.empty_like(src, device=device)\n            setattr(self, d_attr, dst)\n            n = src.numel()\n            view = dst[:n] if n > 0 else dst\n            views.append(view)\n            # Set C struct tensor pointer once — the view object is reused\n            # across decode steps, so the pointer never changes.\n            setattr(self._c, attr, view)\n        self._h2d_views = tuple(views)\n        self._h2d_srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n        self._gpu_buf_cache = None  # invalidate get_gpu_buffers cache\n\n    def to_host(self, huge_page_allocator=None\n                ) -> \"CompressedP4FlatTensor\":\n        \"\"\"Move all compressed buffers to pinned/hugepage CPU memory.\"\"\"\n        for attr in self._BUFFER_ATTRS:\n            gpu_tensor = getattr(self, attr)\n            if gpu_tensor.numel() == 0:\n                cpu_tensor = gpu_tensor.to(\"cpu\")\n            elif huge_page_allocator is not None:\n                gpu_tensor = gpu_tensor.contiguous()\n                try:\n                    hp_tensor = huge_page_allocator.allocate(\n                        gpu_tensor.shape, gpu_tensor.stride(),\n                        gpu_tensor.dtype, page_type=\"weight\")\n                    hp_tensor.copy_(gpu_tensor)\n                    cpu_tensor = hp_tensor\n                except (MemoryError, ValueError):\n                    logger.warning(\n                        \"Hugepage exhausted for P4Flat to_host (attr=%s); \"\n                        \"falling back to pinned memory\", attr)\n                    cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            else:\n                cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            setattr(self, attr, cpu_tensor)\n            setattr(self._c, attr, cpu_tensor)\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n        self._h2d_views = None\n        self._h2d_srcs = None\n        self._gpu_buf_cache = None\n        import gc\n        gc.collect()\n        torch.cuda.empty_cache()\n        return self\n\n    def to(self, device=\"cuda\", non_blocking=True) -> None:\n        \"\"\"H2D copy CPU-resident buffers into pre-bound GPU staging slots.\n\n        Hot path: called ~320×/step (4 components × ~80 layers).  Uses\n        pre-cached narrow views and source tensors from\n        ``register_temp_d_tensor`` and dispatches ALL 10 copies in a single\n        C++ call (``batch_h2d``), eliminating 10 Python → C++ frame\n        transitions per call (~2880/step) that were the dominant source of\n        CPython frame data-stack 16 KiB boundary crossings (mmap/munmap).\n        \"\"\"\n        del device\n        views = self._h2d_views\n        if views is None:\n            raise RuntimeError(\n                \"CompressedP4FlatTensor.to(): call register_temp_d_tensor first\")\n        srcs = self._h2d_srcs\n        if srcs is None:\n            srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n            self._h2d_srcs = srcs\n        # Single C++ dispatch: copies all 10 (src, dst) pairs on the current\n        # CUDA stream without leaving this Python frame.\n        _p4f_ext.batch_h2d(srcs, views)\n\n    def get_gpu_buffers(self):\n        cache = self._gpu_buf_cache\n        if cache is not None:\n            return cache\n        views = self._h2d_views\n        if views is not None:\n            # Reuse the same narrow views created by register_temp_d_tensor\n            # — the data is updated in-place by .to(), so the views always\n            # reflect the latest GPU staging contents.\n            self._gpu_buf_cache = views\n            return views\n        out = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            n = getattr(self, attr).numel()\n            dst = getattr(self, d_attr)\n            out.append(dst[:n] if n > 0 else dst)\n        cache = tuple(out)\n        self._gpu_buf_cache = cache\n        return cache\n\n\nclass P4FlatCompressor(TensorCompressor):\n    \"\"\"BF16 P4-flat weight compressor backed by tiered-serve's\n    ``zipserv_p4flat_ext`` PyTorch C++ extension.\n\n    Per-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa\n    byte. Out-of-palette exponents are stored as a separate (index,\n    value) list and reinjected by the patch kernel during decompress\n    — so the result is bit-exact-equivalent to the original BF16\n    weight.\n\n    Compress runs on the GPU (one CTA per 64x64 tile).  M and K must be\n    multiples of 64.\n","exit_code":0,"duration":{"secs":0,"nanos":2944},"formatted_output":"bash: line 1: rg: command not found\n\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n\n_ROLE_PATS = (\n    (\"q_proj\", \"q\"), (\"k_proj\", \"k\"), (\"v_proj\", \"v\"), (\"o_proj\", \"o\"),\n    (\"gate_proj\", \"gate\"), (\"up_proj\", \"up\"), (\"down_proj\", \"down\"),\n    (\".wq.\", \"q\"), (\".wk.\", \"k\"), (\".wv.\", \"v\"), (\".wo.\", \"o\"),\n    (\".w1.\", \"gate\"), (\".w3.\", \"up\"), (\".w2.\", \"down\"),\n)\n\n#: Fused group name -> the projection roles concatenated along dim 0.\n_GROUP_DEFS = OrderedDict([\n    (\"qkv\", (\"q\", \"k\", \"v\")),\n    (\"o\", (\"o\",)),\n    (\"gateup\", (\"gate\", \"up\")),\n    (\"down\", (\"down\",)),\n])\n\n\ndef _role(key):\n    for pat, r in _ROLE_PATS:\n        if pat in key:\n            return r\n    return None\n\n\ndef _build_layer_index(shards, layer_filter):\n    \"\"\"Map ``layer_idx -> {role: (shard_path, key)}`` across all shards.\"\"\"\n    index = {}\n    for shard in shards:\n        with safe_open(shard, framework=\"pt\") as sf:\n            for k in sf.keys():\n                r = _role(k)\n                if r is None:\n                    continue\n                m = _LAYER_RE.search(k)\n                if m is None:\n                    continue\n                li = int(m.group(1))\n                if layer_filter is not None and li != layer_filter:\n                    continue\n                index.setdefault(li, {})[r] = (shard, k)\n    return index\n\n\ndef _load_layer(parts):\n    \"\"\"Load every projection tensor for one layer; ``role -> CPU tensor``.\"\"\"\n    by_shard = {}\n    for role, (shard, key) in parts.items():\n        by_shard.setdefault(shard, []).append((role, key))\n    out = {}\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for role, key in items:\n                out[role] = sf.get_tensor(key)\n    return out\n\n\ndef _max_fused_numel(index, group_filter):\n    \"\"\"Largest element count among the fused groups that will be benchmarked.\n\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n            reinterpret_cast<const uint32_t*>(comp.exc_group_m.data_ptr());\n        exc_group_off_ptr =\n            reinterpret_cast<const uint32_t*>(comp.exc_group_offsets.data_ptr());\n    }\n\n    cudaError_t err = BF16P4Flat_FusedMM_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        exc_sorted_idx_ptr, exc_sorted_val_ptr,\n        exc_group_m_ptr, exc_group_off_ptr,\n        comp.num_groups,\n        reinterpret_cast<const __nv_bfloat16*>(B_c.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)comp.M, N, (int)comp.K);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_FusedMM_API failed: \", cudaGetErrorString(err));\n    return C;\n}\n\ntorch::Tensor p4flat_decompress(const CompressedP4Flat& comp,\n                                c10::optional<torch::Tensor> output_opt) {\n    TORCH_CHECK(comp.M > 0 && comp.K > 0, \"compressed object has invalid shape\");\n\n    torch::Tensor output;\n    if (output_opt.has_value()) {\n        output = output_opt.value();\n        TORCH_CHECK(output.is_cuda(), \"output must be on CUDA\");\n        TORCH_CHECK(output.scalar_type() == at::kBFloat16,\n                    \"output dtype must be bfloat16\");\n        TORCH_CHECK(output.size(0) == comp.M && output.size(1) == comp.K,\n                    \"output shape mismatch\");\n    } else {\n        output = torch::empty(\n            {comp.M, comp.K},\n            torch::TensorOptions().dtype(at::kBFloat16).device(torch::kCUDA));\n    }\n    TORCH_CHECK(comp.headers.is_cuda() && comp.codes.is_cuda() &&\n                comp.sign_mantissa.is_cuda(),\n                \"compressed buffers must be on CUDA for GPU decompress\");\n\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t err = BF16P4Flat_Decompress_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        comp.num_exceptions > 0\n            ? reinterpret_cast<const uint32_t*>(comp.exc_indices.data_ptr())\n            : nullptr,\n        comp.num_exceptions > 0\n            ? reinterpret_cast<const uint16_t*>(comp.exc_values.data_ptr())\n            : nullptr,\n        comp.num_exceptions,\n        reinterpret_cast<uint16_t*>(output.data_ptr()),\n        (int)comp.M, (int)comp.K,\n        comp.row_major_sm ? 1 : 0);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_Decompress_API failed: \",\n                cudaGetErrorString(err));\n    return output;\n}\n\ntorch::Tensor p4flat_decode_bench(const CompressedP4Flat& comp,\n                                  torch::Tensor output, int64_t mode) {\n    TORCH_CHECK(comp.M > 0 && comp.K > 0, \"compressed object has invalid shape\");\n    TORCH_CHECK(output.is_cuda() && output.scalar_type() == at::kBFloat16,\n                \"output must be CUDA bfloat16\");\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t err = BF16P4Flat_DecodeBench_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        reinterpret_cast<uint16_t*>(output.data_ptr()),\n        (int)comp.M, (int)comp.K, (int)mode);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_DecodeBench_API failed: \", cudaGetErrorString(err));\n    return output;\n}\n\n// ---------------------------------------------------------------------------\n//  Host (CPU) P4-flat batch encoder.\n//\n//  Byte-identical to the NumPy reference ``_p4flat_cpu_encode_block`` (palette\n//  mode, row_major_sm=1, subtile_codec all-0xFF), but written in C++ and\n//  parallelised across blocks with OpenMP under a released GIL — so it scales\n//  linearly across cores instead of bottlenecking on the Python GIL.  Each\n//  block writes only into its own (unique) pool slot, so the parallel loop\n//  needs no synchronisation.\n//\n//  Layout per slot row: [headers | codes | sm | subtile_codec(0xFF) |\n//  exc_idx(u32 LE) | exc_val(u16 LE)], or raw BF16 of the valid rows on\n//  fallback.  ``valid_tm`` (occupancy) restricts encoding to the first\n//  valid_tm 64-row tile bands; the rest of the block is left untouched.\n// ---------------------------------------------------------------------------\n// 256-bin exponent histogram of one 64x64 tile.  4 interleaved sub-histograms\n// break the counts[x]++ read-after-write chain (spatially-correlated KV exps hit\n// the same bucket back-to-back).  Measured fastest on Grace/V2 — an SVE2\n// gather+HISTCNT+scatter version was byte-exact but ~25% SLOWER (gather/scatter\n// is expensive on V2), and the histogram is not the encoder bottleneck anyway.\nstatic inline void p4f_hist64(const uint16_t* in, int64_t r0, int64_t c0,\n                              int64_t K_b, int* counts) {\n    int c0h[256], c1h[256], c2h[256], c3h[256];\n    for (int e = 0; e < 256; ++e) { c0h[e]=c1h[e]=c2h[e]=c3h[e]=0; }\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int x = 0; x < 64; x += 4) {\n            c0h[(rp[x]     >> 7) & 0xFF]++;\n            c1h[(rp[x + 1] >> 7) & 0xFF]++;\n            c2h[(rp[x + 2] >> 7) & 0xFF]++;\n            c3h[(rp[x + 3] >> 7) & 0xFF]++;\n        }\n    }\n    for (int e = 0; e < 256; ++e) counts[e] = c0h[e] + c1h[e] + c2h[e] + c3h[e];\n}\n\n\"\"\"Lossless BF16 ChunkDelta3 compressor.\n\nChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\n16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\nencodes exponent deltas in three bits.  Values outside the local 3-bit range\nare restored from tile-local 20-bit ``(exponent8, position12)`` exceptions,\npacked three per aligned 64-bit word, making the codec bit exact.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\ntry:\n    from tiered_serve.cpp_exts import tp3_cd3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load tp3_cd3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n            alignment = tensor.element_size()\n            offset = (offset + alignment - 1) // alignment * alignment\n            layout.append(\n                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n            offset += tensor.nbytes\n\n        if huge_page_allocator is not None:\n            try:\n                host_slab = huge_page_allocator.allocate(\n                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n            except (MemoryError, ValueError):\n                logger.warning(\n                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n                    \"pinned host memory\")\n                host_slab = torch.empty(offset, dtype=torch.uint8,\n                                        pin_memory=True)\n        else:\n            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n\n        host_views = []\n        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n            view.copy_(source)\n            setattr(self, attr, view)\n            host_views.append(view)\n        self._host_slab = host_slab\n        self._slab_layout = tuple(layout)\n        self._device_slab = None\n        self._h2d_views = None\n        self._h2d_sources = None\n        self._copy_slab = False\n        self._set_native_buffers(tuple(host_views))\n        return self\n\n    def to(self, device=\"cuda\", non_blocking: bool = True):\n        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n        if torch.device(device).type != \"cuda\":\n            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n        if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # GH200 serving calibration covers the lossless Packed20x3 kernels through\n    # N=128.  Above that point the normal dense decompress+cuBLAS route wins.\n    # Keep the environment override for cross-GPU/model retuning.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 128,\n        (8192, 8192): 128,\n        (57344, 8192): 128,\n        (8192, 28672): 128,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        # Weight compression is an offline/load-time operation.  Keep its\n        # compute on the host so it never steals SM time from serving.  The\n        # completed compressed buffers are staged to CUDA only when the input\n        # itself is CUDA; CPU callers retain a host-resident result.\n        self._cpu_weight_encode = (\n            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n\"\"\"BF16 P4-flat weight compressor.\n\nPer-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa byte.\nOut-of-palette exponents are stored as a separate (index, value) list and\nre-injected by a patch kernel during decompress — so the result is\nbit-exact-equivalent to the original BF16 weight.\n\nCompress runs on the GPU (one CTA per 64×64 tile).  Both compress and\ndecompress are delivered by the native PyTorch C++ extension\n``tiered_serve.cpp_exts.zipserv_p4flat_ext``.  No native fused\ndecompress+MM kernel: ``linear_apply`` falls through to the base class\ndefault (``decompress + F.linear``) which empirically beats every fused\nvariant on real LLM weights for decode-N shapes.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4FlatCompressor disabled: failed to load \"\n        f\"zipserv_p4flat_ext ({type(_e).__name__}: {_e})\")\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass Comp