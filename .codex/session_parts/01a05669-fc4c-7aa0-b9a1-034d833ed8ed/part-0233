{"timestamp":"2026-09-01T06:08:10.167Z","ordinal":11554,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05b92-35ce-7bc3-a247-93bd68f8de3a","item":{"type":"CommandExecution","id":"exec-bc3d652e-7a52-4679-98af-c4a170097f1b","process_id":"11004","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc \"cd /root/projects/tiered-serve && rg -n 'weight.*h2d|resident.*decode|decode.*bench|frozen_split|_coalesced_h2d|_zipserv_pipeline_plan' benchmarks tiered_serve | head -240 && sed -n '1,260p' benchmarks/weight_compress.py && sed -n '640,760p' tiered_serve/compression/adapters/cuda/zipserv_p4flat_ext.cpp && sed -n '1,260p' tiered_serve/compression/core/chunk_delta3.py && sed -n '1,220p' tiered_serve/compression/core/p4flat.py\""],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc \"cd /root/projects/tiered-serve && rg -n 'weight.*h2d|resident.*decode|decode.*bench|frozen_split|_coalesced_h2d|_zipserv_pipeline_plan' benchmarks tiered_serve | head -240 && sed -n '1,260p' benchmarks/weight_compress.py && sed -n '640,760p' tiered_serve/compression/adapters/cuda/zipserv_p4flat_ext.cpp && sed -n '1,260p' tiered_serve/compression/core/chunk_delta3.py && sed -n '1,220p' tiered_serve/compression/core/p4flat.py\""}],"source":"unified_exec_startup","status":"completed","stdout":"bash: line 1: rg: command not found\n\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n\n_ROLE_PATS = (\n    (\"q_proj\", \"q\"), (\"k_proj\", \"k\"), (\"v_proj\", \"v\"), (\"o_proj\", \"o\"),\n    (\"gate_proj\", \"gate\"), (\"up_proj\", \"up\"), (\"down_proj\", \"down\"),\n    (\".wq.\", \"q\"), (\".wk.\", \"k\"), (\".wv.\", \"v\"), (\".wo.\", \"o\"),\n    (\".w1.\", \"gate\"), (\".w3.\", \"up\"), (\".w2.\", \"down\"),\n)\n\n#: Fused group name -> the projection roles concatenated along dim 0.\n_GROUP_DEFS = OrderedDict([\n    (\"qkv\", (\"q\", \"k\", \"v\")),\n    (\"o\", (\"o\",)),\n    (\"gateup\", (\"gate\", \"up\")),\n    (\"down\", (\"down\",)),\n])\n\n\ndef _role(key):\n    for pat, r in _ROLE_PATS:\n        if pat in key:\n            return r\n    return None\n\n\ndef _build_layer_index(shards, layer_filter):\n    \"\"\"Map ``layer_idx -> {role: (shard_path, key)}`` across all shards.\"\"\"\n    index = {}\n    for shard in shards:\n        with safe_open(shard, framework=\"pt\") as sf:\n            for k in sf.keys():\n                r = _role(k)\n                if r is None:\n                    continue\n                m = _LAYER_RE.search(k)\n                if m is None:\n                    continue\n                li = int(m.group(1))\n                if layer_filter is not None and li != layer_filter:\n                    continue\n                index.setdefault(li, {})[r] = (shard, k)\n    return index\n\n\ndef _load_layer(parts):\n    \"\"\"Load every projection tensor for one layer; ``role -> CPU tensor``.\"\"\"\n    by_shard = {}\n    for role, (shard, key) in parts.items():\n        by_shard.setdefault(shard, []).append((role, key))\n    out = {}\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for role, key in items:\n                out[role] = sf.get_tensor(key)\n    return out\n\n\ndef _max_fused_numel(index, group_filter):\n    \"\"\"Largest element count among the fused groups that will be benchmarked.\n\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n            reinterpret_cast<const uint32_t*>(comp.exc_group_m.data_ptr());\n        exc_group_off_ptr =\n            reinterpret_cast<const uint32_t*>(comp.exc_group_offsets.data_ptr());\n    }\n\n    cudaError_t err = BF16P4Flat_FusedMM_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        exc_sorted_idx_ptr, exc_sorted_val_ptr,\n        exc_group_m_ptr, exc_group_off_ptr,\n        comp.num_groups,\n        reinterpret_cast<const __nv_bfloat16*>(B_c.data_ptr()),\n        reinterpret_cast<__nv_bfloat16*>(C.data_ptr()),\n        (int)comp.M, N, (int)comp.K);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_FusedMM_API failed: \", cudaGetErrorString(err));\n    return C;\n}\n\ntorch::Tensor p4flat_decompress(const CompressedP4Flat& comp,\n                                c10::optional<torch::Tensor> output_opt) {\n    TORCH_CHECK(comp.M > 0 && comp.K > 0, \"compressed object has invalid shape\");\n\n    torch::Tensor output;\n    if (output_opt.has_value()) {\n        output = output_opt.value();\n        TORCH_CHECK(output.is_cuda(), \"output must be on CUDA\");\n        TORCH_CHECK(output.scalar_type() == at::kBFloat16,\n                    \"output dtype must be bfloat16\");\n        TORCH_CHECK(output.size(0) == comp.M && output.size(1) == comp.K,\n                    \"output shape mismatch\");\n    } else {\n        output = torch::empty(\n            {comp.M, comp.K},\n            torch::TensorOptions().dtype(at::kBFloat16).device(torch::kCUDA));\n    }\n    TORCH_CHECK(comp.headers.is_cuda() && comp.codes.is_cuda() &&\n                comp.sign_mantissa.is_cuda(),\n                \"compressed buffers must be on CUDA for GPU decompress\");\n\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t err = BF16P4Flat_Decompress_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        comp.num_exceptions > 0\n            ? reinterpret_cast<const uint32_t*>(comp.exc_indices.data_ptr())\n            : nullptr,\n        comp.num_exceptions > 0\n            ? reinterpret_cast<const uint16_t*>(comp.exc_values.data_ptr())\n            : nullptr,\n        comp.num_exceptions,\n        reinterpret_cast<uint16_t*>(output.data_ptr()),\n        (int)comp.M, (int)comp.K,\n        comp.row_major_sm ? 1 : 0);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_Decompress_API failed: \",\n                cudaGetErrorString(err));\n    return output;\n}\n\ntorch::Tensor p4flat_decode_bench(const CompressedP4Flat& comp,\n                                  torch::Tensor output, int64_t mode) {\n    TORCH_CHECK(comp.M > 0 && comp.K > 0, \"compressed object has invalid shape\");\n    TORCH_CHECK(output.is_cuda() && output.scalar_type() == at::kBFloat16,\n                \"output must be CUDA bfloat16\");\n    auto stream = c10::cuda::getCurrentCUDAStream();\n    cudaError_t err = BF16P4Flat_DecodeBench_API(\n        stream.stream(),\n        reinterpret_cast<const BF16P4FlatHeader*>(comp.headers.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.codes.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.sign_mantissa.data_ptr()),\n        reinterpret_cast<const uint8_t*>(comp.subtile_codec.data_ptr()),\n        reinterpret_cast<uint16_t*>(output.data_ptr()),\n        (int)comp.M, (int)comp.K, (int)mode);\n    TORCH_CHECK(err == cudaSuccess,\n                \"BF16P4Flat_DecodeBench_API failed: \", cudaGetErrorString(err));\n    return output;\n}\n\n// ---------------------------------------------------------------------------\n//  Host (CPU) P4-flat batch encoder.\n//\n//  Byte-identical to the NumPy reference ``_p4flat_cpu_encode_block`` (palette\n//  mode, row_major_sm=1, subtile_codec all-0xFF), but written in C++ and\n//  parallelised across blocks with OpenMP under a released GIL — so it scales\n//  linearly across cores instead of bottlenecking on the Python GIL.  Each\n//  block writes only into its own (unique) pool slot, so the parallel loop\n//  needs no synchronisation.\n//\n//  Layout per slot row: [headers | codes | sm | subtile_codec(0xFF) |\n//  exc_idx(u32 LE) | exc_val(u16 LE)], or raw BF16 of the valid rows on\n//  fallback.  ``valid_tm`` (occupancy) restricts encoding to the first\n//  valid_tm 64-row tile bands; the rest of the block is left untouched.\n// ---------------------------------------------------------------------------\n// 256-bin exponent histogram of one 64x64 tile.  4 interleaved sub-histograms\n// break the counts[x]++ read-after-write chain (spatially-correlated KV exps hit\n// the same bucket back-to-back).  Measured fastest on Grace/V2 — an SVE2\n// gather+HISTCNT+scatter version was byte-exact but ~25% SLOWER (gather/scatter\n// is expensive on V2), and the histogram is not the encoder bottleneck anyway.\nstatic inline void p4f_hist64(const uint16_t* in, int64_t r0, int64_t c0,\n                              int64_t K_b, int* counts) {\n    int c0h[256], c1h[256], c2h[256], c3h[256];\n    for (int e = 0; e < 256; ++e) { c0h[e]=c1h[e]=c2h[e]=c3h[e]=0; }\n    for (int r = 0; r < 64; ++r) {\n        const uint16_t* rp = in + (r0 + r) * K_b + c0;\n        for (int x = 0; x < 64; x += 4) {\n            c0h[(rp[x]     >> 7) & 0xFF]++;\n            c1h[(rp[x + 1] >> 7) & 0xFF]++;\n           