ots] >= 2)).any()):\n                self._secondary_fallback_possible[layer_id] = True\n        _t2 = time.perf_counter()  # encode done\n        with self._pin_lock:\n            self._wt_wraw += (_ta - _t0)\n            self._wt_wait += (_t1 - _t0)\n            self._wt_comp += (_t2 - _t1)\n            self._wt_n += 1\n            if self._wt_n >= 2000:\n                _n = self._wt_n\n                logger.warning(\n                    \"[kv-compress] per-call: raw-D2H wait %.2f ms | \"\n                    \"decode-H2D wait %.2f ms | encode %.2f ms | %d calls\",\n                    self._wt_wraw / _n * 1e3,\n                    (self._wt_wait - self._wt_wraw) / _n * 1e3,\n                    self._wt_comp / _n * 1e3, _n)\n                self._wt_wraw = self._wt_wait = self._wt_comp = 0.0\n                self._wt_n = 0\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        # Keep the pending entry visible while Event.wait() releases the GIL.\n        # A scheduler/free callback running on another Python thread must still\n        # quarantine the worker's captured physical slots instead of returning\n        # them to the allocation heap before the old worker retires.\n        with self._slot_state_lock:\n            state = self._pending_compress.get(layer_id)\n        if state is not None:\n            try:\n                if 'state' in state:\n                    self._wait_worker_state(state['state'], timeout_sec)\n                else:\n                    for f in state['futures']:\n                        f.result()   # join + propagate worker exceptions\n            except BaseException:\n                if 'state' in state:\n                    worker_retired = state['state']['done'].is_set()\n                else:\n                    worker_retired = all(\n                        future.done() for future in state['futures'])\n                with self._slot_state_lock:\n                    if (worker_retired\n                            and self._pending_compress.get(layer_id) is state):\n                        self._pending_compress.pop(layer_id, None)\n                        deferred = self._deferred_slot_frees.pop(\n                            layer_id, set())\n                        for slot in deferred:\n                            self._release_quarantined_slot(layer_id, slot)\n                # A timeout leaves pending and quarantined rows intact because\n                # the worker may still write them. A terminal worker error has\n                # retired the task; rows were invalidated before enqueue.\n                raise\n            else:\n                buffer_ids = state['buffer_ids']\n                with self._slot_state_lock:\n                    if self._pending_compress.get(layer_id) is state:\n                        try:\n                            pv = self._persistent_valid[layer_id]\n                            # Publish only canonical ids that still own the\n                            # exact physical rows captured by this worker.\n                            if len(buffer_ids):\n                                _bids = np.asarray(\n                                    buffer_ids, dtype=np.int64)\n                                _captured = np.asarray(\n                                    state['physical_slots'], dtype=np.int64)\n                                if _captured.shape != _bids.shape:\n                                    raise RuntimeError(\n                                        \"P4Flat CPU KV pending id/slot shape \"\n                                        f\"mismatch: ids={_bids.shape}, \"\n                                        f\"slots={_captured.shape}\")\n                                _sl = self._kv_slot[\n                                    layer_id][torch.from_numpy(_bids)].numpy()\n                                _va = np.frombuffer(pv, dtype=np.uint8)\n                                _idx = _bids[\n                                    (_sl >= 0) & (_sl == _captured)]\n                                _va[_idx] = 1\n                        finally:\n                            self._pending_compress.pop(layer_id, None)\n                            deferred = self._deferred_slot_frees.pop(\n                                layer_id, set())\n                            for slot in deferred:\n                                self._release_quarantined_slot(layer_id, slot)\n        else:\n            buffer_ids = []\n        # Always publish an entry (empty when no blocks were scheduled for\n        # this layer this iteration) so the shared\n        # ``wait_for_layer_pipeline_cpp`` contract holds — mirrors ZipServ,\n        # whose ``wait_compress_async`` always populates ``_compressed_kv``.\n        self._compressed_kv[layer_id] = {\n            # int64 ndarray (or [] when nothing was scheduled) — popped+discarded\n            # on the p4flat/ublb decode path (no Python-list reader); avoids a\n            # per-layer list() materialization on the forward thread.\n            'buffer_ids': buffer_ids,\n            'block_shape': block_shape,\n            'n': len(buffer_ids),\n        }\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode this layer's KV.  WAIT-BASED ordering (no host synchronize):\n\n\n                    # 2. ZipServ workers wait on that event, then read the\n                    # secondary_kv host tensors directly and write compressed\n                    # output into the persistent LPDDR pool.  This avoids the\n                    # extra private D2H used by gpu_direct.\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_push(\n                            \"schedule_pipeline_offload_from_host\")\n                    secondary_kv = DualMemoryLoader.kv_caches[layer_id].secondary_kv\n                    self.kv_offload_scheduler.schedule_pipeline_offload_from_host(\n                        kv_sys, layer_id, valid_ids,\n                        secondary_kv[0], secondary_kv[1],\n                        unload_event,\n                        kv_compressor=self.kv_compressor)\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_pop()\n                else:\n                    # 1. Compressed D2H + CPU/GPU compress → persistent pool\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_push(\"schedule_pipeline_offload\")\n                    self.kv_offload_scheduler.schedule_pipeline_offload(\n                        kv_sys, layer_id, valid_ids,\n                        DualMemoryLoader.primary_k_caches[layer_id],\n                        DualMemoryLoader.primary_v_caches[layer_id],\n                        kv_compressor=self.kv_compressor)\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_pop()\n                    # 2. Also uncompressed D2H → secondary pool (for prefill reads)\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_push(\n                            \"schedule_unload_uncompressed\")\n                    self.kv_offload_scheduler.schedule_unload_uncompressed(\n                        kv_sys, layer_id, valid_ids,\n                        self.kv_unload_done[layer_id].cuda_event,\n                        already_sorted=True, wait_event=self.unload_kv_barriers[layer_id])\n                    if _ENV_KV_DETAILED_NVTX:\n                        torch.cuda.nvtx.range_pop()\n\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_push(\"after_compress_event_record\")\n        self.after_compress_events[layer_id].record(\n            self.kv_compressor.comp_stream)\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_pop()\n        if _ENV_KV_CPU_PROFILE:\n            _tu1 = _time.perf_counter()\n            self._step_unload_disp_ms += (_tu1 - _tu0) * 1000\n        if _ENV_KV_DETAILED_NVTX:\n            torch.cuda.nvtx.range_pop()  # unload_comped_kv\n\n        if layer_id == self.n_layers - 1:\n            # Ensure last layer's compress + D2H completes before the\n            # next iteration reads the CPU pinned buffers.  Use a\n            # GPU-stream wait (not CPU synchronize) so the CPU stays free.\n            self.kv_compressor.batch_decomp_stream.wait_event(\n                self.after_compress_events[layer_id])\n\n    def prepare_decomp_kv(self):\n        if not hasattr(DualMemoryLoader, \"kv_offload_system\"):\n            return\n\n        # Persistent compressed load/decode builds its own metadata from the\n        # host pool.  The legacy background result has no consumer in either\n        # pure decode or opt-in compressed-prefill, so avoid starting a worker\n        # that only adds foreground contention.\n        if (\n","stderr":"","aggregated_output":"            t.start()\n            self._workers.append(t)\n        logger.info(\n            \"P4Flat CPU KV encoder: C++ OpenMP (host_encode_blocks), \"\n            \"%d worker(s), pin=%s, core_start=%d, omp_cap=%d, main_omp=%s\",\n            _nw, self._pin_workers, self._reserve_cores,\n            self._omp_thread_cap, os.environ.get(\"OMP_NUM_THREADS\", \"unset\"))\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_q.get()\n            if item is None:\n                return\n            state, args = item\n            try:\n                self._encode_chunk(*args)\n                state['error'] = None\n            except BaseException as exc:  # propagate through wait_compress_async\n                state['error'] = exc\n            finally:\n                state['done'].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {'done': done, 'error': None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state['done'].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for p4flat KV CPU worker\")\n        err = state.get('error')\n        if err is not None:\n            raise err\n\n    def _pin_worker_thread(self) -> None:\n        \"\"\"First task on each pool thread: pin to a disjoint core block and cap\n        its OpenMP team size (called at the top of _encode_chunk).\"\"\"\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        n = self._n_workers\n        with self._pin_lock:\n            idx = self._pin_counter[0] % n\n            self._pin_counter[0] += 1\n        # Respect an outer taskset/cgroup cpuset.  CPU IDs need not be dense, so\n        # split the actual allowed-ID list rather than constructing range(ncpu).\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            try:\n                # This ICV is local to the async worker's OpenMP task.  Keep\n                # libgomp from silently shrinking the dedicated encoder team\n                # even if the parent environment exported OMP_DYNAMIC=TRUE.\n                self._omp_lib.omp_set_dynamic(0)\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\n                    \"p4flat compress worker %d: omp_set_dynamic failed %s\",\n                    idx, _e)\n        if not self._pin_workers:\n            # Team sizing is independent of affinity pinning.  This matters\n            # when the production entry point keeps main ATen at OMP=1: an\n            # explicitly unpinned encoder must still receive its dedicated N.\n            nt = min(len(allowed), self._omp_thread_cap)\n            if self._omp_lib is not None:\n                try:\n                    self._omp_lib.omp_set_num_threads(int(nt))\n                except Exception as _e:  # noqa: BLE001\n                    logger.warning(\n                        \"p4flat compress worker %d: omp_set_num_threads \"\n                        \"failed %s\", idx, _e)\n            with self._pin_lock:\n                self._worker_affinities[idx] = tuple(allowed)\n                self._worker_omp_threads[idx] = nt\n            logger.info(\n                \"p4flat compress worker %d unpinned (%d allowed, OMP=%d)\",\n                idx, len(allowed), nt)\n            return\n        compress_cpus = [cpu for cpu in allowed\n                         if cpu >= self._reserve_cores]\n        if len(compress_cpus) < n:\n            logger.warning(\n                \"p4flat compress: only %d CPU(s) remain at/after core %d for \"\n                \"%d worker(s); falling back to the inherited affinity %s\",\n                len(compress_cpus), self._reserve_cores, n, allowed)\n            compress_cpus = allowed\n        # Limit the affinity itself to n*cap CPUs instead of letting a smaller\n        # team roam over every remaining CPU.  The default one-worker case is\n        # therefore exactly cores 8-63 on the measured 64-core host.\n        usable = compress_cpus[:min(\n            len(compress_cpus), n * self._omp_thread_cap)]\n        lo_i = len(usable) * idx // n\n        hi_i = len(usable) * (idx + 1) // n\n        block = set(usable[lo_i:hi_i])\n        if not block:\n            # Only possible with more workers than allowed CPUs.\n            block = {compress_cpus[idx % len(compress_cpus)]}\n        nt = len(block)\n        try:\n            os.sched_setaffinity(0, block)\n        except OSError as _e:\n            logger.warning(\"p4flat compress worker %d: setaffinity failed %s\",\n                           idx, _e)\n        if self._omp_lib is not None:\n            try:\n                self._omp_lib.omp_set_num_threads(int(nt))\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\"p4flat compress worker %d: omp_set_num_threads \"\n                               \"failed %s\", idx, _e)\n        affinity = tuple(sorted(block))\n        with self._pin_lock:\n            self._worker_affinities[idx] = affinity\n            self._worker_omp_threads[idx] = nt\n        logger.info(\n            \"p4flat compress worker %d -> cores %d-%d (%d allowed, OMP=%d), \"\n            \"cores 0-%d reserved for forward\",\n            idx, affinity[0], affinity[-1], len(affinity), nt,\n            self._reserve_cores - 1)\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Analytic sizes — no GPU.  The CPU encoder stores sm row-major\n        (``row_major_sm=1``) and ``subtile_codec`` all-``0xFF``.\"\"\"\n        num_tiles = (M_b // 64) * (K_b // 64)\n        hb = num_tiles * 16\n        cb = M_b * K_b // 2\n        smb = M_b * K_b\n        cdb = (M_b // 16) * (K_b // 16)\n        self._idx_dtype = torch.int32\n        self._val_dtype = torch.int16\n        self._idx_es = 4\n        self._val_es = 2\n        self._row_major_sm = 1\n        return hb, cb, smb, cdb\n\n    # gpu_direct path is not supported on this subclass — it is the\n    # cpu_after_raw_swap encoder.  For GPU-side p4flat compression use the\n    # base P4FlatKVCompressor (selected by TIERED_SERVE_KV_COMP_PRODUCER=\n    # gpu_direct, which is the default for --kv-comp p4flat).\n    def compress_batch_async(self, layer_id, block_ids, gpu_k, gpu_v):\n        raise NotImplementedError(\n            \"P4FlatCPUKVCompressor is the CPU-encode (cpu_after_raw_swap) \"\n            \"backend; it does not support the gpu_direct producer.  For GPU \"\n            \"compression use TIERED_SERVE_KV_COMP_PRODUCER=gpu_direct (the \"\n            \"default for --kv-comp p4flat), which selects P4FlatKVCompressor.\")\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        # The CPU producer can race scheduler free callbacks while its worker\n        # waits release the GIL. Serialize all slot ownership transitions.\n        with self._slot_state_lock:\n            return super()._assign_kv_slots(layer_id, block_ids)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Clear validity immediately and quarantine an in-flight slot.\n\n        The old CPU task may still write its captured ``slots_arr``. Keeping\n        that physical slot off the free heap until wait_compress_async retires\n        the task prevents it from corrupting a newly assigned block.\n        \"\"\"\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get('buffer_ids', ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64)\n            )\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_np = self._kv_slot_np.get(layer_id)\n                if slot_np is None or not 0 <= block_id < slot_np.size:\n                    return\n                slot = int(slot_np[block_id])\n                if slot < 0:\n                    return\n                slot_np[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n\n            self._free_kv_slot(layer_id, block_id)\n\n    def stop_kv_compress_workers(self) -> None:\n        workers = list(getattr(self, \"_workers\", ()))\n        for _ in workers:\n            self._work_q.put(None)\n        for t in workers:\n            t.join()\n        self._workers = []\n\n    # ------------------------------------------------------------------\n    #  cpu_after_raw_swap producer entry\n    # ------------------------------------------------------------------\n\n    def compress_batch_async_from_host(self, layer_id: int, block_ids: list,\n                                       host_k: torch.Tensor,\n                                       host_v: torch.Tensor,\n                                       wait_event_handle: int = 0) -> None:\n        \"\"\"Enqueue CPU compression from already-unloaded raw secondary KV.\n\n        ``host_k`` / ``host_v`` are the per-layer raw secondary tensors\n        (indexed by buffer id).  Workers wait on ``wait_event_handle`` (the\n        primary->secondary D2H completion) before reading them.\"\"\"\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        n_off = host_k.shape[0]\n        # Vectorised in-range filter + slot lookup — no per-block Python loop and\n        # no slots.tolist()/zip on the forward thread.  Both stay int64 numpy\n        # arrays and are handed straight to the worker, which builds the decode\n        # tensors zero-copy (torch.from_numpy) instead of re-zipping per block.\n        #\n        # Step memo: block_ids is the step-stable _valid_ids_cache object passed\n        # unchanged to every layer's offload, and n_off (secondary buffer block\n        # count) is layer-invariant, so the filtered array is identical across\n        # all ~80 layers of a step.  Key on (id(block_ids), n_off) and reuse —\n        # self-validating (a miss just recomputes; never wrong).  The shared\n        # bid_arr is read-only downstream (_assign_kv_slots gathers, the worker\n        # from_numpy-views it), and the memo REPLACES (never mutates) the cached\n        # array, so an in-flight worker from a prior step keeps its own copy.\n        if (block_ids is getattr(self, \"_fh_filter_key\", None)\n                and n_off == getattr(self, \"_fh_filter_noff\", -1)):\n            bid_arr = self._fh_filter_arr\n        else:\n            bid_arr = np.asarray(block_ids, dtype=np.int64)\n            if bid_arr.size:\n                bid_arr = bid_arr[(bid_arr >= 0) & (bid_arr < n_off)]\n            self._fh_filter_key = block_ids\n            self._fh_filter_noff = n_off\n            self._fh_filter_arr = bid_arr\n        if bid_arr.size == 0:\n            return\n        handle = int(wait_event_handle)\n        # WAIT-BASED pool-write ordering: this worker overwrites the same slots\n        # the decode just read via an async H2D.  Instead of host-synchronizing\n        # the decode (which serializes per-layer), the worker waits on this\n        # layer's decode-H2D-done event from its own thread.  Captured now; the\n        # decode→unload order in the layer loop means it holds this step's\n        # recording, and the next step's decode joins this worker before\n        # re-recording, so the worker always observes the correct (this-step)\n        # H2D completion (no main-thread block, no stale-event hazard).\n        dec_h2d = int(self._kv_dec_h2d[layer_id].cuda_event)\n        # Snapshot the per-step occupancy map at schedule time.  The hook\n        # *replaces* (never mutates) this dict each step, so capturing the\n        # reference here keeps a pipelined late encode reading its own step's\n        # counts even after the next step publishes a new map.\n        bvt = self._block_valid_tokens\n        # One task: the C++ encoder parallelises across blocks with OpenMP\n        # internally (splitting across Python workers would nest the pool x\n        # OMP threads and oversubscribe).\n        with self._slot_state_lock:\n            if layer_id in self._pending_compress:\n                raise RuntimeError(\n                    \"P4Flat CPU KV layer still has a pending task after join: \"\n                    f\"layer={layer_id}\")\n            slots_arr = np.asarray(\n                self._assign_kv_slots(layer_id, bid_arr), dtype=np.int64)\n            # A recompress may overwrite an already-valid row. Make it\n            # unavailable before the worker can start; success republishes\n            # only ids that still own these exact captured slots.\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None:\n                valid_np = np.frombuffer(valid, dtype=np.uint8)\n                valid_np[bid_arr] = 0\n\n            state = self._worker_state_for_layer(layer_id)\n            state['error'] = None\n            state['done'].clear()\n            pending = {\n                'state': state,\n                # Keep the int64 ndarray (no per-layer tolist() on the forward\n                # thread). wait_compress_async consumes it via np.asarray.\n                'buffer_ids': bid_arr,\n                # The async worker writes these exact physical rows.\n                'physical_slots': slots_arr,\n            }\n            # Publish ownership before enqueue. SimpleQueue.put can wake a\n            # worker immediately; a concurrent free must already see pending\n            # and quarantine the captured slot.\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_q.put((\n                    state,\n                    (layer_id, host_k, host_v, bid_arr, slots_arr,\n                     handle, bvt, dec_h2d)))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state['done'].set()\n                raise\n\n    def _invoke_host_encode(self, host_i16, bidx, slots_t, pool,\n                            M_b, K_b, valid_tm):\n        \"\"\"Codec-specific C++ host encode of a block group into pool slots.\n        Default = p4flat; ublb subclasses override with their blob encoder.\n        Factored out so the grouping/threading in _encode_chunk stays shared.\"\"\"\n        _p4f_ext.host_encode_blocks(\n            host_i16, bidx, slots_t,\n            pool['blob'], pool['total_size'], pool['exc_cnt'],\n            pool['is_raw'], pool['valid_rows'], M_b, K_b, valid_tm)\n\n    def _encode_chunk(self, layer_id: int, host_k: torch.Tensor,\n                      host_v: torch.Tensor, bid_arr, slots_arr,\n                      wait_handle: int, bvt=None, dec_h2d_handle: int = 0) -> None:\n        # Reads raw secondary KV (gated by the primary->secondary D2H event) and\n        # OVERWRITES the persistent pool slots.  The pool write must follow the\n        # decode's in-flight H2D read of those slots, so wait on the decode-H2D\n        # event too — both waits run here on the worker thread (not the forward\n        # thread), so they never serialize the main decode loop.\n        self._pin_worker_thread()\n        _t0 = time.perf_counter()\n        _sync_cuda_event(wait_handle)      # raw-D2H: unload input ready\n        _ta = time.perf_counter()\n        _sync_cuda_event(dec_h2d_handle)   # decode-H2D: slots free to overwrite\n        _t1 = time.perf_counter()  # GPU event wait done; encode starts\n        M_b, K_b = self._M_b, self._K_b\n        ntm = M_b // 64\n        bs, hd = self._block_size, self._hd\n\n        # Group blocks by valid_tm.  Occupancy OFF (no bvt) => every block is\n        # full (valid_tm == ntm) => a SINGLE group, tensors built zero-copy from\n        # the numpy arrays (torch.from_numpy, no per-block Python loop).\n        # Occupancy ON => one cheap list-comp (dict.get + arithmetic, no .item()).\n        # Each group is one C++ OpenMP call that reads src[block_ids[b]] directly\n        # from the host KV tensor (no gather copy) and writes serialized blobs +\n        # meta into the pool slots, GIL released.  ``host`` is the contiguous\n        # secondary-KV tensor [n_off, *block_shape]; its int16 view is\n        # flat-equivalent to [n_off, M_b, K_b].\n        if bvt is None or not bs or not hd:\n            groups = [(ntm, torch.from_numpy(bid_arr),\n                       torch.from_numpy(slots_arr))]\n        else:\n            from collections import defaultdict\n            gb = defaultdict(list)\n            gs = defaultdict(list)\n            for bid, slot in zip(bid_arr.tolist(), slots_arr.tolist()):\n                vt = max(1, min((int(bvt.get(bid, bs)) * hd + 4095) // 4096,\n                                ntm))\n                gb[vt].append(bid)\n                gs[vt].append(slot)\n            groups = [(vt, torch.from_numpy(np.asarray(gb[vt], dtype=np.int64)),\n                       torch.from_numpy(np.asarray(gs[vt], dtype=np.int64)))\n                      for vt in gb]\n\n        for valid_tm, bidx, slots_t in groups:\n            for host, kv in ((host_k, 'k'), (host_v, 'v')):\n                pool = self._host_pools[layer_id][kv]\n                self._invoke_host_encode(\n                    host.view(torch.int16), bidx, slots_t, pool,\n                    M_b, K_b, valid_tm)\n        if self._blob_stride < self._raw_bytes:\n            pools = self._host_pools[layer_id]\n            slots = np.asarray(slots_arr, dtype=np.int64)\n            if (((pools['k']['is_raw'].numpy()[slots] >= 2)\n                    | (pools['v']['is_raw'].numpy()[slots] >= 2)).any()):\n                self._secondary_fallback_possible[layer_id] = True\n        _t2 = time.perf_counter()  # encode done\n        with self._pin_lock:\n            self._wt_wraw += (_ta - _t0)\n            self._wt_wait += (_t1 - _t0)\n            self._wt_comp += (_t2 - _t1)\n            self._wt_n += 1\n            if self._wt_n >= 2000:\n                _n = self._wt_n\n                logger.warning(\n                    \"[kv-compress] per-call: raw-D2H wait %.2f ms | \"\n                    \"decode-H2D wait %.2f ms | encode %.2f ms | %d calls\",\n                    self._wt_wraw / _n * 1e3,\n                    (self._wt_wait - self._wt_wraw) / _n * 1e3,\n                    self._wt_comp / _n * 1e3, _n)\n                self._wt_wraw = self._wt_wait = self._wt_comp = 0.0\n                self._wt_n = 0\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        # Keep the pending entry visible while Event.wait() releases the GIL.\n        # A scheduler/free callback running on another Python thread must still\n        # quarantine the worker's captured physical slots instead of returning\n        # them to the allocation heap before the old worker retires.\n        with self._slot_state_lock:\n            state = self._pending_compress.get(layer_id)\n        if state is not None:\n            try:\n                if 'state' in state:\n                    self._wait_worker_state(state['state'], timeout_sec)\n                else:\n                    for f in state['futures']:\n                        f.result()   # join + propagate worker exceptions\n            except BaseException:\n                if 'state' in state:\n                    worker_retired =