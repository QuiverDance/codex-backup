gister-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n          