{"timestamp":"2026-09-01T07:46:53.609Z","ordinal":13704,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05bee-b4d9-7d91-9c13-042c2f3dc999","item":{"type":"CommandExecution","id":"exec-54a5f1dd-75fb-4225-a35b-639a1987a4c8","process_id":"75702","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'sed -n \"1,300p\" /root/projects/tiered-serve/benchmarks/kv_cpu_h2d_decode.py && sed -n \"1,340p\" /root/projects/tiered-serve/benchmarks/weight_cpu_h2d_decode.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'sed -n \"1,300p\" /root/projects/tiered-serve/benchmarks/kv_cpu_h2d_decode.py && sed -n \"1,340p\" /root/projects/tiered-serve/benchmarks/weight_cpu_h2d_decode.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3CPUKVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    if len(saved[k_name]) < count or len(saved[\"v_blocks\"]) < count:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    k = torch.stack(\n        [value.contiguous() for value in saved[k_name][:count]])\n    v = torch.stack(\n        [value.contiguous() for value in saved[\"v_blocks\"][:count]])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--blocks\", type=int, required=True)\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    codec_type = (ChunkDelta3CPUKVCompressor\n                  if args.codec == \"chunk_delta3\"\n                  else P4FlatCPUKVCompressor)\n    host_k, host_v = load_blocks(args.path, args.blocks)\n    compressor = codec_type(torch.cuda.Stream())\n    compressor.warmup_kv_buffers(\n        block_shape=BLOCK_SHAPE, max_n_blocks=args.blocks,\n        n_layers=1, max_gpu_blocks=args.blocks,\n        max_gpu_decomp_blocks=args.blocks)\n    compressor.init_kv_compress_workers(1, args.blocks, 1)\n    block_ids = list(range(args.blocks))\n\n    started = time.perf_counter()\n    compressor.compress_batch_async_from_host(\n        0, block_ids, host_k, host_v, 0)\n    compressor.wait_compress_async(0, BLOCK_SHAPE)\n    encode_ms = (time.perf_counter() - started) * 1e3\n\n    output_k = torch.empty(\n        args.blocks, *BLOCK_SHAPE, dtype=torch.bfloat16, device=\"cuda\")\n    output_v = torch.empty_like(output_k)\n    stream = compressor.batch_decomp_stream\n\n    def measure(operation):\n        def run_once():\n            begin = torch.cuda.Event(enable_timing=True)\n            end = torch.cuda.Event(enable_timing=True)\n            begin.record(stream)\n            with torch.cuda.stream(stream):\n                operation()\n            end.record(stream)\n            end.synchronize()\n            return begin.elapsed_time(end)\n\n        for _ in range(args.warmup):\n            run_once()\n        return [run_once() for _ in range(args.iterations)]\n\n    def production():\n        compressor.decompress_batch(\n            0, block_ids, (output_k, output_v))\n\n    # Populate device blobs, decode metadata, and the CD3 steady-state plan.\n    production()\n    torch.cuda.synchronize()\n\n    if args.codec == \"chunk_delta3\":\n        from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n        plan = compressor._decode_plans[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n\n        def resident_decode():\n            rows = plan[\"storage_rows\"]\n            _cd3_ext.decompress_chunk_delta3_batched_blob_pair(\n                compressor._gpu_decomp_pool[\"k\"][\"blob\"][:rows],\n                compressor._gpu_decomp_pool[\"v\"][\"blob\"][:rows],\n                plan[\"slots_gpu\"], plan[\"block_ids_gpu\"],\n                output_k.view(args.blocks, 128, 128),\n                output_v.view(args.blocks, 128, 128),\n                compressor._packed_capacity)\n    else:\n        blob_stride, block_numel, k_width, max_rows, max_exc = \\\n            compressor._fast_const\n        gi = compressor._gi_dev_ring[0]\n        gu = compressor._gu_dev_ring[0]\n        gb = compressor._gb_dev_ring[0]\n\n        def h2d_only():\n            compressor._batch_h2d(\n                [compressor._gpu_dec_blob[:args.blocks],\n                 compressor._gpu_dec_blob_v[:args.blocks]],\n                [compressor._host_pools[0][\"k\"][\"blob\"][:args.blocks],\n                 compressor._host_pools[0][\"v\"][\"blob\"][:args.blocks]])\n\n        def resident_decode():\n            compressor._invoke_decode_layer(\n                compressor._gpu_dec_blob,\n                compressor._gpu_dec_blob_v,\n                blob_stride, gi, gu, gb, args.blocks,\n                output_k, output_v, block_numel, k_width,\n                max_rows, max_exc, compressor._row_major_sm,\n                stream.cuda_stream)\n\n    h2d_samples = measure(h2d_only)\n    decode_samples = measure(resident_decode)\n    total_samples = measure(production)\n    torch.cuda.synchronize()\n\n    exact = (\n        torch.equal(output_k.cpu().view(torch.uint16),\n                    host_k.view(torch.uint16))\n        and torch.equal(output_v.cpu().view(torch.uint16),\n                        host_v.view(torch.uint16)))\n    raw_gib = (host_k.nbytes + host_v.nbytes) / 2**30\n    h2d_median = statistics.median(h2d_samples)\n    decode_median = statistics.median(decode_samples)\n    total_median = statistics.median(total_samples)\n    print(\n        f\"codec={args.codec} blocks={args.blocks} cpu_encode={encode_ms:.3f} \"\n        f\"h2d_min_med_p95={min(h2d_samples):.4f}/{h2d_median:.4f}/\"\n        f\"{percentile(h2d_samples, 0.95):.4f} ms \"\n        f\"decode_min_med_p95={min(decode_samples):.4f}/{decode_median:.4f}/\"\n        f\"{percentile(decode_samples, 0.95):.4f} ms \"\n        f\"total_min_med_p95={min(total_samples):.4f}/{total_median:.4f}/\"\n        f\"{percentile(total_samples, 0.95):.4f} ms \"\n        f\"raw_throughput={raw_gib / (total_median / 1e3):.2f} GiB/s \"\n        f\"bit_exact={exact}\")\n    compressor.stop_kv_compress_workers()\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Split frozen-split weight latency into H2D, resident decode, and total.\n\nBoth codecs are encoded from CPU BF16 weights.  Encode/setup is deliberately\noutside the CUDA-event measurements.  As in production frozen-split storage,\nsign|mantissa remains resident in HBM; CD3 tile exception offsets are resident\ntoo.  Only each codec's LPDDR-side exponent representation is copied per run.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport sys\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom benchmarks.weight_compress import (\n    _GROUP_DEFS,\n    _build_layer_index,\n    _load_layer,\n    _resolve_inputs,\n)\nfrom tiered_serve.compression.core.base import SplitStorageInfo\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    ChunkDelta3Compressor,\n    _cd3_ext,\n)\nfrom tiered_serve.compression.core.p4flat import (\n    P4FlatCompressor,\n    _p4f_ext,\n)\n\n\ndef _percentile(values, fraction):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef _measure(stream, operation, warmup, iterations):\n    begin = torch.cuda.Event(enable_timing=True)\n    end = torch.cuda.Event(enable_timing=True)\n\n    def once():\n        with torch.cuda.stream(stream):\n            begin.record(stream)\n            operation()\n            end.record(stream)\n        end.synchronize()\n        return begin.elapsed_time(end)\n\n    for _ in range(warmup):\n        once()\n    return [once() for _ in range(iterations)]\n\n\ndef _prepare(weight, codec_name, stream):\n    \"\"\"CPU-encode and return (h2d, decode, transfer_bytes, output, comp).\"\"\"\n    if codec_name == \"chunk_delta3\":\n        compressor = ChunkDelta3Compressor(stream, stream)\n        comp = compressor.compress(weight)\n        # Pin the complete CPU result once, then split exactly like serving.\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        hbm_offsets = comp.tile_exception_offsets.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.sign_mantissa = hbm_sm\n        native.tile_exception_offsets = hbm_offsets\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _cd3_ext.decompress_chunk_delta3(native, output)\n    else:\n        compressor = P4FlatCompressor(stream)\n        # CPU input selects the host palette/code encoder.  The native call\n        # only stages the completed representation to CUDA; to_host moves it\n        # into the same pinned LPDDR-side form used by frozen_split serving.\n        comp = compressor.compress(weight)\n        comp.to_host()\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        hbm_sm = comp.sign_mantissa.to(\"cuda\")\n        sources = [getattr(comp, attr) for attr in lpddr_attrs]\n        destinations = [torch.empty_like(src, device=\"cuda\") for src in sources]\n\n        native = _p4f_ext.CompressedP4Flat()\n        native.sign_mantissa = hbm_sm\n        for attr, dst in zip(lpddr_attrs, destinations):\n            setattr(native, attr, dst)\n        native.M = comp.M\n        native.K = comp.K\n        native.num_exceptions = comp.num_exceptions\n        native.num_groups = comp.num_groups\n        native.row_major_sm = False\n        output = torch.empty((comp.M, comp.K), dtype=torch.bfloat16,\n                             device=\"cuda\")\n\n        def decode():\n            _p4f_ext.decompress(native, output)\n\n    # cudaMemcpyBatchAsync through the same native helper used by P4Flat's\n    # weight staging.  It is dtype-agnostic and therefore gives both codecs\n    # the same one-dispatch multi-buffer H2D policy.\n    def h2d():\n        _p4f_ext.batch_h2d(sources, destinations)\n\n    def total():\n        h2d()\n        decode()\n\n    transfer_bytes = sum(t.nbytes for t in sources)\n    # Keep all buffers and native structs alive through the timed region.\n    keepalive = (comp, compressor, native, sources, destinations, hbm_sm)\n    if codec_name == \"chunk_delta3\":\n        keepalive += (hbm_offsets,)\n    return h2d, decode, total, transfer_bytes, output, keepalive\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"model\")\n    parser.add_argument(\"--layer\", type=int, default=40)\n    parser.add_argument(\"--group\", default=\"qkv,o,gateup,down\")\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n                        required=True)\n    parser.add_argument(\"--warmup\", type=int, default=10)\n    parser.add_argument(\"--iterations\", type=int, default=50)\n    args = parser.parse_args()\n\n    wanted = [x.strip() for x in args.group.split(\",\") if x.strip()]\n    unknown = [x for x in wanted if x not in _GROUP_DEFS]\n    if unknown:\n        raise ValueError(f\"unknown groups: {unknown}\")\n    shards = _resolve_inputs([args.model])\n    index = _build_layer_index(shards, args.layer)\n    if args.layer not in index:\n        raise ValueError(f\"layer {args.layer} not found\")\n    tensors = _load_layer(index[args.layer])\n    stream = torch.cuda.Stream()\n    rows = []\n    # Keep completed per-group GPU state alive until all groups finish.  The\n    # native P4 batch-copy call is asynchronous and its pybind struct owns the\n    # destination views; retaining them also avoids allocator reuse between\n    # back-to-back 100s-of-MiB projection measurements.\n    retained = []\n\n    print(f\"gpu={torch.cuda.get_device_name(0)} layer={args.layer} \"\n          f\"codec={args.codec} cpu_encode=true\")\n    for group in wanted:\n        roles = _GROUP_DEFS[group]\n        weight = (tensors[roles[0]] if len(roles) == 1 else\n                  torch.cat([tensors[r] for r in roles], dim=0))\n        weight = weight.contiguous()\n        h2d, decode, total, transfer_bytes, output, keepalive = _prepare(\n            weight, args.codec, stream)\n\n        # Populate staging before the resident-decode timing.\n        with torch.cuda.stream(stream):\n            h2d()\n            decode()\n        stream.synchronize()\n\n        h2d_samples = _measure(\n            stream, h2d, args.warmup, args.iterations)\n        decode_samples = _measure(\n            stream, decode, args.warmup, args.iterations)\n        total_samples = _measure(\n            stream, total, args.warmup, args.iterations)\n        with torch.cuda.stream(stream):\n            total()\n        stream.synchronize()\n        exact = torch.equal(\n            output.cpu().view(torch.uint16), weight.view(torch.uint16))\n\n        hm = statistics.median(h2d_samples)\n        dm = statistics.median(decode_samples)\n        tm = statistics.median(total_samples)\n        rows.append((group, hm, dm, tm, transfer_bytes))\n        print(\n            f\"group={group} shape={weight.shape[0]}x{weight.shape[1]} \"\n            f\"transfer_mib={transfer_bytes / 2**20:.3f} \"\n            f\"h2d_min_med_p95={min(h2d_samples):.4f}/{hm:.4f}/\"\n            f\"{_percentile(h2d_samples, .95):.4f} ms \"\n            f\"decode_min_med_p95={min(decode_samples):.4f}/{dm:.4f}/\"\n            f\"{_percentile(decode_samples, .95):.4f} ms \"\n            f\"total_min_med_p95={min(total_samples):.4f}/{tm:.4f}/\"\n            f\"{_percentile(total_samples, .95):.4f} ms bit_exact={exact}\")\n\n        retained.append((output, keepalive))\n        del h2d, decode, total, output, keepalive, weight\n        gc.collect()\n\n    print(\"sum_medians \"\n          f\"h2d={sum(x[1] for x in rows):.4f} \"\n          f\"decode={sum(x[2] for x in rows):.4f} \"\n          f\"total={sum(x[3] for x in rows):.4f} ms \"\n          f\"transfer_mib={sum(x[4] for x in rows) / 2**20:.3f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Measure production CPU-encoded KV H2D + GPU decode.\n\nEach invocation runs one codec and one block count so allocator and pinned\nbuffer history cannot leak between P4Flat and ChunkDelta3 measurements.\nNo GPU encoder is called by this benchmark.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport statistics\nimport sys\nimport time\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _ROOT not in sys.path:\n    sys.path.insert(0, _ROOT)\n\nimport torch\n\nfrom tiered_serve.chunk_delta3_kv_compressor import (\n    ChunkDelta3CPUKVCompressor,\n)\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n\nBLOCK_SHAPE = (16, 8, 128)\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\n\n\ndef load_blocks(path: str, count: int):\n    saved = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_name = \"k_post_blocks\" if \"k_post_blocks\" in saved else \"k_blocks\"\n    if len(saved[k_name]) < count or len(saved[\"v_blocks\"]) < count:\n        raise ValueError(f\"KV cache has fewer than {count} blocks\")\n    k = torch.stack(\n        [value.contiguous() for value in saved[k_name][:count]])\n    v = torch.stack(\n        [value.contiguous() for value in saved[\"v_blocks\"][:count]])\n    return (\n        k.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n        v.reshape(count, *BLOCK_SHAPE).contiguous().pin_memory(),\n    )\n\n\ndef percentile(values, fraction: float):\n    ordered = sorted(values)\n    return ordered[int(fraction * (len(ordered) - 1))]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--codec\", choices=(\"chunk_delta3\", \"p4flat\"),\n           