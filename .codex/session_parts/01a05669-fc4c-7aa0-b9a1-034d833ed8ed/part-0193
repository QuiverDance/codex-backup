     if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and CD3 shared-memory pressure.\n        # Hopper WGMMA supports standard 64x{16,32} shapes.  Preserve the\n        # existing 64-wide path at N>32, but avoid doing 2-4x excess activation\n        # work in the latency-critical small-token regime.\n        if N <= 16:\n            n_pad = 16\n        elif N <= 32:\n            n_pad = 32\n        elif N <= 48:\n            n_pad = 48\n        else:\n            n_pad = ((N + 63) // 64) * 64\n        # Split-K is tuned per TileN regime after the reduced-shared-memory\n        # kernels raised TileN64/128 residency to five/four CTAs.  Split-4 wins\n        # throughout N<=64; at N=128 only GateUp's large grid stays unsplit.\n        if n_pad <= 32:\n            # The smaller B tile and single exception map allow enough\n            # resident CTAs that split-4 wins for every production projection.\n            split_k = 4\n        elif n_pad <= 64:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 4,\n                (8192, 28672): 4,\n            }.get((M, K), _u4_split_k(M, n_pad, K))\n        elif n_pad == 128:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 1,\n                (8192, 28672): 4,\n            }.get((M, K), 1)\n        elif n_pad in (192, 256):\n            split_k = 4 if (M, K) == (10240, 8192) else 1\n        else:\n            split_k = 1\n        output = torch.empty(\n            n_pad, M, dtype=torch.bfloat16, device=device)\n        padded_input = torch.empty(\n            n_pad, K, dtype=torch.bfloat16, device=device)\n        partials = (\n            torch.empty(\n                split_k, n_pad, M, dtype=torch.float32, device=device)\n            if split_k > 1\n            else _empty_f32(device)\n        )\n        return {\n            \"key\": (M, K, N, device.index),\n            \"n_pad\": n_pad,\n            \"split_k\": split_k,\n            \"output\": output,\n            \"padded_input\": padded_input,\n            \"partials\": partials,\n        }\n\n    def alloc_fused_scratch(\n        self,\n        K: int,\n        M: int,\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        use_fused = (\n            M % 64 == 0\n            and K % 64 == 0\n            and 0 < N <= self._fused_max_n_for(M, K)\n            and x2.dtype == torch.bfloat16\n            and x2.is_cuda\n            and comp._c.codes.is_cuda\n        )\n        if not use_fused:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            weight = self.decompress(comp)\n            if we is not None:\n                we.record()\n            return F.linear(x2, weight).reshape(*original_shape[:-1], M)\n\n        key = (M, K, N, x2.device.index)\n        if scratch is None or scratch.get(\"key\") != key:\n            cache = self.__dict__.setdefault(\"_fused_scratch\", {})\n            scratch = cache.get(key)\n            if scratch is None:\n                scratch = self._allocate_fused_scratch(M, K, N, x2.device)\n                cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\"ChunkDelta3Compressor requires a CUDA tensor\")\n        if weight.shape[0] % 64 or weight.shape[1] % 64:\n            raise ValueError(\n                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n                f\"got {tuple(weight.shape)}\")\n\n        