se\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n            alignment = tensor.element_size()\n            offset = (offset + alignment - 1) // alignment * alignment\n            layout.append(\n                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n            offset += tensor.nbytes\n\n        if huge_page_allocator is not None:\n            try:\n                host_slab = huge_page_allocator.allocate(\n                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n            except (MemoryError, ValueError):\n                logger.warning(\n                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n                    \"pinned host memory\")\n                host_slab = torch.empty(offset, dtype=torch.uint8,\n                                        pin_memory=True)\n        else:\n            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n\n        host_views = []\n        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n            view.copy_(source)\n            setattr(self, attr, view)\n            host_views.append(view)\n        self._host_slab = host_slab\n        self._slab_layout = tuple(layout)\n        self._device_slab = None\n        self._h2d_views = None\n        self._h2d_sources = None\n        self._copy_slab = False\n        self._set_native_buffers(tuple(host_views))\n        return self\n\n    def to(self, device=\"cuda\", non_blocking: bool = True):\n        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n        if torch.device(device).type != \"cuda\":\n            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n        if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # The experimental benchmark force-opens the threshold.  Keep production\n    # routing disabled until a serving-level crossover has been calibrated.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 0,\n        (8192, 8192): 0,\n        (57344, 8192): 0,\n        (8192, 28672): 0,\n    }\n\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and CD3 shared-memory pressure.\n        # Hopper WGMMA supports standard 64x{16,32} shapes.  Preserve the\n        # existing 64-wide path at N>32, but avoid doing 2-4x excess activation\n        # work in the latency-critical small-token regime.\n        if N <= 16:\n            n_pad = 16\n        elif N <= 32:\n            n_pad = 32\n        elif N <= 48:\n            n_pad = 48\n        else:\n            n_pad = ((N + 63) // 64) * 64\n        # Split-K is tuned per TileN regime after the reduced-shared-memory\n        # kernels raised TileN64/128 residency to five/four CTAs.  Split-4 wins\n        # throughout N<=64; at N=128 only GateUp's large grid stays unsplit.\n        if n_pad <= 32:\n            # The smaller B tile and single exception map allow enough\n            # resident CTAs that split-4 wins for every production projection.\n            split_k = 4\n        elif n_pad <= 64:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 4,\n                (8192, 28672): 4,\n            }.get((M, K), _u4_split_k(M, n_pad, K))\n        elif n_pad == 128:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 4,\n                (57344, 8192): 1,\n                (8192, 28672): 4,\n            }.get((M, K), 1)\n        elif n_pad in (192, 256):\n            split_k = 4 if (M, K) == (10240, 8192) else 1\n        else:\n            split_k = 1\n        output = torch.empty(\n            n_pad, M, dtype=torch.bfloat16, device=device)\n        padded_input = torch.empty(\n            n_pad, K, dtype=torch.bfloat16, device=device)\n        partials = (\n            torch.empty(\n                split_k, n_pad, M, dtype=torch.float32, device=device)\n            if split_k > 1\n            else _empty_f32(device)\n        )\n        return {\n            \"key\": (M, K, N, device.index),\n            \"n_pad\": n_pad,\n            \"split_k\": split_k,\n            \"output\": output,\n            \"padded_input\": padded_input,\n            \"partials\": partials,\n        }\n\n    def alloc_fused_scratch(\n        self,\n        K: int,\n        M: int,\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n        M, K = int(comp.M), int(comp.K)\n        original_shape = x.shape\n        x2 = x.reshape(-1, K)\n        N = i