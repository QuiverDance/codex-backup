{"timestamp":"2026-08-31T06:15:22.621Z","ordinal":404,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05674-f3f7-7842-be68-e8f4c7b8f6bb","item":{"type":"CommandExecution","id":"exec-e13770a2-ca82-424b-81fd-404d9832797e","process_id":"36559","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,180p\" benchmarks/weight_compress.py && sed -n \"240,430p\" benchmarks/weight_compress.py && sed -n \"1,210p\" benchmarks/kv_codec.py && sed -n \"1,130p\" benchmarks/fuseGEMM.py && sed -n \"570,720p\" benchmarks/fuseGEMM.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,180p\" benchmarks/weight_compress.py && sed -n \"240,430p\" benchmarks/weight_compress.py && sed -n \"1,210p\" benchmarks/kv_codec.py && sed -n \"1,130p\" benchmarks/fuseGEMM.py && sed -n \"570,720p\" benchmarks/fuseGEMM.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n        c_best = min(c_best, time.perf_counter() - t0)\n    comp_bytes = int(comp.total_compressed_size)\n\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\n\n    def _decomp_into():\n        return comp_obj.decompress(comp, out)\n\n    def _decomp_alloc():\n        return comp_obj.decompress(comp)\n\n    try:\n        dec = _decomp_into()\n        decomp = _decomp_into\n    except Exception:\n        dec = _decomp_alloc()\n        decomp = _decomp_alloc\n    for _ in range(warmup - 1):\n        dec = decomp()\n    torch.cuda.synchronize()\n\n    d_best = float(\"inf\")\n    for _ in range(runs):\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        dec = decomp()\n        torch.cuda.synchronize()\n        d_best = min(d_best, time.perf_counter() - t0)\n\n    ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatting\n# ════════════════════════════════════════════════════════════════════\n\n# Tables are emitted single-space-separated with single-token headers (no\n# internal spaces, no alignment padding) so they paste straight into Excel\n# (Text-to-Columns -> space delimiter, or \"treat consecutive delimiters as one\").\n\ndef _print_table(rows):\n    if not rows:\n        print(\"(no results)\"); return\n    print(\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\")\n    for r in rows:\n        print(f\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \"\n              f\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \"\n              f\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\")\n\n\ndef _print_summary(all_rows):\n    print(\"\\nSUMMARY (averaged across all weights)\")\n    by_codec = defaultdict(list)\n    for r in all_rows:\n        by_codec[r.codec].append(r)\n    print(\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\")\n    import statistics as st\n    for codec, rs in by_codec.items():\n        n = len(rs)\n        n_ok = sum(1 for r in rs if r.ok)\n        print(f\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \"\n              f\"{st.mean(r.c_ms for r in rs):.3f} \"\n              f\"{st.mean(r.d_ms for r in rs):.3f} \"\n              f\"{st.mean(r.c_gbps for r in rs):.2f} \"\n              f\"{st.mean(r.d_gbps for r in rs):.2f} \"\n              f\"{n_ok}/{n}\")\n\n#!/usr/bin/env python3\n\"\"\"Direct production-codec benchmark on real cached K/V blocks.\n\nThe serving KV block layout [N, 16, 8, 128] is viewed as two dense\n[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\nrequired by P4Flat and ChunkDelta3 while exercising their normal compressor,\nhost-staging, and decompressor interfaces.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport time\n\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\n\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\nBLOCK_SHAPE = (16, 8, 128)\nROWS_PER_BLOCK = 128\nCOLS = 128\n\n\ndef _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\n    obj = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_key = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    if len(obj[k_key]) < n or len(obj[\"v_blocks\"]) < n:\n        raise ValueError(\n            f\"Requested {n} blocks, cache has K={len(obj[k_key])}, \"\n            f\"V={len(obj['v_blocks'])}\")\n    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\n    v = torch.stack([x.contiguous() for x in obj[\"v_blocks\"][:n]])\n    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\n\n\ndef _samples(fn, warmup: int, iterations: int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"bit-exact={resident_exact and staged_exact}\")\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--blocks\", default=\"1024,2048\")\n    parser.add_argument(\"--codec\", default=\"p4flat,chunk_delta3\")\n    parser.add_argument(\"--warmup\", type=int, default=5)\n    parser.add_argument(\"--iterations\", type=int, default=20)\n    parser.add_argument(\"--single-process\", action=\"store_true\",\n                        help=argparse.SUPPRESS)\n    args = parser.parse_args()\n    block_counts = [int(value) for value in args.blocks.split(\",\")]\n    codec_names = [value.strip() for value in args.codec.split(\",\")]\n    if len(block_counts) > 1 and not args.single_process:\n        # P4Flat's pinned multi-buffer batch_h2d path is not safely reusable\n        # after changing the matrix size in one process on GH200.  Isolating\n        # sweep points also prevents allocator history from biasing timings.\n        for n in block_counts:\n            subprocess.run([\n                sys.executable, os.path.abspath(__file__),\n                \"--path\", args.path,\n                \"--blocks\", str(n),\n                \"--codec\", args.codec,\n                \"--warmup\", str(args.warmup),\n                \"--iterations\", str(args.iterations),\n                \"--single-process\",\n            ], check=True)\n        return\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n        host_k, host_v = _load(args.path, n)\n        print(f\"\\nKV blocks={n}, matrix=[{n * ROWS_PER_BLOCK}, {COLS}] x K/V\")\n        for name in codec_names:\n            _bench(name, host_k, host_v, args.warmup, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Unified codec decision benchmark for the tiered-serving weight path.\n\nFor each compressor codec (zipserv / p4flat / ublb_flat / chunk_delta3) and each Llama-3.1-70B\nprojection (qkv, o, gate_up, down) this measures the data needed to calibrate\nthe serving strategy, per token count N, between three choices:\n\n  1. fused             — decompress + GEMM in one kernel (no dense HBM write)\n  2. decomp-then-GEMM  — decompress to a dense bf16 weight, then cuBLAS\n  3. raw bf16 load     — skip compression, GEMM the dense bf16 weight directly\n                         (the compute floor; its load cost = raw_bytes / BW is\n                         estimated from the reported ratio)\n\nReported per (codec, proj):\n  * compress time, decompress time, compression ratio + compressed bytes\nReported per (codec, layer, proj, N), under TWO conditions — isolated and with a\nconcurrent H2D memcpy running (mimicking the next layer's weight offload):\n  * raw GEMM, decomp+GEMM, fused latency P50/P95\n\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\nfused has no dense write and is contention-immune. An isolated sweep therefore\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\n\nTo characterise the fused KERNEL at every N (so production thresholds can be\ncalibrated), the per-codec production N-thresholds are forced wide open.\n\nUsage:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\n  ... --synthetic --check --n-values 1,64,256\n  ... --csv codec_decision.csv\n  ... --codecs zipserv,p4flat --projs o,gate_up\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\n\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\nlink, adding two iso/h2d column groups:\n\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\n                the SMs, no dense-weight HBM staging at all.\n\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\nalike.  See\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\n\"\"\"\n\nimport argparse\nimport ctypes\nimport glob\nimport logging\nimport os\nimport re\nimport sys\n\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom benchmarks.fused_bench_common import (\n    H2DContender,\n    LatencyStats,\n    add_timing,\n    bench_cuda,\n    runtime_metadata,\n    sha256_file,\n    sha256_tensor,\n    write_csv,\n)\n\n# Silence per-compress codec INFO spam (logged once per timed iteration).\nlogging.getLogger(\"tiered_serve\").setLevel(logging.WARNING)\n\n\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\nHIDDEN_SIZE = 8192\nNUM_Q_HEADS = 64\nNUM_KV_HEADS = 8\nHEAD_DIM = 128\nINTERMEDIATE_SIZE = 28672\nN_LAYERS = 80\n\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\n\n\ndef proj_shapes(tp):\n    \"\"\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\n\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\n    shard the contraction dim.\n    \"\"\"\n    return {\n        \"qkv\":     (QKV_OUT // tp,    HIDDEN_SIZE),\n        \"o\":       (HIDDEN_SIZE,      Q_DIM // tp),\n        \"gate_up\": (GATEUP_OUT // tp, HIDDEN_SIZE),\n        \"down\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\n    }\n\n\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\n_l2_flush_buf = None\n\n\ndef flush_l2_cache():\n    global _l2_flush_buf\n    if _l2_flush_buf is None:\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\n                                    device=\"cuda\")\n    _l2_flush_buf.zero_()\n\n\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\n    \"\"\"P50/P95 per-iteration GPU time in an isolated stream.\"\"\"\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n    )\n\n    measurement.  Zero-size / non-CUDA buffers (e.g. an empty exception list)\n    are left untouched — the kernel never reads them.\n    \"\"\"\n    target_fn, _mant_attr, exp_attrs = _ATS_PLAN[codec_name]\n    target = target_fn(comp)\n    hbm, ats = {}, {}\n    for a in exp_attrs:\n        t = getattr(target, a, None)\n        hbm[a] = t\n        if not torch.is_tensor(t) or t.numel() == 0 or not t.is_cuda:\n            ats[a] = t  # nothing to relocate; not on the read path\n        else:\n            ats[a] = pool.to_ats(t)\n    torch.cuda.synchronize()  # ensure every D2H into LPDDR has landed\n    return target, exp_attrs, hbm, ats\n\n\n# ── CLI ──────────────────────────────────────────────────────────────────────\ndef parse_args():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--codecs\", default=\"zipserv,p4flat\")\n    ap.add_argument(\"--projs\", default=\"qkv,o,gate_up,down\")\n    ap.add_argument(\"--n-values\",\n                    default=\"1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,160,192,256,512,1024\")\n    ap.add_argument(\"--tp\", type=int, default=1,\n                    help=\"tensor-parallel degree (shards shapes; needs --synthetic for tp>1)\")\n    ap.add_argument(\"--synthetic\", action=\"store_true\",\n                    help=\"random bf16 weights instead of the real checkpoint\")\n    ap.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    ap.add_argument(\"--shards\", type=int, default=6,\n                    help=\"max safetensor shards to scan for real weights\")\n    ap.add_argument(\"--layers\", default=\"0,40\",\n                    help=\"comma-separated real checkpoint layers; official \"\n                         \"scaling run uses the outlier-heavy 0 and representative 40\")\n    ap.add_argument(\"--layer\", type=int, default=None,\n                    help=\"legacy single-layer override for --layers\")\n    ap.add_argument(\"--repeat-id\", type=int, default=0,\n                    help=\"independent-process repeat recorded in every CSV row\")\n    ap.add_argument(\"--seed\", type=int, default=2025010215,\n                    help=\"base seed for reproducible BF16 activations\")\n    ap.add_argument(\"--warmup\", type=int, default=5)\n    ap.add_argument(\"--iters\", type=int, default=50)\n    ap.add_argument(\"--no-flush\", action=\"store_true\",\n                    help=\"disable L2 flush between iters\")\n    ap.add_argument(\"--no-h2d\", action=\"store_true\",\n                    help=\"skip the concurrent-H2D contention condition\")\n    ap.add_argument(\"--h2d-bytes\", type=int, default=0,\n                    help=\"H2D contention traffic per copy (0 = codec compressed size)\")\n    ap.add_argument(\"--check\", action=\"store_true\",\n                    help=\"print per-row fused OK/INVALID marker (validity gate \"\n                         \"is always on unless --no-validate)\")\n    ap.add_argument(\"--no-validate\", action=\"store_true\",\n                    help=\"skip the fused bit-exactness gate (trust fused timings)\")\n    ap.add_argument(\"--full-model\", action=\"store_true\",\n                    help=\"print per-layer / full-model strategy totals\")\n    ap.add_argument(\"--ats\", action=\"store_true\",\n                    help=\"also measure the fused GEMM with the compressed \"\n                         \"exponent in Grace LPDDR (mantissa in HBM), read by \"\n                         \"the SMs over NVLink-C2C/ATS (no HBM staging). GH200 \"\n                         \"only. Adds 'fusedATS' columns.\")\n    ap.add_argument(\"--ats-pool-gib\", type=float, default=2.0,\n                    help=\"LPDDR ATS pool size per projection (GiB)\")\n    ap.add_argument(\"--ats-hugepage-dir\", default=\"/mnt/hugepages\",\n                    help=\"hugetlbfs mount for the ATS pool; falls back to \"\n                         \"numa_alloc_onnode if no free hugepages\")\n    ap.add_argument(\"--ats-lpddr-node\", type=int, default=0,\n                    help=\"NUMA node for the LPDDR fallback (Grace = 0 on GH200)\")\n    ap.add_argument(\"--csv\", required=True,\n                    help=\"output CSV; required so official cells cannot be lost\")\n    return ap.parse_args()\n\n\ndef fmt(v):\n    return \"    n/a\" if v is None else f\"{v:8.3f}\"\n\n\ndef main():\n    args = parse_args()\n    if not torch.cuda.is_available():\n        sys.exit(\"CUDA required.\")\n    if args.tp > 1 and not args.synthetic:\n        sys.exit(\"--tp>1 requires --synthetic (real weights are stored tp=1).\")\n\n    codecs = [c.strip() for c in args.codecs.split(\",\") if c.strip()]\n    projs = [p.strip() for p in args.projs.split(\",\") if p.strip()]\n    n_values = [int(x) for x in args.n_values.split(\",\")]\n    valid_codecs = {\"zipserv\", \"p4flat\", \"ublb_flat\", \"chunk_delta3\"}\n    if not codecs or any(codec not in valid_codecs\n                         for codec in codecs):\n        raise ValueError(\n            f\"--codecs must be a subset of {sorted(valid_codecs)}: {codecs}\")\n    if len(set(codecs)) != len(codecs):\n        raise ValueError(f\"duplicate codecs are not allowed: {codecs}\")\n    valid_projs = {\"qkv\", \"o\", \"gate_up\", \"down\"}\n    if not projs or any(proj not in valid_projs for proj in projs):\n        raise ValueError(f\"invalid --projs: {projs}\")\n    if len(set(projs)) != len(projs):\n        raise ValueError(f\"duplicate projections are not allowed: {projs}\")\n    if not n_values or any(value <= 0 for value in n_values):\n        raise ValueError(f\"N values must be positive: {n_values}\")\n    if len(set(n_values)) != len(n_values):\n        raise ValueError(f\"duplicate N values are not allowed: {n_values}\")\n    layers = ([args.layer] if args.layer is not None else\n              [int(x) for x in args.layers.split(\",\") if x.strip()])\n    if not layers:\n        raise ValueError(\"--layers must contain at least one layer\")\n    if any(layer < 0 or layer >= N_LAYERS for layer in layers):\n        raise ValueError(f\"layers must be in [0,{N_LAYERS - 1}], got {layers}\")\n    if len(set(layers)) != len(layers):\n        raise ValueError(f\"duplicate layers are not allowed: {layers}\")\n    shapes = proj_shapes(args.tp)\n    shapes = {p: shapes[p] for p in projs}\n\n    # ── obtain weights (CPU bf16) ──\n    if args.synthetic:\n        weights_by_layer = {\n            -1: {p: make_synthetic(*shapes[p], seed=1000 + i).cpu()\n                 for i, p in enumerate(projs)}\n        }\n        src = \"synthetic random bf16\"\n    else:\n        weights_by_layer = {\n            layer: load_real_projections(\n                args.weights_dir, shapes, args.shards, layer=layer)\n            for layer in layers\n        }\n        src = (\"real Llama-3.1-70B-Instruct layers=\" +\n               \",\".join(str(layer) for layer in layers))\n\n    weight_hashes = {\n        (layer, proj): sha256_tensor(weight)\n        for layer, weights in weights_by_layer.items()\n        for proj, weight in weights.items()\n    }\n    checkpoint_index = os.path.join(\n        args.weights_dir, \"model.safetensors.index.json\")\n    checkpoint_index_sha256 = (\n        sha256_file(checkpoint_index) if os.path.isfile(checkpoint_index) else \"\")\n    common_meta = runtime_metadata(_REPO_ROOT)\n    common_meta.update({\n        \"benchmark\": \"fused_gemm_scaling\",\n        \"benchmark_script_sha256\": sha256_file(__file__),\n        \"benchmark_helper_sha256\": sha256_file(\n            os.path.join(_REPO_ROOT, \"benchmarks\", \"fused_bench_common.py\")),\n        \"repeat_id\": args.repeat_id,\n        \"weight_source\": os.path.abspath(args.weights_dir),\n        \"checkpoint_index_path\": (\n            os.path.abspath(checkpoint_index) if os.path.isfile(checkpoint_index)\n            else \"\"),\n        \"checkpoint_index_sha256\": checkpoint_index_sha256,\n","stderr":"","aggregated_output":"\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n        c_best = min(c_best, time.perf_counter() - t0)\n    comp_bytes = int(comp.total_compressed_size)\n\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\n\n    def _decomp_into():\n        return comp_obj.decompress(comp, out)\n\n    def _decomp_alloc():\n        return comp_obj.decompress(comp)\n\n    try:\n        dec = _decomp_into()\n        decomp = _decomp_into\n    except Exception:\n        dec = _decomp_alloc()\n        decomp = _decomp_alloc\n    for _ in range(warmup - 1):\n        dec = decomp()\n    torch.cuda.synchronize()\n\n    d_best = float(\"inf\")\n    for _ in range(runs):\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        dec = decomp()\n        torch.cuda.synchronize()\n        d_best = min(d_best, time.perf_counter() - t0)\n\n    ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatting\n# ════════════════════════════════════════════════════════════════════\n\n# Tables are emitted single-space-separated with single-token headers (no\n# internal spaces, no alignment padding) so they paste straight into Excel\n# (Text-to-Columns -> space delimiter, or \"treat consecutive delimiters as one\").\n\ndef _print_table(rows):\n    if not rows:\n        print(\"(no results)\"); return\n    print(\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\")\n    for r in rows:\n        print(f\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \"\n              f\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \"\n              f\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\")\n\n\ndef _print_summary(all_rows):\n    print(\"\\nSUMMARY (averaged across all weights)\")\n    by_codec = defaultdict(list)\n    for r in all_rows:\n        by_codec[r.codec].append(r)\n    print(\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\")\n    import statistics as st\n    for codec, rs in by_codec.items():\n        n = len(rs)\n        n_ok = sum(1 for r in rs if r.ok)\n        print(f\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \"\n              f\"{st.mean(r.c_ms for r in rs):.3f} \"\n              f\"{st.mean(r.d_ms for r in rs):.3f} \"\n              f\"{st.mean(r.c_gbps for r in rs):.2f} \"\n              f\"{st.mean(r.d_gbps for r in rs):.2f} \"\n              f\"{n_ok}/{n}\")\n\n#!/usr/bin/env python3\n\"\"\"Direct production-codec benchmark on real cached K/V blocks.\n\nThe serving KV block layout [N, 16, 8, 128] is viewed as two dense\n[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\nrequired by P4Flat and ChunkDelta3 while exercising their normal compressor,\nhost-staging, and decompressor interfaces.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport time\n\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\n\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\nBLOCK_SHAPE = (16, 8, 128)\nROWS_PER_BLOCK = 128\nCOLS = 128\n\n\ndef _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\n    obj = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_key = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    if len(obj[k_key]) < n or len(obj[\"v_blocks\"]) < n:\n        raise ValueError(\n            f\"Requested {n} blocks, cache has K={len(obj[k_key])}, \"\n            f\"V={len(obj['v_blocks'])}\")\n    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\n    v = torch.stack([x.contiguous() for x in obj[\"v_blocks\"][:n]])\n    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\n\n\ndef _samples(fn, warmup: int, iterations: int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"bit-exact={resident_exact and staged_exact}\")\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--blocks\", default=\"1024,2048\")\n    parser.add_argument(\"--codec\", default=\"p4flat,chunk_delta3\")\n    parser.add_argument(\"--warmup\", type=int, default=5)\n    parser.add_argument(\"--iterations\", type=int, default=20)\n    parser.add_argument(\"--single-process\", action=\"store_true\",\n                        help=argparse.SUPPRESS)\n    args = parser.parse_args()\n    block_counts = [int(value) for value in args.blocks.split(\",\")]\n    codec_names = [value.strip() for value in args.codec.split(\",\")]\n    if len(block_counts) > 1 and not args.single_process:\n        # P4Flat's pinned multi-buffer batch_h2d path is not safely reusable\n        # after changing the matrix size in one process on GH200.  Isolating\n        # sweep points also prevents allocator history from biasing timings.\n        for n in block_counts:\n            subprocess.run([\n                sys.executable, os.path.abspath(__file__),\n                \"--path\", args.path,\n                \"--blocks\", str(n),\n                \"--codec\", args.codec,\n                \"--warmup\", str(args.warmup),\n                \"--iterations\", str(args.iterations),\n                \"--single-process\",\n            ], check=True)\n        return\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n        host_k, host_v = _load(args.path, n)\n        print(f\"\\nKV blocks={n}, matrix=[{n * ROWS_PER_BLOCK}, {COLS}] x K/V\")\n        for name in codec_names:\n            _bench(name, host_k, host_v, args.warmup, args.iterations)\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Unified codec decision benchmark for the tiered-serving weight path.\n\nFor each compressor codec (zipserv / p4flat / ublb_flat / chunk_delta3) and each Llama-3.1-70B\nprojection (qkv, o, gate_up, down) this measures the data needed to calibrate\nthe serving strategy, per token count N, between three choices:\n\n  1. fused             — decompress + GEMM in one kernel (no dense HBM write)\n  2. decomp-then-GEMM  — decompress to a dense bf16 weight, then cuBLAS\n  3. raw bf16 load     — skip compression, GEMM the dense bf16 weight directly\n                         (the compute floor; its load cost = raw_bytes / BW is\n                         estimated from the reported ratio)\n\nReported per (codec, proj):\n  * compress time, decompress time, compression ratio + compressed bytes\nReported per (codec, layer, proj, N), under TWO conditions — isolated and with a\nconcurrent H2D memcpy running (mimicking the next layer's weight offload):\n  * raw GEMM, decomp+GEMM, fused latency P50/P95\n\nWhy the concurrent-H2D condition: decomp-then-GEMM writes the full dense weight\nto HBM, which contends with the weight-offload H2D copy + HBM write bandwidth;\nfused has no dense write and is contention-immune. An isolated sweep therefore\nwrongly favours decomp for O/GateUp/Down — the in-engine flip the codec\nthreshold tables (P4FlatCompressor._FUSED_MAX_N_TABLE etc.) already encode.\n\nTo characterise the fused KERNEL at every N (so production thresholds can be\ncalibrated), the per-codec production N-thresholds are forced wide open.\n\nUsage:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmark_codec_decision.py\n  ... --synthetic --check --n-values 1,64,256\n  ... --csv codec_decision.csv\n  ... --codecs zipserv,p4flat --projs o,gate_up\n  ... --ats --codecs p4flat --projs gate_up   # GH200: exp->LPDDR/C2C, mant->HBM\n\nWith ``--ats`` (GH200 only) the codec's compressed-exponent stream is relocated\nto Grace LPDDR (the raw sign|mantissa byte stream stays in HBM) and BOTH\ncompressed strategies are re-measured reading that exponent over the NVLink-C2C\nlink, adding two iso/h2d column groups:\n\n  * decmpATS  — decompress (exponent from LPDDR/C2C, mantissa from HBM) into a\n                dense bf16 weight in HBM, then cuBLAS GEMM (still an HBM write).\n  * fusedATS  — fused decode+GEMM; the exponent streams from LPDDR straight into\n                the SMs, no dense-weight HBM staging at all.\n\nThis gives the direct HBM-vs-C2C comparison for the decomp+GEMM and fused paths\nalike.  See\n``ats-benchmarks/benchmarks/compress/python/bf16_split_decompress_ats.py``.\n\"\"\"\n\nimport argparse\nimport ctypes\nimport glob\nimport logging\nimport os\nimport re\nimport sys\n\n# Allow running as `python benchmarks/fuseGEMM.py ...` from the repo root (or\n# anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\nfrom benchmarks.fused_bench_common import (\n    H2DContender,\n    LatencyStats,\n    add_timing,\n    bench_cuda,\n    runtime_metadata,\n    sha256_file,\n    sha256_tensor,\n    write_csv,\n)\n\n# Silence per-compress codec INFO spam (logged once per timed iteration).\nlogging.getLogger(\"tiered_serve\").setLevel(logging.WARNING)\n\n\n# ── Llama-3.1-70B-Instruct projection shapes (M=out, K=in) ───────────────────\nHIDDEN_SIZE = 8192\nNUM_Q_HEADS = 64\nNUM_KV_HEADS = 8\nHEAD_DIM = 128\nINTERMEDIATE_SIZE = 28672\nN_LAYERS = 80\n\nQ_DIM = NUM_Q_HEADS * HEAD_DIM          # 8192\nKV_DIM = NUM_KV_HEADS * HEAD_DIM        # 1024\nQKV_OUT = Q_DIM + 2 * KV_DIM            # 10240\nGATEUP_OUT = 2 * INTERMEDIATE_SIZE      # 57344\n\n\ndef proj_shapes(tp):\n    \"\"\"Return {proj: (M, K)} for one decode layer under tensor-parallelism tp.\n\n    Column-parallel (qkv, gate_up) shard the output dim; row-parallel (o, down)\n    shard the contraction dim.\n    \"\"\"\n    return {\n        \"qkv\":     (QKV_OUT // tp,    HIDDEN_SIZE),\n        \"o\":       (HIDDEN_SIZE,      Q_DIM // tp),\n        \"gate_up\": (GATEUP_OUT // tp, HIDDEN_SIZE),\n        \"down\":    (HIDDEN_SIZE,      INTERMEDIATE_SIZE // tp),\n    }\n\n\n# ── Timing helpers (mirror benchmark_decode_gemm.py conventions) ─────────────\n_L2_FLUSH_SIZE = 128 * 1024 * 1024  # bytes; > GH200 L2 to guarantee a flush\n_l2_flush_buf = None\n\n\ndef flush_l2_cache():\n    global _l2_flush_buf\n    if _l2_flush_buf is None:\n        _l2_flush_buf = torch.empty(_L2_FLUSH_SIZE // 4, dtype=torch.float32,\n                                    device=\"cuda\")\n    _l2_flush_buf.zero_()\n\n\ndef bench_gpu_stats(fn, warmup, iters, flush) -> LatencyStats:\n    \"\"\"P50/P95 per-iteration GPU time in an isolated stream.\"\"\"\n    return bench_cuda(\n        fn, warmup, iters,\n        flush_fn=flush_l2_cache if flush else None,\n    )\n\n    measurement.  Zero-size / non-CUDA buffers (e.g. an empty exception list)\n    are left untouched — the kernel never reads them.\n    \"\"\"\n    target_fn, _mant_attr, exp_attrs = _ATS_PLAN[codec_name]\n    target = target_fn(comp)\n    hbm, ats = {}, {}\n    for a in exp_attrs:\n        t = getattr(target, a, None)\n        hbm[a] = t\n        if not torch.is_tensor(t) or t.numel() == 0 or not t.is_cuda:\n            ats[a] = t  # nothing to relocate; not on the read path\n        else:\n            ats[a] = pool.to_ats(t)\n    torch.cuda.synchronize()  # ensure every D2H into LPDDR has landed\n    return target, exp_attrs, hbm, ats\n\n\n# ── CLI ──────────────────────────────────────────────────────────────────────\ndef parse_args():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--codecs\", default=\"zipserv,p4flat\")\n    ap.add_argument(\"--projs\", default=\"qkv,o,gate_up,down\")\n    ap.add_argument(\"--n-values\",\n                    default=\"1,2,4,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,160,192,256,512,1024\")\n    ap.add_argument(\"--tp\", type=int, default=1,\n                    help=\"tensor-parallel degree (shards shapes; needs --synthetic for tp>1)\")\n    ap.add_argument(\"--synthetic\", action=\"store_true\",\n                    help=\"random bf16 weights instead of the real checkpoint\")\n    ap.add_argument(\"--weights-dir\", default=DEFAULT_WEIGHTS_DIR)\n    ap.add_argument(\"--shards\", type=int, default=6,\n                    help=\"max safetensor shards to scan for real weights\")\n    ap.add_argument(\"--layers\", default=\"0,40\",\n                    help=\"comma-separated real checkpoint layers; official \"\n                         \"scaling run uses the outlier-heavy 0 and representative 40\")\n    ap.add_argument(\"--layer\", type=int, default=None,\n                    help=\"legacy single-layer override for --layers\")\n    ap.add_argument(\"--repeat-id\", type=int, default=0,\n                    help=\"independent-process repeat recorded in every CSV row\")\n    ap.add_argument(\"--seed\", type=int, default=2025010215,\n                    help=\"base seed for reproducible BF16 activations\")\n    ap.add_argument(\"--warmup\", type=int, default=5)\n    ap.add_argument(\"--iters\", type=int, default=50)\n    ap.add_argument(\"--no-flush\", action=\"store_true\",\n                    help=\"disable L2 flush between iters\")\n    ap.add_argument(\"--no-h2d\", action=\"store_true\",\n                    help=\"skip the concurrent-H2D contention condition\")\n    ap.add_argument(\"--h2d-bytes\", type=int, default=0,\n                    help=\"H2D contention traffic per copy (0 = codec compressed size)\")\n    ap.add_argument(\"--check\", action=\"store_true\",\n                    help=\"print per-row fused OK/INVALID marker (validity gate \"\n                         \"is always on unless --no-validate)\")\n    ap.add_argument(\"--no-validate\", action=\"store_true\",\n                    help=\"skip the fused bit-exactness gate (trust fused timings)\")\n    ap.add_argument(\"--full-model\", action=\"store_true\",\n                    help=\"print per-layer / full-model strategy totals\")\n    ap.add_argument(\"--ats\", action=\"store_true\",\n                    help=\"also measure the fused GEMM with the compressed \"\n                         \"exponent in Grace LPDDR (mantissa in HBM), read by \"\n                         \"the SMs over NVLink-C2C/ATS (no HBM staging). GH200 \"\n                         \"only. Adds 'fusedATS' columns.\")\n    ap.add_argument(\"--ats-pool-gib\", type=float, default=2.0,\n                    help=\"LPDDR ATS pool size per projection (GiB)\")\n    ap.add_argument(\"--ats-hugepage-dir\", default=\"/mnt/hugepages\",\n                    help=\"hugetlbfs mount for the ATS pool; falls back to \"\n                         \"numa_alloc_onnode if no free hugepages\")\n    ap.add_argument(\"--ats-lpddr-node\", type=int, default=0,\n                    help=\"NUMA node for the LPDDR fallback (Grace = 0 on GH200)\")\n    ap.add_argument(\"--csv\", required=True,\n                    help=\"output CSV; required so official cells cannot be lost\")\n    return ap.parse_args()\n\n\ndef fmt(v):\n    return \"    n/a\" if v is None else f\"{v:8.3f}\"\n\n\ndef main():\n    args = parse_args()\n    if not torch.cuda.is_available():\n        sys.exit(\"CUDA required.\")\n    if args.tp > 1 and not args.synthetic:\n        sys.exit(\"--tp>1 requires --synthetic (real weights are stored tp=1).\")\n\n    codecs = [c.strip() for c in args.codecs.split(\",\") if c.strip()]\n    projs = [p.strip() for p in args.projs.split(\",\") if p.strip()]\n    n_values = [int(x) for x in args.n_values.split(\",\")]\n    valid_codecs = {\"zipserv\", \"p4flat\", \"ublb_flat\", \"chunk_delta3\"}\n    if not codecs or any(codec not in valid_codecs\n                         for codec in codecs):\n        raise ValueError(\n            f\"--codecs must be a subset of {sorted(valid_codecs)}: {codecs}\")\n    if len(set(codecs)) != len(codecs):\n        raise ValueError(f\"duplicate codecs are not allowed: {codecs}\")\n    valid_projs = {\"qkv\", \"o\", \"gate_up\", \"down\"}\n    if not projs or any(proj not in valid_projs for proj in projs):\n        raise ValueError(f\"invalid --projs: {projs}\")\n    if len(set(projs)) != len(projs):\n        raise ValueError(f\"duplicate projections are not allowed: {projs}\")\n    if not n_values or any(value <= 0 for value in n_values):\n        raise ValueError(f\"N values must be positive: {n_values}\")\n    if len(set(n_values)) != len(n_values):\n        raise ValueError(f\"duplicate N values are not allowed: {n_values}\")\n    layers = ([args.layer] if args.layer is not None else\n              [int(x) for x in args.layers.split(\",\") if x.strip()])\n    if not layers:\n        raise ValueError(\"--layers must contain at least one layer\")\n    if any(layer < 0 or layer >= N_LAYERS for layer in layers):\n        raise ValueError(f\"layers must be in [0,{N_LAYERS - 1}], got {layers}\")\n    if len(set(layers)) != len(layers):\n        raise ValueError(f\"duplicate layers are not allowed: {layers}\")\n    shapes = proj_shapes(args.tp)\n    shapes = {p: shapes[p] for p in projs}\n\n    # ── obtain weights (CPU bf16) ──\n    if args.synthetic:\n        weights_by_layer = {\n            -1: {p: make_synthetic(*shapes[p], seed=1000 + i).cpu()\n                 for i, p in enumerate(projs)}\n        }\n        src = \"synthetic random bf16\"\n    else:\n        weights_by_layer = {\n            layer: load_real_projections(\n                args.weights_dir, shapes, args.shards, layer=layer)\n            for layer in layers\n        }\n        src = (\"real Llama-3.1-70B-Instruct layers=\" +\n               \",\".join(str(layer) for layer in layers))\n\n    weight_hashes = {\n        (layer, proj): sha256_tensor(weight)\n        for layer, weights in weights_by_layer.items()\n        for proj, weight in weights.items()\n    }\n    checkpoint_index = os.path.join(\n        args.weights_dir, \"model.safetensors.index.json\")\n    checkpoint_index_sha256 = (\n        sha256_file(checkpoint_index) if os.path.isfile(checkpoint_index) else \"\")\n    common_meta = runtime_metadata(_REPO_ROOT)\n    common_meta.update({\n        \"benchmark\": \"fused_gemm_scaling\",\n        \"benchmark_script_sha256\": sha256_file(__file__),\n        \"benchmark_helper_sha256\": sha256_file(\n            os.path.join(_REPO_ROOT, \"benchmarks\", \"fused_bench_common.py\")),\n        \"repeat_id\": args.repeat_id,\n        \"weight_source\": os.path.abspath(args.weights_dir),\n        \"checkpoint_index_path\": (\n            os.path.abspath(checkpoint_index) if os.path.isfile(checkpoint_index)\n            else \"\"),\n        \"checkpoint_index_sha256\": checkpoint_index_sha256,\n","exit_code":0,"duration":{"secs":0,"nanos":3360},"formatted_output":"\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n        c_best = min(c_best, time.perf_counter() - t0)\n    comp_bytes = int(comp.total_compressed_size)\n\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\n\n    def _decomp_into():\n        return comp_obj.decompress(comp, out)\n\n    def _decomp_alloc():\n        return comp_obj.decompress(comp)\n\n    try:\n        dec = _decomp_into()\n        decomp = _decomp_into\n    except Exception:\n        dec = _decomp_alloc()\n        decomp = _decomp_alloc\n    for _ in range(warmup - 1):\n        dec = decomp()\n    torch.cuda.synchronize()\n\n    d_best = float(\"inf\")\n    for _ in range(runs):\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        dec = decomp()\n        torch.cuda.synchronize()\n        d_best = min(d_best, time.perf_counter() - t0)\n\n    ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatting\n# ════════════════════════════════════════════════════════════════════\n\n# Tables are emitted single-space-separated with single-token headers (no\n# internal spaces, no alignment padding) so they paste straight into Excel\n# (Text-to-Columns -> space delimiter, or \"treat consecutive delimiters as one\").\n\ndef _print_table(rows):\n    if not rows:\n        print(\"(no results)\"); return\n    print(\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\")\n    for r in rows:\n        print(f\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \"\n              f\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \"\n              f\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\")\n\n\ndef _print_summary(all_rows):\n    print(\"\\nSUMMARY (averaged across all weights)\")\n    by_codec = defaultdict(list)\n    for r in all_rows:\n        by_codec[r.codec].append(r)\n    print(\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\")\n    import statistics as st\n    for codec, rs in by_codec.items():\n        n = len(rs)\n        n_ok = sum(1 for r in rs if r.ok)\n        print(f\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \"\n              f\"{st.mea