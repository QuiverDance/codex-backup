uint8_t>(\n                            smem.s_bases[st][owner] + code);\n                        const bool is_exception =\n                            (lane_exception_mask >> i) & 1u;\n                        if (is_exception)\n                            exp = smem.s_exc_exp[exc_st][pos];\n                        const uint8_t smv = smem.s_sm[st][owner * 16 + item];\n                        const uint16_t bits = static_cast<uint16_t>(\n                            (static_cast<uint16_t>(smv & 0x80u) << 8) |\n                            (static_cast<uint16_t>(exp) << 7) |\n                            static_cast<uint16_t>(smv & 0x7fu));\n                        const __nv_bfloat16 value = __ushort_as_bfloat16(bits);\n                        tCrA(i) = reinterpret_cast<const bfloat16_t&>(value);\n                    }\n    const __nv_bfloat16* B, __nv_bfloat16* C, float* Cf32, int split_k,\n    int M, int N, int K)\n{\n#if defined(CUTLASS_ARCH_MMA_SM90_SUPPORTED)\n    using namespace cute;\n    if ((M & 63) || (K & 63) || (N & 15)) return cudaErrorNotSupported;\n    cudaError_t err;\n    if (N % 256 == 0) {\n        using MMA = SM90_64x256x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<256, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 192 == 0) {\n        using MMA = SM90_64x192x16_F32BF16BF16_RS<GMMA::Major::K, GMMA::Major::K>;\n        err = LaunchCD3RS<192, MMA, 4>(stream, codes, sm, bases, tile_offsets,\n            entries20x3, B, C, Cf32, split_k, M, N, K);\n        if (err == cudaSuccess) return err;\n        if (err != cudaErrorNotSupported && err != cudaErrorLaunchOutOfResources) return err;\n        (void)cudaGetLastError();\n    }\n    if (N % 128 == 0) {\n        using MMA = 