n\\n\\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\\n    \\\"\\\"\\\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\\n\\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\\n    portable way to time them across every codec).\\n    \\\"\\\"\\\"\\n    M, K = w_gpu.shape\\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\\n\\n    # --- compress: warm up, then time, holding the last handle ---\\n    comp = None\\n    for _ in range(warmup):\\n        comp = comp_obj.compress(w_gpu)\\n    torch.cuda.synchronize()\\n    c_best = float(\\\"inf\\\")\\n    for _ in range(runs):\\n        del comp\\n        torch.cuda.synchronize(); t0 = time.perf_counter()\\n        comp = comp_obj.compress(w_gpu)\\n        torch.cuda.synchronize()\\n        c_best = min(c_best, time.perf_counter() - t0)\\n    comp_bytes = int(comp.total_compressed_size)\\n\\n    # --- decompress: prefer writing into a preallocated buffer; fall back ---\\n    out = torch.empty((M, K), dtype=w_gpu.dtype, device=w_gpu.device)\\n\\n    def _decomp_into():\\n        return comp_obj.decompress(comp, out)\\n\\n    def _decomp_alloc():\\n        return comp_obj.decompress(comp)\\n\\n    try:\\n        dec = _decomp_into()\\n        decomp = _decomp_into\\n    except Exception:\\n        dec = _decomp_alloc()\\n        decomp = _decomp_alloc\\n    for _ in range(warmup - 1):\\n        dec = decomp()\\n    torch.cuda.synchronize()\\n\\n    d_best = float(\\\"inf\\\")\\n    for _ in range(runs):\\n        torch.cuda.synchronize(); t0 = time.perf_counter()\\n        dec = decomp()\\n        torch.cuda.synchronize()\\n        d_best = min(d_best, time.perf_counter() - t0)\\n\\n    ok = _verify(w_gpu, dec)\\n    del comp, dec, out\\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\\n                  c_best * 1e3, d_best * 1e3, ok)\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  Output formatting\\n# ════════════════════════════════════════════════════════════════════\\n\\n# Tables are emitted single-space-separated with single-token headers (no\\n# internal spaces, no alignment padding) so they paste straight into Excel\\n# (Text-to-Columns -> space delimiter, or \\\"treat consecutive delimiters as one\\\").\\n\\ndef _print_table(rows):\\n    if not rows:\\n        print(\\\"(no results)\\\"); return\\n    print(\\\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\\\")\\n    for r in rows:\\n        print(f\\\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \\\"\\n              f\\\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \\\"\\n              f\\\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\\\")\\n\\n\\ndef _print_summary(all_rows):\\n    print(\\\"\\\\nSUMMARY (averaged across all weights)\\\")\\n    by_codec = defaultdict(list)\\n    for r in all_rows:\\n        by_codec[r.codec].append(r)\\n    print(\\\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\\\")\\n    import statistics as st\\n    for codec, rs in by_codec.items():\\n        n = len(rs)\\n        n_ok = sum(1 for r in rs if r.ok)\\n        print(f\\\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \\\"\\n              f\\\"{st.mean(r.c_ms for r in rs):.3f} \\\"\\n              f\\\"{st.mean(r.d_ms for r in rs):.3f} \\\"\\n              f\\\"{st.mean(r.c_gbps for r in rs):.2f} \\\"\\n              f\\\"{st.mean(r.d_gbps for r in rs):.2f} \\\"\\n              f\\\"{n_ok}/{n}\\\")\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  Per-weight driver\\n# ════════════════════════════════════════════════════════════════════\\n\\ndef _bench_weight(t, name, selected, registry, get_inst, runs, no_cast):\\n    \\\"\\\"\\\"Benchmark every applicable codec on one 2-D weight ``t`` (CPU tensor).\\n\\n    Prints a per-weight header + table and returns the ``Result`` rows.\\n    Handles dtype selection (bf16 / fp8 codecs) and the fp16/fp32 -> bf16\\n    cast, then defers per-codec timing to :func:`bench_codec`.\\n    \\\"\\\"\\\"\\n    if t.ndim != 2 or t.numel() < 1024:\\n        print(f\\\"# skip {name} shape={'x'.join(str(d) for d in t.shape)}\\\")\\n        return []\\n\\n    kind = _fp8_kind(t.dtype)\\n    note = \\\"\\\"\\n    if kind is not None:\\n        dtype_kind = \\\"fp8\\\"\\n        w = t.to(\\\"cuda\\\")\\n    elif t.dtype == torch.bfloat16:\\n        dtype_kind = \\\"bf16\\\"\\n        w = t.to(\\\"cuda\\\")\\n    else:\\n        if no_cast:\\n            print(f\\\"# skip {name} dtype={t.dtype}\\\")\\n            return []\\n        dtype_kind = \\\"bf16\\\"\\n        w = t.to(\\\"cuda\\\").to(torch.bfloat16)\\n        note = f\\\" cast={t.dtype}->bf16\\\"\\n    w = w.contiguous()\\n\\n    codecs = selected if selected is not None else (\\n        _DEFAULT_FP8 if dtype_kind == \\\"fp8\\\" else _DEFAULT_BF16)\\n    codecs = [c for c in codecs if registry[c][0] == dtype_kind]\\n\\n    print(f\\\"# {name} {w.shape[0]}x{w.shape[1]} {w.dtype}{note}\\\")\\n    rows = []\\n    for codec in codecs:\\n        obj = get_inst(codec)\\n        if obj is None:\\n            continue\\n        try:\\n            rows.append(bench_codec(obj, codec, name, w, runs))\\n        except Exception as e:\\n            if \\\"out of memory\\\" in str(e).lower():\\n                free = torch.cuda.mem_get_info()[0] / 1024**3\\n                msg = f\\\"CUDA OOM ({free:.1f} GiB free — GPU shared?)\\\"\\n            else:\\n                msg = str(e).splitlines()[0] if str(e) else type(e).__name__\\n            print(f\\\"    [{codec}] skipped: {msg}\\\")\\n            torch.cuda.empty_cache()\\n    _print_table(rows)\\n    del w\\n    torch.cuda.empty_cache()\\n    return rows\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  Main\\n# ════════════════════════════════════════════════════════════════════\\n\\ndef main():\\n    ap = argparse.ArgumentParser(\\n        description=\\\"tiered-serve weight compress/decompress benchmark\\\")\\n    ap.add_argument(\\\"model\\\", nargs=\\\"+\\\",\\n                    help=\\\"HF model id (org/name, resolved from the hub cache) \\\"\\n                         \\\"or explicit .safetensors path(s)\\\")\\n    ap.add_argument(\\\"--codec\\\", default=None,\\n                    help=\\\"Comma-separated codec names, or 'all'. Default: \\\"\\n                         f\\\"{','.join(_DEFAULT_BF16)} (BF16) / \\\"\\n                         f\\\"{','.join(_DEFAULT_FP8)} (FP8)\\\")\\n    ap.add_argument(\\\"--group\\\", \\\"-g\\\", default=None,\\n                    help=\\\"Comma-separated fused groups to run \\\"\\n                         f\\\"({', '.join(_GROUP_DEFS)}). Default: all\\\")\\n    ap.add_argument(\\\"--layer\\\", \\\"-l\\\", type=int, default=None,\\n                    help=\\\"Restrict to one transformer layer (e.g. 0)\\\")\\n    ap.add_argument(\\\"--per-tensor\\\", action=\\\"store_true\\\",\\n                    help=\\\"Benchmark raw per-projection weights (q/k/v/...) \\\"\\n                         \\\"instead of the fused qkv/o/gateup/down\\\")\\n    ap.add_argument(\\\"--key\\\", \\\"-k\\\", default=None,\\n                    help=\\\"(--per-tensor) only weights whose name contains this\\\")\\n    ap.add_argument(\\\"--all-weights\\\", action=\\\"store_true\\\",\\n                    help=\\\"(--per-tensor) include non-projection weights\\\")\\n    ap.add_argument(\\\"--max-weights\\\", type=int, default=0,\\n                    help=\\\"Process at most this many weights (0 = all)\\\")\\n    ap.add_argument(\\\"--runs\\\", type=int, default=5,\\n                    help=\\\"Timed iterations per codec (best is reported)\\\")\\n    ap.add_argument(\\\"--no-cast\\\", action=\\\"store_true\\\",\\n                    help=\\\"Skip non-BF16/FP8 weights instead of casting fp16/\\\"\\n                         \\\"fp32 to bf16\\\")\\n    args = ap.parse_args()\\n\\n    if not torch.cuda.is_available():\\n        sys.exit(\\\"CUDA is required (tiered-serve weight codecs run on GPU).\\\")\\n\\n    shards = _resolve_inputs(args.model)\\n    if not shards:\\n        sys.exit(\\\"No safetensors shards found.\\\")\\n\\n    registry = _build_registry()\\n    selected = (None if args.codec is None\\n                else list(registry) if args.codec == \\\"all\\\"\\n                else [c.strip() for c in args.codec.split(\\\",\\\") if c.strip()])\\n    if selected is not None:\\n        for c in selected:\\n            if c not in registry:\\n                sys.exit(f\\\"Unknown codec {c!r}. Known: {', '.join(registry)}\\\")\\n\\n    group_filter = None\\n    if args.group is not None:\\n        group_filter = [g.strip() for g in args.group.split(\\\",\\\") if g.strip()]\\n        for g in group_filter:\\n            if g not in _GROUP_DEFS:\\n                sys.exit(f\\\"Unknown group {g!r}. Known: {', '.join(_GROUP_DEFS)}\\\")\\n\\n    mode = \\\"per-tensor\\\" if args.per_tensor else \\\"fused (qkv/o/gateup/down)\\\"\\n    print(\\\"=\\\" * 80)\\n    print(\\\"  tiered-serve weight compression benchmark\\\")\\n    print(\\\"=\\\" * 80)\\n    print(f\\\"  Shards : {len(shards)} file(s)\\\")\\n    print(f\\\"  Mode   : {mode}\\\")\\n    print(f\\\"  GPU    : {torch.cuda.get_device_name(0)}\\\")\\n    print(f\\\"  Runs   : {args.runs}  (best-of)\\\")\\n    print(\\\"=\\\" * 80 + \\\"\\\\n\\\")\\n\\n    stream = torch.cuda.Stream()\\n    instances = {}   # codec name -> built compressor (or None if build failed)\\n\\n    def _get(codec):\\n        if codec not in instances:\\n            try:\\n                instances[codec] = registry[codec][1](stream)\\n            except Exception as e:\\n                print(f\\\"  [build {codec}] FAILED: {e}\\\")\\n                instances[codec] = None\\n        return instances[codec]\\n\\n    all_rows = []\\n    processed = 0\\n\\n    if args.per_tensor:\\n        for shard in sorted(shards):\\n            if args.max_weights and processed >= args.max_weights:\\n                break\\n            with safe_open(shard, framework=\\\"pt\\\") as sf:\\n                keys = _filter_keys(list(sf.keys()), args.key, args.all_weights,\\n                                    args.layer, args.max_weights, processed)\\n                if not keys:\\n                    continue\\n                print(f\\\"# {os.path.basename(shard)} — {len(keys)} weight(s)\\\\n\\\")\\n                for k in keys:\\n                    if args.max_weights and processed >= args.max_weights:\\n                        break\\n                    rows = _bench_weight(sf.get_tensor(k), _short_name(k),\\n                                         selected, registry, _get,\\n                                         args.runs, args.no_cast)\\n                    all_rows.extend(rows)\\n                    if rows:\\n                        processed += 1\\n                    print()\\n    else:\\n        index = _build_layer_index(shards, args.layer)\\n        if not index:\\n            sys.exit(\\\"No transformer-layer projection weights found \\\"\\n                     \\\"(use --per-tensor for non-standard checkpoints).\\\")\\n        # Pre-size the DietGPU ANS workspace to the largest fused weight so it\\n        # doesn't cudaMalloc a temp buffer per compress (which biases its time).\\n        # Falls back to the default (smaller) workspace if the up-front\\n        # allocation won't fit — important when the GPU is shared with another\\n        # process and free memory is tight.\\n        if \\\"dietgpu\\\" in (selected if selected is not None else _DEFAULT_BF16):\\n            max_numel = _max_fused_numel(index, group_filter)\\n            if max_numel:\\n                from tiered_serve.compression.core import DietGPUCompressor\\n                ws = int(max_numel * 2 * 1.4)  # bf16 bytes * compress peak\\n\\n                def _dietgpu_build(s, ws=ws):\\n                    try:\\n                        return DietGPUCompressor(s, workspace_bytes=ws)\\n                    except torch.cuda.OutOfMemoryError:\\n                        torch.cuda.empty_cache()\\n                        return DietGPUCompressor(s)  # default workspace\\n                registry[\\\"dietgpu\\\"] = (\\\"bf16\\\", _dietgpu_build)\\n        for layer in sorted(index):\\n            if args.max_weights and processed >= args.max_weights:\\n                break\\n            tensors = _load_layer(index[layer])\\n            print(f\\\"# layer {layer}\\\\n\\\")\\n            for gname, roles in _GROUP_DEFS.items():\\n                if group_filter is not None and gname not in group_filter:\\n                    continue\\n                if not all(r in tensors for r in roles):\\n                    continue\\n                if args.max_weights and processed >= args.max_weights:\\n                    break\\n                if len(roles) == 1:\\n                    gt = tensors[roles[0]]\\n                else:\\n                    gt = torch.cat([tensors[r] for r in roles], dim=0)\\n                rows = _bench_weight(gt, f\\\"L{layer}.{gname}\\\", selected,\\n                                     registry, _get, args.runs, args.no_cast)\\n                all_rows.extend(rows)\\n                if rows:\\n                    processed += 1\\n                print()\\n                del gt\\n            del tensors\\n            torch.cuda.empty_cache()\\n\\n    if not all_rows:\\n        sys.exit(\\\"No weights were benchmarked (check --group/--layer/--codec).\\\")\\n    _print_summary(all_rows)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\\n=== base interface ===\\n\\\"\\\"\\\"Backend-agnostic helpers and metadata containers for compressed tensors.\\n\\nHouses:\\n\\n* :f…334 tokens truncated…ble).\\n            - \\\"per_head_static\\\": Per-(layer, head) BaseExp from offline calibration.\\n            - \\\"per_head_dynamic\\\": Per-(layer, head, block) BaseExp computed online.\\n        k_base_exp_table: Per-(layer, head) start_exp for K cache.\\n            Shape [num_layers, num_kv_heads], uint8 values. Only used when\\n            mode == \\\"per_head_static\\\".\\n        v_base_exp_table: Per-(layer, head) start_exp for V cache.\\n            Same shape/semantics as k_base_exp_table.\\n        num_kv_heads: Number of KV heads per layer.\\n        block_size: Tokens per KV cache block (must be 16 for initial impl).\\n    \\\"\\\"\\\"\\n    mode: str = \\\"global\\\"\\n    k_base_exp_table: Optional[torch.Tensor] = None\\n    v_base_exp_table: Optional[torch.Tensor] = None\\n    num_kv_heads: int = 8\\n    block_size: int = 16\\n\\n    def __post_init__(self):\\n        valid_modes = (\\\"global\\\", \\\"per_head_static\\\", \\\"per_head_dynamic\\\")\\n        if self.mode not in valid_modes:\\n            raise ValueError(\\n                f\\\"BaseExpConfig.mode must be one of {valid_modes}, \\\"\\n                f\\\"got '{self.mode}'\\\")\\n        if self.mode == \\\"per_head_static\\\":\\n            if self.k_base_exp_table is None or self.v_base_exp_table is None:\\n                raise ValueError(\\n                    \\\"per_head_static mode requires k_base_exp_table and \\\"\\n                    \\\"v_base_exp_table\\\")\\n\\n    @classmethod\\n    def from_json(cls, path: str, num_kv_heads: int = 8,\\n                  block_size: int = 16) -> 'BaseExpConfig':\\n        \\\"\\\"\\\"Load from a calibration JSON file.\\\"\\\"\\\"\\n        with open(path, 'r') as f:\\n            data = json.load(f)\\n        k_table = torch.tensor(data['k_base_exp_table'], dtype=torch.uint8)\\n        v_table = torch.tensor(data['v_base_exp_table'], dtype=torch.uint8)\\n        return cls(\\n            mode=\\\"per_head_static\\\",\\n            k_base_exp_table=k_table,\\n            v_base_exp_table=v_table,\\n            num_kv_heads=data.get('num_kv_heads', num_kv_heads),\\n            block_size=data.get('block_size', block_size),\\n        )\\n\\n    def get_top_exps_table(self, layer_id: int, kv: str, n: int) -> torch.Tensor:\\n        \\\"\\\"\\\"Build [N, num_kv_heads, 7] uint8 top_exps table for compress.\\n\\n        For static mode, start_exp is stored per (layer, head).\\n        top_exps[h] = [start_exp+1, start_exp+2, ..., start_exp+7].\\n        The table is broadcast to N blocks (all blocks in the same layer\\n        share the same per-head exponent window).\\n\\n        For dynamic mode, returns an empty tensor (histogram kernel is used).\\n        \\\"\\\"\\\"\\n        if self.mode == \\\"per_head_dynamic\\\":\\n            return torch.empty(0, dtype=torch.uint8)\\n        table = self.k_base_exp_table if kv == \\\"k\\\" else self.v_base_exp_table\\n        # table shape: [num_layers, num_kv_heads] — values are start_exp\\n        se = table[layer_id]  # [num_kv_heads] uint8\\n        # Build 7 consecutive exponents: start_exp+1 .. start_exp+7\\n        offsets = torch.arange(1, 8, dtype=torch.uint8)\\n        top_exps = se.unsqueeze(-1) + offsets.unsqueeze(0)  # [num_kv_heads, 7]\\n        # Broadcast to N blocks\\n        return top_exps.unsqueeze(0).expand(n, -1, -1).contiguous()\\n\\n\\nclass SplitStorageInfo:\\n    \\\"\\\"\\\"Lightweight container for frozen_split mode per-tensor state.\\n\\n    Holds references to HBM-resident sign_mantissa, LPDDR-resident auxiliary\\n    buffers, and scalar metadata needed to invoke decompress_gpu().\\n\\n    Backend-aware: ZipServ stores six aux buffers\\n    (compressed_full + 3 bitmaps + 2 tile_offsets), DietGPU stores only\\n    the ANS-compressed exponent stream.\\n    \\\"\\\"\\\"\\n\\n    # ZipServ BF16: ``tile_offsets_*`` are small prefix-sum arrays\\n    # (~1% of the weight) that the decompress kernel touches on every\\n    # decode.  Keeping them HBM-resident (see ``_ZIPSERV_HBM_ATTRS``)\\n    # removes them from the per-decode LPDDR→GPU H2D entirely, so only\\n    # the bulk codec payload crosses the bus.\\n    _ZIPSERV_LPDDR_ATTRS = (\\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3',\\n    )\\n    _DIETGPU_LPDDR_ATTRS = ('compressed_exp',)\\n    _DIETGPU_FP8_LPDDR_ATTRS = ('compressed_exp',)\\n    _ZIPSERV_FP8_LPDDR_ATTRS = (\\n        'compressed_full', 'bitmap1', 'bitmap2', 'bitmap3', 'bitmap4',\\n        'group_offsets', 'small_in_group_hi',\\n    )\\n    # P4-flat keeps sign_mantissa on HBM; the rest of the codec state\\n    # (palette headers + 4-bit codes + exception list) lives on LPDDR.\\n    # The sorted-by-m exception metadata is fused-MM-only — shipping it\\n    # to LPDDR enables frozen_split + --fused-mm to find the same data\\n    # the standalone fused-MM path expects.  These buffers are tiny\\n    # (proportional to num_exceptions, typically ≪0.01% of weight bytes)\\n    # so the LPDDR cost is negligible.\\n    _P4FLAT_LPDDR_ATTRS = (\\n        'headers', 'codes',\\n        'subtile_codec',\\n        'exc_indices', 'exc_values',\\n        'exc_sorted_indices', 'exc_sorted_values',\\n        'exc_group_m', 'exc_group_offsets',\\n    )\\n    # P4-D16 (global palette variant): same HBM/LPDDR split as P4-flat\\n    # but the per-tile palette headers collapse to a single global\\n    # palette (16 B) shipped on LPDDR with the rest of the codec state.\\n    _P4D16_LPDDR_ATTRS = (\\n        'global_palette', 'markers', 'codes',\\n        'exc_indices', 'exc_values',\\n    )\\n    # P3-flat FP8 keeps sm_nibbles on HBM (the e4m3 analog of P4-flat's\\n    # sign_mantissa byte, just nibble-packed); the rest of the codec\\n    # state lives on LPDDR. (Per-tile exception offsets live inside the\\n    # 16-byte header — no separate offsets buffer.)\\n    _P3FLAT_FP8_LPDDR_ATTRS = (\\n        'headers', 'codes', 'exc_exp_nibbles',\\n    )\\n    # UBLB-flat: the raw lower byte (lb_raw, M*K bytes = half the BF16) is the\\n    # HBM-resident half (the analog of P4-flat's sign_mantissa); the nibble-\\n    # packed upper-byte codes + 16-byte palette + (idx, ub) exception list ship\\n    # to LPDDR.  Decode = flat_decode(code_stream, lb_raw, palette) + flat_patch.\\n    _UBLB_FLAT_LPDDR_ATTRS = (\\n        'code_stream', 'palette', 'exc_idx', 'exc_ub',\\n    )\\n\\n    # --- HBM-resident auxiliary buffers (beyond sign_mantissa) ---\\n    # These are cloned onto HBM at compress time and NEVER H2D'd in the\\n    # decode hot path.  Only ZipServ BF16 has any; other backends keep\\n    # everything except sign_mantissa on LPDDR (empty tuple default).\\n    _ZIPSERV_HBM_ATTRS = ('tile_offsets_median', 'tile_offsets_global')\\n\\n    _BACKEND_TO_HBM_ATTRS = {\\n        'zipserv': _ZIPSERV_HBM_ATTRS,\\n    }\\n\\n    # Compressor-independent raw-exp split: only the uncompressed exponent\\n    # crosses the bus (sign_mantissa stays HBM-resident); decode is a pure\\n    # bit-merge, no entropy decode.\\n    _RAW_EXP_LPDDR_ATTRS = ('raw_exp',)\\n\\n    _BACKEND_TO_ATTRS = {\\n        'zipserv':     _ZIPSERV_LPDDR_ATTRS,\\n        'dietgpu':     _DIETGPU_LPDDR_ATTRS,\\n        'dietgpu_fp8': _DIETGPU_FP8_LPDDR_ATTRS,\\n        'zipserv_fp8': _ZIPSERV_FP8_LPDDR_ATTRS,\\n        'p4flat':      _P4FLAT_LPDDR_ATTRS,\\n        'ublb_flat':   _UBLB_FLAT_LPDDR_ATTRS,\\n        'p4d16':       _P4D16_LPDDR_ATTRS,\\n        'p3flat_fp8':  _P3FLAT_FP8_LPDDR_ATTRS,\\n        'raw_exp':     _RAW_EXP_LPDDR_ATTRS,\\n    }\\n\\n    def __init__(self, sign_mantissa: torch.Tensor,\\n                 lpddr_buffers: Dict[str, torch.Tensor],\\n                 metadata: Dict[str, int],\\n                 backend: str = 'zipserv',\\n                 lpddr_shared: bool = False,\\n                 hbm_buffers: Optional[Dict[str, torch.Tensor]] = None):\\n        self.sign_mantissa = sign_mantissa          # GPU permanent\\n        # Optional phase-adaptive alternate compression of the SAME weight\\n        # (e.g. a fast-decode p4flat codec used at prefill while this primary\\n        # info is used at decode). It is a full SplitStorageInfo that ALIASES\\n        # this one's ``sign_mantissa`` (only its compressed-exp side differs).\\n        self.alt: Optional['SplitStorageInfo'] = None\\n        self.lpddr_buffers = lpddr_buffers           # {attr_name: LPDDR hugepage tensor}\\n        # Auxiliary buffers kept permanently on HBM alongside\\n        # sign_mantissa (e.g. ZipServ tile_offsets); never H2D'd in the\\n        # decode hot path.  {attr_name: GPU tensor}.\\n        self.hbm_buffers: Dict[str, torch.Tensor] = hbm_buffers or {}\\n        self.hbm_attrs: tuple = self._BACKEND_TO_HBM_ATTRS.get(backend, ())\\n        self.backend = backend\\n        # When True, the LPDDR buffer tensors are aliases owned elsewhere.\\n        # Teardown must NOT call\\n        # huge_page_allocator.free on them — that would invalidate the\\n        # other owner's references and break the next reconfigure.\\n        self.lpddr_shared = lpddr_shared\\n        self.lpddr_attrs: tuple = self._BACKEND_TO_ATTRS.get(\\n            backend, self._ZIPSERV_LPDDR_ATTRS)\\n        # Pre-cache numel of each LPDDR buffer so the hot decompress path\\n        # never has to call tensor.numel() on host (and never risks any\\n        # implicit sync that PyTorch could introduce in future versions).\\n        self.lpddr_numels: Dict[str, int] = {\\n            attr: int(t.numel()) for attr, t in lpddr_buffers.items()\\n        }\\n        # Expose all metadata fields as attributes (e.g. M, K,\\n        # max_high_freq_count for ZipServ; exp_compressed_size for DietGPU).\\n        for k, v in metadata.items():\\n            setattr(self, k, v)\\n\\n    @property\\n    def hbm_bytes(self) -> int:\\n        return self.sign_mantissa.nbytes + sum(\\n            t.nbytes for t in self.hbm_buffers.values())\\n\\n    @property\\n    def lpddr_bytes(self) -> int:\\n        return sum(t.nbytes for t in self.lpddr_buffers.values())\\n\\n=== registry exports ===\\n\\\"\\\"\\\"tiered_serve.compression.core — codec-core Python.\\n\\nHolds one module per codec (``zipserv``, ``dietgpu``, ``ublb``, ...).\\nEach module defines its ``Compressed*Tensor`` and ``*Compressor`` class\\nwithout depending on KV-cache / serving-side concepts — those live in\\n``tiered_serve.compression.adapters``.\\n\\nThis package exposes the public symbols at the package level so new\\ncode can write ``from tiered_serve.compression.core import\\nUBLBCompressor``.  Legacy imports through ``tiered_serve.tensor_compressor``\\ncontinue to work via that module's facade re-exports.\\n\\\"\\\"\\\"\\nfrom tiered_serve.compression.core.base import (\\n    BaseExpConfig,\\n    SplitStorageInfo,\\n    _h2d_record_stream,\\n)\\nfrom tiered_serve.compression.core.ublb import (\\n    CompressedUBLBTensor,\\n    UBLBCompressor,\\n)\\nfrom tiered_serve.compression.core.ublb_tbe import (\\n    CompressedUBLBTBETensor,\\n    UBLBTBECompressor,\\n    CompressedUBLBFlatTensor,\\n    UBLBFlatCompressor,\\n)\\nfrom tiered_serve.compression.core.zipserv import (\\n    CompressedZipServTensor,\\n    ZipServCompressor,\\n)\\nfrom tiered_serve.compression.core.dietgpu import (\\n    _ensure_dietgpu_loaded,\\n    CompressedDietGPUTensor,\\n    DietGPUCompressor,\\n)\\nfrom tiered_serve.compression.core.dietgpu_fp8 import (\\n    _fp8_kind_of,\\n    CompressedDietGPUFP8Tensor,\\n    DietGPUFP8Compressor,\\n)\\nfrom tiered_serve.compression.core.zipserv_fp8 import (\\n    CompressedZipServFP8GpuTensor,\\n    ZipServFP8GpuCompressor,\\n)\\nfrom tiered_serve.compression.core.p4flat import (\\n    CompressedP4FlatTensor,\\n    P4FlatCompressor,\\n)\\nfrom tiered_serve.compression.core.p3flat_fp8 import (\\n    CompressedP3FlatFP8Tensor,\\n    P3FlatFP8Compressor,\\n)\\nfrom tiered_serve.compression.core.p4d16 import (\\n    CompressedP4D16Tensor,\\n    P4D16Compressor,\\n)\\nfrom tiered_serve.compression.core.auto import _AutoWeightCompressor\\n\\n__all__ = [\\n    \\\"BaseExpConfig\\\",\\n    \\\"SplitStorageInfo\\\",\\n    \\\"_h2d_record_stream\\\",\\n    \\\"CompressedUBLBTensor\\\",\\n    \\\"UBLBCompressor\\\",\\n    \\\"CompressedUBLBTBETensor\\\",\\n    \\\"UBLBTBECompressor\\\",\\n    \\\"CompressedUBLBFlatTensor\\\",\\n    \\\"UBLBFlatCompressor\\\",\\n    \\\"CompressedZipServTensor\\\",\\n    \\\"ZipServCompressor\\\",\\n    \\\"_ensure_dietgpu_loaded\\\",\\n    \\\"CompressedDietGPUTensor\\\",\\n    \\\"DietGPUCompressor\\\",\\n    \\\"_fp8_kind_of\\\",\\n    \\\"CompressedDietGPUFP8Tensor\\\",\\n    \\\"DietGPUFP8Compressor\\\",\\n    \\\"CompressedZipServFP8GpuTensor\\\",\\n    \\\"ZipServFP8GpuCompressor\\\",\\n]\\n\\\"\\\"\\\"Auto dtype-dispatching weight compressor.\\n\\nDispatches compress / decompress / fused_mm to the BF16 or FP8 sub-\\ncompressor of the chosen family based on the tensor dtype at call\\ntime, so the dual-memory loader can hold a uniformly-typed\\n``weight_compressor`` regardless of which dtype variant the user\\nselected.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport logging\\nfrom typing import Optional\\n\\nimport torch\\n\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.compression.core.dietgpu import DietGPUCompressor\\nfrom tiered_serve.compression.core.dietgpu_fp8 import (\\n    DietGPUFP8Compressor,\\n    CompressedDietGPUFP8Tensor,\\n    _fp8_kind_of,\\n)\\nfrom tiered_serve.compression.core.zipserv_fp8 import (\\n    ZipServFP8GpuCompressor,\\n    CompressedZipServFP8GpuTensor,\\n)\\n\\nlogger = logging.getLogger(\\\"vllm\\\")\\n\\n\\nclass _AutoWeightCompressor(TensorCompressor):\\n    \\\"\\\"\\\"Dispatches compress/decompress to a BF16 or FP8 backend based on\\n    the tensor dtype at call time.\\n\\n    Inherits :class:`TensorCompressor` so :class:`DualMemoryLoader` sees a\\n    uniformly-typed ``weight_compressor`` regardless of whether the user\\n    pinned a specific dtype variant or chose the auto family.\\n\\n    Used when ``TIERED_SERVE_WEIGHT_COMP_BACKEND`` is ``\\\"zipserv\\\"`` or\\n    ``\\\"dietgpu\\\"`` (no ``_bf16`` / ``_fp8`` suffix): the backend family\\n    is fixed, but whether we use the BF16 or FP8 variant is decided on\\n    the fly.  Both BF16 and FP8 sub-compressors share the same CUDA\\n    stream and are instantiated lazily so unused paths allocate nothing.\\n    \\\"\\\"\\\"\\n\\n    # The fused decompress+GEMM path (``--fused-mm``) is a BF16 feature;\\n    # both supported families' BF16 backends (ZipServ / DietGPU) implement\\n    # it.  Expose the capability so DualMemoryLoader's frozen_split /\\n    # frozen_compressed install loops (which gate on ``HAS_FUSED_MM`` of the\\n    # *wrapper*, not the lazily-built sub-compressor) don't skip every layer.\\n    # ``build_split_shell`` delegates to the BF16 backend and raises\\n    # NotImplementedError if that backend ever lacks fused support — the\\n    # install loop catches it and falls back to the dense decompress path.\\n    HAS_FUSED_MM = True\\n\\n    def __init__(self, family: str, comp_stream: torch.cuda.Stream,\\n                 dietgpu_workspace_bytes: Optional[int] = None):\\n        if family not in (\\\"zipserv\\\", \\\"dietgpu\\\"):\\n            raise ValueError(f\\\"Unknown weight comp family: {family}\\\")\\n        super().__init__(comp_stream=comp_stream)\\n        self.family = family\\n        self.comp_stream = comp_stream\\n        # Forwarded to the DietGPU sub-compressor on instantiation; ignored\\n        # by the ZipServ family.  ``None`` defers to the env-var / module\\n        # default sizing in ``_dietgpu_workspace_bytes``.\\n        self._dietgpu_workspace_bytes = dietgpu_workspace_bytes\\n        self._bf16_impl: Optional[object] = None\\n        self._fp8_impl: Optional[object] = None\\n\\n    # ----- lazy sub-compressor accessors -----\\n\\n    def _bf16(self):\\n        if self._bf16_impl is None:\\n            if self.family == \\\"zipserv\\\":\\n                # Lazy import to avoid the ZipServ module load when the\\n                # caller only ever touches the FP8 path.  ZipServ is still\\n                # in tensor_compressor.py until its dedicated extraction\\n                # phase lands.\\n                from tiered_serve.tensor_compressor import ZipServCompressor\\n                self._bf16_impl = ZipServCompressor(self.comp_stream)\\n            else:\\n                self._bf16_impl = DietGPUCompressor(\\n                    self.comp_stream,\\n                    workspace_bytes=self._dietgpu_workspace_bytes)\\n            logger.info(\\n                \\\"AutoWeightCompressor: instantiated BF16 backend \\\"\\n                f\\\"({self.family})\\\")\\n        return self._bf16_impl\\n\\n    def _fp8(self):\\n        if self._fp8_impl is None:\\n            if self.family == \\\"zipserv\\\":\\n                # Native GPU FP8 e4m3 path (no CPU fallback — the legacy\\n                # reference impl has been removed in favour of the in-tree\\n                # zipserv_fp8_ext extension).\\n                self._fp8_impl = ZipServFP8GpuCompressor(self.comp_stream)\\n            else:\\n                self._fp8_impl = DietGPUFP8Compressor(\\n                    self.comp_stream,\\n                    workspace_bytes=self._dietgpu_workspace_bytes)\\n            logger.info(\\n                \\\"AutoWeightCompressor: instantiated FP8 backend \\\"\\n                f\\\"({self.family}_fp8)\\\")\\n        return self._fp8_impl\\n\\n    # ----- dispatch -----\\n\\n    def _pick_for_dtype(self, dtype):\\n        if _fp8_kind_of(dtype) is not None:\\n            return self._fp8()\\n        if dtype == torch.bfloat16:\\n            return self._bf16()\\n        raise TypeError(\\n            f\\\"AutoWeightCompressor: unsupported dtype {dtype}; expected \\\"\\n            \\\"bfloat16 or float8_e4m3fn/float8_e5m2\\\")\\n\\n    def compress(self, weight, *args, **kwargs):\\n        return self._pick_for_dtype(weight.dtype).compress(\\n            weight, *args, **kwargs)\\n\\n    def decompress(self, comp, *args, **kwargs):\\n        # Pick backend from the compressed-tensor class so this works\\n        # after a round-trip through disk/pool.\\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\\n                             CompressedZipServFP8GpuTensor)):\\n            return self._fp8().decompress(comp, *args, **kwargs)\\n        return self._bf16().decompress(comp, *args, **kwargs)\\n\\n    def compress_batch(self, weights, *args, **kwargs):\\n        # Loop fallback: per-tensor dispatch handles mixed dtypes.\\n        return [self.compress(w, *args, **kwargs) for w in weights]\\n\\n    def decompress_batch(self, comps, outputs=None):\\n        outs = outputs or [None] * len(comps)\\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\\n\\n    def fused_mm(self, comp, *args, **kwargs):\\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\\n                             CompressedZipServFP8GpuTensor)):\\n            raise NotImplementedError(\\n                \\\"fused_mm is only implemented for BF16 compressors\\\")\\n        return self._bf16().fused_mm(comp, *args, **kwargs)\\n\\n    def linear_apply(self, comp, x, *args, **kwargs):\\n        # Hot path under ``--fused-mm`` (see graph_wait_ops._fused_linear_apply\\n        # _impl).  frozen_split shells are BF16; FP8 has no fused path.\\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\\n                             CompressedZipServFP8GpuTensor)):\\n            raise NotImplementedError(\\n                \\\"linear_apply (fused) is only implemented for BF16 compressors\\\")\\n        return self._bf16().linear_apply(comp, x, *args, **kwargs)\\n\\n    def build_split_shell(self, info, staging_dict):\\n        # frozen_split fused-MM install: delegate to the BF16 backend (the\\n 