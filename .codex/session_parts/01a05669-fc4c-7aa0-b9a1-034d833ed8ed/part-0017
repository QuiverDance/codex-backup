urrent_stream())\\\\n+\\\\n+\\\\n+def _all_bf16_patterns() -> torch.Tensor:\\\\n+    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\\\\n+    return bits.view(torch.bfloat16).reshape(256, 256).cuda().contiguous()\\\\n+\\\\n+\\\\n+def _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\\\\n+    assert actual.shape == expected.shape\\\\n+    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\\\\n+\\\\n+\\\\n+def test_all_bf16_patterns_roundtrip_bit_exact() -> None:\\\\n+    codec = _codec()\\\\n+    weight = _all_bf16_patterns()\\\\n+    compressed = codec.compress(weight)\\\\n+    restored = codec.decompress(compressed)\\\\n+    torch.cuda.synchronize()\\\\n+    assert compressed.total_compressed_size == compressed.nbytes\\\\n+    assert compressed.original_size == weight.nbytes\\\\n+    assert compressed.num_exceptions > 0\\\\n+    _assert_bit_exact(restored, weight)\\\\n+\\\\n+\\\\n+@pytest.mark.parametrize(\\\\\\\"use_gpu_pool\\\\\\\", [False, True])\\\\n+def test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\\\\n+    codec = _codec()\\\\n+    generator = torch.Generator(device=\\\\\\\"cuda\\\\\\\").manual_seed(17)\\\\n+    weight = torch.randn(\\\\n+        128, 128, generator=generator, dtype=torch.float32, device=\\\\\\\"cuda\\\\\\\"\\\\n+    ).to(torch.bfloat16)\\\\n+    compressed = codec.compress(weight)\\\\n+    compressed_bytes = compressed.nbytes\\\\n+    compressed.to_host()\\\\n+    assert compressed.nbytes == compressed_bytes\\\\n+    assert all(getattr(compressed, attr).device.type == \\\\\\\"cpu\\\\\\\"\\\\n+               for attr in compressed._BUFFER_ATTRS)\\\\n+\\\\n+    output = torch.empty_like(weight)\\\\n+    gpu_pool = None\\\\n+    if use_gpu_pool:\\\\n+        gpu_pool = {\\\\n+            attr: torch.empty_like(getattr(compressed, attr), device=\\\\\\\"cuda\\\\\\\")\\\\n+            for attr in compressed._BUFFER_ATTRS\\\\n+        }\\\\n+    compressed.register_temp_d_tensor(output, gpu_pool)\\\\n+    compressed.to(\\\\\\\"cuda\\\\\\\", non_blocking=True)\\\\n+    restored = codec.decompress(compressed)\\\\n+    torch.cuda.synchronize()\\\\n+    assert restored.data_ptr() == output.data_ptr()\\\\n+    _assert_bit_exact(restored, weight)\\\\n+\\\\n+\\\\n+def test_rejects_non_tile_aligned_shape() -> None:\\\\n+    codec = _codec()\\\\n+    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\\\\\\\"cuda\\\\\\\")\\\\n+    with pytest.raises(ValueError, match=\\\\\\\"divisible by 64\\\\\\\"):\\\\n+        codec.compress(weight)\\\\n*** Add File: tiered-serve-edit/benchmarks/kv_codec.py\\\\n+#!/usr/bin/env python3\\\\n+\\\\\\\"\\\\\\\"\\\\\\\"Direct production-codec benchmark on real cached K/V blocks.\\\\n+\\\\n+The serving KV block layout [N, 16, 8, 128] is viewed as two dense\\\\n+[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\\\\n+required by P4Flat and ChunkDelta3 while exercising their normal compressor,\\\\n+host-staging, and decompressor interfaces.\\\\n+\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+from __future__ import annotations\\\\n+\\\\n+import argparse\\\\n+import gc\\\\n+import os\\\\n+import statistics\\\\n+import sys\\\\n+import time\\\\n+\\\\n+_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\\\n+if _REPO_ROOT not in sys.path:\\\\n+    sys.path.insert(0, _REPO_ROOT)\\\\n+\\\\n+import torch\\\\n+\\\\n+\\\\n+DEFAULT_PATH = (\\\\n+    \\\\\\\"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\\\\\\\")\\\\n+BLOCK_SHAPE = (16, 8, 128)\\\\n+ROWS_PER_BLOCK = 128\\\\n+COLS = 128\\\\n+\\\\n+\\\\n+def _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\\\\n+    obj = torch.load(path, map_location=\\\\\\\"cpu\\\\\\\", weights_only=False)\\\\n+    k_key = \\\\\\\"k_post_blocks\\\\\\\" if \\\\\\\"k_post_blocks\\\\\\\" in obj else \\\\\\\"k_blocks\\\\\\\"\\\\n+    if len(obj[k_key]) < n or len(obj[\\\\\\\"v_blocks\\\\\\\"]) < n:\\\\n+        raise ValueError(\\\\n+            f\\\\\\\"Requested {n} blocks, cache has K={len(obj[k_key])}, \\\\\\\"\\\\n+            f\\\\\\\"V={len(obj['v_blocks'])}\\\\\\\")\\\\n+    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\\\\n+    v = torch.stack([x.contiguous() for x in obj[\\\\\\\"v_blocks\\\\\\\"][:n]])\\\\n+    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\\\\n+    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\\\\n+    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\\\\n+\\\\n+\\\\n+def _samples(fn, warmup: int, iterations: int) -> list[float]:\\\\n+    for _ in range(warmup):\\\\n+        fn()\\\\n+    torch.cuda.synchronize()\\\\n+    values = []\\\\n+    for _ in range(iterations):\\\\n+        begin = torch.cuda.Event(enable_timing=True)\\\\n+        end = torch.cuda.Event(enable_timing=True)\\\\n+        begin.record()\\\\n+        fn()\\\\n+        end.record()\\\\n+        end.synchronize()\\\\n+        values.append(begin.elapsed_time(end))\\\\n+    return values\\\\n+\\\\n+\\\\n+def _stats(values: list[float]) -> tuple[float, float, float]:\\\\n+    ordered = sorted(values)\\\\n+    return (ordered[0], statistics.median(ordered),\\\\n+            ordered[int(0.95 * (len(ordered) - 1))])\\\\n+\\\\n+\\\\n+def _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\\\\n+    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\\\\n+\\\\n+\\\\n+def _codec(name: str):\\\\n+    if name == \\\\\\\"p4flat\\\\\\\":\\\\n+        from tiered_serve.compression.core import P4FlatCompressor\\\\n+        return P4FlatCompressor(torch.cuda.current_stream())\\\\n+    if name == \\\\\\\"chunk_delta3\\\\\\\":\\\\n+        from tiered_serve.compression.core import ChunkDelta3Compressor\\\\n+        return ChunkDelta3Compressor(torch.cuda.current_stream())\\\\n+    raise ValueError(f\\\\\\\"unknown codec: {name}\\\\\\\")\\\\n+\\\\n+\\\\n+def _bench(\\\\n+    name: str,\\\\n+    host_k: torch