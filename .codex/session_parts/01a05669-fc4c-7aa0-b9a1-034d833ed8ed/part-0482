       f\"layer={layer_id}\")\n                slot = high_water\n                high_water += 1\n            new_slots.append(slot)\n\n        new_slots_array = np.asarray(new_slots, dtype=np.int64)\n        slot_table[bid_arr[new_mask]] = new_slots_array\n        result = previous.copy()\n        result[new_mask] = new_slots_array\n        for block_id, slot in zip(new_block_ids, new_slots):\n            slot_blocks[slot] = block_id\n        self._kv_active_count[layer_id] = high_water\n        self._invalidate_decode_plan(layer_id)\n        return np.ascontiguousarray(result, dtype=np.int64)\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        self._invalidate_decode_plan(layer_id)\n        free_set = self._kv_free_slots[layer_id]\n        high_water = self._kv_active_count[layer_id]\n        if slot == high_water - 1:\n            high_water -= 1\n            while high_water - 1 in free_set:\n                free_set.discard(high_water - 1)\n                high_water -= 1\n            self._kv_active_count[layer_id] = high_water\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get(\"buffer_ids\", ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64))\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_table = self._kv_slot_np.get(layer_id)\n                if slot_table is None or not 0 <= block_id < slot_table.size:\n                    return\n                slot = int(slot_table[bloc