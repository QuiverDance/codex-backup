d_val[i] = exc_val[order[i]];\n        }\n        group_offsets.push_back(0);\n        uint32_t cur_m = (uint32_t)(sorted_idx[0] / (uint32_t)K);\n        group_m.push_back(cur_m);\n        for (size_t i = 1; i < sorted_idx.size(); ++i) {\n            uint32_t mi = (uint32_t)(sorted_idx[i] / (uint32_t)K);\n            if (mi != cur_m) {\n                group_offsets.push_back((uint32_t)i);\n                group_m.push_back(mi);\n                cur_m = mi;\n            }\n        }\n        group_offsets.push_back((uint32_t)sorted_idx.size());\n    }\n    int64_t num_groups = (int64_t)group_m.size();\n\n    /* Stage host buffers onto CUDA. uint32 → int32 storage, uint16 →\n     * int16; kernels reinterpret_cast<uint32_t*> off data_ptr(). Keeping\n     * natural widths means the GPU compress path produces identical\n     * dtype layouts so the frozen_split staging dtype scan is uniform. */\n    auto i8_opts  = torch::TensorOptions().dtype(at::kByte).device(torch::kCUDA);\n    auto i32_opts = torch::TensorOptions().dtype(at::kInt).device(torch::kCUDA);\n    auto i16_opts = torch::TensorOptions().dtype(at::kShort).device(torch::kCUDA);\n\n    auto make_byte_buf = [&](const void* src, int64_t bytes) {\n       