s cudaHostRegister'd\n    (PORTABLE|MAPPED) and a device pointer is obtained via\n    cudaHostGetDevicePointer, so a kernel dereferences it straight from Grace\n    LPDDR over the C2C link.  ``to_ats`` D2H-copies a CUDA tensor into the pool\n    and returns a DHA CUDA-view over the LPDDR device pointer.\n    \"\"\"\n\n    _ALIGN = 256\n\n    def __init__(self, pool_bytes, hugepage_dir, lpddr_node=0):\n        self.pool_bytes = int(pool_bytes)\n        self.hugepage_dir = hugepage_dir\n        self.lpddr_node = int(lpddr_node)\n        self._off = 0\n        self._host_ptr = 0\n        self._dev_ptr = 0\n        self.backend = None\n        self._mm = None\n        self._path = None\n        self._numa = None\n        self._numa_ptr = 0\n        self._hp_err = None\n        cr = ctypes.CDLL(\"libcudart.so\")\n        cr.cudaHostRegister.argtypes = [ctypes.c_void_p, ctypes.c_size_t,\n                                        ctypes.c_uint]\n        cr.cudaHostRegister.restype = ctypes.c_int\n        cr.cudaHostUnregister.argtypes = [ctypes.c_void_p]\n        cr.cudaHostUnregister.restype = ctypes.c_int\n        cr.cudaHostGetDevicePointer.argtypes = [\n            ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_uint]\n        cr.cudaHostGetDevicePointer.restype = ctypes.c_int\n        self._cr = cr\n\n    def _register(self, host_ptr, nbytes):\n        rc = self._cr.cudaHostRegister(ctypes.c_void_p(host_ptr), nbytes,\n                                       0x01 | 0x02)  # PORTABLE | MAPPED\n        if rc != 0:\n            raise RuntimeError(f\"cudaHostRegister failed rc={rc}\")\n        dev = ctypes.c_void_p()\n        rc = self._cr.cudaHostGetDevicePointer(\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06be1-18a5-78a2-b543-38190b7d0bd3","create_time":1788516447.8266232}}}
