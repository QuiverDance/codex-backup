t loads DietGPU and allocates\n        # an ANS workspace we don't need); initialise the shared state directly.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\n        # the compute stream — used as a plain attribute, no per-call resolution.\n        self._kv_decode_on_compute = os.getenv(\n            \"TIERED_SERVE_KV_DECODE_ON_COMPUTE\", \"0\") == \"1\"\n        # KV-load stream separation: run the compressed-blob H2D on the\n        # dedicated load_kv_stream (wired by the loader) instead of\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\n        # pipelines with layer L's decode.  load_kv_stream is gated on\n        # \"QKV weights loaded\" by the graph wrapper, so the blob H2D starts\n        # when the single copy engine is free of weight H2D — otherwise it\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\n        # loader wires one (it aliases it to load_weight_stream), and falls back\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\n        # wired (e.g. a standalone compressor with no loader).\n        self.load_kv_stream = None   # wired by the loader after construction\n        self._dec_blob_ring_idx = 0\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Set by the loader from time_breakdown.  When False, the decode skips\n        # the breakdown-only event records (_kv_h2d_begin) — the per-