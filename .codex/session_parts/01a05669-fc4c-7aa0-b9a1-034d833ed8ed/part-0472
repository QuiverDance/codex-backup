ements\")\n\n\ndef compressed_block_bytes(backend: str, elements: int) -> Optional[int]:\n    \"\"\"Return the persistent host-pool bytes for one K or V block.\n\n    ``None`` means that the backend has no fixed-size persistent pool model.\n    This module deliberately avoids importing CUDA extensions so vLLM can use\n    it during memory planning.\n    \"\"\"\n    backend = backend.lower()\n    if backend == \"zipserv\":\n        rows, columns = _zipserv_dims(elements)\n        sign_mantissa = rows * columns\n        compressed_full = rows * columns * 2\n        bitmap = (rows // 8) * (columns // 8) * 8\n        tile_offsets_median = (rows // 16) * (columns // 64) * 2 * 4\n        tile_offsets_global = (\n            ((rows // 64) * (columns // 64) + 1) * 2 * 4)\n        return (sign_mantissa + compressed_full + 3 * bitmap\n                + tile_offsets_median + tile_offsets_global)\n    if backend in _P4_LAYOUTS:\n        raw_bytes = elements * 2\n        return ((raw_bytes + 127) // 128) * 128 + 9\n    if backend == \"chunk_delta3\":\n        if elements <= 0 or elements % 4096:\n            raise ValueError(\n                \"ChunkDelta3 KV block size must be a positive multiple of 4096\")\n        tiles = elements // 4096\n        entry_capacity = chunk_delta3_exception_capacity()\n        offset = (tiles * 1536 + elements\n                  + tiles * (256 // chunk_delta3_base_rows()))\n        offset = ((offset + 3) // 4) * 4 + (tiles + 1) * 4\n        offset = ((offset + 7) // 8) * 8 + (entry_capacity // 3) * 8\n        offset = ((offset + 3) // 4) * 4 + 4\n        return ((offset + 127) // 128) * 128\n    return None\n\"\"\"ChunkDelta3 backend for persistent offloaded KV blocks.\n\nThe weight codec stores a variable number of Packed20 exceptions.  KV slots\nuse a fixed, configurable exception capacity so every block has a stable host\nrow and batched H2D/D2H remains possible.  A true count is retained per slot;\ncapacity overflow is detected before the block is published.\n\"\"\"\nfrom __future__ import annotations\n\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nfrom typing import Any, Dict, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    _HAS_CHUNK_DELTA3,\n    _cd3_ext,\n)\n\n\nlogger = logging.getLogger(__name__)\n\n\ndef _align_up(value: int, alignment: int) -> int:\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Choose a compact 64-aligned 2-D view for one KV block.\"\"\"\n    if numel <= 0 or numel % 4096:\n        raise ValueError(\n            f\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\")\n    root = int(numel ** 0.5)\n    for k in range((root // 64) * 64, 63, -64):\n        if numel % k == 0 and (numel // k) % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\n    \"\"\"Persistent CD3 KV storage and batched GPU decode implementation.\"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"decompress_chunk_delta3_batched_blob_pair_stream\"):\n            raise RuntimeError(\n                \"ChunkDelta3 requires the stream-aware batched decoder\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Two-stream event/ring overhead dominates very small copies.  Select\n        # the pipelined path only once there is enough work to hide; the value\n        # is deliberately exposed as a hardware-tuning knob.\n        self._kv_split_min_blocks = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BLOCKS\", \"256\")))\n        self._kv_pipeline_chunk_blocks = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_PIPELINE_CHUNK_BLOCKS\", \"0\")))\n        self._kv_pipeline_min_blocks = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_PIPELINE_MIN_BLOCKS\", \"1536\")))\n        self._dec_blob_ring_idx = 0\n        self._gpu_decomp_pool_ring = []\n        self._dec_blob_consumed = []\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._blob_stride = 0\n        self._blob_layout = {}\n        self._max_n_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n        self._identity_slots_gpu = None\n        self._decode_generation = {}\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        self._pipeline_decode_plans = {}\n        self._secondary_fallback_possible = {}\n        # The loader computes one canonical active KV set per forward and then\n        # passes the same Python list to every layer.  Compare that set once at\n        # the step boundary instead of running np.array_equal in every layer's\n        # decompress_batch call.  The held list reference makes the identity\n        # check generation-safe (CPython cannot recycle its id while held).\n        self._prepared_active_list = None\n        self._prepared_active_candidates = None\n        self._prepared_active_version = 0\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\n\n        result = compressed_block_bytes(\"chunk_delta3\", block_elements)\n        assert result is not None\n        return result\n\n    def _build_blob_layout(self) -> None:\n        layout = {}\n        offset = 0\n        for name, width, dtype, alignment in (\n            (\"codes\", self._code_bytes, torch.uint8, 1),\n            (\"sign_mantissa\", self._block_numel, torch.uint8, 1),\n            (\"thread_bases\", self._base_bytes, torch.uint8, 1),\n            (\"tile_exception_offsets\", self._tiles_per_block + 1,\n             torch.int32, 4),\n            (\"entries20x3\", self._packed_capacity, torch.int64, 8),\n            (\"num_exceptions\", 1, torch.int32, 4),\n        ):\n            offset = _align_up(offset, alignment)\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\n            layout[name] = (offset, nbytes, width, dtype)\n            offset += nbytes\n        self._blob_stride = _align_up(offset, 128)\n        self._blob_layout = layout\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            # A configured serving allocator has already