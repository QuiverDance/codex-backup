         pool[name] = view[:, 0] if name == \"num_exceptions\" else view\n            assert pool[name].shape == specs[name][0]\n        return pool\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        del max_gpu_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        from tiered_serve.kv_codec_spec import (\n            chunk_delta3_base_rows,\n            chunk_delta3_exception_capacity,\n        )\n        entry_capacity = chunk_delta3_exception_capacity()\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * (256 // chunk_delta3_base_rows())\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._build_blob_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        # The loader wires load_kv_stream after construction.  Keep two HBM\n        # staging slots so H2D(L+1) can fill one while decode(L) reads the\n        # other.  This is the same general producer/consumer scheme used by\n        # P4Flat; standalone compressors simply stay on slot zero.\n        self._gpu_decomp_pool_ring = [\n            self._gpu_decomp_pool,\n            {\n                \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n                \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            },\n        ]\n        self._dec_blob_ring_idx = 0\n        self._dec_blob_consumed = [torch.cuda.Event(), torch.cuda.Event()]\n        for event in self._dec_blob_consumed:\n            event.record()\n        self._identity_slots_gpu = torch.arange(\n            max_gpu_decomp_blocks + 1, dtype=torch.int32, device=\"cuda\")\n        self._decode_generation = {layer: 0 for layer in range(n_layers)}\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        self._pipeline_decode_plans = {}\n        self._secondary_fallback_possible = {\n            layer: False for layer in range(n_layers)}\n        self._prepared_active_list = None\n        self._prepared_active_candidates = None\n        self._prepared_active_version = 0\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n8674e7b Revert \"Optimize compressed KV serving dispatch\"\n72573f7 Optimize compressed KV serving dispatch\n21ca903 Add ChunkDelta3 KV offload support\n21ca903c (QuiverDance       2026-09-02 22:56:36 +0900  1) \"\"\"Lightweight KV codec capabilities used before compressors are constructed.\"\"\"\n21ca903c (QuiverDance       2026-09-02 22:56:36 +0900  2) \n21ca903c (QuiverDance       2026-09-02 22:56:36 +0900  3) from __future_