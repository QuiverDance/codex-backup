erve-edit/tiered_serve/compression/core/chunk_delta3.py\":{\"type\":\"add\",\"content\":\"\\\"\\\"\\\"Lossless BF16 ChunkDelta3 compressor.\\n\\nChunkDelta3 stores the sign and mantissa byte verbatim.  Each thread covers a\\n16-value row chunk inside a 64x64 tile, stores one 8-bit exponent base, and\\nencodes exponent deltas in three bits.  Values outside the local 3-bit range\\nare restored from a packed 17-bit exception stream, making the codec bit exact.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport logging\\nfrom typing import Dict, Optional\\n\\nimport torch\\n\\nfrom tiered_serve.compressor_base import TensorCompressor\\n\\n\\nlogger = logging.getLogger(\\\"vllm\\\")\\n\\ntry:\\n    from tiered_serve.cpp_exts import tp3_cd3_ext as _cd3_ext\\n    _HAS_CHUNK_DELTA3 = True\\nexcept Exception as _error:\\n    logger.warning(\\n        \\\"ChunkDelta3Compressor disabled: failed to load tp3_cd3_ext \\\"\\n        \\\"(%s: %s)\\\", type(_error).__name__, _error)\\n    _cd3_ext = None\\n    _HAS_CHUNK_DELTA3 = False\\n\\n\\nclass CompressedChunkDelta3Tensor:\\n    \\\"\\\"\\\"Python staging adapter around the native compressed CD3 struct.\\\"\\\"\\\"\\n\\n    _BUFFER_ATTRS = (\\n        \\\"codes\\\",\\n        \\\"sign_mantissa\\\",\\n        \\\"thread_bases\\\",\\n        \\\"tile_exception_offsets\\\",\\n        \\\"warp_prefixes\\\",\\n        \\\"entries17\\\",\\n    )\\n    _BUFFER_ATTR_D_PAIRS = tuple(\\n        (attr, f\\\"_d_{attr}\\\") for attr in _BUFFER_ATTRS)\\n\\n    def __init__(self, c_struct):\\n        self._c = c_struct\\n        self.output_tensor: Optional[torch.Tensor] = None\\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\\n        self._host_slab: Optional[torch.Tensor] = None\\n        self._device_slab: Optional[torch.Tensor] = None\\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\\n        self._copy_slab = False\\n  