ietgpu_kv_compressor import DietGPUKVCompressor\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    _HAS_CHUNK_DELTA3,\n    _cd3_ext,\n)\n\n\nlogger = logging.getLogger(__name__)\n\n\ndef _align_up(value: int, alignment: int) -> int:\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Choose a compact 64-aligned 2-D view for one KV block.\"\"\"\n    if numel <= 0 or numel % 4096:\n        raise ValueError(\n            f\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\")\n    root = int(numel ** 0.5)\n    for k in range((root // 64) * 64, 63, -64):\n        if numel % k == 0 and (numel // k) % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass ChunkDelta3KVCompressor(DietGPUKVCompressor):\n    \"\"\"KV-only CD3 codec with batched GPU encode/decode kernels.\"\"\"\n\n    _USES_GPU_COMPRESS = True\n\n    _FIELDS = (\n        \"codes\", \"sign_mantissa\", \"thread_bases\",\n        \"tile_exception_offsets\", \"entries20x3\", \"num_exceptions\",\n    )\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"compress_chunk_delta3_batched\"):\n            raise RuntimeError(\n                \"ChunkDelta3KVCompressor requires the batched tp3_cd3_ext\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_active_count = {}\n        self._kv_free_heap = {}\n        self._kv_free_slots = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._gpu_comp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._bf16_decomp_out = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._blob_stride = 0\n        self._blob_layout = {}\n        self._max_n_blocks = 0\n        self._max_gpu_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n        self._decode_block_ids_np = None\n        self._decode_block_ids_gpu = None\n        self._decode_slots_np = {}\n        self._decode_slots_gpu = {}\n        self._identity_slots_gpu = None\n        self._batch_ext = None\n        self._decode_generation = {}\n        self._decode_filter_active = None\n        self._decode_filter_limit = None\n        self._decode_filter_candidates = None\n        self._decode_filtered = {}\n        self._decode_plans = {}\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        tiles = block_elements // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n        offset = tiles * 1536 + block_elements + tiles * 256\n        offset = _align_up(offset, 4) + (tiles + 1) * 4\n        offset = _align_up(offset, 8) + (entry_capacity // 3) * 8\n        offset = _align_up(offset, 4) + 4\n        return _align_up(offset, 128)\n\n    def _build_blob_layout(self) -> None:\n        layout = {}\n        offset = 0\n        for name, width, dtype, alignment in (\n            (\"codes\", self._code_bytes, torch.uint8, 1),\n            (\"sign_mantissa\", self._block_numel, torch.uint8, 1),\n            (\"thread_bases\", self._base_bytes, torch.uint8, 1),\n            (\"tile_exception_offsets\", self._tiles_per_block + 1,\n             torch.int32, 4),\n            (\"entries20x3\", self._packed_capacity, torch.int64, 8),\n            (\"num_exceptions\", 1, torch.int32, 4),\n        ):\n            offset = _align_up(offset, alignment)\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\n            layout[name] = (offset, nbytes, width, dtype)\n            offset += nbytes\n        self._blob_stride = _align_up(offset, 128)\n        self._blob_layout = layout\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            for page_type in (\"kv\", \"weight\"):\n                try:\n                    return huge_page_allocator.allocate(\n                        (numel,), (1,), dtype, page_type=page_type).view(shape)\n                except (MemoryError, ValueError):\n                    pass\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _pool(self, rows: int, device: str, huge_page_allocator=None,\n              blob_backed: bool = True) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        if not blob_backed and device == \"cuda\":\n            return {\n                name: torch.empty(shape, dtype=dtype, device=\"cuda\")\n                for name, (shape, dtype) in specs.items()\n            }\n        if not blob_backed:\n            return {\n                name: self._alloc_host_tensor(\n                    shape, dtype, huge_page_allocator)\n                for name, (shape, dtype) in specs.items()\n            }\n\n        if device == \"cuda\":\n            blob = torch.empty(\n                (rows, self._blob_stride), dtype=torch.uint8, device=\"cuda\")\n        else:\n            blob = self._alloc_host_tensor(\n                (rows, self._blob_stride), torch.uint8,\n                huge_page_allocator)\n        pool = {\"blob\": blob}\n        for name, (offset, nbytes, width, dtype) in self._blob_layout.items():\n            view = blob[:, offset:offset + nbytes]\n            if dtype != torch.uint8:\n                view = view.view(dtype)\n            pool[name] = view[:, 0] if name == \"num_exceptions\" else view\n            assert pool[name].shape == specs[name][0]\n        return pool\n\n    def warmup_kv_buffers(\n        self,\n        block_shape: tuple,\n        max_n_blocks: int,\n        n_layers: int = 1,\n        max_gpu_blocks: int = 0,\n        max_gpu_decomp_blocks: int = 0,\n        huge_page_allocator=None,\n        pre_allocated_host_pools=None,\n    ) -> None:\n        del pre_allocated_host_pools  # P4Flat/ZipServ layouts are incompatible.\n        if max_gpu_blocks <= 0:\n            max_gpu_blocks = max_n_blocks\n        if max_gpu_decomp_blocks <= 0:\n            max_gpu_decomp_blocks = max_n_blocks\n        block_numel = 1\n        for size in block_shape:\n            block_numel *= int(size)\n        M_b, K_b = _factor_64(block_numel)\n        tiles = block_numel // 4096\n        entry_capacity = int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"768\"))\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\n\n        self._block_shape = tuple(block_shape)\n        self._block_numel = block_numel\n        self._M_b, self._K_b = M_b, K_b\n        self._tiles_per_block = tiles\n        self._code_bytes = tiles * 1536\n        self._base_bytes = tiles * 256\n        self._entry_capacity = entry_capacity\n        self._packed_capacity = entry_capacity // 3\n        self._build_blob_layout()\n        self._max_n_blocks = max_n_blocks\n        self._max_gpu_blocks = max_gpu_blocks\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\n        self._n_layers = n_layers\n\n        host_n = max_n_blocks + 1\n        self._host_pools = {\n            layer: {\n                \"k\": self._pool(host_n, \"cpu\", huge_page_allocator),\n                \"v\": self._pool(host_n, \"cpu\", huge_page_allocator),\n            }\n            for layer in range(n_layers)\n        }\n        self._gpu_comp_pool = (\n            {\n                \"k\": self._pool(\n                    max_gpu_blocks + 1, \"cuda\", blob_backed=False),\n                \"v\": self._pool(\n                    max_gpu_blocks + 1, \"cuda\", blob_backed=False),\n            }\n            if self._USES_GPU_COMPRESS else {}\n        )\n        self._gpu_decomp_pool = {\n            \"k\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n            \"v\": self._pool(max_gpu_decomp_blocks + 1, \"cuda\"),\n        }\n        self._identity_slots_gpu = torch.arange(\n            max_gpu_decomp_blocks + 1, dtype=torch.int32, device=\"cuda\")\n        self._decode_block_ids_np = None\n        self._decode_block_ids_gpu = None\n        self._decode_slots_np = {}\n        self._decode_slots_gpu = {}\n        self._decode_generation = {layer: 0 for layer in range(n_layers)}\n        self._decode_filter_active = None\n        self._decode_filter_limit = None\n        self._decode_filter_candidates = None\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        # The indexed decoder writes directly into the destination KV cache.\n        # Keeping a full raw-BF16 intermediate used to add another read+write\n        # of every decoded byte and a separate advanced-indexing kernel.\n        self._bf16_decomp_out = {}\n        self._persistent_valid = {\n            layer: bytearray(host_n) for layer in range(n_layers)}\n        self._kv_slot = {\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\n            for layer in range(n_layers)}\n        self._kv_slot_np = {\n            layer: self._kv_slot[layer].numpy()\n            for layer in range(n_layers)}\n        self._kv_slot_block = {\n            layer: [-1] * host_n for layer in range(n_layers)}\n        self._kv_active_count = {\n            layer: 0 for layer in range(n_layers)}\n        self._kv_free_heap = {layer: [] for layer in range(n_layers)}\n        self._kv_free_slots = {layer: set() for layer in range(n_layers)}\n        self._kv_dec_h2d = [\n            torch.cuda.Event(enable_timing=True, external=True)\n            for _ in range(n_layers)\n        ]\n        # Give CPU workers a completed initial event for layers that have not\n        # loaded persistent compressed data yet.\n        with torch.cuda.stream(self.batch_decomp_stream):\n            for event in self._kv_dec_h2d:\n                event.record(self.batch_decomp_stream)\n        self._kv_pools_ready = True\n\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\n        logger.info(\n            \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d slot=%d bytes (%.3fx raw allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _move_host_slot(self, layer_id: int,\n                        dst_slot: int, src_slot: int) -> None:\n        if dst_slot == src_slot:\n            return\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool[\"blob\"][dst_slot].copy_(pool[\"blob\"][src_slot])\n\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\n        self._decode_generation[layer_id] = (\n            self._decode_generation.get(layer_id, 0) + 1)\n        self._decode_filtered.pop(layer_id, None)\n        self._decode_plans.pop(layer_id, None)\n\n    def _assign_kv_slot(self, layer_id: int, bid: int) -> int:\n        slot_table = self._kv_slot_np[layer_id]\n        previous = int(slot_table[bid])\n        if previous >= 0:\n            return previous\n        heap = self._kv_free_heap[layer_id]\n        free_set = self._kv_free_slots[layer_id]\n        slot = -1\n        while heap:\n            candidate = heapq.heappop(heap)\n            if candidate in free_set:\n                free_set.discard(candidate)\n                slot = candidate\n                break\n        if slot < 0:\n            slot = self._kv_active_count[layer_id]\n            if slot >= len(self._kv_slot_block[layer_id]):\n                raise RuntimeError(\n                    f\"ChunkDelta3 KV persistent slot pool full for \"\n                    f\"layer={layer_id}\")\n            self._kv_active_count[layer_id] = slot + 1\n        slot_table[bid] = slot\n        self._kv_slot_block[layer_id][slot] = bid\n        self._invalidate_decode_plan(layer_id)\n        return slot\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    @staticmethod\n    def _slot_runs(slots: list[int]):\n        \"\"\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\"\"\"\n        if not slots:\n            return\n        row_begin = 0\n        slot_begin = slots[0]\n        previous = slot_begin\n        for row in range(1, len(slots)):\n            slot = slots[row]\n            if slot != previous + 1:\n                yield row_begin, row, slot_begin\n                row_begin = row\n                slot_begin = slot\n            previous = slot\n        yield row_begin, len(slots), slot_begin\n\n    def _batch_h2d(self, destinations: list[torch.Tensor],\n                   sources: list[torch.Tensor]) -> None:\n        \"\"\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\"\"\"\n        if not destinations:\n            return\n        if len(destinations) == 1:\n            destinations[0].copy_(sources[0], non_blocking=True)\n            return\n        extension = self._batch_ext\n        if extension is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as extension\n            except Exception:\n                extension = False\n            self._batch_ext = extension\n        if extension and hasattr(extension, \"batch_memcpy\"):\n            extension.batch_memcpy(\n                destinations, sources,\n                torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(\n                destinations, sources, non_blocking=True)\n\n    def _launch_compress(self, layer_id: int, block_ids: list,\n                         gpu_k: torch.Tensor, gpu_v: torch.Tensor) -> None:\n        num_primary = gpu_k.shape[0]\n        block_ids = [int(bid) for bid in block_ids\n                     if 0 <= int(bid) < num_primary]\n        n = len(block_ids)\n        if n == 0:\n            return\n        if n > self._max_gpu_blocks:\n            raise RuntimeError(\n                f\"ChunkDelta3 KV encode batch {n} exceeds \"\n                f\"capacity {self._max_gpu_blocks}\")\n        slots = [self._assign_kv_slot(layer_id, bid) for bid in block_ids]\n        bid_gpu = torch.as_tensor(\n            block_ids, dtype=torch.long, device=gpu_k.device)\n\n        with torch.cuda.stream(self.comp_stream):\n            k_blocks = gpu_k[bid_gpu].reshape(\n                n, self._M_b, self._K_b).contiguous()\n            v_blocks = gpu_v[bid_gpu].reshape(\n                n, self._M_b, self._K_b).contiguous()\n            for kv, blocks in ((\"k\", k_blocks), (\"v\", v_blocks)):\n                pool = self._gpu_comp_pool[kv]\n                _cd3_ext.compress_chunk_delta3_batched(\n                    blocks,\n                    pool[\"codes\"][:n],\n                    pool[\"sign_mantissa\"][:n],\n                    pool[\"thread_bases\"][:n],\n                    pool[\"tile_exception_offsets\"][:n],\n                    pool[\"entries20x3\"][:n],\n                    pool[\"num_exceptions\"][:n],\n                )\n                host = self._host_pools[layer_id][kv]\n                # Physical slots are persistent and may contain holes.  Keep\n                # the copies asynchronous on comp_stream; the event below\n                # gates publication and later slot reuse.\n                for row_begin, row_end, slot_begin in self._slot_runs(slots):\n                    length = row_end - row_beg