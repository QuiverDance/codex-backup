t) -> Optional[int]:\\n    \\\"\\\"\\\"Return the persistent host-pool bytes for one K or V block.\\n\\n    ``None`` means that the backend has no fixed-size persistent pool model.\\n    This module deliberately avoids importing CUDA extensions so vLLM can use\\n    it during memory planning.\\n    \\\"\\\"\\\"\\n    backend = backend.lower()\\n    if backend == \\\"zipserv\\\":\\n        rows, columns = _zipserv_dims(elements)\\n        sign_mantissa = rows * columns\\n        compressed_full = rows * columns * 2\\n        bitmap = (rows // 8) * (columns // 8) * 8\\n        tile_offsets_median = (rows // 16) * (columns // 64) * 2 * 4\\n        tile_offsets_global = (\\n            ((rows // 64) * (columns // 64) + 1) * 2 * 4)\\n        return (sign_mantissa + compressed_full + 3 * bitmap\\n                + tile_offsets_median + tile_offsets_global)\\n    if backend in _P4_LAYOUTS:\\n        raw_bytes = elements * 2\\n        return ((raw_bytes + 127) // 128) * 128 + 9\\n    if backend == \\\"chunk_delta3\\\":\\n        if elements <= 0 or elements % 4096:\\n            raise ValueError(\\n                \\\"ChunkDelta3 KV block size must be a positive multiple of 4096\\\")\\n        tiles = elements // 4096\\n        entry_capacity = int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\", \\\"768\\\"))\\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\\n        offset = tiles * 1536 + elements + tiles * 256\\n        offset = ((offset + 3) // 4) * 4 + (tiles + 1) * 4\\n        offset = ((offset + 7) // 8) * 8 + (entry_capacity // 3) * 8\\n        offset = ((offset + 3) // 4) * 4 + 4\\n        return ((offset + 127) // 128) * 128\\n    return None\\n\\\"\\\"\\\"P4Flat KV cache compressor.\\n\\nDrop-in ``kv_compressor`` for ``DualMemoryLoader`` that uses the BF16 P4-flat\\ncodec (per-64x64-tile 16-entry exponent palette + 4-bit code + raw\\nsign|mantissa byte, with out-of-palette exponents kept as an exception list).\\nSelected with ``--kv-comp p4flat`` (``TIERED_SERVE_KV_COMP_BACKEND=p4flat``).\\n\\nLike :class:`DietGPUKVCompressor` the base :class:`P4FlatKVCompressor` is a\\nGPU-kernel backend (no C++ worker threads): ``compress_batch_async`` launches\\nthe compress + D2H on an internal CUDA stream and ``wait_compress_async``\\nsynchronises it.  It serves the ``gpu_direct`` KV producer mode (the default\\nfor ``--kv-comp p4flat``).  The ``cpu_after_raw_swap`` producer is served by\\nthe :class:`P4FlatCPUKVCompressor` subclass below (CPU worker-pool encode);\\nboth share the same GPU decode kernel and on-host storage layout.\\n\\nIt subclasses :class:`DietGPUKVCompressor` purely to reuse the codec-agnostic\\npersistent-slot bookkeeping (``_assign_kv_slot`` / ``_free_kv_slot`` /\\n``has_*`` / ``free_persistent_block`` / ``decompress_batch`` chunking).  The\\nstorage layout and the codec are completely different and overridden below.\\n\\nStorage layout (per layer, per K and V), one dense pool of variable-length\\ncompressed blobs indexed by physical slot:\\n  - ``blob``       : pinned [host_n, max_comp_size] uint8.  Each row holds a\\n    serialised compressed block ``[headers | codes | sm | codec |\\n    exc_idx | exc_val]`` (or, on raw fallback, the raw BF16 bytes).\\n  - ``total_size`` : pinned [host_n] int32 — used bytes of the blob row.\\n  - ``exc_cnt``    : pinned [host_n] int32 — number of exceptions.\\n  - ``is_raw``     : pinned [host_n] uint8 — 0 compressed, 1 raw BF16 stored\\n    in-row, 2 raw BF16 retained only in secondary KV (tight-stride overflow).\\n\\nA KV block of shape ``block_shape`` is flattened to ``block_numel`` BF16\\nelements and reshaped to a 2-D ``[M_b, K_b]`` matrix with both dims multiples\\nof 64 (p4flat requires this).  The reshape is a contiguous view, so the codec\\nstays bit-exact; the (M_b, K_b) factoring only affects the compression ratio.\\n``block_numel`` must therefore be a multiple of 64*64 = 4096.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport ctypes\\nimport ctypes\\nimport glob\\nimport heapq\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time\\nfrom concurrent.futures import ThreadPoolExecutor\\nfrom typing import Any, Dict, List, Tuple\\n\\nimport numpy as np\\nimport torch\\n\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\\n\\nlogger = logging.getLogger(\\\"vllm\\\")  # configured/flushed handler (was __name__\\n# = \\\"tiered_serve.*\\\" -> root, which suppressed INFO and split ERROR to stderr,\\n# hiding [kv-decode]/MAPPING-DESYNC diagnostics from the server log file)\\n_ENV_KV_DETAILED_NVTX = (\\n    os.getenv(\\\"TIERED_SERVE_KV_DETAILED_NVTX\\\", \\\"0\\\") == \\\"1\\\")\\n\\ntry:\\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\\n    _HAS_P4FLAT = True\\nexcept Exception as _e:  # pragma: no cover - extension build/runtime issue\\n    logger.warning(\\n        \\\"P4FlatKVCompressor disabled: failed to load zipserv_p4flat_ext \\\"\\n        \\\"(%s: %s)\\\", type(_e).__name__, _e)\\n    _p4f_ext = None\\n    _HAS_P4FLAT = False\\n\\ndef _align(n: int, a: int) -> int:\\n    return (n + a - 1) // a * a\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Factor ``numel`` into ``(M_b, K_b)`` with both multiples of 64,\\n    chosen as close to square as possible.  Raises if ``numel`` is not a\\n    multiple of 4096 (= 64*64).\\\"\\\"\\\"\\n    if numel % 4096 != 0:\\n        raise ValueError(\\n            f\\\"P4Flat KV: block_numel={numel} is not a multiple of 4096 \\\"\\n            f\\\"(64*64); cannot factor into 64-aligned (M_b, K_b). Padding is \\\"\\n            f\\\"not supported.\\\")\\n    best = None\\n    m = 64\\n    while m * m <= numel:\\n        if numel % m == 0:\\n            k = numel // m\\n            if k % 64 == 0:\\n                best = (m, k)  # largest square-ish m wins as loop advances\\n        m += 64\\n    if best is None:\\n        # Fall back to the most rectangular valid split (M_b=64).\\n        if (numel // 64) % 64 == 0:\\n            best = (64, numel // 64)\\n        else:\\n            raise ValueError(\\n                f\\\"P4Flat KV: cannot factor block_numel={numel} into \\\"\\n                f\\\"64-aligned (M_b, K_b).\\\")\\n    return best\\n\\n\\ndef _factor_64_kv(numel: int, occupancy: bool) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Factor a KV block into ``(M_b, K_b)``.\\n\\n    Occupancy mode (``TIERED_SERVE_KV_P4FLAT_OCCUPANCY``) lays the block out\\n    *tall* — ``K_b=64`` so ``M_b=numel//64`` — instead of square.  The KV\\n    block is ``[block_size, H, D]`` flattened row-major, so the token axis is\\n    the outermost (slowest) dim: written tokens occupy a contiguous *prefix*\\n    of rows and the unwritten tail is a contiguous suffix of all-zero rows.\\n    A tall layout maximises the number of independent 64-row palette-tile\\n    bands (``M_b//64``), making the all-zero suffix fall on whole skippable\\n    tile bands at the finest possible granularity (``4096//H/D`` tokens/band).\\n    A square factoring would instead pack ~8 tokens into one 64-row band (or\\n    a single band for small blocks, ``M_b==64``), defeating partial-block\\n    skipping.  Tile count — and thus palette/header overhead — is identical\\n    either way (``numel//4096`` tiles), so the ratio impact is marginal.\\n\\n    Non-occupancy mode keeps the historical square factoring (bit-exact with\\n    the validated path).\\\"\\\"\\\"\\n    if not occupancy:\\n        return _factor_64(numel)\\n    if numel % 4096 != 0:\\n        raise ValueError(\\n            f\\\"P4Flat KV: block_numel={numel} is not a multiple of 4096; \\\"\\n            f\\\"cannot use occupancy-aware tall layout.\\\")\\n    return (numel // 64, 64)\\n\\n\\nclass P4FlatKVCompressor(DietGPUKVCompressor):\\n    \\\"\\\"\\\"BF16 P4-flat KV cache compressor (GPU-kernel backend).\\\"\\\"\\\"\\n\\n    # The GPU-encode path uses the batched-compress pinned staging; the\\n    # CPU-encode subclass overrides this to skip allocating it.\\n    _USES_GPU_COMPRESS = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_P4FLAT:\\n            raise RuntimeError(\\n                \\\"P4FlatKVCompressor requires tiered-serve's zipserv_p4flat_ext \\\"\\n                \\\"extension to build successfully.\\\")\\n        # Bypass DietGPUKVCompressor.__init__ (it loads DietGPU and allocates\\n        # an ANS workspace we don't need); initialise the shared state directly.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\\n        # the compute stream — used as a plain attribute, no per-call resolution.\\n        self._kv_decode_on_compute = os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_ON_COMPUTE\\\", \\\"0\\\") == \\\"1\\\"\\n        # KV-load stream separation: run the compressed-blob H2D on the\\n        # dedicated load_kv_stream (wired by the loader) instead of\\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\\n        # pipelines with layer L's decode.  load_kv_stream is gated on\\n        # \\\"QKV weights loaded\\\" by the graph wrapper, so the blob H2D starts\\n        # when the single copy engine is free of weight H2D — otherwise it\\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\\n        # loader wires one (it aliases it to load_weight_stream), and falls back\\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\\n        # wired (e.g. a standalone compressor with no loader).\\n        self.load_kv_stream = None   # wired by the loader after construction\\n        self._dec_blob_ring_idx = 0\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Set by the loader from time_breakdown.  When False, the decode skips\\n        # the breakdown-only event records (_kv_h2d_begin) — the per-step CUDA\\n        # event record() was ~12% of forward-thread CPU in profiling.\\n        self._tb = False\\n\\n        # Per-decode metadata (slots / valid_rows / exc_cnt / is_raw) H2D.\\n        # Default = async ring of pinned buffers, event-gated so a lagging\\n        # in-flight H2D is never overwritten on reuse — the exact failure that\\n        # forced the old synchronous ``torch.stack(...).cuda()`` (pageable ->\\n        # ~1 ms/graph CPU dispatch that starves the GPU).  Set\\n        # TIERED_SERVE_KV_META_SYNC=1 to restore that legacy sync path.\\n        self._meta_sync_fallback = os.getenv(\\n            \\\"TIERED_SERVE_KV_META_SYNC\\\", \\\"0\\\") == \\\"1\\\"\\n        self._meta_ring_n = 0\\n        self._meta_ring_pi = None   # list[pinned int32 [5*cap]]  (cs,vrk,eck,vrv,ecv)\\n        self._meta_ring_pu = None   # list[pinned uint8 [2*cap]]  (is_raw k,v)\\n        self._meta_ring_b = None    # list[pinned int64 [cap]]    (block_ids)\\n        self._meta_ring_ev = None   # list[cuda.Event] gating buffer reuse\\n        self._meta_ring_idx = 0\\n\\n        # Reused, codec-agnostic persistent-slot bookkeeping (see base class).\\n        self._compressed_kv: Dict[int, Any] = {}\\n        self._persistent_valid: Dict[int, bytearray] = {}\\n        self._kv_slot: Dict[int, torch.Tensor] = {}\\n        self._kv_slot_np: Dict[int, Any] = {}   # numpy authority (shared mem)\\n        self._kv_slot_block: Dict[int, List[int]] = {}\\n        # P4Flat free-list slot management (overrides the base dense\\n        # swap-with-last).  ``_kv_active_count`` is repurposed as the staging\\n        # HIGH-WATER-MARK (max-assigned-slot + 1 = the [0:hwm] extent the decode\\n        # H2D copies); freed slots go to a per-layer min-heap and are refilled\\n        # lowest-first so hwm — hence the decode over-copy — stays tight, and\\n        # top-of-range frees shrink hwm.  This makes ``free`` metadata-only (no\\n        # _move_host_slot host memcpy, no decode-stream sync) — see\\n        # ``_free_kv_slot`` and ``_kv_free_metadata_only`` below.\\n        self._kv_active_count: Dict[int, int] = {}   # == hwm per layer\\n        self._kv_free_heap: Dict[int, list] = {}     # min-heap of free slots\\n        self._kv_free_slots: Dict[int, set] = {}     # membership (lazy-delete)\\n        # Signals dual_memory_loader.kv.free_slot that this compressor's free path touches no\\n        # GPU/host pool memory, so the pre-free decode-stream sync is unneeded.\\n        self._kv_free_metadata_only = True\\n        # Decode staging H2D: copy only the occupied (live) slot RUNS in\\n        # [0:hwm), batching them into one cudaMemcpyBatchAsync so holes\\n        # (freed-not-yet-realloc'd slots — possible whenever frees outpace\\n        # allocs, e.g. a drain phase) aren't transferred.  ``free_set`` is the\\n        # sparse bitarray of holes, so runs come from a membership split (no\\n        # sort).  Below this hole count a single [0:hwm] copy is cheaper than\\n        # the scan, so we skip it (env-tunable; 0 = always batch).\\n        self._decode_hole_threshold = int(os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_HOLE_THRESHOLD\\\", \\\"32\\\"))\\n        self._batch_ext = None      # cached zipserv_ext for batch_memcpy\\n        # Decode-arg CPU-dispatch trims (the per-layer Python/torch op count is\\n        # what stalls before_replay — ~20 dispatches x n_layers showed up as\\n        # ~2 ms of forward-thread CPU before the blob batchmemcpy in nsys):\\n        #  - grid sizing uses STATIC caps (M_b / exc_cap) instead of four\\n        #    per-layer pinned .max() reductions; the per-block device arrays\\n        #    still bound each block's work in-kernel.\\n        #    TIERED_SERVE_KV_DECODE_VALIDATE=1 restores the exact maxes\\n        #    (tighter grids + full corrupt-meta detection) for debugging.\\n        #  - the block-id vector is identical for every layer of a step, so\\n        #    its CPU tensor + device upload are cached step-level\\n        #    (content-keyed) and reused by the remaining n_layers-1 decodes.\\n        self._decode_validate = os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_VALIDATE\\\", \\\"0\\\") == \\\"1\\\"\\n        self._cbids_cache_np = None    # np.int64 id vector (content key)\\n        self._cbids_cache_t = None     # CPU int64 tensor wrapping it\\n        self._cbids_cache_gpu = None   # device int64 tensor (uploaded once)\\n        # Step-level cache for wait_compress_async: the buffer_ids list is\\n        # identical across all layers of a step, so np.asarray + torch.from_numpy\\n        # only need to run once per step (not ×80 layers).  Keyed on object\\n        # identity (is) with a held reference, matching the decompress_batch\\n        # cache pattern.\\n        self._wc_bids_np = None        # np.int64 array\\n        self._wc_bids_t = None         # torch int64 tensor wrapping _wc_bids_np\\n        self._wc_bids_list = None      # source list (identity key)\\n        self._wc_vtm = None            # cached valid_tm array for occupancy grouping\\n        self._pending_compress: Dict[int, Dict[str, Any]] = {}\\n        self._secondary_fallback_possible: Dict[int, bool] = {}\\n\\n        self._kv_pools_ready = False\\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\\n\\n        # Occupancy-aware KV compression (TIERED_SERVE_KV_P4FLAT_OCCUPANCY):\\n        # only encode/decode the 64-row tile bands covering written tokens of\\n        # each (partial) block.  ``_block_valid_tokens`` is a per-step\\n        # {buffer_id -> valid_token_count} map published by the forward hook;\\n        # ``None`` (default / metadata unavailable) means \\\"treat every block as\\n        # full\\\", which reduces to the historical full-block behaviour.\\n        self._occupancy_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_P4FLAT_OCCUPANCY\\\", \\\"0\\\") == \\\"1\\\")\\n        self._block_valid_tokens = None\\n        self._block_size = 0   # tokens per KV block (block_shape[0])\\n        self._hd = 0           # per-token elements = num_kv_heads * head_dim\\n\\n        # P4Flat geometry / sizes (filled by warmup_kv_buffers).\\n        self._block_shape: Tuple[int, ...] = ()\\n        self._block_numel = 0\\n        self._raw_bytes = 0\\n        self._M_b = 0\\n        self._K_b = 0\\n        self._hb = 0   # headers bytes\\n        self._cb = 0   # codes bytes\\n        self._smb = 0  # sign_mantissa bytes\\n        self._cdb = 0  # subtile_codec bytes\\n        self._fixed_bytes = 0\\n        self._idx_dtype = torch.int32\\n        self._val_dtype = torch.int16\\n        self._idx_es = 4\\n        self._val_es = 2\\n        self._row_major_sm = 0\\n        self._max_comp_size = 0\\n        self._max_n_blocks = 0\\n        self._max_gpu_blocks = 0\\n        self._max_gpu_decomp_blocks = 0\\n        self._n_layers = 0\\n        # Pinned staging for batched compress D2H (lazy-allocated on the first\\n        # GPU compress; the CPU-encode subclass never touches it).\\n        self._cmp_stage = None\\n        # GPU batched compress (compress_batched): writes per-block blobs on the\\n        # GPU in one kernel (no host scatter).  Lazy GPU staging + scratch.\\n        self._use_gpu_batched = False\\n        self._gpu_cmp = None\\n        self._max_exc_pb = 0\\n        self._iota_l = None      # cached arange (long) for batched-compress ids\\n        self._iota_i = None      # cached arange (int32) for staging slots\\n        # Host-side blob assembly is a strided scatter that numpy runs single-\\n        # threaded (~7 ms for 4096 blocks, dwarfing the 1.1 ms GPU compress).\\n        # numpy releases the GIL during the copy, so a small thread pool\\n        # parallelises it (~3.5x).  Lazy-created; only used above a block-count\\n        # threshold where the dispatch cost is amortised.\\n        self._asm_pool = None\\n        self._asm_nthreads = min(16, max(1, (os.cpu_count() or 8)))\\n        self._asm_thread_thresh = 256\\n\\n    @staticmethod\\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\\n        \\\"\\\"\\\"Worst-case host-pool bytes for one K (or one V) block.\\n\\n        Mirrors the per-block ``blob`` row stride reserved by\\n        ``warmup_kv_buffers`` plus the per-block meta (``total_size`` /\\n        ``exc_cnt`` / ``is_raw``).  A P4Flat block is stored either\\n        compressed or — on raw fallback — as a full BF16 block, so the slot\\n        is always reserved at ``align(raw_bytes, 128)`` (i.e. ~1x raw).\\n\\n        Use this from external callers (e.g. vLLM budget calculation) to\\n        size the persistent compressed host pool without instantiating a\\n        compressor.\\n\\n        Returns the byte size for ONE side (K or V).  Multiply by 2 for K+V.\\n        \\\"\\\"\\\"\\n        raw_bytes = block_elements * 2          # BF16\\n        blob = _align(raw_bytes, 128)           # blob row stride\\n        meta = 4 + 4 + 1                         # total_size + exc_cnt + is_raw\\n        return blob + meta\\n\\n    # ------------------------------------------------------------------\\n    #  Warmup\\n    # ------------------------------------------------------------------\\n\\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\\n        \\\"\\\"\\\"Return (headers, codes, sm, subtile_codec) byte sizes and set the\\n        exception dtypes + sm layout flag.  GPU path: probe-compress a zero\\n        block to read the exact buffer sizes the codec produces.\\\"\\\"\\\"\\n        probe = torch.zeros(M_b, K_b, dtype=torch.bfloat16, device=\\\"cuda\\\")\\n        pc = _p4f_ext.compress(probe)\\n        hb = int(pc.headers.numel())            # uint8 -> 1 byte/elem\\n        cb = int(pc.codes.numel())\\n        smb = int(pc.sign_mantissa.numel())\\n        cdb = int(pc.subtile_codec.numel())\\n        self._idx_dtype = pc.exc_indices.dtype\\n        self._val_dtype = pc.exc_values.dtype\\n        self._idx_es = pc.exc_indices.element_size()\\n        self._val_es = pc.exc_values.element_size()\\n        # Layout flag for sign_mantissa (GPU compress produces tile-blocked\\n        # sm); the decode struct must report the same so the kernel reads it\\n        # back correctly.\\n        self._row_major_sm = int(getattr(pc, \\\"row_major_sm\\\", 0))\\n        del probe, pc\\n        torch.cuda.empty_cache()\\n        return hb, cb, smb, cdb\\n\\n    def warmup_kv_buffers(\\n        self,\\n        block_shape: tuple,\\n        max_n_blocks: int,\\n        n_layers: int = 1,\\n        max_gpu_blocks: int = 0,\\n        max_gpu_decomp_blocks: int = 0,\\n        huge_page_allocator=None,\\n        pre_allocated_host_pools=None,\\n    ) -> None:\\n        if max_gpu_blocks <= 0:\\n            max_gpu_blocks = max_n_blocks\\n        if max_gpu_decomp_blocks <= 0:\\n            max_gpu_decomp_blocks = max_gpu_blocks\\n\\n        block_numel = 1\\n        for s in block_shape:\\n            block_numel *= s\\n        M_b, K_b = _factor_64_kv(block_numel, self._occupancy_enabled)\\n        # Token geometry for occupancy-aware band skipping.  block_shape is\\n        # [block_size, num_kv_heads, head_dim]; the token axis is outermost.\\n        self._block_size = int(block_shape[0]) if len(block_shape) else 0\\n        self._hd = block_numel // self._block_size if self._block_size else 0\\n\\n        # Learn exact codec buffer sizes / dtypes (GPU probe-compress here;\\n        # the CPU variant overrides this with an analytic computation so\\n        # warmup touches no GPU).\\n        hb, cb, smb, cdb = self._probe_sizes(M_b, K_b)\\n\\n        if smb != block_numel:\\n            raise RuntimeError(\\n                f\\\"P4Flat KV: sign_mantissa bytes ({smb}) != block_numel \\\"\\n                f\\\"({block_numel}); unexpected codec layout.\\\")\\n        if hb % 4 or cb % 4 or smb % 4 or cdb % 4:\\n            raise RuntimeError(\\n                f\\\"P4Flat KV: fixed buffer sizes not 4-aligned \\\"\\n                f\\\"(h={hb} c={cb} sm={smb} cd={cdb}); exception views would be \\\"\\n                f\\\"misaligned.\\\")\\n\\n        fixed_bytes = hb + cb + smb + cdb\\n        raw_bytes = block_numel * 2  # BF16\\n        # The blob row must hold either the compressed payload or a raw block.\\n        # A compressed payload is only kept when it is <= raw_bytes (else we\\n        # fall back to raw), so the stored size never exceeds raw_bytes.\\n        max_comp_size = _align(raw_bytes, 128)\\n        # Dense packing: use a 25,600-byte row by default so the contiguous\\n        # decode H2D transfers compressed-size rows instead of the 32KB raw\\n        # worst case.  A blob that does not fit the tight row is published as\\n        # ``is_raw=2`` and restored from the authoritative raw secondary KV;\\n        # neither producer writes past the row.  Clamp the default/override to\\n        # [fixed_bytes, max_comp_size] and align to 128 bytes so other block\\n        # geometries remain valid.  An explicit value <= 0 selects the old\\n        # raw-safe stride.  Legacy TIERED_SERVE_KV_BLOB_SLACK=<bytes>\\n        # (= fixed_bytes+slack) is still honored when no stride is specified.\\n        _stride_env = os.getenv(\\\"TIERED_SERVE_KV_BLOB_STRIDE\\\")\\n        _slack = int(os.getenv(\\\"TIERED_SERVE_KV_BLOB_SLACK\\\", \\\"-1\\\"))\\n        if _stride_env is not None:\\n            _req = int(_stride_env)\\n            blob_stride = (max_comp_size if _req <= 0\\n                           else min(max_comp_size, _align(max(_req, fixed_bytes), 128)))\\n        elif _slack >= 0:\\n            blob_stride = min(max_comp_size, _align(fixed_bytes + _slack, 128))\\n        else:\\n            blob_stride = min(\\n                max_comp_size, _align(max(25600, fixed_bytes), 128))\\n        logger.info(\\n            \\\"[BlobStrideDbg] computed blob_stride=%d (fixed=%d max_comp=%d \\\"\\n            \\\"stride_env=%s slack=%d pre_alloc_pools=%s)\\\",\\n            blob_stride, fixed_bytes, max_comp_size, _stride_env, _slack,\\n            pre_allocated_host_pools is not None)\\n\\n        self._block_shape = tuple(block_shape)\\n        self._block_numel = block_numel\\n        self._raw_bytes = raw_bytes\\n        self._M_b, self._K_b = M_b, K_b\\n        self._hb, self._cb, self._smb, self._cdb = hb, cb, smb, cdb\\n        self._fixed_bytes = fixed_bytes\\n        self._max_comp_size = max_comp_size\\n        self._blob_stride = blob_stride\\n        self._max_n_blocks = max_n_blocks\\n        self._max_gpu_blocks = max_gpu_blocks\\n        self._max_gpu_decomp_blocks = max_gpu_decomp_blocks\\n        self._n_layers = n_layers\\n\\n        # Eagerly allocate the batched-compress pinned staging (GPU-encode path\\n        # only).  Done here — outside any CUDA stream context — so the hot path\\n        # never allocates pinned memory mid-stream.  _store_stack D2Hs each\\n        # codec buffer-type for a whole block-stack into these, then assembles\\n        # the per-slot blob rows host-side.\\n        if self._USES_GPU_COMPRESS:\\n            self._cmp_stage = {\\n                'h':  torch.empty(max_gpu_blocks * hb,  dtype=torch.uint8).pin_memory(),\\n                'c':  torch.empty(max_gpu_blocks * cb,  dtype=torch.uint8).pin_memory(),\\n                'sm': torch.empty(max_gpu_blocks * smb, dtype=torch.uint8).pin_memory(),\\n                'cd': torch.empty(max_gpu_blocks * cdb, dtype=torch.uint8).pin_memory(),\\n                # Device exception count, D2H'd with the payload (compress_lean\\n                # returns it on-device so the call stays sync-free).\\n                'ec': torch.empty(1, dtype=torch.int32).pin_memory(),\\n            }\\n\\n        host_n = max_n_blocks + 1  # +1 safety row\\n\\n        def _alloc_host_pool() -> Dict[str, torch.Tensor]:\\n            specs = {\\n                'blob':       ((host_n, blob_stride), torch.uint8),\\n                'total_size': ((host_n,),               torch.int32),\\n                'exc_cnt':    ((host_n,),               torch.int32),\\n                'is_raw':     ((host_n,),               torch.uint8),\\n                # Occupancy: number of decoded rows for this slot (== M_b for a\\n\",\"stderr\":\"\",\"aggregated_output\":\"\\\"\\\"\\\"Lightweight KV codec capabilities used before compressors are constructed.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nfrom typing import Optional\\n\\n\\n_P4_LAYOUTS = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"ublb_flat\\\", \\\"ublb_tbe\\\"})\\n_FULL_BLOCK_ONLY = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"chunk_delta3\\\"})\\n\\n\\ndef supports_full_block_only(backend: str) -> bool:\\n    return backend.lower() in _FULL_BLOCK_ONLY\\n\\n\\ndef _zipserv_dims(elements: int) -> tuple[int, int]:\\n    for columns in (128, 64, 256, 192, 320):\\n        if elements % columns == 0 and (elements // columns) % 64 == 0:\\n            return elements // columns, columns\\n    raise ValueError(\\n        f\\\"Cannot find 64-aligned ZipServ dimensions for {elements} elements\\\")\\n\\n\\ndef compressed_block_bytes(backend: str, elements: int) -> Optional[int]:\\n    \\\"\\\"\\\"Return the persistent host-pool bytes for one K or V block.\\n\\n    ``None`` means that the backend has no fixed-size persistent pool model.\\n    This module deliberately avoids importing CUDA extensions so vLLM can use\\n    it during memory planning.\\n    \\\"\\\"\\\"\\n    backend = backend.lower()\\n    if backend == \\\"zipserv\\\":\\n        rows, columns = _zipserv_dims(elements)\\n        sign_mantissa = rows * columns\\n        compressed_full = rows * columns * 2\\n        bitmap = (rows // 8) * (columns // 8) * 8\\n        tile_offsets_median = (rows // 16) * (columns // 64) * 2 * 4\\n        tile_offsets_global = (\\n            ((rows // 64) * (columns // 64) + 1) * 2 * 4)\\n        return (sign_mantissa + compressed_full + 3 * bitmap\\n                + tile_offsets_median + tile_offsets_global)\\n    if backend in _P4_LAYOUTS:\\n        raw_bytes = elements * 2\\n        return ((raw_bytes + 127) // 128) * 128 + 9\\n    if backend == \\\"chunk_delta3\\\":\\n        if elements <= 0 or elements % 4096:\\n            raise ValueError(\\n                \\\"ChunkDelta3 KV block size must be a positive multiple of 4096\\\")\\n        tiles = elements // 4096\\n        entry_capacity = int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\", \\\"768\\\"))\\n        entry_capacity = ((max(3, entry_capacity) + 2) // 3) * 3\\n        offset = tiles * 1536 + elements + tiles * 256\\n        offset = ((offset + 3) // 4) * 4 + (tiles + 1) * 4\\n        offset = ((offset + 7) // 8) * 8 + (entry_capacity // 3) * 8\\n        offset = ((offset + 3) // 4) * 4 + 4\\n        return ((offset + 127) // 128) * 128\\n    return None\\n\\\"\\\"\\\"P4Flat KV cache compressor.\\n\\nDrop-in ``kv_compressor`` for ``DualMemoryLoader`` that uses the BF16 P4-flat\\ncodec (per-64x64-tile 16-entry exponent palette + 4-bit code + raw\\nsign|mantissa byte, with out-of-palette exponents kept as an exception list).\\nSelected with ``--kv-comp p4flat`` (``TIERED_SERVE_KV_COMP_BACKEND=p4flat``).\\n\\nLike :class:`DietGPUKVCompressor` the base :class:`P4FlatKVCompressor` is a\\nGPU-kernel backend (no C++ worker threads): ``compress_batch_async`` launches\\nthe compress + D2H on an internal CUDA stream and ``wait_compress_async``\\nsynchronises it.  It serves the ``gpu_direct`` KV producer mode (the default\\nfor ``--kv-comp p4flat``).  The ``cpu_after_raw_swap`` producer is served by\\nthe :class:`P4FlatCPUKVCompressor` subclass below (CPU worker-pool encode);\\nboth share the same GPU decode kernel and on-host storage layout.\\n\\nIt subclasses :class:`DietGPUKVCompressor` purely to reuse the codec-agnostic\\npersistent-slot bookkeeping (``_assign_kv_slot`` / ``_free_kv_slot`` /\\n``has_*`` / ``free_persistent_block`` / ``decompress_batch`` chunking).  The\\nstorage layout and the codec are completely different and overridden below.\\n\\nStorage layout (per layer, per K and V), one dense pool of variable-length\\ncompressed blobs indexed by physical slot:\\n  - ``blob``       : pinned [host_n, max_comp_size] uint8.  Each row holds a\\n    serialised compressed block ``[headers | codes | sm | codec |\\n    exc_idx | exc_val]`` (or, on raw fallback, the raw BF16 bytes).\\n  - ``total_size`` : pinned [host_n] int32 — used bytes of the blob row.\\n  - ``exc_cnt``    : pinned [host_n] int32 — number of exceptions.\\n  - ``is_raw``     : pinned [host_n] uint8 — 0 compressed, 1 raw BF16 stored\\n    in-row, 2 raw BF16 retained only in secondary KV (tight-stride overflow).\\n\\nA KV block of shape ``block_shape`` is flattened to ``block_numel`` BF16\\nelements and reshaped to a 2-D ``[M_b, K_b]`` matrix with both dims multiples\\nof 64 (p4flat requires this).  The reshape is a contiguous view, so the codec\\nstays bit-exact; the (M_b, K_b) factoring only affects the compression ratio.\\n``block_numel`` must therefore be a multiple of 64*64 = 4096.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport ctypes\\nimport ctypes\\nimport glob\\nimport heapq\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time\\nfrom concurrent.futures import ThreadPoolExecutor\\nfrom typing import Any, Dict, List, Tuple\\n\\nimport numpy as np\\nimport torch\\n\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\\n\\nlogger = logging.getLogger(\\\"vllm\\\")  # configured/flushed handler (was __name__\\n# = \\\"tiered_serve.*\\\" -> root, which suppressed INFO and split ERROR to stderr,\\n# hiding [kv-decode]/MAPPING-DESYNC diagnostics from the server log file)\\n_ENV_KV_DETAILED_NVTX = (\\n    os.getenv(\\\"TIERED_SERVE_KV_DETAILED_NVTX\\\", \\\"0\\\") == \\\"1\\\")\\n\\ntry:\\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\\n    _HAS_P4FLAT = True\\nexcept Exception as _e:  # pragma: no cover - extension build/runtime issue\\n    logger.warning(\\n        \\\"P4FlatKVCompressor disabled: failed to load zipserv_p4flat_ext \\\"\\n        \\\"(%s: %s)\\\", type(_e).__name__, _e)\\n    _p4f_ext = None\\n    _HAS_P4FLAT = False\\n\\ndef _align(n: int, a: int) -> int:\\n    return (n + a - 1) // a * a\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Factor ``numel`` into ``(M_b, K_b)`` with both multiples of 64,\\n    chosen as close to square as possible.  Raises if ``numel`` is not a\\n    multiple of 4096 (= 64*64).\\\"\\\"\\\"\\n    if numel % 4096 != 0:\\n        raise ValueError(\\n            f\\\"P4Flat KV: block_numel={numel} is not a multiple of 4096 \\\"\\n            f\\\"(64*64); cannot factor into 64-aligned (M_b, K_b). Padding is \\\"\\n            f\\\"not supported.\\\")\\n    best = None\\n    m = 64\\n    while m * m <= numel:\\n        if numel % m == 0:\\n            k = numel // m\\n            if k % 64 == 0:\\n                best = (m, k)  # largest square-ish m wins as loop advances\\n        m += 64\\n    if best is None:\\n        # Fall back to the most rectangular valid split (M_b=64).\\n        if (numel // 64) % 64 == 0:\\n            best = (64, numel // 64)\\n        else:\\n            raise ValueError(\\n                f\\\"P4Flat KV: cannot factor block_numel={numel} into \\\"\\n                f\\\"64-aligned (M_b, K_b).\\\")\\n    return best\\n\\n\\ndef _factor_64_kv(numel: int, occupancy: bool) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Factor a KV block into ``(M_b, K_b)``.\\n\\n    Occupancy mode (``TIERED_SERVE_KV_P4FLAT_OCCUPANCY``) lays the block out\\n    *tall* — ``K_b=64`` so ``M_b=numel//64`` — instead of square.  The KV\\n    block is ``[block_size, H, D]`` flattened row-major, so the token axis is\\n    the outermost (slowest) dim: written tokens occupy a contiguous *prefix*\\n    of rows and the unwritten tail is a contiguous suffix of all-zero rows.\\n    A tall layout maximises the number of independent 64-row palette-tile\\n    bands (``M_b//64``), making the all-zero suffix fall on whole skippable\\n    tile bands at the finest possible granularity (``4096//H/D`` tokens/band).\\n    A square factoring would instead pack ~8 tokens into one 64-row band (or\\n    a single band for small blocks, ``M_b==64``), defeating partial-block\\n    skipping.  Tile count — and thus palette/header overhead — is identical\\n    either way (``numel//4096`` tiles), so the ratio impact is marginal.\\n\\n    Non-occupancy mode keeps the historical square factoring (bit-exact with\\n    the validated path).\\\"\\\"\\\"\\n    if not occupancy:\\n        return _factor_64(numel)\\n    if numel % 4096 != 0:\\n        raise ValueError(\\n            f\\\"P4Flat KV: block_numel={numel} is not a multiple of 4096; \\\"\\n            f\\\"cannot use occupancy-aware tall layout.\\\")\\n    return (numel // 64, 64)\\n\\n\\nclass P4FlatKVCompressor(DietGPUKVCompressor):\\n    \\\"\\\"\\\"BF16 P4-flat KV cache compressor (GPU-kernel backend).\\\"\\\"\\\"\\n\\n    # The GPU-encode path uses the batched-compress pinned staging; the\\n    # CPU-encode subclass overrides this to skip allocating it.\\n    _USES_GPU_COMPRESS = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_P4FLAT:\\n            raise RuntimeError(\\n                \\\"P4FlatKVCompressor requires tiered-serve's zipserv_p4flat_ext \\\"\\n                \\\"extension to build successfully.\\\")\\n        # Bypass DietGPUKVCompressor.__init__ (it loads DietGPU and allocates\\n        # an ANS workspace we don't need); initialise the shared state directly.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        # One-stream KV decode: when set, the loader points batch_decomp_stream\\n        # at exec_stream so the decode (H2D + kernels + breakdown events) runs on\\n        # the compute stream — used as a plain attribute, no per-call resolution.\\n        self._kv_decode_on_compute = os.getenv(\\n            \\\"TIERED_SERVE_KV_DECODE_ON_COMPUTE\\\", \\\"0\\\") == \\\"1\\\"\\n        # KV-load stream separation: run the compressed-blob H2D on the\\n        # dedicated load_kv_stream (wired by the loader) instead of\\n        # batch_decomp_stream, with a 2-slot blob ring so layer L+1's H2D\\n        # pipelines with layer L's decode.  load_kv_stream is gated on\\n        # \\\"QKV weights loaded\\\" by the graph wrapper, so the blob H2D starts\\n        # when the single copy engine is free of weight H2D — otherwise it\\n        # queues behind weight and the _kv_h2d_begin.._kv_dec_h2d interval\\n        # absorbs that wait (small-batch KVLoad read ~= WLoad).  Decode\\n        # kernels stay on batch_decomp_stream (what exec's attn barrier waits\\n        # on).  Always on — the blob H2D runs on load_kv_stream whenever the\\n        # loader wires one (it aliases it to load_weight_stream), and falls back\\n        # to the single-stream fused H2D+decode only when no load_kv_stream is\\n        # wired (e.g. a standalone compressor with no loader).\\n        self.load_kv_stream = None   # wired by the loader after construction\\n        self._dec_blob_ring_idx = 0\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Set by the loader from time_breakdown.  When False, the decode skips\\n        # the breakdown-only event records (_kv_h2d_begin) — the per-step CUDA\\n        # event record() was ~12% of forward-thread CPU in profiling.\\n        self._tb = False\\n\\n        # Per-decode metadata (slots / valid_rows / exc_cnt / is_raw) H2D.\\n        # Default = async ring of pinned buffers, event-gated so a lagging\\n        # in-flight H2D is never overwritten on reuse — the exact failure that\\n        # forced the old synchronous ``torch.stack(...).cuda()`` (pageable ->\\n        # ~1 ms/graph CPU dispatch that starves the GPU).  Set\\n        # TIERED_SERVE_KV_META_SYNC=1 to restore that legacy sync path.\\n        self._meta_sync_fallback = os.getenv(\\n            \\\"TIERED_SERVE_KV_META_SYNC\\\", \\\"0\\\") == \\\"1\\\"\\n        self._meta_ring_n = 0\\n        self._meta_ring_pi = None   # list[pinned int32 [5*cap]]  (cs,vrk,eck,vrv,ecv)\\n        self._meta_ring_pu = None   # list[pinned uint8 [2*cap]]  (is_raw k,v)\\n        self._meta_ring_b = None    # list[pinned int64 [cap]]    (block_ids)\\n        self._meta_ring_ev = None   # list[cuda.Event] gating buffer reuse\\n        self._meta_ring_idx = 0\\n\\n        # Reused, codec-agnostic persistent-slot bookkeeping (see base class).\\n        self._compressed_kv: Dict[int, Any] = {}\\n        self._persistent_valid: Dict[int, bytearray] = {}\\n        self._kv_slot: Dict[int, torch.Tensor] = {}\\n        self._kv_slot_np: Dict[int, Any] = {}   # numpy authority (shared mem)\\n        self._kv_slot_block: Dict[int, List[int]] = {}\\n        # P4Flat free-list slot management (overrides the base dense\\n        # swap-with-last).  ``_kv_active_count`` is repurposed as the staging\\n        # HIGH-WATER-MARK (max-assigned-slot + 1