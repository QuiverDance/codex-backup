   # _dec_blob_consumed[slot] already gates its reuse — so the split's\\n        # cross-stream meta H2D can't overwrite a buffer the decode is reading.\\n        gi_dev = self._gi_dev_ring[slot]\\n        gu_dev = self._gu_dev_ring[slot]\\n        gb_dev = self._gb_dev_ring[slot]\\n        if self._tb:\\n            # KVLoad bracket begin; on the H2D stream (matches _kv_dec_h2d).\\n            self._kv_h2d_begin[layer_id].record(h2d_stream)\\n        if candidates_t is None:\\n            candidates_t = self._decomp_filter_cand_t\\n        n = _p4f_ext.decode_layer_prep(\\n            candidates_t, self._valid_t[layer_id], slot_tbl,\\n            kvr, kec, kir, vvr, vec, vir,\\n            self._meta_ring_pi[ri], self._meta_ring_pu[ri],\\n            self._meta_ring_b[ri],\\n            gi_dev, gu_dev, gb_dev,\\n            hkb, hvb, blob_k, blob_v,\\n            active, self._meta_ring_ev[ri].cuda_event,\\n            self._kv_dec_h2d[layer_id].cuda_event,\\n            h2d_stream.cuda_stream)\\n        if n <= 0:\\n            if n < 0:\\n                logger.error(\\n                    \\\"[kv-decode] SKIP L%d: valid/slot desync (a valid block \\\"\\n                    \\\"maps outside [0:%d)) -- would CUDA-IMA\\\", layer_id,\\n                    active)\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # kv_decode_cpp\\n            return\\n        gi, gu = gi_dev, gu_dev\\n        blob_stride, block_numel, K_b, M_b, exc_cap = self._fast_const\\n        rsm = self._row_major_sm\\n        # Decode kernels on batch_decomp_stream (raw handle = no per-call\\n        # `with torch.cuda.stream(...)` context).  When the H2D ran on\\n        # load_kv_stream (split), gate the kernels on _kv_dec_h2d so they read\\n        # the blob/meta only after the cross-stream H2D lands.\\n        sh = self.batch_decomp_stream.cuda_stream\\n        if _split:\\n            self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\\n        if self._tb:\\n            self._kv_decode_begin[layer_id].record(\\n                self.batch_decomp_stream)\\n        # Fused K+V decode: pass the BASE gi/gu/gb tensors + n (the codec slices\\n        # by pointer offset in C++) instead of building gi[0:n]/gi[2n:3n]/gu[0:n]\\n        # ... CUDA views + 2 reshapes per launch — that view churn was the CPU\\n        # gap between the blob H2D and the decode kernel.\\n        self._invoke_decode_layer(\\n            blob_k, blob_v, blob_stride,\\n            gi, gu, gb_dev, n, k_cache, v_cache,\\n            block_numel, K_b, M_b, exc_cap, rsm, sh)\\n        if _split and self._dec_blob_consumed is not None:\\n            # decode done reading this load buffer -> the next layer's H2D may\\n            # reuse the slot (the consumed wait above gates it).\\n            self._dec_blob_consumed[slot].record(self.batch_decomp_stream)\\n        if _ENV_KV_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_pop()  # kv_decode_cpp\\n\\n    def _stage_blob_h2d(self, layer_id: int, lo: int, hi: int,\\n                        host_k: dict, host_v: dict,\\n                        gk: torch.Tensor = None, gv: torch.Tensor = None) -> None:\\n        \\\"\\\"\\\"H2D the compressed K/V blobs for slot range [lo:hi) into the decode\\n        staging buffer, preserving slot positions (gpu row = slot - lo).\\n\\n        ``gk``/``gv`` select the target staging blob (a blob-ring slot for the\\n\",\"stderr\":\"\",\"aggregated_output\":\"\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\\n                _cd3_ext, \\\"decompress_chunk_delta3_batched_blob_pair_stream\\\"):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the stream-aware batched decoder\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Two-stream event/ring overhead dominates very small copies.  Select\\n        # the pipelined path only once there is enough work to hide; the value\\n        # is deliberately exposed as a hardware-tuning knob.\\n        self._kv_split_min_blocks = max(1, int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BLOCKS\\\", \\\"256\\\")))\\n        self._dec_blob_ring_idx = 0\\n        self._gpu_decomp_pool_ring = []\\n        self._dec_blob_consumed = []\\n        self._tb = False\\n\\n        self._compressed_kv = {}\\n        self._persistent_valid = {}\\n        self._kv_slot = {}\\n        self._kv_slot_np = {}\\n        self._kv_slot_block = {}\\n        self._kv_active_count = {}\\n        self._kv_free_heap = {}\\n        self._kv_free_slots = {}\\n        self._kv_free_metadata_only = True\\n        self._pending_compress = {}\\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\\n        self._kv_pools_ready = False\\n\\n        self._block_shape = ()\\n        self._block_numel = 0\\n        self._M_b = 0\\n        self._K_b = 0\\n        self._tiles_per_block = 0\\n        self._code_bytes = 0\\n        self._base_bytes = 0\\n        self._entry_capacity = 0\\n        self._packed_capacity = 0\\n        self._blob_stride = 0\\n        self._blob_layout = {}\\n        self._max_n_blocks = 0\\n        self._max_gpu_decomp_blocks = 0\\n        self._n_layers = 0\\n        self._identity_slots_gpu = None\\n        self._decode_generation = {}\\n        self._decode_filtered = {}\\n        self._decode_plans = {}\\n        # The loader computes one canonical active KV set per forward and then\\n        # passes the same Python list to every layer.  Compare that set once at\\n        # the step boundary instead of running np.array_equal in every layer's\\n        # decompress_batch call.  The held list reference makes the identity\\n        # check generation-safe (CPython cannot recycle its id while held).\\n        self._prepared_active_list = None\\n        self._prepared_active_candidates = None\\n        self._prepared_active_version = 0\\n\\n    @staticmethod\\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\\n\\n        result = compressed_block_bytes(\\\"chunk_delta3\\\", block_elements)\\n        assert result is not None\\n        return result\\n\\n    def _build_blob_layout(self) -> None:\\n        layout = {}\\n        offset = 0\\n        for name, width, dtype, alignment in (\\n            (\\\"codes\\\", self._code_bytes, torch.uint8, 1),\\n            (\\\"sign_mantissa\\\", self._block_numel, torch.uint8, 1),\\n            (\\\"thread_bases\\\", self._base_bytes, torch.uint8, 1),\\n            (\\\"tile_exception_offsets\\\", self._tiles_per_block + 1,\\n             torch.int32, 4),\\n            (\\\"entries20x3\\\", self._packed_capacity, torch.int64, 8),\\n            (\\\"num_exceptions\\\", 1, torch.int32, 4),\\n        ):\\n            offset = _align_up(offset, alignment)\\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\\n            layout[name] = (offset, nbytes, width, dtype)\\n            offset += nbytes\\n        self._prepared_active_candidates = candidates\\n\\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= bid < table.size:\\n            return -1\\n        return int(table[bid])\\n\\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= block_id < table.size:\\n            return\\n        slot = int(table[block_id])\\n        if slot < 0:\\n            return\\n        self._invalidate_decode_plan(layer_id)\\n        table[block_id] = -1\\n        self._kv_slot_block[layer_id][slot] = -1\\n        free_set = self._kv_free_slots[layer_id]\\n        hwm = self._kv_active_count[layer_id]\\n        if slot == hwm - 1:\\n            hwm -= 1\\n            while hwm - 1 in free_set:\\n                free_set.discard(hwm - 1)\\n                hwm -= 1\\n            self._kv_active_count[layer_id] = hwm\\n        else:\\n            free_set.add(slot)\\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\\n\\n    @staticmethod\\n    def _slot_runs(slots: list[int]):\\n        \\\"\\\"\\\"Yield (row_begin, row_end, slot_begin) contiguous copy runs.\\\"\\\"\\\"\\n        if not slots:\\n            return\\n        row_begin = 0\\n        slot_begin = slots[0]\\n        previous = slot_begin\\n        for row in range(1, len(slots)):\\n            slot = slots[row]\\n            if slot != previous + 1:\\n                yield row_begin, row, slot_begin\\n                row_begin = row\\n                slot_begin = slot\\n            previous = slot\\n        yield row_begin, len(slots), slot_begin\\n\\n    def _batch_h2d(self, destinations: list[torch.Tensor],\\n                   sources: list[torch.Tensor],\\n                   stream: torch.cuda.Stream | None = None) -> None:\\n        \\\"\\\"\\\"Submit all contiguous K/V runs in one cudaMemcpyBatchAsync.\\\"\\\"\\\"\\n        if not destinations:\\n            return\\n        if len(destinations) == 1:\\n            if stream is None:\\n                destinations[0].copy_(sources[0], non_blocking=True)\\n            else:\\n                with torch.cuda.stream(stream):\\n                    destinations[0].copy_(sources[0], non_blocking=True)\\n            return\\n        from tiered_serve.cpp_exts import zipserv_ext\\n\\n        if not hasattr(zipserv_ext, \\\"batch_memcpy\\\"):\\n            raise RuntimeError(\\\"zipserv_ext.batch_memcpy is required for CD3 KV\\\")\\n        zipserv_ext.batch_memcpy(\\n            destinations, sources,\\n            (torch.cuda.current_stream().cuda_stream\\n             if stream is None else stream.cuda_stream))\\n\\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\\n                         output_buffers) -> None:\\n        \\\"\\\"\\\"Decode the active set published once at the forward boundary.\\\"\\\"\\\"\\n        k_cache, v_cache = output_buffers\\n        valid = self._persistent_valid.get(layer_id)\\n        if valid is None or len(active_block_ids) == 0:\\n            return\\n        if (active_block_ids is not self._prepared_active_list\\n                or self._prepared_active_candidates is None):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV active set was not prepared before decode\\\")\\n        candidates = self._prepared_active_candidates\\n        limit = min(int(k_cache.shape[0]), len(valid))\\n        if (candidates.size\\n                and (int(candidates[0]) < 0\\n                     or int(candida