        cache[key] = scratch\n\n        n_pad = int(scratch[\"n_pad\"])\n        if n_pad == N and x2.is_contiguous():\n            activation = x2\n        else:\n            activation = scratch[\"padded_input\"]\n            activation[:N].copy_(x2)\n\n        from tiered_serve.compression.core.ublb_tbe import _get_rs_ext\n\n        _get_rs_ext().cd3_rs_wgmma_mm(\n            comp._c.codes,\n            comp._c.sign_mantissa,\n            comp._c.thread_bases,\n            comp._c.tile_exception_offsets,\n            comp._c.entries20x3,\n            activation,\n            scratch[\"output\"],\n            scratch[\"partials\"],\n            int(scratch[\"split_k\"]),\n            M,\n            n_pad,\n            K,\n        )\n        return scratch[\"output\"][:N].reshape(*original_shape[:-1], M)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        return self._linear_apply_impl(comp, x, None, wdecomp_events)\n\n    def linear_apply_into(self, comp, x, scratch):\n        return self._linear_apply_impl(comp, x, scratch)\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if not weight.is_cuda:\n            raise RuntimeError(\"ChunkDelta3Compressor requires a CUDA tensor\")\n        if weight.shape[0] % 64 or weight.shape[1] % 64:\n            raise ValueError(\n                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n                f\"got {tuple(weight.shape)}\")\n\n        source = weight.contiguous()\n        stream = self.comp_stream or torch.cuda.current_stream(weight.device)\n        producer_stream = torch.cuda.current_stream(weight.device)\n/**\n * wgmma_lab.cu — staged fusion lab for raw / UBLB-flat WGMMA GEMM (SM90).\n *\n * One templated double-buffered WGMMA GEMM whose ONLY difference between\n * experiments is how the 64x64 A (weight) smem tile is *produced*:\n *\n *   MODE_RAW  (E1): A is dense BF16 in GMEM, loaded directly.\n *   MODE_FLAT (U4): A is UBLB-flat compressed — per-element 4-bit code into a\n *                   16-entry upper-byte palette + raw lower byte. Decoded in\n *                   the producer path (branchless, no cumsum, no exceptions).\n *\n * This isolates \"is fusion competitive?\" (Step 1: E1 vs cuBLAS) from\n * \"does decode survive in the producer path?\" (Step 2: U4 vs E1) — the kernel\n * body (B-load, WGMMA pipeline, epilogue) is byte-identical across modes.\n *\n * Convention (matches the proven zipserv fused WGMMA kernel):\n *   A = weight   [M, K] row-major,  A[m,k] = A[m*K + k]\n *   B = activate [N, K] row-major,  B[n,k] = B[n*K + k]\n *   C = output   [M, N] COLUMN-major, C[m,n] = C[m + n*M]\n *   C[m,n] = sum_k A[m,k] * B[n,k]   (i.e. C = A @ B^T)\n */\n#include <cuda_bf16.h>\n#include <cuda_runtime.h>\n#include <cstdint>\n\n#include <cutlass/bfloat16.h>\n#include <cutlass/cutlass.h>\n#include <cute/arch/mma_sm90.hpp>\n#include <cute/tensor.hpp>\n\n// Slim double-buffered smem: just the WGMMA A/B operand tiles. No decode\n// scratch — the producer writes A elements straight into the swizzled tile.\n// Shared by the raw_pipe (E1) kernel and its launch helper.\ntemplate <int TileN, int Stages>\nstruct LabSmem {\n    using SmemLayoutA = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<64>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    using SmemLayoutB = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutA>> A;\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutB>> B;\n};\n\n// ============================================================================\n// B-1: deep multi-stage cp.async pipelined RAW GEMM (E1, cuBLAS-grade attempt).\n//\n// Replaces the 2-stage synchronous producer with an S-stage cp.async ring so\n// many weight loads are in flight (the prior kernel sat at ~14% HBM because\n// only 2 stages of synchronous loads were ever outstanding). A and B are both\n// dense BF16 here, so cp.async streams them straight into the swizzled smem\n// tiles via CuTe copy atoms. Single warpgroup; relies on memory-level\n// parallelism (deep pipeline) rather than warp specialization for now.\n// ============================================================================\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void raw_pipe_kernel(\n    const __nv_bfloat16* __restrict__ A_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restrict__ C_g,\n    int M, int N, int K)\n{\n#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\n    using namespace cute;\n    constexpr int kTileM = 64, kTileK = 64;\n    using Smem = LabSmem<TileN, Stages>;\n    using SmemLayoutA = typename Smem::SmemLayoutA;\n    using SmemLayoutB = typename Smem::SmemLayoutB;\n\n    extern __shared__ __align__(128) uint8_t raw_smem[];\n    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\n    auto sA = make_tensor(make_smem_ptr(smem.A.begin()), SmemLayoutA{});\n    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), SmemLayoutB{});\n\n    const int tid     = static_cast<int>(threadIdx.x);\n    const int tile_n  = static_cast<int>(blockIdx.x);\n    const int tile_m  = static_cast<int>(blockIdx.y);\n    const int tiles_k = K >> 6;\n\n    // Global operand tensors (row-major), tiled along K.\n    auto mA = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(A_g)),\n                          make_layout(make_shape(M, K), make_stride(K, Int<1>{})));\n    auto gA = local_tile(mA, make_shape(Int<kTileM>{}, Int<kTileK>{}),\n                         make_coord(tile_m, _));          // (64,64,tiles_k)\n    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\n                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05689-f1bb-7113-b755-98c4c0fabf30","create_time":1788158465.4037673}}}
