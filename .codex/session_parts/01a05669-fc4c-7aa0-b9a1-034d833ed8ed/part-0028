\n@pytest.mark.parametrize(\"n_tokens\", [1, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n"},"started_at_ms":1788158456078,"completed_at_ms":1788158456078}}
