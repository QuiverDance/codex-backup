     if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # The experimental benchmark force-opens the threshold.  Keep production\n    # routing disabled until a serving-level crossover has been calibrated.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 0,\n        (8192, 8192): 0,\n        (57344, 8192): 0,\n        (8192, 28672): 0,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n                \"successfully\")\n        self._fused_max_n_override: Optional[int] = None\n        # Serving-level experiments can force the implemented fused path\n        # without changing the conservative production crossover table.\n        # Keeping this explicit matters because the current table is zero\n        # until end-to-end measurements justify enabling a shape by default.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and CD3 shared-memory pressure.\n        n_pad = ((N + 63) // 64) * 64\n        # CD3 blocks do more per-K-tile work than P4/U4, so their generic\n        # split-K=4 choice over-splits O/Down.  Real layer-40 A/B measurements\n        # select two splits there; QKV still benefits slightly from four.\n        if n_pad <= 64:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 2,\n                (8192, 28672): 2,\n            }.get((M, K), _u4_split_k(M, n_pad, K))\n        elif n_pad == 128:\n            split_k = {\n                (10240, 8192): 4,\n                (8192, 8192): 2,\n                (57344, 8192): 2,\n                (8192, 28672): 2,\n            }.get((M, K), 1)\n        elif n_pad in (192, 256):\n            split_k = 4 if (M, K) == (10240, 8192) else 1\n        else:\n            split_k = 1\n        output = torch.empty(\n            n_pad, M, dtype=torch.bfloat16, device=device)\n        padded_input = torch.empty(\n            n_pad, K, dtype=torch.bfloat16, device=device)\n        partials = (\n            torch.empty(\n                split_k, n_pad, M, dtype=torch.float32, device=device)\n            if split_k > 1\n            else _empty_f32(device)\n        )\n        return {\n            \"key\": (M, K, N, device.index),\n            \"n_pad\": n_pad,\n            \"split_k\": split_k,\n            \"output\": output,\n            \"padded_input\": padded_input,\n            \"partials\": partials,\n        }\n\n    def alloc_fused_scratch(\n        self,\n        K: int,\n        M: int,\n        N: int,\n        dtype: torch.dtype,\n        device: torch.device,\n    ):\n        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n                or M % 64 or K % 64 or N <= 0):\n            return None\n        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n\n    def _linear_apply_impl(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        x: torch.Tensor,\n        scratch: Optional[dict],\n        wdecomp_events=None,\n    ) -> torch.Tensor:\n        import torch.nn.functional as F\n\n\"\"\"Correctness coverage for the production ChunkDelta3 adapter.\"\"\"\nfrom __future__ import annotations\n\nimport pytest\nimport torch\nimport torch.nn.functional as F\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"ChunkDelta3 requires CUDA\")\n\n\ndef _codec():\n    from tiered_serve.compression.core.chunk_delta3 import ChunkDelta3Compressor\n    return ChunkDelta3Compressor(torch.cuda.current_stream())\n\n\ndef _all_bf16_patterns() -> torch.Tensor:\n    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    # Transpose so each 16-value CD3 chunk spans many exponents.  A plain\n    # reshape groups equal exponents and never exercises the exception stream.\n    return (bits.view(torch.bfloat16).reshape(256, 256).t().contiguous()\n            .cuda())\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_serving_fused_threshold_override(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\ndef test_frozen_split_keeps_offsets_with_sign_mantissa_in_hbm() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05689-f1bb-7113-b755-98c4c0fabf30","create_time":1788158456.131442}}}
