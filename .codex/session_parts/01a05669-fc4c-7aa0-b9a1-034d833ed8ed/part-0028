.hpp>\n#include <cute/tensor.hpp>\n\n// Slim double-buffered smem: just the WGMMA A/B operand tiles. No decode\n// scratch — the producer writes A elements straight into the swizzled tile.\n// Shared by the raw_pipe (E1) kernel and its launch helper.\ntemplate <int TileN, int Stages>\nstruct LabSmem {\n    using SmemLayoutA = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<64>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    using SmemLayoutB = decltype(\n        cute::tile_to_shape(cute::GMMA::Layout_K_SW128_Atom<cute::bfloat16_t>{},\n                            cute::make_shape(cute::Int<TileN>{}, cute::Int<64>{},\n                                             cute::Int<Stages>{})));\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutA>> A;\n    alignas(128) cute::ArrayEngine<cute::bfloat16_t,\n                                   cute::cosize_v<SmemLayoutB>> B;\n};\n\n// ============================================================================\n// B-1: deep multi-stage cp.async pipelined RAW GEMM (E1, cuBLAS-grade attempt).\n//\n// Replaces the 2-stage synchronous producer with an S-stage cp.async ring so\n// many weight loads are in flight (the prior kernel sat at ~14% HBM because\n// only 2 stages of synchronous loads were ever outstanding). A and B are both\n// dense BF16 here, so cp.async streams them straight into the swizzled smem\n// tiles via CuTe copy atoms. Single warpgroup; relies on memory-level\n// parallelism (deep pipeline) rather than warp specialization for now.\n// ============================================================================\ntemplate <int TileN, class MmaOp, int Stages>\n__global__ void raw_pipe_kernel(\n    const __nv_bfloat16* __restrict__ A_g,\n    const __nv_bfloat16* __restrict__ B_g,\n    __nv_bfloat16*       __restr