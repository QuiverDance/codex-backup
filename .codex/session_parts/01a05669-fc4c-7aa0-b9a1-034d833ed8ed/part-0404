o + e])\n        self._batch_h2d(dst, src)\n\n    def _batch_h2d(self, dst: list, src: list) -> None:\n        \"\"\"Submit a list of H2D copies as one driver call\n        (cudaMemcpyBatchAsync via zipserv_ext.batch_memcpy on the current —\n        i.e. batch_decomp — stream), falling back to ``_foreach_copy_``.\"\"\"\n        if not dst:\n            return\n        if len(dst) == 1:\n            dst[0].copy_(src[0], non_blocking=True)\n            return\n        _zs = self._batch_ext\n        if _zs is None:\n            try:\n                from tiered_serve.cpp_exts import zipserv_ext as _zs\n            except Exception:\n                _zs = False\n            self._batch_ext = _zs\n        if _zs and hasattr(_zs, \"batch_memcpy\"):\n            _zs.batch_memcpy(dst, src,\n                             torch.cuda.current_stream().cuda_stream)\n        else:\n            torch._foreach_copy_(dst, src, non_blocking=True)\n\n    def _wait_meta_ring_slot(self, ri: int) -> None:\n        \"\"\"Gate pinned meta-ring reuse without a host wait on the common path.\"\"\"\n        ev = self._meta_ring_ev[ri]\n        if not ev.query():\n            ev.synchronize()\n\n    def _decompress_batched(self, layer_id: int, block_ids: list,\n                            k_cache: torch.Tensor,\n                            v_cache: torch.Tensor) -> None:\n        \"\"\"Production fast path — deliberately SHORT.\n\n        Runs once per layer per step on the forward thread, where every\n        Python statement / torch dispatch is GPU-idle gap (the nsys\n        before_replay stall).  Handles the production shape only: single\n        chunk (hwm <= staging cap), async meta ring, static grid bounds,\n        dense-ish slots.  Everything else (multi-chunk, sync-meta rollback,\n        VALIDATE=1 full checks, time-breakdown events, hole-heavy staging)\n        falls back to ``_decompress_batched_general``.\n        \"\"\"\n        active = self._kv_active_count[layer_id]\n        fr