j = torch.load(PATH, map_location=\"cpu\", weights_only=False)\n    kk = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns, iterations):\n    comp = cls(torch.cuda.Stream())\n    max_blocks = max(ns)\n    host_pool_blocks = max_blocks\n    if issubclass(cls, ZipServCompressor):\n        # ZipServ's size-class slub allocator reserves payloads in chunks.\n        # Keep capacity headroom when this benchmark fills every logical slot.\n        host_pool_blocks += max(64, max_blocks // 4)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=host_pool_blocks,\n                           n_layers=1,\n                           max_gpu_blocks=max_blocks,\n                           max_gpu_decomp_blocks=max_blocks)\n    default_workers = max(1, (os.cpu_count() or 1) - 10)\n    n_workers = int(os.environ.get(\n        \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers))\n    comp.init_kv_compress_workers(n_workers, max_blocks, 1)\n    actual_workers = getattr(comp, \"_n_workers\", n_workers)\n    print(f\"  {name:>10}  (OMP={os.environ.get('OMP_NUM_THREADS', 'all')}, \"\n          f\"workers={actual_workers})\")\n    for N in ns:\n        ids = list(range(N))\n        k, v = hk[:N].contiguous(), hv[:N].contiguous()\n        comp.compress_batch_async_from_host(0, ids, k, v, 0)\n        comp.wait_compress_async(0, BS)                       # warmup\n        samples = []\n        for _ in range(iterations):\n            # Dense-slot codecs need their benchmark scratch allocation reset.\n            # ZipServ recycles reservations when the same block IDs are reused.\n            if hasattr(comp, \"_kv_active_count\"):\n                comp._kv_active_count[0] = 0\n            if 