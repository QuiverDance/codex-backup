{"timestamp":"2026-09-01T05:38:11.927Z","ordinal":10542,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05669-fc4c-7aa0-b9a1-034d833ed8ed","turn_id":"01a05b75-7c66-7882-b2eb-faf8a147f792","item":{"type":"CommandExecution","id":"exec-5e26a7c2-ebad-4d40-9393-bcbf5efdf3c4","process_id":"5607","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,260p\" benchmarks/kv_codec.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,260p\" benchmarks/kv_codec.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Direct production-codec benchmark on real cached K/V blocks.\n\nThe serving KV block layout [N, 16, 8, 128] is viewed as two dense\n[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\nrequired by P4Flat and ChunkDelta3 while exercising their normal compressor,\nhost-staging, and decompressor interfaces.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport time\n\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\n\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\nBLOCK_SHAPE = (16, 8, 128)\nROWS_PER_BLOCK = 128\nCOLS = 128\n\n\ndef _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\n    obj = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_key = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    if len(obj[k_key]) < n or len(obj[\"v_blocks\"]) < n:\n        raise ValueError(\n            f\"Requested {n} blocks, cache has K={len(obj[k_key])}, \"\n            f\"V={len(obj['v_blocks'])}\")\n    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\n    v = torch.stack([x.contiguous() for x in obj[\"v_blocks\"][:n]])\n    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\n\n\ndef _samples(fn, warmup: int, iterations: int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"