= self.cur_num_tokens\n        fused_flags = []\n        need_decomp_ctx = False\n        for _is_fused, _is_split in _cent[2]:\n            _f = _is_fused\n            if (_f and _is_split\n                    and self.batch_has_prefill and self.use_prefill_raw_bf16\n                    and self._cudagraph_ceiling and _N > self._cudagraph_ceiling):\n                # LARGE prefill (chunk > cudagraph capture ceiling): this batch\n                # runs EAGER (stock vLLM sends num_tokens > max_cudagraph_capture\n                # _size to CUDAGraphMode.NONE), so clear the flag and let\n                # _decompress_frozen_split_for_name materialize the dense\n                # primary through its independent prefill-alt/raw cutoff. The\n                # fused op's large-prefill branch then reads that primary.\n                # SMALL prefill (<= ceiling) is CAPTURED and shares the decode\n                # graph, so KEEP the flag (skip_kernel=True) → H2D the compressed\n                # staging only and let the in-graph custom op decompress it,\n                # exactly like decode (UNIFY: same captured op, same staging).\n                _f = False\n            fused_flags.append(_f)\n            if not _f:\n                need_decomp_ctx = True\n        # Prefill materializes a dense primary consumed by the eager GEMM. The\n        # raw branch can put its H2D on load_weight_stream, while prefill-alt\n        # puts only H2D there and keeps its decoder on decomp_weight_stream.\n        # Enter the decomp context so both paths return to the stream on which\n        # the dense-primary readiness event and consuming work are ordered.\n        if self.batch_has_prefill:\n            need_decomp_ctx = True\n        # All-fused decode (no projection runs a dense reconstruct kernel): the\n        # only GPU work per projection is the H2D on load_weight_stream, so hold\n        # ONE load_weight_stream context for the whole loop and let each\n        # _decompress_froz