   # per-comp_key begin/end straddled every tensor's (and\n                # pipelined group's) H2D wait_event, so WDecomp absorbed the\n                # LPDDR->HBM load-wait bubble — already counted in WLoad —\n                # and read ~= GPUFwd while Compute looked tiny.  Per-kernel\n                # intervals are unioned into WDecomp via\n                # frozen_split_decomp_intervals; the load-wait now correctly\n                # surfaces as Stall.  (begin/end_frozen_decomp_events stay\n                # for the frozen_compressed path, which has no separate H2D.)\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    info = split_data.get(name)\n                    if info is None:\n                        continue\n                    staging = self.frozen_split_staging[name][staging_parity]\n                    output = self.frozen_primary_buffer_pair[name][output_parity]\n                    backend_compressor = self._resolve_backend_compressor(\n                        info, layer_id, comp_key)\n\n                    if is_prefill:\n                        # Prefill weight path. Two sub-cases:\n                        #  * Chunk < PREFILL_ALT_MAX_CHUNK WITH an alt codec\n                        #    stored: H2D the compressed exp into alt staging and\n                        #    decode it (less H2D than raw_bf16). The alt is the\n                        #    primary codec reused (unified) or a distinct\n                        #    fast-decode codec (e.g. p4flat).\n                        #  * Larger chunk or no alt: the big GEMM amortises the\n                        #    H2D, so take the raw_bf16 fast path (full BF16 copy,\n                        #    no reconstruct kernel at all).\n                        if (info.alt is not None\n                                and self.cur_num_tokens\n                                < self._alt_max_chunk_for(info.alt.backend)):\n                            alt = info.alt\n                            # Unified alt (same codec as primary) reuses the\n                            # already-resolved concrete compressor — the\n                            # zipserv/dietgpu decode needs its ._ext / workspace\n                            # helpers, which the _AutoWeightCompressor wrapper\n                            # that _get_or_make_backend returns does not expose.\n                            alt_comp = (\n                                backend_compressor\n                                if alt.backend == info.backend\n                                else self._get_or_make_backend(alt.backend))\n                            self._materialize_frozen_split_prefill_alt(\n                                layer_id, name, alt, output, alt_comp)\n                        else:\n                            src = info.lpddr_buffers[\"raw_bf16\"]\n                            # H2D on load_weight_stream (copy stream) so the\n                            # LPDDR→HBM transfer overlaps exec_stream's GEMMs\n                            # instead of blocking the compute stream.\n                            # decomp_weight_stream == exec_stream; the wait\n                            # below ensures frozen_decomp_events recorded on\n                            # decomp_weight_stream (line ~880) fire after the H2D.\n                            with torch.cuda.stream(self.load_weight_stream):\n                                if tb:\n                                    self._frozen_split_h2d_begin_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                                output.view(src.shape).copy_(\n                                    src, non_blocking=True)\n                                if tb:\n                                    self._frozen_split_h2d_end_timing_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                            self.decomp_weight_stream.wait_stream(\n                                self.load_weight_stream)\n                    elif self._ats_decomp_frozen:\n                        # Decode path (ATS): the LPDDR hugepage memory is\n                        # already cudaHostRegister-mapped, so the GPU\n                        # kernel can dereference its host pointer directly\n                        # via ATS / NVLink-C2C UVA. Skip H2D into staging\n                        # and pass the LPDDR tensors straight to the\n                        # decompress kernel.\n                        if not getattr(self, \"_ats_decomp_logged\", False):\n                            sample = info.lpddr_buffers[info.lpddr_attrs[0]]\n                            logger.info(\n                                \"[ATS-decomp] frozen_split decode reading \"\n                                \"compressed bytes directly from LPDDR via ATS \"\n                                \"(no H2D staging): backend=%s first L%d.%s \"\n                                \"attr=%s device=%s ptr=0x%x\",\n                                info.backend, layer_id, name,\n                                info.lpddr_attrs[0], sample.device,\n                                sample.data_ptr())\n                            self._ats_decomp_logged = True\n                        # ATS reads LPDDR via UVA inside the kernel (no\n                        # separate H2D wait), so the kernel window IS the\n                        # decomp+load — time it directly.\n                        if tb:\n                            self._frozen_split_decomp_begin_timing_event(\n                                layer_id, name).record(\n                                    self.decomp_weight_stream)\n                        self._frozen_split_run_decompress(\n                            info,\n                            info.lpddr_buffers,\n                            info.lpddr_numels,\n                            output,\n                            backend_compressor)\n                        if tb:\n                            self._frozen_split_decomp_end_timing_event(\n                                layer_id, name).record(\n                                    self.decomp_weight_stream)\n        # frozen_compressed cells always launch a decoder on exec; unlike a\n        # sufficiently-large frozen_split cell they never turn into raw H2D.\n        # Raw's pre-before-eager scheduling is therefore unsafe for a mixed\n        # frozen_compressed + frozen_split placement even after every split cell\n        # crosses its alt cutoff.\n        frozen_comp_cells = sum(\n            len(layer) for layer in (\n                getattr(self, \"frozen_comp_buffers\", None) or ()) if layer\n        )\n\n        ceiling = int(getattr(self, \"_cudagraph_ceiling\", 0) or 0)\n        self._prefill_raw_lookahead_has_split = bool(split_cells)\n        self._prefill_raw_lookahead_split_cells = split_cells\n        self._prefill_raw_lookahead_frozen_comp_cells = frozen_comp_cells\n        self._prefill_raw_lookahead_min_tokens = (\n            max(ceiling + 1, max_alt_cutoff)\n            if split_cells and not frozen_comp_cells and ceiling > 0 else None\n        )\n\n    def _offload_prefill_max_chunk_for(self, backend):\n        \"\"\"Per-codec offload_compressed prefill threshold: chunks SMALLER than\n        this decode the compressed copy instead of H2D'ing the uncompressed one.\n\n        Resolution mirrors _alt_max_chunk_for (env per-codec -> env single int\n        -> built-in default), but the final fallback is 0 (DISABLED) rather than\n        a global default: offload prefill-compress is opt-in until its (mode-\n        distinct) crossover is calibrated. Returns 0 when nothing is set.\"\"\"\n        v = self._offload_prefill_max_chunk_by_backend.get(backend)\n        if v is not None:\n            return v\n        if self._offload_prefill_max_chunk is not None:\n            return self._offload_prefill_max_chunk\n        return _OFFLOAD_PREFILL_MAX_CHUNK_DEFAULTS.get(backend, 0)\n\n    def _offload_codec_name(self, layer_id, comp_key):\n        \"\"\"Backend name of the offload_compressed codec for one (layer,\n        component): the per-cell YAML override if present, else the configured\n        offload backend.\"\"\"\n        tm = getattr(self, \"torch_model\", None)\n        if tm is not None and comp_key is not None:\n            comps = getattr(tm, \"layer_weight_compressor\", None)\n            if comps is not None and 0 <= layer_id < len(comps):\n                be = comps[layer_id].get(comp_key)\n                if be:\n                    return be.lower()\n        return getattr(self, \"_offload_backend\", None) or \"zipserv\"\n\n    def _attach_prefill_alt(self, info, gpu_target, hbm_sm, name):\n        \"\"\"Compress ``gpu_target`` a second way with the prefill-alt codec and\n        attach it to ``info.alt`` as a full SplitStorageInfo that ALIASES the\n        primary's HBM ``sign_mantissa`` (only the compressed-exp side is new).\n\n        Only p4flat is supported as the alt codec for now (its decode is the\n        cheap branchless palette path). The alt's LPDDR buffers live under the\n        p4flat attr keys in their own dict, so there is no key collision with\n        the primary's buffers. Per-name GPU staging is allocated so the prefill\n        decode H2Ds LPDDR->GPU first (NO direct-LPDDR/ATS read).\n        \"\"\"\n        alt_name = self._prefill_alt_backend\n        comp = self._get_or_make_backend(alt_name)\n        try:\n            with torch.cuda.stream(self.decomp_weight_stream):\n                alt_comped = comp.compress(gpu_target)\n                torch.cuda.synchronize()\n        except Exception as e:\n            # e.g. p4flat requires dims multiple of 64; if a weight can't be\n            # alt-compressed, skip it — prefill keeps the raw_bf16 fast path\n            # for that tensor (info.alt stays None).\n            logger.warning(\"prefill-alt (%s) compress skipped for a weight \"\n                           \"(%s): %s\", alt_name, type(e).__name__, e)\n            return\n        if not isinstance(alt_comped, CompressedP4FlatTensor):\n            raise RuntimeError(\n                f\"prefill-alt backend '{alt_name}' unsupported \"\n                f\"(only p4flat); got {type(alt_comped).__name__}\")\n        # Canonical shared sm: the primary already stores ONE (M,K) row-major\n        # all-element sign|mantissa on HBM (``hbm_sm``). The p4flat alt SHARES\n        # it (no clone, no LPDDR sm) and decodes in row-major mode (its native\n        # tile-blocked sm from compress is dropped). Only the p4flat exp side\n        # (palette headers + codes + exceptions) ships to LPDDR.\n        lpddr_attrs = SplitStorageInfo._P4FLAT_LPDDR_ATTRS\n        metadata = {\n            \"M\": int(alt_comped.M), \"K\": int(alt_comped.K),\n            \"num_exceptions\": int(alt_comped.num_exceptions),\n            \"num_groups\": int(alt_comped.num_groups),\n        }\n        lpddr_bufs: Dict[str, torch.Tensor] = {}\n        for attr in lpddr_attrs:\n            gpu_buf = getattr(alt_comped, attr).contiguous()\n            hp_t = self.huge_page_allocator.allocate(\n                gpu_buf.shape, gpu_buf.stride(), gpu_buf.dtype,\n                page_type=\"weight\")\n            hp_t.copy_(gpu_buf)\n            lpddr_bufs[attr] = hp_t\n        info.alt = SplitStorageInfo(\n            hbm_sm, lpddr_bufs, metadata, backend=\"p4flat\")\n        info.alt._uses_canonical_sm = True   # p4flat decode reads row-major sm\n        self._ensure_frozen_split_alt_staging(name, info.alt)\n\n    def _attach_prefill_alt_same_codec(self, info, metadata, name):\n        \"\"\"Unified prefill-alt: reuse the PRIMARY frozen_split codec for the\n        small-chunk prefill decode instead of compressing a second time.\n\n        ``info.alt`` ALIASES the primary's HBM sign_mantissa, its HBM aux\n        buffers (e.g. zipserv tile_offsets) and its LPDDR compressed buffers,\n        so there is NO extra LPDDR/HBM cost — only a GPU decode-staging slot is\n        allocated.  Works for every backend the primary decode already\n        supports (zipserv, dietgpu, p4flat, ...): a prefill chunk below\n        TIERED_SERVE_PREFILL_ALT_MAX_CHUNK then decodes the compressed exp from\n        LPDDR (smaller H2D than raw_bf16) via the SAME kernel the decode path\n        uses, at the cost of the primary reconstruct.\n\n        ``metadata`` is the primary's metadata dict (M/K + backend-specific\n        scalars) so the aliasing info exposes the same decode attributes.\n        \"\"\"\n        # Share the codec buffers but drop raw_bf16 — the alt decode only needs\n        # the compressed-exp side, and including raw_bf16 would size a needless\n        # 2*M*K GPU staging slot.\n        codec_bufs = {k: v for k, v in info.lpddr_buffers.items()\n                      if k != \"raw_bf16\"}\n        alt = SplitStorageInfo(\n            info.sign_mantissa, codec_bufs, metadata,\n            backend=info.backend, lpddr_shared=True,\n            hbm_buffers=info.hbm_buffers)\n        # Inherit the primary's sm layout: unified attach only fires when the\n        # primary kept its normal (non-canonical) sm, so this is False here,\n        # but mirror it defensively in case that ever changes.\n        alt._uses_canonical_sm = bool(getattr(info, \"_uses_canonical_sm\", False))\n        info.alt = alt\n        self._ensure_frozen_split_alt_staging(name, alt)\n\n    @staticmethod\n    def _compute_canonical_sm(weight):\n        \"\"\"(M,K) row-major all-element sign|mantissa byte: (sign<<7)|mantissa7.\n        Shared verbatim by the zipserv decode and the p4flat alt decode.\"\"\"\n        u16 = weight.contiguous().view(torch.uint16).reshape(-1).to(torch.int32)\n        return (((u16 >> 8) & 0x80) | (u16 & 0x7F)).to(torch.uint8).contiguous()\n\n    def _frozen_split_run_decompress(self, info, src_bufs, ln, output,\n                                          backend_compressor,\n                                          gt_m_base=0, num_row_tiles=-1):\n        \"\"\"Backend-dispatched decompress for one frozen_split tensor.\n\n        ``src_bufs`` is the dict of attr -> tensor that holds the\n        compressed payload (either staging, post-H2D, or — under ATS —\n        the LPDDR hugepage tensor itself).  ``ln`` is the matching\n        attr -> numel map so we can ``narrow`` to the actual compressed\n        size.  ``output`` is the per-layer decompress destination\n        (BF16 or FP8 depending on the backend).\n        \"\"\"\n        backend = info.backend\n        if backend == \"raw_exp\":\n            # Compressor-independent path: raw exp was H2D'd into staging;\n            # just bit-merge with the HBM-resident sign|mantissa.  No ANS.\n            from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n            numel = info.M * info.K\n            exp_view = src_bufs[\"raw_exp\"].narrow(0, 0, numel)\n            dietgpu_reconstruct(\n                exp_view.view(info.M, info.K),\n                info.sign_mantissa.view(info.M, info.K),\n                output.view(info.M, info.K))\n            return\n        if backend == \"dietgpu\":\n            from tiered_serve.dietgpu_fused_kernel import dietgpu_reconstruct\n            numel = info.M * info.K\n            if \"raw_exp\" in src_bufs:\n                # raw-exp path: the uncompressed exponent was H2D'd straight\n                # into staging — no ANS decode, just the bit-merge kernel.\n                exp_view = src_bufs[\"raw_exp\"].narrow(0, 0, numel)\n            else:\n                comp_n = ln[\"compressed_exp\"]\n                exp_payload = src_bufs[\"compressed_exp\"].narrow(0, 0, comp_n)\n                exp_b