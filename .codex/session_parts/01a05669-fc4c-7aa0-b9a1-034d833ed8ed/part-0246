he load path (``_fused_offload_h2d``) WAR-waits\n        the per-(name, slot) kernel_done event before each H2D and then issues\n        ``decomp_weight_stream.wait_stream(load_weight_stream)`` so the exec\n        barrier the wrapper records (entry[4]) follows the H2D; the fused op\n        waits that barrier and records kernel_done (entry[5]).\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        installed = 0\n        for idx in self.not_frozen_layers:\n            comp_secondary = self.comp_secondary_buffers[idx]\n            if comp_secondary is None:\n                continue\n            block = self.torch_model.decoder_blocks[idx]\n            for name, comped in comp_secondary.items():\n                comp_key = self.tensor_to_component.get(name)\n                comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key)\n                if comp_id is None:\n                    continue\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    block.is_frozen)\n                if mode != \"offload_compressed\":\n                    continue\n                compressor = self._compressor_for_cell(idx, comp_key, mode=mode)\n                if not getattr(compressor, \"HAS_FUSED_MM\", False):\n                    continue\n                # Per-step-threshold codecs (p4flat/ublb) fall back to\n                # orig_forward above their N threshold, which would read the\n                # dense primary buffer the fused load path stops populating —\n                # unsupported here; keep them on the dense decompress path.\n                if getattr(compressor, \"_fused_max_n_for\", None) is not None:\n                    logger.info(\n                        \"fused_mm: offload fused unsupported for per-threshold \"\n                        \"codec %s — skipping %s (keeps dense decompress)\",\n                        type(compressor).__name__, name)\n                    continue\n                primary = (self.primary_buffers[idx].get(name)\n                           if self.primary_buffers[idx] else None)\n                try:\n                    shell = compressor.build_offload_shell(comped, primary)\n                except (NotImplementedError, AttributeError,\n                        TypeError, RuntimeError) as e:\n                    logger.info(\n                        \"fused_mm: cannot build offload shell for %s via %s \"\n                        \"— skipping (%s)\", name, type(compressor).__name__, e)\n                    continue\n                leaf_name, _, _tn = name.rpartition(\".\")\n                leaf_module = block.module.get_submodule(leaf_name)\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx, comp_id=comp_id,\n                    mode=\"offload_compressed\", tensor_name=name)\n                if self._is_fused_offload_cell(idx, comp_id):\n                    installed += 1\n        if installed:\n            logger.info(\n                \"[fused-mm] offload_compressed: installed %d fused override(s)\"\n                \" — decode H2Ds the compressed blob into the _d_* staging and \"\n                \"skips the dense decompress (WDecomp -> Compute); profile_run/\"\n                \"warmup short-circuit to zeros. N>thr -> in-graph decomp+cuBLAS\"\n                \" into the primary buffer; prefill stays native.\", installed)\n\n    def _release_unused_primary_buffers_after_fused_mm(self):\n        \"\"\"Reclaim ``frozen_primary_buffer_pair`` / ``_temp_buffers``\n        slots whose every consumer layer has had the ``--fused-mm``\n        forward override installed.\n\n        For Llama-70B all-frozen-split this recovers ~3.2 GiB of HBM\n        (2 parity copies × 4 components × per-projection size).  The\n        replacement ``module.weight`` is a zero-element Parameter of\n        matching dtype/device — sufficient for any vLLM helper that\n        only consults metadata, and unreachable from the actual\n        forward path now that the fused override is in place.\n\n        Safety: Inductor's AOT-compiled FX graph for this model does\n        NOT extract qkv/o/gate_up/down projection weights as args\n        (verified via traced node listing — only layernorm weights\n        appear), so the compiled graph keeps working with the 0-size\n        replacement Parameters.  If a backend ever does need to read\n        ``module.weight``, this path will surface immediately as a\n        shape mismatch and we can gate the release behind a flag.\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        if not hasattr(self, \"_fused_reg\") or self._fused_reg is None:\n            return\n        if not hasattr(self, \"frozen_primary_buffer_pair\"):\n            return\n        if not getattr(self, \"_temp_buffers\", None):\n            return\n\n        # Releasing the dense-weight primary buffers assumes the fused override\n        # replaces EVERY forward. The threshold-based fused (ublb_flat / p4flat)\n        # only handles DECODE up to the codec's per-shape fused-N threshold;\n        # prefill still\n        # materialises the dense weight in the primary buffer\n        # (_decompress_frozen_split_for_name's prefill branch copies raw_bf16 /\n        # runs the reconstruct into it) and above-threshold decode falls back to\n        # decompress+matmul. Freeing it then leaves that path with output=None\n        # ('NoneType' has no attribute 'view'). Keep the buffers by default;\n        # opt in only for a config where fused provably covers all forwards.\n        if os.environ.get(\"TIERED_SERVE_FUSED_RELEASE_PRIMARY\", \"0\") != \"1\":\n            return\n\n        parity_max = self.FROZEN_DECOMP_PARITY\n        slots_per_layer = self._FUSED_REG_SLOTS_PER_LAYER\n\n        freeable_names: list[str] = []\n        for name in list(self.frozen_primary_buffer_pair.keys()):\n            comp_key = self.tensor_to_component.get(name)\n            comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key) if comp_key else None\n            if comp_id is None:\n                continue\n            # Every layer whose residency mode reads from this primary\n            # buffer must have a fused_mm registry entry.  Offload modes\n            # use the pool too (write target for non-frozen layers) so\n            # we conservatively skip when ANY layer's mode requires the\n            # dense weight to be present.\n            all_fused = True\n            for idx in range(self.n_layers):\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    self.torch_model.decoder_blocks[idx].is_frozen)\n                if mode in (\"frozen_compressed\", \"frozen_split\"):\n                    entry = self._fused_reg[idx * slots_per_layer + comp_id]\n                    if entry is None:\n                        all_fused = False\n                        break\n                else:\n                    # offload / offload_uncompressed / offload_compressed:\n                    # the buffer is the write target of an active\n                    # decompress; can't free.\n                    all_fused = False\n                    break\n            if all_fused:\n            # staging). info.sign_mantissa is the same buffer in that case.\n            _canon = (info.sign_mantissa\n                      if getattr(info, \"_uses_canonical_sm\", False) else None)\n            backend_compressor._ext.decompress(\n                info.sign_mantissa,\n                src_bufs[\"compressed_full\"].narrow(0, 0, ln[\"compressed_full\"]),\n                src_bufs[\"bitmap1\"].narrow(0, 0, ln[\"bitmap1\"]),\n                src_bufs[\"bitmap2\"].narrow(0, 0, ln[\"bitmap2\"]),\n                src_bufs[\"bitmap3\"].narrow(0, 0, ln[\"bitmap3\"]),\n                info.hbm_buffers[\"tile_offsets_median\"],\n                info.hbm_buffers[\"tile_offsets_global\"],\n                info.max_high_freq_count,\n                info.max_full_count,\n                info.start_exp,\n                output,\n                info.M, info.K,\n                gt_m_base, num_row_tiles,\n                _canon)\n\n    def _ensure_prefill_war_events(self):\n        \"\"\"Lazily allocate per-(comp, parity) WAR events for the prefill\n        raw_bf16 path.\n\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\n        2*M*K H2D into the primary buffer moves OFF exec onto\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\n        GEMMs instead of serialising on exec, since\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\n        a cross-stream resource shared across parity-PARITY layers, so the\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\n        has finished reading it.  One event per (comp, parity); pre-recorded\n        so the first PARITY layers (fresh buffers) never block on a\n        never-recorded event.\n        \"\"\"\n        if getattr(self, \"_prefill_war_events\", None) is not None:\n            return\n        self._prefill_war_events = {\n            comp_key: [torch.cuda.Event(external=True)\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n        }\n        for events in self._prefill_war_events.values():\n            for ev in events:\n                ev.record()  # pre-signal\n\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\n                                          info, skip_kernel: bool = False,\n                                          h2d_ctx_held: bool = False,\n                                          collect_into=None\n                                          ) -> None:\n        \"\"\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\n        staging then backend-specific decompress + reconstruct.  The fused\n        H2D-only caller may hold ``load_weight_stream``; dense paths hold\n        ``decomp_weight_stream``.\n\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n                P = self.FROZEN_DECOMP_PARITY\n                if war is not None:\n                    # Default path: free the prior layer's slot for this comp\n                    # inline.  V1 prefill eager lookahead disables this record\n                    # and lets the wrapper mark slots free after the eager piece\n                    # actually consumes them; otherwise scheduling graph K+1\n                    # before graph K would falsely free graph K's qkv slot.\n                    if not getattr(self, \"_v1_prefill_raw_external_war\",\n                                   False):\n                        war[(layer_id - 1) % P].record(self.exec_stream)\n                    # WAR: this H2D overwrites slot L%P, last read by layer\n                    # (L-PARITY)'s GEMM.  Layers < PARITY are first occupants\n                    # (fresh buffer) → no prior reader → skip.\n                    if layer_id >= P:\n                        self.load_weight_stream.wait_event(war[layer_id % P])\n                with torch.cuda.stream(self.load_weight_stream):\n                    output.view(src.shape).copy_(src, non_blocking=True)\n                # RAW: record weight-ready on load_weight_stream so the FX\n                # wait_frozen_weight makes the GEMM wait for THIS H2D.  Suppress\n                # the caller's default exec-stream record (it would shadow this\n        # kept running on the decode path even though the fused forward was\n        # installed).\n        reg = getattr(self, \"_fused_reg\", None)\n        _slots = self._FUSED_REG_SLOTS_PER_LAYER\n        # When --fused-mm is on and a (layer, component) has the override\n        # installed, the dense reconstruct is redundant: the rewritten\n        # Linear.forward consumes the compressed buffer (or frozen_split staging\n        # slot) through the custom op.  The decomp_weight_stream context is the\n        # *current* stream only for an external dense reconstruct, so when every\n        # tensor is fused-skipped (the all-fused decode path) the context is dead\n        # — and entering it once per graph piece (~81x/step) was the single\n        # biggest per-iteration data-stack-churn site.  ``torch.cuda.stream(None)`` is\n        # a no-op, so we skip it entirely in that case.  H2D stays on\n        # load_weight_stream and all events record on explicit streams.\n        # DECODE: a registry entry means the custom op owns the whole decision.\n        # The loader stages compressed bytes only; linear_apply selects fused\n        # GEMM vs one decompress+cuBLAS at the point of use.  Repeating the\n        # threshold decision here used to launch a dense reconstruct before the\n        # graph and then decompress the same QKV again inside the custom op.\n        # PREFILL: captured-size chunks keep compressed staging; only an eager\n        # chunk above the CUDA graph ceiling clears the flag and materializes\n        # raw_bf16 for the custom op's dense-primary branch.\n        #\n        # Static per-(call-site, layer) memo: component lookup, registry\n        # presence, and split ownership are fixed for the run.\n        _cache = getattr(self, \"_dft_static_cache\", None)\n        if _cache is None:\n            _cache = self._dft_static_cache = {}\n        _ckey = (id(tensor_names), layer_id)\n        _cent = _cache.get(_ckey)\n        if (_cent is None or _cent[0] is not tensor_names\n                or _cent[3] is not reg):\n            comp_keys = [self.tensor_to_component.get(n) for n in tensor_names]\n            _static = []\n            for _name, _ck in zip(tensor_names, comp_keys):\n                _cid = _FUSED_MM_COMP_TO_ID.get(_ck) if _ck else None\n                _entry = (reg[layer_id * _slots + _cid]\n                          if (reg is not None and _cid is not None\n                              and layer_id * _slots + _cid < len(reg))\n                          else None)\n                # frozen_split tensors own the raw_bf16 prefill crossover (run in\n                # _decompress_frozen_split_for_name); flag them so the per-step\n                # loop can clear the fuse flag on prefill.\n                _is_split = (split_data is not None and _name in split_data)\n                _static.append((_entry is not None, _is_split))\n            _cent = (tensor_names, comp_keys, _static, reg)\n            _cache[_ckey] = _cent\n        comp_keys = _cent[1]\n        _N = self.cur_num_tokens\n        fused_flags = []\n        need_decomp_ctx = False\n        for _is_fused, _is_split in _cent[2]:\n            _f = _is_fused\n            if (_f and _is_split\n                    and self.batch_has_prefill and self.use_prefill_raw_bf16\n                    and self._cudagraph_ceiling and _N > self._cudagraph_ceiling):\n                # LARGE prefill (chunk > cudagraph capture ceiling): this batch\n                # runs EAGER (stock vLLM sends num_tokens > max_cudagraph_capture\n                # _size to CUDAGraphMode.NONE), so clear the flag and let\n                # _decompress_frozen_split_for_name materialize the dense\n                # primary through its independent prefill-alt/raw cutoff. The\n                # fused op's large-prefill branch then reads that primary.\n                # SMALL prefill (<= ceiling) is CAPTURED and shares the decode\n                # graph, so KEEP the flag (skip_kernel=True) → H2D the compressed\n                # staging only and let the in-graph custom op decompress it,\n                # exactly like decode (UNIFY: same captured op, same staging).\n                _f = False\n            fused_flags.append(_f)\n            if not _f:\n                need_decomp_ctx = True\n        # Prefill materializes a dense primary consumed by the eager GEMM. The\n        # raw branch can put its H2D on load_weight_stream, while prefill-alt\n        # puts only H2D there and keeps its decoder on decomp_weight_stream.\n        # Enter the decomp context so both paths return to the stream on which\n        # the dense-primary readiness event and consuming work are ordered.\n        if self.batch_has_prefill:\n            need_decomp_ctx = True\n        # All-fused decode (no projection runs a dense reconstruct kernel): the\n        # only GPU work per projection is the H2D on load_weight_stream, so hold\n        # ONE load_weight_stream context for the whole loop and let each\n        # _decompress_frozen_split_for_name skip its own per-projection\n        # stream context (h2d_ctx_held).  Non-fused/prefill keep decomp_weight_stream\n        # (the reconstruct kernel needs it) and the per-projection inner H2D\n        # context.  (was: torch.cuda.stream(None) for all-fused -> per-projection churn.)\n        _all_fused_h2d = not need_decomp_ctx\n        if (_ENV_ANY_WLOAD_GRAPH\n                and torch.cuda.is_current_stream_capturing()\n                and not getattr(DualMemoryLoader, \"_wlg_dft_dbg\", False)):\n            DualMemoryLoader._wlg_dft_dbg = True\n            logger.warning(\n                \"[WLG] decompress_frozen_tensors during CAPTURE L%d names=%s \"\n                \"all_fused=%s split=%s comp=%s\", layer_id, tensor_names,\n                _all_fused_h2d, bool(split_data), bool(comp_data))\n        # #8: in the all-fused path, COLLECT each projection's (dst,src,h2d_event)\n        # and issue ONE batch_memcpy after the loop (the WAR waits all run in the\n        # loop first), instead of one batch_memcpy per projection.\n"},"started_at_ms":1788244637882,"completed_at_ms":1788244637882}}
{"timestamp":"2026-09-01T06:37:17.886Z","ordinal":12304,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05baf-b8be-7383-9c63-fe946cae479f","call_id":"call_uvhXuxZheixOB2EShEy48lQQ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"                # backend, so a cao-p4 cell can be P4Flat even when the CLI's\n                # base ``--weight-comp`` is ZipServ.\n                compressor = self._resolve_backend_compressor(\n                    info, idx, comp_key)\n                if not getattr(compressor, \"HAS_FUSED_MM\", False):\n                    continue\n                try:\n                    shell = compressor.build_split_shell(info, staging_dict)\n                except NotImplementedError as e:\n                    logger.info(\n                        \"fused_mm: frozen_split backend %s does not \"\n                        \"implement build_split_shell — skipping (%s)\",\n                        type(compressor).__name__, e)\n                    continue\n                # Bind the per-(layer,name) reusable dense buffer as the\n                # decompress destination for the N>thr decompress+cuBLAS path.\n                # WITHOUT it, fused_mm.decompress() would torch.empty(M,K) a FRESH\n                # M×K buffer per cell inside the captured graph (896 MiB for\n                # gate_up) → OOM.  This is the SAME per-parity primary the loader\n                # materialises raw_bf16 into for large prefill (so the op's\n                # large-prefill branch reads it via leaf.weight), reused across\n                # layers within a forward (serialised on the single stream).\n                self._ensure_frozen_primary_buffer(name)\n                shell.output_tensor = self.frozen_primary_buffer_pair[name][\n                    idx % self.FROZEN_DECOMP_PARITY]\n                leaf_name, _, _tensor_name = name.rpartition(\".\")\n                leaf_module = block.module.get_submodule(leaf_name)\n                # Shapes that NEVER fuse (per-shape fused threshold 0 — e.g.\n                # QKV / GateUp on the U4-RS table) gain nothing from the\n                # override and actively BREAK --time-breakdown WDecomp: with\n                # the override every decode routes through linear_apply's\n                # fallback ``decompress``, which runs INSIDE the replayed CUDA\n                # graph on exec_stream — its time silently folds into Compute\n                # and the in-graph timing events can't be read back per replay\n                # (WDecomp reads 0).  Leaving these shapes on the native\n                # frozen_split forward keeps their dense decompress OUT of the\n                # graph (prefetched on decomp_weight_stream), where it IS\n                # attributed to WDecomp — and loses nothing, since the table\n                # says fused never wins for them anyway.  Positive-threshold\n                # shapes (O / Down) keep the override: they fuse at small N\n                # (→ Compute, correct); only their rare above-threshold decode\n                # still decompresses in-graph (an accepted residual gap).\n                _thr_fn = getattr(compressor, \"_fused_max_n_for\", None)\n                if (getattr(compressor, \"_fused_max_n_override\", None) is None\n                        and _thr_fn is not None\n                        and _thr_fn(int(shell.M), int(shell.K)) <= 0):\n                    logger.info(\n                        \"fused_mm: skip override for %s (M=%d K=%d) — fused \"\n                        \"threshold 0; native frozen_split decomp preserves \"\n                        \"WDecomp attribution\",\n                        name, int(shell.M), int(shell.K))\n                    continue\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx,\n                    comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                    mode=\"frozen_split\", tensor_name=name)\n\n    def _install_offload_compressed_fused_mm_overrides(self):\n        \"\"\"Install fused decompress+GEMM overrides for ``offload_compressed``\n        cells (e.g. flexgen-comp).  Active whenever ``--fused-mm`` is on.\n\n        Runs AFTER the offload GPU staging (``_comp_transfer_bufs`` /\n        ``register_temp_d_tensor``) and the dense ``primary_buffers`` are bound,\n        so the shell can alias the per-decode ``_d_*`` staging and bind the\n        primary buffer as ``fused_mm``'s large-N decompress target.\n\n        Only codecs WITHOUT a per-shape ``_fused_max_n_for`` (zipserv via the\n        auto wrapper) are eligible: their ``fused_mm`` decides fused-kernel vs\n        decompress+cuBLAS internally per N, so decode never falls back to\n        ``orig_forward`` and the load path can unconditionally skip the dense\n        decompress.  Codecs that expose ``_fused_max_n_for`` (p4flat / ublb)\n        would need per-step dense/fused coordination on the load path — not\n        wired here.\n\n        WAR/RAW correctness: the load path (``_fused_offload_h2d``) WAR-waits\n        the per-(name, slot) kernel_done event before each H2D and then issues\n        ``decomp_weight_stream.wait_stream(load_weight_stream)`` so the exec\n        barrier the wrapper records (entry[4]) follows the H2D; the fused op\n        waits that barrier and records kernel_done (entry[5]).\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        installed = 0\n        for idx in self.not_frozen_layers:\n            comp_secondary = self.comp_secondary_buffers[idx]\n            if comp_secondary is None:\n                continue\n            block = self.torch_model.decoder_blocks[idx]\n            for name, comped in comp_secondary.items():\n                comp_key = self.tensor_to_component.get(name)\n                comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key)\n                if comp_id is None:\n                    continue\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    block.is_frozen)\n                if mode != \"offload_compressed\":\n                    continue\n                compressor = self._compressor_for_cell(idx, comp_key, mode=mode)\n                if not getattr(compressor, \"HAS_FUSED_MM\", False):\n                    continue\n                # Per-step-threshold codecs (p4flat/ublb) fall back to\n                # orig_forward above their N threshold, which would read the\n                # dense primary buffer the fused load path stops populating —\n                # unsupported here; keep them on the dense decompress path.\n                if getattr(compressor, \"_fused_max_n_for\", None) is not None:\n                    logger.info(\n                        \"fused_mm: offload fused unsupported for per-threshold \"\n                        \"codec %s — skipping %s (keeps dense decompress)\",\n                        type(compressor).__name__, name)\n                    continue\n                primary = (self.primary_buffers[idx].get(name)\n                           if self.primary_buffers[idx] else None)\n                try:\n                    shell = compressor.build_offload_shell(comped, primary)\n                except (NotImplementedError, AttributeError,\n                        TypeError, RuntimeError) as e:\n                    logger.info(\n                        \"fused_mm: cannot build offload shell for %s via %s \"\n                        \"— skipping (%s)\", name, type(compressor).__name__, e)\n                    continue\n                leaf_name, _, _tn = name.rpartition(\".\")\n                leaf_module = block.module.get_submodule(leaf_name)\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx, comp_id=comp_id,\n                    mode=\"offload_compressed\", tensor_name=name)\n                if self._is_fused_offload_cell(idx, comp_id):\n                    installed += 1\n        if installed:\n            logger.info(\n                \"[fused-mm] offload_compressed: installed %d fused override(s)\"\n                \" — decode H2Ds the compressed blob into the _d_* staging and \"\n                \"skips the dense decompress (WDecomp -> Compute); profile_run/\"\n                \"warmup short-circuit to zeros. N>thr -> in-graph decomp+cuBLAS\"\n                \" into the primary buffer; prefill stays native.\", installed)\n\n    def _release_unused_primary_buffers_after_fused_mm(self):\n        \"\"\"Reclaim ``frozen_primary_buffer_pair`` / ``_temp_buffers``\n        slots whose every consumer layer has had the ``--fused-mm``\n        forward override installed.\n\n        For Llama-70B all-frozen-split this recovers ~3.2 GiB of HBM\n        (2 parity copies × 4 components × per-projection size).  The\n        replacement ``module.weight`` is a zero-element Parameter of\n        matching dtype/device — sufficient for any vLLM helper that\n        only consults metadata, and unreachable from the actual\n        forward path now that the fused override is in place.\n\n        Safety: Inductor's AOT-compiled FX graph for this model does\n        NOT extract qkv/o/gate_up/down projection weights as args\n        (verified via traced node listing — only layernorm weights\n        appear), so the compiled graph keeps working with the 0-size\n        replacement Parameters.  If a backend ever does need to read\n        ``module.weight``, this path will surface immediately as a\n        shape mismatch and we can gate the release behind a flag.\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        if not hasattr(self, \"_fused_reg\") or self._fused_reg is None:\n            return\n        if not hasattr(self, \"frozen_primary_buffer_pair\"):\n            return\n        if not getattr(self, \"_temp_buffers\", None):\n            return\n\n        # Releasing the dense-weight primary buffers assumes the fused override\n        # replaces EVERY forward. The threshold-based fused (ublb_flat / p4flat)\n        # only handles DECODE up to the codec's per-shape fused-N threshold;\n        # prefill still\n        # materialises the dense weight in the primary buffer\n        # (_decompress_frozen_split_for_name's prefill branch copies raw_bf16 /\n        # runs the reconstruct into it) and above-threshold decode falls back to\n        # decompress+matmul. Freeing it then leaves that path with output=None\n        # ('NoneType' has no attribute 'view'). Keep the buffers by default;\n        # opt in only for a config where fused provably covers all forwards.\n        if os.environ.get(\"TIERED_SERVE_FUSED_RELEASE_PRIMARY\", \"0\") != \"1\":\n            return\n\n        parity_max = self.FROZEN_DECOMP_PARITY\n        slots_per_layer = self._FUSED_REG_SLOTS_PER_LAYER\n\n        freeable_names: list[str] = []\n        for name in list(self.frozen_primary_buffer_pair.keys()):\n            comp_key = self.tensor_to_component.get(name)\n            comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key) if comp_key else None\n            if comp_id is None:\n                continue\n            # Every layer whose residency mode reads from this primary\n            # buffer must have a fused_mm registry entry.  Offload modes\n            # use the pool too (write target for non-frozen layers) so\n            # we conservatively skip when ANY layer's mode requires the\n            # dense weight to be present.\n            all_fused = True\n            for idx in range(self.n_layers):\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    self.torch_model.decoder_blocks[idx].is_frozen)\n                if mode in (\"frozen_compressed\", \"frozen_split\"):\n                    entry = self._fused_reg[idx * slots_per_layer + comp_id]\n                    if entry is None:\n                        all_fused = False\n                        break\n                else:\n                    # offload / offload_uncompressed / offload_compressed:\n                    # the buffer is the write target of an active\n                    # decompress; can't free.\n                    all_fused = False\n                    break\n            if all_fused:\n            # staging). info.sign_mantissa is the same buffer in that case.\n            _canon = (info.sign_mantissa\n                      if getattr(info, \"_uses_canonical_sm\", False) else None)\n            backend_compressor._ext.decompress(\n                info.sign_mantissa,\n                src_bufs[\"compressed_full\"].narrow(0, 0, ln[\"compressed_full\"]),\n                src_bufs[\"bitmap1\"].narrow(0, 0, ln[\"bitmap1\"]),\n                src_bufs[\"bitmap2\"].narrow(0, 0, ln[\"bitmap2\"]),\n                src_bufs[\"bitmap3\"].narrow(0, 0, ln[\"bitmap3\"]),\n                info.hbm_buffers[\"tile_offsets_median\"],\n                info.hbm_buffers[\"tile_offsets_global\"],\n                info.max_high_freq_count,\n                info.max_full_count,\n                info.start_exp,\n                output,\n                info.M, info.K,\n                gt_m_base, num_row_tiles,\n                _canon)\n\n    def _ensure_prefill_war_events(self):\n        \"\"\"Lazily allocate per-(comp, parity) WAR events for the prefill\n        raw_bf16 path.\n\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\n        2*M*K H2D into the primary buffer moves OFF exec onto\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\n        GEMMs instead of serialising on exec, since\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\n        a cross-stream resource shared across parity-PARITY layers, so the\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\n        has finished reading it.  One event per (comp, parity); pre-recorded\n        so the first PARITY layers (fresh buffers) never block on a\n        never-recorded event.\n        \"\"\"\n        if getattr(self, \"_prefill_war_events\", None) is not None:\n            return\n        self._prefill_war_events = {\n            comp_key: [torch.cuda.Event(external=True)\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n        }\n        for events in self._prefill_war_events.values():\n            for ev in events:\n                ev.record()  # pre-signal\n\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\n                                          info, skip_kernel: bool = False,\n                                          h2d_ctx_held: bool = False,\n                                          collect_into=None\n                                          ) -> None:\n        \"\"\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\n        staging then backend-specific decompress + reconstruct.  The fused\n        H2D-only caller may hold ``load_weight_stream``; dense paths hold\n        ``decomp_weight_stream``.\n\n        Picks the layer's parity-specific staging + output buffer so\n        adjacent layers can run their H2D + kernel in parallel against\n        physically disjoint memory.  staging and output may use\n        different parity depths (see FROZEN_*_PARITY init).\n\n        ``skip_kernel`` is set by the ``--fused-mm`` install path: the\n        H2D into staging still runs (fused_mm reads from the same\n        staging slot at forward time) but the dense reconstruct kernel\n        is skipped.  The staging-slot serialisation is then handled by\n        ``kernel_done_event`` recorded inside the fused custom op\n        after it reads the slot, rather than here after the kernel.\n        \"\"\"\n        if not getattr(DualMemoryLoader, \"_logged_dfs_entry\", False):\n            DualMemoryLoader._logged_dfs_entry = True\n            logger.info(\n                \"[DFS first-call] layer_id=%d name=%s \"\n                \"batch_has_prefill=%s ran_eager=%s ats=%s skip_kernel=%s\",\n                layer_id, name, self.batch_has_prefill, self.ran_eager,\n                self._ats_decomp_frozen, skip_kernel)\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        staging = self.frozen_split_staging[name][staging_parity]\n        output = self.frozen_primary_buffer_pair[name][output_parity]\n        # batch_has_prefill, not is_prefill: prefill chunks under a PIECEWISE\n        # graph still use the phase policy. For eager chunks this selects\n        # prefill-alt below its cutoff and raw_bf16 at/above it; captured chunks\n        # retain the fused compressed-staging path through ``skip_kernel``.\n        # TIERED_SERVE_PREFILL_RAW_BF16=0 disables this phase policy and falls\n        # through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # Reset per-call: the raw_bf16 prefill branch records the weight-ready\n        # event itself (on load_weight_stream); this flag tells the caller to\n        # skip its default exec-stream record for that case.\n        self._last_prefill_raw_recorded = False\n        # backend_compressor is consumed ONLY by the prefill-reconstruct, ATS,\n        # and non-fused decode paths.  The common fused (skip_kernel) decode\n        # returns right after the H2D without using it, so skip this\n        # per-projection, per-layer resolution (a getattr chain +\n        # _get_or_make_backend) on that hot path.\n        backend_compressor = (\n            None if (skip_kernel and not is_prefill\n                     and not self._ats_decomp_frozen)\n            else self._resolve_backend_compressor(\n                info, layer_id, self.tensor_to_component.get(name)))\n        detailed_nvtx = _ENV_FROZEN_DETAILED_NVTX\n\n        if is_prefill and not skip_kernel:\n            # Large eager prefill weight materialization: the fused custom op\n            # reads the leaf's dense primary weight for N above the CUDA graph\n            # ceiling, so populate that buffer here.  Native non-fused prefill\n            # reads the same output.\n            #\n            # Captured-size prefill keeps skip_kernel=True and uses compressed\n            # staging exactly like decode; only eager large prefill comes here.\n            if (info.alt is not None and self.cur_num_tokens\n                    < self._alt_max_chunk_for(info.alt.backend)):\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_push(\n                        f\"frozen_split_prefill_alt L{layer_id}.{name}\")\n                alt = info.alt\n                # Unified alt reuses the resolved concrete compressor (the\n                # wrapper from _get_or_make_backend lacks ._ext / workspace).\n                alt_comp = (backend_compressor\n                            if alt.backend == info.backend\n                            else self._get_or_make_backend(alt.backend))\n                self._materialize_frozen_split_prefill_alt(\n                    layer_id, name, alt, output, alt_comp)\n                if detailed_nvtx:\n                    torch.cuda.nvtx.range_pop()\n                return\n            if detailed_nvtx:\n                torch.cuda.nvtx.range_push(\n                    f\"frozen_split_prefill_raw_bf16 L{layer_id}.{name}\")\n            src = info.lpddr_buffers[\"raw_bf16\"]\n            comp_key = self.tensor_to_component.get(name)\n            # Move the (large, 2*M*K) raw H2D OFF exec onto load_weight_stream so\n            # the slow C2C copy overlaps the prefill GEMMs instead of serialising\n            # on exec (decomp_weight_stream == exec_stream).  This is only\n            # correct when the consuming graph has a per-component readiness\n            # wait, either from the FX pass or directly in the fused custom op.\n            _component_waits = (\n                (getattr(type(self), \"_v1_weight_waits_active\", False)\n                 or getattr(self, \"_v1_fused_weight_waits_complete\", False))\n                and comp_key is not None\n                and hasattr(self, \"frozen_decomp_events\")\n            )\n            if _component_waits:\n                # The primary buffer `output` is now written cross-stream, so\n                # guard it with the WAR events.\n                self._ensure_prefill_war_events()\n                war = self._prefill_war_events.get(comp_key)\n                P = self.FROZEN_DECOMP_PARITY\n                if war is not None:\n                    # Default path: free the prior layer's slot for this comp\n                    # inline.  V1 prefill eager lookahead disables this record\n                    # and lets the wrapper mark slots free after the eager piece\n                    # actually consumes them; otherwise scheduling graph K+1\n                    # before graph K would falsely free graph K's qkv slot.\n                    if not getattr(self, \"_v1_prefill_raw_external_war\",\n                                   False):\n                        war[(layer_id - 1) % P].record(self.exec_stream)\n                    # WAR: this H2D overwrites slot L%P, last read by layer\n                    # (L-PARITY)'s GEMM.  Layers < PARITY are first occupants\n                    # (fresh buffer) → no prior reader → skip.\n                    if layer_id >= P:\n                        self.load_weight_stream.wait_event(war[layer_id % P])\n                with torch.cuda.stream(self.load_weight_stream):\n                    output.view(src.shape).copy_(src, non_blocking=True)\n                # RAW: record weight-ready on load_weight_stream so the FX\n                # wait_frozen_weight makes the GEMM wait for THIS H2D.  Suppress\n                # the caller's default exec-stream record (it would shadow this\n        # kept running on the decode path even though the fused forward was\n        # installed).\n        reg = getattr(self, \"_fused_reg\", None)\n        _slots = self._FUSED_REG_SLOTS_PER_LAYER\n        # When --fused-mm is on and a (layer, component) has the override\n        # installed, the dense reconstruct is redundant: the rewritten\n        # Linear.forward consumes the compressed buffer (or frozen_split staging\n        # slot) through the custom op.  The decomp_weight_stream context is the\n        # *current* stream only for an external dense reconstruct, so when every\n        # tensor is fused-skipped (the all-fused decode path) the context is dead\n        # — and entering it once per graph piece (~81x/step) was the single\n        # biggest per-iteration data-stack-churn site.  ``torch.cuda.stream(None)`` is\n        # a no-op, so we skip it entirely in that case.  H2D stays on\n        # load_weight_stream and all events record on explicit streams.\n        # DECODE: a registry entry means the custom op owns the whole decision.\n        # The loader stages compressed bytes only; linear_apply selects fused\n        # GEMM vs one decompress+cuBLAS at the point of use.  Repeating the\n        # threshold decision here used to launch a dense reconstruct before the\n        # graph and then decompress the same QKV again inside the custom op.\n        # PREFILL: captured-size chunks keep compressed staging; only an eager\n        # chunk above the CUDA graph ceiling clears the flag and materializes\n        # raw_bf16 for the custom op's dense-primary branch.\n        #\n        # Static per-(call-site, layer) memo: component lookup, registry\n        # presence, and split ownership are fixed for the run.\n        _cache = getattr(self, \"_dft_static_cache\", None)\n        if _cache is None:\n            _cache = self._dft_static_cache = {}\n        _ckey = (id(tensor_names), layer_id)\n        _cent = _cache.get(_ckey)\n        if (_cent is None or _cent[0] is not tensor_names\n                or _cent[3] is not reg):\n            comp_keys = [self.tensor_to_component.get(n) for n in tensor_names]\n            _static = []\n            for _name, _ck in zip(tensor_names, comp_keys):\n                _cid = _FUSED_MM_COMP_TO_ID.get(_ck) if _ck else None\n                _entry = (reg[layer_id * _slots + _cid]\n                          if (reg is not None and _cid is not None\n                              and layer_id * _slots + _cid < len(reg))\n                          else None)\n                # frozen_split tensors own the raw_bf16 prefill crossover (run in\n                # _decompress_frozen_split_for_name); flag them so the per-step\n                # loop can clear the fuse flag on prefill.\n                _is_split = (split_data is not None and _name in split_data)\n                _static.append((_entry is not None, _is_split))\n            _cent = (tensor_names, comp_keys, _static, reg)\n            _cache[_ckey] = _cent\n        comp_keys = _cent[1]\n        _N = self.cur_num_tokens\n        fused_flags = []\n        need_decomp_ctx = False\n        for _is_fused, _is_split in _cent[2]:\n            _f = _is_fused\n            if (_f and _is_split\n                    and self.batch_has_prefill and self.use_prefill_raw_bf16\n                    and self._cudagraph_ceiling and _N > self._cudagraph_ceiling):\n                # LARGE prefill (chunk > cudagraph capture ceiling): this batch\n                # runs EAGER (stock vLLM sends num_tokens > max_cudagraph_capture\n                # _size to CUDAGraphMode.NONE), so clear the flag and let\n                # _decompress_frozen_split_for_name materialize the dense\n                # primary through its independent prefill-alt/raw cutoff. The\n                # fused op's large-prefill branch then reads that primary.\n                # SMALL prefill (<= ceiling) is CAPTURED and shares the decode\n                # graph, so KEEP the flag (skip_kernel=True) → H2D the compressed\n                # staging only and let the in-graph custom op decompress it,\n                # exactly like decode (UNIFY: same captured op, same staging).\n                _f = False\n            fused_flags.append(_f)\n            if not _f:\n                need_decomp_ctx = True\n        # Prefill materializes a dense primary consumed by the eager GEMM. The\n        # raw branch can put its H2D on load_weight_stream, while prefill-alt\n        # puts only H2D there and keeps its decoder on decomp_weight_stream.\n        # Enter the decomp context so both paths return to the stream on which\n        # the dense-primary readiness event and consuming work are ordered.\n        if self.batch_has_prefill:\n            need_decomp_ctx = True\n        # All-fused decode (no projection runs a dense reconstruct kernel): the\n        # only GPU work per projection is the H2D on load_weight_stream, so hold\n        # ONE load_weight_stream context for the whole loop and let each\n        # _decompress_frozen_split_for_name skip its own per-projection\n        # stream context (h2d_ctx_held).  Non-fused/prefill keep decomp_weight_stream\n        # (the reconstruct kernel needs it) and the per-projection inner H2D\n        # context.  (was: torch.cuda.stream(None) for all-fused -> per-projection churn.)\n        _all_fused_h2d = not need_decomp_ctx\n        if (_ENV_ANY_WLOAD_GRAPH\n                and torch.cuda.is_current_stream_capturing()\n                and not getattr(DualMemoryLoader, \"_wlg_dft_dbg\", False)):\n            DualMemoryLoader._wlg_dft_dbg = True\n            logger.warning(\n                \"[WLG] decompress_frozen_tensors during CAPTURE L%d names=%s \"\n                \"all_fused=%s split=%s comp=%s\", layer_id, tensor_names,\n                _all_fused_h2d, bool(split_data), bool(comp_data))\n        # #8: in the all-fused path, COLLECT each projection's (dst,src,h2d_event)\n        # and issue ONE batch_memcpy after the loop (the WAR waits all run in the\n        # loop first), instead of one batch_memcpy per projection.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05bae-ef18-7720-b869-6aa3459e3ab2","create_time":1788244637.8865423}}}
