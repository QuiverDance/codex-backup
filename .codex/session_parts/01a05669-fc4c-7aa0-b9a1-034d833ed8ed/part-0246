 if (getattr(compressor, \"_fused_max_n_override\", None) is None\n                        and _thr_fn is not None\n                        and _thr_fn(int(shell.M), int(shell.K)) <= 0):\n                    logger.info(\n                        \"fused_mm: skip override for %s (M=%d K=%d) — fused \"\n                        \"threshold 0; native frozen_split decomp preserves \"\n                        \"WDecomp attribution\",\n                        name, int(shell.M), int(shell.K))\n                    continue\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx,\n                    comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                    mode=\"frozen_split\", tensor_name=name)\n\n    def _install_offload_compressed_fused_mm_overrides(self):\n        \"\"\"Install fused decompress+GEMM overrides for ``offload_compressed``\n        cells (e.g. flexgen-comp).  Active whenever ``--fused-mm`` is on.\n\n        Runs AFTER the offload GPU staging (``_comp_transfer_bufs`` /\n        ``register_temp_d_tensor``) and the dense ``primary_buffers`` are bound,\n        so the shell can alias the per-decode ``_d_*`` staging and bind the\n        primary buffer as ``fused_mm``'s large-N decompress target.\n\n        Only codecs WITHOUT a per-shape ``_fused_max_n_for`` (zipserv via the\n        auto wrapper) are eligible: their ``fused_mm`` decides fused-kernel vs\n        decompress+cuBLAS internally per N, so decode never falls back to\n        ``orig_forward`` and the load path can unconditionally skip the dense\n        decompress.  Codecs that expose ``_fused_max_n_for`` (p4flat / ublb)\n        would need per-step dense/fused coordination on the load path — not\n        wired here.\n\n        WAR/RAW correctness: the load path (``_fused_offload_h2d``) WAR-waits\n        the per-(name, slot) kernel_done event before each H2D and then issues\n        ``decomp_weight_stream.wait_stream(load_weight_stream)`` so the exec\n        barrier the wrapper records (entry[4]) follows the H2D; the fused op\n        waits that barrier and records kernel_done (entry[5]).\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        installed = 0\n        for idx in self.not_frozen_layers:\n            comp_secondary = self.comp_secondary_buffers[idx]\n            if comp_secondary is None:\n                continue\n            block = self.torch_model.decoder_blocks[idx]\n            for name, comped in comp_secondary.items():\n                comp_key = self.tensor_to_component.get(name)\n                comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key)\n                if comp_id is None:\n                    continue\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    block.is_frozen)\n                if mode != \"offload_compressed\":\n                    continue\n                compressor = self._compressor_for_cell(idx, comp_key, mode=mode)\n                if not getattr(compressor, \"HAS_FUSED_MM\", False):\n                    continue\n                # Per-step-threshold codecs (p4flat/ublb) fall back to\n                # orig_forward above their N threshold, which would read the\n                # dense primary buffer the fused load path stops populating —\n                # unsupported here; keep them on the dense decompress path.\n                if getattr(compressor, \"_fused_max_n_for\", None) is not None:\n                    logger.info(\n                        \"fused_mm: offload fused unsupported for per-threshold \"\n                        \"codec %s — skipping %s (keeps dense decompress)\",\n                        type(compressor).__name__, name)\n                    continue\n                primary = (self.primary_buffers[idx].get(name)\n                           if self.primary_buffers[idx] else None)\n                try:\n                    shell = compressor.build_offload_shell(comped, primary)\n                except (NotImplementedError, AttributeError,\n                        TypeError, RuntimeError) as e:\n                    logger.info(\n                        \"fused_mm: cannot build offload shell for %s via %s \"\n                        \"— skipping (%s)\", name, type(compressor).__name__, e)\n                    continue\n                leaf_name, _, _tn = name.rpartition(\".\")\n                leaf_module = block.module.get_submodule(leaf_name)\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx, comp_id=comp_id,\n                    mode=\"offload_compressed\", tensor_name=name)\n                if self._is_fused_offload_cell(idx, comp_id):\n                    installed += 1\n        if installed:\n            logger.info(\n                \"[fused-mm] offload_compressed: installed %d fused override(s)\"\n                \" — decode H2Ds the compressed blob into the _d_* staging and \"\n                \"skips the dense decompress (WDecomp -> Compute); profile_run/\"\n                \"warmup short-circuit to zeros. N>thr -> in-graph decomp+cuBLAS\"\n                \" into the primary buffer; prefill stays native.\", installed)\n\n    def _release_unused_primary_buffers_after_fused_mm(self):\n        \"\"\"Reclaim ``frozen_primary_buffer_pair`` / ``_temp_buffers``\n        slots whose every consumer layer has had the ``--fused-mm``\n        forward override installed.\n\n        For Llama-70B all-frozen-split this recovers ~3.2 GiB of HBM\n        (2 parity copies × 4 components × per-projection size).  The\n        replacement ``module.weight`` is a zero-element Parameter of\n        matching dtype/device — sufficient for any vLLM helper that\n        only consults metadata, and unreachable from the actual\n        forward path now that the fused override is in place.\n\n        Safety: Inductor's AOT-compiled FX graph for this model does\n        NOT extract qkv/o/gate_up/down projection weights as args\n        (verified via traced node listing — only layernorm weights\n        appear), so the compiled graph keeps working with the 0-size\n        replacement Parameters.  If a backend ever does need to read\n        ``module.weight``, this path will surface immediately as a\n        shape mismatch and we can gate the release behind a flag.\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        if not hasattr(self, \"_fused_reg\") or self._fused_reg is None:\n            return\n        if not hasattr(self, \"frozen_primary_buffer_pair\"):\n            return\n        if not getattr(self, \"_temp_buffers\", None):\n            return\n\n        # Releasing the dense-weight primary buffers assumes the fused override\n        # replaces EVERY forward. The threshold-based fused (ublb_flat / p4flat)\n        # only handles DECODE up to the codec's per-shape fused-N threshold;\n        # prefill still\n        # materialises the dense weight in the primary buffer\n        # (_decompress_frozen_split_for_name's prefill branch copies raw_bf16 /\n        # runs the reconstruct into it) and above-threshold decode falls back to\n        # decompress+matmul. Freeing it then leaves that path with output=None\n        # ('NoneType' has no attribute 'view'). Keep the buffers by default;\n        # opt in only for a config where fused provably covers all forwards.\n        if os.environ.get(\"TIERED_SERVE_FUSED_RELEASE_PRIMARY\", \"0\") != \"1\":\n            return\n\n        parity_max = self.FROZEN_DECOMP_PARITY\n        slots_per_layer = self._FUSED_REG_SLOTS_PER_LAYER\n\n        freeable_names: list[str] = []\n        for name in list(self.frozen_primary_buffer_pair.keys()):\n            comp_key = self.tensor_to_component.get(name)\n            comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key) if comp_key else None\n            if comp_id is None:\n                continue\n            # Every layer whose residency mode reads from this primary\n            # buffer must have a fused_mm registry entry.  Offload modes\n            # use the pool too (write target for non-frozen layers) so\n            # we conservatively skip when ANY layer's mode requires the\n            # dense weight to be present.\n            all_fused = True\n            for idx in range(self.n_layers):\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    self.torch_model.decoder_blocks[idx].is_frozen)\n                if mode in (\"frozen_compressed\", \"frozen_split\"):\n                    entry = self._fused_reg[idx * slots_per_layer + comp_id]\n                    if entry is None:\n                        all_fused = False\n                        break\n                else:\n                    # offload / offload_uncompressed / offload_compressed:\n                    # the buffer is the write target of an active\n                    # decompress; can't free.\n                    all_fused = False\n                    break\n            if all_fused:\n            # staging). info.sign_mantissa is the same buffer in that case.\n            _canon = (info.sign_mantissa\n                      if getattr(info, \"_uses_canonical_sm\", False) else None)\n            backend_compressor._ext.decompress(\n                info.sign_mantissa,\n                src_bufs[\"compressed_full\"].narrow(0, 0, ln[\"compressed_full\"]),\n                src_bufs[\"bitmap1\"].narrow(0, 0, ln[\"bitmap1\"]),\n                src_bufs[\"bitmap2\"].narrow(0, 0, ln[\"bitmap2\"]),\n                src_bufs[\"bitmap3\"].narrow(0, 0, ln[\"bitmap3\"]),\n                info.hbm_buffers[\"tile_offsets_median\"],\n                info.hbm_buffers[\"tile_offsets_global\"],\n                info.max_high_freq_count,\n                info.max_full_count,\n                info.start_exp,\n                output,\n                info.M, info.K,\n                gt_m_base, num_row_tiles,\n                _canon)\n\n    def _ensure_prefill_war_events(self):\n        \"\"\"Lazily allocate per-(comp, parity) WAR events for the prefill\n        raw_bf16 path.\n\n        When --fused-mm routes a large prefill chunk through raw_bf16, the\n        2*M*K H2D into the primary buffer moves OFF exec onto\n        ``load_weight_stream`` (so the slow C2C copy overlaps the prefill\n        GEMMs instead of serialising on exec, since\n        ``decomp_weight_stream == exec_stream``).  The primary buffer is then\n        a cross-stream resource shared across parity-PARITY layers, so the\n        next layer's H2D must wait until the previous occupant's GEMM (exec)\n        has finished reading it.  One event per (comp, parity); pre-recorded\n        so the first PARITY layers (fresh buffers) never block on a\n        never-recorded event.\n        \"\"\"\n        if getattr(self, \"_prefill_war_events\", None) is not None:\n            return\n        self._prefill_war_events = {\n            comp_key: [torch.cuda.Event(external=True)\n                       for _ in range(self.FROZEN_DECOMP_PARITY)]\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n        }\n        for events in self._prefill_war_events.values():\n            for ev in events:\n                ev.record()  # pre-signal\n\n    def _decompress_frozen_split_for_name(self, layer_id: int, name: str,\n                                          info, skip_kernel: bool = False,\n                                          h2d_ctx_held: bool = False,\n                                          collect_into=None\n                                          ) -> None:\n        \"\"\"Per-name frozen_split decode-path decompress: H2D LPDDR→GPU\n        staging then backend-specific decompress + reconstruct.  The fused\n        H2D-only caller may hold