} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\\\"\\n                  f\\\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\\\")\\n        del kc, vc; torch.cuda.empty_cache()\\n    comp.stop_kv_compress_workers()\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--limit\\\", type=int, default=max(NS))\\n    args = ap.parse_args()\\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\\n    hk, hv = load(2 * max(ns))\\n    for cls, name in [(P4FlatCPUKVCompressor, \\\"p4flat\\\"),\\n                      (UBLBFlatCPUKVCompressor, \\\"ublb_flat\\\"),\\n                      (BitcompCPUKVCompressor, \\\"bitcomp\\\")]:\\n        bench(cls, name, hk, hv, ns)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05763-68a2-74f2-a524-d67eb0eee000","create_time":1788173281.4087365}}}
