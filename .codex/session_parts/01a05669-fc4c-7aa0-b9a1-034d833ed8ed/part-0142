\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\n    V = torch.stack([t.contiguous() for t in obj[\"v_blocks\"][:n_max]]).reshape(n_max, *BS)\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\n\n\ndef bench(cls, name, hk, hv, ns):\n    comp = cls(torch.cuda.Stream())\n    pool = 2 * max(ns)\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=pool, n_layers=1,\n                           max_gpu_blocks=pool, max_gpu_decomp_blocks=pool)\n    print(f\"  {name}\")\n    for N in ns:\n        # Compress 2N blocks (slots 0..2N-1), then decode N of them two ways:\n        #   contig  = block ids [0..N-1]      -> slots 0..N-1   (sequential reads)\n        #   scatter = block ids [0,2,..,2N-2] -> slots 0,2,..   (paged/fragmented,\n        #             the production pattern where block_table is non-contiguous)\n        # decompress_batch writes output id-indexed (kc[id]=block id), so kc is\n        # sized 2N and we compare/measure only the decoded subset.\n        M = 2 * N\n        comp._kv_active_count[0] = 0; comp._kv_slot[0].fill_(-1)\n        comp.compress_batch_async_from_host(0, list(range(M)), hk[:M].contiguous(),\n                                            hv[:M].contiguous(), 0)\n        comp.wait_compress_async(0, BS)\n        kc = torch.zeros(M, *BS, dtype=torch.bfloat16, device=\"cuda\")\n        vc = torch.zeros_like(kc)\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\n        for label, dids in [(\"contig\", list(range(N))),\n                            (\"scatter\", list(range(0, M, 2)))]:\n            comp.decompress_batch(0, dids, (kc, vc)); torch.cuda.synchronize()\n            sel = torch.tensor(dids)\n            ke = (kc[sel].cpu() - hk[sel]).abs().max().item()\n            ve = (vc[sel].cpu() - hv[sel]).abs().max().item()\n            best = 1e9\n            for _ in range(20):\n                torch.cuda.synchronize(); t0 = time.perf_counter()\n                comp.decompress_batch(0, dids, (kc, vc))\n                torch.cuda.synchronize(); best = min(best, time.perf_counter() - t0)\n            print(f\"     N={N:>4} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\"\n                  f\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\")\n        del kc, vc; torch.cuda.empty_cache()\n    comp.stop_kv_compress_workers()\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--limit\", type=int, default=max(NS))\n    args = ap.parse_args()\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\n    hk, hv = load(2 * max(ns))\n    for cls, name in [(P4FlatCPUKVCompressor, \"p4flat\"),\n                      (UBLBFlatCPUKVCompressor, \"ublb_flat\"),\n                      (BitcompCPUKVCompressor, \"bitcomp\")]:\n        bench(cls, name, hk, hv, ns)\n\n\nif __name__ == \"__main__\":\n    main()\n","stderr":"","aggregated_output":"\"\"\"KV GPU decompress (decode) latency + throughput on the production decode\npath: decompress_batch -> decompress_batched (one batched CUDA kernel over the\nGPU-resident compressed block pool), for p4flat and ublb_flat.\n\nKV is compressed once (host encode) to populate the pool; only the GPU batched\ndecode is timed.  Independent of OMP_NUM_THREADS (pure GPU kernel + the codec's\ninternal staging).  GiB/s is over the decoded raw BF16 bytes (K+V).  This is the\ndecode side of the serving dense \"decomp+attention\" path; the encode side is\nkv_cpu_encode.py.\n\nRun from tiered-serve:\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmarks/kv_gpu_decode.py [--limit N]\n\"\"\"\nimport argparse\nimport time\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\n\nPATH = \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\"\nBS = (16, 8, 128)\nNS = [1024, 2048]            # decodes N of a 2N po