1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n            self._free_kv_slot(layer_id, block_id)\n\n    def compress_batch_async_from_host(\n        self,\n        layer_id: int,\n        block_ids: list,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        wait_event_handle: int = 0,\n    ) -> None:\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"compress_batch_async_from_host requires warmup_kv_buffers\")\n        if layer_id in self._pending_compress:\n            self.wait_compress_async(layer_id, tuple(host_k.shape[1:]))\n        num_source_blocks = host_k.shape[0]\n        block_array = np.asarray(block_ids, dtype=np.int64)\n        if block_array.size:\n            block_array = block_array[\n                (block_array >= 0) & (block_array < num_source_blocks)]\n        if block_array.size == 0:\n            return\n        decode_event_handle = int(\n            self._kv_dec_h2d[layer_id].cuda_event)\n        with self._slot_state_lock:\n            slots = self._assign_kv_slots(layer_id, block_array)\n            valid = self._persistent_valid[layer_id]\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\n            state = self._worker_state_for_layer(layer_id)\n            state[\"error\"] = None\n            state[\"done\"].clear()\n            pending = {\n                \"state\": state,\n                \"buffer_ids\": block_array,\n                \"physical_slots\": slots,\n            }\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_queue.put((\n                    state,\n                    (layer_id, host_k, host_v, block_array, slots,\n                     int(wait_event_handle), decode_event_handle),\n                ))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state[\"done\"].set()\n                raise\n\n    def _encode_chunk(\n        self,\n        layer_id: int,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        block_ids: np.ndarray,\n        slots: np.ndarray,\n        raw_event_handle: int,\n        decode_event_handle: int,\n    ) -> None:\n        self._pin_worker_thread()\n        start = time.perf_counter()\n        _sync_cuda_event(raw_event_handle)\n        raw_ready = time.perf_counter()\n        _sync_cuda_event(decode_event_handle)\n        encode_start = time.perf_counter()\n        block_tensor = torch.from_numpy(block_ids)\n        slot_tensor = torch.from_numpy(slots)\n        for source, kv in ((host_k, \"k\"), (host_v, \"v\")):\n            pool = self._host_pools[layer_id][kv]\n            _cd3_ext.host_encode_chunk_delta3_blocks(\n                source.view(torch.int16), block_tensor, slot_tensor,\n                pool[\"codes\"], pool[\"sign_mantissa\"],\n                pool[\"thread_bases\"], pool[\"tile_exception_offsets\"],\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                self._M_b, self._K_b,\n            )\n        finish = time.perf_counter()\n        with self._pin_lock:\n            self._timing_raw_wait += raw_ready - start\n            self._timing_decode_wait += encode_start - raw_ready\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        # Keep CPU 0-7 available to the serving/runtime threads by default;\n        # compression uses the fixed [8, 64) range on the measured 64-core\n        # host.  Keep the existing env name because it describes this prefix.\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        # Use one fixed 56-thread encoder team on the measured 64-core host,\n        # leaving eight CPUs for serving/runtime work.  Keep this dedicated cap\n        # independent of the main process's OMP_NUM_THREADS=1: libgomp maintains\n        # a team per encountering master, so sharing one global N creates\n        # overlapping ATen and encoder pools.  The per-worker cap is clamped to\n        # its affinity-block width and can still be overridden explicitly.\n        _omp_cap = os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", \"56\")\n        # Accept a comma-separated nested-team list for compatibility; this\n        # encoder has one parallel level, so only its first value is relevant.\n        self._omp_thread_cap = max(1, int(_omp_cap.split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as _e:\n            logger.warning(\"p4flat compress: libgomp.so.1 load failed \"\n                           \"(%s); OMP threads will use the process default\", _e)\n        self._pin_tls = threading.local()\n        self._pin_counter = [0]\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, Tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        # Diagnostic: split each compress worker call into GPU-event-wait\n        # (raw-D2H + decode-H2D) vs actual CPU encode, to tell whether the\n        # END-join is bound by waiting on the GPU or by the encode itself.\n        self._wt_wait = 0.0   # total event-wait\n        self._wt_wraw = 0.0   # raw-D2H (unload input) portion of the wait\n        self._wt_comp = 0.0\n        self._wt_n = 0\n        self._work_q = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        # A CPU worker captures physical persistent slots before it starts.\n        # If the scheduler frees/reuses the same canonical block id while that\n        # worker is pending, immediately returning the slot lets the old worker\n        # overwrite a new owner's blob (ABA). Quarantine such slots until the\n        # owning layer task retires.\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._workers = []\n        for i in range(_nw):\n            t = threading.Thread(\n                target=self._worker_loop,\n                daemon=True,\n                name=f\"p4flat-kv-cpu-{i}\")\n            t.start()\n            self._workers.append(t)\n        logger.info(\n            \"P4Flat CPU KV encoder: C++ OpenMP (host_encode_blocks), \"\n            \"%d worker(s), pin=%s, core_start=%d, omp_cap=%d, main_omp=%s\",\n            _nw, self._pin_workers, self._reserve_cores,\n            self._omp_thread_cap, os.environ.get(\"OMP_NUM_THREADS\", \"unset\"))\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_q.get()\n            if item is None:\n                return\n            state, args = item\n            try:\n                self._encode_chunk(*args)\n                state['error'] = None\n            except BaseException as exc:  # propagate through wait_compress_async\n                state['error'] = exc\n            finally:\n                state['done'].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {'done': done, 'error': None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state['done'].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for p4flat KV CPU worker\")\n        err = state.get('error')\n        if err is not None:\n            raise err\n\n    def _pin_worker_thread(self) -> None:\n        \"\"\"First task on each pool thread: pin to a disjoint core block and cap\n        its OpenMP team size (called at the top of _encode_chunk).\"\"\"\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        n = self._n_workers\n        with self._pin_lock:\n            idx = self._pin_counter[0] % n\n            self._pin_counter[0] += 1\n        # Respect an outer taskset/cgroup cpuset.  CPU IDs need not be dense, so\n        # split the actual allowed-ID list rather than constructing range(ncpu).\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            try:\n                # This ICV is local to the async worker's OpenMP task.  Keep\n                # libgomp from silently shrinking the dedicated encoder team\n                # even if the parent environment exported OMP_DYNAMIC=TRUE.\n                self._omp_lib.omp_set_dynamic(0)\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\n                    \"p4flat compress worker %d: omp_set_dynamic failed %s\",\n                    idx, _e)\n        if not self._pin_workers:\n            # Team sizing is independent of affinity pinning.  This matters\n            # when the production entry point keeps main ATen at OMP=1: an\n            # explicitly unpinned encoder must still receive its dedicated N.\n            nt = min(len(allowed), self._omp_thread_cap)\n            if self._omp_lib is not None:\n                try:\n                    self._omp_lib.omp_set_num_threads(int(nt))\n                except Exception as _e:  # noqa: BLE001\n                    logger.warning(\n                        \"p4flat compress worker %d: omp_set_num_threads \"\n                        \"failed %s\", idx, _e)\n            with self._pin_lock:\n                self._worker_affinities[idx] = tuple(allowed)\n                self._worker_omp_threads[idx] = nt\n            logger.info(\n                \"p4flat compress worker %d unpinned (%d allowed, OMP=%d)\",\n                idx, len(allowed), nt)\n            return\n        compress_cpus = [cpu for cpu in allowed\n                         if cpu >= self._reserve_cores]\n        if len(compress_cpus) < n:\n            logger.warning(\n                \"p4flat compress: only %d CPU(s) remain at/after core %d for \"\n                \"%d worker(s); falling back to the inherited affinity %s\",\n                len(compress_cpus), self._reserve_cores, n, allowed)\n            compress_cpus = allowed\n        # Limit the affinity itself to n*cap CPUs instead of letting a smaller\n        # team roam over every remaining CPU.  The default one-worker case is\n        # therefore exactly cores 8-63 on the measured 64-core host.\n        usable = compress_cpus[:min(\n            len(compress_cpus), n * self._omp_thread_cap)]\n        lo_i = len(usable) * idx // n\n        hi_i = len(usable) * (idx + 1) // n\n        block = set(usable[lo_i:hi_i])\n        if not block:\n            # Only possible with more workers than allowed CPUs.\n            block = {compress_cpus[idx % len(compress_cpus)]}\n        nt = len(block)\n        try:\n            os.sched_setaffinity(0, block)\n        except OSError as _e:\n            logger.warning(\"p4flat compress worker %d: setaffinity failed %s\",\n                           idx, _e)\n        if self._omp_lib is not None:\n            try:\n                self._omp_lib.omp_set_num_threads(int(nt))\n            except Exception as _e:  # noqa: BLE001\n                logger.warning(\"p4flat compress worker %d: omp_set_num_threads \"\n                               \"failed %s\", idx, _e)\n        affinity = tuple(sorted(block))\n        with self._pin_lock:\n            self._worker_affinities[idx] = affinity\n            self._worker_omp_threads[idx] = nt\n        logger.info(\n            \"p4flat compress worker %d -> cores %d-%d (%d allowed, OMP=%d), \"\n            \"cores 0-%d reserved for forward\",\n            idx, affinity[0], affinity[-1], len(affinity), nt,\n            self._reserve_cores - 1)\n\n    def _probe_sizes(self, M_b: int, K_b: int) -> Tuple[int, int, int, int]:\n        \"\"\"Analytic sizes — no GPU.  The CPU encoder stores sm row-major\n        (``row_major_sm=1``) and ``subtile_codec`` all-``0xFF``.\"\"\"\n        num_tiles = (M_b // 64) * (K_b // 64)\n        hb = num_tiles * 16\n        cb = M_b * K_b // 2\n        smb = M_b * K_b\n        cdb = (M_b // 16) * (K_b // 16)\n        self._idx_dtype = torch.int32\n        self._val_dtype = torch.int16\n        self._idx_es = 4\n        self._val_es = 2\n        self._row_major_sm = 1\n        return hb, cb, smb, cdb\n\n    # gpu_direct path is not supported on this subclass — it is the\n    # cpu_after_raw_swap encoder.  For GPU-side p4flat compression use the\n    # base P4FlatKVCompressor (selected by TIERED_SERVE_KV_COMP_PRODUCER=\n    # gpu_direct, which is the default for --kv-comp p4flat).\n    def compress_batch_async(self, layer_id, block_ids, gpu_k, gpu_v):\n        raise NotImplementedError(\n            \"P4FlatCPUKVCompressor is the CPU-encode (cpu_after_raw_swap) \"\n            \"backend; it does not support the gpu_direct producer.  For GPU \"\n            \"compression use TIERED_SERVE_KV_COMP_PRODUCER=gpu_direct (the \"\n            \"default for --kv-comp p4flat), which selects P4FlatKVCompressor.\")\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def _assign_kv_slots(self, layer_id: int, block_ids) -> \"np.ndarray\":\n        # The CPU producer can race scheduler free callbacks while its worker\n        # waits release the GIL. Serialize all slot ownership transitions.\n        with self._slot_state_lock:\n            return super()._assign_kv_slots(layer_id, block_ids)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Clear validity immediately and quarantine an in-flight slot.\n\n        The old CPU task may still write its captured ``slots_arr``. Keeping\n        that physical slot off the free heap until wait_compress_async retires\n        the task prevents it from corrupting a newly assigned block.\n        \"\"\"\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get('buffer_ids', ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64)\n            )\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_np = self._kv_slot_np.get(layer_id)\n                if slot_np is None or not 0 <= block_id < slot_np.size:\n                    return\n                slot = int(slot_np[block_id])\n                if slot < 0:\n                    return\n                slot_np[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n\n            self._free_kv_slot(layer_id, block_id)\n\n","exit_code":0,"duration":{"secs":0,"nanos":3392},"formatted_output":"    _USES_GPU_COMPRESS = False\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\n                _cd3_ext, \"host_encode_chunk_delta3_blocks\"):\n            raise RuntimeError(\n                \"ChunkDelta3CPUKVCompressor requires the CPU-enabled \"\n                \"tp3_cd3_ext\")\n        super().__init__(comp_stream)\n        self._slot_state_lock = threading.RLock()\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\n        self._work_queue = queue.SimpleQueue()\n        self._work_states: Dict[int, Dict[str, Any]] = {}\n        self._n_workers = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", \"1\")))\n        self._pin_workers = (\n            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n        self._reserve_cores = max(0, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n        self._omp_thread_cap = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", \"56\")\n            .split(\",\", 1)[0].strip()))\n        self._omp_lib = None\n        try:\n            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n        except OSError as error:\n            logger.warning(\n                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n                \"OpenMP defaults\", error)\n        self._pin_tls = threading.local()\n        self._pin_counter = 0\n        self._pin_lock = threading.Lock()\n        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n        self._worker_omp_threads: Dict[int, int] = {}\n        self._timing_raw_wait = 0.0\n        self._timing_decode_wait = 0.0\n        self._timing_encode = 0.0\n        self._timing_count = 0\n        self._workers = []\n        for index in range(self._n_workers):\n            worker = threading.Thread(\n                target=self._worker_loop, daemon=True,\n                name=f\"cd3-kv-cpu-{index}\")\n            worker.start()\n            self._workers.append(worker)\n        logger.info(\n            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n            \"core_start=%d omp_cap=%d\",\n            self._n_workers, self._pin_workers,\n            self._reserve_cores, self._omp_thread_cap)\n\n    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n                                 n_layers: int) -> None:\n        del n_workers, max_blocks, n_layers\n        if not self._kv_pools_ready:\n            raise RuntimeError(\n                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n\n    def _worker_loop(self) -> None:\n        while True:\n            item = self._work_queue.get()\n            if item is None:\n                return\n            state, arguments = item\n            try:\n                self._encode_chunk(*arguments)\n                state[\"error\"] = None\n            except BaseException as error:\n                state[\"error\"] = error\n            finally:\n                state[\"done\"].set()\n\n    def _worker_state_for_layer(self, layer_id: int) -> Dict[str, Any]:\n        state = self._work_states.get(layer_id)\n        if state is None:\n            done = threading.Event()\n            done.set()\n            state = {\"done\": done, \"error\": None}\n            self._work_states[layer_id] = state\n        return state\n\n    @staticmethod\n    def _wait_worker_state(state: Dict[str, Any],\n                           timeout_sec: float = -1.0) -> None:\n        timeout = None if timeout_sec is None or timeout_sec < 0 else timeout_sec\n        if not state[\"done\"].wait(timeout):\n            raise TimeoutError(\"Timed out waiting for CD3 KV CPU worker\")\n        error = state.get(\"error\")\n        if error is not None:\n            raise error\n\n    def _pin_worker_thread(self) -> None:\n        if getattr(self._pin_tls, \"done\", False):\n            return\n        self._pin_tls.done = True\n        with self._pin_lock:\n            index = self._pin_counter % self._n_workers\n            self._pin_counter += 1\n        allowed = sorted(os.sched_getaffinity(0))\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_dynamic(0)\n        if self._pin_workers:\n            compression_cpus = [\n                cpu for cpu in allowed if cpu >= self._reserve_cores]\n            if len(compression_cpus) < self._n_workers:\n                compression_cpus = allowed\n            usable = compression_cpus[:min(\n                len(compression_cpus),\n                self._n_workers * self._omp_thread_cap)]\n            begin = len(usable) * index // self._n_workers\n            end = len(usable) * (index + 1) // self._n_workers\n            affinity = set(usable[begin:end])\n            if not affinity:\n                affinity = {allowed[index % len(allowed)]}\n            try:\n                os.sched_setaffinity(0, affinity)\n            except OSError as error:\n                logger.warning(\n                    \"CD3 compress worker %d affinity failed: %s\",\n                    index, error)\n        else:\n            affinity = set(allowed)\n        omp_threads = min(len(affinity), self._omp_thread_cap)\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(omp_threads))\n        ordered = tuple(sorted(affinity))\n        with self._pin_lock:\n            self._worker_affinities[index] = ordered\n            self._worker_omp_threads[index] = omp_threads\n        logger.info(\n            \"CD3 compress worker %d -> %d CPUs (%d-%d), OMP=%d\",\n            index, len(ordered), ordered[0], ordered[-1], omp_threads)\n\n    def compress_batch_async(self, layer_id: int, block_ids: list,\n                             gpu_k: torch.Tensor,\n                             gpu_v: torch.Tensor) -> None:\n        raise NotImplementedError(\n            \"ChunkDelta3CPUKVCompressor uses cpu_after_raw_swap; \"\n            \"select gpu_direct explicitly for GPU encoding\")\n\n    def _assign_kv_slots(self, layer_id: int,\n             