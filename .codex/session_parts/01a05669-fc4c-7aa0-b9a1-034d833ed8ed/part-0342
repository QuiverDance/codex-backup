ODE_LOAD\", \"compressed\").lower()\n        if self.kv_decode_load_backend not in (\"compressed\", \"raw\"):\n            raise ValueError(\n                f\"Unknown TIERED_SERVE_KV_DECODE_LOAD: \"\n                f\"{self.kv_decode_load_backend!r}. Expected 'compressed' \"\n                \"or 'raw'.\")\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV decode load backend: %s\",\n                self.kv_decode_load_backend)\n        _prefill_comp_requested = (\n            os.getenv(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if _prefill_comp_requested and not DualMemoryLoader.use_kv_comp:\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 requires \"\n                \"TIERED_SERVE_USE_KV_COMP=1\"\n            )\n        if (\n            _prefill_comp_requested\n            and self.kv_decode_load_backend != \"compressed\"\n        ):\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 conflicts with \"\n                \"TIERED_SERVE_KV_DECODE_LOAD=raw\"\n            )\n        self.kv_comp_prefill_load = bool(_prefill_comp_requested)\n        DualMemoryLoader.kv_comp_prefill_load = (\n            self.kv_comp_prefill_load\n        )\n        # A mixed prefill needs current-layer KV materialisation: a preceding\n        # decode may have left a different parity-sharing layer in the dense\n        # staging cache.  The offline benchmark enables this for both its raw\n        # and compressed arms so they use the same safe schedule.  Resolve the\n        # policy once here; the per-piece wrapper only reads the cached bool.\n        self.kv_prefill_jit_current = (\n            os.getenv(\n                \"TIERED_SERVE_KV_PREFILL_JIT_CURRENT\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV prefill load backend: %s\",\n                (\n                    \"compressed\"\n                    if self.kv_comp_prefill_load\n                    else \"raw\"\n                ),\n            )\n        if self.kv_prefill_jit_current:\n            logger.info(\"KV prefill scheduling: current-layer JIT\")\n\n        # Per-step CPU-timer accumulators for the KV-comp pipeline.  Reset\n        # at layer 0 (step start) inside the load/unload paths; logged at\n        # the last layer (step end) inside unload_comped_kv.\n        self._step_unload_disp_ms = 0.0\n        self._step_comp_wait_ms = 0.0\n        # Reset once per forward in torch_hooks.before_model_forward.  The\n        # mixed-prefill benchmark uses this as a structural proof that at\n        # least one layer actually launched persistent compressed KV H2D,\n        # rather than merely having offloadable active block ids.\n        self.prefill_kv_comp_load_layers = 0\n\n        self._time_log_file = None\n        if self.collect_times:\n            log_dir = os.getenv(\"TIERED_SERVE_LOG_DIR\")\n            if log_dir:\n                os.makedirs(log_dir, exist_ok=True)\n                ts = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n                engine_id = os.getenv(\"TIERED_SERVE_ENGINE_ID\", \"unknown\")\n                log_path = os.path.join(\n                    log_dir, f\"{ts}_{engine_id}_collect_time.log\")\n                self._time_log_file = open(log_path, \"a\")\n                logger.info(f\"collect_time log: {log_path}\")\n\n        # raw_bf16 prefill capability: LPDDR keeps a full BF16 copy that an eager\n        # prefill may H2D directly into the dense primary buffer, skipping the\n        # reconstruct kernel.  The phase-adaptive prefill-alt policy below can\n        # still choose compressed H2D + reconstruct for chunks below its cutoff.\n        # Set TIERED_SERVE_PREFILL_RAW_BF16=0 to disable the raw materializer and\n        # use the split reconstruct path throughout prefill.\n        self.use_prefill_raw_bf16 = (\n            os.getenv(\"TIERED_SERVE_PREFILL_RAW_BF16\", \"1\") == \"1\")\n        logger.info(\"frozen_split prefill: raw_bf16 materializer %s\",\n                    \"ON\" if self.use_prefill_raw_bf16 else \"OFF (split reconstruct)\")\n        # cudagraph capture ceiling (= max_cudagraph_capture_size set by the entry\n        # script).  Splits prefill into: chunk <= ceiling → CAPTURED, reads the\n            compute_intervals = (\n                all_weight_decomp_intervals\n                + (kv_decomp_intervals if use_kv_comp else []))\n            if llm_active_intervals or compute_intervals:\n                compute_union = self._calc_exec_times(\n                    llm_active_intervals, compute_intervals)\n            else:\n                compute_union = []\n            # Compressed begin/end_memcpy_kv includes the decode-buffer/ring\n            # waits around the transfer.  Stall must use the same tight H2D\n            # interval as KVLoad, otherwise waits are counted as load-active.\n            canonical_kv_load_intervals = (\n                kv_h2d_intervals if kv_h2d_intervals else kv_memcpy_times)\n            load_union_all = self._calc_exec_times(\n                all_weight_load_intervals, canonical_kv_load_intervals)\n            load_total = sum(e - b for b, e in load_union_all)\n            load_in_compute = self._calculate_total_overlap(\n                load_union_all, compute_union)\n            stall_brk = max(0.0, load_total - load_in_compute)\n\n            # GPUFwd here is wall time between begin_forward_event and\n            # end_forward_event — pure GPU forward.  Python-side TPOT\n            # (engine.step()) additionally includes scheduler, sampling,\n            # logits processing and output assembly running on CPU\n            # serially after the GPU forward finishes; that gap is\n            # visible by comparing this line to the [Step] StepLatency\n            # line emitted by offline_offload_kvweight.py.\n            # Reported metrics (per-step wall-clock on GPU):\n            #   Compute  — GEMM + Attention on cur_stream (exec union).\n            #              A fused decode+GEMM kernel (``--fused-mm``) runs\n            #              ON cur_stream, so its decompression is folded\n            #              into Compute, NOT WDecomp.  WDecomp only sees\n            #              decompression that runs on the separate\n            #              decomp_weight_stream.\n            #   WDecomp  — weight decompression on decomp_weight_stream\n            #   KVDecomp — KV decompression on the KV decomp stream(s).  This\n            #              runs CONCURRENTLY with Compute (it is prefetched a\n            #              layer ahead), so it is NOT carved out of Compute and\n            #              is NOT part of the additive GPUFwd tiling — it is a\n            #              standalone stream-busy figure that overlaps Compute.\n            #              When --kv-comp is toggled Compute therefore stays\n            #              ~constant and KVDecomp simply appears on top.\n            #   WLoad    — weight H2D on load_weight_stream\n            #   KVLoad   — KV H2D on load_kv_stream\n            #   Stall    — Load-active wall time that NO compute\n            #              (Compute / WDecomp / KVDecomp) was overlapping;\n            #              i.e. we paid memory bandwidth but the model\n            #              didn't advance.\n            brk_msg = (\n                f\"{prefix} [Breakdown] \"\n                f\"GPUFwd: {total_time:.4f} | \"\n                f\"Compute: {llm_brk:.4f} \"\n                f\"WDecomp: {wdecomp_brk:.4f} \"\n                f\"KVDecomp: {kvdecomp_brk:.4f} \"\n                f\"WLoad: {wload_brk:.4f} \"\n                f\"KVLoad: {kvload_brk:.4f} \"\n                f\"Stall: {stall_brk:.4f}\")\n            # Both