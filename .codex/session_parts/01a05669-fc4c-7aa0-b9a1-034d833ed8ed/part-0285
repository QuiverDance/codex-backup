_max_n_for(8192, 28672) == 128\n\n\ndef test_split_shell_narrows_shared_staging_capacity() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(29)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    lpddr = {\n        attr: getattr(compressed, attr)\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n    }\n    info = SplitStorageInfo(\n        compressed.sign_mantissa,\n        lpddr,\n        {\n            \"M\": compressed.M,\n            \"K\": compressed.K,\n            \"num_exceptions\": compressed.num_exceptions,\n        },\n        backend=\"chunk_delta3\",\n        hbm_buffers={\n            \"tile_exception_offsets\": compressed.tile_exception_offsets,\n        },\n    )\n    staging = {}\n    for attr, source in lpddr.items():\n        capacity = source.numel() + 17\n        staging[attr] = torch.empty(\n            capacity, dtype=source.dtype, device=source.device)\n        staging[attr][:source.numel()].copy_(source.reshape(-1))\n\n    shell = codec.build_split_shell(info, staging)\n    for attr, source in lpddr.items():\n        assert getattr(shell._c, attr).numel() == source.numel()\n    restored = codec.decompress(shell)\n    torch.cuda.synchronize()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\ndef test_frozen_split_keeps_offsets_with_sign_mantissa_in_hbm() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_cpu_weight_encode_stages_and_roundtrips_bit_exact() -> None:\n    codec = _codec()\n    generator = torch.Generator().manual_seed(911)\n    source = torch.randn(\n        256, 256, generator=generator, dtype=torch.float32\n    ).to(torch.bfloat16).contiguous()\n\n    compressed = codec.compress(source)\n    assert compressed.sign_mantissa.device.type == \"cpu\"\n    output = torch.empty(source.shape, dtype=source.dtype, device=\"cuda\")\n    compressed.register_temp_d_tensor(output)\n    compressed.to(non_blocking=False)\n    restored = codec.decompress(compressed, output)\n    torch.cuda.synchronize()\n\n    _assert_bit_exact(restored.cpu(), source)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\ndef test_cpu_kv_encoder_matches_gpu_and_roundtrips() -> None:\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\n\n    generator = torch.Generator().manual_seed(123)\n    source = torch.randn(\n        4, 128, 128, generator=generator, dtype=torch.float32\n    ).to(torch.bfloat16).contiguous()\n    block_ids = torch.tensor([2, 0, 3], dtype=torch.int64)\n    slots = torch.tensor([3, 1, 4], dtype=torch.int64)\n    n = block_ids.numel()\n    host_n = 5\n    tiles = 4\n    code_bytes = tiles * 1536\n    base_bytes = tiles * 256\n    packed_capacity = 256\n\n    cpu = {\n        \"codes\": torch.empty(host_n, code_bytes, dtype=torch.uint8),\n        \"sign_mantissa\": torch.empty(\n            host_n, 128 * 128, dtype=torch.uint8),\n        \"thread_bases\": torch.empty(host_n, base_bytes, dtype=torch.uint8),\n        \"tile_exception_offsets\": torch.empty(\n            host_n, tiles + 1, dtype=torch.int32),\n        \"entries20x3\": torch.empty(\n            host_n, packed_capacity, dtype=torch.int64),\n        \"num_exceptions\": torch.empty(host_n, dtype=torch.int32),\n    }\n    _cd3_ext.host_encode_chunk_delta3_blocks(\n        source.view(torch.int16), block_ids, slots,\n        cpu[\"codes\"], cpu[\"sign_mantissa\"], cpu[\"thread_bases\"],\n        cpu[\"tile_exception_offsets\"], cpu[\"entries20x3\"],\n        cpu[\"num_exceptions\"], 128, 128,\n    )\n\n    selected = source[block_ids].cuda()\n    gpu = {\n        \"codes\": torch.empty(n, code_bytes, dtype=torch.uint8, device=\"cuda\"),\n        \"sign_mantissa\": torch.empty(\n            n, 128 * 128, dtype=torch.uint8, device=\"cuda\"),\n        \"thread_bases\": torch.empty(\n            n, base_bytes, dtype=torch.uint8, device=\"cuda\"),\n        \"tile_exception_offsets\": torch.empty(\n            n, tiles + 1, dtype=torch.int32, device=\"cuda\"),\n        \"entries20x3\": torch.empty(\n            n, packed_capacity, dtype=torch.int64, device=\"cuda\"),\n        \"num_exceptions\": torch.empty(n, dtype=torch.int32, device=\"cuda\"),\n    }\n    _cd3_ext.compress_chunk_delta3_batched(\n        selected, gpu[\"codes\"], gpu[\"sign_mantissa\"],\n        gpu[\"thread_bases\"], gpu[\"tile_exception_offsets\"],\n        gpu[\"entries20x3\"], gpu[\"num_exceptions\"],\n    )\n    torch.cuda.synchronize()\n\n    for name in cpu:\n        actual = cpu[name][slots]\n        expected = gpu[name].cpu()\n        assert torch.equal(actual, expected), name\n\n    restored = torch.empty_like(selected)\n    _cd3_ext.decompress_chunk_delta3_batched(\n        cpu[\"codes\"][slots].cuda(),\n        cpu[\"sign_mantissa\"][slots].cuda(),\n        cpu[\"thread_bases\"][slots].cuda(),\n        cpu[\"tile_exception_offsets\"][slots].cuda(),\n        cpu[\"entries20x3\"][slots].cuda(), restored,\n    )\n    torch.cuda.synchronize()\n    _assert_bit_exact(restored, selected)\n\n\ndef test_cpu_kv_backend_async_roundtrip_and_pending_free() -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3CPUKVCompressor,\n    )\n\n    compressor = ChunkDelta3CPUKVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        # Freeing an ID after enqueue must quarantine its captured slot; the\n        # retiring worker may finish writing it but must not republish it.\n        compressor.free_persistent_block(0, 1)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        compressor.decompress_batch(\n            0, [1, 3, 6], output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        active = [2, 6]\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n\n        compressor.free_persistent_block(0, 6)\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(v_cache[2].cpu(), host_v[2])\n        assert torch.count_nonzero(k_cache[6]).item() == 0\n        assert torch.count_nonzero(v_cache[6]).item() == 0\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 16, 32, 40, 48, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected =