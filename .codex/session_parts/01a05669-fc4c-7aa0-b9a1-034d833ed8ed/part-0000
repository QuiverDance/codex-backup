s_bases[Stages][256];        // base per 16-value chunk\\n+    alignas(16) uint8_t s_exc_exp[Stages][4096];     // valid where mask bit is 1\\n+    alignas(16) uint32_t s_exc_mask[Stages][128];    // one bit per tile value\\n+};\\n+\\n+__device__ __forceinline__ uint32_t cd3_unpack_entry17(\\n+    const uint8_t* entries, int64_t index)\\n+{\\n+    const int64_t bit = index * 17;\\n+    const int64_t byte = bit >> 3;\\n+    const int shift = static_cast<int>(bit & 7);\\n+    const uint32_t word = static_cast<uint32_t>(entries[byte])\\n+        | (static_cast<uint32_t>(entries[byte + 1]) << 8)\\n+        | (static_cast<uint32_t>(entries[byte + 2]) << 16);\\n+    return (word >> shift) & 0x1ffffu;\\n+}\\n+\\n+template <int TileN, class MmaOp, int Stages>\\n+__global__ void cd3_rs_kernel(\\n+    const uint8_t*       __restrict__ codes_g,\\n+    const uint8_t*       __restrict__ sm_g,\\n+    const uint8_t*       __restrict__ bases_g,\\n+    const int32_t*       __restrict__ tile_offsets_g,\\n+    const uint16_t*      __restrict__ warp_prefixes_g,\\n+    const uint8_t*       __restrict__ entries17_g,\\n+    const __nv_bfloat16* __restrict__ B_g,\\n+    __nv_bfloat16*       __restrict__ C_g,\\n+    float*               __restrict__ Cf32_g,\\n+    int M, int N, int K, int split_k)\\n+{\\n+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)\\n+    using namespace cute;\\n+    constexpr int kTileM = 64, kTileK = 64;\\n+    using Smem = CD3RSSmem<TileN, Stages>;\\n+    extern __shared__ __align__(128) uint8_t raw_smem[];\\n+    Smem& smem = *reinterpret_cast<Smem*>(raw_smem);\\n+    auto sB = make_tensor(make_smem_ptr(smem.B.begin()), typename Smem::SmemLayoutB{});\\n+\\n+    const int tid = static_cast<int>(threadIdx.x);\\n+    const int tile_n = static_cast<int>(blockIdx.x);\\n+    const int tile_m = static_cast<int>(blockIdx.y);\\n+    const int tiles_k = K >> 6;\\n+    const int split_idx = static_cast<int>(blockIdx.z);\\n+    const int tk_split = tiles_k / split_k;\\n+    const int k0 = split_idx * tk_split;\\n+\\n+    auto mB = make_tensor(make_gmem_ptr(reinterpret_cast<const bfloat16_t*>(B_g)),\\n+                          make_layout(make_shape(N, K), make_stride(K, Int<1>{})));\\n+    auto gB = local_tile(mB, make_shape(Int<TileN>{}, Int<kTileK>{}),\\n+                         make_coord(tile_n, _));\\n+    using G2S = Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL<uint128_t>, bfloat16_t>;\\n+    auto tiled_copy = make_tiled_copy(G2S{},\\n+        Layout<Shape<_16, _8>, Stride<_8, _1>>{}, Layout<Shape<_1, _8>>{});\\n+    auto thr_copy = tiled_copy.get_slice(tid);\\n+    auto tBgB = thr_copy.partition_S(gB);\\n+    auto tBsB = thr_copy.partition_D(sB);\\n+\\n+    auto gC = make_tensor(make_gmem_ptr(reinterpret_cast<bfloat16_t*>(C_g)),\\n+                          make_layout(make_shape(M, N), make_stride(Int<1>{}, M)));\\n+    auto gC_tile = local_tile(gC, make_shape(Int<kTileM>{}, Int<TileN>{}),\\n+                              make_coord(tile_m, tile_n));\\n+    auto tiled_mma = make_tiled_mma(MmaOp{});\\n+    auto thr_mma = tiled_mma.get_thread_slice(tid);\\n+    auto tCrC = thr_mma.partition_fragment_C(gC_tile);\\n+    clear(tCrC);\\n+    auto tCrB = thr_mma.make_fragment_B(thr_mma.partition_B(sB));\\n+\\n+    using SmemLayoutA = decltype(tile_to_shape(\\n+        GMMA::Layout_K_SW128_Atom<bfloat16_t>{},\\n+        make_shape(Int<kTileM>{}, Int<kTileK>{})));\\n+    auto sA_dummy = make_tensor(make_smem_ptr(static_cast<bfloat16_t*>(nullptr)),\\n+                                SmemLayoutA{});\\n+    auto tCrA = thr_mma.partition_fragment_A(sA_dummy);\\n+    auto cA = make_identity_tensor(make_shape(Int<kTileM>{}, Int<kTileK>{}));\\n+    auto tCcA = thr_mma.partition_A(cA);\\n+\\n+    auto load_b = [&](int k_tile, int pipe) {\\n+        copy(tiled_copy, tBgB(_, _, _, k_tile), tBsB(_, _, _, pipe));\\n+    };\\n+\\n+    auto load_compressed = [&](int k_tile, int st) {\\n+        const int tile_idx = tile_m * tiles_k + k_tile;\\n+        const int64_t cbase = static_cast<int64_t>(tile_idx) * 1536;\\n+        const int64_t sbase = static_cast<int64_t>(tile_idx) * 4096;\\n+        const int64_t bbase = static_cast<int64_t>(tile_idx) * 256;\\n+        if (tid < 96)\\n+            cp_async_16(&smem.s_codes[st][tid << 4], codes_g + cbase + (tid << 4));\\n+        #pragma unroll\\n+        for (int j = 0; j < 2; ++j) {\\n+            const int chunk = tid + j * 128;\\n+            cp_async_16(&smem.s_sm[st][chunk << 4], sm_g + sbase + (chunk << 4));\\n+        }\\n+        if (tid < 16)\\n+            cp_async_16(&smem.s_bases[st][tid << 4], bases_g + bbase + (tid << 4));\\n+    };\\n+\\n+    auto build_exception_map = [&](int k_tile, int st) {\\n+        smem.s_exc_mask[st][tid] = 0;\\n+        __syncthreads();\\n+        const int tile_idx = tile_m * tiles_k + k_tile;\\n+        const int begin = tile_offsets_g[tile_idx];\\n+        const int end = tile_offsets_g[tile_idx + 1];\\n+        for (int e = begin + tid; e < end; e += 128) {\\n+            const int local = e - begin;\\n+            int warp = 0;\\n+            #pragma unroll\\n+            for (int w = 1; w < 8; ++w)\\n+                warp += local >= static_cast<int>(\\n+                    warp_prefixes_g[static_cast<int64_t>(tile_idx) * 8 + w]);\\n+            const uint32_t entry = cd3_unpack_entry17(entries17_g, e);\\n+            const int pos = warp * 512 + static_cast<int>(entry & 0x1ffu);\\n+            smem.s_exc_exp[st][pos] = static_cast<uint8_t>(entry >> 9);\\n+            atomicOr(&smem.s_exc_mask[st][pos >> 5], 1u << (pos & 31));\\n+        }\\n+        __syncthreads();\\n+    };\\n+\\n+    auto decode_regA = [&](int st) {\\n+        CUTE_UNROLL\\n+        for (int i = 0; i < size(tCrA); ++i) {\\n+            auto c = tCcA(i);\\n+            const int m = get<0>(c), k = get<1>(c);\\n+            const int owner = m * 4 + (k >> 4);\\n+            const int item = k & 15;\\n+            const int bit = item * 3;\\n+            con