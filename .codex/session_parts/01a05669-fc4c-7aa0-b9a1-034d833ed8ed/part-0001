e == expected.dtype == torch.bfloat16\\n    assert torch.equal(actual.view(torch.int16), expected.view(torch.int16))\\n\\n\\n@pytest.fixture(scope=\\\"module\\\", params=[\\\"tile_palette3\\\", \\\"chunk_delta3\\\"])\\ndef compressor(request):\\n    try:\\n        from tiered_serve.compression.core.tp3_cd3 import (\\n            ChunkDelta3Compressor,\\n            TilePalette3Compressor,\\n        )\\n\\n        classes = {\\n            \\\"tile_palette3\\\": TilePalette3Compressor,\\n            \\\"chunk_delta3\\\": ChunkDelta3Compressor,\\n        }\\n        return request.param, classes[request.param]()\\n    except (ImportError, OSError, RuntimeError) as error:\\n        detail = str(error).splitlines()[0] if str(error) else type(error).__name__\\n        pytest.skip(f\\\"TP3/CD3 extension unavailable: {detail}\\\")\\n\\n\\ndef test_all_bf16_patterns_roundtrip_bit_exact(compressor) -> None:\\n    _, codec = compressor\\n    weight = _all_bf16_patterns()\\n\\n    compressed = codec.compress(weight)\\n    restored = codec.decompress(compressed)\\n    torch.cuda.synchronize()\\n\\n    assert compressed.total_compressed_size == compressed.nbytes\\n    assert compressed.original_size == weight.nbytes\\n    assert compressed.M == weight.shape[0]\\n    assert compressed.K == weight.shape[1]\\n    _assert_bit_exact(restored, weight)\\n\\n\\n@pytest.mark.parametrize(\\\"use_gpu_pool\\\", [False, True])\\ndef test_host_staging_roundtrip_bit_exact(compressor, use_gpu_pool) -> None:\\n    _, codec = compressor\\n    weight = _representative_weight()\\n    output = torch.empty_like(weight)\\n    compressed = codec.compress(weight)\\n    torch.cuda.synchronize()\\n    compressed_size = compressed.nbytes\\n\\n    compressed.to_host()\\n    assert compressed.nbytes == compressed_size\\n    assert all(\\n        getattr(compressed, attr).device.type == \\\"cpu\\\"\\n        for attr in compressed._BUFFER_ATTRS\\n    )\\n\\n    gpu_pool = None\\n    if use_gpu_pool:\\n       