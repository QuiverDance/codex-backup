serve repo root (PYTHONPATH not required — the script\\nadds the repo root to sys.path itself):\\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\\n  python benchmarks/weight_compress.py <model-id> --layer 0\\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\\n\\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\\nbut driven entirely through the production tiered-serve compressor classes.\\n\\\"\\\"\\\"\\nimport argparse\\nimport glob\\nimport os\\nimport re\\nimport sys\\nimport time\\nfrom collections import OrderedDict, defaultdict\\n\\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\nif _REPO_ROOT not in sys.path:\\n    sys.path.insert(0, _REPO_ROOT)\\n\\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\\n# serving run); must be set before torch initialises CUDA.\\nos.environ.setdefault(\\\"PYTORCH_CUDA_ALLOC_CONF\\\", \\\"expandable_segments:True\\\")\\n\\nimport torch\\nfrom safetensors import safe_open\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\\n# ════════════════════════════════════════════════════════════════════\\n\\ndef _hf_cache_roots():\\n    \\\"\\\"\\\"Candidate HuggingFace hub cache directories, in priority order.\\\"\\\"\\\"\\n    roots = []\\n    for env in (\\\"HF_HUB_CACHE\\\", \\\"HUGGINGFACE_HUB_CACHE\\\"):\\n        if os.environ.get(env):\\n            roots.append(os.environ[env])\\n    if os.environ.get(\\\"HF_HOME\\\"):\\n        roots.append(os.path.join(os.environ[\\\"HF_HOME\\\"], \\\"hub\\\"))\\n    roots.append(os.path.expanduser(\\\"~/.cache/huggingface/hub\\\"))\\n    seen, uniq = set(), []\\n    for r in roots:\\n        r = os.path.abspath(r)\\n        if r not in seen and os.path.isdir(r):\\n            seen.add(r); uniq.append(r)\\n    return uniq\\n\\n\\ndef _resolve_hf_model(model_id):\\n    \\\"\\\"\\\"Return safetensors paths for a HF model id (``org/name``) from the cache.\\n\\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\\n    \\\"\\\"\\\"\\n    if \\\"/\\\" not in model_id:\\n        raise FileNotFoundError(\\n            f\\\"Model id must look like 'org/name' (got {model_id!r})\\\")\\n    org, name = model_id.split(\\\"/\\\", 1)\\n    dir_name = f\\\"models--{org}--{name}\\\"\\n    snapshots = []\\n    for root in _hf_cache_roots():\\n        snap_root = os.path.join(root, dir_name, \\\"snapshots\\\")\\n        if os.path.isdir(snap_root):\\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\\n                          if os.path.isdir(os.path.join(snap_root, s))]\\n    if not snapshots:\\n        raise FileNotFoundError(\\n            f\\\"No HF cache entry for {model_id!r}. Searched: \\\"\\n            f\\\"{', '.join(_hf_cache_roots()) or '(none)'}\\\")\\n    snapshots.sort(key=os.path.getmtime, reverse=True)\\n    for snap in snapshots:\\n        files = sorted(glob.glob(os.path.join(snap, \\\"*.safetensors\\\")))\\n        if files:\\n            return files\\n    raise FileNotFoundError(\\n        f\\\"{model_id!r} is cached but has no .safetensors shards.\\\")\\n\\n\\ndef _resolve_inputs(inputs):\\n    \\\"\\\"\\\"Expand file paths and HF model ids into a flat list of shard paths.\\\"\\\"\\\"\\n    out = []\\n    for s in inputs:\\n        if os.path.isfile(s) and s.endswith(\\\".safetensors\\\"):\\n            out.append(s)\\n        elif os.path.isfile(s):\\n            sys.exit(f\\\"Unsupported file (need .safetensors): {s}\\\")\\n        elif \\\"/\\\" in s and not os.path.exists(s):\\n            try:\\n                resolved = _resolve_hf_model(s)\\n            except FileNotFoundError as e:\\n                sys.exit(str(e))\\n            print(f\\\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \\\"\\n                  f\\\"{os.path.dirname(resolved[0])}\\\")\\n            out += resolved\\n        else:\\n            sys.exit(f\\\"Not found: {s}\\\")\\n    return out\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  Weight-key filtering\\n# ════════════════════════════════════════════════════════════════════\\n\\n_PROJ_NAMES = (\\\"q_proj\\\", \\\"k_proj\\\", \\\"v_proj\\\", \\\"o_proj\\\",\\n               \\\"gate_proj\\\", \\\"up_proj\\\", \\\"down_proj\\\",\\n               \\\".wq.\\\", \\\".wk.\\\", \\\".wv.\\\", \\\".wo.\\\", \\\".w1.\\\", \\\".w2.\\\", \\\".w3.\\\")\\n\\n\\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\\n    if key:\\n        keys = [k for k in keys if key in k]\\n    elif not all_weights:\\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\\n    if layer is not None:\\n        keys = [k for k in keys if f\\\"layers.{layer}.\\\" in k]\\n    if max_weights > 0:\\n        keys = keys[:max(0, max_weights - already)]\\n    return keys\\n\\n\\ndef _short_name(name):\\n    return (name.replace(\\\"model.layers.\\\", \\\"L\\\")\\n                .replace(\\\".self_attn.\\\", \\\".attn.\\\")\\n                .replace(\\\".weight\\\", \\\"\\\"))\\n\\n\\ndef _fp8_kind(dtype):\\n    s = str(dtype).lower()\\n    if \\\"float8\\\" not in s:\\n        return None\\n    return \\\"e4m3\\\" if \\\"e4m3\\\" in s else \\\"e5m2\\\" if \\\"e5m2\\\" in s else \\\"unknown\\\"\\n\\n\\n# ════════════════════════════════════════════════════════════════════\\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\\n# ════════════════════════════════════════════════════════════════════\\n#\\n# tiered-serve serves the merged projections that vLLM builds:\\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\\n#   o_proj / down_proj stay as-is.\\n# We reconstruct those from the per-projection safetensors so the benchmark\\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\\n\\n_LAYER_RE = re.compile(r\\\"layers\\\\.(\\\\d+)\\\\.\\\")\\n\\n_ROLE_PATS = (\\n    (\\\"q_proj\\\", \\\"q\\\"), (\\\"k_proj\\\", \\\"k\\\"), (\\\"v_proj\\\", \\\"v\\\"), (\\\"o_proj\\\", \\\"o\\\"),\\n    (\\\"gate_proj\\\", \\\"gate\\\"), (\\\"up_proj\\\", \\\"up\\\"), (\\\"down_proj\\\", \\\"down\\\"),\\n    (\\\".wq.\\\", \\\"q\\\"), (\\\".wk.\\\", \\\"k\\\"), (\\\".wv.\\\", \\\"v\\\"), (\\\".wo.\\\", \\\"o\\\"),\\n    (\\\".w1.\\\", \\\"gate\\\"), (\\\".w3.\\\", \\\"up\\\"), (\\\".w2.\\\", \\\"down\\\"),\\n)\\n\\n#: Fused group name -> the projection roles concatenated along dim 0.\\n_GROUP_DEFS = OrderedDict([\\n    (\\\"qkv\\\", (\\\"q\\\", \\\"k\\\", \\\"v\\\")),\\n    (\\\"o\\\", (\\\"o\\\",)),\\n    (\\\"gateup\\\", (\\\"gate\\\", \\\"up\\\")),\\n    (\\\"down\\\", (\\\"down\\\",)),\\n])\\n\\n\\ndef _role(key):\\n    for pat, r in _ROLE_PATS:\\n        if pat in key:\\n            return r\\n    return None\\n\\n\\ndef _build_layer_index(shards, layer_filter):\\n    \\\"\\\"\\\"Map ``layer_idx -> {role: (shard_path, key)}`` across all shards.\\\"\\\"\\\"\\n    index = {}\\n    for shard in shards:\\n        with safe_open(shard, framework=\\\"pt\\\") as sf:\\n            for k in sf.keys():\\n                r = _role(k)\\n                if r is None:\\n                    continue\\n                m = _LAYER_RE.search(k)\\n                if m is None:\\n                    continue\\n                li = int(m.group(1))\\n                if layer_filter is not None and li != layer_filter:\\n                    continue\\n                index.setdefault(li, {})[r] = (shard, k)\\n    return index\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"01a04287-0fd9-7860-86ed-0dfd530834d8\",\"create_time\":1787822576.0341663}}}\n/home/ubuntu/codex-backup/.codex/session_parts/01a03d13-635e-7550-914d-cb9bbed50690/part-0015:8:{\"timestamp\":\"2026-08-27T09:23:01.446Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"id\":\"ctc_0eac246026567f69016a9001f344c087d197bdf0266dc58a93\",\"status\":\"completed\",\"call_id\":\"call_SAXBrRU5ftT87Cq3viIJS0Na\",\"name\":\"exec\",\"input\":\"const r = await tools.exec_command({\\n  cmd: \\\"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && grep -n \\\\\\\"zipserv_p4flat_ext\\\\\\\\|_submit(\\\\\\\\|_futures\\\\\\\\|__getattr__\\\\\\\\|wait\\\\\\\" tiered_serve/cpp_exts/__init__.py | head -180; grep -n \\\\\\\"def _codec_registry\\\\\\\\|return {\\\\\\\\|p4flat\\\\\\\\|--codec\\\\\\\\|codec\\\\\\\" benchmarks/weight_compress.py | tail -140; find benchmarks -maxdepth 3 -type f | sort | grep -Ei \\\\\\\"kv|compress|weight|codec\\\\\\\"; find tiered_serve/compression -maxdepth 3 -type f | sort | grep -Ei \\\\\\\"kv|p4flat|compress\\\\\\\" | head -160; grep -R -n \\\\\\\"kv_blocks_cache\\\\\\\\|KV.*benchmark\\\\\\\\|kv.*compress.*bench\\\\\\\" benchmarks tests scripts 2>/dev/null | head -180'\\\",\\n  workdir: \\\"/home/ubuntu\\\",\\n  yield_time_ms: 10000,\\n  max_output_tokens: 22000\\n});\\ntext(r.output);\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"01a04287-0fd9-7860-86ed-0dfd530834d8\",\"create_time\":1787822576.338136}}}\n/home/ubuntu/codex-backup/.codex/session_parts/01a03d13-635e-7550-914d-cb9bbed50690/part-0015:9:{\"timestamp\":\"2026-08-27T09:23:01.536Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"id\":\"ctco_01a04287-a720-7ec3-b181-2620b2519fa6\",\"call_id\":\"call_SAXBrRU5ftT87Cq3viIJS0Na\",\"output\":[{\"type\"