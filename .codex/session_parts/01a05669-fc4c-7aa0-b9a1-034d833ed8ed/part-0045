{"timestamp":"2026-08-31T07:18:27.233Z","ordinal":1586,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a056af-0aa1-7e31-bdc9-9a5ccbfd5c95","call_id":"call_VPYIBl1IW01zBm95e7gHhsC1","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{}"},{"type":"input_text","text":"\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n#!/usr/bin/env python3\n\"\"\"Direct production-codec benchmark on real cached K/V blocks.\n\nThe serving KV block layout [N, 16, 8, 128] is viewed as two dense\n[N*128, 128] BF16 matrices.  This preserves every value and the 64x64 tiling\nrequired by P4Flat and ChunkDelta3 while exercising their normal compressor,\nhost-staging, and decompressor interfaces.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport os\nimport statistics\nimport subprocess\nimport sys\nimport time\n\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\nimport torch\n\n\nDEFAULT_PATH = (\n    \"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\")\nBLOCK_SHAPE = (16, 8, 128)\nROWS_PER_BLOCK = 128\nCOLS = 128\n\n\ndef _load(path: str, n: int) -> tuple[torch.Tensor, torch.Tensor]:\n    obj = torch.load(path, map_location=\"cpu\", weights_only=False)\n    k_key = \"k_post_blocks\" if \"k_post_blocks\" in obj else \"k_blocks\"\n    if len(obj[k_key]) < n or len(obj[\"v_blocks\"]) < n:\n        raise ValueError(\n            f\"Requested {n} blocks, cache has K={len(obj[k_key])}, \"\n            f\"V={len(obj['v_blocks'])}\")\n    k = torch.stack([x.contiguous() for x in obj[k_key][:n]])\n    v = torch.stack([x.contiguous() for x in obj[\"v_blocks\"][:n]])\n    k = k.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    v = v.reshape(n, *BLOCK_SHAPE).reshape(n * ROWS_PER_BLOCK, COLS)\n    return k.contiguous().pin_memory(), v.contiguous().pin_memory()\n\n\ndef _samples(fn, warmup: int, iterations: int) -> list[float]:\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    values = []\n    for _ in range(iterations):\n        begin = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        begin.record()\n        fn()\n        end.record()\n        end.synchronize()\n        values.append(begin.elapsed_time(end))\n    return values\n\n\ndef _stats(values: list[float]) -> tuple[float, float, float]:\n    ordered = sorted(values)\n    return (ordered[0], statistics.median(ordered),\n            ordered[int(0.95 * (len(ordered) - 1))])\n\n\ndef _exact(actual: torch.Tensor, expected: torch.Tensor) -> bool:\n    return torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef _codec(name: str):\n    if name == \"p4flat\":\n        from tiered_serve.compression.core import P4FlatCompressor\n        return P4FlatCompressor(torch.cuda.current_stream())\n    if name == \"chunk_delta3\":\n        from tiered_serve.compression.core import ChunkDelta3Compressor\n        return ChunkDelta3Compressor(torch.cuda.current_stream())\n    raise ValueError(f\"unknown codec: {name}\")\n\n\ndef _bench(\n    name: str,\n    host_k: torch.Tensor,\n    host_v: torch.Tensor,\n    warmup: int,\n    iterations: int,\n) -> None:\n    codec = _codec(name)\n    gpu_k = host_k.cuda(non_blocking=True)\n    gpu_v = host_v.cuda(non_blocking=True)\n    torch.cuda.synchronize()\n\n    def encode_pair():\n        return codec.compress(gpu_k), codec.compress(gpu_v)\n\n    for _ in range(warmup):\n        ck, cv = encode_pair()\n        del ck, cv\n    torch.cuda.synchronize()\n    encode_values = []\n    ck = cv = None\n    for _ in range(iterations):\n        if ck is not None:\n            del ck, cv\n        torch.cuda.synchronize()\n        started = time.perf_counter()\n        ck, cv = encode_pair()\n        torch.cuda.synchronize()\n        encode_values.append((time.perf_counter() - started) * 1e3)\n\n    out_k = torch.empty_like(gpu_k)\n    out_v = torch.empty_like(gpu_v)\n    resident = _samples(\n        lambda: (codec.decompress(ck, out_k), codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    resident_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    raw_bytes = gpu_k.nbytes + gpu_v.nbytes\n    compressed_bytes = ck.nbytes + cv.nbytes\n    exceptions = ck.num_exceptions + cv.num_exceptions\n    ck.to_host()\n    cv.to_host()\n    ck.register_temp_d_tensor(out_k)\n    cv.register_temp_d_tensor(out_v)\n    h2d = _samples(lambda: (ck.to(), cv.to()), warmup, iterations)\n    staged = _samples(\n        lambda: (ck.to(), cv.to(), codec.decompress(ck, out_k),\n                 codec.decompress(cv, out_v)),\n        warmup, iterations)\n    torch.cuda.synchronize()\n    staged_exact = _exact(out_k, gpu_k) and _exact(out_v, gpu_v)\n\n    enc = _stats(encode_values)\n    dec = _stats(resident)\n    copy = _stats(h2d)\n    total = _stats(staged)\n    gib = raw_bytes / 2**30\n    print(\n        f\"{name}: raw={raw_bytes / 2**20:.1f} MiB \"\n        f\"compressed={compressed_bytes / 2**20:.3f} MiB \"\n        f\"ratio={raw_bytes / compressed_bytes:.4f}x \"\n        f\"exceptions={exceptions}\")\n    print(\n        f\"  encode min/med/p95={enc[0]:.3f}/{enc[1]:.3f}/{enc[2]:.3f} ms\")\n    print(\n        f\"  resident decode min/med/p95={dec[0]:.3f}/{dec[1]:.3f}/\"\n        f\"{dec[2]:.3f} ms ({gib / (dec[1] / 1e3):.1f} GiB/s)\")\n    print(\n        f\"  H2D min/med/p95={copy[0]:.3f}/{copy[1]:.3f}/{copy[2]:.3f} ms; \"\n        f\"H2D+decode={total[0]:.3f}/{total[1]:.3f}/{total[2]:.3f} ms \"\n        f\"bit-exact={resident_exact and staged_exact}\")\n\n    del ck, cv, out_k, out_v, gpu_k, gpu_v\n    gc.collect()\n    torch.cuda.empty_cache()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--path\", default=DEFAULT_PATH)\n    parser.add_argument(\"--blocks\", default=\"1024,2048\")\n    parser.add_argument(\"--codec\", default=\"p4flat,chunk_delta3\")\n    parser.add_argument(\"--warmup\", type=int, default=5)\n    parser.add_argument(\"--iterations\", type=int, default=20)\n    parser.add_argument(\"--single-process\", action=\"store_true\",\n                        help=argparse.SUPPRESS)\n    args = parser.parse_args()\n    block_counts = [int(value) for value in args.blocks.split(\",\")]\n    codec_names = [value.strip() for value in args.codec.split(\",\")]\n    if len(block_counts) > 1 and not args.single_process:\n        # P4Flat's pinned multi-buffer batch_h2d path is not safely reusable\n        # after changing the matrix size in one process on GH200.  Isolating\n        # sweep points also prevents allocator history from biasing timings.\n        for n in block_counts:\n            subprocess.run([\n                sys.executable, os.path.abspath(__file__),\n                \"--path\", args.path,\n                \"--blocks\", str(n),\n                \"--codec\", args.codec,\n                \"--warmup\", str(args.warmup),\n                \"--iterations\", str(args.iterations),\n                \"--single-process\",\n            ], check=True)\n        return\n    print(torch.cuda.get_device_name())\n    for n in block_counts:\n   