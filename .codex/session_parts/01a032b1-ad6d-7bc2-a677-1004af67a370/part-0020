   fi\n        if [ \"$elapsed\" -ge \"$TIMEOUT\" ]; then\n            echo \"[!] Timeout (${TIMEOUT}s) waiting for server.\"\n            kill \"$SERVER_PID\" 2>/dev/null\n            exit 1\n        fi\n        sleep 5\n        elapsed=$((elapsed + 5))\n    done\n    echo \"[*] Server ready after ${elapsed}s.\"\n\n    # 클라이언트 실행 (포그라운드, 끝날 때까지 대기) — 현재 config 전달\n    echo \"[*] Running client...\"\n    bash scripts/serving/client/azure_conv.sh \"$MODEL_ALIAS\" \"$cfg\"\n    echo \"[*] Client finished.\"\n\n    # 서버 종료\n    echo \"[*] Shutting down server...\"\n    kill \"$SERVER_PID\" 2>/dev/null\n    wait \"$SERVER_PID\" 2>/dev/null || true\n    trap - EXIT\n    sleep 5\ndone\n\necho \"\"\necho \"[*] All experiments finished.\"\n/root/projects/tiered-serve-af2/serve_offload_kvweight.py:42:#   ./.venv/bin/python vllm/benchmarks/benchmark_serving.py \\\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03377-ad1a-7120-82d9-28ebad1a61a8","create_time":1787569931.4426725}}}
