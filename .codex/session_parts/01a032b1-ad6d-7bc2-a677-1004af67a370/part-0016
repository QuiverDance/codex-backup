id >= last.block_id:                # new maximum → tail\\n            last.next_free_block = block\\n            block.prev_free_block = last\\n            block.next_free_block = tail\\n            tail.prev_free_block = block\\n            return\\n        # Interior: scan from whichever end is closer in id space.\\n        if bid - first.block_id <= last.block_id - bid:\\n            cur = first\\n            while cur is not tail and cur.block_id < bid:\\n                cur = cur.next_free_block\\n            self._append_after(cur.prev_free_block, block)\\n        else:\\n            cur = last\\n            while cur is not head and cur.block_id > bid:\\n                cur = cur.prev_free_block\\n            self._append_after(cur, block)\\n\\n    def append(self, block: KVCacheBlock) -> None:\\n        \\\"\\\"\\\"Put a block back into the free list and increase\\n        num_free_blocks by 1.\\n\\n        If *num_dedicated_blocks* is set and the block is a dedicated block\\n        (block_id < num_dedicated_blocks), it is inserted right after\\n        fake_free_list_head so that dedicated blocks are always popped\\n        before offloadable blocks.\\n\\n        Args:\\n            block: The block to append.\\n        \\\"\\\"\\\"\\n        if self.fake_free_list_tail.prev_free_block is None:\\n            raise RuntimeError(\\n                \\\"prev_free_block of fake_free_list_tail should always exist\\\"\\n            )\\n\\n        if self._addr_order:\\n            self._insert_one_sorted(block)\\n            self.num_free_blocks += 1\\n            return\\n\\n        if (self.num_dedicated_blocks is not None\\n                and block.block_id < self.num_dedicated_blocks):\\n            # Dedicated block → insert at front (after fake head)\\n            self._append_after(self.fake_free_list_head, block)\\n        else:\\n            # Offloadable (or no boundary set) → append at tail\\n            last_block = self.fake_free_list_tail.prev_free_block\\n            last_block.next_free_block = block\\n            block.prev_free_block = last_block\\n            block.next_free_block = self.fake_free_list_tail\\n            self.fake_free_list_tail.prev_free_block = block\\n\\n        self.num_free_blocks += 1\\n\\n    def append_n(self, blocks: list[KVCacheBlock]) -> None:\\n        \\\"\\\"\\\"Put a list of blocks back into the free list.\\n\\n        When *num_dedicated_blocks* is set, dedicated blocks are inserted\\n        at the front and offloadable blocks at the tail so that dedicated\\n        blocks are always allocated first.\\n\\n        Args:\\n            blocks: The blocks to append.\\n        \\\"\\\"\\\"\\n        if len(blocks) == 0:\\n            return\\n\\n        if self._addr_order:\\n            # Insert ascending so each insert tends to extend the previous\\n            # one's position (cheap when freeing a packed low-id run).\\n            for block in sorted(blocks, key=lambda b: b.block_id):\\n                self._insert_one_sorted(block)\\n            self.num_free_blocks += len(blocks)\\n            return\\n\\n        boundary = self.num_dedicated_blocks\\n        if boundary is not None:\\n            dedicated = [b for b in blocks if b.block_id < boundary]\\n            offloadable = [b for b in blocks if b.block_id >= boundary]\\n        else:\\n            dedicated = []\\n            offloadable = blocks\\n\\n        # Prepend dedicated blocks right after fake_head\\n        if dedicated:\\n            # Build a sub-chain: dedicated[0] <-> ... <-> dedicated[-1]\\n            for i in range(len(dedicated) - 1):\\n                dedicated[i].next_free_block = dedicated[i + 1]\\n                dedicated[i + 1].prev_free_block = dedicated[i]\\n            # Splice into list: fake_head <-> dedicated_chain <-> old_first\\n            old_first = self.fake_free_list_head.next_free_block\\n            assert old_first is not None\\n            self.fake_free_list_head.next_f