 if n_kv_layers > 1:\\n                    d_max_hbm = max(0, (gpu_blocks - num_blocks_total)\\n                                    // (n_kv_layers - 1))\\n                else:\\n                    d_max_hbm = num_blocks_total\\n\\n                # D + O = N; ensure O ≤ o_max and D ≤ d_max_hbm\\n                # Dedicated blocks must be >= 16 (matches core.py).\\n                # When D is forced up to MIN_DED, O is reduced so\\n                # the HBM constraint (D*L*pb + O*pb ≤ gpu_avail)\\n                # still holds.\\n                MIN_DED = 16\\n                # Explicit dedicated request via env (BLOCKS direct, or SIZE_GB\\n                # -> blocks).  When set, HONOR it (capped to what HBM holds) and\\n                # cap offloadable at the LPDDR buffer (o_max); the usable total\\n                # then shrinks below num_blocks_total and the leftover blocks\\n                # stay UNALLOCATED (empty HBM/LPDDR is fine).  Without it, keep\\n                # the default (force dedicated up so offloadable == o_max and\\n                # the full block budget is used).\\n                _env_ded = None\\n                if os.getenv(\\\"TIERED_SERVE_DEDICATED_KV_BLOCKS\\\"):\\n                    _env_ded = int(\\n                        os.getenv(\\\"TIERED_SERVE_DEDICATED_KV_BLOCKS\\\"))\\n                elif os.getenv(\\\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\\\"):\\n                    _gb = float(\\n                        os.getenv(\\\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\\\"))\\n                    if _gb > 0 and per_block_bytes_raw > 0 and n_kv_layers > 0:\\n                        _env_ded = int(_gb * 1024**3\\n                                       // (n_kv_layers * per_block_bytes_raw))\\n                if _env_ded is not None:\\n                    num_dedicated_hbm = max(\\n                        MIN_DED,\\n                        min(_env_ded, d_max_hbm, num_blocks_total - 1))\\n                    num_offloadable_lpddr = min(\\n                        num_blocks_total - num_dedicated_hbm, o_max)\\n                else:\\n                    num_dedicated_hbm = max(\\n                        MIN_DED,\\n                        min(d_max_hbm,\\n                            num_blocks_total - o_max,\\n                            num_blocks_total - 1))\\n                    # Determinism: vLLM's profiling measures gpu_avail with a few\\n                    # MB of run-to-run jitter -> num_dedicated_hbm flips by +-1\\n                    # block run-to-run, which SHIFTS the dedicated/offloadable\\n                    # boundary (block_id >= num_dedicated => offloadable).  With\\n                    # the KV-offload pipeline that changes WHICH blocks are\\n                    # offloaded+recompressed and makes the decode nondeterministic\\n                    # (a boundary request's tokens diverge run-to-run).  Round the\\n                    # boundary DOWN to a stable granularity so the jitter is\\n                    # absorbed; the few reclaimed blocks just become offloadable.\\n                    _g = int(os.getenv(\\n                        \\\"TIERED_SERVE_KV_DEDICATED_GRANULARITY\\\", \\\"16\\\"))\\n                    if _g > 1:\\n                        num_dedicated_hbm = max(\\n                            MIN_DED, (num_dedicated_hbm // _g) * _g)\\n                    # Cap offloadable at o_max (physical hugepage/LPDDR\\n                    # capacity).  The granularity round-down above lowers\\n                    # num_dedicated_hbm, which would otherwise push\\n                    # (num_blocks_total - num_dedicated_hbm) ABOVE o_max -- and\\n                    # since num_dedicated was already pinned by the\\n                    # (num_blocks_total - o_max) term, offloadable was sitting\\n                    # exactly at o_max before rounding.  Without the cap each\\n                    # per-layer secondary_kv requests > o_max_frag blocks and\\n                    # overflows its hugep