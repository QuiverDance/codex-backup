HBM holds) and\n                # cap offloadable at the LPDDR buffer (o_max); the usable total\n                # then shrinks below num_blocks_total and the leftover blocks\n                # stay UNALLOCATED (empty HBM/LPDDR is fine).  Without it, keep\n                # the default (force dedicated up so offloadable == o_max and\n                # the full block budget is used).\n                _env_ded = None\n                if os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"):\n                    _env_ded = int(\n                        os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"))\n                elif os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"):\n                    _gb = float(\n                        os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"))\n                    if _gb > 0 and per_block_bytes_raw > 0 and n_kv_layers > 0:\n                        _env_ded = int(_gb * 1024**3\n                                       // (n_kv_layers * per_block_bytes_raw))\n                if _env_ded is not None:\n                    num_dedicated_hbm = max(\n                        MIN_DED,\n                        min(_env_ded, d_max_hbm, num_blocks_total - 1))\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n                else:\n                    num_dedicated_hbm = max(\n                        MIN_DED,\n                        min(d_max_hbm,\n                            num_blocks_total - o_max,\n                            num_blocks_total - 1))\n                    # Determinism: vLLM's profiling measures gpu_avail with a few\n                    # MB of run-to-run jitter -> num_dedicated_hbm flips by +-1\n                    # block run-to-run, which SHIFTS the dedicated/offloadable\n                    # boundary (block_id >= num_dedicated => offloadable).  With\n                    # the KV-offload pipeline that changes WHICH blocks are\n                    # offloaded+reco