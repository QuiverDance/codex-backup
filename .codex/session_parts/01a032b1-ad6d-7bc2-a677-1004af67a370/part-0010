fig.kv_cache_groups:\n                            _spec = (kv_cache_config.kv_cache_groups[0]\n                                     .kv_cache_spec)\n                        if _per_side_fn is not None and _spec is not None:\n                            _bs = _spec.block_size\n                            _nkv = getattr(_spec, \"num_kv_heads\", 0)\n                            _hd = getattr(_spec, \"head_size\", 0)\n                            _block_elements = _bs * _nkv * _hd\n                            if _block_elements > 0:\n                                _per_side = _per_side_fn(_block_elements)\n                                per_block_bytes_lpddr = (\n                                    per_block_bytes_raw + 2 * _per_side)\n                        elif _per_side_fn is None:\n                            logger.info(\n                                \"Tiered-serve hugepage alloc: backend=%s \"\n                                \"compressed pool not modeled; using raw \"\n                                \"pb only\", kv_backend)\n                    except Exception as _e:\n                        logger.warning(\n                            \"Tiered-serve hugepage alloc: failed to \"\n                            \"size compressed pool (%s); using raw \"\n                            \"pb only\", _e)\n\n                # Max offloadable blocks from LPDDR5:\n                # O × n_kv_layers × pb_lpddr ≤ lpddr5\n                o_max_lpddr = lpddr5_bytes // (\n                    n_kv_layers * per_block_bytes_lpddr)\n                # Max offloadable blocks from hugepage packing:\n                # each page must fit ceil(n_kv_layers/n_kv_pages)\n                # layer-secondaries (raw + compressed)\n                n_kv_hp = hp_allocator.n_kv_pages\n                lpp = _math.ceil(n_kv_layers / n_kv_hp) if n_kv_hp else 1\n                o_max_frag = (hp_allocator.hp_size\n                              // (lpp * per_block_bytes_lpddr))\n                o_max = min(o_max_lpddr, o_max_frag)\n\n                # Max dedicated blocks from HBM (raw only):\n                # D × n_kv_layers × pb + O × pb ≤ gpu_avail\n                # D × (n_kv_layers - 1) = gpu_avail/pb - N\n                gpu_blocks = gpu_avail // per_block_bytes_raw\n                if n_kv_layers > 1:\n                    d_max_hbm = max(0, (gpu_blocks - num_blocks_total)\n                                    // (n_kv_layers - 1))\n                else:\n                    d_max_hbm = num_blocks_total\n\n                # D + O = N; ensure O ≤ o_max and D ≤ d_max_hbm\n                # Dedicated blocks must be >= 16 (matches core.py).\n                # When D is forced up to MIN_DED, O is reduced so\n                # the HBM constraint (D*L*pb + O*pb ≤ gpu_avail)\n                # still holds.\n                MIN_DED = 16\n                # Explicit dedicated request via env (BLOCKS direct, or SIZE_GB\n                # -> blocks). The value is the logical scheduler-visible\n                # dedicated block count. Resident-tail rows are physical HBM\n                # backing and are added separately. An explicit request is an\n                # exact experiment constraint: fail instead of silently\n                # reducing it when this run has less free HBM. Cap only the\n                # offloadable side at the LPDDR buffer (o_max); the usable total\n                # may then shrink below num_blocks_total and the leftover blocks\n                # stay UNALLOCATED (empty HBM/LPDDR is fine). Without it, keep\n                # the default (force dedicated up so offloadable == o_max and\n                # the full block budget is used).\n                _env_ded = None\n                if os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"):\n                    _env_ded = int(\n                        os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"))\n                elif os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"):\n                    _gb = float