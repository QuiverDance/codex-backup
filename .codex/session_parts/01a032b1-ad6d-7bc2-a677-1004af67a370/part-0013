essed pools are stored on\n+                    # LPDDR (raw is needed for prefill latency, compressed\n+                    # for memory savings on decode).  pb_total = pb_raw +\n+                    # pb_compressed.  Otherwise pb_total == pb.\n+                    # N = D + O (total blocks)\n+                    first_spec = next(\n+                        iter(kv_cache_specs[0].values()))\n+                    pb = first_spec.page_size_bytes\n+\n+                    # Compute LPDDR per-block size accounting for\n+                    # compressed pool.  When KV compression is on, LPDDR\n+                    # holds BOTH the raw secondary (needed for prefill\n+                    # latency) AND the persistent compressed pool (decode),\n+                    # so pb_lpddr = pb_raw + 2*per_side (K+V).  Each backend\n+                    # exposes a static ``compute_per_block_compressed_bytes``\n+                    # returning the worst-case per-side host-pool bytes.\n+                    pb_lpddr = pb\n+                    use_kv_comp_env = (\n+                        os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\")\n+                    if use_kv_comp_env:\n+                        kv_backend = os.getenv(\n+                            \"TIERED_SERVE_KV_COMP_BACKEND\",\n+                            \"zipserv\").lower()\n+                        # Resolve the backend's per-side compressed-pool\n+                        # estimator.  Backends not listed here (dietgpu /\n+                        # mantexp) have a dynamically-varying footprint that\n+                        # is not yet modelled — they fall through to the\n+                        # conservative raw-pb-only path below.\n+                        _per_side_fn = None\n+                        try:\n+                            if kv_backend == \"zipserv\":\n+                                from tiered_serve.tensor_compressor import (\n+                                    ZipServCompressor,\n+                                )\n+                                _per_side_fn = (\n+                                    ZipServCompressor\n+                                    .compute_per_block_compressed_bytes)\n+                            elif kv_backend in (\"p4flat\", \"p4flatcpu\",\n+                                                \"ublb_flat\", \"ublb_tbe\"):\n+                                # p4flatcpu (C++ CPU encode) and the UB/LB-split\n+                                # codecs (ublb_flat/ublb_tbe, P4Flat-based) all\n+                                # share p4flat's on-host blob pool layout\n+                                # ([host_n, align(raw,128)] + meta), so the\n+                                # per-block compressed-pool size is identical\n+                                # (inherited static method).  All MUST be\n+                                # modelled or the unbudgeted compressed pool\n+                                # over-offloads and OOM-kills the host at warmup.\n+                                from tiered_serve.p4flat_kv_compressor import (\n+                                    P4FlatKVCompressor,\n+                                )\n+                                _per_side_fn = (\n+                                    P4FlatKVCompressor\n+                                    .compute_per_block_compressed_bytes)\n+                        except Exception as _e:\n+                            logger.warning(\n+                                \"Tiered-serve: failed to import %s \"\n+                                \"compressor for KV budget (%s); using raw \"\n+                                \"pb only\", kv_backend, _e)\n+                        # block_elements = block_size *\n+                        #   num_kv_heads * head_size  (one side, K or V)\n+                        _bs = first_spec.block_size\n+                        _nkv = getattr(first_spec, \"num_kv_heads\", 0)\n+                        _hd = getattr(first_spec, \"head_size\", 0)\n+                        _block_elements = _bs * _nkv * _hd\n+                        if _per_side_fn is not None and _block_elements > 0:\n+                            try:\n+                                _per_side = _per_side_fn(_block_elements)\n+                                # K + V compressed pool bytes per block\n+                                pb_compressed = 2 * _per_side\n+                                pb_lpddr = pb + pb_compressed\n+                                logger.info(\n+                                    \"Tiered-serve KV comp budget: \"\n+                                    \"backend=%s pb_raw=%d, pb_comp=%d \"\n+                                    \"(%.2fx), pb_lpddr_total=%d\",\n+                                    kv_backend, pb, pb_compressed,\n+                                    pb_compressed / pb if pb else 0,\n+                                    pb_lpddr)\n+                            except Exception as _e:\n+                                logger.warning(\n+                                    \"Tiered-serve: failed to size \"\n+                                    \"compressed pool for %s (%s); using \"\n+                                    \"raw pb only\", kv_backend, _e)\n+                        else:\n+                            logger.info(\n+                                \"Tiered-serve KV comp budget: backend=%s \"\n+                                \"compressed pool not modeled; using \"\n+                                \"raw pb only\",\n+                                kv_backend)\n+\n+                    o_lpddr = (lpddr5_bytes // (n_layers * pb_lpddr)\n+                               if n_layers > 0 and pb_lpddr > 0 else 0)\n+                    lpp = -(-n_layers // n_kv_pages)  # ceil div\n+                    o_frag = (hp_size // (lpp * pb_lpddr)\n+                              if lpp > 0 and pb_lpddr > 0 else 0)\n+                    o_max = min(o_lpddr, o_frag)\n+\n+                    MIN_DED = 16  # ded