\"TIERED_SERVE_OFFLOAD_TYPE\", \"\")\n+        if offload_type and \"kv\" in offload_type.lower():\n+            # no_offload_kv: KV stays fully HBM-resident with no LPDDR\n+            # offload, so it must NOT inflate the budget with hugepage\n+            # LPDDR capacity.  Route it through the same actual-free-HBM\n+            # budget path as reduce-kv.\n+            reduce_kv = (\n+                os.getenv(\"TIERED_SERVE_REDUCE_KV_FOOTPRINT\", \"0\") == \"1\"\n+                or os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n+            if not reduce_kv:\n+                import math as _math\n+                try:\n+                    from tiered_serve.huge_page_allocator import (\n+                        allocator as hp_allocator,\n+                    )\n+                    n_kv_pages = hp_allocator.n_kv_pages\n+                    hp_size = hp_allocator.hp_size\n+                except Exception as _hp_err:\n+                    logger.warning(\n+                        \"Tiered-serve KV: HugePageAllocator failed \"\n+                        \"(%s), falling back to HBM-only budget\",\n+                        _hp_err)\n+                    n_kv_pages = 0\n+                    hp_size = 0\n+                # LPDDR5 capacity = KV hugepages\n+                lpddr5_bytes = n_kv_pages * hp_size\n+                n_layers = len(kv_cache_specs[0])\n+\n+                # unlikely\n+                if n_kv_pages == 0:\n+                    # No hugepages for KV — fall back to HBM-only budget.\n+                    # Use actual free GPU memory (better than the profiled\n+                    # value which can be negative when model is very large).\n+                    import torch as _torch\n+                    _gpu_free, _ = _torch.cuda.mem_get_info()\n+                    gpu_reserve = int(os.getenv(\n+                        \"TIERED_SERVE_GPU_RESERVE_GIB\", \"5\")) * (1 << 30)\n+                    hbm_only = max(0, _gpu_free - gpu_reserve)\n+                    available_gpu_memory = [hbm_only] * len(\n+                        available_gpu_memory)\n+                    logger.info(\n+                        \"Tiered-serve KV: no hugepages for KV \"\n+                        \"(n_kv_pages=0), using HBM-only budget \"\n+                        \"%.2f GiB (free=%.2f, reserve=%.2f)\",\n+                        hbm_only / 1024**3,\n+                        _gpu_free / 1024**3,\n+                        gpu_reserve / 1024**3)\n+                else:\n+                    gpu_reserve = int(os.getenv(\n+                        \"TIERED_SERVE_GPU_RESERVE_GIB\", \"5\")) * (1 << 30)\n+\n+                    # The profiled available_gpu_memory is capped by\n+                    # gpu_memory_utilization (default 0.9), which leaves\n+                    # ~10% of GPU memory unused.  We can't simply\n+                    # increase gpu_memory_utilization because vLLM's\n+                    # startup check requires\n+                    # free_memory >= total * utilization, and CUDA\n+                    # context already consumes ~9 GiB at startup.\n+                    # Instead, measure actual free memory post-profiling\n+                    # and back-compute the true activation overhead to\n+                    # get a tighter HBM budget.\n+                    import torch as _torch\n+                    _gpu_free, _gpu_total = _torch.cuda.mem_get_info()\n+                    _profiled = (available_gpu_memory[0]\n+                                 if available_gpu_memory else 0)\n+                    _util = (self.vllm_config.cache_config\n+                             .gpu_memory_utilization)\n+                    # profiled = total*util - (model+act+ctx)\n+                    # model+ctx ≈ total - gpu_free  (activations freed)\n+                    # => act ≈ gpu_free - profiled - total*(1-util)\n+                    # When a memory ballast is present (simulated HBM\n+                    # limit), (total - g