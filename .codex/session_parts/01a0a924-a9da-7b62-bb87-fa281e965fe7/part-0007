oup = 0; group < kThreads / DecodeThreads; ++group) {')\\ns=s.replace('const int thread = physical_thread + group * kDecodeThreads;','const int thread = physical_thread + group * DecodeThreads;')\\nold='''        auto* vectors = reinterpret_cast<ulonglong2*>(destination);\\n        decode_and_store_half<CodeBits, 0>(code_word, sm, base, vectors);\\n        decode_and_store_half<CodeBits, 8>(code_word, sm, base, vectors + 1);\\n    }\\n\\n    __syncthreads();'''\\nnew='''        if constexpr (KV) {\\n            auto* vectors = reinterpret_cast<uint4*>(destination);\\n            decode_and_store_pairs<CodeBits, 0>(code_word, sm, base, vectors);\\n            decode_and_store_pairs<CodeBits, 8>(code_word, sm, base, vectors + 1);\\n        } else {\\n            auto* vectors = reinterpret_cast<ulonglong2*>(destination);\\n            decode_and_store_half<CodeBits, 0>(code_word, sm, base, vectors);\\n            decode_and_store_half<CodeBits, 8>(code_word, sm, base, vectors + 1);\\n        }\\n    }\\n\\n    if constexpr (KV) {\\n        // This condition is uniform across the CTA. With no patches pending,\\n        // the base stores need no block-wide barrier before returning.\\n        if (tile_exception_offsets[tile] == tile_exception_offsets[tile + 1]) {\\n            return;\\n        }\\n    }\\n    __syncthreads();'''\\nassert s.count(old)==1\\ns=s.replace(old,new)\\ns=s.replace('''__global__ __launch_bounds__(kDecodeThreads, 8)\\nvoid DecompressChunkDelta3BatchedKernel(''', '''// Keep the same 1024-thread register budget across candidate block sizes.\\n__global__ __launch_bounds__(kKVDecodeThreads, 1024 / kKVDecodeThreads)\\nvoid DecompressChunkDelta3BatchedKernel(''')\\ns=s.replace('decompress_chunk_delta3_tile<kKVDeltaBits>(', 'decompress_chunk_delta3_tile<kKVDeltaBits, kKVDecodeThreads, true>(')\\ns=s.replace('DecompressChunkDelta3BatchedKernel<<<grid, kDecodeThreads, 0, stream>>>(', 'DecompressChunkDelta3BatchedKernel<<<grid, kKVDecodeThreads, 0, stream