, dtype=torch.float32, device=\\\"cuda\\\"\\n    ).to(torch.bfloat16)\\n    compressed = codec.compress(weight)\\n    compressed_bytes = compressed.nbytes\\n    compressed.to_host()\\n    assert compressed.nbytes == compressed_bytes\\n    assert all(getattr(compressed, attr).device.type == \\\"cpu\\\"\\n               for attr in compressed._BUFFER_ATTRS)\\n\\n    output = torch.empty_like(weight)\\n    gpu_pool = None\\n    if use_gpu_pool:\\n        gpu_pool = {\\n            attr: torch.empty_like(getattr(compressed, attr), device=\\\"cuda\\\")\\n            for attr in compressed._BUFFER_ATTRS\\n        }\\n    compressed.register_temp_d_tensor(output, gpu_pool)\\n    compressed.to(\\\"cuda\\\", non_blocking=True)\\n    restored = codec.decompress(compressed)\\n    torch.cuda.synchronize()\\n    assert restored.data_ptr() == output.data_ptr()\\n    _assert_bit_exact(restored, weight)\\n\\n\\ndef test_cpu_weight_encode_stages_and_roundtrips_bit_exact() -> None:\\n    codec = _codec()\\n    generator = torch.Generator().manual_seed(911)\\n    source = torch.randn(\\n        256, 256, generator=generator, dtype=torch.float32\\n    ).to(torch.bfloat16).contiguous()\\n\\n    compressed = codec.compress(source)\\n    assert compressed.sign_mantissa.device.type == \\\"cpu\\\"\\n    output = torch.empty(source.shape, dtype=source.dtype, device=\\\"cuda\\\")\\n    compressed.register_temp_d_tensor(output)\\n    compressed.to(non_blocking=False)\\n    restored = codec.decompress(compressed, output)\\n    torch.cuda.synchronize()\\n\\n    _assert_bit_exact(restored.cpu(), source)\\n\\n\\ndef test_rejects_non_tile_aligned_shape() -> None:\\n    codec = _codec()\\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\\\"cuda\\\")\\n    with pytest.raises(ValueError, match=\\\"divisible by 64\\\"):\\n        codec.compress(weight)\\n\\n\\n@pytest.mark.parametrize(\\\"profile_enabled\\\", [False, True])\\n@pytest.mark.parametrize(\\\"split_h2d\\\", [False, True])\\ndef test_cpu_kv_backend_async_roundtrip_and_pending_bulk_free(\\n        split_h2d: bool, profile_enabled: bool) -> None:\\n    from tiered_serve.chunk_delta3_kv_compressor import (\\n        ChunkDelta3KVCompressor,\\n    )\\n\\n    from tiered_serve import kv_cpu_profile\\n    kv_cpu_profile.begin_run(profile_enabled)\\n    kv_cpu_profile.set_step(1, 0)\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\\n    compressor._tb = profile_enabled\\n    try:\\n        block_shape = (16, 8, 128)\\n        compressor.warmup_kv_buffers(\\n            block_shape, max_n_blocks=8, n_layers=1,\\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\\n        )\\n        if split_h2d:\\n            compressor.load_kv_stream = torch.cuda.Stream()\\n            compressor._kv_split_min_bytes = 0\\n        generator = torch.Generator().manual_seed(321)\\n        host_k = torch.randn(\\n            8, *block_shape, generator=generator, dtype=torch.float32\\n        ).to(torch.bfloat16).contiguous()\\n        host_v = torch.randn(\\n            8, *block_shape, generator=generator, dtype=torch.float32\\n        ).to(torch.bfloat16).contiguous()\\n\\n        # Seed one completed row, then retire it in the same callback batch as\\n        # a row owned by the next writer.  Because that writer may rebuild the\\n        # whole layer CSR, both physical slots must stay quarantined.\\n        compressor.compress_batch_async_from_host(0, [7], host_k, host_v)\\n        compressor.wait_compress_async(0, block_shape)\\n        compressor.compress_batch_async_from_host(\\n            0, [3, 1, 6], host_k, host_v)\\n        retired_slots = {\\n            int(compressor._kv_slot_np[0][block_id])\\n            for block_id in (1, 7)\\n        }\\n        compressor.free_persistent_blocks([7, 1, 7])\\n        assert compressor._deferred_slot_frees[0] == retired_slots\\n        compressor._kv_slot_allocator[0].validate_occupied(\\n            np.asarray(sorted(retired_slots), dtype=np.int64))\\n        assert compressor._kv_slot_np[0][1] == -1\\n        assert compressor._kv_slot_np[0][7] == -1\\n\\n        compressor.wait_compress_async(0, block_shape)\\n        assert compressor._persistent_valid[0][3]\\n        assert not compressor._persistent_valid[0][1]\\n        assert compressor._persistent_valid[0][6]\\n        assert not compressor._persistent_valid[0][7]\\n        assert 0 not in compressor._deferred_slot_frees\\n        for slot in retired_slots:\\n            with pytest.raises(RuntimeError):\\n                compressor._kv_slot_allocator[0].validate_occupied(\\n                    np.asarray([slot], dtype=np.int64))\\n\\n        k_cache = torch.zeros(\\n\\\"\\\"\\\"Compare production host encoding with the original full-search format.\\n\\nChecks encoded bytes, exception order, and truncated scratch counts, rather\\nthan only lossless decoding (which would miss changed base tie-breaking).\\n\\\"\\\"\\\"\\nimport numpy as np\\nimport pytest\\nimport torch\\n\\n\\ndef reference(bits, base_rows, capacity):\\n    rows, columns = bits.shape\\n    codes, sm, bases, offsets, entries = [], [], [], [0], []\\n    for row in range(0, rows, 64):\\n        for col in range(0, columns, 64):\\n            tile = bits[row:row + 64, col:col + 64]\\n            chunks = tile.reshape(64, 4, 16)\\n            tile_codes = np.zeros((64, 4, 6), dtype=np.uint8)\\n            for group_row in range(0, 64, base_rows):\\n                for group_col in range(4):\\n                    values = chunks[group_row:group_row + base_rows, group_col]\\n                    exponents = (values >> 7) & 255\\n                    base = min(int(exponents.min()), 248)\\n                    if int(exponents.max()) - base > 7:\\n                        if base_rows == 1:\\n                            candidates = [min(int(e), 248) for e in exponents.flat]\\n                            scores = [np.count_nonzero(\\n                                (exponents >= c) & (exponents <= c + 7))\\n                                for c in candidates]\\n                            base = candidates[int(np.argmax(scores))]\\n                        else:\\n                            histogram = np.bincount(exponents.ravel(), minlength=256)\\n                            # Original exhaustive 0..248 search, earliest tie.\\n                            scores = np.convolve(histogram, np.ones(8, dtype=int), 'valid')\\n                            base = int(np.argmax(scores))\\n                    bases.append(base)\\n                    for r in range(base_rows):\\n                        thread = (group_row + r) * 4 + group_col\\n                        word = 0\\n                        for item, exp in enumerate(exponents[r]):\\n                            exp = int(exp)\\n                            if base <= exp <= base + 7:\\n                                word |= (exp - base) << (item * 3)\\n                            else:\\n                                entries.append((exp << 12) | (thread * 16 + item))\\n                        tile_codes[group_row + r, group_col] = list(word.to_bytes(6, 'little'))\\n            codes.extend(tile_codes.ravel())\\n            sm.extend((((tile >> 8) & 128) | (tile & 127)).ravel())\\n            offsets.append(len(entries))\\n    packed = np.zeros(capacity, dtype=np.uint64)\\n    for i, entry in enumerate(entries[:capacity * 3]):\\n        packed[i // 3] |= np.uint64(entry) << np.uint64((i % 3) * 20)\\n    return codes, sm, bases, offsets, packed, len(entries)\\n\\n\\n@pytest.mark.parametrize('capacity', [1, 5462])\\ndef test_host_encode_matches_original_format(capacity):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext, _cd3_base_rows\\n\\n    rng = np.random.default_rng(71)\\n    shape = (128, 128)\\n    count = np.prod(shape)\\n    patterns = [\\n        np.full(shape, 120),\\n        (100 + np.arange(count) % 8).reshape(shape),\\n        (95 + np.arange(count) % 25).reshape(shape),\\n        rng.integers(0, 256, size=shape),\\n        np.where(np.arange(count) % 257 == 0, 255, 0).reshape(shape),\\n    ]\\n    # Include both signs and all mantissa bits, including special BF16 values.\\n    bits = np.stack([(e << 7) | rng.integers(0, 128, size=shape)\\n                     | (rng.integers(0, 2, size=shape) << 15)\\n                     for e in patterns]).astype(np.uint16)\\n    source = torch.from_numpy(bits.view(np.int16))\\n    ids = torch.tensor([4, 1, 3, 0, 2], dtype=torch.int64)\\n    slots = torch.tensor([5, 2, 6, 1, 4], dtype=torch.int64)\\n    tiles = 4\\n    outputs = [\\n        torch.zeros((7, tiles * 1536), dtype=torch.uint8),\\n        torch.zeros((7, count), dtype=torch.uint8),\\n        torch.zeros((7, tiles * (256 // _cd3_base_rows)), dtype=torch.uint8),\\n        torch.zeros((7, tiles + 1), dtype=torch.int32),\\n        torch.zeros((7, capacity), dtype=torch.int64),\\n        torch.zeros(7, dtype=torch.int32),\\n    ]\\n    chunk_delta3_ext.host_encode_chunk_delta3_blocks(\\n        source, ids, slots, *outputs, *shape)\\n    for bid, slot in zip(ids.tolist(), slots.tolist()):\\n        expected = reference(bits[bid], _cd3_base_rows, capacity)\\n        for index, (output, want) in enumerate(zip(outputs, expected)):\\n            actual = output[slot].numpy()\\n            if index == 4:\\n                actual = actual.view(np.uint64)\\n            np.testing.assert_array_equal(actual, want)\\n    for output in outputs:\\n        assert torch.count_nonzero(output[[0, 3]]) == 0\\n\\n\\n@pytest.mark.parametrize('capacity', [1, 5462])\\ndef test_paired_encode_matches_single_sides_and_validates_before_writes(capacity):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext, _cd3_base_rows\\n\\n    generator = torch.Generator().manual_seed(97)\\n    sources = [torch.randint(-32768, 32768, (4, 128, 128),\\n                             dtype=torch.int16, generator=generator)\\n               for _ in range(2)]\\n    ids = torch.tensor([3, 0, 2], dtype=torch.int64)\\n    slots = torch.tensor([4, 1, 3], dtype=torch.int64)\\n\\n    def buffers():\\n        return [torch.zeros((5, 4 * 1536), dtype=torch.uint8),\\n                torch.zeros((5, 128 * 128), dtype=torch.uint8),\\n                torch.zeros((5, 4 * (256 // _cd3_base_rows)), dtype=torch.uint8),\\n                torch.zeros((5, 5), dtype=torch.int32),\\n                torch.zeros((5, capacity), dtype=torch.int64),\\n                torch.zeros(5, dtype=torch.int32)]\\n\\n    expected = [buffers(), buffers()]\\n    actual = [buffers(), buffers()]\\n    for source, output in zip(sources, expected):\\n        chunk_delta3_ext.host_encode_chunk_delta3_blocks(\\n            source, ids, slots, *output, 128, 128)\\n    chunk_delta3_ext.host_encode_chunk_delta3_kv_blocks(\\n        *sources, ids, slots, *actual, 128, 128)\\n    for want_side, got_side in zip(expected, actual):\\n        for want, got in zip(want_side, got_side):\\n            assert torch.equal(want, got)\\n    # Invalid V must not leave a partially encoded K side behind.\\n    untouched = [buffers(), buffers()]\\n    with pytest.raises(RuntimeError, match='source must'):\\n        chunk_delta3_ext.host_encode_chunk_delta3_kv_blocks(\\n            sources[0], sources[1].float(), ids, slots, *untouched, 128, 128)\\n    assert all(torch.count_nonzero(t) == 0 for side in untouched for t in side)\\n\\n\\ndef test_csr_append_uses_plan_and_preserves_unselected_storage():\\n    from tiered_serve.cpp_exts import chunk_delta3_ext as ext\\n\\n    # Strided host rows/counts match views into the production pinned body.\\n    entries = torch.arange(36, dtype=torch.int64).reshape(6, 6)[:, :4]\\n    count_storage = torch.tensor([0, -99, 5, -99, 50, -99,\\n                                  1, -99, 0, -99, 9, -99], dtype=torch.int32)\\n    counts = count_storage[::2]\\n    slots = torch.tensor([2, 0, 5, 1], dtype=torch.int64)\\n    previous = np.array([0, 1, 2, 3, 0, 1], dtype=np.int64)\\n    words = torch.empty(4, dtype=torch.int64)\\n    offsets = torch.empty_like(words)\\n    size, old = ext.prepare_host_chunk_delta3_csr_append(\\n        counts, slots, previous, words, offsets, 4)\\n    assert size == 9 and old == 4\\n    assert words.tolist() == [4, 0, 3, 2]\\n    assert offsets.tolist() == [0, 4, 4, 7]\\n    destination = torch.full((20,), -1, dtype=torch.int64)\\n    published_offsets = torch.full((6,), -1, dtype=torch.int64)\\n    ext.append_host_chunk_delta3_csr(entries, slots, words, offsets,\\n                                    destination, published_offsets, previous, 3, size)\\n    expected = torch.cat([entries[2, :4], entries[5, :3], entries[1, :2]])\\n    assert torch.equal(destination[3:12], expected)\\n    assert (destination[:3] == -1).all() and (destination[12:] == -1).all()\\n    assert published_offsets.tolist() == [7, 10, 3, -1, -1, 7]\\n    assert previous.tolist() == [0, 2, 4, 3, 0, 3]\\n    # A corrupt plan is rejected before any persistent write.\\n    saved = destination.clone(), published_offsets.clone(), previous.copy()\\n    offsets[2] += 1\\n    with pytest.raises(RuntimeError, match='prefix'):\\n        ext.append_host_chunk_delta3_csr(entries, slots, words, offsets,\\n                                        destination, published_offsets, previous, 3, size)\\n    assert torch.equal(destination, saved[0])\\n    assert torch.equal(published_offsets, saved[1])\\n    np.testing.assert_array_equal(previous, saved[2])\\n\\\"\\\"\\\"KV GPU decompress (decode) latency + throughput on the production decode\\npath: decompress_batch -> decompress_batched (one batched CUDA kernel over the\\nGPU-resident compressed block pool), for p4flat and ublb_flat.\\n\\nKV is compressed once (host encode) to populate the pool; only the GPU batched\\ndecode is timed.  Independent of OMP_NUM_THREADS (pure GPU kernel + the codec's\\ninternal staging).  GiB/s is over the decoded raw BF16 bytes (K+V).  This is the\\ndecode side of the serving dense \\\"decomp+attention\\\" path; the encode side is\\nkv_cpu_encode.py.\\n\\nRun from tiered-serve:\\n  PYTHONPATH=$(pwd) ./.venv/bin/python benchmarks/kv_gpu_decode.py [--limit N]\\n\\\"\\\"\\\"\\nimport argparse\\nimport time\\n\\nimport torch\\n\\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\\nfrom tiered_serve.ublb_kv_compressor import UBLBFlatCPUKVCompressor\\nfrom tiered_serve.bitcomp_kv_compressor import BitcompCPUKVCompressor\\n\\nPATH = \\\"/root/projects/ats-benchmarks/benchmarks/compress/kv_blocks_cache.pt\\\"\\nBS = (16, 8, 128)\\nNS = [1024, 2048]            # decodes N of a 2N pool (scatter test needs 2x slots)\\n\\n\\ndef load(n_max):\\n    obj = torch.load(PATH, map_location=\\\"cpu\\\", weights_only=False)\\n    kk = \\\"k_post_blocks\\\" if \\\"k_post_blocks\\\" in obj else \\\"k_blocks\\\"\\n    K = torch.stack([t.contiguous() for t in obj[kk][:n_max]]).reshape(n_max, *BS)\\n    V = torch.stack([t.contiguous() for t in obj[\\\"v_blocks\\\"][:n_max]]).reshape(n_max, *BS)\\n    return K.contiguous().pin_memory(), V.contiguous().pin_memory()\\n\\n\\ndef bench(cls, name, hk, hv, ns):\\n    comp = cls(torch.cuda.Stream())\\n    pool = 2 * max(ns)\\n    comp.warmup_kv_buffers(block_shape=BS, max_n_blocks=pool, n_layers=1,\\n                           max_gpu_blocks=pool, max_gpu_decomp_blocks=pool)\\n    print(f\\\"  {name}\\\")\\n    for N in ns:\\n        # Compress 2N blocks (slots 0..2N-1), then decode N of them two ways:\\n        #   contig  = block ids [0..N-1]      -> slots 0..N-1   (sequential reads)\\n        #   scatter = block ids [0,2,..,2N-2] -> slots 0,2,..   (paged/fragmented,\\n        #             the production pattern where block_table is non-contiguous)\\n        # decompress_batch writes output id-indexed (kc[id]=block id), so kc is\\n        # sized 2N and we compare/measure only the decoded subset.\\n        M = 2 * N\\n        comp._kv_active_count[0] = 0; comp._kv_slot[0].fill_(-1)\\n        comp.compress_batch_async_from_host(0, list(range(M)), hk[:M].contiguous(),\\n                                            hv[:M].contiguous(), 0)\\n        comp.wait_compress_async(0, BS)\\n        kc = torch.zeros(M, *BS, dtype=torch.bfloat16, device=\\\"cuda\\\")\\n        vc = torch.zeros_like(kc)\\n        mb = 2 * N * 16 * 8 * 128 * 2 / 1024**2\\n        for label, dids in [(\\\"contig\\\", list(range(N))),\\n                            (\\\"scatter\\\", list(range(0, M, 2)))]:\\n            comp.decompress_batch(0, dids, (kc, vc)); torch.cuda.synchronize()\\n            sel = torch.tensor(dids)\\n            ke = (kc[sel].cpu() - hk[sel]).abs().max().item()\\n            ve = (vc[sel].cpu() - hv[sel]).abs().max().item()\\n            best = 1e9\\n            for _ in range(20):\\n                torch.cuda.synchronize(); t0 = time.perf_counter()\\n                comp.decompress_batch(0, dids, (kc, vc))\\n                torch.cuda.synchronize(); best = min(best, time.perf_counter() - t0)\\n            print(f\\\"     N={N:>4} {label:>7} (K+V {mb:5.0f} MiB) : {best*1e3:7.3f} ms\\\"\\n                  f\\\"   ({mb / 1024 / best:6.1f} GiB/s)  bit-exact={ke == 0 and ve == 0}\\\")\\n        del kc, vc; torch.cuda.empty_cache()\\n    comp.stop_kv_compress_workers()\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--limit\\\", type=int, default=max(NS))\\n    args = ap.parse_args()\\n    ns = [n for n in NS if n <= args.limit] or [args.limit]\\n    hk, hv = load(2 * max(ns))\\n    for cls, name in [(P4FlatCPUKVCompressor, \\\"p4flat\\\"),\\n                      (UBLBFlatCPUKVCompressor, \\\"ublb_flat\\\"),\\n                      (BitcompCPUKVCompressor, \\\"bitcomp\\\")]:\\n        bench(cls, name, hk, hv, ns)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n#!/usr/bin/env bash\\nset -Eeuo pipefail\\n\\nSCRIPT_DIR=\\\"$(cd -- \\\"$(dirname -- \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\nREPO_ROOT=\\\"$(cd -- \\\"${SCRIPT_DIR}/../..\\\" && pwd)\\\"\\n\\nPYTHON_BIN=\\\"${REPO_ROOT}/.venv/bin/python\\\"\\nSERVER_SCRIPT=\\\"${REPO_ROOT}/serve_offload_kvweight.py\\\"\\nCLIENT_SCRIPT=\\\"${REPO_ROOT}/scripts/serving/client/azure_conv.sh\\\"\\nMODEL_CONFIG_DIR=\\\"${REPO_ROOT}/tiered_serve/model_configs/meta-llama/Llama-3.1-70B-Instruct\\\"\\nP4_RAW_CONFIG=\\\"${MODEL_CONFIG_DIR}/cao-p4-fused.yaml\\\"\\nP4_KVCOMP_CONFIG=\\\"${MODEL_CONFIG_DIR}/cao-p4-kvcomp.yaml\\\"\\nCD3_CONFIG=\\\"${MODEL_CONFIG_DIR}/cao-cd3-fused.yaml\\\"\\nSTACK_POOL_SO=\\\"${REPO_ROOT}/etc/stack_pool.so\\\"\\n\\nMODEL_ALIAS=\\\"llama70b\\\"\\nMODEL_PATH=\\\"meta-llama/Llama-3.1-70B-Instruct\\\"\\nPORT=8000\\n\\nCODECS=(p4flat cd3)\\nMODES=(raw kvcomp)\\nCD3_BASE_ROWS=(16)\\nCHUNKS=(2048 4096 8192)\\nREQUEST_RATES=(1.2)\\nREPEATS=1\\nMAX_NUM_SEQS=128\\nMAX_CONTEXT_LEN=8192\\nDEDICATED_KV_BLOCKS=2432\\nWEIGHT_HUGE_PAGES=14\\nWEIGHT_BUFFERS=2\\nGPU_RESERVE_GIB=6\\nKV_ADDR_ORDER=1\\nKV_LOCALITY=0\\nKV_RANDOM_ALLOC=0\\nNUM_PROMPTS=1200\\nSKIP_FIRST_N_REQUESTS=100\\nSKIP_LAST_N_REQUESTS=100\\n# 1-based send-order prefix.  Zero means wait for all NUM_PROMPTS requests.\\nSTOP_AFTER_REQUEST=0\\n\\nNUMA_NODE=0\\nGPU_INDEX=0\\nSTARTUP_TIMEOUT=900\\nSHUTDOWN_TIMEOUT=120\\nCLEANUP_TIMEOUT=180\\nMAX_IDLE_HBM_MIB=1024\\nOUTPUT_ROOT=\\\"${REPO_ROOT}/benchmark_results/serving_suite\\\"\\nDRY_RUN=0\\nCHECK_ONLY=0\\nBREAKDOWN=0\\nSMOKE=0\\n\\nusage() {\\n  cat <<'EOF'\\nUsage: scripts/serving/run_performance_suite.sh [options]\\n\\nWith --breakdown, KV byte counts, compression/transfer ratios, and GPU timing\\nare saved under each cell's kv_metrics directory and linked from summary.tsv.\\nThese cover all server forwards, not the client's trimmed request cohort.\\nWithout --breakdown, KV metrics collection and CSV output are disabled.\\n\\nRuns isolated llama70b serving experiments. Every combination of KV mode,\\nchunk size, request rate, and repeat gets a fresh server process.\\n\\nOptions:\\n  --codecs LIST                 p4flat,cd3 (default