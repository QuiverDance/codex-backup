n\\n\\ndef test_cpu_kv_exception_overflow_restores_raw_secondary(\\n        monkeypatch) -> None:\\n    from tiered_serve.chunk_delta3_kv_compressor import (\\n        ChunkDelta3KVCompressor,\\n    )\\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\", \\\"3\\\")\\n    block_shape = (16, 8, 128)\\n    # Transposition makes each 16-value encoder chunk span many exponents,\\n    # deterministically overflowing a three-entry test row.\\n    bits = torch.arange(16384, dtype=torch.int32).to(torch.int16)\\n    host_k = (bits.view(torch.bfloat16).reshape(128, 128).t()\\n              .contiguous().reshape(1, *block_shape).pin_memory())\\n    host_v = torch.randn(\\n        1, *block_shape, generator=torch.Generator().manual_seed(73),\\n        dtype=torch.float32).to(torch.bfloat16).contiguous().pin_memory()\\n    monkeypatch.setattr(\\n        DualMemoryLoader, \\\"kv_caches\\\",\\n        [SimpleNamespace(secondary_kv=(host_k, host_v))])\\n\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\\n    try:\\n        compressor.warmup_kv_buffers(\\n            block_shape, max_n_blocks=1, n_layers=1,\\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\\n        compressor.compress_batch_async_from_host(\\n            0, [0], host_k, host_v)\\n        compressor.wait_compress_async(0, block_shape)\\n        assert compressor._secondary_fallback_possible[0]\\n        assert int(compressor._host_pools[0][\\\"k\\\"][\\n            \\\"num_exceptions\\\"][0]) > compressor._entry_capacity\\n\\n        output_k = torch.zeros(\\n            1, *block_shape, dtype=torch.bfloat16, device=\\\"cuda\\\")\\n        output_v = torch.zeros_like(output_k)\\n        active = [0]\\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\\n        compressor.decompress_batch(\\n            0, active, output_buffers=(output_k, output_v))\\n        torch.cuda.synchronize()\\n        _assert_bit_exact(output_k.cpu(), host_k)\\n        _assert_bit_exact(output_v.cpu(), host_v)\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n\\n\\n@pytest.mark.parametrize(\\\"n_tokens\\\", [1, 16, 32, 40, 48, 64, 128])\\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\\n    codec = _codec()\\n    generator = torch.Generator(device=\\\"cuda\\\").manual_seed(41 + n_tokens)\\n    weight = (torch.randn(\\n        128, 128, generator=generator, dtype=torch.float32, device=\\\"cuda\\\"\\n    ) * 0.02).to(torch.bfloat16)\\n    compressed = codec.compress(weight)\\n    assert compressed.num_exceptions > 0\\n\\n    codec._fused_max_n_override = 10 ** 9\\n    activation = torch.randn(\\n        n_tokens, 128, generator=generator,\\n        dtype=torch.bfloat16, device=\\\"cuda\\\")\\n    scratch = codec.alloc_fused_scratch(\\n        128, 128, n_tokens, activation.dtype, activation.device)\\n    actual = codec.linear_apply_into(compressed, activation, scratch)\\n    expected = F.linear(activation, weight)\\n    torch.cuda.synchronize()\\n\\n    amax = float(expected.abs().max())\\n    assert torch.allclose(\\n        actual.float(), expected.float(),\\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\\n\\n\\ndef test_cpu_kv_csr_growth_compaction_and_workspace_reuse(monkeypatch):\\n    from tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3KVCompressor\\n\\n    monkeypatch.setenv('TIERED_SERVE_KV_CD3_CSR_INITIAL_WORDS_PER_SLOT', '1')\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\\n    shape = (16, 8, 128)\\n    try:\\n        compressor.warmup_kv_buffers(shape, max_n_blocks=8, n_layers=1,\\n                                    max_gpu_blocks=8, max_gpu_decomp_blocks=8)\\n        generator = torch.Generator().manual_seed(137)\\n        sources = []\\n        for _ in range(2):\\n            exponent = torch.randint(120, 130, (8, *shape), generator=generator)\\n            mantissa = torch.randint(0, 128, (8, *shape), generator=generator)\\n            sources.append(((exponent << 7) | mantissa).to(torch.int16)\\n                           .view(torch.bfloat16))\\n        ids = [4, 1]\\n        compressor.compress_batch_async_from_host(0, ids, *sources)\\n        compressor.wait_compress_async(0, shape)\\n        first_states = dict(compressor._persistent_csr[0])\\n        assert all(state.entries.numel() > 1024 for state in first_states.values())\\n        workspace = compressor._csr_append_scratch[0]\\n        # Produce a real decode plan retaining the old arenas before re-encode.\\n        caches = tuple(torch.zeros((8, *shape), dtype=torch.bfloat16, device='cuda')\\n                       for _ in range(2))\\n        compressor.prepare_active_set(ids, np.asarray(ids))\\n        compressor.decompress_batch(0, ids, caches)\\n        first_plan = compressor._decode_plans[0]\\n        first_event = first_plan.h2d_done\\n        first_arena = first_plan.host_owners[0].data_ptr()\\n        compressor.compress_batch_async_from_host(0, ids, *sources)\\n        compressor.wait_compress_async(0, shape)\\n        assert compressor._csr_append_scratch[0] is workspace\\n        for side in ('k', 'v'):\\n            state = compressor._persistent_csr[0][side]\\n            assert state is not first_states[side]  # append garbage compacted\\n            assert state.garbage_words == 0\\n            assert state.used_words == int(state.word_counts.sum())\\n        compressor.prepare_active_set(ids, np.asarray(ids))\\n        compressor.decompress_batch(0, ids, caches)\\n        torch.cuda.synchronize()\\n        reused_plan = compressor._decode_plans[0]\\n        assert reused_plan.h2d_done is first_event\\n        assert reused_plan.host_owners[0].data_ptr() == first_arena\\n        assert first_plan.block_ids_cpu is None\\n        assert first_plan.block_ids_tensor is None\\n        assert reused_plan.block_ids_tensor is reused_plan.block_ids_cpu\\n        for source, cache in zip(sources, caches):\\n            _assert_bit_exact(cache[ids].cpu(), source[ids])\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n\\n\\ndef test_kv_routes_sparse_high_slots_and_capacity_buffers():\\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\\n\\n    # Exercise multiple radix bytes, fragmented slots and an oversized GPU\\n    # destination. Exact round-trip of the codec is covered by the tests above.\\n    rows, count, capacity = 65537, 5, 8\\n    host_body = torch.arange(rows, dtype=torch.int64).pin_memory().view(torch.uint8).reshape(rows, 8)\\n    host_offsets = torch.zeros(rows, dtype=torch.int64, pin_memory=True)\\n    host_entries = torch.empty(1, dtype=torch.int64, pin_memory=True)[:0]\\n    block_ids = torch.arange(count, dtype=torch.int64)\\n    slots = torch.tensor([65536, 256, 0, 255, 384], dtype=torch.int32)\\n    sorted_ids = torch.empty(count, dtype=torch.int64, pin_memory=True)\\n    gpu_body = [torch.full((capacity, 8), 123, dtype=torch.uint8, device=\\\"cuda\\\")\\n                for _ in range(2)]\\n    gpu_offsets = [torch.empty(capacity, dtype=torch.int64, device=\\\"cuda\\\")\\n                   for _ in range(2)]\\n    gpu_ids = torch.full((capacity,), -1, dtype=torch.int64, device=\\\"cuda\\\")\\n    gpu_entries = torch.empty(0, dtype=torch.int64, device=\\\"cuda\\\")\\n    stream = torch.cuda.Stream()\\n    stream.wait_stream(torch.cuda.current_stream())\\n    args = [block_ids, slots, sorted_ids, host_body, host_body,\\n            host_offsets, host_offsets, host_entries, host_entries,\\n            *gpu_body, *gpu_offsets, gpu_ids, gpu_entries, gpu_entries,\\n            False, rows, stream.cuda_stream]\\n    expected_ids = torch.tensor([2, 3, 1, 4, 0])\\n    expected_slots = slots[expected_ids].to(torch.int64)\\n    for reuse in (False, True):\\n        if reuse:\\n            args[0] = sorted_ids\\n        profile = {}\\n        _cd3_ext.prepare_chunk_delta3_kv_decode(*args, profile=profile)\\n        torch.cuda.synchronize()\\n        assert torch.equal(sorted_ids, expected_ids)\\n        assert torch.equal(gpu_ids[:count].cpu(), expected_ids)\\n        assert torch.equal(gpu_body[0][:count].view(torch.int64).flatten().cpu(), expected_slots)\\n        assert torch.all(gpu_body[0][count:] == 123)\\n        assert torch.all(gpu_ids[count:] == -1)\\n        assert profile[\\\"wire_bytes\\\"] == count * (2 * 8 + 3 * 8)\\n    slots[3] = slots[2]\\n    with pytest.raises(RuntimeError, match=\\\"duplicate persistent CD3 slot\\\"):\\n        _cd3_ext.prepare_chunk_delta3_kv_decode(*args)\\n# Weight/KV 기능 조합 테스트\\n\\n이 문서는 weight offloading, KV offloading, weight compression, KV\\ncompression의 ON/OFF 조합이 올바른 답과 실제 runtime route를 만드는지\\n검증하는 최소 절차다. 내부 구조는\\n[LANDING_GUIDE.md](LANDING_GUIDE.md)를 참고한다.\\n\\n모든 명령은 `/root/projects/tiered-serve`에서\\n`./.venv/bin/python`으로 실행한다. 기본 matrix는 모든 cell에\\n`--fused-mm`을 전달한다.\\n\\n모든 실행 명령에는 CPython frame-stack mmap/munmap을 제거하기 위해\\n`LD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so`를 붙인다.\\n자세한 설명은 [Serving 가이드](SERVING_GUIDE.md#0-ld_preload-cpython-frame-stack-mmapmunmap-제거)를\\n참고한다. `.so` 빌드 방법은 [구조 가이드의 Tips](LANDING_GUIDE.md#6-tips)를\\n참고한다.\\n\\n## 1. Feature 정의\\n\\nCase ID는 `wo{0|1}-ko{0|1}-wc{0|1}-kc{0|1}` 형식이다.\\n\\n| 기능 | OFF | ON | 판정 기준 |\\n|---|---|---|---|\\n| Weight offload (`wo`) | 모든 projection이 `frozen_*` | 하나 이상의 projection이 `offload_*` | resolved YAML residency |\\n| KV offload (`ko`) | `--no-offload-kv` | flag 생략 + 실제 KV load | `KVLoad`와 topology |\\n| Weight compression (`wc`) | raw YAML, compressor CLI 없음 | compressed YAML + `--weight-comp p4flat` | residency와 `WDecomp` |\\n| KV compression (`kc`) | raw KV offload | KV offload + `--kv-comp p4flat` | full-block marker와 `KVDecomp` |\\n\\n`ko0,kc1`은 지원하지 않는다. 현재 runtime은 KV offloadable tier 없이\\ncompressed KV만 resident하게 유지하지 못하므로 해당 네 Boolean 행을\\n명시적으로 거부한다.\\n\\n`--no-offload-kv`는 weight 설정을 바꾸지 않는다. 또한\\n`--weight-comp p4flat`만 추가해도 raw YAML의 `offload_uncompressed`\\ncell이 자동으로 압축되지는 않는다.\\n\\nFused-MM은 다섯 번째 Boolean 축이 아니라 matrix 전체에서 고정 ON이다.\\nRaw-weight cell에서는 설치 대상이 없고, compressed-weight cell에서는\\n실제 override 수 또는 명시적인 dense fallback 수를 검사한다.\\n\\n## 2. 실행 가능한 조합\\n\\n| 모델 | Weight 상태 | KV 상태 | 실행 cell |\\n|---|---|---|---:|\\n| Llama-3.1-8B-Instruct | `(wo0,wc0)`, `(wo0,wc1)`, `(wo1,wc0)`, `(wo1,wc1)` | `(ko0,kc0)`, `(ko1,kc0)`, `(ko1,kc1)` | 12 |\\n| Llama-3.1-70B-Instruct | `(wo1,wc0)`, `(wo1,wc1)` | 동일 | 6 |\\n\\n8B matrix의 weight config는 네 pure state를 각각 사용한다.\\n\\n| `wo,wc` | Config |\\n|---|---|\\n| `0,0` | `all-frozen-uncompressed` |\\n| `0,1` | `all-frozen-compressed-p4` |\\n| `1,0` | `all-streamed-uncompressed` |\\n| `1,1` | `all-offload-compressed-p4` |\\n\\n70B BF16 raw weight 전체는 GH200 HBM에 들어가지 않으므로 `wo0` 여섯\\ncell은 실행하지 않는다. 70B의 `wo1`은 `flexgen` 또는\\n`flexgen-comp-p4`를 사용해 even layer는 raw HBM, odd layer는\\nraw/P4Flat LPDDR에 둔다. 따라서 `wo1`은 offload path가 활성이라는\\n뜻이지 모든 weight가 offload된다는 뜻은 아니다.\\n\\n## 3. Preflight\\n\\n```bash\\ncd /root/projects/tiered-serve\\n\\nnvidia-smi\\nfindmnt -no TARGET,FSTYPE,OPTIONS /mnt/hugepages\\n\\n./.venv/bin/python - <<'PY'\\nimport torch\\nimport vllm\\nimport tiered_serve\\n\\nprint(\\\"vllm:\\\", vllm.__file__)\\nprint(\\\"tiered_serve:\\\", tiered_serve.__file__)\\nprint(\\\"cuda:\\\", torch.cuda.is_available())\\nPY\\n```\\n\\nSibling vLLM과 현재 tiered-serve가 import되고, 같은 실행 경계에서 CUDA가\\n보이며, 16 GiB hugepage mount가 read-write 상태여야 한다. Patch/ABI\\n확인은 [구조 가이드](LANDING_GUIDE.md)를 따른다.\\n\\nGPU E2E를 시작하기 전에 YAML/CLI 매핑만 빠르게 검사한다.\\n\\n```bash\\n./.venv/bin/python -m pytest -q tests/test_feature_matrix_e2e.py\\n```\\n\\n환경변수를 지정하지 않으면 model E2E test는 의도적으로 skip된다.\\n\\n## 4. Feature matrix 실행\\n\\n각 cell은 `--fused-mm`을 포함한 fresh process에서 batch 1, 생성 2\\ntokens로 실행된다. Prompt는 `benchmarks/staged_correctness_prompt.txt`이고\\n정답에 `Paris`가 포함되어야 한다.\\n\\n### 4.1 8B 전체 12개\\n\\\"\\\"\\\"Offline weight/KV offload benchmark. Run with ``--help`` for options.\\\"\\\"\\\"\\n\\nimport argparse\\nfrom datetime import datetime\\nimport logging\\nimport os\\nfrom pathlib import Path\\n\\n# Let checkpoint loading and setup use the CPUs available to this process.\\n# DualMemoryLoader.init_workers() switches the main ATen team to\\n# TIERED_SERVE_MAIN_OMP_THREADS (default 1) before measured inference begins;\\n# CPU KV encoders configure their own dedicated team independently.  Do not\\n# inherit a stale generic OMP_NUM_THREADS for either phase.\\n_startup_omp_default = len(os.sched_getaffinity(0))\\n_startup_omp_threads = max(1, int(os.getenv(\\n    \\\"TIERED_SERVE_STARTUP_OMP_THREADS\\\", str(_startup_omp_default))))\\nos.environ[\\\"OMP_NUM_THREADS\\\"] = str(_startup_omp_threads)\\nos.environ[\\\"TIERED_SERVE_OMP_PHASE_SWITCH\\\"] = \\\"1\\\"\\n\\n# Hugepage discovery must happen before importing torch/vLLM/tiered-serve.\\nos.environ[\\\"TIERED_SERVE_NUM_HUGE_PAGE\\\"] = \\\"0\\\"\\n_HUGEPAGE_NR_PATH = \\\"/sys/kernel/mm/hugepages/hugepages-16777216kB/nr_hugepages\\\"\\ntry:\\n    with open(_HUGEPAGE_NR_PATH, \\\"r\\\") as f:\\n        os.environ[\\\"TIERED_SERVE_NUM_HUGE_PAGE\\\"] = str(int(f.read().strip()))\\nexcept FileNotFoundError:\\n    raise RuntimeError(\\n        f\\\"16 GiB hugepages not configured. Expected file: {_HUGEPAGE_NR_PATH}\\\\n\\\"\\n        f\\\"Reserve hugepages first, e.g.:\\\\n\\\"\\n        f\\\"  echo 16 | sudo tee {_HUGEPAGE_NR_PATH}\\\\n\\\"\\n        f\\\"  mkdir -p /mnt/hugepages\\\\n\\\"\\n        f\\\"  sudo mount -t hugetlbfs -o pagesize=16G none /mnt/hugepages\\\")\\n\\nimport