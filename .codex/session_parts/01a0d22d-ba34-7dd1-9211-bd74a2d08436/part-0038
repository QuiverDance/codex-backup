ol[\\\"entries20x3\\\"], slots, new_word_counts, relative_offsets,\\n            state.entries, state.offsets, state.word_counts,\\n            int(state.used_words), append_words,\\n            absolute_offsets=self.csr_policy == \\\"reuse\\\")\\n        state.used_words = required\\n#pragma once\\n\\n#include <set>\\n\\n// Only unused (length, offset) pairs live here. The ordinary CSR offsets and\\n// word counts remain the sole metadata for live entries. No coalescing,\\n// tail trimming, minimum remainder, or transfer layout policy is applied.\\nclass CSRFreeRanges {\\npublic:\\n    int64_t reserve(torch::Tensor slots, torch::Tensor word_counts,\\n                    torch::Tensor destinations, torch::Tensor offsets,\\n                    const HostWordCounts& previous_counts, int64_t base)\\n    {\\n        check_host_long_vector(slots, \\\"slots\\\");\\n        check_host_long_vector(word_counts, \\\"word_counts\\\");\\n        check_host_long_vector(destinations, \\\"destinations\\\");\\n        TORCH_CHECK(slots.numel() == word_counts.numel()\\n                        && slots.numel() == destinations.numel() && base >= 0,\\n                    \\\"CSR placement vectors or append base are invalid\\\");\\n        const auto* ids = slots.data_ptr<int64_t>();\\n        const auto* counts = word_counts.data_ptr<int64_t>();\\n        validate_release(ids, slots.numel(), offsets, previous_counts);\\n        int64_t maximum_end = base;\\n        for (int64_t row = 0; row < slots.numel(); ++row) {\\n            TORCH_CHECK(counts[row] >= 0\\n                            && counts[row] <= std::numeric_limits<int64_t>::max() - maximum_end,\\n                        \\\"CSR placement word count overflows int64\\\");\\n            maximum_end += counts[row];\\n        }\\n\\n        // Replacement records retire their previous ranges, just as append\\n        // marks those words as garbage. Payload and published offsets stay\\n        // untouched until the common CSR writer runs after its H2D wait.\\n        record_release(ids, slots.numel(), offsets, previous_counts);\\n        auto* starts = destinations.data_ptr<int64_t>();\\n        int64_t end = base;\\n        for (int64_t row = 0; row < slots.numel(); ++row) {\\n            const int64_t count = counts[row];\\n            const auto fit = count ? holes_.lower_bound({count, 0}) : holes_.end();\\n            if (fit == holes_.end()) {\\n                starts[row] = end;\\n                end += count;\\n            } else {\\n                const auto [length, start] = *fit;\\n                holes_.erase(fit);\\n                starts[row] = start;\\n                if (length > count) holes_.emplace(length - count, start + count);\\n            }\\n        }\\n        return end - base;\\n    }\\n\\n    static void release_pair(\\n        const HostWordCounts& slots,\\n        CSRFreeRanges* k, py::object k_offsets, py::object k_counts,\\n        CSRFreeRanges* v, py::object v_offsets, py::object v_counts)\\n    {\\n        TORCH_CHECK(slots.ndim() == 1, \\\"CSR release slots must be an int64 vector\\\");\\n        // Validate both sides before either free-range set changes. These are\\n        // the same live metadata arrays the existing retirement call clears.\\n        torch::Tensor ko, vo;\\n        HostWordCounts kc, vc;\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0d383-6076-77e3-a731-a505383593a7","create_time":1790255020.9304752}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
