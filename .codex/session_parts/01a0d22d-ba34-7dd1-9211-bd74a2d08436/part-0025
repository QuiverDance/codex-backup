kv_serial(\n        ids, slot_table, sorted_ids, *bodies, *offsets, *entries,\n        *gpu_bodies, *gpu_offsets, gpu_ids, *gpu_entries, False, 8,\n        torch.arange(4, dtype=torch.int32, device=\"cuda\"), *outputs, profile=None)\n    stream = torch.cuda.Stream()\n    begin, end = [torch.cuda.Event(enable_timing=True) for _ in range(2)]\n    begin.record(stream)\n    end.record(stream)\n    api_us, elapsed_us = [], []\n    for index in range(repetitions + 20):\n        profile = {}\n        plan.submit(0, stream.cuda_stream, profile, begin.cuda_event, end.cuda_event)\n        end.synchronize()\n        if index >= 20:\n            api_us.append(profile[\"native_api_cpu_ms\"] * 1000)\n            elapsed_us.append(begin.elapsed_time(end) * 1000)\n    return dict(bytes=plan.wire_bytes, descriptors=plan.copy_count,\n                api_us=statistics.median(api_us), elapsed_us=statistics.median(elapsed_us),\n                api_samples_us=api_us, elapsed_samples_us=elapsed_us)\n\n\ndef fit(rows, field):\n    matrix = np.asarray([[1, row[\"bytes\"], row[\"descriptors\"]] for row in rows], dtype=float)\n    values = np.asarray([row[field] for row in rows])\n    coefficients = np.linalg.lstsq(matrix, values, rcond=None)[0]\n    residual = values - matrix @ coefficients\n    variance = float(residual @ residual) / (len(rows) - 3)\n    covariance = variance * np.linalg.inv(matrix.T @ matrix)\n    return dict(intercept_us=float(coefficients[0]), us_per_byte=float(coefficients[1]),\n                descriptor_us=float(coefficients[2]),\n                descriptor_standard_error_us=math.sqrt(float(covariance[2, 2])))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    parser.add_argument(\"--repetitions\", type=int, default=101)\n    args = parser.parse_args()\n    torch.set_num_threads(1)\n    # Same byte counts with either one or four body spans vary descriptors\n    # while keeping payload and the cudaMemcpyBatchAsync backend unchanged.\n    rows = [measure(size * 1024 * 1024, spans, args.repetitions)\n            for size in (1, 4, 8, 16) for spans in (1, 4)]\n    device_fit, cpu_fit = fit(rows, \"elapsed_us\"), fit(rows, \"api_us\")\n    if device_fit[\"us_per_byte\"] <= 0:\n        raise RuntimeError(\"copy bandwidth fit was nonpositive; calibration is invalid\")\n    bytes_per_us = 1 / device_fit[\"us_per_byte\"]\n    # A fixed conservative estimate absorbs calibration noise; no serving\n    # workload, request rate or dynamic policy enters this selection.\n    descriptor_us = max(0.0, *(item[\"descriptor_us\"]\n        + 2 * item[\"descriptor_standard_error_us\"] for item in (device_fit, cpu_fit)))\n    threshold = math.ceil(bytes_per_us * descriptor_us / 8) * 8\n    result = dict(device=torch.cuda.get_device_name(), torch_version=torch.__version__,\n                  cuda_version=torch.version.cuda, repetitions=args.repetitions,\n                  rows=rows, device_fit=device_fit, cpu_fit=cpu_fit,\n                  bytes_per_us=bytes_per_us, descriptor_cost_us=descriptor_us,\n                  min_skipped_hole_bytes=threshold)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(result, indent=2) + \"\\n\")\n    print(json.dumps({key: value for key, value in result.items() if key != \"rows\"}, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed"}}
