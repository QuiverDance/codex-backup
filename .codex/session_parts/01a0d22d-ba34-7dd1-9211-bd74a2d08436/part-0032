t self._csr_cpu_optimized:\\n            return offsets.clone().pin_memory()\\n        result = self._csr_host_tensor(offsets.numel())\\n        result.copy_(offsets)\\n        return result\\n\\n    def _new_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Lazily allocate stable pinned CSR storage for one layer/side.\\\"\\\"\\\"\\n        host_rows = self._max_n_blocks + 1\\n        max_words = host_rows * self._packed_capacity\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        initial_words = min(\\n            max_words,\\n            max(1024, host_rows * self._csr_initial_words_per_slot),\\n        )\\n        state = _PersistentCSRState(\\n            entries=self._csr_host_tensor(initial_words),\\n            offsets=self._csr_host_tensor(host_rows, zero=True),\\n            word_counts=np.zeros(host_rows, dtype=np.int64),\\n            used_words=0,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        if self.csr_policy == \\\"reuse\\\":\\n            state.free_list = _cd3_ext.CSRFreeList(host_rows, max_words)\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    @cd3_cpu_profile.timed(\\\"csr.rebuild\\\")\\n    def _rebuild_persistent_csr(\\n            self, layer_id: int, kv: str, *, updated_slots=None,\\n            updated_word_counts=None):\\n        \\\"\\\"\\\"Publish compact storage while earlier readers retain old tensors.\\n\\n        The caller has exclusive access to the layer's encoder scratch. The\\n        new used length, rather than returning pinned capacity to the OS,\\n        removes garbage from subsequent contiguous H2D transfers.\\n        \\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n        rows = self._kv_slot_allocator[layer_id].high_water\\n        slots = np.arange(rows, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[:rows]\\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        if total_words > max_words:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 persistent CSR exceeds host slot capacity: \\\"\\n                f\\\"layer={layer_id} side={kv} words={total_words} \\\"\\n                f\\\"capacity={max_words}\\\")\\n        previous = self._persistent_csr[layer_id][kv]\\n        previous_capacity = (\\n            previous.entries.numel() if previous is not None else 0)\\n        capacity = max(\\n            1024, total_words,\\n            min(max_words, previous_capacity),\\n        )\\n        entries = self._csr_host_tensor(capacity)\\n        offsets = self._csr_host_tensor(self._max_n_blocks + 1, zero=True)\\n        published_counts = np.zeros(self._max_n_blocks + 1, dtype=np.int64)\\n        if self._csr_cpu_optimized and previous is not None:\\n            if updated_slots is None:\\n                updated_slots = torch.empty(0, dtype=torch.int64)\\n                updated_word_counts = updated_slots\\n            written = _cd3_ext.compact_host_chunk_delta3_csr(\\n                previous.entries[:previous.used_words], previous.offsets,\\n                previous.word_counts, updated_slots, updated_word_counts,\\n                pool[\\\"entries20x3\\\"], entries, offsets, published_counts)\\n            if written != total_words:\\n                raise RuntimeError(\\\"CD3 compacted word count disagrees with encoded scratch\\\")\\n        elif rows:\\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n                pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n                torch.from_numpy(slots), entries[:total_words],\\n                offsets[:rows])\\n            published_counts[:rows] = word_counts\\n        state = _PersistentCSRState(\\n            entries=entries,\\n            offsets=offsets,\\n            word_counts=published_counts,\\n            used_words=total_words,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        if self.csr_policy == \\\"reuse\\\":\\n            state.free_list = _cd3_ext.CSRFreeList(len(state.word_counts), max_words)\\n            state.free_list.reset(state.offsets, state.word_counts)\\n        self._persistent_csr[layer_id][kv] = state\\n        stats = self._csr_stats[layer_id, kv]\\n        stats[\\\"compactions\\\"] += 1\\n        stats[\\\"compact_words\\\"] += total_words\\n        stats[\\\"peak_used_words\\\"] = max(stats[\\\"peak_used_words\\\"], total_words)\\n        return state\\n\\n    @cd3_cpu_profile.timed(\\\"csr.update\\\")\\n    def _append_persistent_csr(\\n            self, layer_id: int, kv: str, slots: torch.Tensor) -> None:\\n        \\\"\\\"\\\"Append encoded slots using one native count/prefix calculation.\\\"\\\"\\\"\\n        count = slots.numel()\\n        if count == 0:\\n            return\\n        scratch = self._csr_append_scratch.get(layer_id)\\n        if scratch is None or scratch.shape[1] < count:\\n            capacity = max(count, 2 * scratch.shape[1] if scratch is not None else 0)\\n            scratch = torch.empty((2, capacity), dtype=torch.int64)\\n            self._csr_append_scratch[layer_id] = scratch\\n        new_word_counts = scratch[0, :count]\\n        relative_offsets = scratch[1, :count]\\n        pool = self._host_pools[layer_id][kv]\\n        state = self._persistent_csr[layer_id][kv]\\n        if state is None:\\n            state = self._new_persistent_csr(layer_id, kv)\\n        append_words, old_words = _cd3_ext.prepare_host_chunk_delta3_csr_append(\\n            pool[\\\"num_exceptions\\\"], slots, state.word_counts,\\n            new_word_counts, relative_offsets, self._packed_capacity)\\n\\n        if self.csr_policy == \\\"reuse\\\":\\n            self._reuse_persistent_csr(\\n                layer_id, kv, state, slots, new_word_counts, relative_offsets)\\n            return\\n        if self.csr_policy == \\\"compact\\\" and state.garbage_words + old_words:\\n            self._rebuild_persistent_csr(layer_id, kv, updated_slots=slots,\\n                                        updated_word_counts=new_word_counts)\\n            return\\n\\n        required = int(state.used_words) + append_words\\n        # Reuse/re-encode churn can leave unreachable append records.  Only\\n        # compact in the worker when it avoids growth or is required to stay\\n        # within the fixed GPU CSR staging capacity.\\n        should_compact = required > state.max_words\\n        should_compact |= (\\n            required > state.gpu_words\\n            and self._kv_slot_allocator[layer_id].high_water\\n            <= self._max_gpu_decomp_blocks + 1)\\n        should_compact |= (\\n            required > state.entries.numel()\\n            and state.garbage_words + old_words >= append_words)\\n        if should_compact:\\n            # Scratch rows already contain the just-encoded values, so one\\n            # rebuild publishes both the old live set and this update.\\n            self._rebuild_persistent_csr(layer_id, kv, updated_slots=slots,\\n                                        updated_word_counts=new_word_counts)\\n            return\\n\\n        if required > state.entries.numel():\\n            capacity = min(\\n                state.max_words,\\n                max(required, state.entries.numel() * 2),\\n            )\\n            entries = self._csr_host_tensor(capacity)\\n            entries[:state.used_words].copy_(\\n                state.entries[:state.used_words])\\n            offsets = self._csr_clone_offsets(state.offsets)\\n            state.entries = entries\\n            state.offsets = offsets\\n\\n        _cd3_ext.append_host_chunk_delta3_csr(\\n            pool[\\\"entries20x3\\\"], slots, new_word_counts, relative_offsets,\\n            state.entries, state.offsets, state.word_counts,\\n            int(state.used_words), append_words)\\n        state.used_words = required\\n        state.garbage_words += old_words\\n        stats = self._csr_stats[layer_id, kv]\\n        stats[\\\"append_words\\\"] += append_words\\n        stats[\\\"peak_used_words\\\"] = max(stats[\\\"peak_used_words\\\"], required)\\n\\n    @cd3_cpu_profile.timed(\\\"csr.reuse\\\")\\n    def _reuse_persistent_csr(\\n            self, layer_id, kv, state, slots, word_counts, destinations):\\n        \\\"\\\"\\\"Fill best-fit holes after the worker has waited for prior H2D.\\\"\\\"\\\"\\n        if not state.free_list.reserve(slots, word_counts, destinations):\\n            self._rebuild_persistent_csr(layer_id, kv, updated_slots=slots,\\n                                        updated_word_counts=word_counts)\\n            return\\n        layout = state.free_list.stats()\\n        required = layout[\\\"used_words\\\"]\\n        if (required > state.gpu_words\\n                and self._kv_slot_allocator[layer_id].high_water\\n                <= self._max_gpu_decomp_blocks + 1):\\n            self._rebuild_persistent_csr(layer_id, kv, updated_slots=slots,\\n                                        updated_word_counts=word_counts)\\n            return\\n        if required > state.entries.numel():\\n            capacity = min(state.max_words, max(required, state.entries.numel() * 2))\\n            entries = self._csr_host_tensor(capacity)\\n            entries[:state.used_words].copy_(state.entries[:state.used_words])\\n            state.entries = entries\\n            state.offsets = self._csr_clone_offsets(state.offsets)\\n        _cd3_ext.write_host_chunk_delta3_csr(\\n            self._host_pools[layer_id][kv][\\\"entries20x3\\\"], slots,\\n            word_counts, destinations, state.entries, state.offsets,\\n            state.word_counts)\\n        state.used_words = required\\n        state.garbage_words = required - layout[\\\"live_words\\\"]\\n        stats = self._csr_stats[layer_id, kv]\\n        stats[\\\"reuse_words\\\"] += layout[\\\"last_reused_words\\\"]\\n        stats[\\\"append_words\\\"] += layout[\\\"last_appended_words\\\"]\\n        stats[\\\"peak_used_words\\\"] = max(stats[\\\"peak_used_words\\\"], required)\\n\\n    def _discard_persistent_csr_slot(\\n            self, layer_id: int, slot: int) -> None:\\n        self._discard_persistent_csr_slots(\\n            layer_id, np.asarray([slot], dtype=np.int64))\\n\\n    @cd3_cpu_profile.timed(\\\"csr.retire\\\")\\n    def _discard_persistent_csr_slots(\\n            self, layer_id: int, slots: np.ndarray) -> None:\\n        \\\"\\\"\\\"Retire K/V scratch metadata together without touching H2D data.\\\"\\\"\\\"\\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\\n        if slots.size == 0:\\n            return\\n        counts = self._host_num_exceptions_np[layer_id]\\n        states = self._persistent_csr.get(layer_id, {})\\n        k_state, v_state = states.get(\\\"k\\\"), states.get(\\\"v\\\")\\n        policy = getattr(self, \\\"csr_policy\\\", \\\"append\\\")\\n        if policy == \\\"reuse\\\":\\n            # Allocation metadata only; the encoder still waits for preceding\\n            # H2D before reusing payload. Validate K/V IDs together once.\\n            layout = _cd3_ext.release_kv_csr_slots(\\n                slots, k_state.free_list if k_state is not None else None,\\n                v_state.free_list if v_state is not None else None)\\n        # CSR rebuild replaces its state/word-count arrays. Resolve them now;\\n        # only the fixed scratch-pool views above are cached across callbacks.\\n        k_garbage, v_garbage = _cd3_ext.retire_kv_csr_slots(\\n            slots, counts[\\\"k\\\"], counts[\\\"v\\\"],\\n            k_state.word_counts if k_state is not None else None,\\n            v_state.word_counts if v_state is not None else None,\\n        )\\n        if k_state is not None:\\n            k_state.garbage_words += k_garbage\\n        if v_state is not None:\\n            v_state.garbage_words += v_garbage\\n        for side, state, retired_words in ((\\\"k\\\", k_state, k_garbage),\\n                                           (\\\"v\\\", v_state, v_garbage)):\\n            if state is None:\\n                continue\\n            stats = getattr(self, \\\"_csr_stats\\\", {}).get((layer_id, side))\\n            if stats is not None:\\n                stats[\\\"retired_words\\\"] += retired_words\\n            if policy == \\\"compact\\\" and state.garbage_words:\\n                self._rebuild_persistent_csr(layer_id, side)\\n            elif policy == \\\"reuse\\\":\\n                index = 0 if side == \\\"k\\\" else 2\\n                state.used_words = layout[index]\\n                state.garbage_words = state.used_words - layout[index + 1]\\n\\n    def _acquire_csr_host_arena(\\n            self, length: int) -> Tuple[torch.Tensor, torch.Tensor | None]:\\n        \\\"\\\"\\\"Return an exact view backed by a retained pinned int64 arena.\\\"\\\"\\\"\\n        if length == 0:\\n            return self._csr_host_tensor(0), None\\n        capacity = 1 << (length - 1).bit_length()\\n        available = min((size for size in self._free_csr_host_arenas\\n                         if size >= capacity), default=None)\\n        if available is not None:\\n            bucket = self._free_csr_host_arenas[available]\\n            arena = bucket.pop()\\n            if not bucket:\\n                del self._free_csr_host_arenas[available]\\n        else:\\n            arena = self._csr_host_tensor(capacity)\\n        return arena[:length], arena\\n\\n    def _release_csr_plan(self, plan: _DecodePlan | None) -> None:\\n        if plan is None:\\n            return\\n        if hasattr(plan, \\\"native_plan\\\"):\\n            if plan.native_plan is not None:\\n                plan.native_plan.release_sources()\\n                plan.native_plan = None\\n#pragma once\\n\\n#include <map>\\n#include <set>\\n\\n// Included inside chunk_delta3_ext.cpp's anonymous namespace.\\nstruct CSRTransferSnapshot {\\n    int64_t used_words = 0;\\n    int64_t skipped_words = 0;\\n    std::vector<std::pair<int64_t, int64_t>> spans;\\n};\\n\\nclass CSRFreeList {\\npublic:\\n    CSRFreeList(int64_t num_slots, int64_t max_words)\\n        : max_words_(max_words)\\n    {\\n        TORCH_CHECK(num_slots >= 0 && max_words >= 0,\\n                    \\\"CSR allocator dimensions must be nonnegative\\\");\\n        offsets_.resize(num_slots);\\n        reserved_.resize(num_slots);\\n        logical_.resize(num_slots);\\n        active_.resize(num_slots, false);\\n    }\\n\\n    bool reserve(torch::Tensor slots, torch::Tensor word_counts,\\n                 torch::Tensor destinations)\\n    {\\n        check_host_long_vector(slots, \\\"slots\\\");\\n        check_host_long_vector(word_counts, \\\"word_counts\\\");\\n        check_host_long_vector(destinations, \\\"destinations\\\");\\n        TORCH_CHECK(slots.numel() == word_counts.numel()\\n                        && slots.numel() == destinations.numel(),\\n                    \\\"CSR reservation vectors must have equal length\\\");\\n\\n        const int64_t rows = slots.numel();\\n        const int64_t* ids = slots.data_ptr<int64_t>();\\n        const int64_t* counts = word_counts.data_ptr<int64_t>();\\n        std::vector<int64_t> checked_ids;\\n        std::vector<int64_t> checked_counts;\\n        checked_ids.reserve(rows);\\n        checked_counts.reserve(rows);\\n        for (int64_t row = 0; row < rows; ++row) {\\n            checked_ids.push_back(ids[row]);\\n            checked_counts.push_back(counts[row]);\\n        }\\n        std::vector<int64_t> sorted = checked_ids;\\n        std::sort(sorted.begin(), sorted.end());\\n        TORCH_CHECK(std::adjacent_find(sorted.begin(), sorted.end()) == sorted.end(),\\n                    \\\"duplicate CSR reservation slot\\\");\\n        for (int64_t row = 0; row < rows; ++row) {\\n            TORCH_CHECK(checked_ids[row] >= 0\\n                            && checked_ids[row] < static_cast<int64_t>(offsets_.size()),\\n                        \\\"CSR reservation slot out of range\\\");\\n            TORCH_CHECK(checked_counts[row] >= 0 && checked_counts[row] <= max_words_,\\n                        \\\"CSR reservation word count out of range\\\");\\n        }\\n        if (!usable_) return false;\\n\\n        // An unsuccessful plan is discarded by rebuilding from authoritative\\n        // scratch data. No payload or output offset is written on failure.\\n        usable_ = false;\\n        last_reused_words_ = 0;\\n        last_appended_words_ = 0;\\n        std::vector<int64_t> planned(rows);\\n        release_validated(checked_ids);\\n        for (int64_t row = 0; row < rows; ++row) {\\n            const int64_t slot = checked_ids[row];\\n            const int64_t count = checked_counts[row];\\n            if (count == 0) {\\n                active_[slot] = true;\\n                planned[row] = 0;\\n                continue;\\n            }\\n            const auto fit = holes_by_size_.lower_bound({count, 0});\\n            if (fit != holes_by_size_.end()) {\\n                const int64_t start = fit->second;\\n                const int64_t hole_words = fit->first;\\n                remove_hole(start);\\n                const int64_t remainder = hole_words - count;\\n                const int64_t owned = remainder < 8 ? hole_words : count;\\n                if (remainder >= 8) add_hole(start + count, remainder);\\n                offsets_[slot] = start;\\n                reserved_[slot] = owned;\\n                last_reused_words_ += count;\\n            } else {\\n                if (count > max_words_ - used_words_) return false;\\n                offsets_[slot] = used_words_;\\n                reserved_[slot] = count;\\n                used_words_ += count;\\n                last_appended_words_ += count;\\n            }\\n            logical_[slot] = count;\\n            live_words_ += count;\\n            active_[slot] = true;\\n            planned[row] = offsets_[slot];\\n        }\\n        std::copy(planned.begin(), planned.end(), destinations.data_ptr<int64_t>());\\n        usable_ = true;\\n        return true;\\n    }\\n\\n    void release(const HostWordCounts& slots)\\n    {\\n        const auto& checked = validate_release(slots);\\n        usable_ = false;\\n        release_validated(checked);\\n        usable_ = true;\\n    }\\n\\n    static std::array<int64_t, 4> release_pair(\\n        const HostWordCounts& slots, CSRFreeList* k, CSRFreeList* v)\\n    {\\n        CSRFreeList* first = k ? k : v;\\n        if (!first) return {0, 0, 0, 0};\\n        // Check both allocators before either changes. The common slot IDs\\n        // need only one copy, bounds pass and duplicate check for K and V.\\n        const auto& checked = first->validate_release(slots, k && v ? v : nullptr);\\n        for (auto* allocator : {k, v}) {\\n            if (allocator) {\\n                allocator->usable_ = false;\\n                allocator->release_validated(checked);\\n                allocator->usable_ = true;\\n            }\\n        }\\n        return {k ? k->used_words_ : 0, k ? k->live_words_ : 0,\\n                v ? v->used_words_ : 0, v ? v->live_words_ : 0};\\n    }\\n\\n    void reset(torch::Tensor offsets, const HostWordCounts& word_counts)\\n    {\\n        check_host_long_vector(offsets, \\\"offsets\\\");\\n        TORCH_CHECK(word_counts.ndim() == 1\\n                        && offsets.numel() == static_cast<int64_t>(offsets_.size())\\n                        && word_counts.size() == offsets.numel(),\\n                    \\\