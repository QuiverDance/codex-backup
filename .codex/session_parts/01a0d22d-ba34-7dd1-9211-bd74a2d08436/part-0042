{"timestamp":"2026-09-24T14:25:32.790Z","ordinal":3759,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0d3ce-ae76-76a1-ac3f-c8962416116b","call_id":"call_R9Se6MUdZei4HlNkschEfQ62","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 18188)\nTotal output lines: 3\n\n{\"i\":0,\"output\":\"\\\"\\\"\\\"ChunkDelta3 backend for persistent offloaded KV blocks.\\n\\nKV exponent deltas use three bits by default, or four with\\nTIERED_SERVE_KV_CD3_DELTA_BITS=4. Weight CD3 remains three-bit.\\nEach host slot keeps a fixed CD3 body and bounded CPU-encode scratch.  CPU\\nencode workers append the exact Packed20 words to persistent CSR storage, so\\nthe per-forward decode plan only references already-packed pinned memory.\\nRecords whose exact compressed representation is not smaller than raw BF16\\nare restored from authoritative secondary KV.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport atexit\\nimport ctypes\\nimport glob\\nimport hashlib\\nimport json\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time as _time\\nfrom dataclasses import dataclass, field\\nfrom typing import Any, Dict, Tuple\\n\\nimport numpy as np\\nimport torch\\n\\nfrom tiered_serve import cd3_cpu_profile, kv_cpu_profile, kv_load_metrics\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\\nfrom tiered_serve.compression.core.chunk_delta3 import (\\n    _HAS_CHUNK_DELTA3,\\n    _cd3_ext,\\n)\\n\\n\\nlogger = logging.getLogger(__name__)\\n\\n@dataclass\\nclass _PersistentCSRState:\\n    entries: torch.Tensor\\n    offsets: torch.Tensor\\n    word_counts: np.ndarray\\n    used_words: int\\n    garbage_words: int\\n    max_words: int\\n    gpu_words: int\\n    free_ranges: Any = None\\n\\n\\n@dataclass\\nclass _DecodePlan:\\n    layer_id: int\\n    block_ids: np.ndarray\\n    block_ids_tensor: torch.Tensor | None\\n    block_ids_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event | None\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n    completion_valid: bool = True\\n    profile_active_entry_bytes: int | None = None\\n    native_plans: list = field(default_factory=list)\\n    side_payload: tuple = (0, 0)\\n    side_alignment: tuple = (0, 0)\\n    side_gap: tuple = (0, 0)\\n    csr_garbage_bytes: int = 0\\n    serial_native: Any = None\\n    output_buffers: tuple = ()\\n    entry_wire_bytes: tuple = (0, 0)\\n    csr_skipped_bytes: int = 0\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    kv_load_metrics_supported = True\\n    supports_kv_ownership = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        required = (\\n            \\\"decompress_chunk_delta3_batched_csr_pair_stream\\\",\\n            \\\"pack_host_chunk_delta3_entries_csr\\\",\\n            \\\"prepare_chunk_delta3_kv_decode\\\",\\n            \\\"KVSlotAllocator\\\",\\n            \\\"retire_kv_csr_slots\\\",\\n            \\\"prepare_host_chunk_delta3_csr_append\\\",\\n            \\\"append_host_chunk_delta3_csr\\\",\\n        )\\n        if (not _HAS_CHUNK_DELTA3\\n                or any(not hasattr(_cd3_ext, name) for name in required)):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the CSR KV decoder and native slot allocator\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        if \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\\\" in os.environ:\\n            raise ValueError(\\n                \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES was removed; unset it. \\\"\\n                \\\"CD3 always uses separate load and decode streams.\\\")\\n        if os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") == \\\"1\\\":\\n            raise ValueError(\\\"CD3 requires separate load and decode streams; \\\"\\n                             \\\"unset TIERED_SERVE_KV_NO_SPLIT.\\\")\\n        self._decode_ring_idx = 0\\n        self._gpu_decomp_pool_ring = []\\n        self._decode_consumed = []\\n        self._tb = False\\n        self.storage_requested = os.getenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", \\\"csr\\\")\\n        self.execution_requested = os.getenv(\\\"TIERED_SERVE_KV_CD3_EXECUTION\\\", \\\"serial\\\")\\n        self.csr_policy = os.getenv(\\\"TIERED_SERVE_KV_CD3_CSR_POLICY\\\", \\\"compact\\\")\\n        self.cpu_path = os.getenv(\\\"TIERED_SERVE_KV_CD3_CPU_PATH\\\", \\\"optimized\\\")\\n        if self.cpu_path not in (\\\"legacy\\\", \\\"optimized\\\"):\\n            raise ValueError(\\\"CD3 CPU path must be legacy or optimized\\\")\\n        self._csr_cpu_optimized = self.cpu_path == \\\"optimized\\\"\\n        if self.storage_requested not in (\\\"csr\\\", \\\"hybrid\\\"):\\n            raise ValueError(\\\"CD3 KV storage must be csr or hybrid\\\")\\n        if self.execution_requested not in (\\\"serial\\\", \\\"pipeline\\\"):\\n            raise ValueError(\\\"CD3 KV execution must be serial or pipeline\\\")\\n        if self.csr_policy not in (\\\"append\\\", \\\"compact\\\", \\\"reuse\\\"):\\n            raise ValueError(\\\"CD3 CSR policy must be append, compact, or reuse\\\")\\n        full_blocks = os.getenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"0\\\") == \\\"1\\\"\\n        self.storage_backend = self.storage_requested if full_blocks else \\\"csr\\\"\\n        if self.csr_policy != \\\"append\\\" and self.storage_backend != \\\"csr\\\":\\n            raise ValueError(\\\"CD3 CSR garbage policies require CSR storage\\\")\\n        self.storage_fallback_reason = (\\n            \\\"requires_full_block_only\\\" if self.storage_backend != self.storage_requested else \\\"\\\")\\n        if (self.storage_backend == \\\"hybrid\\\" or self.execution_requested == \\\"pipeline\\\"):\\n            if not hasattr(_cd3_ext, \\\"prepare_chunk_delta3_kv_pipeline\\\"):\\n                raise RuntimeError(\\\"CD3 KV hybrid/pipeline requires the updated native extension\\\")\\n        if self.storage_backend == \\\"hybrid\\\" and not hasattr(_cd3_ext, \\\"HybridKVStore\\\"):\\n            raise RuntimeError(\\\"CD3 hybrid storage requires the updated native extension\\\")\\n        self._hybrid_stores = {}\\n        self._hybrid_ownership = {}\\n        self._entry_pool = None\\n        self._entry_arenas = []\\n        self._hybrid_allocator = None\\n        self._worker_encode_scratch = []\\n        self._record_generations = {}\\n        self._encode_chunk_blocks = max(1, int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_ENCODE_CHUNK_BLOCKS\\\", \\\"64\\\")))\\n        self._kv_side_intervals = []\\n        self._kv_decode_intervals = []\\n        self._kv_timed_layers = set()\\n        self._pipeline_timing_pool = []\\n        self._reported_execution_modes = set()\\n\\n        self._compressed_kv = {}\\n        self._persistent_valid = {}\\n        self._persistent_valid_np = {}\\n        self._kv_slot = {}\\n        self._kv_slot_np = {}\\n        self._kv_slot_block = {}\\n        self._kv_slot_allocator = {}\\n        self._kv_free_metadata_only = True\\n        self._pending_compress = {}\\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\\n        self._host_num_exceptions_np = {}\\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\\n        self._kv_pools_ready = False\\n\\n        self._block_shape = ()\\n        self._block_numel = 0\\n        self._M_b = 0\\n        self._K_b = 0\\n        self._tiles_per_block = 0\\n        self._code_bytes = 0\\n        self._base_bytes = 0\\n        self._entry_capacity = 0\\n        self._packed_capacity = 0\\n        self._body_stride = 0\\n        self._body_layout = {}\\n        self._max_n_blocks = 0\\n        self._max_gpu_decomp_blocks = 0\\n        self._n_layers = 0\\n        self._identity_slots_gpu = None\\n        self._block_ids_gpu_ring = []\\n        self._decode_generation = {}\\n        self._decode_filtered = {}\\n        self._decode_plans = {}\\n        self._decode_extra_plans = {}\\n        self._decode_chunks = {}\\n        self._persistent_csr = {}\\n        self._csr_stats = {}\\n        self._csr_append_scratch = {}\\n        self._host_encode_outputs = {}\\n        self._csr_initial_words_per_slot = max(1, int(os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_CSR_INITIAL_WORDS_PER_SLOT\\\", \\\"128\\\")))\\n        self._free_csr_host_arenas = {}\\n        self._free_csr_h2d_events = []\\n        self._retired_csr_plans = []\\n        self._secondary_fallback_possible = {}\\n        # The loader computes one canonical active KV set per forward and then\\n        # passes the same Python list to every layer.  Compare that set once at\\n        # the step boundary instead of running np.array_equal in every layer's\\n        # decompress_batch call.  The held list reference makes the identity\\n        # check generation-safe (CPython cannot recycle its id while held).\\n        self._prepared_active_list = None\\n        self._prepared_active_candidates = None\\n        self._prepared_active_version = 0\\n        self._storage_metrics_enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n\\n    @staticmethod\\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\\n\\n        result = compressed_block_bytes(\\\"chunk_delta3\\\", block_elements)\\n        assert result is not None\\n        return result\\n\\n    def _build_body_layout(self) -> None:\\n        layout = {}\\n        offset = 0\\n        for name, width, dtype, alignment in (\\n            (\\\"codes\\\", self._code_bytes, torch.uint8, 1),\\n            (\\\"sign_mantissa\\\", self._block_numel, torch.uint8, 1),\\n            (\\\"thread_bases\\\", self._base_bytes, torch.uint8, 1),\\n            (\\\"tile_exception_offsets\\\", self._tiles_per_block + 1,\\n             torch.int32, 4),\\n        ):\\n            offset = _align_up(offset, alignment)\\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\\n        self._free_csr_h2d_events = []\\n        self._retired_csr_plans = []\\n        self._secondary_fallback_possible = {\\n            layer: False for layer in range(n_layers)}\\n        self._prepared_active_list = None\\n        self._prepared_active_candidates = None\\n        self._prepared_active_version = 0\\n        self._persistent_valid = {\\n            layer: bytearray(host_n) for layer in range(n_layers)}\\n        self._persistent_valid_np = {\\n            layer: np.frombuffer(valid, dtype=np.uint8)\\n            for layer, valid in self._persistent_valid.items()\\n        }\\n        self._kv_slot = {\\n            layer: torch.full((host_n,), -1, dtype=torch.int32)\\n            for layer in range(n_layers)}\\n        self._kv_slot_np = {\\n            layer: self._kv_slot[layer].numpy()\\n            for layer in range(n_layers)}\\n        self._kv_slot_block = {\\n            layer: np.full(host_n, -1, dtype=np.int32)\\n            for layer in range(n_layers)}\\n        self._kv_slot_allocator = {\\n            layer: _cd3_ext.KVSlotAllocator(host_n)\\n            for layer in range(n_layers)}\\n        self._kv_dec_h2d = [\\n            torch.cuda.Event(enable_timing=True, external=True)\\n            for _ in range(n_layers)\\n        ]\\n        self._kv_h2d_begin = [\\n            torch.cuda.Event(enable_timing=True, external=True)\\n            for _ in range(n_layers)\\n        ]\\n        self._kv_decode_begin = [\\n            torch.cuda.Event(enable_timing=True, external=True)\\n            for _ in range(n_layers)\\n        ]\\n        self._kv_load_probe_events = [\\n            tuple(torch.cuda.Event(enable_timing=True) for _ in range(6))\\n            for _ in range(n_layers)] if self._tb else []\\n        # Give CPU workers a completed initial event for layers that have not\\n        # loaded persistent compressed data yet.\\n        with torch.cuda.stream(self.batch_decomp_stream):\\n            for event in self._kv_dec_h2d:\\n                event.record(self.batch_decomp_stream)\\n            for event in self._kv_h2d_begin:\\n                event.record(self.batch_decomp_stream)\\n            for event in self._kv_decode_begin:\\n                event.record(self.batch_decomp_stream)\\n            for events in self._kv_load_probe_events:\\n                for event in events:\\n                    event.record(self.batch_decomp_stream)\\n        self._kv_pools_ready = True\\n        # These reservations are fixed at startup. Do not walk tensor aliases\\n        # or descriptors in each model forward just to measure them again.\\n        self._fixed_host_bytes = sum(\\n            pool[name].nbytes for pools in self._host_pools.values()\\n            for pool in pools.values()\\n            for name in (\\\"body\\\", \\\"entries20x3\\\", \\\"num_exceptions\\\") if name in pool)\\n        self._fixed_host_bytes += sum(arena.nbytes for arena in self._entry_arenas)\\n        self._host_uses_hugepages = huge_page_allocator is not None\\n        self._gpu_staging_bytes = sum(\\n            tensor.nbytes for pool in self._gpu_decomp_pool_ring\\n            for side in pool.values() for tensor in side.values())\\n        self._gpu_staging_bytes += sum(t.nbytes for t in self._block_ids_gpu_ring)\\n        self._gpu_staging_bytes += self._identity_slots_gpu.nbytes\\n        with open(_cd3_ext.__file__, \\\"rb\\\") as native_binary:\\n            self._native_build_sha256 = hashlib.file_digest(native_binary, \\\"sha256\\\").hexdigest()\\n        logger.info(\\\"CD3 fixed buffers host_bytes=%d gpu_staging_bytes=%d native_sha256=%s\\\",\\n                    self._fixed_host_bytes, self._gpu_staging_bytes, self._native_build_sha256)\\n        self._pipeline_k_done = [torch.cuda.Event() for _ in range(2)]\\n        self._pipeline_v_done = [torch.cuda.Event() for _ in range(2)]\\n        # Materialize handles outside native submission; event recording is\\n        # otherwise unnecessary until the first producer uses them.\\n        for event in (*self._pipeline_k_done, *self._pipeline_v_done):\\n            event.record(self.batch_decomp_stream)\\n        logger.info(\\\"CD3 KV storage requested=%s effective=%s fallback=%s execution=%s\\\",\\n                    self.storage_requested, self.storage_backend,\\n                    self.storage_fallback_reason or \\\"none\\\", self.execution_requested)\\n        if self.storage_backend == \\\"csr\\\":\\n            logger.info(\\\"CD3 CSR garbage policy=%s CPU path=%s\\\", self.csr_policy, self.cpu_path)\\n\\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\\n        logger.info(\\n            \\\"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \\\"\\n            \\\"delta_bits=%d decode_threads=%d \\\"\\n            \\\"entry_capacity=%d body=%d host_slot=%d bytes \\\"\\n            \\\"(%.3fx raw worst-case allocation) \\\"\\n            \\\"max_blocks=%d layers=%d\\\",\\n            block_shape, M_b, K_b, delta_bits,\\n            _cd3_ext.compiled_kv_decode_threads(), entry_capacity, self._body_stride,\\n            slot_bytes,\\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\\n\\n    def _init_hybrid_storage(self, host_n, n_layers, huge_page_allocator):\\n        from tiered_serve.kv_codec_spec import chunk_delta3_hybrid_memory_budget\\n        self._hybrid_allocator = huge_page_allocator\\n        self._hybrid_planner_bytes = n_layers * _cd3_ext.hybrid_planner_budget(\\n            host_n, min(self._max_gpu_decomp_blocks, host_n))\\n        budget = chunk_delta3_hybrid_memory_budget(\\n            self._block_numel, host_n - 1, n_layers, self._n_workers,\\n            self._encode_chunk_blocks, planner_bytes=self._hybrid_planner_bytes)\\n        available = budget.entry_budget_bytes\\n        minimum_segment = 1 << (self._packed_capacity * 8 - 1).bit_length()\\n        segment_bytes = max(64 * 1024, minimum_segment)\\n        while segment_bytes > minimum_segment and available < segment_bytes * 8:\\n            segment_bytes //= 2\\n        pool_bytes = available // segment_bytes * segment_bytes\\n        metadata_bytes = _cd3_ext.hybrid_entry_pool_metadata_budget(pool_bytes, segment_bytes)\\n        pool_bytes = (available - metadata_bytes) // segment_bytes * segment_bytes\\n        if pool_bytes < 2 * segment_bytes:\\n            raise ValueError(\\\"CD3 hybrid host budget cannot hold the K/V entries segments\\\")\\n        self._hybrid_planner_bytes += metadata_bytes\\n        self._hybrid_scratch_bytes = budget.scratch_bytes\\n        self._encode_chunk_blocks = budget.scratch_rows_per_worker\\n        self._host_pools = {\\n            layer: {side: self._host_pool(host_n, huge_page_allocator, body_only=True)\\n                    for side in (\\\"k\\\", \\\"v\\\")} for layer in range(n_layers)}\\n        self._hybrid_scratch_queue = queue.LifoQueue()\\n        for _ in range(budget.scratch_workers):\\n            scratch = {side: {\\n                \\\"entries20x3\\\": torch.empty((self._encode_chunk_blocks, self._packed_capacity),\\n                                          dtype=torch.int64),\\n                \\\"num_exceptions\\\": torch.empty(self._encode_chunk_blocks, dtype=torch.int32),\\n            } for side in (\\\"k\\\", \\\"v\\\")}\\n            self._worker_encode_scratch.append(scratch)\\n            self._hybrid_scratch_queue.put(scratch)\\n        # Reserve backing arenas once. Runtime segment checkout is native\\n        # free-list/bump allocation and never invokes the hugepage allocator.\\n        arena_bytes = max(segment_bytes, (pool_bytes // (2 * n_layers)\\n                                          // segment_bytes) * segment_bytes)\\n        remaining = pool_bytes\\n        while remaining:\\n            size = min(arena_bytes, remaining)\\n            self._entry_arenas.append(self._alloc_host_tensor(\\n                (size,), torch.uint8, huge_page_allocator))\\n            remaining -= size\\n        self._entry_pool = _cd3_ext.HybridEntryPool(self._entry_arenas, segment_bytes)\\n        self._hybrid_ownership = {layer: {} for layer in range(n_layers)}\\n        logger.info(\\\"CD3 hybrid host budget=%d body=%d entries=%d scratch=%d counts=%d planner=%d segment=%d\\\",\\n                    budget.total_by