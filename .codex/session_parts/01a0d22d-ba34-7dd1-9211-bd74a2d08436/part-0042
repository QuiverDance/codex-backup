\\nfrom __future__ import annotations\\n\\nimport os\\nfrom dataclasses import dataclass\\nfrom typing import Optional\\n\\n\\n_P4_LAYOUTS = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"ublb_flat\\\", \\\"ublb_tbe\\\"})\\n_FULL_BLOCK_ONLY = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"chunk_delta3\\\"})\\ndef chunk_delta3_base_rows() -> int:\\n    value = int(os.getenv(\\\"TIERED_SERVE_CD3_BASE_ROWS\\\", \\\"16\\\"))\\n    if value not in (1, 16, 32, 64):\\n        raise ValueError(\\n            \\\"TIERED_SERVE_CD3_BASE_ROWS must be 1, 16, 32, or 64\\\")\\n    return value\\n\\n\\ndef chunk_delta3_kv_delta_bits() -> int:\\n    \\\"\\\"\\\"KV-only exponent delta width; weight CD3 always uses three bits.\\\"\\\"\\\"\\n    value = int(os.getenv(\\\"TIERED_SERVE_KV_CD3_DELTA_BITS\\\", \\\"3\\\"))\\n    if value not in (3, 4):\\n        raise ValueError(\\\"TIERED_SERVE_KV_CD3_DELTA_BITS must be 3 or 4\\\")\\n    return value\\n\\n\\ndef supports_full_block_only(backend: str) -> bool:\\n    return backend.lower() in _FULL_BLOCK_ONLY\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef chunk_delta3_body_bytes(elements: int) -> int:\\n    \\\"\\\"\\\"Return codec payload through the last tile exception offset.\\\"\\\"\\\"\\n    if elements <= 0 or elements % 4096:\\n        raise ValueError(\\n            \\\"ChunkDelta3 KV block size must be a positive multiple of 4096\\\")\\n    tiles = elements // 4096\\n    body_end = (elements * chunk_delta3_kv_delta_bits() // 8 + elements\\n                + tiles * (256 // chunk_delta3_base_rows()))\\n    return _align_up(body_end, 4) + (tiles + 1) * 4\\n\\n\\ndef chunk_delta3_body_stride(elements: int) -> int:\\n    \\\"\\\"\\\"Return the 128-byte-aligned fixed CSR body row size.\\\"\\\"\\\"\\n    return _align_up(chunk_delta3_body_bytes(elements), 128)\\n\\n\\ndef chunk_delta3_exception_capacity(elements: int) -> int:\\n    \\\"\\\"\\\"Return CPU encode scratch capacity in logical Packed20 entries.\\n\\n    Serving transfers a compact CSR arena containing only the words actually\\n    used, so scratch capacity no longer determines H2D size.  By default the\\n    scratch holds every exception count for which the exact CSR representation\\n    remains smaller than raw BF16.  Larger records are restored from the\\n    authoritative raw secondary KV.  An explicit override can reduce the\\n    scratch allocation, but it is clamped to that useful maximum.\\n\\n    \\\"\\\"\\\"\\n    body_stride = chunk_delta3_body_stride(elements)\\n    # One int64 CSR word offset is transferred per block. Require the\\n    # compressed representation to be strictly smaller than raw BF16.\\n    available = elements * 2 - body_stride - 8\\n    useful_capacity = max(3, ((max(1, available) - 1) // 8) * 3)\\n    override = os.getenv(\\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\")\\n    if override is None:\\n        return useful_capacity\\n    requested = ((max(3, int(override)) + 2) // 3) * 3\\n    return min(requested, useful_capacity)\\n\\n\\n@dataclass(frozen=True)\\nclass ChunkDelta3HybridMemoryBudget:\\n    total_bytes: int\\n    body_bytes: int\\n    entry_budget_bytes: int\\n    scratch_bytes: int\\n    count_bytes: int\\n    planner_bytes: int\\n    scratch_workers: int\\n    scratch_rows_per_worker: int\\n\\n\\ndef chunk_delta3_hybrid_memory_budget(\\n        elements: int, max_blocks: int, n_layers: int, n_workers: int,\\n        chunk_blocks: int, planner_bytes: int = 0\\n        ) -> ChunkDelta3HybridMemoryBudget:\\n    \\\"\\\"\\\"Partition the original compressed-host allowance; entries have one owner.\\\"\\\"\\\"\\n    if min(max_blocks, n_layers, n_workers, chunk_blocks) <= 0 or planner_bytes < 0:\\n        raise ValueError(\\\"hybrid memory planning requires positive capacities\\\")\\n    rows = max_blocks + 1\\n    per_side = compressed_block_bytes(\\\"chunk_delta3\\\", elements)\\n    total = per_side * rows