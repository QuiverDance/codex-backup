       \"cd3_gap_bytes\", \"cd3_copy_descriptors\", \"cd3_batch_calls\",\n                           \"cd3_plan_builds\", \"cd3_plan_hits\")\n            record.update(dict.fromkeys(byte_fields, 0))\n            record.update(server_forwards=0, small_decode_forwards=0,\n                          small_decode_raw_bytes=0, small_decode_h2d_bytes=0)\n            for metrics_file in metrics_dir.glob(\"kv_metrics.*.csv\"):\n                for row in csv.DictReader(metrics_file.open()):\n                    if row[\"bytes_complete\"] != \"1\":\n                        raise ValueError(f\"incomplete byte accounting: {metrics_file}\")\n                    record[\"server_forwards\"] += 1\n                    for field in byte_fields:\n                        value = row.get(field, \"NA\")\n                        if value not in (\"NA\", \"\"):\n                            record[field] += int(value)\n                    if row[\"phase\"] == \"decode\" and int(row[\"tokens\"]) <= 8:\n                        record[\"small_decode_forwards\"] += 1\n                        record[\"small_decode_raw_bytes\"] += int(row[\"kv_raw_bytes\"])\n                        record[\"small_decode_h2d_bytes\"] += int(row[\"kv_h2d_bytes\"])\n            record[\"h2d_per_raw\"] = record[\"kv_h2d_bytes\"] / record[\"kv_raw_bytes\"]\n            record[\"garbage_per_raw\"] = record[\"cd3_csr_garbage_bytes\"] / record[\"kv_raw_bytes\"]\n            summaries = [json.loads(line) for path in metrics_dir.glob(\"cd3_storage.*.jsonl\")\n                         for line in path.read_text().splitlines()]\n            record[\"storage_summaries\"] = summaries\n            if summaries:\n                record[\"native_sha256\"] = summaries[-1][\"native_sha256\"]\n                record[\"gpu_peak_reserved_bytes\"] = max(s[\"gpu_peak_reserved_bytes\"] for s in summaries)\n                record[\"gpu_staging_bytes\"] = summaries[-1][\"gpu_staging_bytes\"]\n                record[\"fixed_host_bytes\"] = summaries[-1][\"fixed_host_bytes\"]\n            records.append(record)\n    return records\n\n\ndef rank(records):\n    metrics = (\"tpot_p50_ms\", \"tpot_p90_ms\", \"ttft_p90_ms\", \"duration_s\", \"slo200_pct\")\n    grouped = {}\n    for row in records:\n        grouped.setdefault((row[\"candidate\"], row[\"workload\"]), []).append(row)\n    medians = {key: {name: statistics.median(row[name] for row in rows) for name in metrics}\n               for key, rows in grouped.items()}\n    result = []\n    for candidate in sorted({row[\"candidate\"] for row in records}):\n        if any((candidate, s) not in medians or (\"A\", s) not in medians for s in (\"S1\", \"S2\")):\n            continue\n        ratios, regressions = [], []\n        for workload in (\"S1\", \"S2\"):\n            values, baseline = medians[candidate, workload], medians[\"A\", workload]\n            ratios.append(values[\"tpot_p50_ms\"] / baseline[\"tpot_p50_ms\"])\n            for name, limit in ((\"tpot_p50_ms\", 1.02), (\"tpot_p90_ms\", 1.05),\n                                (\"ttft_p90_ms\", 1.05), (\"duration_s\", 1.05)):\n                if values[name] > baseline[name] * limit:\n                    regressions.append(f\"{workload}:{name}\")\n            if values[\"slo200_pct\"] < baseline[\"slo200_pct\"] - 2:\n                regressions.append(f\"{workload}:slo200_pct\")\n        result.append(dict(candidate=candidate, score=math.sqrt(math.prod(ratios)),\n                           regression_flags=regressions,\n                           runs={s: len(grouped[candidate, s]) for s in (\"S1\", \"S2\")},\n                           medians={s: medians[candidate, s] for s in (\"S1\", \"S2\")}))\n    return sorted(result, key=lambda item: item[\"score\"])\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"directory\", type=Path)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    args = parser.parse_args()\n    records = collect(args.directory)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps({\"runs\": records, \"ranking\": rank(records)}, indent=2) + \"\\n\")\n    if records:\n        fields = list(dict.fromkeys(key for row in records for key in row if key != \"storage_summaries\"))\n        with args.output.with_suffix(\".csv\").open(\"w\", newline=\"\") as output:\n            writer = csv.DictWriter(output, fieldnames=fields)\n            writer.writeheader()\n            writer.writerows({key: row.get(key) for key in fields} for row in records)\n    print(json.dumps({\"completed_runs\": len(records), \"ranking\": rank(records)}, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed"}}
