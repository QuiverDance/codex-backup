       assert torch.count_nonzero(k_cache[6]).item() == 0\\n        assert torch.count_nonzero(v_cache[6]).item() == 0\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n        kv_cpu_profile.begin_run(False)\\n\\n\\ndef test_cpu_kv_compact_row_matches_planner(monkeypatch) -> None:\\n    from tiered_serve.chunk_delta3_kv_compressor import (\\n        ChunkDelta3KVCompressor,\\n    )\\n    from tiered_serve.kv_codec_spec import compressed_block_bytes\\n    from tiered_serve.kv_codec_spec import (\\n        chunk_delta3_body_stride,\\n        chunk_delta3_exception_capacity,\\n    )\\n\\n    monkeypatch.delenv(\\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\", raising=False)\\n    monkeypatch.delenv(\\n        \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\\\", raising=False)\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\\n    compressor.load_kv_stream = torch.cuda.Stream()\\n    try:\\n        block_shape = (16, 8, 128)\\n        compressor.warmup_kv_buffers(\\n            block_shape, max_n_blocks=1, n_layers=1,\\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\\n        expected_capacity = chunk_delta3_exception_capacity(16384)\\n        expected_body_stride = chunk_delta3_body_stride(16384)\\n        assert compressor._entry_capacity == expected_capacity\\n        assert compressor._body_stride == expected_body_stride\\n        assert \\\"body\\\" in compressor._host_pools[0][\\\"k\\\"]\\n        assert \\\"blob\\\" not in compressor._host_pools[0][\\\"k\\\"]\\n        assert set(compressor._gpu_decomp_pool[\\\"k\\\"]) == {\\n            \\\"body\\\", \\\"entries20x3\\\", \\\"entry_word_offsets\\\"}\\n        assert compressed_block_bytes(\\\"chunk_delta3\\\", 16384) == (\\n            expected_body_stride + (expected_capacity // 3) * 8 + 4)\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n\\n\\ndef test_cpu_kv_exception_overflow_restores_raw_secondary(\\n        monkeypatch) -> None:\\n    from tiered_serve.ch