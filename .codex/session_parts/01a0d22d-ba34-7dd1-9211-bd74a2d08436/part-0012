ss Transfer:\\n    def __init__(self, timing):\\n        # Native staging fills this reusable list before the begin event.\\n        self.stats = [0, 0, 0]  # dense-equivalent, encoded payload, H2D\\n        self.layer = -1\\n        self.events = None\\n        self.handles = (0, 0)\\n        if timing:\\n            import torch\\n            self.events = tuple(torch.cuda.Event(enable_timing=True)\\n                                for _ in range(2))\\n            for event in self.events:\\n                event.record()  # Materialize native handles once.\\n            self.handles = tuple(event.cuda_event for event in self.events)\\n\\n    def begin(self, stream):\\n        if self.events:\\n            self.events[0].record(stream)\\n\\n    def end(self, stream):\\n        if self.events:\\n            self.events[1].record(stream)\\n\\n\\nclass KVLoadMetrics:\\n    def __init__(self, *, timing=False, path=None, capacity=0):\\n        self.timing = timing\\n        self.active = False\\n        self.forward = -1\\n        self.batch = self.step = -1\\n        self.config = \\\"serving\\\"\\n        self.pool = [Transfer(timing) for _ in range(capacity)]\\n        self.layer = -1\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.last = None\\n        self.cd3 = {}\\n        self.file = None\\n        if path:\\n            Path(path).parent.mkdir(parents=True, exist_ok=True)\\n            # One write per forward, never per layer; line buffering also\\n            # preserves completed forwards when a serving worker is stopped.\\n            self.file = open(path, \\\"w\\\", buffering=1)\\n            self.writer = csv.DictWriter(self.file, fieldnames=COLUMNS)\\n            self.writer.writeheader()\\n            atexit.register(self.close)\\n\\n    def close(self):\\n        if self.file:\\n            self.file.close()\\n            self.file = None\\n\\n    def begin_forward(self, is_prefill, tokens):\\n        self.forward += 1\\n        self.layer = -1\\n        self.phase = \\\"prefill\\\" if is_prefill else \\\"decode\\\"\\n        self.tokens = tokens\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.active = True\\n        self.cd3 = {}\\n\\n    def record_cd3(self, *, modes, counters):\\n        for key, value in modes.items():\\n            self.cd3[key] = value\\n        for key, value in counters.items():\\n            self.cd3[key] = self.cd3.get(key, 0) + value\\n\\n    def add_payload(self, raw_bytes, payload_bytes):\\n        self.raw_bytes += raw_bytes\\n        self.payload_bytes += payload_bytes\\n\\n    def transfer(self, raw_bytes=0, payload_bytes=0):\\n        if self.count == len(self.pool):\\n            self.pool.append(Transfer(self.timing))\\n        item = self.pool[self.count]\\n        self.count += 1\\n        item.layer = self.layer\\n        item.stats[:] = [raw_bytes, payload_bytes, 0]\\n        return item\\n\\n    def transfers(self):\\n        return [item for item in self.pool[:self.count] if item.stats[2] > 0]\\n\\n    def snapshot(self):\\n        items = self.transfers()\\n        raw, payload, wire = (sum(item.stats[i] for item in items)\\n                              for i in range(3))\\n        raw += self.raw_bytes\\n        payload += self.payload_bytes\\n        timing_complete = self.timing and self.complete\\n        elapsed = 0.0\\n        if timing_complete:\\n            for item in items:\\n                begin, end = item.events\\n                if not end.query():\\n                    timing_complete = False\\n                    break\\n                elapsed += begin.elapsed_time(end)\\n        result = dict(\\n            forward=self.forward, batch=self.batch, step=self.step,\\n            config=self.config, phase=self.phase, tokens=self.tokens,\\n            kv_raw_bytes=raw if self.complete else None,\\n            kv_payload_bytes=payload if self.complete else None,\\n            kv_h2d_bytes=wire if self.complete else None,\\n            kv_compression_ratio=(raw / payload if payload and self.complete else None),\\n            kv_transfer_ratio=(raw / wire if wire and self.complete else None),\\n            kvload_ms=elapsed if timing_complete else None,\\n            transfers=len(items), bytes_complete=int(self.complete),\\n            timing_complete=int(timing_complete))\\n        result.update({key: self.cd3.get(key) for key in (*CD3_COUNTERS, *CD3_MODES)})\\n        return result\\n\\n    def finish_forward(self):\\n        if not self.active:\\n            return\\n        self.last = self.snapshot()\\n        if self.file:\\n            self.writer.writerow({key: \\\"NA\\\" if value is None else value\\n                                  for key, value in self.last.items()})\\n        self.active = False\\n        if cd3_cpu_profile.enabled and self.forward % 64 == 0:\\n            cd3_cpu_profile.flush()\\n\\n\\ndef configure(*, timing=False, log_dir=None, capacity=0):\\n    global _collector, _generation\\n    if _collector:\\n        _collector.close()\\n    enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n    if not enabled and not timing:\\n        _collector = None\\n        return None\\n    directory = os.getenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\") or log_dir\\n    _generation += 1\\n    path = (str(Path(directory) / f\\\"kv_metrics.{os.getpid()}.{_generation}.csv\\\")\\n            if enabled and directory else None)\\n    _collector = KVLoadMetrics(timing=timing, path=path, capacity=capacity)\\n    return _collector\\n\\n\\ndef current():\\n    return _collector if _collector is not None and _collector.active else None\\n{'forward': '96', 'batch': '-1', 'step': '-1', 'config': 'serving', 'phase': 'prefill', 'tokens': '754', 'kv_raw_bytes': '922746880', 'kv_payload_bytes': '922746880', 'kv_h2d_bytes': '922746880', 'kv_compression_