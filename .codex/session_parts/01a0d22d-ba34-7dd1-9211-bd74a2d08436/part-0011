ecord[\\\"cd3_csr_garbage_bytes\\\"] / record[\\\"kv_raw_bytes\\\"]\\n            summaries = [json.loads(line) for path in metrics_dir.glob(\\\"cd3_storage.*.jsonl\\\")\\n                         for line in path.read_text().splitlines()]\\n            record[\\\"storage_summaries\\\"] = summaries\\n            if summaries:\\n                record[\\\"native_sha256\\\"] = summaries[-1][\\\"native_sha256\\\"]\\n                record[\\\"gpu_peak_reserved_bytes\\\"] = max(s[\\\"gpu_peak_reserved_bytes\\\"] for s in summaries)\\n                record[\\\"gpu_staging_bytes\\\"] = summaries[-1][\\\"gpu_staging_bytes\\\"]\\n                record[\\\"fixed_host_bytes\\\"] = summaries[-1][\\\"fixed_host_bytes\\\"]\\n            records.append(record)\\n    return records\\n\\n\\ndef rank(records):\\n    metrics = (\\\"tpot_p50_ms\\\", \\\"tpot_p90_ms\\\", \\\"ttft_p90_ms\\\", \\\"duration_s\\\", \\\"slo200_pct\\\")\\n    grouped = {}\\n    for row in records:\\n        if not row.get(\\\"eligible\\\", True):\\n            continue\\n        grouped.setdefault((row[\\\"candidate\\\"], row[\\\"workload\\\"]), []).append(row)\\n    medians = {key: {name: statistics.median(row[name] for row in rows) for name in metrics}\\n               for key, rows in grouped.items()}\\n    result = []\\n    for candidate in sorted({row[\\\"candidate\\\"] for row in records}):\\n        if any((candidate, s) not in medians or (\\\"A\\\", s) not in medians for s in (\\\"S1\\\", \\\"S2\\\")):\\n            continue\\n        ratios, regressions = [], []\\n        for workload in (\\\"S1\\\", \\\"S2\\\"):\\n            values, baseline = medians[candidate, workload], medians[\\\"A\\\", workload]\\n            ratios.append(values[\\\"tpot_p50_ms\\\"] / baseline[\\\"tpot_p50_ms\\\"])\\n            for name, limit in ((\\\"tpot_p50_ms\\\", 1.02), (\\\"tpot_p90_ms\\\", 1.05),\\n                                (\\\"ttft_p90_ms\\\", 1.05), (\\\"duration_s\\\", 1.05)):\\n                if value