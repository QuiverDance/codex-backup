  free_list: Any = None\\n\\n\\n@dataclass\\nclass _DecodePlan:\\n    layer_id: int\\n    block_ids: np.ndarray\\n    block_ids_tensor: torch.Tensor | None\\n    block_ids_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event | None\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n    completion_valid: bool = True\\n    profile_active_entry_bytes: int | None = None\\n    native_plans: list = field(default_factory=list)\\n    side_payload: tuple = (0, 0)\\n    side_alignment: tuple = (0, 0)\\n    side_gap: tuple = (0, 0)\\n    csr_garbage_bytes: int = 0\\n    serial_native: Any = None\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    kv_load_metrics_supported = True\\n    supports_kv_ownership = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        required = (\\n            \\\"decompress_chunk_delta3_batched_csr_pair_stream\\\",\\n            \\\"pack_host_chunk_delta3_entries_csr\\\",\\n            \\\"prepare_chunk_delta3_kv_decode\\\",\\n            \\\"KVSlotAllocator\\\",\\n            \\\"retire_kv_csr_slots\\\",\\n            \\\"prepare_host_chunk_delta3_csr_append\\\",\\n            \\\"append_host_chunk_delta3_csr\\\",\\n        )\\n        if (not _HAS_CHUNK_DELTA3\\n                or any(not hasattr(_cd3_ext, name) for name in required)):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the CSR KV decoder and native slot allocator\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Two-stream event/ring overhead dominates small copies. Decide from\\n        # the bytes actually staged, not the requested-row count: a sparse\\n        # active set can have few rows but a much larger metadata payload.\\n        split_min_bytes = os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\\\")\\n        self._kv_split_min_bytes = (\\n            None if split_min_bytes is None\\n            else max(0, int(split_min_bytes)))\\n        self._decode_ring_idx = 0\\n        self._gpu_decomp_pool_ring = []\\n        self._decode_consumed = []\\n        self._tb = False\\n        self.storage_requested = os.getenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", \\\"hybrid\\\")\\n        self.execution_requested = os.getenv(\\\"TIERED_SERVE_KV_CD3_EXECUTION\\\", \\\"pipeline\\\")\\n        self.csr_policy = os.getenv(\\\"TIERED_SERVE_KV_CD3_CSR_POLICY\\\", \\\"append\\\")\\n        self.cpu_path = os.getenv(\\\"TIERED_SERVE_KV_CD3_CPU_PATH\\\", \\\"optimized\\\")\\n        if self.cpu_path not in (\\\"legacy\\\", \\\"optimized\\\"):\\n            raise ValueError(\\\"CD3 CPU path must be legacy or optimized\\\")\\n        self._csr_cpu_optimized = self.cpu_path == \\\"optimized\\\"\\n        if self.storage_requested not in (\\\"csr\\\", \\\"hybrid\\\"):\\n            raise ValueError(\\\"CD3 KV storage must be csr or hybrid\\\")\\n        if self.execution_requested not in (\\\"serial\\\", \\\"pipeline\\\"):\\n            raise ValueError(\\\"CD3 KV execution must be serial or pipeline\\\")\\n        if self.csr_policy not in (\\\"append\\\", \\\"compact\\\", \\\"reuse\\\"):\\n            raise ValueError(\\\"CD3 CSR policy must be append, compact, or reuse\\\")\\n        full_blocks = os.getenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"0\\\") == \\\"1\\\"\\n        self.storage_backend = self.storage_requested if full_blocks else \\\"csr\\\"\\n        if self.csr_policy != \\\"append\\\" and self.storage_backend != \\\"csr\\\":\\n            raise ValueError(\\\"CD3 CSR garbage policies require CSR storage\\\")\\n        self.storage_fallback_reason = (\\n            \\\"requires_full_block_only\\\" if self.storage_backend != self.storage_requested else \\\"\\\")\\n        if (self.storage_backend == \\\"hybrid\\\" or self.execution_requested == \\\"pipeline\\\"):\\n            if not hasattr(_cd3_ext, \\\"prepare_chunk_delta3_kv_pipeline\\\"):\\n                raise RuntimeError(\\\"CD3 KV hybrid/pipeline requires the updated native extension\\\")\\n        if self.storage_backend == \\\"hybrid\\\" and not hasattr(_cd3_ext, \\\"HybridKVStore\\\"):\\n            raise RuntimeError(\\\"CD3 hybrid storage requires the updated native extension\\\")\\n        self._hybrid_stores = {}\\n        self._hybrid_ownership = {}\\n        self._entry_pool = None\\n        self._entry_arenas = []\\n        self._hybrid_allocator = None\\n        self._wo