rs must have equal length\\\");\\n\\n        const int64_t rows = slots.numel();\\n        const int64_t* ids = slots.data_ptr<int64_t>();\\n        const int64_t* counts = word_counts.data_ptr<int64_t>();\\n        std::vector<int64_t> checked_ids;\\n        std::vector<int64_t> checked_counts;\\n        checked_ids.reserve(rows);\\n        checked_counts.reserve(rows);\\n        for (int64_t row = 0; row < rows; ++row) {\\n            checked_ids.push_back(ids[row]);\\n            checked_counts.push_back(counts[row]);\\n        }\\n        std::vector<int64_t> sorted = checked_ids;\\n        std::sort(sorted.begin(), sorted.end());\\n        TORCH_CHECK(std::adjacent_find(sorted.begin(), sorted.end()) == sorted.end(),\\n                    \\\"duplicate CSR reservation slot\\\");\\n        for (int64_t row = 0; row < rows; ++row) {\\n            TORCH_CHECK(checked_ids[row] >= 0\\n                            && checked_ids[row] < static_cast<int64_t>(offsets_.size()),\\n                        \\\"CSR reservation slot out of range\\\");\\n            TORCH_CHECK(checked_counts[row] >= 0 && checked_counts[row] <= max_words_,\\n                        \\\"CSR reservation word count out of range\\\");\\n        }\\n        if (!usable_) return false;\\n\\n        // An unsuccessful plan is discarded by rebuilding from authoritative\\n        // scratch data. No payload or output offset is written on failure.\\n        usable_ = false;\\n        last_reused_words_ = 0;\\n        last_appended_words_ = 0;\\n        std::vector<int64_t> planned(rows);\\n        release_validated(checked_ids);\\n        for (int64_t row = 0; row < rows; ++row) {\\n            const int64_t slot = checked_ids[row];\\n            const int64_t count = checked_counts[row];\\n            if (count == 0) {\\n                active_[slot] = true;\\n                planned[row] = 0;\\n                continue;\\n            }\\n            const auto fit = holes_by_size_.lower_bound({count, 0}