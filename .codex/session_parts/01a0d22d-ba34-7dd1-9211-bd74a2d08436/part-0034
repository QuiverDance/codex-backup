apacity)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        packed, packed_owner = self._acquire_csr_host_arena(total_words)\\n        offsets, offsets_owner = self._acquire_csr_host_arena(\\n            storage_slots.size)\\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n            pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n            torch.from_numpy(storage_slots), packed, offsets)\\n        return packed, offsets, [packed_owner, offsets_owner]\\n\\n    def _build_decode_plan(\\n            self, layer_id: int,\\n            block_ids: np.ndarray, k_cache, v_cache) -> _DecodePlan:\\n        self._reclaim_csr_plans()\\n        if self.storage_backend == \\\"hybrid\\\":\\n            from tiered_serve.chunk_delta3_kv_plan import prepare_hybrid_plan\\n            return prepare_hybrid_plan(self, layer_id, block_ids)\\n        n = len(block_ids)\\n        hwm = self._kv_slot_allocator[layer_id].high_water\\n        states = self._persistent_csr[layer_id]\\n        if states[\\\"k\\\"] is None or states[\\\"v\\\"] is None:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 persistent CSR is missing for layer={layer_id}\\\")\\n\\n        slots = np.ascontiguousarray(\\n            self._kv_slot_np[layer_id][block_ids], dtype=np.int32)\\n        if bool((slots < 0).any()):\\n            missing = int(block_ids[np.flatnonzero(slots < 0)[0]])\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV has no slot for layer={layer_id} \\\"\\n                f\\\"block={missing}\\\")\\n\\n        block_ids_tensor = torch.from_numpy(\\n            np.ascontiguousarray(block_ids, dtype=np.int64))\\n        block_ids_cpu, block_ids_owner = self._acquire_csr_host_arena(n)\\n        host_owners = [block_ids_owner] if block_ids_owner is not None else []\\n\\n        gpu_entry_capacity = self._gpu_decomp_pool_ring[0][\\\"k\\\"][\\n            \\\"entries20x3\\\"].numel()\\n        repack = any(\\n            states[kv].used_words > gpu_entry_capacity\\n            for kv in (\\\"k\\\", \\\"v\\\"))\\n        if repack:\\n            order = np.argsort(slots, kind=\\\"stable\\\")\\n            storage_slots = np.ascontiguousarray(\\n                slots[order], dtype=np.int64)\\n            packed_k, offsets_k, owners_k = self._pack_csr_entries(\\n                self._host_pools[layer_id][\\\"k\\\"], storage_slots)\\n            packed_v, offsets_v, owners_v = self._pack_csr_entries(\\n                self._host_pools[layer_id][\\\"v\\\"], storage_slots)\\n            host_owners.extend(\\n                owner for owner in owners_k + owners_v\\n                if owner is not None)\\n            host_entries = (packed_k, packed_v)\\n            host_offsets = (offsets_k, offsets_v)\\n        else:\\n            host_entries = (\\n                states[\\\"k\\\"].entries[:states[\\\"k\\\"].used_words],\\n                states[\\\"v\\\"].entries[:states[\\\"v\\\"].used_words],\\n            )\\n            host_offsets = (\\n                states[\\\"k\\\"].offsets,\\n                states[\\\"v\\\"].offsets,\\n            )\\n\\n        host_bodies = (\\n            self._host_pools[layer_id][\\\"k\\\"][\\\"body\\\"],\\n            self._host_pools[layer_id][\\\"v\\\"][\\\"body\\\"],\\n        )\\n        entry_words = (\\n            host_entries[0].numel(), host_entries[1].numel())\\n        staged_bytes = (\\n            n * (2 * self._body_stride + 3 * 8)\\n            + host_entries[0].nbytes + host_entries[1].nbytes)\\n        active_words = tuple(int(states[side].word_counts[slots].sum()) for side in (\\\"k\\\", \\\"v\\\"))\\n        plan = _DecodePlan(\\n            layer_id=layer_id,\\n            block_ids=block_ids,\\n            block_ids_tensor=block_ids_tensor,\\n            block_ids_cpu=block_ids_cpu,\\n            generation=self._decode_generation.get(layer_id, 0),\\n            slots_gpu=self.