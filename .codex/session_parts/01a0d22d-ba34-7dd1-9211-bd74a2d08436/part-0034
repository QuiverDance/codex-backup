               allocator->usable_ = true;\\n            }\\n        }\\n        return {k ? k->used_words_ : 0, k ? k->live_words_ : 0,\\n                v ? v->used_words_ : 0, v ? v->live_words_ : 0};\\n    }\\n\\n    void reset(torch::Tensor offsets, const HostWordCounts& word_counts)\\n    {\\n        check_host_long_vector(offsets, \\\"offsets\\\");\\n        TORCH_CHECK(word_counts.ndim() == 1\\n                        && offsets.numel() == static_cast<int64_t>(offsets_.size())\\n                        && word_counts.size() == offsets.numel(),\\n                    \\\"CSR reset metadata must match slot count\\\");\\n        const int64_t* starts = offsets.data_ptr<int64_t>();\\n        const int64_t* counts = word_counts.data();\\n        std::vector<std::pair<int64_t, int64_t>> ranges;\\n        std::vector<int64_t> new_offsets(offsets_.size(), 0);\\n        std::vector<int64_t> new_reserved(offsets_.size(), 0);\\n        std::vector<int64_t> new_logical(offsets_.size(), 0);\\n        std::vector<bool> new_active(offsets_.size(), false);\\n        for (size_t slot = 0; slot < offsets_.size(); ++slot) {\\n            TORCH_CHECK(starts[slot] >= 0 && starts[slot] <= max_words_\\n                            && counts[slot] >= 0\\n                            && counts[slot] <= max_words_ - starts[slot],\\n                        \\\"CSR reset range out of bounds\\\");\\n            if (counts[slot] == 0) continue;\\n            ranges.emplace_back(starts[slot], counts[slot]);\\n            new_offsets[slot] = starts[slot];\\n            new_reserved[slot] = counts[slot];\\n            new_logical[slot] = counts[slot];\\n            new_active[slot] = true;\\n        }\\n        std::sort(ranges.begin(), ranges.end());\\n        int64_t end = 0;\\n        for (const auto& range : ranges) {\\n            TORCH_CHECK(range.first == end,\\n                        \\\"CSR reset requires compact, nonoverlapping ranges\\\");\\n            end += range.second;\\n        }\\n        offsets_.swap(new_offsets);\\n        reserved_.swap(new_reserved);\\n        logical_.swap(new_logical);\\n        active_.swap(new_active);\\n        holes_.clear();\\n        holes_by_size_.clear();\\n        used_words_ = end;\\n        live_words_ = end;\\n        free_words_ = 0;\\n        last_reused_words_ = 0;\\n        last_appended_words_ = 0;\\n        usable_ = true;\\n    }\\n\\n    py::dict stats() const\\n    {\\n        py::dict out;\\n        out[\\\"used_words\\\"] = used_words_;\\n        out[\\\"live_words\\\"] = live_words_;\\n        out[\\\"free_words\\\"] = free_words_;\\n        out[\\\"slack_words\\\"] = used_words_ - live_words_ - free_words_;\\n        out[\\\"last_reused_words\\\"] = last_reused_words_;\\n        out[\\\"last_appended_words\\\"] = last_appended_words_;\\n        out[\\\"usable\\\"] = usable_;\\n        return out;\\n    }\\n\\n    std::shared_ptr<CSRTransferSnapshot> transfer_snapshot(int64_t min_hole_bytes) const\\n    {\\n        TORCH_CHECK(usable_, \\\"CSR allocator requires reset before transfer planning\\\");\\n        TORCH_CHECK(min_hole_bytes >= 0, \\\"CSR hole threshold must be nonnegative\\\");\\n        auto result = std::make_shared<CSRTransferSnapshot>();\\n        result->used_words = used_words_;\\n        // The size index already orders holes. Visit at most three; never\\n        // rescan live records, copy payload, or modify an in-flight plan.\\n        std::array<std::pair<int64_t, int64_t>, 3> omitted;\\n        size_t count = 0;\\n        for (auto hole = holes_by_size_.rbegin();\\n             hole != holes_by_size_.rend() && count < omitted.size(); ++hole) {\\n            if (hole->first <= min_hole_bytes / sizeof(int64_t)) break;\\n            omitted[count++] = {hole->second, hole->first};\\n        }\\n        std::sort(omitted.begin(), omitted.begin() + count);\\n        result->spans.reserve(count + 1);\\n        int64_t cursor = 0;\\n        for (size_t index = 0; index < count; ++index) {\\n            const auto [start, words] = omitted[index];\\n            if (start > cursor) result->spans.emplace_back(cursor, start - cursor);\\n            if (start > cursor) result->spans.emplace_back(cursor, start - cursor);\\n            cursor = start + words;\\n            result->skipped_words += words;\\n        }\\n        if (cursor < used_words_)\\n            result->spans.emplace_back(cursor, used_words_ - cursor);\\n        return result;\\n    }\\n\\nprivate:\\n    void add_hole(int64_t start, int64_t words)\\n    {\\n        if (words == 0) return;\\n        const auto inserted = holes_.emplace(start, words);\\n        TORCH_INTERNAL_ASSERT(inserted.second);\\n        holes_by_size_.emplace(words, start);\\n        free_words_ += words;\\n    }\\n\\n    void remove_hole(int64_t start)\\n    {\\n        auto hole = holes_.find(start);\\n        TORCH_INTERNAL_ASSERT(hole != holes_.end());\\n        const int64_t words = hole->second;\\n        TORCH_INTERNAL_ASSERT(holes_by_size_.erase({words, start}) == 1);\\n        holes_.erase(hole);\\n        free_words_ -= words;\\n    }\\n\\n    const std::vector<int64_t>& validate_release(\\n        const HostWordCounts& slots, const CSRFreeList* other = nullptr)\\n    {\\n        TORCH_CHECK(slots.ndim() == 1, \\\"CSR release slots must be an int64 vector\\\");\\n        TORCH_CHECK(usable_ && (!other || other->usable_),\\n                    \\\"CSR allocator requires reset after failed reserve\\\");\\n        const size_t limit = other ? std::min(offsets_.size(), other->offsets_.size())\\n                                   : offsets_.size();\\n        release_ids_.clear();\\n        release_ids_.reserve(slots.size());\\n        for (py::ssize_t row = 0; row < slots.size(); ++row) {\\n            const int64_t slot = slots.data()[row];\\n            TORCH_CHECK(slot >= 0 && static_cast<size_t>(slot) < limit,\\n                        \\\"CSR release slot out of range\\\");\\n            release_ids_.push_back(slot);\\n        }\\n        if (!std::is_sorted(release_ids_.begin(), release_ids_.end()))\\n            std::sort(release_ids_.begin(), release_ids_.end());\\n        TORCH_CHECK(std::adjacent_find(release_ids_.begin(), release_ids_.end())\\n                        == release_ids_.end(), \\\"duplicate CSR release slot\\\");\\n        return release_ids_;\\n    }\\n\\n    void release_validated(const std::vector<int64_t>& slots)\\n    {\\n        released_ranges_.clear();\\n        released_ranges_.reserve(slots.size());\\n        for (int64_t slot : slots) {\\n            if (!active_[slot]) continue;\\n            if (reserved_[slot])\\n                released_ranges_.emplace_back(offsets_[slot], reserved_[slot]);\\n            live_words_ -= logical_[slot];\\n            offsets_[slot] = reserved_[slot] = logical_[slot] = 0;\\n            active_[slot] = false;\\n        }\\n        if (!std::is_sorted(released_ranges_.begin(), released_ranges_.end()))\\n            std::sort(released_ranges_.begin(), released_ranges_.end());\\n        // Merge this batch before touching either hole index. Returning a\\n        // contiguous request range creates one hole, not one node per slot.\\n        size_t index = 0;\\n        while (index < released_ranges_.size()) {\\n            const int64_t start = released_ranges_[index].first;\\n            int64_t end = start + released_ranges_[index++].second;\\n            while (index < released_ranges_.size()\\n                   && released_ranges_[index].first == end)\\n                end += released_ranges_[index++].second;\\n            release_range(start, end - start);\\n        }\\n    }\\n\\n    void release_range(int64_t start, int64_t words)\\n    {\\n        int64_t merged_start = start;\\n        int64_t merged_end = start + words;\\n        auto next = holes_.lower_bound(start);\\n        if (next != holes_.begin()) {\\n            auto previous = std::prev(next);\\n            if (previous->first + previous->second == start) {\\n                merged_start = previous->first;\\n                remove_hole(merged_start);\\n            }\\n        }\\n        next = holes_.lower_bound(start);\\n        if (next != holes_.end() && next->first == merged_end) {\\n            merged_end += next->second;\\n            remove_hole(next->first);\\n        }\\n        if (merged_end == used_words_) {\\n            used_words_ = merged_start;\\n            return;\\n        }\\n        add_hole(merged_start, merged_end - merged_start);\\n    }\\n\\n    int64_t max_words_;\\n    std::vector<int64_t> offsets_;\\n    std::vector<int64_t> reserved_;\\n    std::vector<int64_t> logical_;\\n    std::vector<bool> active_;\\n    std::vector<int64_t> release_ids_;\\n    std::vector<std::pair<int64_t, int64_t>> released_ranges_;\\n    std::map<int64_t, int64_t> holes_;\\n    std::set<std::pair<int64_t, int64_t>> holes_by_size_;\\n    int64_t used_words_ = 0;\\n    int64_t live_words_ = 0;\\n    int64_t free_words_ = 0;\\n    int64_t last_reused_words_ = 0;\\n    int64_t last_appended_words_ = 0;\\n    bool usable_ = true;\\n};\\n\\nvoid write_host_chunk_delta3_csr(\\n    torch::Tensor entries20x3, torch::Tensor slots,\\n    torch::Tensor word_counts, torch::Tensor destinations,\\n    torch::Tensor destination_entries, torch::Tensor destination_offsets,\\n    HostWordCounts destination_word_counts)\\n{\\n    TORCH_CHECK(entries20x3.device().is_cpu()\\n                    && entries20x3.dim() == 2\\n                    && entries20x3.scalar_type() == at::kLong\\n                    && entries20x3.stride(1) == 1\\n                    && entries20x3.stride(0) >= entries20x3.size(1),\\n                \\\"entries20x3 must be a row-major CPU int64 matrix\\\");\\n    check_host_long_vector(slots, \\\"slots\\\");\\n    check_host_long_vector(word_counts, \\\"word_counts\\\");\\n    check_host_long_vector(destinations, \\\"destinations\\\");\\n    check_host_long_vector(destination_entries, \\\"destination_entries\\\");\\n    check_host_long_vector(destination_offsets, \\\"destination_offsets\\\");\\n    TORCH_CHECK(slots.numel() == word_counts.numel()\\n                    && slots.numel() == destinations.numel(),\\n                \\\"CSR write vectors must have equal length\\\");\\n    TORCH_CHECK(destination_word_counts.ndim() == 1\\n                    && destination_word_counts.writeable()\\n                    && destination_word_counts.size() == entries20x3.size(0)\\n                    && destination_offsets.numel() == entries20x3.size(0),\\n                \\\"CSR destination metadata must match source rows and be writable\\\");\\n\\n    const int64_t rows = slots.numel();\\n    const int64_t* ids = slots.data_ptr<int64_t>();\\n    const int64_t* words = word_counts.data_ptr<int64_t>();\\n    const int64_t* starts = destinations.data_ptr<int64_t>();\\n    std::vector<int64_t> sorted_ids;\\n    sorted_ids.reserve(rows);\\n    for (int64_t row = 0; row < rows; ++row) sorted_ids.push_back(ids[row]);\\n    std::sort(sorted_ids.begin(), sorted_ids.end());\\n    TORCH_CHECK(std::adjacent_find(sorted_ids.begin(), sorted_ids.end())\\n                    == sorted_ids.end(), \\\"duplicate CSR write slot\\\");\\n    std::vector<std::pair<int64_t, int64_t>> ranges;\\n    ranges.reserve(rows);\\n    for (int64_t row = 0; row < rows; ++row) {\\n        TORCH_CHECK(ids[row] >= 0 && ids[row] < entries20x3.size(0),\\n                    \\\"CSR write slot out of range\\\");\\n        TORCH_CHECK(words[row] >= 0 && words[row] <= entries20x3.size(1)\\n                        && starts[row] >= 0\\n                        && starts[row] <= destination_entries.numel()\\n                        && words[row] <= destination_entries.numel() - starts[row],\\n                    \\\"CSR write range out of bounds\\\");\\n        if (words[row] != 0) ranges.emplace_back(starts[row], words[row]);\\n    }\\n    std::sort(ranges.begin(), ranges.end());\\n    for (size_t row = 1; row < ranges.size(); ++row) {\\n        TORCH_CHECK(ranges[row - 1].first + ranges[row - 1].second\\n                        <= ranges[row].first, \\\"overlapping CSR write ranges\\\");\\n    }\\n\\n    const int64_t* source = entries20x3.data_ptr<int64_t>();\\n    int64_t* destination = destination_entries.data_ptr<int64_t>();\\n    int64_t* published_offsets = destination_offsets.data_ptr<int64_t>();\\n    int64_t* published_words = destination_word_counts.mutable_data();\\n    const int64_t stride = entries20x3.stride(0);\\n    py::gil_scoped_release no_gil;\\n#pragma omp parallel for schedule(static) if(rows >= 64)\\n    for (int64_t row = 0; row < rows; ++row) {\\n        if (words[row] != 0) {\\n            std::memcpy(destination + starts[row], source + ids[row] * stride,\\n                        static_cast<size_t>(words[row]) * sizeof(int64_t));\\n        }\\n    }\\n    for (int64_t row = 0; row < rows; ++row) {\\n        published_offsets[ids[row]] = starts[row];\\n        published_words[ids[row]] = words[row];\\n    }\\n}\\n\"}"},{"type":"input_text","text":"{\"i\":3,\"output\":\"\\\"\\\"\\\"CPU behavior of the native ChunkDelta3 CSR free-range allocator.\\\"\\\"\\\"\\n\\nimport numpy as np\\nimport pytest\\nimport torch\\n\\n\\ndef _extension():\\n    from tiered_serve.cpp_exts import chunk_delta3_ext\\n    return chunk_delta3_ext\\n\\n\\ndef _reserve(allocator, slots, counts):\\n    slots = torch.tensor(slots, dtype=torch.int64)\\n    counts = torch.tensor(counts, dtype=torch.int64)\\n    destinations = torch.full_like(slots, -1)\\n    ok = allocator.reserve(slots, counts, destinations)\\n    return ok, destinations.tolist()\\n\\n\\ndef test_reuse_coalesce_internal_slack_and_tail_trim():\\n    allocator = _extension().CSRFreeList(5, 20)\\n    assert _reserve(allocator, [0, 1, 2], [3, 4, 5]) == (True, [0, 3, 7])\\n    allocator.release(np.array([1], dtype=np.int64))\\n    assert allocator.stats()[\\\"free_words\\\"] == 4\\n\\n    assert _reserve(allocator, [3], [3]) == (True, [3])\\n    assert allocator.stats() == {\\n        \\\"used_words\\\": 12, \\\"live_words\\\": 11, \\\"free_words\\\": 0,\\n        \\\"slack_words\\\": 1, \\\"last_reused_words\\\": 3,\\n        \\\"last_appended_words\\\": 0, \\\"usable\\\": True,\\n    }\\n    allocator.release(np.array([0, 3], dtype=np.int64))\\n    assert allocator.stats()[\\\"free_words\\\"] == 7\\n    allocator.release(np.array([2], dtype=np.int64))\\n    assert allocator.stats()[\\\"used_words\\\"] == 0\\n    assert allocator.stats()[\\\"free_words\\\"] == 0\\n\\n\\ndef test_best_fit_and_overwrite_reuses_released_range():\\n    allocator = _extension().CSRFreeList(7, 30)\\n    assert _reserve(allocator, [0, 1, 2, 3, 5], [4, 4, 2, 7, 1]) == (\\n        True, [0, 4, 8, 10, 17])\\n    allocator.release(np.array([0, 3], dtype=np.int64))\\n    # Both holes are interior; three words select the smaller four-word hole.\\n    assert _reserve(allocator, [4], [3]) == (True, [0])\\n    assert allocator.stats()[\\\"last_reused_words\\\"] == 3\\n    assert _reserve(allocator, [1], [2]) == (True, [4])\\n    assert allocator.stats()[\\\"slack_words\\\"] == 3\\n\\n\\ndef test_fragmentation_failure_invalidates_plan_and_reset_restores_compact_state():\\n    allocator = _extension().CSRFreeList(4, 10)\\n    assert _reserve(allocator, [0, 1, 2], [4, 4, 2])[0]\\n    allocator.release(np.array([0], dtype=np.int64))\\n    ok, destinations = _reserve(allocator, [3], [5])\\n    assert not ok\\n    assert destinations == [-1]\\n    assert allocator.stats()[\\\"usable\\\"] is False\\n    with pytest.raises(RuntimeError, match=\\\"compact\\\"):\\n        allocator.reset(torch.tensor([0, 4, 8, 0]),\\n                        np.array([0, 4, 2, 0], dtype=np.int64))\\n    allocator.reset(torch.tensor([0, 0, 4, 0]),\\n                    np.array([0, 4, 2, 0], dtype=np.int64))\\n    assert allocator.stats()[\\\"used_words\\\"] == 6\\n    assert _reserve(allocator, [3], [4]) == (True, [6])\\n\\n\\ndef test_transfer_snapshot_omits_only_three_profitable_holes_and_is_immutable():\\n    allocator = _extension().CSRFreeList(9, 256)\\n    assert _reserve(allocator, list(range(9)), [10, 20, 10, 40, 10, 30, 10, 50, 10])[0]\\n    allocator.release(np.array([1, 3, 5, 7], dtype=np.int64))\\n    snapshot = allocator.transfer_snapshot(0)\\n    assert snapshot.used_words == 190\\n    assert snapshot.skipped_words == 120\\n    assert snapshot.spans == [(0, 40), (80, 10), (120, 10), (180, 10)]\\n    assert allocator.transfer_snapshot(30 * 8).spans == [(0, 40), (80, 50), (180, 10)]\\n    assert allocator.transfer_snapshot(50 * 8).spans == [(0, 190)]\\n    # A retained plan's descriptor sources cannot change when holes are reused.\\n    assert _reserve(allocator, [7], [45]) == (True, [130])\\n    assert snapshot.spans == [(0, 40), (80, 10), (120, 10), (180, 10)]\\n    assert allocator.transfer_snapshot(0).skipped_words == 90\\n    with pytest.raises(RuntimeError, match=\\\"nonnegative\\\"):\\n        allocator.transfer_snapshot(-1)\\n    allocator.release(np.arange(9, dtype=np.int64))\\n    assert allocator.transfer_snapshot(0).spans == []\\n\\n\\ndef test_batch_release_coalesces_new_ranges_through_existing_holes():\\n    allocator = _extension().CSRFreeList(8, 64)\\n    assert _reserve(allocator, list(range(8)), [8] * 8)[0]\\n    allocator.release(np.array([1, 3, 5], dtype=np.int64))\\n    allocator.release(np.array([4, 0, 2], dtype=np.int64))\\n    assert allocator.transfer_snapshot(0).spans == [(48, 16)]\\n    assert _reserve(allocator, [0], [40]) == (True, [0])\\n    allocator.release(np.array([7, 6], dtype=np.int64))\\n    assert allocator.stats()[\\\"used_words\\\"] == 40\\n    assert allocator.stats()[\\\"live_words\\\"] == 40\\n    assert allocator.stats()[\\\"free_words\\\"] == 0\\n\\n\\ndef test_pair_release_validates_both_sides_before_mutating_either():\\n    extension = _extension()\\n    k, v = extension.CSRFreeList(6, 64), extension.CSRFreeList(4, 64)\\n    assert _reserve(k, list(range(6)), [8] * 6)[0]\\n    assert _reserve(v, list(range(4)), [16] * 4)[0]\\n    before = (k.stats(), v.stats())\\n    for ids in ([4], [-1], [1, 1]):\\n        with pytest.raises(RuntimeError, match=\\\"out of range|duplicate\\\"):\\n            extension.release_kv_csr_slots(np.asarray(ids, dtype=np.int64), k, v)\\n        assert (k.stats(), v.stats()) == before\\n    assert extension.release_kv_csr_slots(np.array([3, 1], dtype=np.int64), k, v) == [48, 32, 48, 32]\\n    assert extension.release_kv_csr_slots(np.array([0], dtype=np.int64), None, v) == [0, 0, 48, 16]\\n    assert v.transfer_snapshot(0).spans == [(32, 16)]\\n\\n\\ndef test_scatter_copy_publishes_only_valid_arbitrary_ranges():\\n    extension = _extension()\\n    entries = torch.arange(5 * 6, dtype=torch.int64).reshape(5, 6)\\n    slots = torch.tensor([3, 1], dtype=torch.int64)\\n    counts = torch.tensor([3, 2], dtype=torch.int64)\\n    destinations = torch.tensor([8, 1], dtype=torch.int64)\\n    payload = torch.full((14,), -1, dtype=torch.int64)\\n    offsets = torch.full((5,), -1, dtype=torch.int64)\\n    published_counts = np.zeros(5, dtype=np.int64)\\n    extension.write_host_chunk_delta3_csr(\\n        entries, slots, counts, destinations, payload, offsets,\\n        published_counts)\\n    assert payload[8:11].tolist() == entries[3, :3].tolist()\\n    assert payload[1:3].tolist() == entries[1, :2].tolist()\\n    assert offsets.tolist() == [-1, 1, -1, 8, -1]\\n    assert published_counts.tolist() == [0, 2, 0, 3, 0]\\n\\n    before = payload.clone()\\n    with pytest.raises(RuntimeError, match=\\\"overlapping\\\"):\\n        extension.write_host_chunk_delta3_csr(\\n            entries, slots, counts, torch.tensor([2, 3]), payload,\\n            offsets, published_counts)\\n    assert torch.equal(payload, before)\\n\\\"\\\"\\\"CPU-only lifecycle tests for CD3 persistent-KV batch retirement.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport ast\\nfrom itertools import count\\nfrom pathlib import Path\\nfrom types import MethodType, SimpleNamespace\\nimport threading\\n\\nimport numpy as np\\nimport pytest\\n\\n\\nREPO_ROOT = Path(__file__).resolve().parents[1]\\nCD3_SOURCE = REPO_ROOT / \\\"tiered_serve\\\" / \\\"chunk_delta3_kv_compressor.py\\\"\\n\\n\\nclass ArrayTensor:\\n    def __init__(self, values):\\n        self.values = np.asarray(values, dtype=np.int32)\\n\\n    def numpy(self):\\n        return self.values\\n\\n\\ndef _fail_clock():\\n    raise AssertionError(\\\"canonical retirement must not read the clock\\\")\\n\\n\\ndef _policy_class(clock=_fail_clock):\\n    from tiered_serve import cd3_cpu_profile\\n    from tiered_serve.cpp_exts import chunk_delta3_ext\\n\\n    tree = ast.parse(CD3_SOURCE.read_text())\\n    storage = next(\\n        node for node in tree.body\\n        if isinstance(node, ast.ClassDef)\\n        and node.name == \\\"_ChunkDelta3KVStorage\\\"\\n    )\\n    compressor = next(\\n        node for node in tree.body\\n        if isinstance(node, ast.ClassDef)\\n        and node.name == \\\"ChunkDelta3KVCompressor\\\"\\n    )\\n    method_names = {\\n        \\\"_discard_persistent_csr_slots\\\",\\n        \\\"_release_physical_slots\\\",\\n        \\\"_reclaim_validated_slots\\\",\\n        \\\"_assign_kv_slots\\\",\\n        \\\"_prepare_layer_retirement\\\",\\n        \\\"_apply_layer_retirement\\\",\\n        \\\"_invalidate_decode_plan\\\",\\n        \\\"_retire_layer_decode_plans\\\",\\n        \\\"_retire_decode_plan\\\",\\n        \\\"_retire_layer_blocks\\\",\\n        \\\"free_persistent_blocks\\\",\\n        \\\"free_persistent_blocks_profiled\\\",\\n        \\\"free_persistent_block\\\",\\n        \\\"_release_deferred_slots\\\",\\n        \\\"wait_compress_async\\\",\\n    }\\n    methods = [\\n        node\\n        for owner in (storage, compressor)\\n        for node in owner.body\\n        if isinstance(node, ast.FunctionDef) and node.name in method_names\\n    ]\\n    policy = ast.ClassDef(\\n        name=\\\"Policy\\\",\\n        bases=[],\\n        keywords=[],\\n        body=methods,\\n        decorator_list=[],\\n    )\\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\\n    namespace = {\\\"np\\\": np, \\\"_cd3_ext\\\": chunk_delta3_ext,\\n                 \\\"cd3_cpu_profile\\\": cd3_cpu_profile,\\n                 \\\"_time\\\": SimpleNamespace(perf_counter_ns=clock)}\\n    exec(compile(module, str(CD3_SOURCE), \\\"exec\\\"), namespace)\\n    return namespace[\\\"Policy\\\"]\\n\\n\\ndef _state(clock=_fail_clock):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext\\n\\n    policy = _policy_class(clock)()\\n    policy.storage_backend = \\\"csr\\\"\\n    policy._storage_metrics_enabled = False\\n    policy._decode_extra_plans = {}\\n    policy._decode_chunks = {}\\n    policy._n_layers = 2\\n    policy._slot_state_lock = threading.RLock()\\n    policy._deferred_slot_frees = {}\\n    policy._pending_compress = {}\\n    policy._persistent_valid = {\\n        0: bytearray([1, 1, 1, 1, 1, 0]),\\n        1: bytearray([1, 1, 1, 0, 1, 0]),\\n    }\\n    policy._kv_slot_np = {\\n        0: np.asarray([0, 1, 2, 3, 4, -1], dtype=np.int32),\\n        1: np.asarray([0, 2, 4, -1, 5, -1], dtype=np.int32),\\n    }\\n    policy._kv_slot_block = {\\n        0: np.asarray([0, 1, 2, 3, 4, -1], dtype=np.int32),\\n        1: np.asarray([0, -1, 1, -1, 2, 4], dtype=np.int32),\\n    }\\n    policy._kv_slot_allocator = {\\n        layer: chunk_delta3_ext.KVSlotAllocator(6) for layer in range(2)\\n    }\\n    policy._kv_slot_allocator[0].allocate(5)\\n    policy._kv_slot_allocator[1].allocate(6)\\n    policy._kv_slot_allocator[1].release(np.asarray([1, 3], dtype=np.int64))\\n    policy._host_pools = {}\\n    policy._persistent_csr = {}\\n    for layer in range(2):\\n        policy._host_pools[layer] = {}\\n        policy._persistent_csr[layer] = {}\\n        for side, bias in ((\\\"k\\\", 0), (\\\"v\\\", 10)):\\n            policy._host_pools[layer][side] = {\\n                \\\"num_exceptions\\\": ArrayTensor(\\n                    np.arange(6, dtype=np.int32) + bias + 1)\\n            }\\n            policy._persistent_csr[layer][side] = SimpleNamespace(\\n                word_counts=np.arange(6, dtype=np.int64) + bias + 1,\\n                garbage_words=100 + bias,\\n                used_words=999 + bias,\\n                entries=object(),\\n                offsets=object(),\\n            )\\n    policy._persistent_valid_np = {\\n        layer: np.frombuffer(valid, dtype=np.uint8)\\n        for layer, valid in policy._persistent_valid.items()\\n    }\\n    policy._host_num_exceptions_np = {\\n        layer: {side: pools[side][\\\"num_exceptions\\\"].numpy()\\n                for side in (\\\"k\\\", \\\"v\\\")}\\n        for layer, pools in policy._host_pools.items()\\n    }\\n    policy.invalidated_layers = []\\n\\n    def invalidate(self, layer_id):\\n        self.invalidated_layers.append(layer_id)\\n\\n    policy._invalidate_decode_plan = MethodType(invalidate, policy)\\n    return policy\\n\\n\\ndef _occupied_slots(allocator):\\n    occupied = set()\\n    for slot in range(allocator.capacity):\\n        try:\\n            allocator.validate_occupied(np.asarray([slot], dtype=np.int64))\\n        except RuntimeError:\\n            continue\\n        occupied.add(slot)\\n    assert len(occupied) == allocator.occupied_count\\n    return occupied\\n\\n\\ndef test_batch_retirement_updates_each_layer_once_and_preserves_csr_payload():\\n    policy = _state()\\n    csr_payloads = {\\n        (layer, side): (\\n            policy._persistent_csr[layer][side].entries,\\n         