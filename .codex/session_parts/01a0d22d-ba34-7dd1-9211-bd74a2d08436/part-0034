     self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Validate standalone/deferred releases before reclaiming storage.\\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        slots = np.unique(np.asarray(slots, dtype=np.int64))\\n        if slots.size == 0:\\n            return\\n        self._kv_slot_allocator[layer_id].validate_occupied(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_validate_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n        self._reclaim_validated_slots(layer_id, slots, _profile=_profile)\\n\\n    def _reclaim_validated_slots(\\n            self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Reclaim slots after validation under the slot-state lock.\\n\\n        The native occupied bitmap is the authority for both minimum-free\\n        allocation and exact high-water. Quarantined slots remain occupied\\n        until their writer has stopped and this method can clear their bits.\\n        \\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        if getattr(self, \\\"storage_backend\\\", \\\"csr\\\") == \\\"hybrid\\\":\\n            for side in (\\\"k\\\", \\\"v\\\"):\\n                self._host_num_exceptions_np[layer_id][side][slots] = 0\\n        else:\\n            self._discard_persistent_csr_slots(layer_id, slots)\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_csr_ns\\\"] += now_ns - started_ns\\n            started_ns = now_ns\\n        self._kv_slot_allocator[layer_id].release(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_allocator_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n            _profile[\\\"cd3_released_slots\\\"] += int(slots.size)\\n\\n    def decompress_batch(self, layer_id: int,