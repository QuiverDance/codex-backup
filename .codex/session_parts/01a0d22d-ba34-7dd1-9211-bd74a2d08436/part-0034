    affinity = set(usable[begin:end])\\n            if not affinity:\\n                affinity = {allowed[index % len(allowed)]}\\n            try:\\n                os.sched_setaffinity(0, affinity)\\n            except OSError as error:\\n                logger.warning(\\n                    \\\"CD3 compress worker %d affinity failed: %s\\\",\\n                    index, error)\\n        else:\\n            affinity = set(allowed)\\n        omp_threads = min(len(affinity), self._omp_thread_cap)\\n        if self._omp_lib is not None:\\n            self._omp_lib.omp_set_num_threads(int(omp_threads))\\n        ordered = tuple(sorted(affinity))\\n        with self._pin_lock:\\n            self._worker_affinities[index] = ordered\\n            self._worker_omp_threads[index] = omp_threads\\n        logger.info(\\n            \\\"CD3 compress worker %d -> %d CPUs (%d-%d), OMP=%d\\\",\\n            index, len(ordered), ordered[0], ordered[-1], omp_threads)\\n\\n    def compress_batch_async(self, layer_id: int, block_ids: list,\\n                             gpu_k: torch.Tensor,\\n                             gpu_v: torch.Tensor) -> None:\\n        raise NotImplementedError(\\n            \\\"ChunkDelta3 uses CPU encoding after the raw KV swap\\\")\\n\\n    def _assign_kv_slots(self, layer_id: int,\\n                         block_ids: np.ndarray) -> np.ndarray:\\n        bid_arr = np.asarray(block_ids, dtype=np.int64)\\n        slot_table = self._kv_slot_np[layer_id]\\n        previous = slot_table[bid_arr]\\n        new_mask = previous < 0\\n        if not bool(new_mask.any()):\\n            return np.ascontiguousarray(previous, dtype=np.int64)\\n\\n        new_block_ids = bid_arr[new_mask]\\n        # The native hierarchy chooses the same lowest available slots as the\\n        # old min-heap, without lazy entries or per-slot Python allocation work.\\n        new_slots = self._kv_slot_allocator[layer_id].allocate(\\n            int(new_block_ids.size))\\n        slot