    self._free_csr_h2d_events = []\\n        self._retired_csr_plans = []\\n        self._secondary_fallback_possible = {}\\n        # The loader computes one canonical active KV set per forward and then\\n        # passes the same Python list to every layer.  Compare that set once at\\n        # the step boundary instead of running np.array_equal in every layer's\\n        # decompress_batch call.  The held list reference makes the identity\\n        # check generation-safe (CPython cannot recycle its id while held).\\n        self._prepared_active_list = None\\n        self._prepared_active_candidates = None\\n        self._prepared_active_version = 0\\n        self._storage_metrics_enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n\\n    @staticmethod\\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\\n\\n        result = compressed_block_bytes(\\\"chunk_delta3\\\", block_elements)\\n        assert result is not None\\n        return result\\n\\n    def _build_body_layout(self) -> None:\\n        layout = {}\\n        self._gpu_staging_bytes += self._identity_slots_gpu.nbytes\\n        with open(_cd3_ext.__file__, \\\"rb\\\") as native_binary:\\n            self._native_build_sha256 = hashlib.file_digest(native_binary, \\\"sha256\\\").hexdigest()\\n        logger.info(\\\"CD3 fixed buffers host_bytes=%d gpu_staging_bytes=%d native_sha256=%s\\\",\\n                    self._fixed_host_bytes, self._gpu_staging_bytes, self._native_build_sha256)\\n        self._pipeline_k_done = [torch.cuda.Event() for _ in range(2)]\\n        self._pipeline_v_done = [torch.cuda.Event() for _ in range(2)]\\n        # Materialize handles outside native submission; event recording is\\n        # otherwise unnecessary until the first producer uses them.\\n        for event in (*self._pipeline_k_done, *self._pipeline_v_done):\\n            event.record(self.batch_decomp_stream)\\n        logger.info(\\\"CD3 KV storage requested=%s effective=%s fallback=%s execution=%s\\\",\\n                    self.storage_requested, self.storage_backend,\\n                    self.storage_fallback_reason or \\\"none\\\", self.execution_requested)\\n        if self.storage_backend == \\\"csr\\\":\\n            logger.info(\\\"CD3 CSR garbage policy=%s CPU path=%s\\\", self.csr_policy, self.cpu_path)\\n\\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\\n        logger.info(\\n            \\\"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \\\"\\n            \\\"delta_bits=%d decode_threads=%d \\\"\\n            \\\"entry_capacity=%d body=%d host_slot=%d bytes \\\"\\n            \\\"(%.3fx raw worst-case allocation) \\\"\\n            \\\"max_blocks=%d layers=%d\\\",\\n            block_shape, M_b, K_b, delta_bits,\\n            _cd3_ext.compiled_kv_decode_threads(), entry_capacity, self._body_stride,\\n            slot_bytes,\\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\\n\\n    def _init_hybrid_storage(self, host_n, n_layers, huge_page_allocator):\\n        from tiered_serve.kv_codec_spec import chunk_delta3_hybrid_memory_budget\\n        self._hybrid_allocator = huge_page_allocator\\n        self._hybrid_planner_bytes = n_layers * _cd3_ext.hybrid_planner_budget(\\n            host_n, min(self._max_gpu_decomp_blocks, host_n))\\n        budget = chunk_delta3_hybrid_memory_budget(\\n            self._block_numel, host_n - 1, n_layers, self._n_workers,\\n            self._encode_chunk_blocks, planner_bytes=self._hybrid_planner_bytes)\\n        available = budget.entry_budget_bytes\\n        minimum_segment = 1 << (self._packed_capacity * 8 - 1).bit_length()\\n        segment_bytes = max(64 * 1024, minimum_segment)\\n        while segment_bytes > minimum_segment and available < segment_bytes * 8:\\n            segment_bytes //= 2\\n        pool_bytes = available // segment_bytes * segment_bytes\\n        metadata_bytes = _cd3_ext.hybrid_entry_pool_metadata_budget(pool_bytes, segment_bytes)\\n        pool_bytes = (available - metadata_bytes) // segment_bytes * segment_bytes\\n        if pool_bytes < 2 * segment_bytes:\\n            raise ValueError(\\\"CD3 hybrid host budget cannot hold the K/V entries segments\\\")\\n        self._hybrid_planner_bytes += metadata_bytes\\n        self._hybrid_scratch_bytes = budget.scratch_bytes\\n        self._encode_chunk_blocks = budget.scratch_rows_per_worker\\n        self._host_pools = {\\n            layer: {side: self._host_pool(host_n, huge_page_allocator, body_only=True)\\n                    for side in (\\\"k\\\", \\\"v\\\")} for layer in range(n_layers)}\\n        self._hybrid_scratch_queue = queue.LifoQueue()\\n        for _ in range(budget.scratch_workers):\\n            scratch = {side: {\\n                \\\"entries20x3\\\": torch.empty((self._encode_chunk_blocks, self._packed_capacity),\\n                                          dtype=torch.int64),\\n                \\\"num_exceptions\\\": torch.empty(self._encode_chunk_blocks, dtype=torch.int32),\\n            } for side in (\\\"k\\\", \\\"v\\\")}\\n            self._worker_encode_scratch.append(scratch)\\n            self._hybrid_scratch_queue.put(scratch)\\n        # Reserve backing arenas once. Runtime segment checkout is native\\n        # free-list/bump allocation and never invokes the hugepage allocator.\\n        arena_bytes = max(segment_bytes, (pool_bytes // (2 * n_layers)\\n                                          // segment_bytes) * segment_bytes)\\n        remaining = pool_bytes\\n        while remaining:\\n            size = min(arena_bytes, remaining)\\n            self._entry_arenas.append(self._alloc_host_tensor(\\n                (size,), torch.uint8, huge_page_allocator))\\n            remaining -= size\\n        self._entry_pool = _cd3_ext.HybridEntryPool(self._entry_arenas, segment_bytes)\\n        self._hybrid_ownership = {layer: {} for layer in range(n_layers)}\\n        logger.info(\\\"CD3 hybrid host budget=%d body=%d entries=%d scratch=%d counts=%d planner=%d segment=%d\\\",\\n                    budget.total_bytes, budget.body_bytes, pool_bytes, budget.scratch_bytes,\\n                    budget.count_bytes, self._hybrid_planner_bytes, segment_bytes)\\n\\n    def _csr_host_tensor(self, length, *, zero=False):\\n        factory = torch.zeros if zero else torch.empty\\n        if self._csr_cpu_optimized:\\n            return factory(length, dtype=torch.int64, pin_memory=True)\\n        return factory(length, dtype=torch.int64).pin_memory()\\n\\n    def _csr_clone_offsets(self, offsets):\\n        if not self._csr_cpu_optimized:\\n            return offsets.clone().pin_memory()\\n        result = self._csr_host_tensor(offsets.numel())\\n        result.copy_(offsets)\\n        return result\\n\\n    def _new_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Lazily allocate stable pinned CSR storage for one layer/side.\\\"\\\"\\\"\\n        host_rows = self._max_n_blocks + 1\\n        max_words = host_rows * self._packed_capacity\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        initial_words = min(\\n            max_words,\\n            max(1024, host_rows * self._csr_initial_words_per_slot),\\n        )\\n        state = _PersistentCSRState(\\n            entries=self._csr_host_tensor(initial_words),\\n            offsets=self._csr_host_tensor(host_rows, zero=True),\\n            word_counts=np.zeros(host_rows, dtype=np.int64),\\n            used_words=0,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        if self.csr_policy == \\\"reuse\\\":\\n            state.free_ranges = _cd3_ext.CSRFreeRanges()\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    @cd3_cpu_profile.timed(\\\"csr.rebuild\\\")\\n    def _rebuild_persistent_csr(\\n            self, layer_id: int, kv: str, *, updated_slots=None,\\n            updated_word_counts=None):\\n        \\\"\\\"\\\"Publish compact storage while earlier readers retain old tensors.\\n\\n        The caller has exclusive access to the layer's encoder scratch. The\\n        new used length, rather than returning pinned capacity to the OS,\\n        removes garbage from subsequent contiguous H2D transfers.\\n        \\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n        rows = self._kv_slot_allocator[layer_id].high_water\\n        slots = np.arange(rows, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[:rows]\\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        if total_words > max_words:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 persistent CSR exceeds host slot capacity: \\\"\\n                f\\\"layer={layer_id} side={kv} words={total_words} \\\"\\n                f\\\"capacity={max_words}\\\")\\n        previous = self._persistent_csr[layer_id][kv]\\n        previous_capacity = (\\n            previous.entries.numel() if previous is not None else 0)\\n        capacity = max(\\n            1024, total_words,\\n            min(max_words, previous_capacity),\\n        )\\n        entries = self._csr_host_tensor(capacity)\\n        offsets = self._csr_host_tensor(self._max_n_blocks + 1, zero=True)\\n        published_counts = np.zeros(self._max_n_blocks + 1, dtype=np.int64)\\n        if self._csr_cpu_optimized and previous is not None:\\n            if updated_slots is None:\\n                updated_slots = torch.empty(0, dtype=torch.int64)\\n     