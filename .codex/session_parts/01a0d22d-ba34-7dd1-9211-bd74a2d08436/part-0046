\"\\\"\\n    if elements <= 0 or elements % 4096:\\n        raise ValueError(\\n            \\\"ChunkDelta3 KV block size must be a positive multiple of 4096\\\")\\n    tiles = elements // 4096\\n    body_end = (elements * chunk_delta3_kv_delta_bits() // 8 + elements\\n                + tiles * (256 // chunk_delta3_base_rows()))\\n    return _align_up(body_end, 4) + (tiles + 1) * 4\\n\\n\\ndef chunk_delta3_body_stride(elements: int) -> int:\\n    \\\"\\\"\\\"Return the 128-byte-aligned fixed CSR body row size.\\\"\\\"\\\"\\n    return _align_up(chunk_delta3_body_bytes(elements), 128)\\n\\n\\ndef chunk_delta3_exception_capacity(elements: int) -> int:\\n    \\\"\\\"\\\"Return CPU encode scratch capacity in logical Packed20 entries.\\n\\n    Serving transfers a compact CSR arena containing only the words actually\\n    used, so scratch capacity no longer determines H2D size.  By default the\\n    scratch holds every exception count for which the exact CSR representation\\n    remains smaller than raw BF16.  Larger records are restored from the\\n    authoritative raw secondary KV.  An explicit override can reduce the\\n    scratch allocation, but it is clamped to that useful maximum.\\n\\n    \\\"\\\"\\\"\\n    body_stride = chunk_delta3_body_stride(elements)\\n    # One int64 CSR word offset is transferred per block. Require the\\n    # compressed representation to be strictly smaller than raw BF16.\\n    available = elements * 2 - body_stride - 8\\n    useful_capacity = max(3, ((max(1, available) - 1) // 8) * 3)\\n    override = os.getenv(\\\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\\\")\\n    if override is None:\\n        return useful_capacity\\n    requested = ((max(3, int(override)) + 2) // 3) * 3\\n    return min(requested, useful_capacity)\\n\\n\\n@dataclass(frozen=True)\\nclass ChunkDelta3HybridMemoryBudget:\\n    total_bytes: int\\n    body_bytes: int\\n    entry_budget_bytes: int\\n    scratch_bytes: int\\n    count_bytes: int\\n    planner_bytes: int\\n    s