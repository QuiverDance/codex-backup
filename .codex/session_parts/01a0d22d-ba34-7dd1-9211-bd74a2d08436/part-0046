means that the backend has no fixed-size persistent pool model.\\n    This module deliberately avoids importing CUDA extensions so vLLM can use\\n    it during memory planning.\\n    \\\"\\\"\\\"\\n    backend = backend.lower()\\n    if backend == \\\"zipserv\\\":\\n        rows, columns = _zipserv_dims(elements)\\n        sign_mantissa = rows * columns\\n        compressed_full = rows * columns * 2\\n        bitmap = (rows // 8) * (columns // 8) * 8\\n        tile_offsets_median = (rows // 16) * (columns // 64) * 2 * 4\\n        tile_offsets_global = (\\n            ((rows // 64) * (columns // 64) + 1) * 2 * 4)\\n        return (sign_mantissa + compressed_full + 3 * bitmap\\n                + tile_offsets_median + tile_offsets_global)\\n    if backend in _P4_LAYOUTS:\\n        raw_bytes = elements * 2\\n        return ((raw_bytes + 127) // 128) * 128 + 9\\n    if backend == \\\"chunk_delta3\\\":\\n        body_stride = chunk_delta3_body_stride(elements)\\n        entry_capacity = chunk_delta3_exception_capacity(elements)\\n        # Persistent host storage is body + bounded encode scratch + count.\\n        # Transfer only the used exception words, without padding.\\n        return body_stride + (entry_capacity // 3) * 8 + 4\\n    return None\\n28-if _cd3_decode_threads not in (64, 128, 256):\\n29-    raise ValueError(\\n30-        \\\"TIERED_SERVE_CD3_DECODE_THREADS must be 64, 128, or 256\\\")\\n31:_cd3_kv_delta_bits = chunk_delta3_kv_delta_bits()\\n32:_cd3_kv_decode_threads = int(\\n33:    _os.environ.get(\\\"TIERED_SERVE_KV_CD3_DECODE_THREADS\\\", \\\"128\\\"))\\n34:if _cd3_kv_decode_threads not in (64, 128):\\n35-    raise ValueError(\\n36:        \\\"TIERED_SERVE_KV_CD3_DECODE_THREADS must be 64 or 128\\\")\\n37-_cd3_defines = [\\n38:    f\\\"-DCD3_KV_DELTA_BITS={_cd3_kv_delta_bits}\\\",\\n39:    f\\\"-DCD3_KV_DECODE_THREADS={_cd3_kv_decode_threads}\\\",\\n40-    f\\\"-DCD3_BASE_ROWS={_cd3_base_rows}\\\",\\n41-    f\\\"-DCD3_DECODE_THREADS={_cd3_decode_thread