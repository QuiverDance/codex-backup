       host_offsets = (offsets_k, offsets_v)\\n        else:\\n            host_entries = (\\n                states[\\\"k\\\"].entries[:states[\\\"k\\\"].used_words],\\n                states[\\\"v\\\"].entries[:states[\\\"v\\\"].used_words],\\n            )\\n            host_offsets = (\\n                states[\\\"k\\\"].offsets,\\n                states[\\\"v\\\"].offsets,\\n            )\\n\\n        host_bodies = (\\n            self._host_pools[layer_id][\\\"k\\\"][\\\"body\\\"],\\n            self._host_pools[layer_id][\\\"v\\\"][\\\"body\\\"],\\n        )\\n        entry_words = (\\n            host_entries[0].numel(), host_entries[1].numel())\\n        staged_bytes = (\\n            n * (2 * self._body_stride + 3 * 8)\\n            + host_entries[0].nbytes + host_entries[1].nbytes)\\n        active_words = tuple(int(states[side].word_counts[slots].sum()) for side in (\\\"k\\\", \\\"v\\\"))\\n        plan = _DecodePlan(\\n            layer_id=layer_id,\\n            block_ids=block_ids,\\n            block_ids_tensor=block_ids_tensor,\\n            block_ids_cpu=block_ids_cpu,\\n            generation=self._decode_generation.get(layer_id, 0),\\n            slots_gpu=self._identity_slots_gpu[:n],\\n            host_bodies=host_bodies,\\n            host_offsets=host_offsets,\\n            host_entries=host_entries,\\n            offsets_are_compact=repack,\\n            storage_rows=n,\\n            entry_words=entry_words,\\n            entry_wire_bytes=tuple(words * 8 for words in entry_words),\\n            staged_bytes=staged_bytes,\\n            host_owners=host_owners,\\n            h2d_done=(self._free_csr_h2d_events.pop()\\n                      if self._free_csr_h2d_events else torch.cuda.Event()),\\n            side_payload=tuple(n * self._record_body_bytes + words * 8 for words in active_words),\\n            side_alignment=(n * (self._body_stride - self._record_body_bytes),) * 2,\\n            side_gap=tuple((entry_words[i] - active_words[i]) * 8 for i in range(2)),\\n            csr_garbage_bytes=(0 if repack else 8 * sum(\\n                states[side].garbage_words for side in (\\\"k\\\", \\\"v\\\"))),\\n            profile_active_entry_bytes=(8 * sum(active_words)\\n                                        if self._csr_cpu_optimized else None),\\n        )\\n        if self._csr_cpu_optimized and self.execution_requested == \\\"serial\\\":\\n            rings = self._gpu_decomp_pool_ring\\n            native_profile = {} if cd3_cpu_profile.enabled else None\\n            plan.serial_native = _cd3_ext.prepare_chunk_delta3_kv_serial(\\n                block_ids_tensor, self._kv_slot[layer_id], block_ids_cpu,\\n                *host_bodies, *host_offsets, *host_entries,\\n                [ring[\\\"k\\\"][\\\"body\\\"] for ring in rings],\\n                [ring[\\\"v\\\"][\\\"body\\\"] for ring in rings],\\n                [ring[\\\"k\\\"][\\\"entry_word_offsets\\\"] for ring in rings],\\n                [ring[\\\"v\\\"][\\\"entry_word_offsets\\\"] for ring in rings],\\n                self._block_ids_gpu_ring,\\n                [ring[\\\"k\\\"][\\\"entries20x3\\\"] for ring in rings],\\n                [ring[\\\"v\\\"][\\\"entries20x3\\\"] for ring in rings],\\n                repack, hwm, plan.slots_gpu,\\n                k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\\n                v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\\n                native_profile)\\n            plan.output_buffers = (k_cache, v_cache)\\n            plan.staged_bytes = plan.serial_native.wire_bytes\\n            if native_profile is not None:\\n                cd3_cpu_profile.record(\\\"load.native_plan_build_cpu_ms\\\", int(\\n                    native_profile[\\\"native_plan_build_cpu_ms\\\"] * 1e6))\\n        return plan\\n\\n    def _stage_decode_plan(\\n            self, plan: _DecodePlan, ring_slot: int,\\n            stream: torch.cuda.Stream, profile=None, *, decode_events=None) -> None:\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        handles = profile.get(\\\"_handles\\\", (0, 0, 0, 0)) if profile is not None else (0, 0, 0, 0)\\n        if plan.block_ids_cpu is None:\\n            raise RuntimeError(\\\"ChunkDelta3 decode plan was already released\\\")\\n        gpu_pool = self._gpu_decomp_pool_ring[ring_slot]\\n        metrics = kv_load_metrics.current()\\n        transfer = None\\n        if metrics is not None:\\n            if plan.profile_active_entry_bytes is None:\\n                slots = self._kv_slot_np[plan.layer_id][plan.block_ids]\\n                plan.profile_active_entry_bytes = 8 * sum(\\n                    int(self._persistent_csr[plan.layer_id][side].word_counts[slots].sum())\\n                    for side in (\\\"k\\\", \\\"v\\\"))\\n            n = plan.storage_rows\\n            transfer = metrics.transfer(\\n                n * self._block_numel * 4,\\n                n * 2 * self._record_body_bytes\\n                + plan.profile_active_entry_bytes)\\n            transfer.stats.extend((0, 0))\\n        load_handles = transfer.handles if transfer is not None else (0, 0)\\n        if plan.serial_native is not None:\\n            events = (*decode_events[:4], *load_handles, *decode_events[4:])\\n            plan.serial_native.submit_decode(\\n                ring_slot, stream.cuda_stream, self.batch_decomp_stream.cuda_stream,\\n                self._decode_consumed[ring_slot].cuda_event,\\n                self._kv_dec_h2d[plan.layer_id].cuda_event,\\n                plan.h2d_done.cuda_event, events, profile,\\n                transfer.stats if transfer is not None else None)\\n        else:\\n            _cd3_ext.prepare_chunk_delta3_kv_decode(\\n                plan.block_ids_tensor,\\n                self._kv_slot[plan.layer_id],\\n                plan.block_ids_cpu,\\n                plan.host_bodies[0], plan.host_bodies[1],\\n                plan.host_offsets[0], plan.host_offsets[1],\\n                plan.host_entries[0], plan.host_entries[1],\\n                gpu_pool[\\\"k\\\"][\\\"body\\\"], gpu_pool[\\\"v\\\"][\\\"body\\\"],\\n                gpu_pool[\\\"k\\\"][\\\"entry_word_offsets\\\"],\\n                gpu_pool[\\\"v\\\"][\\\"entry_word_offsets\\\"],\\n                self._block_ids_gpu_ring[ring_slot],\\n                gpu_pool[\\\"k\\\"][\\\"entries20x3\\\"],\\n                gpu_pool[\\\"v\\\"][\\\"entries20x3\\\"],\\n                plan.offsets_are_compact,\\n                self._kv_slot_allocator[plan.layer_id].high_water,\\n                stream.cuda_stream, profile, handles[0], handles[1],\\n                load_handles[0], load_handles[1],\\n                transfer.stats if transfer is not None else None,\\n            )\\n        # Same-generation submissions can read the already ordered IDs.\\n        # Native code still validates every slot and avoids rewriting this\\n        # pinned source while an earlier H2D may be reading it.\\n        plan.block_ids_tensor = plan.block_ids_cpu\\n        if transfer is not None:\\n            # Preserve baseline's one native submission and paired decoder;\\n            # count its actual descriptors separately from API calls.\\n            n = plan.storage_rows\\n            metrics.record_cd3(modes={\\n                \\\"cd3_storage_requested\\\": self.storage_requested,\\n                \\\"cd3_storage_effective\\\": self.storage_backend,\\n                \\\"cd3_execution_requested\\\": self.execution_requested,\\n                \\\"cd3_execution_effective\\\": \\\"serial\\\",\\n                \\\"cd3_fallback_reason\\\": self.storage_fallback_reason or \\\"none\\\",\\n                \\\"cd3_csr_policy\\\": self.csr_policy,\\n                \\\"cd3_cpu_path\\\": self.cpu_path,\\n            }, counters={\\n                \\\"cd3_k_h2d_bytes\\\": n * (self._body_stride + 16) + plan.entry_wire_bytes[0],\\n                \\\"cd3_v_h2d_bytes\\\": n * (self._body_stride + 8) + plan.entry_wire_bytes[1],\\n                \\\"cd3_metadata_bytes\\\": n * 24,\\n                \\\"cd3_alignment_bytes\\\": sum(plan.side_alignment),\\n                \\\"cd3_gap_bytes\\\": sum(plan.side_gap),\\n                \\\"cd3_csr_garbage_bytes\\\": plan.csr_garbage_bytes,\\n                \\\"cd3_csr_skipped_bytes\\\": plan.csr_skipped_bytes,\\n                \\\"cd3_copy_descriptors\\\": transfer.stats[3],\\n                \\\"cd3_batch_calls\\\": transfer.stats[4],\\n            })\\n        if profile is not None:\\n            profile[\\\"stage_cpu_ms\\\"] = (_time.perf_counter_ns() - started) / 1e6\\n            cd3_cpu_profile.record_load(profile)\\n\\n    def _decode_probe_handles(self, plan, profile):\\n        handles = profile.get(\\\"_handles\\\", (0, 0, 0, 0)) if profile is not None else (0, 0, 0, 0)\\n        if self._tb:\\n            # One pair per chunk, not a layer event overwritten by later chunks.\\n            index = len(self._kv_decode_intervals)\\n            if index == len(self._pipeline_timing_pool):\\n                group = tuple(torch.cuda.Event(enable_timing=True) for _ in range(8))\\n                for event in group:\\n                    event.record(self.batch_decomp_stream)\\n                self._pipeline_timing_pool.append(group)\\n            begin, end = self._pipeline_timing_pool[index][4:6]\\n            handles = (*handles[:2], begin.cuda_event, end.cuda_event)\\n            self._kv_decode_intervals.append((plan.layer_id, \\\"pair\\\", begin, end))\\n        return handles\\n\\n    def _launch_decode(\\n            self, gpu_pool, plan: _DecodePlan, k_cache, v_cache,\\n            ring_slot: int, profile=None) -> None:\\n        handles = self._decode_probe_handles(plan, profile)\\n        _cd3_ext.decompress_chunk_delta3_batched_csr_pair_stream(\\n            gpu_pool[\\\"k\\\"][\\\"body\\\"],\\n            gpu_pool[\\\"v\\\"][\\\"body\\\"],\\n            gpu_pool[\\\"k\\\"][\\\"entries20x3\\\"],\\n            gpu_pool[\\\"v\\\"][\\\"entries20x3\\\"],\\n            gpu_pool[\\\"k\\\"][\\\"entry_word_offsets\\\"],\\n            gpu_pool[\\\"v\\\"][\\\"entry_word_offsets\\\"],\\n            plan.slots_gpu,\\n            self._block_ids_gpu_ring[ring_slot],\\n            k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\\n            v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\\n            self.batch_decomp_stream.cuda_stream, handles[2], handles[3],\\n        )\\n\\n    def _submit_split_plan(\\n            self, layer_id: int, plan: _DecodePlan,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor,\\n            first_chunk: bool, profile=None) -> None:\\n        ring_slot = self._decode_ring_idx & 1\\n        self._decode_ring_idx += 1\\n        gpu_pool = self._gpu_decomp_pool_ring[ring_slot]\\n        h2d_stream = self.load_kv_stream\\n        if plan.serial_native is not None:\\n            handles = self._decode_probe_handles(plan, profile)\\n            ring_handles = (0, 0)\\n            if profile is not None and profile[\\\"gpu_sampled\\\"]:\\n                probes = self._kv_load_probe_events[layer_id]\\n                profile[\\\"_events\\\"].append((\\\"ring_wait_ms\\\", probes[4], probes[5]))\\n                ring_handles = (probes[4].cuda_event, probes[5].cuda_event)\\n            layer_begin = (self._kv_decode_begin[layer_id].cuda_event\\n                           if self._tb and first_chunk else 0)\\n            if not plan.h2d_done.cuda_event:\\n                plan.h2d_done.record(self.batch_decomp_stream)\\n            # A partial native submission must retain every DMA source until\\n            # error cleanup has drained both streams.\\n            plan.h2d_submitted = True\\n            plan.completion_valid = False\\n            try:\\n                self._stage_decode_plan(\\n                    plan, ring_slot, h2d_stream, profile,\\n                    decode_events=(*handles, *ring_handles, layer_begin))\\n                plan.completion_valid = True\\n            except BaseException as error:\\n                error.add_note(f\\\"CD3 serial layer={layer_id} blocks={plan.storage_rows} \\\"\\n                               f\\\"ring={ring_slot} generation={plan.generation}\\\")\\n                h2d_stream.synchronize()\\n                self.batch_decomp_stream.synchronize()\\n                plan.h2d_done.record(h2d_stream)\\n                plan.completion_valid = True\\n                raise\\n            return\\n        if profile is not None and profile[\\\"gpu_sampled\\\"]:\\n            events = self._kv_load_probe_events[layer_id]\\n            profile[\\\"_events\\\"].append((\\\"ring_wait_ms\\\", events[4], events[5]))\\n            events[4].record(h2d_stream)\\n        h2d_stream.wait_event(self._decode_consumed[ring_slot])\\n        if profile is not None and profile[\\\"gpu_sampled\\\"]:\\n            events[5].record(h2d_stream)\\n        self._stage_decode_plan(plan, ring_slot, h2d_stream, profile)\\n        plan.h2d_done.record(h2d_stream)\\n        plan.h2d_submitted = True\\n        self._kv_dec_h2d[layer_id].record(h2d_stream)\\n\\n        self.batch_decomp_stream.wait_event(self._kv_dec_h2d[layer_id])\\n        if self._tb and first_chunk:\\n            self._kv_decode_begin[layer_id].record(\\n                self.batch_decomp_stream)\\n        self._launch_decode(\\n            gpu_pool, plan, k_cache, v_cache, ring_slot, profile)\\n        self._decode_consumed[ring_slot].record(\\n            self.batch_decomp_stream)\\n\\n    def _decompress_blocks(self, layer_id: int, block_ids,\\n                           k_cache: torch.Tensor,\\n                           v_cache: torch.Tensor, *, chunk_index=0) -> None:\\n        n = len(block_ids)\\n        if n == 0:\\n            return\\n        if n > self._max_gpu_decomp_blocks:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV decode batch {n} exceeds \\\"\\n                f\\\"capacity {self._max_gpu_decomp_blocks}\\\")\\n        if self._kv_slot_allocator[layer_id].high_water <= 0:\\n            return\\n        if not isinstance(block_ids, np.ndarray):\\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\\n        profile = kv_cpu_profile.new_load(layer_id, \\\"cd3\\\", n, self._n_layers)\\n        if profile is None and cd3_cpu_profile.enabled:\\n            profile = {\\\"gpu_sampled\\\": 0}\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        plans = (self._decode_plans if chunk_index == 0 else\\n                 self._decode_extra_plans.setdefault(layer_id, {}))\\n        plan_key = layer_id if chunk_index == 0 else chunk_index\\n        plan = plans.get(plan_key)\\n        generation = self._decode_generation.get(layer_id, 0)\\n        plan_hit = (plan is not None and plan.block_ids is block_ids\\n                    and plan.generation == generation)\\n        if plan_hit and getattr(plan, \\\"serial_native\\\", None) is not None:\\n            plan_hit = (plan.output_buffers[0] is k_cache\\n                        and plan.output_buffers[1] is v_cache)\\n        if not plan_hit:\\n            # Plan construction only touches CPU metadata and tensor views.\\n            # Retire first so completed arenas/events can serve this plan.\\n            self._retire_decode_plan(plans.pop(plan_key, None))\\n            plan = self._build_decode_plan(layer_id, block_ids, k_cache, v_cache)\\n            plans[plan_key] = plan\\n        metrics = kv_load_metrics.current()\\n        if metrics is not None:\\n            metrics.record_cd3(modes={}, counters={\\n                \\\"cd3_plan_builds\\\": int(not plan_hit),\\n                \\\"cd3_plan_hits\\\": int(plan_hit),\\n            })\\n\\n        if self.storage_backend == \\\"hybrid\\\" or self.execution_requested == \\\"pipeline\\\":\\n            if self.storage_backend != \\\"hybrid\\\" and not plan.native_plans:\\n                from tiered_serve.chunk_delta3_kv_plan import prepare_csr_pipeline\\n                prepare_csr_pipeline(self, plan, _cd3_ext)\\n            if profile is not None:\\n                profile.update(plan_hit=int(plan_hit), plan_cpu_ms=(\\n                    _time.perf_counter_ns() - started) / 1e6)\\n                if self.storage_backend == \\\"hybrid\\\":\\n                    native = plan.native_plan\\n                    profile.update(\\n                        native_prepare_cpu_ms=0.0 if plan_hit else native.prepare_cpu_ms,\\n                        planner_visited_records=0 if plan_hit else native.visited_records,\\n                        planner_selected_segments=0 if plan_hit else native.selected_segments,\\n                        planner_new_allocations=0 if plan_hit else native.new_allocations)\\n            self._submit_native_plan(layer_id, plan, k_cache, v_cache, profile)\\n            return\\n\\n        if profile is not None:\\n            profile[\\\"plan_cpu_ms\\\"] = (_time.perf_counter_ns() - started) / 1e6\\n            if plan.profile_active_entry_bytes is None:\\n                slots = self._kv_slot_np[layer_id][block_ids]\\n                plan.profile_active_entry_bytes = 8 * sum(\\n                    int(self._persistent_csr[layer_id][side].word_counts[slots].sum())\\n                    for side in (\\\"k\\\", \\\"v\\\"))\\n            entries = sum(plan.entry_wire_bytes)\\n            profile.update(plan_hit=int(plan_hit), raw_bytes=n * self._block_numel * 4,\\n                           body_bytes=n * self._body_stride * 2, entry_bytes=entries,\\n                           active_entry_bytes=plan.profile_active_entry_bytes,\\n                           extra_entry_bytes=max(0, entries - plan.profile_active_entry_bytes))\\n            if profile[\\\"gpu_sampled\\\"] and self._kv_load_probe_events:\\n                events = self._kv_load_probe_events[layer_id]\\n                profile[\\\"_handles\\\"] = tuple(event.cuda_event for event in events[:4])\\n                profile[\\\"_events\\\"] = [(\\\"h2d_window_ms\\\", events[0], events[1]),\\n                                      (\\\"decode_window_ms\\\", events[2], events[3])]\\n            else:\\n                profile[\\\"gpu_sampled\\\"] = 0\\n\\n        self._submit_split_plan(\\n            layer_id, plan, k_cache, v_cache, first_chunk=True, profile=profile)\\n\\n    def _submit_native_plan(self, layer_id, plan, k_cache, v_cache, profile):\\n        ring = self._decode_ring_idx & 1\\n        self._decode_ring_idx += 1\\n        pipeline = self.execution_requested == \\\"pipeline\\\"\\n        stream = self.load_kv_stream\\n        effective = \\\"pipeline\\\" if pipeline else \\\"serial\\\"\\n        reason = self.storage_fallback_reason\\n        mode = (effective, reason)\\n        if mode not in self._reported_execution_modes:\\n            logger.info(\\\"CD3 KV execution requested=%s effective=%s fallback=%s\\\",\\n                        self.execution_requested, effective, reason or \\\"none\\\")\\n            self._reported_execution_modes.add(mode)\\n        hybrid_plan = getattr(plan, \\\"native_plan\\\", None)\\n        native = hybrid_plan if hybrid_plan is not None else plan.native_plans[ring]\\n        if not plan.h2d_done.cuda_event:\\n            plan.h2d_done.record(self.batch_decomp_stream)\\n        metrics = kv_load_metrics.current()\\n        transfers = []\\n        if metrics is not None:\\n            for index, wire in enumerate((native.k_wire_bytes, native.v_wire_bytes)):\\n                item = metrics.transfer(plan.storage_rows * self._block_numel * 2,\\n                                        plan.side_payload[index])\\n                item.stats[2] = wire\\n                transfers.append(item)\\n            metrics.record_cd3(modes={\\n                \\\"cd3_storage_requested\\\": self.storage_requested,\\n                \\\"cd3_storage_effective\\\": self.storage_backend,\\n                \\\"cd3_execution_requested\\\": self.execution_requested,\\n                \\\"cd3_execution_effective\\\": effective,\\n                \\\"cd3_fallback_reason\\\": reason or \\\"none\\\",\\n                \\\"cd3_csr_policy\\\": self.csr_policy,\\n                \\\"cd3_cpu_path\\\": self.cpu_path,\\n            }, counters={\\n                \\\"cd3_k_h2d_bytes\\\": native.k_wire_bytes,\\n                \\\"cd3_v_h2d_bytes\\\": native.v_wire_bytes,\\n                \\\"cd3_metadata_bytes\\\": plan.storage_rows * 24,\\n                \\\"cd3_alignment_bytes\\\": sum(plan.side_alignment),\\n                \\\"cd3_gap_bytes\\\": sum(plan.side_gap),\\n                \\\"cd3_csr_garbage_bytes\\\": getattr(plan, \\\"csr_garbage_bytes\\\", 0),\\n                \\\"cd3_copy_descriptors\\\": native.k_copy_count + native.v_copy_count,\\n                \\\"cd3_batch_calls\\\": native.batch_api_calls,\\n            })\\n        events = ()\\n        handles = []\\n        if self._tb:\\n            index = len(self._kv_side_intervals)\\n            if index == len(self._pipeline_timing_pool):\\n                group = tuple(torch.cuda.Event(enable_timing=True) for _ in range(8))\\n                for event in group:\\n                    event.record(self.batch_decomp_stream)\\n                self._pipeline_timing_pool.append(group)\\n            events = self._pipeline_timing_pool[index]\\n            # Transfer windows feed the existing loader's H2D accounting.\\n            if transfers and metrics.timing:\\n                events = (*transfers[0].events, *transfers[1].events, *events[4:])\\n            handles = [event.cuda_event for event in events]\\n            self._kv_side_intervals.append((layer_id, events))\\n            self._kv_decode_intervals.extend((\\n                (layer_id, \\\"k\\\", events[4], events[5]),\\n                (layer_id, \\\"v\\\", events[6], events[7])))\\n            if profile is not None:\\n                profile.update(gpu_samp