            target, baseline = f\"{target}_{workload}\", f\"{baseline}_{workload}\"\n            if target not in by_name or baseline not in by_name:\n                continue\n            a, b = by_name[baseline], by_name[target]\n            delta = {key: 100 * (b[key] / a[key] - 1) for key in (\n                \"tpot_mean_ms\", \"tpot_p50_ms\", \"tpot_p90_ms\", \"duration_s\", \"h2d_per_raw\")}\n            comparisons.append(dict(target=target, baseline=baseline, delta_pct=delta,\n                improves_mean_tpot_and_duration=(delta[\"tpot_mean_ms\"] < 0\n                                                 and delta[\"duration_s\"] < 0)))\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(dict(runs=records, comparisons=comparisons), indent=2) + \"\\n\")\n    fields = [\"run\", \"source_commit\", \"source_sha256\", \"native_sha256\", \"tpot_mean_ms\",\n              \"tpot_p50_ms\", \"tpot_p90_ms\", \"duration_s\", \"slo200_pct\", \"request_250_att_pct\",\n              \"h2d_per_raw\", \"cd3_csr_skipped_bytes\", \"cd3_copy_descriptors\", \"cd3_batch_calls\"]\n    with args.output.with_suffix(\".csv\").open(\"w\", newline=\"\") as out:\n        writer = csv.DictWriter(out, fieldnames=fields, extrasaction=\"ignore\")\n        writer.writeheader()\n        writer.writerows(records)\n    print(json.dumps(dict(runs=len(records), comparisons=comparisons), indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /home/ubuntu/TieredServe/scripts/summarize_cd3_improvement.py\n"},"completed_at_ms":1790248182392}}
