ting CUDA extensions so vLLM can use\\n    it during memory planning.\\n    \\\"\\\"\\\"\\n    backend = backend.lower()\\n    if backend == \\\"zipserv\\\":\\n        rows, columns = _zipserv_dims(elements)\\n        sign_mantissa = rows * columns\\n        compressed_full = rows * columns * 2\\n        bitmap = (rows // 8) * (columns // 8) * 8\\n        tile_offsets_median = (rows // 16) * (columns // 64) * 2 * 4\\n        tile_offsets_global = (\\n            ((rows // 64) * (columns // 64) + 1) * 2 * 4)\\n        return (sign_mantissa + compressed_full + 3 * bitmap\\n                + tile_offsets_median + tile_offsets_global)\\n    if backend in _P4_LAYOUTS:\\n        raw_bytes = elements * 2\\n        return ((raw_bytes + 127) // 128) * 128 + 9\\n    if backend == \\\"chunk_delta3\\\":\\n        body_stride = chunk_delta3_body_stride(elements)\\n        entry_capacity = chunk_delta3_exception_capacity(elements)\\n        # Persistent host storage is body + bounded encode scratch + count.\\n        # Transfer only the used exception words, without padding.\\n        return body_stride + (entry_capacity // 3) * 8 + 4\\n    return None\\n\\\"\\\"\\\"KV H2D accounting shared by offline and serving.\\n\\nBytes count submitted memcpy payloads, not link-protocol traffic. Compression\\nratio is dense-equivalent bytes / active encoded payload bytes; transfer ratio\\nalso includes routing metadata, padding, and extra rows actually copied.\\nRatios over multiple forwards must be computed from byte sums, not averaged.\\nCUDA timing is opt-in and reports a submission window, not copy-engine activity.\\n\\\"\\\"\\\"\\nimport atexit\\nimport csv\\nimport os\\nfrom pathlib import Path\\n\\nfrom tiered_serve import cd3_cpu_profile\\n\\n\\nCOLUMNS = (\\n    \\\"forward\\\", \\\"batch\\\", \\\"step\\\", \\\"config\\\", \\\"phase\\\", \\\"tokens\\\", \\\"kv_raw_bytes\\\", \\\"kv_payload_bytes\\\",\\n    \\\"kv_h2d_bytes\\\", \\\"kv_compression_ratio\\\", \\\"kv_transfer_ratio\\\",\\n    \\\"kvload_ms\\\", \\\"transfers\\\", \\\"bytes_complete\\\", \\\"timing_complete\\\",\\n    \\\"cd3_k_h2d_bytes\\\", \\\"cd3_v_h2d_bytes\\\", \\\"cd3_metadata_bytes\\\",\\n    \\\"cd3_alignment_bytes\\\", \\\"cd3_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\",\\n    \\\"cd3_csr_garbage_bytes\\\", \\\"cd3_csr_skipped_bytes\\\",\\n    \\\"cd3_plan_builds\\\", \\\"cd3_plan_hits\\\",\\n    \\\"cd3_storage_requested\\\", \\\"cd3_storage_effective\\\", \\\"cd3_execution_requested\\\",\\n    \\\"cd3_execution_effective\\\", \\\"cd3_fallback_reason\\\",\\n    \\\"cd3_csr_policy\\\",\\n    \\\"cd3_cpu_path\\\",\\n)\\nCD3_COUNTERS = COLUMNS[15:26]\\nCD3_MODES = COLUMNS[26:]\\n_collector = None\\n_generation = 0\\n\\n\\nclass Transfer:\\n    def __init__(self, timing):\\n        # Native staging fills this reusable list before the begin event.\\n        self.stats = [0, 0, 0]  # dense-equivalent, encoded payload, H2D\\n        self.layer = -1\\n        self.events = None\\n        self.handles = (0, 0)\\n        if timing:\\n            import torch\\n            self.events = tuple(torch.cuda.Event(enable_timing=True)\\n                                for _ in range(2))\\n            for event in self.events:\\n                event.record()  # Materialize native handles once.\\n            self.handles = tuple(event.cuda_event for event in self.events)\\n\\n    def begin(self, stream):\\n        if self.events:\\n            self.events[0].record(stream)\\n\\n    def end(self, stream):\\n        if self.events:\\n            self.events[1].record(stream)\\n\\n\\nclass KVLoadMetrics:\\n    def __init__(self, *, timing=False, path=None, capacity=0):\\n        self.timing = timing\\n        self.active = False\\n        self.forward = -1\\n        self.batch = self.step = -1\\n        self.config = \\\"serving\\\"\\n        self.pool = [Transfer(timing) for _ in range(capacity)]\\n        self.layer = -1\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.last = None\\n        self.cd3 = {}\\n        self.file = None\\n        if path:\\n            Path(path).parent.mkdir(parents=True, exist_ok=True)\\n            # One write per forward, never per layer; line buffering also\\n            # preserves completed forwards when a serving worker is stopped.\\n            self.file = open(path, \\\"w\\\", buffering=1)\\n            self.writer = csv.DictWriter(self.file, fieldnames=COLUMNS)\\n            self.writer.writeheader()\\n            atexit.register(self.close)\\n\\n    def close(self):\\n        if self.file:\\n            self.file.close()\\n            self.file = None\\n\\n    def begin_forward(self, is_prefill, tokens):\\n        self.forward += 1\\n        self.layer = -1\\n        self.phase = \\\"prefill\\\" if is_prefill else \\\"decode\\\"\\n        self.tokens = tokens\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.active = True\\n        self.cd3 = {}\\n\\n    def record_cd3(self, *, modes, counters):\\n        for key, value in modes.items():\\n            self.cd3[key] = value\\n        for key, value in counters.items():\\n            self.cd3[key] = self.cd3.get(key, 0) + value\\n\\n    def add_payload(self, raw_bytes, payload_bytes):\\n        self.raw_bytes += raw_bytes\\n        self.payload_bytes += payload_bytes\\n\\n    def transfer(self, raw_bytes=0, payload_bytes=0):\\n        if self.count == len(self.pool):\\n            self.pool.append(Transfer(self.timing))\\n        item = self.pool[self.count]\\n        self.count += 1\\n        item.layer = self.layer\\n        item.stats[:] = [raw_bytes, payload_bytes, 0]\\n        return item\\n\\n    def transfers(self):\\n        return [item for item in self.pool[:self.count] if item.stats[2] > 0]\\n\\n    def snapshot(self):\\n        items = self.transfers()\\n        raw, payload, wire = (sum(item.stats[i] for item in items)\\n                              for i in range(3))\\n        raw += self.raw_bytes\\n        payload += self.payload_bytes\\n        timing_complete = self.timing and self.complete\\n        elapsed = 0.0\\n        if timing_complete:\\n            for item in items:\\n                begin, end = item.events\\n                if not end.query():\\n                    timing_complete = False\\n                    break\\n                elapsed += begin.elapsed_time(end)\\n        result = dict(\\n            forward=self.forward, batch=self.batch, step=self.step,\\n            config=self.config, phase=self.phase, tokens=self.tokens,\\n            kv_raw_bytes=raw if self.complete else None,\\n            kv_payload_bytes=payload if self.complete else None,\\n            kv_h2d_bytes=wire if self.complete else None,\\n            kv_compression_ratio=(raw / payload if payload and self.complete else None),\\n            kv_transfer_ratio=(raw / wire if wire and self.complete else None),\\n            kvload_ms=elapsed if timing_complete else None,\\n            transfers=len(items), bytes_complete=int(self.complete),\\n            timing_complete=int(timing_complete))\\n        result.update({key: self.cd3.get(key) for key in (*CD3_COUNTERS, *CD3_MODES)})\\n        return result\\n\\n    def finish_forward(self):\\n        if not self.active:\\n            return\\n        self.last = self.snapshot()\\n        if self.file:\\n            self.writer.writerow({key: \\\"NA\\\" if value is None else value\\n                                  for key, value in self.last.items()})\\n        self.active = False\\n        if cd3_cpu_profile.enabled and self.forward % 64 == 0:\\n            cd3_cpu_profile.flush()\\n\\n\\ndef configure(*, timing=False, log_dir=None, capacity=0):\\n    global _collector, _generation\\n    if _collector:\\n        _collector.close()\\n    enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n    if not enabled and not timing:\\n        _collector = None\\n        return None\\n    directory = os.getenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\") or log_dir\\n    _generation += 1\\n    path = (str(Path(directory) / f\\\"kv_metrics.{os.getpid()}.{_generation}.csv\\\")\\n            if enabled and directory else None)\\n    _collector = KVLoadMetrics(timing=timing, path=path, capacity=capacity)\\n    return _collector\\n\\n\\ndef current():\\n    return _collector if _collector is not None and _collector.active else None\\n\\n\\ndef set_context(batch, step, config):\\n    if _collector is not None:\\n        _collector.batch, _collector.step, _collector.config = batch, step, config\\n\\n\\ndef h2d(source, device, *, raw=False):\\n    \\\"\\\"\\\"Account for a standalone H2D, keeping destination allocation outside timing.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return source.to(device, non_blocking=True)\\n    size = source.nbytes\\n    item = metrics.transfer(size if raw else 0, size if raw else 0)\\n    if metrics.timing:\\n        import torch\\n        destination = torch.empty_like(source, device=device)\\n        stream = torch.cuda.current_stream(device)\\n        item.begin(stream)\\n        destination.copy_(source, non_blocking=True)\\n        item.end(stream)\\n    else:\\n        destination = source.to(device, non_blocking=True)\\n    item.stats[2] = size\\n    return destination\\n\\n\\ndef copy_into(destination, source):\\n    metrics = current()\\n    if metrics is None:\\n        return destination.copy_(source, non_blocking=True)\\n    import torch\\n    item = metrics.transfer()\\n    stream = torch.cuda.current_stream(destination.device)\\n    item.begin(stream)\\n    destination.copy_(source, non_blocking=True)\\n    item.end(stream)\\n    item.stats[2] = source.nbytes\\n    return destination\\n\\n\\ndef submit(function, *args):\\n    \\\"\\\"\\\"Native descriptor builders return actual H2D bytes after submission.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return function(*args)\\n    item = metrics.transfer()\\n    item.stats[2] = function(*args, *item.handles)\\n    return item.stats[2]\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Summarize KV traffic across workers, without importing torch or CUDA.\\n\\nThe byte sums cover recorded model forwards (including repeated KV loads).\\nServing rows are not attributable to the client's trimmed request cohort.\\n\\\"\\\"\\\"\\nimport argparse\\nimport csv\\nfrom pathlib import Path\\n\\n\\nBYTE_FIELDS = (\\\"kv_raw_bytes\\\", \\\"kv_payload_bytes\\\", \\\"kv_h2d_bytes\\\")\\nCD3_FIELDS = (\\\"cd3_k_h2d_bytes\\\", \\\"cd3_v_h2d_bytes\\\", \\\"cd3_metadata_bytes\\\",\\n              \\\"cd3_alignment_bytes\\\", \\\"cd3_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\",\\n              \\\"cd3_csr_garbage_bytes\\\", \\\"cd3_csr_skipped_bytes\\\",\\n              \\\"cd3_plan_builds\\\", \\\"cd3_plan_hits\\\")\\n\\n\\ndef summarize(paths):\\n    groups = {}\\n    for path in paths:\\n        with open(path, newline=\\\"\\\") as source:\\n            for row in csv.DictReader(source):\\n                key = (row[\\\"config\\\"], row[\\\"batch\\\"], row[\\\"phase\\\"])\\n                if key not in groups:\\n                    groups[key] = dict(\\n                        config=key[0], batch=key[1], phase=key[2],\\n                        forwards=0, transfers=0, bytes_complete_forwards=0,\\n                        timed_forwards=0, **dict.fromkeys(BYTE_FIELDS, 0),\\n                        kvload_total_ms=0.0)\\n                    groups[key].update(dict.fromkeys(CD3_FIELDS, 0))\\n                    groups[key][\\\"cd3_accounted_forwards\\\"] = 0\\n                group = groups[key]\\n                group[\\\"forwards\\\"] += 1\\n                group[\\\"transfers\\\"] += int(row[\\\"transfers\\\"])\\n                if row[\\\"bytes_complete\\\"] == \\\"1\\\":\\n                    group[\\\"bytes_complete_forwards\\\"] += 1\\n                    for field in BYTE_FIELDS:\\n                        value = row.get(field)\\n                        if value in (None, \\\"NA\\\", \\\"\\\") or group[field] is None:\\n                            group[field] = None\\n                        else:\\n                            group[field] += int(value)\\n                if row[\\\"timing_complete\\\"] == \\\"1\\\":\\n                    group[\\\"timed_forwards\\\"] += 1\\n                    group[\\\"kvload_total_ms\\\"] += float(row[\\\"kvload_ms\\\"])\\n                if row.get(\\\"cd3_k_h2d_bytes\\\") not in (None, \\\"NA\\\", \\\"\\\"):\\n                    group[\\\"cd3_accounted_forwards\\\"] += 1\\n                    for field in CD3_FIELDS:\\n                        value = row.get(field)\\n                        if value in (None, \\\"NA\\\", \\\"\\\") or group[field] is None:\\n                            group[field] = None\\n                        else:\\n                            group[field] += int(value)\\n    for group in groups.values():\\n        if group[\\\"bytes_complete_forwards\\\"] != group[\\\"forwards\\\"]:\\n            for field in BYTE_FIELDS:\\n                group[field] = None\\n        raw = group[\\\"kv_raw_bytes\\\"]\\n        payload, wire = group[\\\"kv_payload_bytes\\\"], group[\\\"kv_h2d_bytes\\\"]\\n        group[\\\"kv_compression_ratio\\\"] = raw / payload if payload else None\\n        group[\\\"kv_transfer_ratio\\\"] = raw / wire if wire else None\\n        group[\\\"kv_h2d_payload_ratio\\\"] = wire / payload if payload else None\\n        if not group[\\\"cd3_accounted_forwards\\\"]:\\n            for field in CD3_FIELDS:\\n                group[field] = None\\n        if group[\\\"timed_forwards\\\"] != group[\\\"forwards\\\"]:\\n            group[\\\"kvload_total_ms\\\"] = None\\n        elapsed = group[\\\"kvload_total_ms\\\"]\\n        group[\\\"kvload_mean_ms\\\"] = (elapsed