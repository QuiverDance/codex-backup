\"v\\\", 10)):\\n            policy._host_pools[layer][side] = {\\n                \\\"num_exceptions\\\": ArrayTensor(\\n                    np.arange(6, dtype=np.int32) + bias + 1)\\n            }\\n            policy._persistent_csr[layer][side] = SimpleNamespace(\\n                word_counts=np.arange(6, dtype=np.int64) + bias + 1,\\n                garbage_words=100 + bias,\\n                used_words=999 + bias,\\n                entries=object(),\\n                offsets=object(),\\n            )\\n    policy._persistent_valid_np = {\\n        layer: np.frombuffer(valid, dtype=np.uint8)\\n        for layer, valid in policy._persistent_valid.items()\\n    }\\n    policy._host_num_exceptions_np = {\\n        layer: {side: pools[side][\\\"num_exceptions\\\"].numpy()\\n                for side in (\\\"k\\\", \\\"v\\\")}\\n        for layer, pools in policy._host_pools.items()\\n    }\\n    policy.invalidated_layers = []\\n\\n    def invalidate(self, layer_id):\\n        self.invalidated_layers.append(layer_id)\\n\\n    policy._invalidate_decode_plan = MethodType(invalidate, policy)\\n    return policy\\n\\n\\ndef _occupied_slots(allocator):\\n    occupied = set()\\n    for slot in range(allocator.capacity):\\n        try:\\n            allocator.validate_occupied(np.asarray([slot], dtype=np.int64))\\n        except RuntimeError:\\n            continue\\n        occupied.add(slot)\\n    assert len(occupied) == allocator.occupied_count\\n    return occupied\\n\\n\\ndef test_batch_retirement_updates_each_layer_once_and_preserves_csr_payload():\\n    policy = _state()\\n    csr_payloads = {\\n        (layer, side): (\\n            policy._persistent_csr[layer][side].entries,\\n            policy._persistent_csr[layer][side].offsets,\\n            policy._persistent_csr[layer][side].used_words,\\n        )\\n        for layer in range(2)\\n        for side in (\\\"k\\\", \\\"v\\\")\\n    }\\n\\n    policy.free_persistent_blocks([1, 3, 4, 3])\\n\\n    assert policy.