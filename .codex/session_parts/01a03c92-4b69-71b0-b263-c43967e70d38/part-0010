{"timestamp":"2026-08-26T06:27:33.086Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03cc0-a45e-7a73-a698-7886dfb6df80","call_id":"call_uCY9lshowXB0dl6lOyHvkFjh","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"?? tests/test_kv_prefill_load_policy.py\n?? tests/test_kv_retired_slots.py\n?? tests/test_prefill_weight_stream_policy.py\n\"\"\"CPU-only checks for eager-prefill frozen-weight stream policy.\n\nThe production loader imports CUDA extensions at module import time.  Extract\nthe small policy/helpers from their source AST so cutoff and event ordering can\nbe validated without a GPU or extension build.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nFROZEN_SOURCE = (\n    REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"frozen_split.py\"\n)\nINIT_SOURCE = REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"init.py\"\nWRAPPER_SOURCE = REPO_ROOT / \"tiered_serve\" / \"v1_cuda_graph_wrapper.py\"\n\n\ndef _class_method(source: Path, class_name: str, method_name: str) -> ast.AST:\n    tree = ast.parse(source.read_text())\n    cls = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef) and node.name == class_name\n    )\n    return next(\n        node for node in cls.body\n        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))\n        and node.name == method_name\n    )\n\n\ndef _policy_class(methods, namespace=None):\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=list(methods),\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {} if namespace is None else dict(namespace)\n    exec(compile(module, str(FROZEN_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"], namespace\n\n\ndef _alt(backend: str):\n    return SimpleNamespace(backend=backend)\n\n\ndef _info(backend: str | None):\n    return SimpleNamespace(alt=None if backend is None else _alt(backend))\n\n\ndef test_actual_raw_lookahead_uses_cached_all_cell_cutoff():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    predicate = _class_method(\n        WRAPPER_SOURCE,\n        \"TieredServeCUDAGraphWrapper\",\n        \"_prefill_raw_weight_lookahead\",\n    )\n    policy_cls, namespace = _policy_class((refresh, predicate))\n    namespace[\"TieredServeCUDAGraphWrapper\"] = policy_cls\n    policy_cls._uses_component_weight_waits_for = staticmethod(\n        lambda dm: dm.component_weight_waits)\n\n    loader = policy_cls()\n    loader._cudagraph_ceiling = 512\n    loader.frozen_comp_buffers = []\n    loader._alt_max_chunk_for = lambda backend: {\n        \"p4flat\": 1330,\n        \"zipserv\": 1107,\n    }[backend]\n    loader.frozen_split_info = [\n        {\"qkv\": _info(\"p4flat\"), \"o\": _info(None)},\n        {\"down\": _info(\"zipserv\")},\n        None,\n    ]\n    loader._refresh_prefill_raw_lookahead_policy()\n\n    assert loader._prefill_raw_lookahead_split_cells == 3\n    assert loader._prefill_raw_lookahead_min_tokens == 1330\n\n    loader.frozen_decomp_event = object()\n    loader.FROZEN_DECOMP_PARITY = 2\n    loader.batch_has_prefill = True\n    loader.use_prefill_raw_bf16 = True\n    loader.component_weight_waits = True\n\n    for n in (512, 513, 1329):\n        loader.cur_num_tokens = n\n        assert not loader._prefill_raw_weight_lookahead(loader)\n    for n in (1330, 1331):\n        loader.cur_num_tokens = n\n        assert loader._prefill_raw_weight_lookahead(loader)\n\n    loader.batch_has_prefill = False\n    assert not loader._prefill_raw_weight_lookahead(loader)\n    loader.batch_has_prefill = True\n    loader.component_weight_waits = False\n    assert not loader._prefill_raw_weight_lookahead(loader)\n\n\ndef test_actual_raw_cutoff_respects_ceiling_and_empty_placement():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    policy_cls, _ = _policy_class((refresh,))\n    loader = policy_cls()\n    loader.frozen_comp_buffers = []\n    loader._alt_max_chunk_for = lambda backend: 128\n    loader._cudagraph_ceiling = 512\n    loader.frozen_split_info = [{\"qkv\": _info(\"p4flat\")}]\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert loader._prefill_raw_lookahead_min_tokens == 513\n\n    loader.frozen_split_info = []\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert not loader._prefill_raw_lookahead_has_split\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n    loader.frozen_split_info = [{\"qkv\": _info(None)}]\n    loader._cudagraph_ceiling = 0\n    loader._refresh_prefill_raw_lookahead_policy()\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n\ndef test_mixed_frozen_compressed_disables_raw_early_lookahead():\n    refresh = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_refresh_prefill_raw_lookahead_policy\",\n    )\n    policy_cls, _ = _policy_class((refresh,))\n    loader = policy_cls()\n    loader._cudagraph_ceiling = 512\n    loader._alt_max_chunk_for = lambda backend: 1330\n    loader.frozen_split_info = [{\"qkv\": _info(\"p4flat\")}]\n    loader.frozen_comp_buffers = [None, {\"o\": object()}]\n\n    loader._refresh_prefill_raw_lookahead_policy()\n\n    assert loader._prefill_raw_lookahead_split_cells == 1\n    assert loader._prefill_raw_lookahead_frozen_comp_cells == 1\n    assert loader._prefill_raw_lookahead_min_tokens is None\n\n\ndef test_prefill_alt_h2d_and_staging_reuse_event_order():\n    materialize = _class_method(\n        FROZEN_SOURCE,\n        \"FrozenSplitMixin\",\n        \"_materialize_frozen_split_prefill_alt\",\n    )\n    trace = []\n    current = [None]\n\n    class FakeStream:\n        def __init__(self, name):\n            self.name = name\n\n        def wait_event(self, event):\n            trace.append((\"wait\", self.name, event.name))\n\n    class FakeEvent:\n        def __init__(self, name):\n            self.name = name\n\n        def record(self, stream=None):\n            trace.append((\"record\", self.name, stream.name))\n\n    class FakeStreamCtx:\n\"\"\"End-to-end test for P4FlatCPUKVCompressor (GPU required).\n\nAuthoritative check: CPU encode (worker threads, from host raw KV) ->\nreal GPU decode kernel -> bit-exact.  Exercises the cpu_after_raw_swap\nproducer entry compress_batch_async_from_host + wait_compress_async +\ndecompress_batch + free_persistent_block.\n\"\"\"\nfrom types import SimpleNamespace\n\nimport pytest\nimport torch\n\nif not torch.cuda.is_available():\n    pytest.skip(\"CUDA is required\", allow_module_level=True)\n\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\n\n# Keep compressors alive for the module: destroying one (freeing its pinned\n# meta-ring) then building another in-process makes the next instance's\n# pinned .cuda(non_blocking=True) raise cudaErrorInvalidValue (a PyTorch\n# host-allocator artifact, not a codec bug; prod uses one lifelong instance).\n_LIVE_COMPRESSORS = []\n\n\ndef _roundtrip(comp, layer, ids, k_cache, v_cache, host_k, host_v, label):\n    k_cache.zero_()\n    v_cache.zero_()\n    comp.decompress_batch(layer, ids, (k_cache, v_cache))\n    torch.cuda.synchronize()\n    sel = torch.as_tensor(ids, device=k_cache.device)\n    # host_k/host_v are CPU tensors — index them with a CPU id tensor.\n    sel_cpu = torch.as_tensor(ids)\n    k_ref = host_k[sel_cpu].to(k_cache.device)\n    v_ref = host_v[sel_cpu].to(v_cache.device)\n    k_err = (k_cache[sel] - k_ref).abs().max().item()\n    v_err = (v_cache[sel] - v_ref).abs().max().item()\n    print(f\"{label:24s} k_err={k_err}, v_err={v_err}\")\n    assert k_err == 0 and v_err == 0, f\"{label}: bit-exact roundtrip expected\"\n\n\ndef test_p4flat_cpu_kv_roundtrip():\n    assert torch.cuda.is_available(), \"CUDA required\"\n\n    num_blocks = 16\n    block_size, num_heads, head_dim = 16, 8, 128   # block_numel = 16384\n    block_shape = (block_size, num_heads, head_dim)\n\n    # Raw secondary KV lives on pinned host memory (as in cpu_after_raw_swap).\n    host_k = torch.randn(num_blocks, *block_shape,\n                         dtype=torch.bfloat16).pin_memory()\n    host_v = torch.randn(num_blocks, *block_shape,\n                         dtype=torch.bfloat16).pin_memory()\n    k_cache = torch.zeros(num_blocks, *block_shape,\n                          dtype=torch.bfloat16, device=\"cuda\")\n    v_cache = torch.zeros_like(k_cache)\n\n    comp = P4FlatCPUKVCompressor(torch.cuda.Stream())\n    _LIVE_COMPRESSORS.append(comp)  # keep alive for module lifetime (see note)\n    comp.warmup_kv_buffers(\n        block_shape=block_shape, max_n_blocks=num_blocks, n_layers=2,\n        max_gpu_blocks=num_blocks, max_gpu_decomp_blocks=num_blocks)\n\n    ids = list(range(num_blocks))\n    # wait_event_handle=0 -> no event to wait on (host data already present).\n    comp.compress_batch_async_from_host(0, ids, host_k, host_v, 0)\n    comp.wait_compress_async(0, block_shape)\n    assert comp.has_persistent_compressed_kv(0, ids)\n    _roundtrip(comp, 0, ids, k_cache, v_cache, host_k, host_v,\n               \"cpu->gpu roundtrip\")\n\n    # free is metadata-only (free-list): slot released, NO swap-with-last,\n    # hwm (_kv_active_count) unchanged, freed slot goes to the free-list.\n    comp.free_persistent_block(0, 0)\n    assert int(comp._kv_slot[0][0].item()) == -1\n    assert int(comp._kv_slot[0][num_blocks - 1].item()) == num_blocks - 1\n    assert comp._kv_active_count[0] == num_blocks\n    assert 0 in comp._kv_free_slots[0]\n    _roundtrip(comp, 0, list(range(1, num_blocks)), k_cache, v_cache,\n               host_k, host_v, \"post-free roundtrip\")\n\n    # second layer, out-of-order subset\n    subset = [9, 1, 14, 0, 6]\n    comp.compress_batch_async_from_host(1, subset, host_k, host_v, 0)\n    comp.wait_compress_async(1, block_shape)\n    _roundtrip(comp, 1, subset, k_cache, v_cache, host_k, host_v,\n               \"subset roundtrip\")\n\n    comp.stop_kv_compress_workers()\n    print(\"ALL PASS\")\n\n\ndef test_p4flat_tight_stride_secondary_fallback(monkeypatch):\n    \"\"\"A blob larger than a tight row falls back to raw secondary KV.\n\n    The production cpu_after_raw_swap path intentionally retains raw host KV.\n    High-exception P4Flat blocks that fit neither compressed nor raw in the\n    25,600-byte row must publish ``is_raw=2`` instead of throwing or writing\n    into the next row.  Decode then restores those blocks from secondary while\n    normal low-exception blocks continue through the compressed GPU kernel.\n    \"\"\"\n    assert torch.cuda.is_available(), \"CUDA required\"\n    monkeypatch.delenv(\"TIERED_SERVE_KV_BLOB_STRIDE\", raising=False)\n    monkeypatch.delenv(\"TIERED_SERVE_KV_BLOB_SLACK\", raising=False)\n\n    num_blocks = 8\n    block_shape = (16, 8, 128)\n    # Random BF16 bit patterns have enough exponent exceptions to overflow the\n    # tight row.  Keep block 0 all-zero so the same batch also exercises the\n    # ordinary compressed path.\n    k_bits = torch.randint(\n        0, 65536, (num_blocks, *block_shape), dtype=torch.int32).to(\n            torch.uint16)\n    v_bits = torch.randint(\n        0, 65536, (num_blocks, *block_shape), dtype=torch.int32).to(\n            torch.uint16)\n    k_bits[0].zero_()\n    v_bits[0].zero_()\n    host_k = k_bits.view(torch.bfloat16).pin_memory()\n    host_v = v_bits.view(torch.bfloat16).pin_memory()\n    k_cache = torch.zeros(\n        num_blocks, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n    v_cache = torch.zeros_like(k_cache)\n\n    comp = P4FlatCPUKVCompressor(torch.cuda.Stream())\n    _LIVE_COMPRESSORS.append(comp)\n    comp.warmup_kv_buffers(\n        block_shape=block_shape, max_n_blocks=num_blocks, n_layers=1,\n        max_gpu_blocks=num_blocks, max_gpu_decomp_blocks=num_blocks)\n    assert comp._blob_stride == 25600\n\n    old_caches = DualMemoryLoader.kv_caches\n    DualMemoryLoader.kv_caches = [\n        SimpleNamespace(secondary_kv=(host_k, host_v))]\n    try:\n        ids = list(range(num_blocks))\n        comp.compress_batch_async_from_host(0, ids, host_k, host_v, 0)\n        comp.wait_compress_async(0, block_shape)\n        assert comp.has_persistent_compressed_kv(0, ids)\n\n        slots = comp._kv_slot_np[0][ids]\n        pools = comp._host_pools[0]\n        k_raw = pools[\"k\"][\"is_raw\"].numpy()[slots]\n        v_raw = pools[\"v\"][\"is_raw\"].numpy()[slots]\n        assert (k_raw == 0).any() and (v_raw == 0).any()\n        assert ((k_raw >= 2) | (v_raw >= 2)).any()\n        assert comp._secondary_fallback_possible[0]\n\n        comp.decompress_batch(0, ids, (k_cache, v_cache))\n        torch.cuda.synchronize()\n        assert torch.equal(\n            k_cache.cpu().view(torch.uint16), host_k.view(torch.uint16))\n        assert torch.equal(\n            v_cache.cpu().view(torch.uint16), host_v.view(torch.uint16))\n    finally:\n        DualMemoryLoader.kv_caches = old_caches\n        comp.stop_kv_compress_workers()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03cc0-7d0d-7050-b140-c5e8ee1dc8c0","create_time":1787725653.0861025}}}
