{"timestamp":"2026-08-26T06:25:44.252Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03cbe-fb3c-7b70-a518-94b0239e6bc7","call_id":"call_mYGLlL0S0LP5nfuppJherWyA","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Auto dtype-dispatching weight compressor.\n\nDispatches compress / decompress / fused_mm to the BF16 or FP8 sub-\ncompressor of the chosen family based on the tensor dtype at call\ntime, so the dual-memory loader can hold a uniformly-typed\n``weight_compressor`` regardless of which dtype variant the user\nselected.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.compression.core.dietgpu import DietGPUCompressor\nfrom tiered_serve.compression.core.dietgpu_fp8 import (\n    DietGPUFP8Compressor,\n    CompressedDietGPUFP8Tensor,\n    _fp8_kind_of,\n)\nfrom tiered_serve.compression.core.zipserv_fp8 import (\n    ZipServFP8GpuCompressor,\n    CompressedZipServFP8GpuTensor,\n)\n\nlogger = logging.getLogger(\"vllm\")\n\n\nclass _AutoWeightCompressor(TensorCompressor):\n    \"\"\"Dispatches compress/decompress to a BF16 or FP8 backend based on\n    the tensor dtype at call time.\n\n    Inherits :class:`TensorCompressor` so :class:`DualMemoryLoader` sees a\n    uniformly-typed ``weight_compressor`` regardless of whether the user\n    pinned a specific dtype variant or chose the auto family.\n\n    Used when ``TIERED_SERVE_WEIGHT_COMP_BACKEND`` is ``\"zipserv\"`` or\n    ``\"dietgpu\"`` (no ``_bf16`` / ``_fp8`` suffix): the backend family\n    is fixed, but whether we use the BF16 or FP8 variant is decided on\n    the fly.  Both BF16 and FP8 sub-compressors share the same CUDA\n    stream and are instantiated lazily so unused paths allocate nothing.\n    \"\"\"\n\n    # The fused decompress+GEMM path (``--fused-mm``) is a BF16 feature;\n    # both supported families' BF16 backends (ZipServ / DietGPU) implement\n    # it.  Expose the capability so DualMemoryLoader's frozen_split /\n    # frozen_compressed install loops (which gate on ``HAS_FUSED_MM`` of the\n    # *wrapper*, not the lazily-built sub-compressor) don't skip every layer.\n    # ``build_split_shell`` delegates to the BF16 backend and raises\n    # NotImplementedError if that backend ever lacks fused support — the\n    # install loop catches it and falls back to the dense decompress path.\n    HAS_FUSED_MM = True\n\n    def __init__(self, family: str, comp_stream: torch.cuda.Stream,\n                 dietgpu_workspace_bytes: Optional[int] = None):\n        if family not in (\"zipserv\", \"dietgpu\"):\n            raise ValueError(f\"Unknown weight comp family: {family}\")\n        super().__init__(comp_stream=comp_stream)\n        self.family = family\n        self.comp_stream = comp_stream\n        # Forwarded to the DietGPU sub-compressor on instantiation; ignored\n        # by the ZipServ family.  ``None`` defers to the env-var / module\n        # default sizing in ``_dietgpu_workspace_bytes``.\n        self._dietgpu_workspace_bytes = dietgpu_workspace_bytes\n        self._bf16_impl: Optional[object] = None\n        self._fp8_impl: Optional[object] = None\n\n    # ----- lazy sub-compressor accessors -----\n\n    def _bf16(self):\n        if self._bf16_impl is None:\n            if self.family == \"zipserv\":\n                # Lazy import to avoid the ZipServ module load when the\n                # caller only ever touches the FP8 path.  ZipServ is still\n                # in tensor_compressor.py until its dedicated extraction\n                # phase lands.\n                from tiered_serve.tensor_compressor import ZipServCompressor\n                self._bf16_impl = ZipServCompressor(self.comp_stream)\n            else:\n                self._bf16_impl = DietGPUCompressor(\n                    self.comp_stream,\n                    workspace_bytes=self._dietgpu_workspace_bytes)\n            logger.info(\n                \"AutoWeightCompressor: instantiated BF16 backend \"\n                f\"({self.family})\")\n        return self._bf16_impl\n\n    def _fp8(self):\n        if self._fp8_impl is None:\n            if self.family == \"zipserv\":\n                # Native GPU FP8 e4m3 path (no CPU fallback — the legacy\n                # reference impl has been removed in favour of the in-tree\n                # zipserv_fp8_ext extension).\n                self._fp8_impl = ZipServFP8GpuCompressor(self.comp_stream)\n            else:\n                self._fp8_impl = DietGPUFP8Compressor(\n                    self.comp_stream,\n                    workspace_bytes=self._dietgpu_workspace_bytes)\n            logger.info(\n                \"AutoWeightCompressor: instantiated FP8 backend \"\n                f\"({self.family}_fp8)\")\n        return self._fp8_impl\n\n    # ----- dispatch -----\n\n    def _pick_for_dtype(self, dtype):\n        if _fp8_kind_of(dtype) is not None:\n            return self._fp8()\n        if dtype == torch.bfloat16:\n            return self._bf16()\n        raise TypeError(\n            f\"AutoWeightCompressor: unsupported dtype {dtype}; expected \"\n            \"bfloat16 or float8_e4m3fn/float8_e5m2\")\n\n    def compress(self, weight, *args, **kwargs):\n        return self._pick_for_dtype(weight.dtype).compress(\n            weight, *args, **kwargs)\n\n    def decompress(self, comp, *args, **kwargs):\n        # Pick backend from the compressed-tensor class so this works\n        # after a round-trip through disk/pool.\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            return self._fp8().decompress(comp, *args, **kwargs)\n        return self._bf16().decompress(comp, *args, **kwargs)\n\n    def compress_batch(self, weights, *args, **kwargs):\n        # Loop fallback: per-tensor dispatch handles mixed dtypes.\n        return [self.compress(w, *args, **kwargs) for w in weights]\n\n    def decompress_batch(self, comps, outputs=None):\n        outs = outputs or [None] * len(comps)\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\n\n    def fused_mm(self, comp, *args, **kwargs):\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"fused_mm is only implemented for BF16 compressors\")\n        return self._bf16().fused_mm(comp, *args, **kwargs)\n\n    def linear_apply(self, comp, x, *args, **kwargs):\n        # Hot path under ``--fused-mm`` (see graph_wait_ops._fused_linear_apply\n        # _impl).  frozen_split shells are BF16; FP8 has no fused path.\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"linear_apply (fused) is only implemented for BF16 compressors\")\n        return self._bf16().linear_apply(comp, x, *args, **kwargs)\n\n    def build_split_shell(self, info, staging_dict):\n        # frozen_split fused-MM install: delegate to the BF16 backend (the\n        # split codec compresses BF16 sign+mantissa).  Raises\n        # NotImplementedError if the backend lacks fused support; the\n        # DualMemoryLoader install loop catches it and skips the override.\n        return self._bf16().build_split_shell(info, staging_dict)\n\n    def build_offload_shell(self, comped, output_tensor=None):\n        # offload_compressed fused-MM install: delegate to the BF16 backend.\n        # AttributeError (backend lacks it) / NotImplementedError are caught by\n        # the install loop, which then leaves the cell on the dense path.\n        return self._bf16().build_offload_shell(comped, output_tensor)\n\n    # ----- workspace management -----\n\n    def shrink_workspace_for_