                kv_comp_producer != \"cpu_after_raw_swap\":\n   668\t                logger.warning(\n   669\t                    \"%s is CPU-encode only; ignoring \"\n   670\t                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n   671\t                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n   672\t                kv_comp_producer = \"cpu_after_raw_swap\"\n   673\t            if (kv_comp_producer == \"cpu_after_raw_swap\"\n   674\t                    and kv_comp_backend not in\n   675\t                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n   676\t                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n   677\t                raise ValueError(\n   678\t                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n   679\t                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n   680\t                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n   681\t                    f\"(backend \"\n   682\t                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n   683\t            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n   684\t\n   685\t            # ── Backend instantiation (p4flat's encode side depends on the\n   686\t            #    producer mode resolved above) ──\n   687\t            if kv_comp_backend == \"dietgpu\":\n   688\t                from tiered_serve.dietgpu_kv_compressor import (\n   689\t                    DietGPUKVCompressor,\n   690\t                )\n   691\t                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n   692\t                logger.info(\"KV compressor: DietGPU\")\n   693\t            elif kv_comp_backend == \"mantexp\":\n   694\t                # Mantissa/Exponent split: sm stays in HBM, exp is\n   695\t                # ANS-compressed and persisted in LPDDR (see\n   696\t                # tiered_serve/mantexp_kv_compressor.py).\n   697\