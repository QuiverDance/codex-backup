yer_id, filtered[start:start + capacity],\n   549\t                k_cache, v_cache)\n   550\t\n   551\t    def _build_decode_plan(self, layer_id: int,\n   552\t                           block_ids: np.ndarray,\n   553\t                           k_cache: torch.Tensor) -> Dict[str, Any]:\n   554\t        n = len(block_ids)\n   555\t        hwm = self._kv_active_count[layer_id]\n   556\t        slot_table = self._kv_slot_np[layer_id]\n   557\t        slots_np = np.ascontiguousarray(\n   558\t            slot_table[block_ids], dtype=np.int32)\n   559\t        if bool((slots_np < 0).any()):\n   560\t            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n   561\t            raise RuntimeError(\n   562\t                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n   563\t                f\"block={missing}\")\n   564\t\n   565\t        # The production steady state is dense: all active physical slots are\n   566\t        # requested.  Skip Python list conversion and run construction there.\n   567\t        dense = n == hwm and not self._kv_free_slots.get(layer_id)\n   568\t        slot_runs = None\n   569\t        if dense:\n   570\t            packed_h2d = False\n   571\t        else:\n   572\t            slot_runs = list(self._slot_runs(slots_np.tolist()))\n   573\t            max_runs = max(0, int(os.getenv(\n   574\t                \"TIERED_SERVE_KV_CD3_PACKED_H2D_MAX_RUNS\", \"8\")))\n   575\t            packed_h2d = (\n   576\t                (n < hwm and max_runs > 0 and len(slot_runs) <= max_runs)\n   577\t                or hwm > self._max_gpu_decomp_blocks + 1)\n   578\t\n   579\t        slots_gpu = (\n   580\t            self._identity_slots_gpu[:n]\n   581\t            if packed_h2d else torch.as_tensor(\n   582\t                slots_np, dtype=torch.int32, device=k_cache.device))\n   583\t        block_ids_gpu = torch.as_tensor(\n   584\t            block_ids, dtype=torch.long, device=k_cache.device)\n   585\t        copy_destination