\t                copy_sources.append(host_blob[:hwm])\n   599\t        storage_rows = n if packed_h2d else hwm\n   600\t        return {\n   601\t            \"block_ids\": block_ids,\n   602\t            \"generation\": self._decode_generation.get(layer_id, 0),\n   603\t            \"slots_gpu\": slots_gpu,\n   604\t            \"block_ids_gpu\": block_ids_gpu,\n   605\t            \"copy_destinations\": copy_destinations,\n   606\t            \"copy_sources\": copy_sources,\n   607\t            \"storage_rows\": storage_rows,\n   608\t        }\n   609\t\n   610\t    def _decompress_blocks(self, layer_id: int, block_ids,\n   611\t                           k_cache: torch.Tensor,\n   612\t                           v_cache: torch.Tensor) -> None:\n   613\t        n = len(block_ids)\n   614\t        if n == 0:\n   615\t            return\n   616\t        if n > self._max_gpu_decomp_blocks:\n   617\t            raise RuntimeError(\n   618\t                f\"ChunkDelta3 KV decode batch {n} exceeds \"\n   619\t                f\"capacity {self._max_gpu_decomp_blocks}\")\n   620\t        if self._kv_active_count[layer_id] <= 0:\n   621\t            return\n   622\t        if not isinstance(block_ids, np.ndarray):\n   623\t            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\n   624\t        plan = self._decode_plans.get(layer_id)\n   625\t        generation = self._decode_generation.get(layer_id, 0)\n   626\t        with torch.cuda.stream(self.batch_decomp_stream):\n   627\t            if (plan is None or plan[\"block_ids\"] is not block_ids\n   628\t                    or plan[\"generation\"] != generation):\n   629\t                plan = self._build_decode_plan(\n   630\t                    layer_id, block_ids, k_cache)\n   631\t                self._decode_plans[layer_id] = plan\n   632\t            self._batch_h2d(\n   633\t                plan[\"copy_destinations\"], plan[\"copy_sources\"])\n   634\t            storage_rows = plan[\"storage_ro