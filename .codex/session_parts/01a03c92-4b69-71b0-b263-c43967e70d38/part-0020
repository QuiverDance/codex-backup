u_direct compress runs 3 device kernels\n   635\t            # (compress_lean) on comp_stream.  When weight compression is also\n   636\t            # active, those kernels contend with weight-decompress + fused-mm\n   637\t            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n   638\t            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n   639\t            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n   640\t            # default p4flat to the CPU encoder whenever weight comp is on (the\n   641\t            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n   642\t            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n   643\t            # where the GPU has spare SMs and the two paths are on par\n   644\t            # (180 vs 176 ms).  An explicit env value below still overrides.\n   645\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   646\t                                   \"ublb_flat\", \"ublb_tbe\"):\n   647\t                _default_producer = \"cpu_after_raw_swap\"\n   648\t            elif kv_comp_backend == \"chunk_delta3\":\n   649\t                # CD3 GPU encode contends directly with fused weight decode/MM\n   650\t                # once KV offload begins.  The host encoder consumes the raw\n   651\t                # secondary copy asynchronously and is the serving default.\n   652\t                _default_producer = \"cpu_after_raw_swap\"\n   653\t            elif (kv_comp_backend == \"p4flat\"\n   654\t                    and DualMemoryLoader.use_weight_comp):\n   655\t                _default_producer = \"cpu_after_raw_swap\"\n   656\t            else:\n   657\t                _default_producer = \"gpu_direct\"\n   658\t            kv_comp_producer = os.getenv(\n   659\t                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n   660\t            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n   661\t                raise ValueError(\n   662\t                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n   663\t                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n   664\t                    f\"'cpu_after_raw_swap'.\")\n   665\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   666\t                                   \"ublb_flat\", \"ublb_tbe\") and \\\n   667\t                    kv_comp_producer != \"cpu_after_raw_swap\":\n   668\t                logger.warning(\n   669\t                    \"%s is CPU-encode only; ignoring \"\n   670\t                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n   671\t                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n   672\t                kv_comp_producer = \"cpu_after_raw_swap\"\n   673\t            if (kv_comp_producer == \"cpu_after_raw_swap\"\n   674\t                    and kv_comp_backend not in\n   675\t                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n   676\t                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n   677\t                raise ValueError(\n   678\t                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n   679\t                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n   680\t                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n   681\t                    f\"(backend \"\n   682\t                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n   683\t            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n   684\t\n   685\t            # ── Backend instantiation (p4flat's encode side depends on the\n   686\t            #    producer mode resolved above) ──\n   687\t            if kv_comp_backend == \"dietgpu\":\n   688\t                from tiered_serve.dietgpu_kv_compressor import (\n   689\t                    DietGPUKVCompressor,\n   690\t                )\n   691\t                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n   692\t                logger.info(\"KV compressor: DietGPU\")\n   693\t            elif kv_comp_backend == \"mantexp\":\n   694\t                # Mantissa/Exponent split: sm stays in HBM, exp is\n   695\t                # ANS-compressed and persisted in LPDDR (see\n   696\t                # tiered_serve/mantexp_kv_compressor.py).\n   697\t                if not self.mantexp_split_kv:\n   698\t                    logger.warning(\n   699\t                        \"KV backend 'mantexp' selected without \"\n   700\t                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n   701\t                from tiered_serve.mantexp_kv_compressor import (\n   702\t                    MantExpKVCompressor,\n   703\t                )\n   704\t                self.kv_compressor = MantExpKVCompressor(\n   705\t                    self.decomp_kv_stream)\n   706\t                logger.info(\"KV compressor: MantExp (split storage)\")\n   707\t            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n   708\t                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n   709\t                # backends share the same GPU decode kernel and storage layout:\n   710\t                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n   711\t                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n   712\t                #                         host_encode_blocks)\n   713\t                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n   714\t                # follows the producer mode (defaults to gpu_direct).\n   715\t                # See tiered_serve/p4flat_kv_compressor.py.\n   716\t                from tiered_serve.p4flat_kv_compressor import (\n   717\t                    P4FlatCPUKVCompressor,\n   718\t                    P4FlatKVCompressor,\n   719\t                )\n   720\t                if (kv_comp_backend == \"p4flatcpu\"\n   721\t                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n   722\t                    self.kv_compressor = P4FlatCPUKVCompressor(\n   723\t                        self.decomp_kv_stream)\n   724\t                    logger.info(\n   725\t                        \"KV compressor: P4Flat (CPU encode, \"\n   726\t                        \"C++ OpenMP host_encode_blocks)\")\n   727\t                else:\n   728\t                    self.kv_compressor = P4FlatKVCompressor(\n   729\t                        self.decomp_kv_stream)\n   730\t                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n   731\t                # One-stream KV decode: point batch_decomp_stream straight at the\n   732\t                # compute stream (exec_stream) so the decode serializes with the\n   733\t                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n   734\t                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n   735\t                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n   736\t                    logger.info(\n   737\t                        \"[kv-decode] on compute stream (exec_stream)\")\n   738\t            elif kv_comp_backend == \"chunk_delta3\":\n   739\t                from tiered_serve.chunk_delta3_kv_compressor import (\n   740\t                    ChunkDelta3CPUKVCompressor,\n   741\t                    ChunkDelta3KVCompressor,\n   742\t                )\n   743\t                if kv_comp_producer == \"cpu_after_raw_swap\":\n   744\t                    self.kv_compressor = ChunkDelta3CPUKVCompressor(\n   745\t                        self.decomp_kv_stream)\n   746\t                    logger.info(\n   747\t                        \"KV compressor: ChunkDelta3 (CPU OpenMP encode, \"\n   748\t                        \"batched GPU decode)\")\n   749\t                else:\n   750\t                    self.kv_compressor = ChunkDelta3KVCompressor(\n   751\t                        self.decomp_kv_stream)\n   752\t                    logger.info(\n   753\t                        \"KV compressor: ChunkDelta3 \"\n   754\t                        \"(batched GPU encode/decode)\")\n   755\t            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n   756\t                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n   757\t                # backends share the same GPU decode kernel and storage layout:\n   758\t                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n   759\t                #                         nvcomp_bitcomp_compress_batch)\n   760\t                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n   761\t                #                         compress, bitcompHostCompressLossless)\n   762\t                # ``bitcompcpu`` always selects the CPU encoder; bare\n   763\t                # ``bitcomp`` follows the producer mode (defaults to gpu_direct).\n   764\t                from tiered_serve.bitcomp_kv_compressor import (\n   765\t                    BitcompCPUKVCompressor,\n   766\t                    BitcompKVCompressor,\n   767\t                )\n   768\t                if (kv_comp_backend == \"bitcompcpu\"\n   769\t                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n   770\t                    self.kv_compressor = BitcompCPUKVCompressor(\n    60\t        Eagerly prime BF16 here so both workspaces are allocated up\n    61\t        front while HBM is still clean.  Today's targeted models\n    62\t        (Qwen/Llama bf16) always hit the BF16 path; FP8 stays lazy.\n    63\t\n    64\t        DietGPU workspaces are auto-sized from the largest model tensor\n    65\t        so users don't need to set ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB``\n    66\t        per model (the env var, if set, still wins).\n    67\t        \"\"\"\n    68\t        stream = self.decomp_weight_stream\n    69\t        auto_ws = self._auto_dietgpu_workspace_bytes()\n    70\t        if backend in (\"zipserv\", \"dietgpu\"):\n    71\t            comp = _AutoWeightCompressor(\n    72\t                family=backend, comp_stream=stream,\n    73\t                dietgpu_workspace_bytes=auto_ws)\n    74\t            comp._bf16()\n    75\t            logger.info(\n    76\t                \"Weight compressor [%s]: %s (auto BF16/FP8, BF16 primed%s)\",\n    77\t                role, backend,\n    78\t                \"\" if auto_ws is None\n    79\t                else f\", DietGPU ws={auto_ws / (1 << 20):.0f} MiB\")\n    80\t        elif backend == \"zipserv_bf16\":\n    81\t            comp = ZipServCompressor(stream)\n    82\t            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n    83\t        elif backend == \"dietgpu_bf16\":\n    84\t            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n    85\t            logger.info(\n    86\t                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n    87\t                \"\" if auto_ws is None\n    88\t                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n    89\t        elif backend == \"dietgpu_fp8\":\n    90\t            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n    91\t            logger.info(\n    92\t                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n    93\t                \"\" if auto_ws is None\n    94\t                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n    95\t        elif backend == \"zipserv_fp8\":\n    96\t            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n    97\t            # (forked from LLM-bitfield-compressor, built in-tree). No\n    98\t            # CPU fallback — the legacy reference impl was removed.\n    99\t            comp = ZipServFP8GpuCompressor(stream)\n   100\t            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n   101\t        elif backend == \"p4flat\":\n   102\t            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n   103\t            # patch fused MM); sources copied from LLM-bitfield-compressor,\n   104\t            # built via cpp_exts.zipserv_p4flat_ext.\n   105\t            from tiered_serve.tensor_compressor import P4FlatCompressor\n   106\t            comp = P4FlatCompressor(stream)\n   107\t            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n   108\t        elif backend == \"chunk_delta3\":\n   109\t            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n   110\t            comp = ChunkDelta3Compressor(stream)\n   111\t            logger.info(\n   112\t                \"Weight compressor [%s]: BF16 ChunkDelta3 \"\n   113\t                \"(CPU encode, GPU decode/fused-MM)\", role)\n   114\t        elif backend == \"p4d16\":\n   115\t            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n   116\t            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n   117\t            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n   118\t            from tiered_serve.tensor_compressor import P4D16Compressor\n   119\t            comp = P4D16Compressor(stream)\n   120\t            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n   121\t        elif backend == \"p3flat_fp8\":\n   122\t            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n   123\t            # nibble); bit-exact reconstruction via per-tile exception\n   124\t            # substream + warp prefix-sum in decompress kernel.\n   125\t            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n   126\t            comp = P3FlatFP8Compressor(stream)\n   127\t            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n   128\t        elif backend == \"ublb_flat\":\n   129\t            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n   130\t            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n   131\t            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n   132\t            from tiered_serve.tensor_compressor import UBLBFlatCompressor\n   133\t            comp = UBLBFlatCompressor(stream)\n   134\t            logger.info(\"Weight compressor [%s]: UBLB-flat (BF16)\", role)\n   135\t        else:\n   136\t            raise ValueError(\n   137\t                f\"Unknown weight compressor backend ({role}): \"\n   138\t                f\"{backend!r}. Expected one of: \"\n   139\t                f\"zipserv, dietgpu, zipserv_bf16, dietgpu_bf16, \"\n   140\t                f\"zipserv_fp8, dietgpu_fp8, p4flat, p4d16, p3flat_fp8, \"\n   141\t                f\"ublb_flat, chunk_delta3.\")\n   142\t        self._configure_weight_compressor_runtime(comp)\n   143\t        return comp\n   144\t\n   145\t    def _configure_weight_compressor_runtime(self, comp):\n   146\t        \"\"\"Attach loader runtime constants to compressor objects.\"\"\"\n   147\t        if comp is None or not hasattr(self, \"_cudagraph_ceiling\"):\n   148\t            return\n   149\t        comp._cudagraph_ceiling = self._cudagraph_ceiling\n   150\t        bf16 = getattr(comp, \"_bf16_impl\", None)\n   151\t        if bf16 is not None:\n   152\t            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n   153\t\n   154\t    def _compressor_for_mode(self, mode: str):\n   155\t        \"\"\"Return the weight compressor instance for a given residency mode.\n   201\tclass ChunkDelta3Compressor(TensorCompressor):\n   202\t    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n   203\t\n   204\t    HAS_FUSED_MM = True\n   205\t    codec_name = \"chunk_delta3\"\n   206\t\n   207\t    # GH200/Llama-70B serving calibration covers the lossless Packed20x3\n   208\t    # kernels through N=128.  With concurrent weight H2D, all four projections\n   209\t    # win throughout N=65..128.  QKV wins on 7