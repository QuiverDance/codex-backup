ate = self._pending_compress.pop(layer_id, None)\n   470\t        if state is None:\n   471\t            return\n   472\t        state[\"event\"].synchronize()\n   473\t        block_ids = state[\"buffer_ids\"]\n   474\t        slots = state[\"physical_slots\"]\n   475\t        for kv in (\"k\", \"v\"):\n   476\t            counts = self._host_pools[layer_id][kv][\"num_exceptions\"]\n   477\t            for bid, slot in zip(block_ids, slots):\n   478\t                count = int(counts[slot].item())\n   479\t                if count > self._entry_capacity:\n   480\t                    raise RuntimeError(\n   481\t                        \"ChunkDelta3 KV exception capacity exceeded: \"\n   482\t                        f\"layer={layer_id} kv={kv} block={bid} \"\n   483\t                        f\"count={count} capacity={self._entry_capacity}; \"\n   484\t                        \"increase TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\")\n   485\t        valid = self._persistent_valid[layer_id]\n   486\t        for bid in block_ids:\n   487\t            valid[bid] = 1\n   488\t        self._invalidate_decode_plan(layer_id)\n   489\t        self._compressed_kv[layer_id] = {\n   490\t            \"buffer_ids\": list(block_ids),\n   491\t            \"block_shape\": block_shape,\n   492\t            \"n\": len(block_ids),\n   493\t        }\n   494\t\n   495\t    def decompress_batch(self, layer_id: int, active_block_ids: list,\n   496\t                         output_buffers) -> None:\n   497\t        \"\"\"Filter once per active-set object and reuse a native decode plan.\n   498\t\n   499\t        The loader passes the same active list object to every layer in one\n   500\t        step.  Identity caches its range filter across layers; a C-level\n   501\t        content comparison also reuses each layer's plan across steps whose\n   502\t        active set did not change.\n   503\t        \"\"\"\n   504\t        k_cache, v_cache = output_buffers\n   505\t        valid = self._persistent_valid.get(layer_id)\n   506\t        if valid is None or len(active_block_ids) == 0:\n   507\t            return\n   508\t        limit = min(k_cache.shape[0], len(valid))\n   509\t        if (self._decode_filter_active is not active_block_ids\n   510\t                or self._decode_filter_limit != limit):\n   511\t            candidates = (\n   512\t                active_block_ids\n   513\t                if isinstance(active_block_ids, np.ndarray)\n   514\t                else np.asarray(active_block_ids, dtype=np.int64))\n   515\t            candidates = candidates[\n   516\t                (candidates >= 0) & (candidates < limit)]\n   517\t            if candidates.size > 1 and bool(\n   518\t                    (candidates[1:] < candidates[:-1]).any()):\n   519\t                candidates = np.sort(candidates)\n   520\t            self._decode_filter_active = active_block_ids\n   540\t            return\n   541\t\n   542\t        capacity = self._max_gpu_decomp_blocks\n   543\t        if filtered.size <= capacity:\n   544\t            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n   545\t            return\n   546\t        for start in range(0, filtered.size, capacity):\n   547\t            self._decompress_blocks(\n   548\t                layer_id, filtered[start:start + capacity],\n   549\t                k_cache, v_cache)\n   550\t\n   551\t    def _build_decode_plan(self, layer_id: int,\n   552\t                           block_ids: np.ndarray,\n   553\t                           k_cache: torch.Tensor) -> Dict[str, Any]:\n   554\t        n = len(block_ids)\n   555\t        hwm = self._kv_active_count[layer_id]\n   556\t        slot_table = self._kv_slot_np[layer_id]\n   557\t        slots_np = np.ascontiguousarray(\n   558\t            slot_table[block_ids], dtype=np.int32)\n   559\t        if bool((slots_np < 0).any()):\n   560\t            missing = int(block_ids[np.flatnonzero(slots_np < 0)[0]])\n   561\t            raise Run