= {}\n   711\t        self._work_queue = queue.SimpleQueue()\n   712\t        self._work_states: Dict[int, Dict[str, Any]] = {}\n   713\t        # Grace serving usually produces only eight newly-full blocks per\n   714\t        # layer/step.  One large OpenMP team pays its startup cost 80 times in\n   715\t        # series; eight small teams instead pipeline independent layers across\n   716\t        # the same CPU budget.  Retain the established one-worker x86 default.\n   717\t        default_workers = \"8\" if os.uname().machine == \"aarch64\" else \"1\"\n   718\t        self._n_workers = max(1, int(os.getenv(\n   719\t            \"TIERED_SERVE_KV_COMPRESS_WORKERS\", default_workers)))\n   720\t        self._pin_workers = (\n   721\t            os.getenv(\"TIERED_SERVE_KV_COMPRESS_PIN\", \"1\") == \"1\")\n   722\t        self._reserve_cores = max(0, int(os.getenv(\n   723\t            \"TIERED_SERVE_KV_COMPRESS_RESERVE_CORES\", \"8\")))\n   724\t        compression_cpu_count = len([\n   725\t            cpu for cpu in os.sched_getaffinity(0)\n   726\t            if cpu >= self._reserve_cores])\n   727\t        default_omp_threads = str(max(\n   728\t            1, (compression_cpu_count + self._n_workers - 1)\n   729\t            // self._n_workers))\n   730\t        self._omp_thread_cap = max(1, int(os.getenv(\n   731\t            \"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\", default_omp_threads)\n   732\t            .split(\",\", 1)[0].strip()))\n   733\t        self._omp_lib = None\n   734\t        try:\n   735\t            self._omp_lib = ctypes.CDLL(\"libgomp.so.1\")\n   736\t        except OSError as error:\n   737\t            logger.warning(\n   738\t                \"CD3 CPU encode: libgomp unavailable (%s); using process \"\n   739\t                \"OpenMP defaults\", error)\n   740\t        self._pin_tls = threading.local()\n   741\t        self._pin_counter = 0\n   742\t        self._pin_lock = threading.Lock()\n   743\t        self._worker_affinities: Dict[int, tuple[int, ...]] = {}\n   744\t        self._worker_omp_threads: Dict[int, int] = {}\n   745\t        self._timing_raw_wait = 0.0\n   746\t        self._timing_decode_wait = 0.0\n   747\t        self._timing_encode = 0.0\n   748\t        self._timing_count = 0\n   749\t        self._workers = []\n   750\t        for index in range(self._n_workers):\n   751\t            worker = threading.Thread(\n   752\t                target=self._worker_loop, daemon=True,\n   753\t                name=f\"cd3-kv-cpu-{index}\")\n   754\t            worker.start()\n   755\t            self._workers.append(worker)\n   756\t        logger.info(\n   757\t            \"ChunkDelta3 CPU KV encoder: C++ OpenMP, workers=%d pin=%s \"\n   758\t            \"core_start=%d omp_cap=%d\",\n   759\t            self._n_workers, self._pin_workers,\n   760\t            self._reserve_cores, self._omp_thread_cap)\n   761\t\n   762\t    def init_kv_compress_workers(self, n_workers: int, max_blocks: int,\n   763\t                                 n_layers: int) -> None:\n   764\t        del n_workers, max_blocks, n_layers\n   765\t        if not self._kv_pools_ready:\n   766\t            raise RuntimeError(\n   767\t                \"init_kv_compress_workers requires warmup_kv_buffers first\")\n   768\t\n   769\t    def _worker_loop(self) -> None:\n   770\t        while True:\n   771\t            item = self._work_queue.get()\n   772\t            if item is None:\n   773\t                return\n   774\t            state, arguments = item\n   775\t            try:\n   776\t                self._encode_chunk(*arguments)\n   777\t                state[\"error\"] = None\n   778\t            except BaseException as error:\n   779\t                state[\"error\"] = error\n   780\t            finally:\n   820\t                self._n_workers * self._omp_thread_cap)]\n   821\t            begin = len(usable) * index // self._n_workers\n   822\t            end = len(usable) * (index + 1) // self._n_work