f test_serving_fused_threshold_override(monkeypatch) -> None:\n    32\t    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"64\")\n    33\t    codec = _codec()\n    34\t    assert codec._fused_max_n_for(10240, 8192) == 64\n    35\t\n    36\t\n    37\tdef test_projection_fused_threshold_override_takes_precedence(monkeypatch) -> None:\n    38\t    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"128\")\n    39\t    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N_QKV\", \"64\")\n    40\t    codec = _codec()\n    41\t    assert codec._fused_max_n_for(10240, 8192) == 64\n    42\t    assert codec._fused_max_n_for(8192, 8192) == 128\n    43\t    assert codec._fused_max_n_for(57344, 8192) == 128\n    44\t    assert codec._fused_max_n_for(8192, 28672) == 128\n    45\t\n    46\t\n    47\tdef test_split_shell_narrows_shared_staging_capacity() -> None:\n    48\t    from tiered_serve.compression.core.base import SplitStorageInfo\n    49\t\n    50\t    codec = _codec()\n    51\t    generator = torch.Generator(device=\"cuda\").manual_seed(29)\n    52\t    weight = torch.randn(\n    53\t        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    54\t    ).to(torch.bfloat16)\n    55\t    compressed = codec.compress(weight)\n    56\t    lpddr = {\n    57\t        attr: getattr(compressed, attr)\n    58\t        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n    59\t    }\n    60\t    info = SplitStorageInfo(\n    61\t        compressed.sign_mantissa,\n    62\t        lpddr,\n    63\t        {\n    64\t            \"M\": compressed.M,\n    65\t            \"K\": compressed.K,\n    66\t            \"num_exceptions\": compressed.num_exceptions,\n    67\t        },\n    68\t        backend=\"chunk_delta3\",\n    69\t        hbm_buffers={\n    70\t            \"tile_exception_offsets\": compressed.tile_exception_offsets,\n    71\t        },\n    72\t    )\n    73\t    staging = {}\n    74\t    for attr, source in lpddr.items():\n    75\t        