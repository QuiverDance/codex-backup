     \"sign+mantissa / compressed-exponent split \"\n   225\t                             \"backend (equivalent to --mantexp-split-kv). \"\n   226\t                             \"'p4flat' selects the BF16 P4-flat per-tile \"\n   227\t                             \"exponent-palette codec (GPU encode by default). \"\n   228\t                             \"'p4flatcpu' is the same codec with the C++ \"\n   229\t                             \"OpenMP CPU host encoder (cpu_after_raw_swap). \"\n   230\t                             \"'ublb_flat'/'ublb_tbe' are the UB/LB-split codecs \"\n   231\t                             \"(P4Flat-based, CPU encode + GPU batched decode): \"\n   232\t                             \"ublb_flat = fastest enc+dec (ratio 1.33), \"\n   233\t                             \"ublb_tbe = best ratio ~1.38.\")\n   234\t    parser.add_argument(\"--collect-time\",\n   235\t                        action=\"store_true\",\n   392\t    # prior run with different flags would be silently reused → wrong weights /\n   393\t    # IMA.  Force a fresh compile every run (skips both cache load and save).\n   394\t    os.environ[\"VLLM_DISABLE_COMPILE_CACHE\"] = \"1\"\n   395\t    os.environ[\"TIERED_SERVE_ATS_DECOMP_FROZEN\"] = (\n   396\t        \"1\" if args.ats_decomp_frozen else \"0\")\n   397\t    os.environ[\"TIERED_SERVE_ATS_DECOMP_OFFLOAD\"] = (\n   398\t        \"1\" if args.ats_decomp_offload else \"0\")\n   399\t    os.environ[\"TIERED_SERVE_USE_KV_COMP\"] = \"1\" if args.kv_comp else \"0\"\n   400\t    if args.kv_comp:\n   401\t        os.environ[\"TIERED_SERVE_KV_COMP_BACKEND\"] = args.kv_comp\n   402\t        # Keep an offloadable block's partial tail in a request-private HBM\n   403\t        # slot and publish/compress it only after all 16 tokens are written.\n   404\t        # Cache the choice before model/KV allocation; the serving hot path\n   405\t        # never reads this environment variable.  Set it to 0 for a legacy\n   406\t        # same-code A/B run.\n   407\t        if args.kv_comp in (\"p4flat\", \"p4flatcpu\", \"chunk_delta3\"):\n   408\t            os.environ.setdefault(\n   409\t                \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"1\")\n   410\t        if args.kv_comp == \"zipserv\":\n   411\t            # ``--kv-comp zipserv`` is an explicit request for the accelerated\n   412\t            # host encoder.  Overwrite a stale inherited producer setting so\n   413\t            # serving always runs raw D2H -> C++ CPU worker compression.\n   414\t            os.environ[\"TIERED_SERVE_KV_COMP_PRODUCER\"] = \\\n   415\t                \"cpu_after_raw_swap\"\n   416\t        # P4Flat/UBLB own the tight 25,600-byte default and their encoders\n   417\t        # publish is_raw=2 for an over-stride block.  An explicit\n   418\t        # TIERED_SERVE_KV_BLOB_STRIDE (0 selects raw-safe) still overrides it.\n   419\t\n   420\t    os.environ[\"TIERED_SERVE_COLLECT_TIME\"] = \"1\" if args.collect_time else \"0\"\n   470\t    if args.fused_mm:\n   471\t        logger.info(\"##### Using Fused MM\")\n   472\t    if args.prefill_alt_comp is not None:\n   473\t        logger.info(\n   474\t            \"##### Phase-adaptive prefill-alt codec = %s (decode keeps %s)%s\",\n   475\t            args.prefill_alt_comp,\n   476\t            args.split_compressor or args.weight_comp or \"zipserv\",\n   477\t            f\"; max-chunk={args.prefill_alt_max_chunk}\"\n   478\t            if args.prefill_alt_max_chunk else \"\")\n   479\t    if args.kv_comp:\n   480\t        logger.info(\n   481\t            \"##### Using KV Compression (backend=%s, producer=%s)\",\n   482\t            args.kv_comp,\n   483\t            os.environ.get(\"TIERED_SERVE_KV_COMP_PRODUCER\",\n   484\t                           \"backend-default\"))\n   485\t        if os.environ.get(\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\":\n   486\t            logger.info(\n   487\t                \"##### KV full-block-only enabled \"\n   488\t                \"(partial tails stay in HBM)\")\n    54\t    CONFIGS=(\"flexgen\" \"flexgen-comp\" \"cao-zs\" \"cao-zs-fused\" \\\n    55\t             \"cao-p4\" \"cao-p4-fused\" \"cao-p4-kvcomp\" \"cao-zs-kvcomp\")\n    56\tfi\n    57\t\n    58\t# config별 서버 플래그 (weight-comp 백엔드 / --fused-mm / --kv-comp 조합).\n    59\t# --weight-comp 백엔드는 config YAML 안에 박힌 per-layer compressor 와 일치해야 한다\n    60\t#   cao-zs* → zipserv, cao-p4* → p4flat (cao-*-kvcomp 도 동일 규칙).\n    61\tdeclare -A CFG_FLAGS=(\n    62\t    [flexgen]=\"--weight-comp zipserv\"\n    63\t    [flexgen-comp]=\"--weight-comp zipserv\"\n    64\t    [cao-zs]=\"--weight-comp zipserv\"\n    65\t    [cao-zs-fused]=\"--weight-comp zipserv --fused-mm\"\n    66\t    [cao-zs-kvcomp]=\"--weight-comp zipserv --fused-mm --kv-comp ublb_flat\"\n    67\t    [cao-p4]=\"--weight-comp p4flat\"\n    68\t    [cao-p4-fused]=\"--weight-comp p4flat --fused-mm\"\n    69\t    [cao-p4-kvcomp]=\"--weight-comp p4flat --fused-mm --kv-comp ublb_flat\"\n    70\t)\n    71\t\n    72\tfor cfg in \"${CONFIGS[@]}\"; do\n    73\t    # 클라이언트에 현재 config 전달 → 결과가 config별 디렉토리로 저장됨\n    74\t    CLIENT_CMD=\"bash scripts/serving/client/${CLIENT_SCRIPT}.sh $MODEL_ALIAS $cfg\"\n   350\t}\n   351\t\n   352\twait_for_clean_state() {\n   353\t  local context=\"$1\"\n   354\t  local deadline=$((SECONDS + CLEANUP_TIMEOUT))\n   355\t  local next_report=$SECONDS\n   356\t  while ! capture_clean_state; do\n   357\t    if ((SECONDS >= deadline)); then\n   358\t      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n   359\t      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n   360\t      return 1\n   361\t    fi\n   362\t    if ((SECONDS >= next_report)); then\n   363\t      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n   364\t      next_report=$((SECONDS + 15))\n   365\t    fi\n   366\t    sleep 2\n   367\t  done\n   368\t  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n   369\t}\n   370\t\n   371\tsanitize_id() {\n   372\t  local value=\"$1\"\n   373\t  value=\"${value//./p}\"\n   374\t  value=\"${value//\\//_}\"\n   375\t  printf '%s' \"$value\"\n   376\t}\n   377\t\n   378\tquote_command() {\n   379\t  printf '%q ' \"$@\"\n   380\t  printf '\\n'\n   381\t}\n   382\t\n   383\tCMD=()\n   384\tbuild_server_command() {\n   385\t  local mode=\"$1\"\n   386\t  local chunk=\"$2\"\n   387\t  local config\n   388\t  local -a mode_args=()\n   389\t  local -a breakdown_args=()\n   390\t\n   391\t  if [[ \"$mode\" == kvcomp ]]; then\n   392\t    config=\"$KVCOMP_CONFIG\"\n   393\t    mode_args=(--kv-comp \"$KV_BACKEND\")\n   394\t  else\n   395\t    config=\"$RAW_CONFIG\"\n   396\t  fi\n   397\t  if ((BREAKDOWN)); then\n   398\t    # Serving calls the detailed per-forward breakdown mode --collect-time.\n   399\t    # It records both the legacy timing line and the granular [Breakdown] line.\n   400\t    breakdown_args=(--collect-time)\n   401\t  fi\n   402\t\n   403\t  CMD=(\n   404\t    \"${CLEAN_ENV[@]}\"\n   405\t    \"PYTHONHASHSEED=0\"\n   406\t    \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n   407\t    \"LD_PRELOAD=${STACK_POOL_SO}\"\n   408\t    \"VLLM_DISABLE_COMPILE_CACHE=1\"\n   409\t    \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\"\n   410\t    \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05bef-8045-7b22-8a00-0f54beb65863","create_time":1788248830.6607842}}}
