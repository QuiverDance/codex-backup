ILL_MAX_CHUNK.\")\n    parser.add_argument(\"--fused-mm\",\n                        action=\"store_true\",\n                        help=\"Request the weight compressor's \"\n                             \"decompress+GEMM execution path. An override is \"\n                             \"installed only for compressor/residency pairs \"\n                             \"that support it; other cells keep dense \"\n                             \"decompress+matmul. P4Flat frozen_compressed and \"\n                             \"frozen_split install overrides, while P4Flat \"\n                             \"offload_compressed keeps the dense path. This \"\n                             \"flag does not enable weight compression.\")\n    parser.add_argument(\"--ats-decomp-frozen\",\n                        action=\"store_true\",\n                        help=\"frozen_split decode reads compressed bytes \"\n                             \"directly from LPDDR via host-mapped UVA, \"\n                             \"skipping the H2D copy into GPU staging. \"\n                             \"Recommended on GH200.\")\n    parser.add_argument(\"--ats-decomp-offload\",\n                        action=\"store_true\",\n                        help=\"offload_compressed load+decompress reads \"\n                             \"compressed bytes directly from LPDDR via \"\n                             \"host-mapped UVA, skipping the H2D copy \"\n                             \"into GPU staging. Recommended on GH200.\")\n    parser.add_argument(\"--kv-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=[\"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\",\n                                 \"p4flatcpu\", \"ublb_flat\"],\n                        help=\"Enable KV Compression. Optional value selects \"\n                             \"backend (default: zipserv when flag is given \"\n           