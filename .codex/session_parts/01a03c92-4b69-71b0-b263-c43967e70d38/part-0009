         # Free the CPU hugepage source after compression.\n                    # After UVA conversion, target.data_ptr() is the\n                    # CUDA device pointer, not the CPU hugepage ptr\n                    # that the allocator tracks.  Use the original CPU\n                    # tensor stored by the model loader so the free\n                    # actually finds the allocation.\n                    if gpu_target is not target:\n                        cpu_data = getattr(target, '_tiered_serve_cpu_data',\n                                           target)\n                        self.huge_page_allocator.free(cpu_data)\n\n                    frozen_comp_dict[name] = comped\n\n                    # Redirect module param to this layer's parity-specific\n                    # decomp buffer (even layers→buf0, odd→buf1).  Bound\n                    # ONCE here at init; never reassigned, so the V1\n                    # piecewise CUDA graph can capture a stable pointer.\n                    delattr(leaf_module, tensor_name)\n                    setattr(leaf_module, tensor_name,\n                            torch.nn.Parameter(\n                                primary,\n                                requires_grad=False))\n\n                    # Install fused decompress+GEMM override if the user\n                    # enabled --fused-mm and the bound compressor exposes\n                    # a native fused kernel.  With fused_mm the dense\n                    # decompress kernel is skipped (see\n                    # decompress_frozen_tensors); the compressed buffer\n                    # is permanent HBM so no H2D is needed either.\n                    self._maybe_install_fused_mm(\n                        leaf_module, comped,\n                        self._compressor_for_cell(idx, comp_key, mode=mode),\n                        layer_id=idx,\n                        comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                        mode=\"frozen_compressed\", tensor_name=name)\n\n                elif mode == \"frozen_split\":\n                    # Compress on GPU, keep sign_mantissa on HBM,\n                    # move remaining buffers to LPDDR hugepage.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing FrozenSplit Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            gpu_target.copy_(target, non_blocking=False)\n                        # Per-cell backend: the resulting CompressedTensor\n                        # type sets SplitStorageInfo.backend below, and the\n                        # decode reconstruct (_resolve_backend_compressor)\n                        # re-derives the SAME per-cell instance, so compress\n                        # and reconstruct stay matched.\n                        if self._frozen_raw_exp:\n                            comped = RawExpCompressed.from_weight(gpu_target)\n                        else:\n                            comped = self._compressor_for_cell(\n                                idx, comp_key, mode=mode).compress(\n                                gpu_target, primary)\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: Compression Ratio: \"\n                            f\"{gpu_target.nbytes/comped.nbytes:.2f}x\")\n\n                    # sign_mantissa stays on GPU.  ZipServ FP8 keeps its\n                    # tensor fields nested under ``comped._c``; everything\n                    # else exposes them on ``comped`` directly. P3-flat FP8\n                    # stores the HBM-resident half-byte stream as\n                    # ``sm_nibbles`` (no separate sign_mantissa byte).\n                    if isinstance(comped, CompressedP3FlatFP8Tensor):\n                        hbm_sm = comped.sm_nibbles.clone()\n                    elif isinstance(comped, CompressedUBLBFlatTensor):\n                        # UBLB-flat: the raw lower byte stays on HBM (the\n                        # sign_mantissa analog); code_stream/palette/exc ship\n                        # to LPDDR.  Stored generically as ``sign_mantissa``.\n                        hbm_sm = comped.lb_raw.clone()\n                    else:\n                        sm_src = (comped._c\n                                  if isinstance(comped, CompressedZipServFP8GpuTensor)\n                                  else comped)\n                        hbm_sm = sm_src.sign_mantissa.clone()\n\n                    # Backend-specific LPDDR layout\n                    if isinstance(comped, RawExpCompressed):\n                        backend = \"raw_exp\"\n                        lpddr_attrs = (\"raw_exp\",)\n                        metadata = {\"M\": comped.M, \"K\": comped.K}\n                    elif isinstance(comped, CompressedDietGPUTensor):\n                        backend = \"dietgpu\"\n                        # raw-exp mode: ship the uncompressed exp (M*K) instead\n                        # of the ANS-compressed stream so decode can merge-only.\n                        lpddr_attrs = (\n                            (\"raw_exp\",)\n                            if (os.getenv(\"TIERED_SERVE_FROZEN_RAW_EXP\", \"0\")\n                                == \"1\" and comped.raw_exp is not None)\n                            else SplitStorageInfo._DIETGPU_LPDDR_ATTRS)\nMODULE