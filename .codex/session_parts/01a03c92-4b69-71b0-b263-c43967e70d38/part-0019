)\n   336\t            if split_k > 1\n   337\t            else _empty_f32(device)\n   338\t        )\n   339\t        return {\n   340\t            \"key\": (M, K, N, device.index),\n   341\t            \"n_pad\": n_pad,\n   342\t            \"split_k\": split_k,\n   343\t            \"output\": output,\n   344\t            \"padded_input\": padded_input,\n   345\t            \"partials\": partials,\n   346\t        }\n   347\t\n   348\t    def alloc_fused_scratch(\n   349\t        self,\n   350\t        K: int,\n   351\t        M: int,\n   352\t        N: int,\n   353\t        dtype: torch.dtype,\n   354\t        device: torch.device,\n   355\t    ):\n   356\t        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n   357\t                or M % 64 or K % 64 or N <= 0):\n   358\t            return None\n   359\t        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n   360\t\n   361\t    def _linear_apply_impl(\n   362\t        self,\n   363\t        comp: CompressedChunkDelta3Tensor,\n   364\t        x: torch.Tensor,\n   365\t        scratch: Optional[dict],\n   366\t        wdecomp_events=None,\n   367\t    ) -> torch.Tensor:\n   368\t        import torch.nn.functional as F\n   369\t\n   370\t        M, K = int(comp.M), int(comp.K)\n   371\t        original_shape = x.shape\n   372\t        x2 = x.reshape(-1, K)\n   373\t        N = int(x2.shape[0])\n   374\t        use_fused = (\n   375\t            M % 64 == 0\n   376\t            and K % 64 == 0\n   377\t            and 0 < N <= self._fused_max_n_for(M, K)\n   378\t            and x2.dtype == torch.bfloat16\n   379\t            and x2.is_cuda\n   380\t            and comp._c.codes.is_cuda\n   450\t            words = packed_per_stripe[stripe, :(count + 2) // 3]\n   451\t            destination = entries20[begin:begin + count]\n   452\t            destination[0::3] = (words[:destination[0::3].numel()]\n   453\t                                  & mask).to(torch.int32)\n   454\t            if count > 1:\n   455\t                destination[1::3] = ((words[:destination[1::3].numel()] >> 20)\n   456\t                                      & mask).to(torch.int32)\n   457\t            if count > 2:\n   458\t                destination[2::3] = ((words[:destination[2::3].numel()] >> 40)\n   459\t                                      & mask).to(torch.int32)\n   460\t\n   461\t        num_words = (total + 2) // 3\n   462\t        padded = torch.zeros(num_words * 3, dtype=torch.int64)\n   463\t        padded[:total].copy_(entries20.to(torch.int64))\n   464\t        triples = padded.view(num_words, 3)\n   465\t        return (triples[:, 0]\n   466\t                | (triples[:, 1] << 20)\n   467\t                | (triples[:, 2] << 40)).contiguous()\n   468\t\n   469\t    @classmethod\n   470\t    def _compress_cpu_native(cls, source: torch.Tensor):\n   471\t        \"\"\"Encode a row-major BF16 weight with the OpenMP host encoder.\n   472\t\n   473\t        The KV encoder owns whole blocks.  Treat each 64-row weight stripe as\n   474\t        one block, which exposes M/64 independent jobs while preserving the\n   475\t        exact tile order consumed by the standalone and fused GPU decoders.\n   476\t        \"\"\"\n   477\t        if source.device.type != \"cpu\":\n   478\t            raise ValueError(\"ChunkDelta3 CPU encode requires a CPU tensor\")\n   479\t        source = source.contiguous()\n   480\t        M, K = map(int, source.shape)\n   481\t        stripes = M // 64\n   482\t        tiles_per_stripe = K // 64\n   483\t        block_elements = 64 * K\n   484\t        code_bytes = tiles_per_stripe * (64 * 64 * 3 // 8)\n   485\t        base_bytes = tiles_per_stripe * 256\n   486\t\n   487\t        # Layer-0 QKV is exception-heavy (~6%).  Start at 12.5% capacity and\n   488\t        # retry at the measured maximum if an unusual checkpoint exceeds it.\n   489\t        requested = int(os.getenv(\n   490\t            \"TIERED_SERVE_CD3_WEIGHT_CPU_EXCEPTION_CAPACITY_PER_64_ROWS\",\n   491\t            \"65536\"))\n   492\t        entry_capacity = min(block_elements, max(3, requested))\n   493\t        entry_capacity = ((entry_capacity + 2) // 3) * 3\n   494\t        block_ids = torch.arange(stripes, dtype=torch.int64)\n   495\t        slots = block_ids.clone()\n   496\t\n   497\t        while True:\n   498\t            codes = torch.empty((stripes, code_bytes), dtype=torch.uint8)\n   499\t            sign_mantissa = torch.empty(\n   500\t                (stripes, block_elements), dtype=torch.uint8)\n   501\t            thread_bases = torch.empty(\n   502\t                (stripes, base_bytes), dtype=torch.uint8)\n   503\t            local_offsets = torch.empty(\n   504\t                (stripes, tiles_per_stripe + 1), dtype=torch.int32)\n   505\t            packed_per_stripe = torch.empty(\n   506\t                (stripes, entry_capacity // 3), dtype=torch.int64)\n   507\t            counts = torch.empty(stripes, dtype=torch.int32)\n   508\t            _cd3_ext.host_encode_chunk_delta3_blocks(\n   509\t                source.view(torch.int16).reshape(stripes, 64, K),\n   510\t                block_ids, slots, codes, sign_mantissa, thread_bases,\n   511\t                local_offsets, packed_per_stripe, counts, 64, K)\n   512\t            maximum = int(counts.max().item()) if stripes else 0\n   513\t            if maximum <= entry_capacity:\n   514\t                break\n   515\t            entry_capacity = min(\n   516\t                block_elements,\n   517\t                ((max(maximum, entry_capacity * 2) + 2) // 3) * 3)\n   518\t            if maximum > entry_capacity:\n   519\t                raise RuntimeError(\n   520\t                    \"ChunkDelta3 CPU weight exception count exceeds one \"\n   521\t                    f\"64-row stripe: {maximum} > {block_elements}\")\n   522\t\n   523\t        stripe_prefix = torch.zeros(stripes + 1, dtype=torch.int64)\n   524\t        stripe_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n   525\t        total = int(stripe_prefix[-1].item())\n   526\t        tile_offsets = torch.empty(\n   527\t            stripes * tiles_per_stripe + 1, dtype=torch.int32)\n   528\t        tile_offsets[:-1] = (\n   529\t            local_offsets[:, :-1].to(torch.int64)\n   530\t            + stripe_prefix[:-1, None]).reshape(-1).to(torch.int32)\n   531\t        tile_offsets[-1] = total\n   532\t\n   533\t        native = _cd3_ext.CompressedChunkDelta3()\n   534\t        native.codes = codes.reshape(-1)\n   535\t        native.sign_mantissa = sign_mantissa.reshape(-1)\n   536\t        native.thread_bases = thread_bases.reshape(-1)\n   537\t        native.tile_exception_offsets = tile_offsets\n   538\t        native.entries20x3 = cls._pack_cpu_weight_entries(\n   539\t            packed_per_stripe, counts)\n   540\t        native.M = M\n   541\t        native.K = K\n   542\t        native.num_exceptions = total\n   543\t        return native\n   544\t\n   545\t    @staticmethod\n   546\t    def _stage_native_to_cuda(native, device: torch.device, stream) -> None:\n   547\t        with torch.cuda.stream(stream):\n   548\t            for attr in CompressedChunkDelta3Tensor._BUFFER_ATTRS:\n   549\t                setattr(native, attr, getattr(native, attr).to(device))\n   550\t\n   551\t    def compress(\n   552\t        self,\n   553\t        weight: torch.Tensor,\n   554\t        decomp_output_tensor: Optional[torch.Tensor] = None,\n   555\t        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n   556\t        _sync: bool = True,\n   557\t    ) -> CompressedChunkDelta3Tensor:\n   558\t        del comp_output_tensor\n   559\t        if weight.dtype != torch.bfloat16:\n   560\t            raise TypeError(\n   561\t                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n   562\t        if weight.ndim != 2:\n   563\t            raise ValueError(\n   564\t                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n   565\t                f\"got {tuple(weight.shape)}\")\n   566\t        if weight.shape[0] % 64 or weight.shape[1] % 64:\n   567\t            raise ValueError(\n   568\t                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n   569\t                f\"got {tuple(weight.shape)}\")\n   570\t\n   571\t        if self._cpu_weight_encode or not weight.is_cuda:\n   572\t            host_source = getattr(weight, \"_tiered_serve_cpu_data\", None)\n   573\t            if (not isinstance(host_source, torch.Tensor)\n   574\t                    or host_source.device.type != \"cpu\"\n   575\t                    or tuple(host_source.shape) != tuple(weight.shape)):\n   576\t                host_source = (weight.detach().cpu() if weight.is_cuda\n   577\t                               else weight.detach())\n   578\t            native = self._compress_cpu_native(host_source)\n   579\t            if weight.is_cuda:\n   580\t                stream = (self.comp_stream\n   581\t                          or torch.cuda.current_stream(weight.device))\n   582\t                self._stage_native_to_cuda(native, weight.device, stream)\n   583\t                if _sync:\n   584\t                    stream.synchronize()\n   585\t        else:\n   586\t            source = weight.contiguous()\n   587\t            stream = self.comp_stream or torch.cuda.current_stream(weight.device)\n   588\t            producer_stream = torch.cuda.current_stream(weight.device)\n   589\t            if stream != producer_stream:\n   590\t                stream.wait_stream(producer_stream)\n   591\t            with torch.cuda.stream(stream):\n   592\t                native = _cd3_ext.compress_chunk_delta3(source)\n   593\t            if _sync:\n   594\t                # The packed-entry kernel is enqueued after a host-visible count\n   595\t                # readback.  Complete it before exposing the object cross-stream.\n   596\t                stream.synchronize()\n   597\t        compressed = CompressedChunkDelta3Tensor(native)\n   598\t        if decomp_output_tensor is not None:\n   599\t            compressed.output_tensor = decomp_output_tensor\n   600\t        if _sync:\n   601\t            ratio = weight.nbytes / max(1, compressed.nbytes)\n   602\t            logger.info(\n   603\t                \"ChunkDelta3 compress [%dx%d]: ratio=%.3fx nbytes=%d \"\n   604\t                \"exceptions=%d\", compressed.M, compre