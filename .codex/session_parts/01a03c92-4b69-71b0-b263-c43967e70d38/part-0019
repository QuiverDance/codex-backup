 paths; we\n   563\t            # alias to the offload compressor so they keep behaving the\n   564\t            # same when the user supplies only the base flag.\n   565\t            self.weight_compressor = self._compressor_offload\n   566\t\n   567\t        env_var_value = os.getenv(\"TIERED_SERVE_USE_KV_COMP\")\n   568\t        use_kv_comp = env_var_value is not None and env_var_value == \"1\"\n   569\t        DualMemoryLoader.no_offload_kv = (\n   570\t            os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n   571\t        if DualMemoryLoader.no_offload_kv:\n   572\t            # KV stays fully resident in GPU HBM: disable offload + KV\n   573\t            # compression entirely (weights are still offloaded).\n   574\t            use_kv_comp = False\n   575\t        DualMemoryLoader.use_kv_comp = use_kv_comp\n   576\t        DualMemoryLoader.kv_full_block_only = False\n   577\t\n   578\t        self.kv_compressor = None\n   579\t        if DualMemoryLoader.use_kv_comp:\n   580\t            kv_comp_backend = os.getenv(\n   581\t                \"TIERED_SERVE_KV_COMP_BACKEND\", \"zipserv\").lower()\n   582\t            if kv_comp_backend not in (\n   583\t                    \"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\", \"p4flatcpu\",\n   584\t                    \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\",\n   585\t                    \"chunk_delta3\"):\n   586\t                raise ValueError(\n   587\t                    f\"Unknown TIERED_SERVE_KV_COMP_BACKEND: \"\n   588\t                    f\"{kv_comp_backend!r}. Expected one of: \"\n   589\t                    f\"zipserv, dietgpu, mantexp, p4flat, p4flatcpu, \"\n   590\t                    f\"bitcomp, bitcompcpu, ublb_flat, ublb_tbe, \"\n   591\t                    f\"chunk_delta3.\")\n   592\t\n   593\t            _full_block_only = (\n   594\t                os.getenv(\n   595\t                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\")\n   596\t            if _full_block_only and kv_comp_backend not in (\n   597\t                    \"p4flat\", \"p4flatcpu\", \"chunk_delta3\"):\n   598\t                raise ValueError(\n   599\t                    \"TIERED_SERVE_KV_FULL_BLOCK_ONLY=1 currently requires \"\n   600\t                    \"the p4flat, p4flatcpu, or chunk_delta3 KV backend; got \"\n   601\t                    f\"{kv_comp_backend!r}\")\n   602\t            DualMemoryLoader.kv_full_block_only = _full_block_only\n   603\t\n   604\t            # ── KV compression producer mode ──\n   605\t            # Selects how the compressed KV copy is produced during unload.\n   606\t            # Both modes always store raw KV in LPDDR secondary so that\n   607\t            # prefill-containing phases load uncompressed without paying\n   608\t            # decompression latency.  Resolved *before* the backend is\n   609\t            # instantiated because p4flat picks its encode implementation\n   610\t            # (GPU vs CPU) from the producer mode below.\n   611\t            #\n   612\t            #   gpu_direct:\n   613\t            #       Backend's existing pipeline produces compressed KV on GPU\n   614\t            #       (DietGPU/MantExp/p4flat run compress kernels on\n   615\t            #       comp_stream).  Raw secondary unload runs in parallel.\n   616\t            #\n   617\t            #   cpu_after_raw_swap:\n   618\t            #       Avoid GPU compression entirely.  Raw KV is D2H'd to\n   619\t            #       LPDDR secondary first, then a CPU compressor reads\n   620\t            #       directly from secondary_kv (no extra D2H) and writes\n   621\t            #       into the persistent compressed host pool.  Supported only\n   622\t            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n   623\t            #       manager), p4flat, and ChunkDelta3 (Python worker boundary\n   624\t            #       around an OpenMP C++ encoder).\n   625\t            # Default is backend-aware.  ZipServ is CPU-encode only in the\n   626\t            # serving path: raw KV is first swapped to secondary_kv and its C++\n   627\t            # worker manager compresses directly from that host tensor.  This\n   628\t            # is also enforced below so an inherited producer env cannot route\n   629\t            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n   630\t            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n   631\t            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n   632\t            # host_encode_blocks) variant of the p4flat codec — it always uses\n   633\t            # the cpu_after_raw_swap producer, regardless of the env default.\n   634\t            # p4flat's gpu_direct compress runs 3 device kernels\n   635\t            # (compress_lean) on comp_stream.  When weight compression is also\n   636\t            # active, those kernels contend with weight-decompress + fused-mm\n   637\t            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n   638\t            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n   639\t            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n   640\t            # default p4flat to the CPU encoder whenever weight comp is on (the\n   641\t            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n   642\t            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n   643\t            # where the GPU has spare SMs and the two paths are on par\n   644\t            # (180 vs 176 ms).  An explicit env value below still overrides.\n   645\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   646\t                                   \"ublb_flat\", \"ublb_tbe\"):\n   647\t                _default_producer = \"cpu_after_raw_swap\"\n   648\t            elif kv_comp_backend == \"chunk_delta3\":\n   649\t                # CD3 GPU encode contends directly with fused weight decode/MM\n   650\t                # once KV offload begins.  The host encoder consumes the raw\n   651\t                # secondary copy asynchronously and is the serving default.\n   652\t                _default_producer = \"cpu_after_raw_swap\"\n   653\t            elif (kv_comp_backend == \"p4flat\"\n   654\t                    and DualMemoryLoader.use_weight_comp):\n   655\t                _default_producer = \"cpu_after_raw_swap\"\n   656\t            else:\n   657\t                _default_producer = \"gpu_direct\"\n   658\t            kv_comp_producer = os.getenv(\n   659\t                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n   660\t            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n   661\t                raise ValueError(\n   662\t                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n   663\t                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n   664\t                    f\"'cpu_after_raw_swap'.\")\n   665\t            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n   666\t                                   \"ublb_flat\", \"ublb_tbe\") and \\\n   667\t                    kv_comp_producer != \"cpu_after_raw_swap\":\n   668\t                logger.warning(\n   669\t                    \"%s is CPU-encode only; ignoring \"\n   670\t                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n   671\t                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n   672\t                kv_comp_producer = \"cpu_after_raw_swap\"\n   673\t            if (kv_comp_producer == \"cpu_after_raw_swap\"\n   674\t                    and kv_comp_backend not in\n   675\t                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n   676\t                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n   677\t                raise ValueError(\n   678\t                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n   679\t                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n   680\t                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n   681\t                    f\"(backend \"\n   682\t                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n   683\t            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n   684\t\n   685\t            # ── Backend instantiation (p4flat's encode side depends on the\n   686\t            #    producer mode resolved above) ──\n   687\t            if kv_comp_backend == \"dietgpu\":\n   688\t                from tiered_serve.dietgpu_kv_compressor import (\n   689\t                    DietGPUKVCompressor,\n   690\t                )\n   691\t                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n   692\t                logger.info(\"KV compressor: DietGPU\")\n   693\t            elif kv_comp_backend == \"mantexp\":\n   694\t                # Mantissa/Exponent split: sm stays in HBM, exp is\n   695\t                # ANS-compressed and persisted in LPDDR (see\n   696\t                # tiered_serve/mantexp_kv_compressor.py).\n   697\t                if not self.mantexp_split_kv:\n   698\t                    logger.warning(\n   699\t                        \"KV backend 'mantexp' selected without \"\n   700\t                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n   701\t                from tiered_serve.mantexp_kv_compressor import (\n   702\t                    MantExpKVCompressor,\n   703\t                )\n   704\t                self.kv_compressor = MantExpKVCompressor(\n   705\t                    self.decomp_kv_stream)\n   706\t                logger.info(\"KV compressor: MantExp (split storage)\")\n   707\t            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n   708\t                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n   709\t                #