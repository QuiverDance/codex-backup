stream)\")\n   738\t            elif kv_comp_backend == \"chunk_delta3\":\n   739\t                from tiered_serve.chunk_delta3_kv_compressor import (\n   740\t                    ChunkDelta3CPUKVCompressor,\n   741\t                    ChunkDelta3KVCompressor,\n   742\t                )\n   743\t                if kv_comp_producer == \"cpu_after_raw_swap\":\n   744\t                    self.kv_compressor = ChunkDelta3CPUKVCompressor(\n   745\t                        self.decomp_kv_stream)\n   746\t                    logger.info(\n   747\t                        \"KV compressor: ChunkDelta3 (CPU OpenMP encode, \"\n   748\t                        \"batched GPU decode)\")\n   749\t                else:\n   750\t                    self.kv_compressor = ChunkDelta3KVCompressor(\n   751\t                        self.decomp_kv_stream)\n   752\t                    logger.info(\n   753\t                        \"KV compressor: ChunkDelta3 \"\n   754\t                        \"(batched GPU encode/decode)\")\n   755\t            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n   756\t                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n   757\t                # backends share the same GPU decode kernel and storage layout:\n   758\t                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n   759\t                #                         nvcomp_bitcomp_compress_batch)\n   760\t                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n   761\t                #                         compress, bitcompHostCompressLossless)\n   762\t                # ``bitcompcpu`` always selects the CPU encoder; bare\n   763\t                # ``bitcomp`` follows the producer mode (defaults to gpu_direct).\n   764\t                from tiered_serve.bitcomp_kv_compressor import (\n   765\t                    BitcompCPUKVCompressor,\n   766\t                    BitcompKVCompressor,\n   767\t                )\n   768\t                if (kv_comp_backend == \"bitcompcpu\"\n   769\t                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n   770\t                    self.kv_compressor = BitcompCPUKVCompressor(\n    60\t        Eagerly prime BF16 here so both workspaces are allocated up\n    61\t        front while HBM is still clean.  Today's targeted models\n    62\t        (Qwen/Llama bf16) always hit the BF16 path; FP8 stays lazy.\n    63\t\n    64\t        DietGPU workspaces are auto-sized from the largest model tensor\n    65\t        so users don't need to set ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB``\n    66\t        per model (the env var, if set, still wins).\n    67\t        \"\"\"\n    68\t        stream = self.decomp_weight_stream\n    69\t        auto_ws = self._auto_dietgpu_workspace_bytes()\n    70\t        if backend in (\"zipserv\", \"dietgpu\"):\n    71\t            comp = _AutoWeightCompressor(\n    72\t                family=backend, comp_stream=stream,\n    73\t                dietgpu_workspace_bytes=auto_ws)\n    74\t            comp._bf16()\n    75\t            logger.info(\n    76\t                \"Weight compressor [%s]: %s (auto BF16/FP8, BF16 primed%s)\",\n    77\t                role, backend,\n    78\t                \"\" if auto_ws is None\n    79\t                else f\", DietGPU ws={auto_ws / (1 << 20):.0f} MiB\")\n    80\t        elif backend == \"zipserv_bf16\":\n    81\t            comp = ZipServCompressor(stream)\n    82\t            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n    83\t        elif backend == \"dietgpu_bf16\":\n    84\t            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n    85\t            logger.info(\n    86\t                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n    87\t                \"\" if auto_ws is None\n    88\t                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n    89\t        elif backend == \"dietgpu_fp8\":\n    90\t            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n    91\t            logger.info(\n    92\t                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n    93\t                \"\" if auto_ws is None\n    94\t                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n    95\t        elif backend == \"zipserv_fp8\":\n    96\t            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n    97\t            # (forked from LLM-bitfield-compressor, built in-tree). No\n    98\t            # CPU fallback — the legacy reference impl was removed.\n    99\t            comp = ZipServFP8GpuCompressor(stream)\n   100\t            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n   101\t        elif backend == \"p4flat\":\n   102\t            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n   103\t            # patch fused MM); sources copied from LLM-bitfield-compressor,\n   104\t            # built via cpp_exts.zipserv_p4flat_ext.\n   105\t            from tiered_serve.tensor_compressor import P4FlatCompressor\n   106\t            comp = P4FlatCompressor(stream)\n   107\t            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n   108\t        elif backend == \"chunk_delta3\":\n   109\t            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n   110\t            comp = ChunkDelta3Compressor(stream)\n   111\t            logger.info(\n   112\t                \"Weight compressor [%s]: BF16 ChunkDelta3 \"\n   113\t                \"(CPU encode, GPU decode/fused-MM)\", role)\n   114\t        elif backend == \"p4d16\":\n   115\t            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n   116\t            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n   117\t            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n   118\t            from tiered_serve.tensor_compressor import P4D16Compressor\n   119\t            comp = P4D16Compressor(stream)\n   120\t            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n   121\t        elif backend == \"p3flat_fp8\":\n   122\t            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n   123\t            # nibble); bit-exact reconstruction via per-tile exception\n   124\t            # substream + warp prefix-sum in decompress kernel.\n   125\t            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n   126\t            comp = P3FlatFP8Compressor(stream)\n   127\t            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n   128\t        elif backend == \"ublb_flat\":\n   129\t            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n   130\t            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n   131\t            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n   132\t            from tiered_serve.tensor_compressor import UBLBFlatCompressor\n   133\t            comp = UBLBFlatCompressor(stream)\n   134\t            logger.info(\"Weight compressor [%s]: UBLB-flat (BF16)\", role)\n   135\t        else:\n   136\t            raise ValueError(\n   137\t                f\"Unknown weight compressor backend ({role}): \"\n   138\t                f\"{backend!r}. Expected one of: \"\n   139\t                f\"zipserv, dietgpu, zipserv_bf16, dietgpu_bf16, \"\n   140\t                f\"zipserv_fp8, dietgpu_fp8, p4flat, p4d16, p3flat_fp8, \"\n   141\t                f\"ublb_flat, chunk_delta3.\")\n   142\t        self._configure_weight_compressor_runtime(comp)\n   143\t        return comp\n   144\t\n   145\t    def _configure_weight_compressor_runtime(self, comp):\n   146\t        \"\"\"Attach loader runtime constants to compressor objects.\"\"\"\n   147\t        if comp is None or not hasattr(self, \"_cudagraph_ceiling\"):\n   148\t            return\n   149\t        comp._cudagraph_ceiling = self._cudagraph_ceiling\n   150\t        bf16 = getattr(comp, \"_bf16_impl\", None)\n   151\t        if bf16 is not None:\n   152\t            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n   153\t\n   154\t    def _compressor_for_mode(self, mode: str):\n   155\t        \"\"\"Return the weight compressor instance for a given residency mode.\n   201\tclass ChunkDelta3Compressor(TensorCompressor):\n   202\t    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n   203\t\n   204\t    HAS_FUSED_MM = True\n   205\t    codec_name = \"chunk_delta3\"\n   206\t\n   207\t    # GH200/Llama-70B serving calibration covers the lossless Packed20x3\n   208\t    # kernels through N=128.  With concurrent weight H2D, all four projections\n   209\t    # win throughout N=65..128.  QKV wins on 79/80 real layers (layer 0 is the\n   210\t    # exception-heavy outlier) and still wins in the 80-layer aggregate.  At\n   211\t    # N=129 the activation tile expands from 128 to 192 and fused latency jumps\n   212\t    # by about 2x, so dense decompress+cuBLAS is the clear route above 128.\n   213\t    # Keep environment overrides for cross-GPU/model retuning.\n   214\t    _FUSED_MAX_N_TABLE = {\n   215\t        (10240, 8192): 128,\n   216\t        (8192, 8192): 128,\n   217\t        (57344, 8192): 128,\n   218\t        (8192, 28672): 128,\n   219\t    }\n   220\t\n   221\t    def __init__(\n   222\t        self,\n   223\t        comp_stream: Optional[torch.cuda.Stream] = None,\n   224\t        decomp_stream: Optional[torch.cuda.Stream] = None,\n   225\t    ):\n   226\t        super().__init__(comp_stream, decomp_stream)\n   227\t        if not _HAS_CHUNK_DELTA3:\n   228\t            raise RuntimeError(\n   229\t                \"ChunkDelta3Compressor requires tp3_cd3_ext to build \"\n   230\t                \"successfully\")\n   231\t        # Weight compression is an offline/load-time operation.  Keep its\n   232\t        # compute on the host so it never steals SM time from serving.  The\n   233\t        # completed compressed buffers are staged to CUDA only when the input\n   234\t        # itself is CUDA; CPU callers retain a host-resident result.\n   235\t        self._cpu_weight_encode = (\n   236\t            os.getenv(\"TIERED_SERVE_CD3_WEIGHT_CPU_ENCODE\", \"1\") == \"1\")\n   237\t        self._fused_max_n_override: Optional[int] = None\n   238\t        self._fused_max_n_by_shape_override: dict[tuple[int, int], int] = {}\n   239\t        # Serving-level experiments can force the implemented fused path\n   240\t        # without changing the conservative production crossover table.\n   241\t        # Keeping this explicit matters because the current table is zero\n   242\t        # until end-to-end measurements justify enabling a shape by default.\n   243\t        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n   244\t        if fused_override is not None:\n   245\t            value = int(fused_override)\n   246\t            if value < 0:\n   247\t                raise ValueError(\n   248\t                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n   249\t            self._fused_max_n_override = value\n   250\t\n   251\t        # Projection-specific overrides make route calibration possible without\n   252\t        # rebuilding the extension or editing the production table.  A shape\n   253\t        # override takes precedence over the uniform override above.\n   254\t        projection_shapes = {\n   255\t            \"QKV\": (10240, 8192),\n   256\t            \"O\": (8192, 8192),\n   257\t            \"GATE_UP\": (57344, 8192),\n   258\t            \"DOWN\": (8192, 28672),\n   259\t        }\n   260\t        for projection, shape in projection_shapes.items():\n   261\t            env_name = f\"TIERED_SERVE_CD3_FUSED_MAX_N_{projection}\"\n   262\t            raw_value = os.getenv(env_name)\n   263\t            if raw_value is None:\n   264\t                continue\n   265\t            value = int(raw_value)\n   266\t            if value < 0:\n   267\t                raise ValueError(f\"{env_name} must be non-negative\")\n   268\t            self._fused_max_n_by_shape_override[shape] = value\n   269\t\n   270\t    def _fused_max_n_for(self, M: int, K: int) -> int:\n   271\t        shape_override = self._fused_max_n_by_shape_override.get((M, K))\n   272\t        if shape_override is not None:\n   273\t            return int(shape_override)\n   274\t        if self._fused_max_n_override is not None:\n   275\t            return int(self._fused_max_n_override)\n   276\t        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n   277\t\n   278\t    @staticmethod\n   279\t    def _allocate_fused_scratch(\n   280\t        M: int,\n   281\t        K: int,\n   282\t        N: int,\n   283\t        device: torch.device,\n   284\t    ) -> dict:\n   285\t        from tiered_serve.compression.core.ublb_tbe import (\n   286\t            _empty_f32,\n   287\t            _u4_split_k,\n   288\t        )\n   289\t\n   290\t        # CD3's TileN=128 kernel carries substantially more decode state than\n   291\t        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n   292\t        # it increases both WGMMA work and CD3 shared-memory pressure.\n   293\t        # Hopper WGMMA supports standard 64x{16,32} shapes.  Preserve the\n   294\t        # existing 64-wide path at N>32, but avoid doing 2-4x excess activation\n   295\t        # work in the latency-critical small-token regime.\n   296\t        if N <= 16:\n   297\t            n_pad = 16\n   298\t        elif N <= 32:\n   299\t            n_pad = 32\n   300\t        elif N <= 48:\n   301\t            n_pad = 48\n   302\t        else:\n   303\t            n_pad = ((N + 63) // 64) * 64\n   304\t        # Split-K is tuned per TileN regime after the reduced-shared-memory\n   305\t        # kernels raised TileN64/128 residency to five/four CTAs.  Split-4 wins\n   306\t        # throughout N<=64; at N=128 only GateUp's large grid stays unsplit.\n   307\t        if n_pad <= 32:\n   308\t            # The smaller B tile and single exception map allow enough\n   309\t            # resident CTAs that split-4 wins for every production projection.\n   310\t            split_k = 4\n   311\t        elif n_pad <= 64:\n   312\t            split_k = {\n   313\t                (10240, 8192): 4,\n   314\t                (8192, 8192): 4,\n   315\t                (57344, 8192): 4,\n   316\t                (8192, 28672): 4,\n   317\t            }.get((M, K), _u4_split_k(M, n_pad, K))\n   318\t        elif n_pad == 128:\n   319\t            split_k = {\n   320\t                (10240, 8192): 4,\n   321\t                (8192, 8192): 4,\n   322\t                (57344, 8192): 1,\n   323\t                (8192, 28672): 4,\n   324\t            }.get((M, K), 1)\n   325\t        elif n_pad in (192, 256):\n   326\t            split_k = 4 if (M, K) == (10240, 8192) else 1\n   327\t        else:\n   328\t            split_k = 1\n   329\t        output = torch.empty(\n   330\t            n_pad, M, dtype=torch.bfloat16, device=device)\n   331\t        padded_input = torch.empty(\n   332\t            n_pad, K, dtype=torch.bfloat16, device=device)\n   333\t        partials = (\n   334\t            torch.empty(\n   335\t                split_k, n_pad, M, dtype=torch.float32, device=device)\n   336\t            if split_k > 1\n   337\t            else _empty_f32(device)\n   338\t        )\n   339\t        return {\n   340\t            \"key\": (M, K, N, device.index),\n   341\t            \"n_pad\": n_pad,\n   342\t            \"split_k\": split_k,\n   343\t            \"output\": output,\n   344\t            \"padded_input\": padded_input,\n   345\t            \"partials\": partials,\n   346\t        }\n   347\t\n   348\t    def alloc_fused_scratch(\n   349\t        self,\n   350\t        K: int,\n   351\t        M: int,\n   352\t        N: int,\n   353\t        dtype: torch.dtype,\n   354\t        device: torch.device,\n   355\t    ):\n   356\t        if (dtype != torch.bfloat16 or torch.device(device).type != \"cuda\"\n   357\t                or M % 64 or K % 64 or N <= 0):\n   358\t            return None\n   359\t        return self._allocate_fused_scratch(M, K, N, torch.device(device))\n   360\t\n   361\t    def _linear_apply_impl(\n   362\t        self,\n   363\t        comp: CompressedChunkDelta3Tensor,\n   364\t        x: torch.Tensor,\n   365\t        scratch: Optional[dict],\n   366\t        wdecomp_events=None,\n   367\t    ) -> torch.Tensor:\n   368\t        import torch.nn.functional as F\n   369\t\n   370\t        M, K = int(comp.M), int(comp.K)\n   371\t        original_shape = x.shape\n   372\t        x2 = x.reshape(-1, K)\n   373\t        N = int(x2.shape[0])\n   374\t        use_fused = (\n   375\t            M % 64 == 0\n   376\t            and K % 64 == 0\n   377\t            and 0 < N <= self._fused_max_n_for(M, K)\n   378\t            and x2.dtype == torch.bfloat16\n   379\t            and x2.is_cuda\n   380\t            and comp._c.codes.is_cuda\n   450\t            words = packed_per_stripe[stripe, :(count + 2) // 3]\n   451\t            destination = entries20[begin:begin + count]\n   452\t            destination[0::3] = (words[:destination[0::3].numel()]\n   453\t                                  & mask).to(torch.int32)\n   454\t            if count > 1:\n   455\t                destination[1::3] = ((words[:destination[1::3].numel()] >> 20)\n   456\t                                      & mask).to(torch.int32)\n   457\t            if count > 2:\n   458\t                destination[2::3] = ((words[:destination[2::3].numel()] >> 40)\n   459\t                                      & mask).to(torch.int32)\n   460\t\n   461\t        num_words = (total + 2) // 3\n   462\t        padded = torch.zeros(num_words * 3, dtype=torch.int64)\n   463\t        padded[:total].copy_(entries20.to(torch.int64))\n   464\t        triples = padded.view(num_words, 3)\n   465\t        return (triples[:, 0]\n   466\t                | (triples[:, 1] << 20)\n   467\t                | (triples[:, 2] << 40)).contiguous()\n   468\t\n   469\t    @classmethod\n   470\t    def _compress_cpu_native(cls, source: torch.Tensor):\n   471\t        \"\"\"Encode a row-major BF16 weight with the OpenMP host encoder.\n   472\t\n   473\t        The KV encoder owns whole blocks.  Treat each 64-row weight stripe as\n   474\t        one block, which exposes M/64 independent jobs while preserving the\n   475\t        exact tile order consumed by the standalone and fused GPU decoders.\n   476\t        \"\"\"\n   477\t        if source.device.type != \"cpu\":\n   478\t            raise ValueError(\"ChunkDelta3 CPU encode requires a CPU tensor\")\n   479\t        source = source.contiguous()\n   480\t        M, K = map(int, source.shape)\n   481\t        stripes = M // 64\n   482\t        tiles_per_stripe = K // 64\n   483\t        block_elements = 64 * K\n   484\t        code_bytes = tiles_per_stripe * (64 * 64 * 3 // 8)\n   485\t        base_bytes = tiles_per_stripe * 256\n   486\t\n   487\t        # Layer-0 QKV is exception-heavy (~6%).  Start at 12.5% capacity and\n   488\t        # retry at the measured maximum if an unusual checkpoint exceeds it.\n   489\t        requested = int(os.getenv(\n   490\t            \"TIERED_SERVE_CD3_WEIGHT_CPU_EXCEPTION_CAPACITY_PER_64_ROWS\",\n   491\t            \"65536\"))\n   492\t        entry_capacity = min(block_elements, max(3, requested))\n   493\t        entry_capacity = ((entry_capacity + 2) // 3) * 3\n   494\t        block_ids = torch.arange(stripes, dtype=torch.int64)\n   495\t        slots = block_ids.clone()\n   496\t\n   497\t        while True:\n   498\t            codes = torch.empty((stripes, code_bytes), dtype=torch.uint8)\n   499\t            sign_mantissa = torch.empty(\n   500\t                (stripes, block_elements), dtype=torch.uint8)\n   501\t            thread_bases = torch.empty(\n   502\t                (stripes, base_bytes), dtype=torch.uint8)\n   503\t            local_offsets = torch.empty(\n   504\t                (stripes, tiles_per_stripe + 1), dtype=torch.int32)\n   505\t            packed_per_stripe = torch.empty(\n   506\t                (stripes, entry_capacity // 3), dtype=torch.int64)\n   507\t            counts = torch.empty(stripes, dtype=torch.int32)\n   508\t            _cd3_ext.host_encode_chunk_delta3_blocks(\n   509\t                source.view(torch.int16).reshape(stripes, 64, K),\n   510\t                block_ids, slots, codes, sign_mantissa, thread_bases,\n   511\t                local_offsets, packed_per_stripe, counts, 64, K)\n   512\t            maximum = int(counts.max().item()) if stripes else 0\n   513\t            if maximum <= entry_capacity:\n   514\t                break\n   515\t            entry_capacity = min(\n   516\t                block_elements,\n   517\t                ((max(maximum, entry_capacity * 2) + 2) // 3) * 3)\n   518\t            if maximum > entry_capacity:\n   519\t                raise RuntimeError(\n   520\t                    \"ChunkDelta3 CPU weight exception count exceeds one \"\n   521\t                    f\"64-row stripe: {maximum} > {block_elements}\")\n   522\t\n   523\t        stripe_prefix = torch.zeros(stripes + 1, dtype=torch.int64)\n   524\t        stripe_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n   525\t        total = int(stripe_prefix[-1].item())\n   526\t        tile_offsets = torch.empty(\n   527\t            stripes * tiles_per_stripe + 1, dtype=torch.int32)\n   528\t        tile_offsets[:-1] = (\n   529\t            local_offsets[:, :-1].to(torch.int64)\n   530\t            + stripe_prefix[:-1, None]).reshape(-1).to(torch.int32)\n   531\t        tile_offsets[-1] = total\n   532\t\n   533\t        native = _cd3_ext.CompressedChunkDelta3()\n   534\t        native.codes = codes.reshape(-1)\n   535\t        native.sign_mantissa = sign_mantissa.reshape(-1)\n   536\t        native.thread_bases = thre