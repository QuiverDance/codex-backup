{"timestamp":"2026-08-26T05:54:01.731Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03ca1-f383-76c1-ae64-60eadd65b6fc","call_id":"call_8CgCV2p5m6xqyJdYbUiKxYnL","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        logger.info(\n            \"##### Semantic prompt: %s (%d tokens), expect=%r\",\n            args.prompt_file, input_seq_len, args.expect_text)\n    logger.info(f\"##### BATCH SIZES: {batches}\")\n    if args.weight_comp:\n        logger.info(f\"##### Using Weight Compression\")\n    if args.fused_mm:\n        logger.info(\"##### Using Fused MM\")\n    if args.kv_comp:\n        logger.info(\n            \"##### Using KV Compression (backend=%s, producer=%s)\",\n            args.kv_comp,\n            os.environ.get(\"TIERED_SERVE_KV_COMP_PRODUCER\",\n                           \"backend-default\"))\n    logger.info(\n        \"##########################################################################\"\n    )\n\n    engine_args = EngineArgs.from_cli_args(args)\n    # Preserve vLLM's --enforce-eager CLI value.  Forcing this back to False\n    # made it impossible to use the hook-driven eager path as a correctness\n    # reference for the compiled V1 weight-offload wrapper.\n    engine_args.max_num_batched_tokens = args.prefill_chunk\n    if args.fixed_generation_length:\n        # --gen is a per-request token count under this opt-in policy.\n        max_gen = gen_phase\n    else:\n        # Compute the longest gen_phase any request will need (earliest\n        # prefilled request in the largest batch).\n        _pp = calc_prefill_phases(max_batch, input_seq_len,\n                                  engine_args.max_num_batched_tokens)\n        max_gen = gen_phase + max(_pp)\n    engine_args.max_num_seqs = max_batch\n    # max_model_len is a per-sequence limit, not per-batch total.\n    engine_args.max_model_len = input_seq_len + max_gen\n    engine_args.enable_prefix_caching = False\n    engine_args.enable_chunked_prefill = True\n    engine_args.swap_space = 0\n\n    # Keep PREFILL out of cudagraph (mirrors serve_offload_kvweight.py's\n    # proven design).  Cap the cudagraph capture to the decode-concurrency\n    # ceiling so any batch whose TOKEN count exceeds it — i.e. one carrying a\n    # prefill chunk (prefill-chunk default 8192 >> the ceiling) — runs EAGER\n    # (CUDAGraphMode.NONE).  Captured-size prefill (chunk <= ceiling) shares the\n    # decode graph and reads the compressed staging (UNIFY); larger prefill runs\n    # eager on the raw_bf16 dense primary.  TIERED_SERVE_CUDAGRAPH_CEILING tells\n    # the loader/op where that boundary is so the two agree (see DualMemoryLoader\n    # ._cudagraph_ceiling).\n    from vllm.config import CompilationConfig\n    _DECODE_CAPTURE_REQS = max(int(engine_args.max_num_seqs), 1)\n    _cc = engine_args.compilation_config\n    if not isinstance(_cc, CompilationConfig):\n        if isinstance(_cc, int):\n            _cc = CompilationConfig(level=_cc)\n        elif isinstance(_cc, dict):\n            _cc = CompilationConfig(**_cc)\n        else:\n            _cc = CompilationConfig()\n        engine_args.compilation_config = _cc\n    _cc.max_cudagraph_capture_size = _DECODE_CAPTURE_REQS\n    os.environ[\"TIERED_SERVE_CUDAGRAPH_CEILING\"] = str(_DECODE_CAPTURE_REQS)\n    logger.info(\n        \"CUDA-graph capture ceiling = %d reqs (prefill chunks > ceiling => \"\n        \"eager raw_bf16 primary; <= ceiling => captured staging path)\",\n        _DECODE_CAPTURE_REQS)\n    # gpu_memory_utilization flows through EngineArgs.from_cli_args via the\n    # native vLLM --gpu-memory-utilization flag (add_cli_args above).\n\n    # --- HBM limit: allocate a dummy tensor to reduce visible free memory ---\n    _hbm_ballast = None\n    if args.hbm_limit is not None:\n        _free, _total = torch.cuda.mem_get_info()\n        _target = int(args.hbm_limit * 1024**3)\n        _waste = _free - _target\n        if _waste > 0:\n            _hbm_ballast = torch.empty(_waste, dtype=torch.uint8, device='cuda:0')\n            _new_free, _ = torch.cuda.mem_get_info()\n            logger.info(\"HBM limit: %.2f GiB target, allocated %.2f GiB \"\n                        \"ballast (free: %.2f -> %.2f GiB)\",\n                        args.hbm_limit, _waste / 1024**3,\n                        _free / 1024**3, _new_free / 1024**3)\n            # Adjust gpu_memory_utilization so vLLM startup check passes:\n            #   free_memory >= total * utilization\n            max_util = _new_free / _total\n            engine_args.gpu_memory_utilization = min(\n                engine_args.gpu_memory_utilization, max_util - 0.01)\n            logger.info(\"HBM limit: gpu_memory_utilization adjusted to %.3f\",\n                        engine_args.gpu_memory_utilization)\n        else:\n            logger.info(\"HBM limit: %.2f GiB requested but free is already \"\n                        \"%.2f GiB, no ballast needed\",\n                        args.hbm_limit, _free / 1024**3)\n\n    # V1's EngineCore runs in a separate process with an independent busy\n    # loop.  This means ts_set_phase() calls arrive AFTER the EngineCore has\n    # already started the next step, breaking phase synchronisation and making\n    # timing measurements meaningless (engine.step() just dequeues a\n    # pre-computed result).  Disabling multiprocessing switches to InprocClient\n    # which calls step_fn() directly — giving V0-style synchronous behaviour.\n    os.environ[\"VLLM_ENABLE_V1_MULTIPROCESSING\"] = \"0\"\n    if \"fp8\" in args.model.lower():\n        engine_args.quantization = \"modelopt\"\n\n    engine = LLMEngine.from_engine_args(engine_args)\n\n    if args.verify_runtime_weights:\n        verify_llama_31_70b_runtime_state(\n            args.model,\n            args.revision,\n            getattr(DualMemoryLoader, \"_v1_dm_ref\", None),\n            logger,\n        )\n\n    def _ten