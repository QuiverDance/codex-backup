the active run process group ${CURRENT_PGID}\" >&2\n    kill -TERM -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    local deadline=$((SECONDS + 10))\n    while kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null && ((SECONDS < deadline)); do\n      sleep 1\n    done\n    if kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null; then\n      kill -KILL -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    fi\n  fi\n}\n\nhandle_signal() {\n  local signal=\"$1\"\n  terminate_current_group\n  [[ \"$signal\" == INT ]] && exit 130\n  exit 143\n}\n\ntrap 'handle_signal INT' INT\ntrap 'handle_signal TERM' TERM\ntrap 'terminate_current_group' EXIT\n\npreflight_files\n\nif ((DRY_RUN)); then\n  echo \"[suite] dry-run: ${#METHODS[@]} methods x ${REPEATS} repeat(s)\"\n  for ((round = 1; round <= REPEATS; round++)); do\n    if ((round % 2 == 1)); then\n      order=(\"${METHODS[@]}\")\n    else\n      order=()\n      for ((idx = ${#METHODS[@]} - 1; idx >= 0; idx--)); do\n        order+=(\"${METHODS[idx]}\")\n      done\n    fi\n    for method in \"${order[@]}\"; do\n      build_command \"$method\"\n      printf '[round %d] %-31s config=%s\\n  ' \"$round\" \"$METHOD_LABEL\" \"$CONFIG_STEM\"\n      printf '%q ' \"${CMD[@]}\"\n      printf '\\n'\n    done\n  done\n  exit 0\nfi\n\nwait_for_clean_state \"suite preflight\" || exit 1\n\nSUITE_ID=\"$(date +%Y%m%d_%H%M%S)\"\nSUITE_DIR=\"${OUTPUT_ROOT}/${SUITE_ID}\"\nmkdir -p \"$SUITE_DIR\"\nSUMMARY=\"${SUITE_DIR}/summary.tsv\"\nMANIFEST=\"${SUITE_DIR}/manifest.txt\"\nprintf 'round\\tmethod_id\\tmethod\\tconfig\\texit_code\\telapsed_sec\\tstate\\tcsv\\trunner_log\\n' >\"$SUMMARY\"\n\n{\n  echo \"suite_id=${SUITE_ID}\"\n  echo \"repo_root=${REPO_ROOT}\"\n  echo \"git_commit=$(git -C \"$REPO_ROOT\" rev-parse HEAD 2>/dev/null || echo unknown)\"\n  echo \"model=${MODEL}\"\n  echo \"batches=${BATCHES[*]}\"\n  echo \"input_seq_len=${INPUT_SEQ_LEN}\"\n  echo \"gen=${GEN_TOKENS}\"\n  echo \"warmup=${WARMUP}\"\n  echo \"prefill_chunk=${PREFILL_CHUNK}\"\n  echo \"repeats=${