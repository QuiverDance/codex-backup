  while read -r pid stat args; do\\n+    [[ \\\"$stat\\\" == Z* ]] && continue\\n+    case \\\"$args\\\" in\\n+      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\\n+        printf '%s %s %s\\\\n' \\\"$pid\\\" \\\"$stat\\\" \\\"$args\\\"\\n+        ;;\\n+    esac\\n+  done < <(ps -eo pid=,stat=,args=)\\n+}\\n+\\n+LAST_STATE_DETAIL=\\\"\\\"\\n+capture_clean_state() {\\n+  local offenders gpu_apps gpu_line hbm_used gpu_util\\n+  local hp_total hp_free hp_reserved mount_type\\n+  local -a problems=()\\n+\\n+  offenders=\\\"$(active_tiered_processes)\\\"\\n+  [[ -z \\\"$offenders\\\" ]] || problems+=(\\\"tiered-processes=${offenders//$'\\\\n'/ | }\\\")\\n+\\n+  if ! gpu_line=\\\"$(nvidia-smi -i \\\"$GPU_INDEX\\\" \\\\\\n+      --query-gpu=memory.used,utilization.gpu \\\\\\n+      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\\\"; then\\n+    problems+=(\\\"nvidia-smi-query-failed\\\")\\n+    gpu_line=\\\",\\\" \\n+  fi\\n+  IFS=',' read -r hbm_used gpu_util <<<\\\"$gpu_line\\\"\\n+  if [[ ! \\\"$hbm_used\\\" =~ ^[0-9]+$ ]]; then\\n+    problems+=(\\\"invalid-hbm=${hbm_used:-empty}\\\")\\n+  elif ((hbm_used > MAX_IDLE_HBM_MIB)); then\\n+    problems+=(\\\"hbm=${hbm_used}MiB>${MAX_IDLE_HBM_MIB}MiB\\\")\\n+  fi\\n+  if [[ ! \\\"$gpu_util\\\" =~ ^[0-9]+$ ]]; then\\n+    problems+=(\\\"invalid-gpu-util=${gpu_util:-empty}\\\")\\n+  elif ((gpu_util != 0)); then\\n+    problems+=(\\\"gpu-util=${gpu_util}%\\\")\\n+  fi\\n+\\n+  gpu_apps=\\\"$(nvidia-smi -i \\\"$GPU_INDEX\\\" \\\\\\n+      --query-compute-apps=pid,process_name,used_memory \\\\\\n+      --format=csv,noheader,nounits 2>/dev/null | sed '/^[[:space:]]*$/d' || true)\\\"\\n+  [[ -z \\\"$gpu_apps\\\" ]] || problems+=(\\\"gpu-processes=${gpu_apps//$'\\\\n'/ | }\\\")\\n+\\n+  if [[ -r \\\"${HUGEPAGE_SYSFS}/nr_hugepages\\\" ]]; then\\n+    hp_total=\\\"$(<\\\"${HUGEPAGE_SYSFS}/nr_hugepages\\\")\\\"\\n+    hp_free=\\\"$(<\\\"${HUGEPAGE_SYSFS}/free_hugepages\\\")\\\