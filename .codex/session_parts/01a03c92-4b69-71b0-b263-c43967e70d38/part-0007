\")\n      ;;\n    cao-p4flat-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)\"\n      CONFIG_STEM=\"cao-p4-fused\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm)\n      ;;\n    cao-p4flat-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)-kvcomp\"\n      CONFIG_STEM=\"cao-p4-kvcomp\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    *)\n      die \"internal error: unknown method ${method}\"\n      ;;\n  esac\n  CONFIG_PATH=\"${CONFIG_ROOT}/${CONFIG_STEM}.yaml\"\n}\n\npreflight_files() {\n  [[ -x \"$PYTHON\" ]] || die \"Python not found: ${PYTHON}\"\n  [[ -f \"$DRIVER\" ]] || die \"offline driver not found: ${DRIVER}\"\n  [[ -f \"$STACK_POOL\" ]] || die \"stack-pool preload library not found: ${STACK_POOL}\"\n  command -v numactl >/dev/null || die \"numactl is required\"\n  command -v setsid >/dev/null || die \"setsid is required\"\n  command -v nvidia-smi >/dev/null || die \"nvidia-smi is required\"\n\n  local method\n  for method in \"${METHODS[@]}\"; do\n    build_method \"$method\"\n    [[ -f \"$CONFIG_PATH\" ]] || die \"config not found: ${CONFIG_PATH}\"\n    if [[ -n \"$EXPECTED_CODEC\" ]] &&\n       ! grep -q \"compressor: ${EXPECTED_CODEC}\" \"$CONFIG_PATH\"; then\n      die \"${method}: ${CONFIG_PATH} does not declare ${EXPECTED_CODEC}\"\n    fi\n  done\n}\n\n# Clear every inherited tiered-serve knob. Each child receives only the common\n# values below and the flags selected by build_method().\nENV_PREFIX=(env)\nwhile IFS='=' read -r env_name _; do\n  if [[ \"$env_name\" == TIERED_SERVE_* ]]; then\n    ENV_PREFIX+=(-u \"$env_name\")\n  fi\ndone < <(env)\nENV_PREFIX+=(\n  \"PYTHONHASHSEED=0\"\n  \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n  \"LD_PRELOAD=${STACK_POOL}\"\n  \"VLLM_DISABLE_COMPILE_CACHE=1\"\n  \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n  \"TIERED_SERVE_N_WEIGHT_BUFFERS=2\"\n)\n\nbuild_command() {\n  local method=\"$1\"\n  build_method \"$method\"\n  CMD=(\n    \"${ENV_PREFIX[@]}\"\n    numactl -m \"$NUMA_NODE\"\n    \"$PYTHON\" \"$DRIVER\"\n    --model \"$MODEL\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --block-size 16\n    --no-enable-prefix-caching\n    --batch \"${BATCHES[@]}\"\n    --inputseqlen \"$INPUT_SEQ_LEN\"\n    --gen \"$GEN_TOKENS\"\n    --fixed-generation-length\n    --prefill-chunk \"$PREFILL_CHUNK\"\n    --warmup \"$WARMUP\"\n    --ts-configs \"$CONFIG_PATH\"\n    \"${FEATURE_ARGS[@]}\"\n  )\n}\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+=(\"nvidia-smi-query-failed\")\n    gpu_line=\",\" \n  fi\n  IFS=',' read -r hbm_used gpu_util <<<\"$gpu_line\"\n  if [[ ! \"$hbm_used\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-hbm=${hbm_used:-empty}\")\n  elif ((hbm_used > MAX_IDLE_HBM_MIB)); then\n    problems+=(\"hbm=${hbm_used}MiB>${MAX_IDLE_HBM_MIB}MiB\")\n  fi\n  if [[ ! \"$gpu_util\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-gpu-util=${gpu_util:-empty}\")\n  elif ((gpu_util != 0)); then\n    problems+=(\"gpu-util=${gpu_util}%\")\n  fi\n\n  gpu_apps=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-compute-apps=pid,