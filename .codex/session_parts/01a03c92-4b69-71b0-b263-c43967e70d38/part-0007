ult: 129)\n  --warmup N              Initial TPOT samples excluded (default: 16)\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\n  --kv-backend NAME       KV codec for the two kvcomp cells (default: ublb_flat)\n  --gpu-index N           Physical GPU used and checked (default: 0)\n  --numa-node N           NUMA memory node (default: 0)\n  --weight-huge-pages N   16 GiB pages assigned to weights (default: 14)\n  --max-idle-hbm-mib N    Maximum clean-state HBM use (default: 1024)\n  --cleanup-timeout SEC   Wait for clean state between runs (default: 120)\n  --output-root DIR       Suite logs/manifests directory\n  --dry-run               Validate mappings and print commands only\n  -h, --help              Show this help\n\nExamples:\n  bash scripts/offline/run_performance_suite.sh\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --batches 16,64,128\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --dry-run\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nrequire_uint() {\n  local option=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${option} requires a non-negative integer: ${value}\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --batches)\n      (($# >= 2)) || die \"--batches requires a value\"\n      batch_spec=\"${2//,/ }\"\n      read -r -a BATCHES <<<\"${batch_spec}\"\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --input-seq-len)\n      (($# >= 2)) || die \"--input-seq-len requires a value\"\n      INPUT_SEQ_LEN=\"$2\"\n      shift 2\n      ;;\n    --gen)\n      (($# >= 2)) || die \"--gen requires a value\"\n      GEN_TOKENS=\"$2\"\n      shift 2\n      ;;\n    --warmup)\n      (($# >= 2)) || die \"--warmup requires a value\"\n      WARMUP=\"$2\"\n      shift 2\n      ;;\n    --prefill-chunk)\n      (($# >= 2)) || die \"--prefill-chunk requires a value\"\n      PREFILL_CHUNK=\"$2\"\n      shift 2\n      ;;\n    --kv-backend)\n      (($# >= 2)) || die \"--kv-backend requires a value\"\n      KV_BACKEND=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_uint --repeats \"$REPEATS\"\nrequire_uint --input-seq-len \"$INPUT_SEQ_LEN\"\nrequire_uint --gen \"$GEN_TOKENS\"\nrequire_uint --warmup \"$WARMUP\"\nrequire_uint --prefill-chunk \"$PREFILL_CHUNK\"\nrequire_uint --gpu-index \"$GPU_INDEX\"\nrequire_uint --numa-node \"$NUMA_NODE\"\nrequire_uint --weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_uint --max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\nrequire_uint --cleanup-timeout \"$CLEANUP_TIMEOUT\"\n((REPEATS > 0)) || die \"--repeats must be greater than zero\"\n((INPUT_SEQ_LEN > 0)) || die \"--input-seq-len must be greater than zero\"\n((GEN_TOKENS > 0)) || die \"--gen must be greater than zero\"\n((PREFILL_CHUNK > 0)) || die \"--prefill-chunk must be greater than zero\"\n((CLEANUP_TIMEOUT > 0)) || die \"--cleanup-timeout must be greater than zero\"\n((${#BATCHES[@]} >