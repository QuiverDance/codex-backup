 that bracket as a standalone value.  Recover the clean KV\n            # engine-time as  engine_busy_union − weight :\n            #   • the UNION of weight ∪ KV intervals is INFLATION-IMMUNE — the\n            #     absorbed weight is double-counted (it lives in both the inflated\n            #     KV interval AND the clean weight intervals), and the union-merge\n            #     cancels that overlap → the union equals the true H2D engine-busy\n            #     span (validated disjoint vs the nsys copy-engine timeline).\n            #   • weight_load_time is the CLEAN head-of-queue weight union (weight\n            #     is prefetched first, never queued behind KV → never absorbed).\n            # KVLoad = union − weight is then exact, additive by construction\n            # (WLoad+KVLoad = union ≤ GPUFwd), zero schedule perturbation (pure\n            # post-hoc arithmetic on the fast baseline's recorded events), and a\n            # real measurement (a genuine KV slowdown grows the union → the\n            # residual).  Validated: union 150.79 − weight 112.92 = 37.87 ≈ nsys\n            # KV 37.86 @b64.  (Stream-ordering fixes — weight-waits-KV / alias /\n            # KV-waits-weight — were all rejected: they change the schedule and\n            # collapse the depth-2 weight prefetch, +25-31% TPOT.)\n            engine_busy_union = self._merge_union(\n                weight_memcpy_times + kv_memcpy_times)\n            kv_load_time = max(0.0, engine_busy_union - weight_load_time)\n\n        # ── Stall computation ──\n        if not self.batch_has_prefill:\n            # Decode: measure stalls from exec event gaps and barrier\n            # wait events recorded in V1 wrapper.\n            #\n            # Exec intervals span [begin_exec → end_exec] per graph\n            # piece.  They include the KV barrier wait (exec_attn_barriers\n            # wait in _after_replay) which delays attention start.\n            #\n            # The KV barrier wait is NOT caused by slow KV loading — it's\n            # caused by the weight→KV dependency chain: load_kv_stream\n            # waits for load_weight_stream, so the barrier is delayed.\n            # waits for load_weight_stream, so the barrier is delayed.\n            #\n            # We report a single TotalStall = total_time - pure_exec.\n            # The barrier wait events give additional breakdown.\n\n            # Measure barrier waits inside exec intervals\n            attn_barrier_wait = 0.0\n            valid_exec_set = set()\n            n_exec = len(self.begin_exec_events)  # n_layers + 1\n            for i in range(n_exec):\n                begin_time = init_event.elapsed_time(\n                    self.begin_exec_events[i])\n                end_time = init_event.elapsed_time(\n                    self.end_exec_events[i])\n                if begin_time >= -0.01 and end_time > begin_time + 0.001:\n                    valid_exec_set.add(i)\n\n            for i in range(self.n_layers):\n                if i not in valid_exec_set:\n                    continue\n                wait_ms = self._v1_kv_wait_begin_events[i].elapsed_time(\n                    self._v1_kv_wait_end_events[i])\n                if wait_ms > 0.001:\n                    attn_barrier_wait += wait_ms\n\n            # ── Per-component stall (the \"where\") ──\n            # Each projection GEMM waits for its own weight at the in-graph\n            # ``wait_frozen_weight`` op (timed by _v1_wwait_*); attention waits\n            # for KV at the _v1_kv_wait op.  ALL of these waits live on\n            # cur_stream and run sequentially, so the per-component sums\n            # partition the step's stall with no double-counting.  Filter by\n            # absolute timestamp (begin inside this step's window) to drop\n            # stale events from frozen/resident layers that did not wait.\n            comp_stall = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_stall_by_layer = {}\n            wwb = getattr(self, \"_v1_wwait_begin_events\", None)\n            wwe = getattr(self, \"_v1_wwait_end_events\", None)\n            if wwb and wwe:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = L * 4 + c\n                        try:\n                            b = init_event.elapsed_time(wwb[j])\n                            e = init_event.elapsed_time(wwe[j])\n                        except RuntimeError:\n                            continue\n                        if b > -0.01 and b < total_time and e - b > 0.001:\n                            comp_stall[c] += e - b\n                            comp_stall_by_layer.setdefault(\n                                L, [0.0, 0.0, 0.0, 0.0])[c] = e - b\n            weight_stall = sum(comp_stall)\n\n            # pure exec = exec intervals minus ALL barrier waits inside them\n            # (attention KV wait + per-component in-graph weight waits).\n            exec_time = max(0.0, llm_time - attn_barrier_wait - weight_stall)\n            weight_barrier_wait = max(0.0, total_time - llm_time)\n            total_stall_time = total_time - exec_time\n\n            # Per-component stall breakdown — where cur_stream IDLES (compute\n            # side).  In a load-bound pipeline this lands on whichever barrier\n            # sits at the per-layer load-slot end (usually attn), which is the\n            # OBSERVATION point, not the cause.\n            # Under time_breakdown the per-step line is suppressed; the driver\n            # (offline_offload_kvweight.py) prints one batch-averaged line from\n            # the barrier-wait/comp_load values stashed into decode_breakdowns.\n            if not self.time_breakdown:\n                logger.info(\n                    \"  BarrierWait(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                    \"down=%.2f attn=%.2f | weight=%.2f direct=%.2f\",\n                    comp_stall[0], comp_stall[1], comp_stall[2], comp_stall[3],\n                    attn_barrier_wait, weight_stall,\n                    weight_stall + attn_barrier_wait)\n\n            # ── Per-component LOAD time (the copy-engine critical path) ──\n            # The CAUSE of the stall: in a load-bound pipeline the bottleneck\n            # is the H2D copy engine, and the stall is driven by whichever\n            # component's load takes longest.  Measure per-component H2D\n            # duration (begin→end memcpy), summed over the layers that load\n            # this step.  The largest component IS where the stall lives.\n            comp_load = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_to_slot = {\"qkv\": 0, \"o\": 1, \"gate_up\": 2, \"down\": 3}\n            bmw = getattr(self, \"begin_memcpy_weight_events\", None)\n            emw = getattr(self, \"end_memcpy_weight_events\", None)\n            if bmw and emw:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = 4 * L + c\n                        if j >= len(emw):\n                            continue\n                        try:\n                            b = init_event.elapsed_time(bmw[j])\n                            e = init_event.elapsed_time(emw[j])\n                        except RuntimeError:\n                            continue\n                        if b > -0.01 and b < total_time and e - b > 0.001:\n                            comp_load[c] += e - b\n            # Frozen_split compressed-exp / aux H2D is timed through a\n            # per-(layer, tensor_name) cache, not begin_memcpy_weight_events.\n            # WLoad already folds these intervals into the total; mirror that\n            # attribution here so ComponentLoad does not report zero weight\n            # load in frozen_split/fused-mm dec