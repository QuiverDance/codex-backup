ayers,\n                    len(self.begin_exec_events) - 1)):\n                attn_wait = self._v1_kv_wait_begin_events[\n                    cur_id].elapsed_time(\n                        self._v1_kv_wait_end_events[cur_id])\n                wcw = comp_stal…1940 tokens truncated…     or layer_id >= len(end_list)):\n                            continue\n                        try:\n                            begin_t = init_event.elapsed_time(\n                                begin_list[layer_id])\n                            end_t = init_event.elapsed_time(\n                                end_list[layer_id])\n                        except RuntimeError:\n                            continue\n                        # Skip stale (pre-init) or zero-duration events.\n                        # Either side being pre-init means this layer\n                        # didn't actually decompress in this forward.\n                        if (begin_t < -0.01 or end_t < -0.01\n                                or end_t - begin_t < 0.001):\n                            continue\n                        frozen_decomp_intervals.append((begin_t, end_t))\n                frozen_decomp_intervals.sort(key=lambda x: x[0])\n\n            # frozen_split's per-(layer,name) decomp kernel uses its\n            # own lazy timing cache (the per-comp_key\n            # end_frozen_decomp_timing_events slots are written by the\n            # frozen_compressed paths, not by\n            # _decompress_frozen_split_for_name).\n            frozen_split_decomp_intervals = []\n            sd_begin_cache = getattr(\n                self,\n                \"_frozen_split_decomp_begin_timing_events_cache\",\n                None)\n            sd_end_cache = getattr(\n                self,\n                \"_frozen_split_decomp_end_timing_events_cache\",\n                None)\n            if sd_begin_cache and sd_end_cache:\n                for key, begin_ev in sd_begin_cache.items():\n                    end_ev = sd_end_cache.get(key)\n                    if end_ev is None:\n                        continue\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_decomp_intervals.append((b_t, e_t))\n                frozen_split_decomp_intervals.sort(key=lambda x: x[0])\n\n            all_weight_decomp_intervals = (\n                weight_decomp_intervals\n                + frozen_decomp_intervals\n                + frozen_split_decomp_intervals)\n            wdecomp_union: List[Tuple[float, float]] = []\n            wdecomp_brk = 0.0\n            if all_weight_decomp_intervals:\n                wdecomp_union = self._calc_exec_times(\n                    all_weight_decomp_intervals, [])\n                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\n\n            kvdecomp_union: List[Tuple[float, float]] = []\n            kvdecomp_brk = 0.0\n            if use_kv_comp and kv_decomp_intervals:\n                kvdecomp_union = self._calc_exec_times(\n                    kv_decomp_intervals, [])\n                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\n\n            # ── Separate Compute from WEIGHT Decomp ──\n            # The decode GEMM blocks on cur_stream until its WEIGHT\n            # decompression (on decomp_weight_stream) completes — the weight IS\n            # the GEMM operand, so the GEMM cannot start until decomp lands.\n            # Only ~6ms of that block surfaces as the in-graph _v1_wwait; the\n            # rest stays inside the exec window, which is why Compute(LLM) read\n            # ~= WDecomp ~= GPUFwd even though the real GEMM is tiny.  Carve the\n            # weight-decomp union out