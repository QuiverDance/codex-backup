                self, \"_frozen_split_h2d_begin_events_cache\", None)\n            end_cache = getattr(\n                self, \"_frozen_split_h2d_end_timing_events_cache\", None)\n            if begin_cache and end_cache:\n                for key, begin_ev in begin_cache.items():\n                    end_ev = end_cache.get(key)\n                    if end_ev is None:\n                        continue\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_h2d_intervals.append((b_t, e_t))\n                frozen_split_h2d_intervals.sort(key=lambda x: x[0])\n\n            all_weight_load_intervals = (\n                weight_memcpy_times + frozen_split_h2d_intervals)\n            wload_union: List[Tuple[float, float]] = []\n            wload_brk = 0.0\n            if all_weight_load_intervals:\n                wload_union = self._calc_exec_times(\n                    all_weight_load_intervals, [])\n                wload_brk = sum(e - b for b, e in wload_union)\n\n            # Diagnostic: count how many intervals reached each bucket so\n            # we can tell whether wload_brk is low because intervals were\n            # filtered (stale events) or because the union truly is small.\n            if not self.batch_has_prefill and os.getenv(\n                    \"TIERED_SERVE_BREAKDOWN_VERBOSE\", \"0\") == \"1\":\n                wmt_sum = sum(e - b for b, e in weight_memcpy_times)\n                fsi_sum = sum(e - b for b, e in frozen_split_h2d_intervals)\n                logger.info(\n                    \"[WLoadDbg] weight_memcpy: n=%d sum=%.2fms | \"\n                    \"frozen_split_h2d: n=%d sum=%.2fms | \"\n                    \"union=%.2fms (cache_size begin=%d end=%d)\",\n                    len(weight_memcpy_times), wmt_sum,\n                    len(frozen_split_h2d_intervals), fsi_sum,\n                    wload_brk,\n                    len(begin_cache or {}),\n                    len(end_cache or {}))\n\n            kvload_union: List[Tuple[float, float]] = []\n            kvload_brk = 0.0\n            # KVLoad = the wall-clock the KV stream actually spends moving KV\n            # H2D, measured DIRECTLY by the CUDA events that bracket each\n            # layer's transfer: the raw load_kv_stream memcpys (begin/\n            # end_memcpy_kv) plus the compressed-blob H2D on batch_decomp_stream\n            # (_kv_h2d_begin .. _kv_dec_h2d).  Union-merge so back-to-back\n            # intervals on the one stream aren't double-counted, then sum.\n            # NO weight-overlap subtraction: KV H2D and weight H2D serialise on\n            # the single GH200 copy engine, so they never overlap in wall-clock\n            # and there is nothing to attribute away.\n            # Compressed-KV path: the H2D is the dedicated load_kv_stream blob\n            # transfer, bracketed TIGHTLY by _kv_h2d_begin .. _kv_dec_h2d.  Use\n            # that alone — the loader's begin/end_memcpy_kv span ALSO covers the\n            # double-buffer consumed-wait that precedes the H2D, which would\n            # inflate KVLoad with the previous layer's decode time.  Raw KV has\n            # no _kv_h2d events, so fall back to the load_kv_stream memcpys.\n            if kv_h2d_intervals:\n                # KVLoad = Σ each layer's KV H2D begin..end elapsed_time, read\n                # DIRECTLY from the tight _kv_h2d_begin.._kv_dec_h2d events — the\n                # real per-transfer engine time.  NO union-merge: the per-layer\n                # intervals are disjoint on the load stream (union == sum), and\n                # the raw event elapsed_time is the source of truth.  Under the\n                # single-stream (H2D-on-weight) layout each layer's KV H2D runs\n                # in its own engine slot, so this reads the clean ~raw/ratio\n                # transfer (~0.29 ms/layer) instead of the inflated value the KV\n                # op showed when it queued behind weight on a separate stream.\n                kvload_brk = sum(e - b for b, e in kv_h2d_intervals)\n            else:\n                # Raw KV on a separate stream: the begin/end_memcpy_kv bracket is\n                # inflated (absorbs prefetched weight on the shared link).  Don't\n                # use it directly.  KVLoad = engine_busy_union − WLoad: the union\n                # of weight ∪ KV intervals is inflation-immune (the absorbed\n                # weight is double-counted and the merge cancels it → true H2D\n                # weight is double-counted and the merge cancels it → true H2D\n                # engine-busy), and wload_brk is the clean head-of-queue weight\n                # union.  Additive by construction, zero perturbation, validated\n                # vs nsys (union 150.79 − weight 112.92 = 37.87 ≈ KV 37.86 @b64).\n                # (Same recovery as kv_load_time above; see that comment.)\n                engine_busy_union = sum(\n                    e - b for b, e in self._calc_exec_times(\n                        all_weight_load_intervals + kv_memcpy_times, []))\n                kvload_brk = max(0.0, engine_busy_union - wload_brk)\n\n            # Stall = wall-clock time when Load (weight or KV) is\n            # active but NO compute is running on the GPU — neither\n            # Compute (GEMM + Attention) nor WDecomp nor KVDecomp.  Decomp\n            # counts as compute, so Stream 16 gaps in nsight that are filled\n            # by Stream 37 decomp do NOT count as stall.  llm_active_intervals\n            # here had both the cur_stream waits AND the decomp overlap\n            # carved out (so it's pure GEMM+attention); re-adding the decomp\n            # intervals via compute_intervals restores the full compute\n            # timeline — (A − decomp) ∪ decomp == A ∪ decomp, so this Stall is\n            # identical to using the pre-decomp-subtraction intervals.\n            compute_intervals = (\n                all_weight_decomp_intervals\n                + (kv_decomp_intervals if use_kv_comp else []))\n            if llm_active_intervals or compute_intervals:\n                compute_union = self._calc_exec_times(\n                    llm_active_intervals, compute_intervals)\n            else:\n                compute_union = []\n            # Compressed begin/end_memcpy_kv includes the decode-buffer/ring\n            # waits around the transfer.  Stall must use the same tight H2D\n            # interval as KVLoad, otherwise waits are counted as load-active.\n            canonical_kv_load_intervals = (\n                kv_h2d_intervals if kv_h2d_intervals else kv_memcpy_times)\n            load_union_all = self._calc_exec_times(\n                all_weight_load_intervals, canonical_kv_load_intervals)\n            load_total = sum(e - b for b, e in load_union_all)\n            load_in_compute = self._calculate_total_overlap(\n                load_union_all, compute_union)\n            stall_brk = max(0.0, load_total - load_in_compute)\n\n            # GPUFwd here is wall time between begin_forward_event and\n            # end_forward_event — pure GPU forward.  Python-side TPOT\n            # (engine.step()) additionally includes scheduler, sampling,\n            # logits processing and output assembly running on CPU\n            # serially after the GPU forward finishes; that gap is\n            # visible by comparing this line to the [Step] StepLatency\n            # line emitted by offline_offload_kvweight.py.\n            # Reported metrics (per-step wall-clock on GPU):\n            #   Compute  — GEMM + Attention on cur_stream (exec union).\n            #              A fused decode+GEMM kernel (``--fused-mm``) runs\n     