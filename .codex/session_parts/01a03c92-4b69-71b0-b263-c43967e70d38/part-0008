{"timestamp":"2026-08-26T06:02:08.601Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03ca9-6159-7020-a9b4-6f5416bf1bac","call_id":"call_GKLh4ghFUZ1GpS4zdqHW0v6j","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"UBLB KV cache compressors — P4Flat-based (reuse all of its KV machinery).\n\n``--kv-comp ublb_flat`` / ``ublb_tbe`` select these.  They subclass\n:class:`P4FlatCPUKVCompressor` and inherit its entire pipeline — persistent slot\npool, gather/scatter, CPU worker threads (``cpu_after_raw_swap``), pinned\nstaging, the decode-vs-unload race fixes — overriding only THREE codec hooks:\n\n  * ``_probe_sizes``         : the per-block serialized-blob fixed layout\n  * ``_invoke_host_encode``  : the C++ OpenMP host encoder (ublb_tbe_ext)\n  * ``_invoke_decode_kernel``: the batched blob GPU decode (ublb_tbe_ext)\n\nBlob layout per slot (full block, block_numel = M_b*K_b):\n\n  ublb_flat : [ palette(16) | code_stream(BN/2) | lb_raw(BN) | exc_idx(c*4) | exc_ub(c) ]\n              fixed = 16 + BN/2 + BN ;  5 bytes/exception.\n  ublb_tbe  : [ palette(8) | bm123(3*nt*8) | lb_raw(BN) | oob_rel(nt*2) | fallback(o) ]\n              fixed = 8 + 24*nt + BN + 2*nt ;  1 byte/out-of-palette.\n\nBoth fall back to a raw BF16 block (is_raw=1) when the payload would exceed the\nraw size, exactly like p4flat.  Encode runs on CPU (off-GPU → yields SM to\ncompute), decode is a single batched GPU kernel that overlaps the forward —\nthe (CPU compress + GPU decompress) pattern this codec targets.\n\nRequires block_numel % 4096 == 0 (Llama KV block = 16*8*128 = 16384 ✓): the\ndecode threadblock spans 4096 elements and must stay inside one block.\n\"\"\"\nfrom __future__ import annotations\n\nimport torch\n\nfrom tiered_serve.p4flat_kv_compressor import P4FlatCPUKVCompressor\nfrom tiered_serve.compression.core.ublb_tbe import _get_ext as _ublb_get_ext\n\n\nclass _UBLBKVMixin:\n    \"\"\"Shared wiring: load the ublb ext, force full-block (no occupancy), and\n    require block_numel % 4096 == 0 for the batched decode tiling.\"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        super().__init__(comp_stream)\n        self._ublb = _ublb_get_ext()\n        # v1: always encode full blocks (the ublb blob encoders ignore valid_tm).\n        # Occupancy (partial-block size opt) is a later refinement.\n        self._occupancy_enabled = False\n\n\nclass UBLBFlatCPUKVCompressor(_UBLBKVMixin, P4FlatCPUKVCompressor):\n    \"\"\"ublb_flat KV: UB/LB split, upper byte = flat 4-bit/16-palette code.\n    Fastest (CPU encode + GPU decode) of the KV codecs (ratio 1.33).\"\"\"\n\n    def _probe_sizes(self, M_b: int, K_b: int):\n        BN = M_b * K_b\n        if BN % 4096:\n            raise RuntimeError(\n                f\"UBLB flat KV: block_numel={BN} must be a multiple of 4096.\")\n        self._idx_dtype = torch.int32\n        self._val_dtype = torch.uint8\n        self._idx_es = 4\n        self._val_es = 1\n        self._row_major_sm = 1\n        # (palette, code_stream, lb_raw, none) -> fixed = 16 + BN/2 + BN.\n        # smb must equal block_numel (base warmup invariant) -> lb_raw region.\n        return 16, BN // 2, BN, 0\n\n    def _invoke_host_encode(self, host_i16, bidx, slots_t, pool,\n                            M_b, K_b, valid_tm):\n        self._ublb.flat_host_encode_blocks(\n            host_i16, bidx, slots_t,\n            pool['blob'], pool['total_size'], pool['exc_cnt'],\n            pool['is_raw'], pool['valid_rows'], M_b, K_b, valid_tm)\n\n    def _invoke_decode_kernel(self, gpu_blob, blob_stride, slots, block_ids,\n                              valid_rows, exc_cnt, is_raw, out_flat, block_numel,\n                              K_b, max_vr, max_exc, rsm, stream_handle=0):\n        self._ublb.flat_decompress_batched(\n            gpu_blob, blob_stride, slots, block_ids, exc_cnt, is_raw,\n            out_flat, block_numel, self._fixed_bytes, stream_handle)\n\n    def _invoke_decode_layer(self, blob_k, blob_v, blob_stride, gi, gu, gb, n,\n                             k_cache, v_cache, block_numel, K_b, max_vr,\n                             max_exc, rsm, stream_handle=0):\n        # One pybind call, base meta tensors sliced by pointer offset in C++\n        # (K: gi[0:n]/gi[2n:3n]/gu[0:n], V: gi[0:n]/gi[4n:5n]/gu[n:2n]) — see\n        # flat_decode_kv_layer.  k_cache/v_cache are contiguous flat KV buffers,\n        # so .data_ptr() == .reshape(-1).data_ptr() (no Python reshape needed).\n        self._ublb.flat_decode_kv_layer(\n            blob_k, blob_v, blob_stride, gi, gb, gu, n,\n            k_cache, v_cache, block_numel, self._fixed_bytes, stream_handle)\n\n\nclass UBLBTBECPUKVCompressor(_UBLBKVMixin, P4FlatCPUKVCompressor):\n    \"\"\"ublb_tbe KV: UB/LB split, upper byte = triple-bitmap 7-value palette.\n    Best ratio (~1.38) of the KV codecs; decode ≈ p4flat.\"\"\"\n\n    def _probe_sizes(self, M_b: int, K_b: int):\n        BN = M_b * K_b\n        if BN % 4096:\n            raise RuntimeError(\n                f\"UBLB tbe KV: block_numel={BN} must be a multiple of 4096.\")\n        nt = BN // 64                       # 64-element tiles\n        self._idx_dtype = torch.int16       # oob_rel\n        self._val_dtype = torch.uint8       # fallback\n        self._idx_es = 2\n        self._val_es = 1\n        self._row_major_sm = 1\n        # blob = [palette(8) | bm123(24*nt) | lb_raw(BN) | oob_rel(2*nt) | fallback]\n        # map to (hb,cb,smb,cdb) with smb==block_numel (base invariant):\n        #   hb = palette + bm123 = 8 + 24*nt ;  cb = 0 ;  smb = lb_raw = BN ;\n        #   cdb = oob_rel = 2*nt   ->  fixed = 8 + 26*nt + BN.\n        return 8 + 24 * nt, 0, BN, 2 * nt\n\n    def _invoke_host_encode(self, host_i16, bidx, slots_t, pool,\n                            M_b, K_b, valid_tm):\n        self._ublb.tbe_host_encode_blocks(\n            host_i16, bidx, slots_t,\n            pool['blob'], pool['total_size'], pool['exc_cnt'],\n            pool['is_raw'], pool['valid_rows'], M_b, K_b, valid_tm)\n\n    def _invoke_decode_kernel(self, gpu_blob, blob_stride, slots, block_ids,\n                              valid_rows, exc_cnt, is_raw, out_flat, block_numel,\n                              K_b, max_vr, max_exc, rsm, stream_handle=0):\n        self._ublb.tbe_decompress_batched(\n            gpu_blob, blob_stride, slots, block_ids, is_raw,\n            out_flat, block_numel, self._fixed_bytes, stream_handle)\n            #       by backends that ship a CPU encoder: ZipServ (C++ worker\n            #       manager) and p4flat (Python worker pool).\n            # Default is backend-aware.  ZipServ is CPU-encode only in the\n            # serving path: raw KV is first swapped to secondary_kv and its C++\n            # worker manager compresses directly from that host tensor.  This\n            # is also enforced below so an inherited producer env cannot route\n            # ``--kv-comp zipserv`` back through gpu_direct.  GPU-kernel\n            # backends (dietgpu / mantexp / p4flat) default to gpu_direct.\n            # ``p4flatcpu`` is the explicit CPU-encode (C++ OpenMP\n            # host_encode_blocks) variant of the p4flat codec — it always uses\n            # the cpu_after_raw_swap producer, regardless of the env default.\n            # p4flat's gpu_direct compress runs 3 device kernels\n            # (compress_lean) on comp_stream.  When weight compression is also\n            # active, those kernels contend with weight-decompress + fused-mm\n            # GEMM for SMs — measured +~51ms GPUFwd (an un-attributed forward\n            # gap = the compress kernels) and +~25ms stall, a 1.26x slowdown\n            # vs ublb_flat (CPU encode) on the weight+KV (cao) config.  So\n            # default p4flat to the CPU encoder whenever weight comp is on (the\n            # same GPU-contention-free path ublb uses; p4flat's C++ OpenMP\n            # host_encode keeps up just like ublb's).  KV-only keeps gpu_direct,\n            # where the GPU has spare SMs and the two paths are on par\n            # (180 vs 176 ms).  An explicit env value below still overrides.\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\"):\n                _default_producer = \"cpu_after_raw_swap\"\n            elif (kv_comp_backend == \"p4flat\"\n                    and DualMemoryLoader.use_weight_comp):\n                _default_producer = \"cpu_after_raw_swap\"\n            else:\n                _default_producer = \"gpu_direct\"\n            kv_comp_producer = os.getenv(\n                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n                    f\"'cpu_after_raw_swap'.\")\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\") and \\\n                    kv_comp_producer != \"cpu_after_raw_swap\":\n                logger.warning(\n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, bitcomp, bitcompcpu) (backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent split: sm stays in HBM, exp is\n                # ANS-compressed and persisted in LPDDR (see\n                # tiered_serve/mantexp_kv_compressor.py).\n                if not self.mantexp_split_kv:\n                    logger.warning(\n                        \"KV backend 'mantexp' selected without \"\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n                #                         host_encode_blocks)\n                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n                # follows the producer mode (defaults to gpu_direct).\n                # See tiered_serve/p4flat_kv_compressor.py.\n                from tiered_serve.p4flat_kv_compressor import (\n                    P4FlatCPUKVCompressor,\n                    P4FlatKVCompressor,\n                )\n                if (kv_comp_backend == \"p4flatcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = P4FlatCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: P4Flat (CPU encode, \"\n                        \"C++ OpenMP host_encode_blocks)\")\n                else:\n                    self.kv_compressor = P4FlatKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            elif kv_comp_backend in (\"bitcomp\", \"bitcompcpu\"):\n                # Lossless nvCOMP Bitcomp over the whole BF16 block.  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> BitcompKVCompressor    (GPU compress,\n                #                         nvcomp_bitcomp_compress_batch)\n                #   cpu_after_raw_swap -> BitcompCPUKVCompressor (CPU host\n                #                         compress, bitcompHostCompressLossless)\n                # ``bitcompcpu`` always selects the CPU encoder; bare\n                # ``bitcomp`` follows the producer mode (defaults to gpu_direct).\n                from tiered_serve.bitcomp_kv_compressor import (\n                    BitcompCPUKVCompressor,\n                    BitcompKVCompressor,\n                )\n                if (kv_comp_backend == \"bitcompcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = BitcompCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: Bitcomp (CPU encode, \"\n                        \"bitcompHostCompressLossless worker pool)\")\n                else:\n                    self.kv_compressor = BitcompKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: Bitcomp (GPU encode)\")\n            elif kv_comp_backend in (\"ublb_flat\", \"ublb_tbe\"):\n                # UBLB UB/LB-split KV codecs, P4Flat-based (reuse its slot pool /\n                # gather / worker pipeline; ublb overrides only the blob layout +\n                # C++ host encoder + batched GPU decode).  CPU-encode only\n                # (cpu_after_raw_swap): encode off-GPU yields SM to compute,\n                # decode is one batched kernel that overlaps the forward.\n                #   ublb_flat : flat 4-bit/16-palette  (fastest enc+dec, ratio 1.33)\n                #   ublb_tbe  : triple-bitmap 7-palette (best ratio ~1.38)\n                from tiered_serve.ublb_kv_compressor import (\n                    UBLBFlatCPUKVCompressor,\n                    UBLBTBECPUKVCompressor,\n                )\n                cls = (UBLBFlatCPUKVCompressor if kv_comp_backend == \"ublb_flat\"\n                       else UBLBTBECPUKVCompressor)\n                self.kv_compressor = cls(self.decomp_kv_stream)\n                logger.info(\n                    \"KV compressor: %s (CPU encode C++ OpenMP, \"\n                    \"GPU batched decode)\", kv_comp_backend)\n                # Same one-stream KV-decode opt-in as p4flat (inherited flag).\n                if getattr(self.kv_compressor, \"_kv_decode_on_compute\", False):\n                    self.kv_compressor.batch_decomp_stream = self.exec_stream\n                    logger.info(\n                        \"[kv-decode] on compute stream (exec_stream)\")\n            else:  # zipserv\n                self.kv_compressor = ZipServCompressor(self.decomp_kv_stream)\n                logger.info(\n                    \"KV compressor: ZipServ (CPU encode, C++ worker pool, \"\n                    \"cpu_after_raw_swap)\")\n                             \"Recommended on GH200.\")\n    parser.add_argument(\"--ats-decomp-offload\",\n                        action=\"store_true\",\n                        help=\"offload_compressed load+decompress reads \"\n                             \"compressed bytes directly from LPDDR via \"\n                             \"host-mapped UVA, skipping the H2D copy \"\n                             \"into GPU staging. Recommended on GH200.\")\n    parser.add_argument(\"--kv-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=[\"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\",\n                                 \"p4flatcpu\", \"ublb_flat\", \"ublb_tbe\"],\n                        help=\"Enable KV Compression. Optional value selects \"\n                             \"backend (default: zipserv when flag is given \"\n                             \"without value). 'zipserv' uses the accelerated \"\n                             \"C++ CPU worker pool after raw KV is swapped to \"\n                             \"host memory. 'mantexp' selects the \"\n                             \"sign+mantissa / compressed-exponent split \"\n                             \"backend (equivalent to --mantexp-split-kv). \"\n                             \"'p4flat' selects the BF16 P4-flat per-tile \"\n                             \"exponent-palette codec (GPU encode by default). \"\n                             \"'p4flatcpu' is the same codec with the C++ \"\n                             \"OpenMP CPU host encoder (cpu_after_raw_swap). \"\n                             \"'ublb_flat'/'ublb_tbe' are the UB/LB-split codecs \"\n                             \"(P4Flat-based, CPU encode + GPU batched decode): \"\n                             \"ublb_flat = fastest enc+dec (ratio 1.33), \"\n                             \"ublb_tbe = best ratio ~1.38.\")\n    parser.add_argument(\"--collect-time\",\n                        action=\"store_true\",\n                        help=\"Collect Time data\")\n    parser.add_argument(\"--chunked-prefill\",\n                        default=True,\n                        action=argparse.BooleanOptionalAction,\n                        help=\"Compatibility flag; this serving driver always \"\n                             \"enables chunked prefill\")\n        for a in (\"code_stream\", \"lb_raw\", \"palette\", \"exc_idx\", \"exc_ub\"):\n            setattr(self, a, getattr(self, a).to(device=device,\n                                                 non_blocking=non_blocking))\n        return self\n\n\nclass UBLBFlatCompressor(TensorCompressor):\n    \"\"\"UB/LB-split BF16; upper byte = flat 4-bit palette code, lower byte raw.\n\n    Same byte split as :class:`UBLBTBECompressor` but the upper byte is coded\n    with a flat per-element 4-bit code into a 16-entry palette instead of the\n    triple bitmap. Decode is branchless (no popcount/rank/transpose) — the\n    P4flat-style fast path — at a lower ratio ceiling (16/(4+8) = 1.333x).\n\n    With ``HAS_FUSED_MM = True`` the inference hot path (``--fused-mm`` +\n    frozen_compressed) routes the forward through :meth:`linear_apply`, which\n    fuses decode into a register-A WGMMA GEMM (the U4-RS kernel). For batch /\n    token counts above the per-shape :meth:`_fused_max_n_for` threshold it falls\n    back to decompress + ``F.linear`` (faster in the prefill / compute-bound\n    regime). The palette-only fused decode mishandles the rare out-of-palette\n    exceptions (~0.01% of weights), so an exact sparse correction is ALWAYS\n    applied after the fused GEMM, making the fused path bit-exact.\n\n    The threshold is PER-SHAPE (:attr:`_FUSED_MAX_N_TABLE`), looked up by\n    :meth:`_fused_max_n_for`.\n    \"\"\"\n\n    HAS_FUSED_MM = True\n\n    # Per-(M,K) fused-decode N threshold (0 = never fuse this shape).  Measured\n    # by bench_rs_projections.py (fused U4-RS vs decompress+cuBLAS on the real\n    # Llama-70B projection shapes): the kernel pads N to a 64-row WGMMA tile, so\n    # fused beats decompress+cuBLAS at one full tile (N<=64) for O/Down, through\n    # N=128 for GateUp (huge M -> Npad=128 still wins), and never for QKV (cheap\n    # decode + slow fused GEMM lose at every N).  Above the threshold the padded\n    # tile is wasted work and cuBLAS wins, so fall back to decompress + F.linear.\n    # Re-wired 2026-06-10 from benchmark_codec_decision.py (H2D-contended; fused\n    # incl split-K). Earlier values were from an isolated bench (no H2D overlap).\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused wins or is a noise-level tie (<=2%) vs decmp\n        # under H2D.\n        (10240, 8192): 0,     # QKV    (never)\n        (8192,  8192): 64,    # O      (clear win at 64 via split-K)\n        (57344, 8192): 0,     # GateUp (was 128; no clear win, only loose ties)\n        (8192, 28672): 64,    # Down   (split-K win <=64; jumps to +13% at 96)\n    }\n\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\n        super().__init__(comp_stream)\n        # Per-shape fused-N threshold lives in _fused_max_n_for / _FUSED_MAX_N_TABLE.\n        # tests/benchmarks may set this instance attr directly to force-fuse at all N.\n        self._fused_max_n_override = None\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-shape fused N threshold (0 = never fuse this shape); unknown shapes\n        fall back to 64 (the one-full-WGMMA-tile sweet spot).  An instance-level\n\"\"\"P4Flat KV cache compressor.\n\nDrop-in ``kv_compressor`` for ``DualMemoryLoader`` that uses the BF16 P4-flat\ncodec (per-64x64-tile 16-entry exponent palette + 4-bit code + raw\nsign|mantissa byte, with out-of-palette exponents kept as an exception list).\nSelected with ``--kv-comp p4flat`` (``TIERED_SERVE_KV_COMP_BACKEND=p4flat``).\n\nLike :class:`DietGPUKVCompressor` the base :class:`P4FlatKVCompressor` is a\nGPU-kernel backend (no C++ worker threads): ``compress_batch_async`` launches\nthe compress + D2H on an internal CUDA stream and ``wait_compress_async``\nsynchronises it.  It serves the ``gpu_direct`` KV producer mode (the default\nfor ``--kv-comp p4flat``).  The ``cpu_after_raw_swap`` producer is served by\nthe :class:`P4FlatCPUKVCompressor` subclass below (CPU worker-pool encode);\nboth share the same GPU decode kernel and on-host storage layout.\n\nIt subclasses :class:`DietGPUKVCompressor` purely to reuse the codec-agnostic\npersistent-slot bookkeeping (``_assign_kv_slot`` / ``_free_kv_slot`` /\n``has_*`` / ``free_persistent_block`` / ``decompress_batch`` chunking).  The\nstorage layout and the codec are completely different and overridden below.\n\nStorage layout (per layer, per K and V), one dense pool of variable-length\ncompressed blobs indexed by physical slot:\n  - ``blob``       : pinned [host_n, max_comp_size] uint8.  Each row holds a\n    serialised compressed block ``[headers | codes | sm | codec |\n    exc_idx | exc_val]`` (or, on raw fallback, the raw BF16 bytes).\n  - ``total_size`` : pinned [host_n] int32 — used bytes of the blob row.\n  - ``exc_cnt``    : pinned [host_n] int32 — number of exceptions.\n  - ``is_raw``     : pinned [host_n] uint8 — 0 compressed, 1 raw BF16 stored\n    in-row, 2 raw BF16 retained only in secondary KV (tight-stride overflow).\n\nA KV block of shape ``block_shape`` is flattened to ``block_numel`` BF16\nelements and reshaped to a 2-D ``[M_b, K_b]`` matrix with both dims multiples\nof 64 (p4flat requires this).  The reshape is a contiguous view, so the codec\nstays bit-exact; the (M_b, K_b) factoring only affects the compression ratio.\n``block_numel`` must therefore be a multiple of 64*64 = 4096.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ctypes\nimport ctypes\nimport glob\nimport heapq\nimport logging\nimport os\nimport queue\nimport threading\nimport time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom typing import Any, Dict, List, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\n\nlogger = logging.getLogger(\"vllm\")  # configured/flushed handler (was __name__\n# = \"tiered_serve.*\" -> root, which suppressed INFO and split ERROR to stderr,\n# hiding [kv-decode]/MAPPING-DESYNC diagnostics from the server log file)\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:  # pragma: no cover - extension build/runtime issue\n    logger.warning(\n        \"P4FlatKVCompressor disabled: failed to load zipserv_p4flat_ext \"\n        \"(%s: %s)\", type(_e).__name__, _e)\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\ndef _align(n: int, a: int) -> int:\n    return (n + a - 1) // a * a\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Factor ``numel`` into ``(M_b, K_b)`` with both multiples of 64,\n    chosen as close to square as possible.  Raises if ``numel`` is not a\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03ca9-3b76-7243-a438-029569847e61","create_time":1787724128.601373}}}
