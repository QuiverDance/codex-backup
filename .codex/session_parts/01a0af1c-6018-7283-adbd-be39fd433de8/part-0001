s)\n    e2el_p50, e2el_p90, e2el_p95, e2el_p99 = _pcts(e2els_ms)\n\n    n_total = len(successful)\n    prefill_att = (\n        sum(1 for t in ttfts_ms if t <= TTFT_SLO_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_200_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_200_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_250_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_250_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    # Request-level attainment: a request is counted only if it meets BOTH the\n    # prefill (TTFT) and decode (TPOT) SLOs.\n    def _meets_slo(o: RequestFuncOutput, tpot_slo_ms: float) -> bool:\n        return o.ttft * 1000 <= TTFT_SLO_MS and o.tpot * 1000 <= tpot_slo_ms\n\n    request_200_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_200_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    request_250_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_250_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    # Server-side batch statistics over this benchmark window: parse the\n    # scheduler's per-step \"Schedule Info\" lines from server.log and split them\n    # into prefill-containing vs decode-only batches.\n    window_end = datetime.now()\n    window_start = window_end - timedelta(seconds=benchmark_duration)\n    batch_stats = _server_batch_stats(log_dir, window_start, window_end)\n    if batch_stats is not None:\n        bs = batch_stats\n        batch_cols = (\n            f\"{bs['n_batches']} \"\n            f\"{bs['prefill_pct']:.2f} {bs['decode_pct']:.2f} \"\n            f\"{bs['sz_avg']:.2f} {bs['sz_p50']:.2f} \"\n            f\"{bs['sz_p90']:.2f} {bs['sz_max']:.0f}\"\n        )\n    else:\n        batch_cols = \"NA NA NA NA NA NA NA\"\n\n    csv_header = (\n        \"request_rate \"\n        \"ttft_p50 ttft_p90 ttft_p95 ttft_p99 \"\n        \"tpot_p50 tpot_p90 tpot_p95 tpot_p99 \"\n        \"itl_p50 itl_p90 itl_p95 itl_p99 \"\n        \"e2el_p50 e2el_p90 e2el_p95 e2el_p99 \"\n        \"prefill_att(%) decode_200_att(%) decode_250_att(%) \"\n        \"request_200_att(%) request_250_att(%) \"\n        \"n_batches prefill_batch(%) decode_batch(%) \"\n        \"batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\"\n    )\n    write_header = not os.path.exists(csv_path)\n    with open(csv_path, \"a\") as cf:\n        if write_header:\n            cf.write(csv_header + \"\\n\")\n        cf.write(\n            f\"{request_rate} \"\n            f\"{ttft_p50:.2f} {ttft_p90:.2f} {ttft_p95:.2f} {ttft_p99:.2f} \"\n            f\"{tpot_p50:.2f} {tpot_p90:.2f} {tpot_p95:.2f} {tpot_p99:.2f} \"\n            f\"{itl_p50:.2f} {itl_p90:.2f} {itl_p95:.2f} {itl_p99:.2f} \"\n            f\"{e2el_p50:.2f} {e2el_p90:.2f} {e2el_p95:.2f} {e2el_p99:.2f} \"\n            f\"{prefill_att:.2f} {decode_200_att:.2f} {decode_250_att:.2f} \"\n            f\"{request_200_att:.2f} {request_250_att:.2f} \"\n            f\"{batch_cols}\\n\"\n        )\n    print(f\"Summary CSV row appended to {csv_path}\")\n\n    print(f\"Client benchmark results saved to {log_path}\")\n\n\nasync def benchmark(\n    task_type: TaskType,\n    endpoint_type: str,\n    api_url: str,\n    base_url: str,\n    model_id: str,\n    model_name: str,\n    tokenizer: TokenizerLike,\n    input_requests: list[SampleRequest],\n    logprobs: int | None,\n            f\"{ramp_up_end_rps} RPS over the duration of the benchmark.\"\n        )\n    else:\n        print(f\"Traffic request rate: {request_rate}\")\n\n    print(f\"Burstiness factor: {burstiness} ({distribution})\")\n    print(f\"Maximum request concurrency: {max_concurrency}\")\n\n    pbar = None if disable_tqdm else tqdm(total=len(input_requests))\n\n    semaphore = (\n        asyncio.Semaphore(max_concurrency)\n        if max_concurrency\n        else contextlib.nullcontext()\n    )\n\n    # SLO attainment(누적) 설정: summary.csv 의 request_{200,250}_att 와 동일 정의.\n    # 한 요청이 \"attained\" 되려면 (TTFT <= prefill SLO) 이고 (mean TPOT <= decode SLO)\n    # 여야 한다. decode SLO 두 기준(200/250ms)을 동시에 추적한다.\n    # prefill SLO 는 TS_PREFILL_SLO_MS(기본 2000), decode SLO 는\n    # TS_GOODPUT_SLO_MS(콤마 구분, 기본 200,250) 로 바꿀 수 있다.\n    ttft_slo_ms = float(os.environ.get(\"TS_PREFILL_SLO_MS\", \"2000\"))\n    slo_ms_list = [\n        float(x) for x in os.environ.get(\"TS_GOODPUT_SLO_MS\", \"200,250\").split(\",\")\n    ]\n    # slo_stats[\"total\"] = 완료(성공+실패) 요청 수, slo_stats[slo] = attained 수\n    slo_stats = {\"total\": 0}\n    for _slo in slo_ms_list:\n        slo_stats[_slo] = 0\n\n    # A stop target is a one-based SEND-ORDER prefix. Wait until every\n    # request in that prefix is terminal, rather than stopping when an\n    # arbitrary count of requests (or only request N) finishes. This prevents\n    # a slow earlier request from disappearing from the metric window.\n    completion_target = stop_after_request\n    prefix_terminal = [False] * completion_target\n    completed_prefix = 0\n    stop_event = asyncio.Event()\n\n    async def limited_request_func(request_func_input, session, pbar):\n        async with semaphore:\n            output = await request_func(\n                request_func_input=request_func_input, session=session, pbar=pbar\n            )\n            # 요청이 끝날 때마다 그 요청의 ttft/tpot 와 지금까지의 SLO attainment 출력.\n            # 분모는 완료된 모든 요청(실패 포함) — summary 의 전체 평균 정의와 일치.\n            slo_stats[\"total\"] += 1\n            if output.success:\n                out_len = output.output_tokens or request_func_input.output_len or 0\n                # mean TPOT (out_len<=1 이면 0 으로 본다; goodput 관례와 동일)\n                tpot = (\n                    (output.latency - output.ttft) / (out_len - 1)\n                    if out_len > 1\n                    else 0.0\n                )\n                ttft_ms = output.ttft * 1000.0\n                tpot_ms = tpot * 1000.0\n                prefill_ok = ttft_ms <= ttft_slo_ms\n                for slo in slo_ms_list:\n                    if prefill_ok and tpot_ms <= slo:\n                        slo_stats[slo] += 1\n\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n                    f\"ttft={ttft_ms:.1f}ms \"\n                    f\"tpot={tpot_ms:.1f}ms \"\n                    f\"| {attain}\"\n                )\n            else:\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\nrequest_rate ttft_p50 ttft_p90 ttft_p95 ttft_p99 tpot_p50 tpot_p90 tpot_p95 tpot_p99 itl_p50 itl_p90 itl_p95 itl_p99 e2el_p50 e2el_p90 e2el_p95 e2el_p99 prefill_att(%) decode_200_att(%) decode_250_att(%) request_200_att(%) request_250_att(%) n_batches prefill_batch(%) decode_batch(%) batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\n1.2 507.12 1425.50 2091.97 4466.85 157.93 208.90 233.40 303.62 106.98 332.90 427.71 1062.90 19434.34 73024.75 79239.53 100839.30 94.20 86.80 96.10 82.90 91.50 6395 15.50 84.50 37.39 36.00 56.00 71\nround\tcell\tcodec\tmode\tcd3_base_rows\tchunk\trequest_rate\tstop_after_request\tinstrumented\tclient_status\tserver_exit\tserver_stop\telapsed_sec\tresult_json\tbreakdown_log\tkv_metrics_csv\tinterval_summary_csv\tserver_log_dir\n1\tr01-cd3-kvcomp-c8192-q1p2-g16-d3\tcd3\tkvcomp\t16\t8192\t1.2\t1100\t0\t0\t0\tinterrupt\t1381\t/root/projects/tiered-serve/benchmark_results/serving_suite/20260917T102943Z/r01-cd3-kvcomp-c8192-q1p2-g16-d3/client/rate_1.2.json\t-\t-\t-\t/root/projects/tiered-serve/logs/serving/llama_3_1_70b_instruct/cao-cd3-fused/20260917_193055\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0af1c-aa8a-7ca3-90e1-09b9f766c5f4","create_time":1789644376.633622}}}
