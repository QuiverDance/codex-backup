parated method IDs (default: all)\n  --batches LIST          Comma/space-separated batches (default: 1,16,32,64,96,128)\n  --repeats N             Fresh-process repeats per method (default: 3)\n  --input-seq-len N       Random input tokens per request (default: 1020)\n  --gen N                 Tokens generated per request (default: 129)\n  --warmup N              Initial per-request token intervals excluded (default: 16)\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\n  --kv-backend NAME       KV codec for configurable kvcomp cells (default: p4flat)\n  --cd3-kv-delta-bits N   KV exponent delta width: 3 or 4 (default: 3);\n                          only cao-cd3-fused-kvcomp changes, weights stay 3-bit\n  --cd3-kv-decode-threads N     KV decoder threads: auto,64,128 (default: auto);\n                          weight decode threads are unchanged\n  --breakdown             Enable diagnostic per-forward timing and aggregated\n                          GPU breakdown CSVs plus per-engine-step KV-free\n                          timing CSVs with CD3 retirement phases and counters;\n                          layer/component intervals, waits and pipeline states\n                          (instrumented; not canonical perf)\n  --gpu-index N           Physical GPU used and checked (default: 0)\n  --numa-node N           NUMA memory node (default: 0)\n  --weight-huge-pages N   16 GiB pages assigned to weights (default: 14)\n  --max-idle-hbm-mib N    Maximum clean-state HBM use (default: 1024)\n  --cleanup-timeout SEC   Wait for clean state between runs (default: 120)\n  --output-root DIR       Suite logs/manifests directory\n  --start-from METHOD     Start at METHOD and run the remaining methods\n  --check-only            Run resource/config preflight and exit\n  --dry-run               Validate mappings and print commands only\n  -h, --help              Show this help\n\nExamples:\n  bash scripts/offline/run_performance_suite.sh\n  bash scripts/offline/run_performance_suite.sh --methods cao-cd3-fused,cao-p4flat-fused\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --batches 16,64,128\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --start-from flexgen-zipserv\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --dry-run\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nrequire_uint() {\n  local option=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${option} requires a non-negative integer: ${value}\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --methods)\n      (($# >= 2)) || die \"--methods requires a value\"\n      method_spec=\"${2//,/ }\"\n      read -r -a METHODS <<<\"${method_spec}\"\n      shift 2\n      ;;\n    --batches)\n      (($# >= 2)) || die \"--batches requires a value\"\n      batch_spec=\"${2//,/ }\"\n      read -r -a BATCHES <<<\"${batch_spec}\"\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --input-seq-len)\n      (($# >= 2)) || die \"--input-seq-len requires a value\"\n      INPUT_SEQ_LEN=\"$2\"\n      shift 2\n      ;;\n    --gen)\n      (($# >= 2)) || die \"--gen requires a value\"\n      GEN_TOKENS=\"$2\"\n      shift 2\n      ;;\n    --warmup)\n      (($# >= 2)) || die \"--warmup requires a value\"\n      WARMUP=\"$2\"\n      shift 2\n      ;;\n    --prefill-chunk)\n      (($# >= 2)) || die \"--prefill-chunk requires a value\"\n      PREFILL_CHUNK=\"$2\"\n      shift 2\n      ;;\n    --kv-backend)\n      (($# >= 2)) || die \"--kv-backend requires a value\"\n      KV_BACKEND=\"$2\"\n      shift 2\n      ;;\n    --cd3-kv-decode-threads)\n      (($# >= 2)) || die \"--cd3-kv-decode-threads requires a value\"\n      CD3_KV_DECODE_THREADS=\"$2\"\n      shift 2\n      ;;\n    --cd3-kv-delta-bits)\n      (($# >= 2)) || die \"--cd3-kv-delta-bits requires a value\"\n      CD3_KV_DELTA_BITS=\"$2\"\n      shift 2\n      ;;\n 