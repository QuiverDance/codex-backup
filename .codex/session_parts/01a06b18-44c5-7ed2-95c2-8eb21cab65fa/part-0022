    comp_key: [\n                    torch.cuda.Event(enable_timing=True, external=True)\n                    for _ in range(self.n_layers)\n                ]\n                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\")\n            }\n            for events in self.begin_frozen_decomp_events.values():\n                for ev in events:\n                    ev.record()\n            for events in self.end_frozen_decomp_timing_events.values():\n                for ev in events:\n                    ev.record()\n\n        # === Process each layer ===\n        buffer_id = 0\n        for idx, blk in enumerate(self.torch_model.decoder_blocks):\n            is_frozen = blk.is_frozen\n            uncomp_dict: Dict[str, torch.Tensor] = {}\n            comp_dict: Dict[str, CompressedTensor] = {}\n            frozen_comp_dict: Dict[str, CompressedTensor] = {}\n            frozen_split_dict: Dict[str, SplitStorageInfo] = {}\n\n            for name in self.tensor_names:\n                comp_key = self.tensor_to_component.get(name)\n                raw_mode = (\n                    self.layer_weight_comp[idx].get(\n                        comp_key, \"offload\")\n                    if comp_key else \"offload\")\n                mode = self._effective_mode(raw_mode, is_frozen)\n\n                leaf_name, _, tensor_name = name.rpartition(\".\")\n                leaf_module = blk.module.get_submodule(leaf_name)\n                target: torch.Tensor = getattr(\n                    leaf_module, tensor_name, None)\n                if target is None:\n                    raise RuntimeError(\n                        f\"Can't find {name} in {blk.module._get_name()}\")\n\n                if mode == \"offload\":\n                    # Always store uncompressed copy in DRAM.\n                    # After UVA conversion the param.data is a cuda view;\n                    # prefer the original CPU hugepage tensor stored by\n                    # immigrant_model_loader so secondary→primary copies\n                    # are proper H2D transfers.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n                    # When USE_WEIGHT_COMP=1, also store compressed copy\n                    if DualMemoryLoader.use_weight_comp:\n                        logger.info(\n                            f\"Compressing Decoder-{idx}.{name}\")\n                        with torch.cuda.stream(\n                                self.decomp_weight_stream):\n                            comped = self._compressor_for_cell(\n                                idx, comp_key, mode=mode).compress(\n                                target,\n                                temp_buffers[buffer_id][name])\n                            torch.cuda.synchronize()\n                            logger.info(\n                                f\"Decoder-{idx}.{name}: \"\n                                f\"Compression Ratio: \"\n                                f\"{target.nbytes/comped.nbytes:.2f}x\")\n                            comped.to_host(self.huge_page_allocator)\n                        comp_dict[name] = comped\n\n                elif mode == \"offload_uncompressed\":\n                    # Always store uncompressed in DRAM; skip compression\n                    # even when USE_WEIGHT_COMP=1.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n\n                elif mode == \"offload_compressed\":\n                    # Always store compressed in DRAM; also keep uncompressed\n                    # copy so prefill can bypass decompression.\n                    # Decompressed to primary buffer at inference time.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = target.data\n                    else:\n                        uncomp_dict[name] = target\n                    logger.info(\n                        f\"Compressing (offload_compressed) Decoder-{idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        comped = self._compressor_for_cell(\n                            idx, comp_key, mode=mode).compress(\n                            target,\n                            temp_buffers[buffer_id][name])\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: \"\n                            f\"Compression Ratio: \"\n                            f\"{target.nbytes/comped.nbytes:.2f}x\")\n                        comped.to_host(self.huge_page_allocator)\n                    comp_dict[name] = comped\n\n                elif mode == \"frozen_compressed\":\n                    # Compress on GPU, keep compressed data on GPU.\n                    # Weight may arrive in CPU hugepage (moved there during\n                    # load_weights to prevent HBM exhaustion when total frozen\n                    # weights exceed GPU capacity, e.g. GH200 unified memory).\n                    # After UVA conversion hugepage tensors report\n                    # device.type==\"cuda\", so check _on_hugepage to\n                    # distinguish genuine GPU tensors from UVA views.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing \"\n                        f\"{'Frozen' if is_frozen else 'FrozenCompressed'}\"\n                        f\" Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            # Copy weight into frozen_primary_buffer on\n                            # the same stream as compress to guarantee\n                            # ordering. On GH200, a copy from UVA\n                            # hugepages on the default stream may not be\n                            # visible to decomp_weight_stream without\n                            # explicit synchronization.\n                            gpu_target.copy_(target, non_blocking=False)\n                        comped = self._compressor_for_cell(\n                            idx, comp_key, mode=mode).compress(\n                            gpu_target, primary)\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: Compression Ratio: \"\n                            f\"{gpu_target.nbytes/comped.nbytes:.2f}x\")\n\n                    # Free the CPU hugepage source after compression.\n                    # After UVA conversion, target.data_ptr() is the\n                    # CUDA device pointer, not the CPU hugepage ptr\n                    # that the allocator tracks.  Use the original CPU\n                    # tensor stored by the model loader so the free\n                    # actually finds the allocation.\n                    if gpu_target is not target:\n                        cpu_data = getattr(target, '_tiered_serve_cpu_data',\n                                           target)\n                        self.huge_page_allocator.free(cpu_data)\n\n                    frozen_comp_dict[name] = comped\n\n                    # Redirect module param to this layer's parity-specific\n                    # decomp buffer (even layers→buf0, odd→buf1).  Bound\n                    # ONCE here at init; never reassigned, so the V1\n                    # piecewise CUDA graph can capture a stable pointer.\n                    delattr(leaf_module, tensor_name)\n                    setattr(leaf_module, tensor_name,\n                            torch.nn.Parameter(\n                                primary,\n                                requires_grad=False))\n\n                    # Install fused decompress+GEMM override if the user\n                    # enabled --fused-mm and the bound compressor exposes\n                    # a native fused kernel.  With fused_mm the dense\n                    # decompress kernel is skipped (see\n                    # decompress_frozen_tensors); the compressed buffer\n                    # is permanent HBM so no H2D is needed either.\n                    self._maybe_install_fused_mm(\n                        leaf_module, comped,\n                        self._compressor_for_cell(idx, comp_key, mode=mode),\n                        layer_id=idx,\n                        comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                        mode=\"frozen_compressed\", tensor_name=name)\n\n                elif mode == \"frozen_split\":\n                    # Compress on GPU, keep sign_mantissa on HBM,\n                    # move remaining buffers to LPDDR hugepage.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n        elif backend == \"zipserv_bf16\":\n            comp = ZipServCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n        elif backend == \"dietgpu_bf16\":\n            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n                \"\" if auto_ws is None\n                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"dietgpu_fp8\":\n            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n                \"\" if auto_ws is None\n                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n        elif backend == \"zipserv_fp8\":\n            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n            # (forked from LLM-bitfield-compressor, built in-tree). No\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"chunk_delta3\":\n            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n            comp = ChunkDelta3Compressor(stream)\n            logger.info(\n                \"Weight compressor [%s]: BF16 ChunkDelta3 \"\n                \"(CPU encode, GPU decode/fused-MM)\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06fdb-bce9-7970-aa53-f50e95e053c6","create_time":1788583239.6606238}},{"type":"reasoning","id":"rs_050cb4c536794460016a9b9d4a0d5887d198d52808b62b0ed5","summary":[],"encrypted_content":"gAAAAABqm51LwepPCwg0EdJ4RF6fGSBdpYB535D7NUi-gC93c-ZCfOW1CGAsE2scRoH6ZqTRNYqVIp1LDyvrH_bBqQZGrG3lZJ3oSDXYqWIGrN7WELCSqfwRmnSQZSV3Frqif7D2m_8a2wgKBGvwWvshB0_Sw8aEuTQGgB7U3NXMBO0B7CVdL6hDSvYOGfoaje6IgZxQMrmON_0npHlKna73o9jEkDC8wQjkIF3lopvIUbBbmnU3OwbzgodduOByf2k2hIEOdcQ9AbnIwOg9ttAdsBztwE9mRWwhN_eAahwqEX17XK7f3Ut7Tg5MYvMmKKVnbJFba-9kl6yMUHb4_WostonAxCoh8_C5AOBEh9njfpstQoYOoAn_AgNDYeGqb5XUIn2A29U1lW9-IUH1ucn8vma2PZ4Hd9F9htFV0evsKAPKtVeFR29HFzfm-xteaS4zYUo_yahEq0JwZVKcOdfStbnrJhRd6bIjbr6fX9CE7Gon8iuRVibcqkAv7fr8G29CrOJ57o60TTsBwSHoGvqFiIDLUMcg2WS8v3WRgdqsjyCZcbeLxqzinpxNTe1G0Dda2Bx-RSkKpHNXdN79DIxUrgukk2kMkW5g0Y8oAvXrTgXl8LfzumX-arQNmv7zvV079LLKOb9xaiPgg_Jee9TNOKh1jsgRSZmJUus6-sc6tBbkI2IODu_BkJ978MymNSgoCAHgQL9VbN2xRLzQtz-oE-aJ6izFoy-XANm2SFyVPYT64KATJOvsvnaxKdH6-0GofGrI-IcBkJtdGwMFwg6guDXBrOAxiRJUeNmaM0BDyAMhU18b24xAqKezlTZyYmQZJMK_bJYIuSDtq-bEyCVfWTrS3bKY4aUI2TmpxBeTif3wlizP8UxANBTeYtR3pPzJS6TZk5kRgibq7-zrKB-b4UiFZW_lgkwfvqRiffrC7FN5qvAxNwZ8LiR_VDsVkdaAM3t9bfG6gnd6PuqXt_byjCHY7rR-Sn8iBO0_zaPC9szVYXfJ5rQjfh0ttZla2aaMs0aWRqQXkdQ3SenYc0vCLKyjT_9es2xXWhyCWIRHzdh-Wv85_YiLVaTuHd1oy7CAECV5PQKWNV9fky8ok9kjDUWWfNd-tJ31nRxI_F9PbvcJn7KSqkUYGJIpG0wTAFq-Vp7kDKfbm01J1WrZjw6ntNyfsl23L_CaaoISsgd8Y5ycpyvkxJL-t0hdreg2valrvgu05bfBGAc9KaG3tTpX6LRqtAErLZxwE8pcHpxtUmnHww6LBxchj8WXV5CoRn0ChmQNlF2AqZ3R9JHYjIBhKMDrI8vnXJgRqPANkgWTm35jl5YRKQywwGGx-VrewzHby-1J4GDEVMgPaZPUewJKXstAVFDiPXzojaDlfMg9Ai9qLFDi4EaTTlBJSv9_LmjDy1Jsc4upo42zRxvT4yv9WafFAtXQg5Ar1GEdbe6BwCLpVElNSU5wKtjRVYmKJN-KaYIDqxfH41i9TEEZJ2mo2BfXwIQl-FJEBYqOAvOcIt1aseLy133ooK4M5jovBn2x9ofKKYBNeQR7Qmj0xjwVYx9_dY6wNJdu1ywIR2ahnQDaw_GuYDNMHd64QKkJUrdPVGMwP