 def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedTensor] = None,\n        _sync: bool = True,\n    ) -> CompressedTensor:\n        \"\"\"Compress ``weight`` and return a :class:`CompressedTensor`.\"\"\"\n\n    @abstractmethod\n    def decompress(\n        self,\n        comp: CompressedTensor,\n        output: Optional[torch.Tensor] = None,\n    ) -> torch.Tensor:\n        \"\"\"Decompress ``comp`` into ``output`` (allocated when ``None``).\"\"\"\n\n    # ------------------------------------------------------------------\n    #  Batched API (override for truly-batched kernels)\n    # ------------------------------------------------------------------\n\n    @abstractmethod\n    def compress_batch(\n        self,\n        weights: \"list[torch.Tensor]\",\n        decomp_output_tensors: \"Optional[list[torch.Tensor]]\" = None,\n        comp_output_tensors: \"Optional[list[CompressedTensor]]\" = None,\n        _sync: bool = True,\n    ) -> \"list[CompressedTensor]\":\n        \"\"\"Compress a batch of weights in a single launch.\n\n        Subclasses with a true batched primitive (e.g. nvcomp's\n        ``BatchedXXXCompressAsync``) should override this to avoid the\n        per-tensor host sync incurred by the default fallback.  The base\n        implementation (callable via ``super().compress_batch(...)``)\n        loops over :meth:`compress`.\n        \"\"\"\n        n = len(weights)\n        decomp_outs = decomp_output_tensors or [None] * n\n        comp_outs = comp_output_tensors or [None] * n\n        results: \"list[CompressedTensor]\" = []\n        for w, d_out, c_out in zip(weights, decomp_outs, comp_outs):\n            results.append(self.compress(w, d_out, c_out, _sync=_sync))\n        return results\n\n    @abstractmethod\n    def decompress_batch(\n        self,\n        comps: \"list[CompressedTensor]\",\n        outputs: \"Optional[list