  ok = _verify(w_gpu, dec)\n    del comp, dec, out\n    return Result(codec, wt_name, orig_bytes, comp_bytes,\n                  c_best * 1e3, d_best * 1e3, ok)\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Output formatting\n# ════════════════════════════════════════════════════════════════════\n\n# Tables are emitted single-space-separated with single-token headers (no\n# internal spaces, no alignment padding) so they paste straight into Excel\n# (Text-to-Columns -> space delimiter, or \"treat consecutive delimiters as one\").\n\ndef _print_table(rows):\n    if not rows:\n        print(\"(no results)\"); return\n    print(\"Codec Orig(MB) Comp(MB) Ratio C_ms D_ms C_GiB/s D_GiB/s OK\")\n    for r in rows:\n        print(f\"{r.codec} {r.orig/1024**2:.1f} {r.comp/1024**2:.1f} \"\n              f\"{r.ratio:.3f} {r.c_ms:.3f} {r.d_ms:.3f} \"\n              f\"{r.c_gbps:.2f} {r.d_gbps:.2f} {'OK' if r.ok else 'XX'}\")\n\n\ndef _print_summary(all_rows):\n    print(\"\\nSUMMARY (averaged across all weights)\")\n    by_codec = defaultdict(list)\n    for r in all_rows:\n        by_codec[r.codec].append(r)\n    print(\"Codec #W AvgRatio Avg_C_ms Avg_D_ms C_GiB/s D_GiB/s OK\")\n    import statistics as st\n    for codec, rs in by_codec.items():\n        n = len(rs)\n        n_ok = sum(1 for r in rs if r.ok)\n        print(f\"{codec} {n} {st.mean(r.ratio for r in rs):.3f} \"\n              f\"{st.mean(r.c_ms for r in rs):.3f} \"\n              f\"{st.mean(r.d_ms for r in rs):.3f} \"\n              f\"{st.mean(r.c_gbps for r in rs):.2f} \"\n              f\"{st.mean(r.d_gbps for r in rs):.2f} \"\n              f\"{n_ok}/{n}\")\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Per-weight driver\n# ════════════════════════════════════════════════════════════════════\n\ndef _bench_weight(t, name, selected, registry, get_inst, runs, no_cast):\n    \"\"\"Benchmark every applicable codec on one 2-D weight ``t`` (CPU tensor