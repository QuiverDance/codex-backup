sor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\n_BASE_ROWS = int(os.getenv(\"TIERED_SERVE_CD3_BASE_ROWS\", \"16\"))\nif _BASE_ROWS not in (1, 16, 32, 64):\n    raise ValueError(\n        \"TIERED_SERVE_CD3_BASE_ROWS must be 1, 16, 32, or 64\")\n\ntry:\n    from tiered_serve.cpp_exts import chunk_delta3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load chunk_delta3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_comp