_ctypes.RTLD_GLOBAL)\n    except OSError:\n        pass  # will fail later with a clearer error from the linker\n\n_csrc_dir = _os.path.join(_os.path.dirname(__file__), \"..\", \"..\", \"cpp_extensions\", \"csrc\")\n_zipserv_kernel_dir = _os.path.join(_csrc_dir, \"zipserv\")\n# After Phase 1 migration, codec-core .cu live under\n# tiered_serve/compression/cuda/ and fused MM kernels under\n# tiered_serve/compression/adapters/cuda/.  Headers (include/, zipserv/)\n# stay in cpp_extensions/csrc/ and are reached via the existing\n# _csrc_dir/_zipserv_kernel_dir extra_include_paths.\n_compression_dir = _os.path.join(\n    _os.path.dirname(__file__), \"..\", \"compression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old