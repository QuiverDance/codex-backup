nc = _nvcomp_include_dir()\n\n# ---------------------------------------------------------------------------\n# Parallel build: torch's JIT load() builds each extension sequentially, and\n# with only a handful of sources per extension a single heavy nvcc invocation\n# serialises the whole import.  Extensions have distinct names -> distinct\n# build dirs (FileBaton-locked individually), so building them concurrently\n# is safe.  TIERED_SERVE_BUILD_JOBS caps concurrent extension builds; each\n# build's internal ninja parallelism is capped via MAX_JOBS (unless the user\n# already set it) so the total stays around the core count.\n# ---------------------------------------------------------------------------\n_n_build_workers = int(_os.environ.get(\"TIERED_SERVE_BUILD_JOBS\", \"8\"))\n_old_max_jobs = _os.environ.get(\"MAX_JOBS\")\nif _old_max_jobs is None:\n    _os.environ[\"MAX_JOBS\"] = str(\n        max(2, (_os.cpu_count() or 8) // _n_build_workers))\n\n_build_pool = ThreadPoolExecutor(max_workers=_n_build_workers)\n_futures = {}\n\ndef _submit(name, **kwargs):\n    _futures[name] = _build_pool.submit(load, name=name, **kwargs)\n\n_submit(\n    \"huge_page_allocator\",\n    sources=[\n        \"cpp_extensions/csrc/huge_page_allocator.cpp\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\",\n        \"-O3\",\n        \"-std=gnu++17\",\n    ],\n    extra_ldflags=[f\"-L{sysconfig.get_config_var('LIBDIR')}\", \"-lcuda\"],\n)\n\n# Build before kv_offload_system\n_submit(\n    \"unload_worker_ext\",\n    sources=[\n        \"cpp_extensions/csrc/unload_worker_ext.cpp\",\n        \"cpp_extensions/csrc/utils.cpp\",\n    ],\n    extra_include_paths=[\n        \"cpp_extensions/csrc/include\"\n    ],\n    extra_cflags=[\"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\"],\n    with_cuda=True,\n    extra_ldflags=[\n        # \"-Wl,-rpath,/usr/lib/sbsa-linux-gnu/nvcomp/12\",\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        