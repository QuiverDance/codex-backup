u\",\n                                   \"ublb_flat\", \"ublb_tbe\", \"chunk_delta3\"):\n                _default_producer = \"cpu_after_raw_swap\"\n            elif (kv_comp_backend == \"p4flat\"\n                    and DualMemoryLoader.use_weight_comp):\n                _default_producer = \"cpu_after_raw_swap\"\n            else:\n                _default_producer = \"gpu_direct\"\n            kv_comp_producer = os.getenv(\n                \"TIERED_SERVE_KV_COMP_PRODUCER\", _default_producer).lower()\n            if kv_comp_producer not in (\"gpu_direct\", \"cpu_after_raw_swap\"):\n                raise ValueError(\n                    f\"Unknown TIERED_SERVE_KV_COMP_PRODUCER: \"\n                    f\"{kv_comp_producer!r}. Expected 'gpu_direct' or \"\n                    f\"'cpu_after_raw_swap'.\")\n            if kv_comp_backend in (\"zipserv\", \"p4flatcpu\", \"bitcompcpu\",\n                                   \"ublb_flat\", \"ublb_tbe\",\n                                   \"chunk_delta3\") and \\\n                    kv_comp_producer != \"cpu_after_raw_swap\":\n                logger.warning(\n                    \"%s is CPU-encode only; ignoring \"\n                    \"TIERED_SERVE_KV_COMP_PRODUCER=%s and forcing \"\n                    \"cpu_after_raw_swap.\", kv_comp_backend, kv_comp_producer)\n                kv_comp_producer = \"cpu_after_raw_swap\"\n            if (kv_comp_producer == \"cpu_after_raw_swap\"\n                    and kv_comp_backend not in\n                    (\"zipserv\", \"p4flat\", \"p4flatcpu\", \"chunk_delta3\",\n                     \"bitcomp\", \"bitcompcpu\", \"ublb_flat\", \"ublb_tbe\")):\n                raise ValueError(\n                    f\"TIERED_SERVE_KV_COMP_PRODUCER=cpu_after_raw_swap \"\n                    f\"requires TIERED_SERVE_KV_COMP_BACKEND in (zipserv, \"\n                    f\"p4flat, p4flatcpu, chunk_delta3, bitcomp, bitcompcpu) \"\n                    f\"(backend \"\n                    f\"{kv_comp_backend!r} is GPU-kernel based).\")\n            DualMemoryLoader.kv_comp_producer_mode = kv_comp_producer\n\n            # ── Backend instantiation (p4flat's encode side depends on the\n            #    producer mode resolved above) ──\n            if kv_comp_backend == \"dietgpu\":\n                from tiered_serve.dietgpu_kv_compressor import (\n                    DietGPUKVCompressor,\n                )\n                self.kv_compressor = DietGPUKVCompressor(self.decomp_kv_stream)\n                logger.info(\"KV compressor: DietGPU\")\n            elif kv_comp_backend == \"mantexp\":\n                # Mantissa/Exponent split: sm stays in HBM, exp is\n                # ANS-compressed and persisted in LPDDR (see\n                # tiered_serve/mantexp_kv_compressor.py).\n                if not self.mantexp_split_kv:\n                    logger.warning(\n                        \"KV backend 'mantexp' selected without \"\n                        \"TIERED_SERVE_MANTEXP_SPLIT_KV=1\")\n                from tiered_serve.mantexp_kv_compressor import (\n                    MantExpKVCompressor,\n                )\n                self.kv_compressor = MantExpKVCompressor(\n                    self.decomp_kv_stream)\n                logger.info(\"KV compressor: MantExp (split storage)\")\n            elif kv_comp_backend in (\"p4flat\", \"p4flatcpu\"):\n                # BF16 P4-flat codec (per-tile exponent palette).  Two encode\n                # backends share the same GPU decode kernel and storage layout:\n                #   gpu_direct         -> P4FlatKVCompressor    (GPU compress)\n                #   cpu_after_raw_swap -> P4FlatCPUKVCompressor (C++ OpenMP\n                #                         host_encode_blocks)\n                # ``p4flatcpu`` always selects the CPU encoder; bare ``p4flat``\n                # follows the producer mode (defaults to gpu_direct).\n                # See tiered_serve/p4flat_kv_compressor.py.\n                from tiered_serve.p4flat_kv_compressor import (\n                    P4FlatCPUKVCompressor,\n                    P4FlatKVCompressor,\n                )\n                if (kv_comp_backend == \"p4flatcpu\"\n                        or kv_comp_producer == \"cpu_after_raw_swap\"):\n                    self.kv_compressor = P4FlatCPUKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\n                        \"KV compressor: P4Flat (CPU encode, \"\n                        \"C++ OpenMP host_encode_blocks)\")\n                else:\n                    self.kv_compressor = P4FlatKVCompressor(\n                        self.decomp_kv_stream)\n                    logger.info(\"KV compressor: P4Flat (GPU encode)\")\n                # One-stream KV decode: point batch_decomp_stream straight at the\n                # compute stream (exec_stream) so the decode serializes with the\n                # GEMM.  Plain attribute reuse — no per-call stream resolution.\n    cao-zipserv-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ zipserv)\"\n      CONFIG_STEM=\"cao-zs-fused\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv --fused-mm)\n      ;;\n    cao-zipserv-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ zipserv)-kvcomp\"\n      CONFIG_STEM=\"cao-zs-kvcomp\"\n      EXPECTED_CODEC=\"zipserv\"\n      FEATURE_ARGS=(--weight-comp zipserv --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    cao-p4flat-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)\"\n      CONFIG_STEM=\"cao-p4-fused\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm)\n      ;;\n    cao-p4flat-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ p4flat)-kvcomp\"\n      CONFIG_STEM=\"cao-p4-kvcomp\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    cao-cd3)\n      METHOD_LABEL=\"C.A.O(w/ CD3)\"\n      CONFIG_STEM=\"cao-cd3-fused\"\n      EXPECTED_CODEC=\"