_ext\n\nzipserv_ext = _exts[\"zipserv_ext\"]\n\nzipserv_p4flat_ext = _exts[\"zipserv_p4flat_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4flat_ext'] = zipserv_p4flat_ext\n\nchunk_delta3_ext = _exts[_cd3_ext_name]\nsys.modules['tiered_serve.cpp_exts.chunk_delta3_ext'] = chunk_delta3_ext\n\nzipserv_ot_ext = _exts[\"zipserv_ot_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_ot_ext'] = zipserv_ot_ext\n\nzipserv_p4wg_ext = _exts[\"zipserv_p4wg_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4wg_ext'] = zipserv_p4wg_ext\n\nzipserv_p3flat_fp8_ext = _exts[\"zipserv_p3flat_fp8_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p3flat_fp8_ext'] = zipserv_p3flat_fp8_ext\n\nzipserv_p4d16_ext = _exts[\"zipserv_p4d16_ext\"]\nsys.modules['tiered_serve.cpp_exts.zipserv_p4d16_ext'] = zipserv_p4d16_ext\n\n#!/bin/bash\n\n# Turn off when error occurs\nset -e\n\n# 1. set environments\nexport CUDA_HOME='/usr/local/cuda'\nexport CMAKE_CUDA_COMPILER=\"$CUDA_HOME/bin/nvcc\"\n\n# 2. install cudnn\nwget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/sbsa/cuda-keyring_1.1-1_all.deb\ndpkg -i cuda-keyring_1.1-1_all.deb\napt-get update\n\napt-get -y install cudnn9-cuda-12\napt-get -y install cusparselt-cuda-12\n\n# 2. Make virtual envrionment\nrm -rf .venv\nuv venv --python 3.11\nsource .venv/bin/activate\n\n# 3. Pre-install requirement\nuv pip install numpy==1.26.4 cmake==3.* ninja setuptools typing-extensions wheel pybind11 pyyaml psutil\n\nuv pip install -e ../pytorch --no-build-isolation -v\n\nCMAKE_CUDA_COMPILER=$CMAKE_CUDA_COMPILER \\\nuv sync --no-build-isolation --preview\n\nuv pip uninstall torchvision\n\necho \"Build successful. \\\nTo use tiered-serve please execute \\\n'source .venv/bin/activate'\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06fdb-bce9-7970-aa53-f50e95e053c6","create_time":1788583127.0838263}},{"type":"reasoning","id":"rs_050cb4c536794460016a9b9cdb139c87d19944c60f2c99f5d9","summary":[],"content":null,"encrypted_c