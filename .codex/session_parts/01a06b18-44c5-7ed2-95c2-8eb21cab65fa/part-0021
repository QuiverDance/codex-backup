ntissa, thread_bases,\n                local_offsets, packed_per_stripe, counts, 64, K)\n            maximum = int(counts.max().item()) if stripes else 0\n            if maximum <= entry_capacity:\n                break\n            entry_capacity = min(\n                block_elements,\n                ((max(maximum, entry_capacity * 2) + 2) // 3) * 3)\n            if maximum > entry_capacity:\n                raise RuntimeError(\n                    \"ChunkDelta3 CPU weight exception count exceeds one \"\n                    f\"64-row stripe: {maximum} > {block_elements}\")\n\n        stripe_prefix = torch.zeros(stripes + 1, dtype=torch.int64)\n        stripe_prefix[1:] = torch.cumsum(counts.to(torch.int64), dim=0)\n        total = int(stripe_prefix[-1].item())\n        tile_offsets = torch.empty(\n            stripes * tiles_per_stripe + 1, dtype=torch.int32)\n        tile_offsets[:-1] = (\n            local_offsets[:, :-1].to(torch.int64)\n            + stripe_prefix[:-1, None]).reshape(-1).to(torch.int32)\n        tile_offsets[-1] = total\n\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.codes = codes.reshape(-1)\n        native.sign_mantissa = sign_mantissa.reshape(-1)\n        native.thread_bases = thread_bases.reshape(-1)\n        native.tile_exception_offsets = tile_offsets\n        native.entries20x3 = cls._pack_cpu_weight_entries(\n            packed_per_stripe, counts)\n        native.M = M\n        native.K = K\n        native.num_exceptions = total\n        return native\n\n    @staticmethod\n    def _stage_native_to_cuda(native, device: torch.device, stream) -> None:\n        with torch.cuda.stream(stream):\n            for attr in CompressedChunkDelta3Tensor._BUFFER_ATTRS:\n                setattr(native, attr, getattr(native, attr).to(device))\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedChunkDelta3Tensor] = None,\n        _sync: bool = True,\n    ) -> CompressedChunkDelta3Tensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"ChunkDelta3Compressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"ChunkDelta3Compressor expects a 2-D tensor, \"\n                f\"got {tuple(weight.shape)}\")\n        if weight.shape[0] % 64 or weight.shape[1] % 64:\n            raise ValueError(\n                \"ChunkDelta3Compressor requires dimensions divisible by 64, \"\n                f\"got {tuple(weight.shape)}\")\n\n        # Weight encode is a load-time CPU operation.  Keeping one production\n        # route avoids SM contention and guarantees that offline and serving\n        # use the same representation.\n        host_source = getattr(weight, \"_tiered_serve_cpu_data\", None)\n        if (not isinstance(host_source, torch.Tensor)\n                or host_source.device.type != \"cpu\"\n                or tuple(host_source.shape) != tuple(weight.shape)):\n            host_source = (weight.detach().cpu() if weight.is_cuda\n                           else weight.detach())\n        native = self._compress_cpu_native(host_source)\n        if weight.is_cuda:\n            stream = (self.comp_stream\n                      or torch.cuda.current_stream(weight.device))\n            self._stage_native_to_cuda(native, weight.device, stream)\n            if _sync:\n                stream.synchronize()\n        compressed = CompressedChunkDelta3Tensor(native)\n        if decomp_output_tensor is not None:\n            compressed.output_tensor = decomp_output_tensor\n        if _sync:\n            ratio = weight.nbytes / max(1, compressed.nbytes)\n            logger.info(\n                \"ChunkDelta3 compress [%dx%d]: ratio=%.3fx nbytes=%d \"\n                \"exceptions=%d\", compressed.M, compressed.K, ratio,\n                compressed.nbytes, compressed.num_exceptions)\n        return compressed\n\n    def decompress(\n        self,\n        comp: CompressedChunkDelta3Tensor,\n        output: Optional[torch.Tensor] = None,\n    ) -> torch.Tensor:\n        if not isinstance(comp, CompressedChunkDelta3Tensor):\n            raise TypeError(\n                \"ChunkDelta3Compressor.decompress expects \"\n                f\"CompressedChunkDelta3Tensor, got {type(comp).__name__}\")\n        output = output if output is not None else comp.output_tensor\n        if output is None:\n            if comp.sign_mantissa.device.type != \"cuda\":\n                raise RuntimeError(\n                    \"Host-resident ChunkDelta3 data must be staged before \"\n                    \"decompression\")\n            output = torch.empty(\n                (comp.M, comp.K), dtype=torch.bfloat16,\n                device=comp.sign_mantissa.device)\n        return _cd3_ext.decompress_chunk_delta3(comp._c, output)\n\n    # TensorCompressor supplies loop implementations but declares these\n    # methods abstract so concrete codecs must opt in explicitly.\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def decompress_batch(self, *args, **kwargs):\n        return super().decompress_batch(*args, **kwargs)\n\n    def build_split_shell(self, info, staging_dict):\n        if getattr(info, \"backend\", None) != \"chunk_delta3\":\n            raise NotImplementedError(\n                \"ChunkDelta3 build_split_shell requires chunk_delta3 data\")\n        native = _cd3_ext.CompressedChunkDelta3()\n        native.sign_mantissa = info.sign_mantissa\n        for attr in info.lpddr_attrs:\n            value = staging_dict.get(attr)\n            if value is None:\n                raise RuntimeError(\n                    f\"ChunkDelta3 staging slot missing {attr!r}\")\n            # FrozenSplit staging is allocated to the largest tensor of each\n            # projection/parity and reused by every layer.  Bind only this\n            # layer's live prefix: the native decoder validates exact buffer\n            # sizes (not capacity), especially for variable-size entries20x3.\n            numel = int(info.lpddr_numels[attr])\n            if value.numel() < numel:\nvoid host_encode_chunk_delta3_blocks(\n    torch::Tensor source,\n    torch::Tensor block_ids,\n    torch::Tensor slots,\n    torch::Tensor codes,\n    torch::Tensor sign_mantissa,\n    torch::Tensor thread_bases,\n    torch::Tensor tile_exception_offsets,\n    torch::Tensor entries20x3,\n    torch::Tensor num_exceptions,\n    int64_t rows,\n    int64_t columns)\n{\n    TORCH_CHECK(!source.is_cuda() && source.is_contiguous()\n                    && source.scalar_type() == at::kShort,\n                \"source must be contiguous CPU int16 BF16 storage\");\n    TORCH_CHECK(!block_ids.is_cuda() && block_ids.is_contiguous()\n                    && block_ids.dim() == 1\n                    && block_ids.scalar_type() == at::kLong,\n                \"block_ids must be contiguous CPU int64\");\n    TORCH_CHECK(!slots.is_cuda() && slots.is_contiguous()\n                    && slots.dim() == 1\n                    && slots.scalar_type() == at::kLong\n                    && slots.numel() == block_ids.numel(),\n                \"slots must be contiguous CPU int64 matching block_ids\");\n    TORCH_CHECK(rows > 0 && columns > 0\n                    && rows % kTileDim == 0\n                    && columns % kTileDim == 0,\n                \"host ChunkDelta3 dimensions must be positive multiples \"\n                \"of 64\");\n\n    const int64_t blocks = block_ids.numel();\n    if (blocks == 0) {\n        return;\n    }\n    const int64_t block_elements = rows * columns;\n    TORCH_CHECK(source.dim() >= 2 && source.size(0) > 0\n                    && source.numel() == source.size(0) * block_elements,\n                \"source shape is incompatible with rows*columns\");\n    const int64_t tiles_per_block =\n        (rows / kTileDim) * (columns / kTileDim);\n    const int64_t code_bytes = tiles_per_block * kCodeBytesPerTile;\n    const int64_t base_bytes = tiles_per_block * kBasesPerTile;\n    const int64_t host_slots = codes.size(0);\n\n    auto check_cpu_byte_2d = [host_slots](\n            const torch::Tensor& tensor, int64_t width, const char* name) {\n        TORCH_CHECK(!tensor.is_cuda()\n                        && tensor.scalar_type() == at::kByte\n                        && tensor.dim() == 2\n                        && tensor.size(0) == host_slots\n                        && tensor.size(1) == width\n                        && tensor.stride(1) == 1\n                        && tensor.stride(0) >= width,\n                    \"invalid host ChunkDelta3 \", name, \" buffer\");\n    };\n    check_cpu_byte_2d(codes, code_bytes, \"codes\");\n    check_cpu_byte_2d(\n        sign_mantissa, block_elements, \"sign_mantissa\");\n    check_cpu_byte_2d(thread_bases, base_bytes, \"thread_bases\");\n    TORCH_CHECK(!tile_exception_offsets.is_cuda()\n                    && tile_exception_offsets.scalar_type() == at::kInt\n                    && tile_exception_offsets.dim() == 2\n                    && tile_exception_offsets.size(0) == host_slots\n                    && tile_exception_offsets.size(1)\n                        == tiles_per_block + 1\n                    && tile_exception_offsets.stride(1) == 1\n                    && tile_exception_offsets.stride(0)\n                        >= tiles_per_block + 1,\n                \"invalid host ChunkDelta3 tile_exception_offsets buffer\");\n    TORCH_CHECK(!entries20x3.is_cuda()\n                    && entries20x3.scalar_type() == at::kLong\n                    && entries20x3.dim() == 2\n                    && entries20x3.size(0) == host_slots\n                    && entries20x3.size(1) > 0\n                    && entries20x3.stride(1) == 1\n                    && entries20x3.stride(0) >= entries20x3.size(1),\