OWS must be 1, 16, 32, or 64\")\nif _cd3_decode_threads not in (64, 128, 256):\n    raise ValueError(\n        \"TIERED_SERVE_CD3_DECODE_THREADS must be 64, 128, or 256\")\n_cd3_defines = [\n    f\"-DCD3_BASE_ROWS={_cd3_base_rows}\",\n    f\"-DCD3_DECODE_THREADS={_cd3_decode_threads}\",\n]\n_cd3_ext_name = (\n    f\"chunk_delta3_ext_g{_cd3_base_rows}_t{_cd3_decode_threads}\")\n\n# Pre-load libcuda.so so that CUDA driver symbols are available\ntry:\n    _ctypes.CDLL(\"libcuda.so\", mode=_ctypes.RTLD_GLOBAL)\nexcept OSError:\n    try:\n        _ctypes.CDLL(f\"/usr/lib/{_libarch}/libcuda.so\", mode=_ctypes.RTLD_GLOBAL)\n    except OSError:\n        pass  # will fail later with a clearer error from the linker\n\n_csrc_dir = _os.path.join(_os.path.dirname(__file__), \"..\", \"..\", \"cpp_extensions\", \"csrc\")\n_zipserv_kernel_dir = _os.path.join(_csrc_dir, \"zipserv\")\n# After Phase 1 migration, codec-core .cu live under\n# tiered_serve/compression/cuda/ and fused MM kernels under\n# tiered_serve/compression/adapters/cuda/.  Headers (include/, zipserv/)\n# stay in cpp_extensions/csrc/ and are reached via the existing\n# _csrc_dir/_zipserv_kernel_dir extra_include_paths.\n_compression_dir = _os.path.join(\n    _os.path.dirname(__file__), \"..\", \"compression\")\n_codec_cuda_dir = _os.path.join(_compression_dir, \"cuda\")\n_adapter_cuda_dir = _os.path.join(_compression_dir, \"adapters\", \"cuda\")\ndef _resolve_cutlass_include():\n    \"\"\"Find CUTLASS headers. Honor CUTLASS_INCLUDE_DIR first, then probe\n    common locations so users don't need to set the env var in typical setups.\"\"\"\n    env = _os.environ.get(\"CUTLASS_INCLUDE_DIR\")\n    if env:\n        return env\n    for candidate in (\n        _os.path.expanduser(\"~/cutlass/include\"),\n        \"/usr/local/cutlass/include\",\n        \"/opt/cutlass/include\",\n        \"/root/projects/cutlass/include\",  # legacy default\n    ):\n        if _os.path.isfile(_os.path.join(candidate, \"cute\", \"tensor.hpp\")):\n            return candidate\n    # Fall back to the legacy hardcoded path so the error message points\n    # at the original assumption rather than nothing.\n    return \"/root/projects/cutlass/include\"\n\n_cutlass_include = _resolve_cutlass_include()\n\n# Force the host-appropriate CUDA arch (SM_90a on Hopper, SM_120a on Blackwell);\n# suppress PyTorch's auto-detected arch list so the extension isn't\n# dual-compiled for the non-`a` variant (which lacks WGMMA / tcgen05).\n# (huge_page_allocator / unload_worker_ext have no .cu sources, so the forced\n# arch list is a no-op for them.)\n_old_arch_list = _os.environ.get(\"TORCH_CUDA_ARCH_LIST\")\n_os.environ[\"TORCH_CUDA_ARCH_LIST\"] = _os.environ.get(\n    \"TIERED_SERVE_CUDA_ARCH\", _default_cuda_arch)\n\n# SM_90a-only WGMMA kernels — built only on Hopper hosts. On Blackwell the\n# fused decompress+GEMM path falls back to the SM_120-compatible\n# zipserv_fused_mm_gpu.cu (ldmatrix + mma.m16n8k16) kernel.\n_is_hopper = _default_cuda_arch.startswith(\"9.\")\n_wgmma_sources = [\n    \"tiered_serve/compression/adapters/cuda/zipserv_fused_wgmma_sm90.cu\",\n        \"tiered_serve/compression/cuda/zipserv_p4flat.cu\",\n        \"tiered_serve/compression/adapters/cuda/zipserv_p4flat_fused_mm.cu\",\n        *_p4flat_wgmma_sources,\n    ],\n    with_cuda=True,\n    # CUTLASS include path needed for the WGMMA kernel's cute headers.\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir, _cutlass_include],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        # -mcpu=grace: target the GH200 Grace core (Neoverse V2, armv9-a + SVE2)\n        # for both ISA and pipeline tuning, so host_encode_blocks vectorises +\n        # schedules for V2.  -funroll-loops for the tight per-tile inner loops.\n        # (host integer encode -> byte-identical output.)\n        \"-mcpu=grace\", \"-funroll-loops\",\n        \"-fopenmp\",  # host_encode_blocks parallelises across KV blocks\n        *_wgmma_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n        *_wgmma_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\", \"-fopenmp\",\n    ],\n)\n\n_submit(\n    _cd3_ext_name,\n    sources=[\n        \"tiered_serve/compression/cuda/chunk_delta3_ext.cpp\",\n        \"tiered_serve/compression/cuda/chunk_delta3.cu\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n        \"-funroll-loops\", \"-fopenmp\", *_cd3_host_tune_flags,\n        *_cd3_defines,\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\", *_cd3_defines,\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        f\"-L/usr/lib/{_libarch}\",\n        \"-lcuda\", \"-fopenmp\",\n    ],\n)\n\n# ZipServ Offset-Table (OT) ablation codec — replaces ZipServ's bitmap\n# + __popcll dynamic addressing with explicit per-group offset tables.\n# Decoder-only ablation experiment; no fused MM, no WGMMA path.\n_submit(\n    \"zipserv_ot_ext\",\n    sources=[\n        \"tiered_serve/compression/adapters/cuda/zipserv_ot_ext.cpp\",\n        \"tiered_serve/compression/cuda/zipserv_ot.cu\",\n    ],\n    with_cuda=True,\n    extra_include_paths=[_csrc_dir, _codec_cuda_dir],\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\", \"-O3\", \"-std=gnu++17\",\n    ],\n    extra_cuda_cflags=[\n        \"--std=c++17\", \"-O3\", \"-Xptxas=-v\",\n            f\"-L/usr/lib/{_libarch}/{_nvcomp_libdir_rel}\" if _nvcomp_libdir_rel else f\"-L/usr/lib/{_libarch}\",\n            f\"-Wl,-rpath,/usr/lib/{_libarch}/{_nvcomp_libdir_rel}\" if _nvcomp_libdir_rel else f\"-Wl,-rpath,/usr/lib/{_libarch}\",\n            \"-lcuda\",\n            \"-lnvcomp\",\n        ],\n    )\nelse:\n    import logging as _logging\n    _logging.getLogger(\"vllm\").warning(\n        \"nvcomp_ext