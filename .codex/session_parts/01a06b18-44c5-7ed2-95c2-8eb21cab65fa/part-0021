pressor``, ``ZipServFP8GpuCompressor``) inherits from\n:class:`TensorCompressor` defined here.\n\nShared infrastructure provided by the base class:\n\n* ``self.comp_stream`` — per-instance CUDA stream for compress /\n  decompress.  Created on the current device when the caller does not\n  supply one (and ``None`` on CPU-only hosts).\n* :func:`TensorCompressor._jit_load_ext` — thin wrapper around\n  :func:`torch.utils.cpp_extension.load` that resolves source paths\n  under ``cpp_extensions/csrc`` so subclasses do not have to repeat\n  the same ``os.path.join(__file__, \"..\", ...)`` boilerplate.\n* :func:`TensorCompressor._log_compress_ratio` — uniform info-level log\n  line for compress operations.\n\nThe :class:`CompressedTensor` :class:`typing.Protocol` documents (and,\nunder ``isinstance`` checks, validates) the structural interface every\n``Compressed*Tensor`` class exposes to consumers.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Iterable, Optional, Protocol, runtime_checkable\n\nimport torch\n\n\nlogger = logging.getLogger(__name__)\n\n\n@runtime_checkable\nclass CompressedTensor(Protocol):\n    \"\"\"Structural protocol satisfied by every ``Compressed*Tensor`` class.\n\n    Attributes:\n        output_tensor: Optional pre-allocated decompress destination.\n\n    Properties:\n        total_compressed_size: Total bytes occupied by the compressed\n            payload(s).  Used for ratio logging and slot accounting.\n        nbytes: Alias for total_compressed_size where applicable.\n\n    Methods:\n        to(device): Return a copy of the compressed payload(s) staged on\n            the requested device (or update internal GPU buffers in place\n            for compressors that support it).\n    \"\"\"\n\n    output_tensor: Optional[torch.Tensor]\n\n    @property\n    def total_compressed_size(self) -> int: ...  # pragma: no cover\n\n    def to(self, device: Any) -> \"CompressedTensor\": ...  # pragma: no cover\n\n\nclass TensorCompressor(ABC):\n    \"\"\"Abstract base class for weight tensor compressors.\n\n    Subclasses must implement :meth:`compress` and :meth:`decompress`.\n    They may override :meth:`fused_mm` to provide a fused\n    decompress + GEMM kernel; otherwise the default implementation\n    decompresses then calls :func:`torch.mm`.\n\n    Two CUDA streams are provided so compress and decompress can run\n    concurrently (e.g. compressing layer N+1 while decompressing layer\n    N for matmul):\n\n    * ``self.comp_stream``   — used by :meth:`compress`.\n    * ``self.decomp_stream`` — used by :meth:`decompress` /\n      :meth:`fused_mm`.\n\n    Both default to freshly allocated :class:`torch.cuda.Stream` instances\n    on CUDA hosts and ``None`` on CPU-only hosts.  Either may be passed\n    explicitly by the caller (e.g. to share a stream with an upstream\n    pipeline stage).\n    \"\"\"\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        cuda_available = torch.cuda.is_available()\n        self.comp_stream = comp_stream or (\n            torch.cuda.Stream() if cuda_available else None\n        )\n        self.decomp_stream = decomp_stream or (\n            torch.cuda.Stream() if cuda_available else None\n        )\n\n    # ------------------------------------------------------------------\n    #  Required API\n    # ------------------------------------------------------------------\n\n    @abstractmethod\n   