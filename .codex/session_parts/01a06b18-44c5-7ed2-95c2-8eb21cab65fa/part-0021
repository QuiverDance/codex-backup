              y = (Cbuf[:N].float() + ycorr[:, :N].t()).to(torch.bfloat16)\n            else:\n                y = Cbuf[:N]\n        else:\n            wb, we = wdecomp_events if wdecomp_events else (None, None)\n            if wb is not None:\n                wb.record()\n            A = self.decompress(comp)\n            if we is not None:\n                we.record()\n            if A.device != x2.device:\n                A = A.to(x2.device)\n            y = F.linear(x2, A)\n        return y.reshape(*orig[:-1], M)\n\n    def build_split_shell(\n        self,\n        info,\n        staging_dict: Dict[str, torch.Tensor],\n    ) -> CompressedP4FlatTensor:\n        \"\"\"Construct a fused-MM-ready :class:`CompressedP4FlatTensor` whose\n        ``sign_mantissa`` is the HBM-permanent slice and whose remaining\n        codec buffers are aliased onto the layer's frozen-split staging\n        slot.  Used by the loader's ``--fused-mm`` install path so the\n        forward override can call ``linear_apply`` without first\n        materialising the dense weight.\n\n        ``staging_dict`` is ``self.frozen_split_staging[name][parity]``\n        — a dict of ``attr -> staging tensor`` populated by the H2D\n        producer every forward.  Tensors are *aliased*, not copied;\n        consumers must serialise against the H2D event chain that\n        decompress already waits on.\n        \"\"\"\n    BF16P4Flat_CompressBatchFinalize_Kernel<<<(unsigned)n, 256, 0, stream>>>(\n        d_in_base, d_block_ids, d_slots, d_blob_base, blob_stride,\n        d_exc_count, d_exc_scr_idx, d_exc_scr_val,\n        d_total_size, d_exc_cnt, d_is_raw, d_valid_rows,\n        block_numel, M, K, max_exc_pb, raw_bytes);\n    return cudaGetLastError();\n}\n\n/* ───────────────────────────────────────────────────────────────────\n *  GPU compress: one CTA per 64x64 tile.\n *\n *  Phase 1 — load BF16 tile to shared memory, extract sign|mantissa\n *  byte into global, increment a shared-mem histogram of e