             if prefill_tok > 0:\n                    n_prefill += 1\n                else:\n                    n_decode += 1\n    except OSError:\n        return None\n\n    n_batches = n_prefill + n_decode\n    if n_batches == 0:\n        return None\n    arr = np.array(batch_sizes) if batch_sizes else np.array([0])\n    return {\n        \"n_batches\": n_batches,\n        \"prefill_pct\": n_prefill / n_batches * 100,\n        \"decode_pct\": n_decode / n_batches * 100,\n        \"sz_avg\": float(np.mean(arr)),\n        \"sz_p50\": float(np.percentile(arr, 50)),\n        \"sz_p90\": float(np.percentile(arr, 90)),\n        \"sz_max\": float(np.max(arr)),\n    }\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06b19-7247-7012-bee1-1f6f985b101c","create_time":1788511780.0556083}}}
