     result_path = Path(row[\"result_json\"])\n        if not result_path.is_absolute():\n            result_path = Path.cwd() / result_path\n        with result_path.open() as handle:\n            result = json.load(handle)\n        server_log = Path(row[\"server_log_dir\"]) / \"server.log\"\n        steps = main_request_decode_steps(server_log)\n        cells.append(\n            {\n                **row,\n                \"tpot_ms\": float(result[\"median_tpot_ms\"]),\n                \"client_p90_tpot_ms\": float(result[\"p90_tpot_ms\"]),\n                \"failed\": int(result[\"failed\"]),\n                \"scheduler_steps_ms\": steps,\n                \"scheduler_p50_ms\": percentile(steps, 50) if steps else None,\n                \"scheduler_p90_ms\": percentile(steps, 90) if steps else None,\n            }\n        )\n    return run, cells\n\n\ndef summarize_w0(label, output_root):\n    run, cells = load_cells(output_root)\n    groups = defaultdict(list)\n    for cell in cells:\n        groups[(cell[\"codec\"], cell[\"mode\"])].append(cell)\n    rows = []\n    for (codec, mode), group in sorted(groups.items()):\n        steps = [v for cell in group for v in cell[\"scheduler_steps_ms\"]]\n        tpots = [cell[\"tpot_ms\"] for cell in group]\n        rows.append(\n            {\n                \"variant\": label,\n                \"codec\": codec,\n                \"mode\": mode,\n                \"repeats\": len(group),\n                \"scheduler_n\": len(steps),\n                \"scheduler_p50_ms\": percentile(steps, 50),\n                \"scheduler_p90_ms\": percentile(steps, 90),\n                \"tpot_median_ms\": percentile(tpots, 50),\n                \"tpot_p90_ms\": percentile(tpots, 90),\n                \"tpot_values_ms\": tpots,\n                \"failed\": sum(cell[\"failed\"] for cell in group),\n            }\n        )\n    by_codec_mode = {(r[\"codec\"], r[\"mode\"]): r for r in rows}\n    for codec in sorted({r[\"codec\"] for r in ro