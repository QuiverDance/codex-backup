 # decompress kernel is skipped (see\n                    # decompress_frozen_tensors); the compressed buffer\n                    # is permanent HBM so no H2D is needed either.\n                    self._maybe_install_fused_mm(\n                        leaf_module, comped,\n                        self._compressor_for_cell(idx, comp_key, mode=mode),\n                        layer_id=idx,\n                        comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                        mode=\"frozen_compressed\", tensor_name=name)\n\n                elif mode == \"frozen_split\":\n                    # Compress on GPU, keep sign_mantissa on HBM,\n                    # move remaining buffers to LPDDR hugepage.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n        elif backend == \"zipserv_bf16\":\n            comp = ZipServCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n        elif backend == \"dietgpu_bf16\":\n            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n                \"\" if auto_ws is None\n                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"dietgpu_fp8\":\n            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n                \"\" if auto_ws is None\n                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n        elif backend == \"zipserv_fp8\":\n            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n            # (forked from LLM-bitfield-compressor, built in-tree). No\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"chunk_delta3\":\n            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n            comp = ChunkDelta3Compressor(stream)\n            logger.info(\n                \"Weight compressor [%s]: BF16 ChunkDelta3 \"\n                \"(CPU encode, GPU decode/fused-MM)\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n                continue\n            if not all((layer, r) in role_numel for r in roles):\n                continue\n            best = max(best, sum(role_numel[(layer, r)] for r in roles))\n    return best\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Codec registry\n# ════════════════════════════════════════════════════════════════════\n#\n# name -> (dtype_kind, builder(stream)).  dtype_kind is \"bf16\" or \"fp8\";\n# builders are called lazily (the first weight that needs the codec) and the\n# instance is reused across all weights, so each codec's C++/CUDA extension is\n# JIT-built at most once.\n\ndef _build_registry():\n    from tiered_serve.compression.core import (\n        P4FlatCompressor, UBLBFlatCompressor, UBLBCompressor,\n        ZipServCompressor, DietGPUCompressor,\n        DietGPUFP8Compressor, ZipServFP8GpuCompressor,\n        ChunkDelta3Compressor,\n    )\n    return {\n        \"p4flat\":      (\"bf16\", lambda s: P4FlatCompressor(s)),\n        \"chunk_delta3\": (\"bf16\", lambda s: ChunkDelta3Compressor(s)),\n        \"ublb_flat\":   (\"bf16\", lambda s: UBLBFlatCompressor(s)),\n        \"ublb\":        (\"bf16\", lambda s: UBLBCompressor(comp_stream=s)),\n        \"zipserv\":     (\"bf16\", lambda s: ZipServCompressor(s)),\n        \"dietgpu\":     (\"bf16\", lambda s: DietGPUCompressor(s)),\n        \"dietgpu_fp8\": (\"fp8\",  lambda s: DietGPUFP8Compressor(s)),\n        \"zipserv_fp8\": (\"fp8\",  lambda s: ZipServFP8GpuCompressor(s)),\n    }\n\n\n# Default selection (the in-tree BF16 weight codecs).  ``ublb`` (nvcomp\n# gdeflate) is registered but off by default; add it with ``--codec``.\n_DEFAULT_BF16 = [\"p4flat\", \"ublb_flat\", \"zipserv\", \"dietgpu\"]\n_DEFAULT_FP8 = [\"zipserv_fp8\", \"dietgpu_fp8\"]\n\n\n# ════════════════════════════════════════════════════════════════════\n#  One benchmark result\n# ════════════════════════════════════════════════════════════════════\n\nclass Result:\n    __slots__ = (\"codec\", \"wt\", \"orig\", \"comp\", \"c_ms\", \"d_ms\", \"ok\")\n\n    def __init__(self, codec, wt, orig, comp, c_ms, d_ms, ok):\n        self.codec = codec; self.wt = wt\n        self.orig = orig; self.comp = comp\n        self.c_ms = c_ms; self.d_ms = d_ms; self.ok = ok\n\n    @property\n    def ratio(self):\n        return self.orig / self.comp if self.comp else 0.0\n\n    @property\n    def c_gbps(self):\n        return (self.orig / 1024**3) / (self.c_ms / 1e3) if self.c_ms else 0.0\n\n    @property\n    def d_gbps(self):\n        return (self.orig / 1024**3) / (self.d_ms / 1e3) if self.d_ms else 0.0\n\n\ndef _verify(w, dec):\n    \"\"\"Bit-exact round-trip check (raw byte compare; codecs are lossless).\"\"\"\n    dec = dec.reshape(w.shape).contiguous()\n    view = torch.int16 if w.element_size() == 2 else torch.uint8\n    try:\n        return bool(torch.equal(w.view(view), dec.view(view)))\n    except RuntimeError:\n        # dtype/size mismatch fallback\n        return bool(torch.equal(w.cpu(), dec.cpu()))\n\n\ndef bench_codec(comp_obj, codec, wt_name, w_gpu, runs):\n    \"\"\"Round-trip ``w_gpu`` through ``comp_obj``; return a :class:`Result`.\n\n    Latency is the best (min) wall-clock of ``runs`` timed iterations, each\n    bracketed by ``torch.cuda.synchronize()`` (the compressors run on a private\n    ``comp_stream`` and sync internally, so wall-clock with a global sync is the\n    portable way to time them across every codec).\n    \"\"\"\n    M, K = w_gpu.shape\n    orig_bytes = w_gpu.numel() * w_gpu.element_size()\n    warmup = 2  # absorb first-call JIT / lazy-alloc / clock-ramp on each shape\n\n    # --- compress: warm up, then time, holding the last handle ---\n    comp = None\n    for _ in range(warmup):\n        comp = comp_obj.compress(w_gpu)\n    torch.cuda.synchronize()\n    c_best = float(\"inf\")\n    for _ in range(runs):\n        del comp\n        torch.cuda.synchronize(); t0 = time.perf_counter()\n        comp = comp_obj.compress(w_gpu)\n        torch.cuda.synchronize()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06fdb-bce9-7970-aa53-f50e95e053c6","create_time":1788583239.6606238}}}
