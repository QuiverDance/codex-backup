{"timestamp":"2026-09-05T04:40:44.455Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06fde-72a7-71d0-8b1b-6df632917971","call_id":"call_qyjh3dkc9CHaT1rPmmVyKftT","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Correctness coverage for the production ChunkDelta3 adapter.\"\"\"\nfrom __future__ import annotations\n\nfrom types import SimpleNamespace\n\nimport pytest\nimport torch\nimport torch.nn.functional as F\n\n\npytestmark = pytest.mark.skipif(\n    not torch.cuda.is_available(), reason=\"ChunkDelta3 requires CUDA\")\n\n\ndef _codec():\n    from tiered_serve.compression.core.chunk_delta3 import ChunkDelta3Compressor\n    return ChunkDelta3Compressor(torch.cuda.current_stream())\n\n\ndef _all_bf16_patterns() -> torch.Tensor:\n    bits = torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    # Transpose so each 16-value CD3 chunk spans many exponents.  A plain\n    # reshape groups equal exponents and never exercises the exception stream.\n    return (bits.view(torch.bfloat16).reshape(256, 256).t().contiguous()\n            .cuda())\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_serving_fused_threshold_override(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n\n\ndef test_projection_fused_threshold_override_takes_precedence(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"128\")\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N_QKV\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n    assert codec._fused_max_n_for(8192, 8192) == 128\n    assert codec._fused_max_n_for(57344, 8192) == 128\n    assert codec._fused_max_n_for(8192, 28672) == 128\n\n\ndef test_split_shell_narrows_shared_staging_capacity() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(29)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    lpddr = {\n        attr: getattr(compressed, attr)\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n    }\n    info = SplitStorageInfo(\n        compressed.sign_mantissa,\n        lpddr,\n        {\n            \"M\": compressed.M,\n            \"K\": compressed.K,\n            \"num_exceptions\": compressed.num_exceptions,\n        },\n        backend=\"chunk_delta3\",\n        hbm_buffers={\n            \"tile_exception_offsets\": compressed.tile_exception_offsets,\n        },\n    )\n    staging = {}\n    for attr, source in lpddr.items():\n        capacity = source.numel() + 17\n        staging[attr] = torch.empty(\n            capacity, dtype=source.dtype, device=source.device)\n        staging[attr][:source.numel()].copy_(source.reshape(-1))\n\n    shell = codec.build_split_shell(info, staging)\n    for attr, source in lpddr.items():\n        assert getattr(shell._c, attr).numel() == source.numel()\n    restored = codec.decompress(shell)\n    torch.cuda.synchronize()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    _assert_bit_exact(restored, weight)\n\n\ndef test_frozen_split_keeps_offsets_with_sign_mantissa_in_hbm() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_cpu_weight_encode_stages_and_roundtrips_bit_exact() -> None:\n    codec = _codec()\n    generator = torch.Generator().manual_seed(911)\n    source = torch.randn(\n        256, 256, generator=generator, dtype=torch.float32\n    ).to(torch.bfloat16).contiguous()\n\n    compressed = codec.compress(source)\n    assert compressed.sign_mantissa.device.type == \"cpu\"\n    output = torch.empty(source.shape, dtype=source.dtype, device=\"cuda\")\n    compressed.register_temp_d_tensor(output)\n    compressed.to(non_blocking=False)\n    restored = codec.decompress(compressed, output)\n    torch.cuda.synchronize()\n\n    _assert_bit_exact(restored.cpu(), source)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\n@pytest.mark.parametrize(\"split_h2d\", [False, True])\ndef test_cpu_kv_backend_async_roundtrip_and_pending_free(\n        split_h2d: bool) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        if split_h2d:\n            compressor.load_kv_stream = torch.cuda.Stream()\n            compressor._kv_split_min_bytes = 0\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        # Freeing an ID after enqueue must quarantine its captured slot; the\n        # retiring worker may finish writing it but must not republish it.\n        compressor.free_persistent_block(0, 1)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        prepared = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared, torch.tensor(prepared).numpy())\n        initial_active_version = compressor._prepared_active_version\n        compressor.decompress_batch(\n            0, prepared, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        plan = compressor._decode_plans[0]\n        assert plan.storage_rows == 2\n        assert not plan.offsets_are_compact\n        # One retained pinned owner stages the output block ids. Exception\n        # entries themselves still reference persistent CSR directly.\n        assert len(plan.host_owners) == 1\n        assert plan.host_owners[0].tolist() == [3, 6]\n        source_ptrs = {source.data_ptr() for source in plan.host_entries}\n        assert compressor._persistent_csr[0][\"k\"].entries.data_ptr() \\\n            in source_ptrs\n        assert compressor._persistent_csr[0][\"v\"].entries.data_ptr() \\\n            in source_ptrs\n        assert plan.staged_bytes < 3 * compressor._body_stride * 2\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # A newly materialized list with identical content keeps the version;\n        # the held identity still proves that per-layer fast-path calls belong\n        # to the currently prepared step.\n        prepared_same = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared_same, torch.tensor(prepared_same).numpy())\n        assert compressor._prepared_active_version == initial_active_version\n        assert compressor._prepared_active_list is prepared_same\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        active = [2, 3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        assert compressor._prepared_active_version == initial_active_version + 2\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        compressor.free_persistent_block(0, 6)\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(v_cache[2].cpu(), host_v[2])\n        assert torch.count_nonzero(k_cache[6]).item() == 0\n        assert torch.count_nonzero(v_cache[6]).item() == 0\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\ndef test_cpu_kv_compact_row_matches_planner(monkeypatch) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n    from tiered_serve.kv_codec_spec import compressed_block_bytes\n    from tiered_serve.kv_codec_spec import (\n        chunk_delta3_body_stride,\n        chunk_delta3_exception_capacity,\n    )\n\n    monkeypatch.delenv(\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", raising=False)\n    monkeypatch.delenv(\n        \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\", raising=False)\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=1, n_layers=1,\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\n        expected_capacity = chunk_delta3_exception_capacity(16384)\n        expected_body_stride = chunk_delta3_body_stride(16384)\n        assert compressor._entry_capacity == expected_capacity\n        assert compressor._body_stride == expected_body_stride\n        assert \"body\" in compressor._host_pools[0][\"k\"]\n        assert \"blob\" not in compressor._host_pools[0][\"k\"]\n        assert set(compressor._gpu_decomp_pool[\"k\"]) == {\n            \"body\", \"entries20x3\", \"entry_word_offsets\"}\n        assert compressor._kv_split_min_bytes == expected_body_stride * 512\n        assert compressed_block_bytes(\"chunk_delta3\", 16384) == (\n            expected_body_stride + (expected_capacity // 3) * 8 + 4)\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\n\"\"\"Weight compress/decompress latency + throughput benchmark for tiered-serve's\nweight compressors, run against real model weights from the HuggingFace cache.\n\nReads safetensors shards for a model (a HF model id, e.g.\n``meta-llama/Llama-3.1-70B-Instruct``, resolved from the local hub cache — or\nexplicit ``.safetensors`` paths) and, by default, reconstructs the *fused*\nserving weights for each transformer layer the way tiered-serve runs them:\n\n    qkv     = cat(q_proj, k_proj, v_proj)   (e.g. 10240 x 8192)\n    o       = o_proj                        (e.g.  8192 x 8192)\n    gateup  = cat(gate_proj, up_proj)       (e.g. 57344 x 8192)\n    down    = down_proj                     (e.g.  8192 x 28672)\n\neach is then round-tripped through each selected tiered-serve weight codec\n(use ``--per-tensor`` to benchmark the raw, un-fused q/k/v/... weights instead):\n\n    p4flat     – P4FlatCompressor      (per-tile palette4, BF16)\n    chunk_delta3 – ChunkDelta3Compressor (per-chunk delta3, BF16)\n    ublb_flat  – UBLBFlatCompressor    (U4 flat, BF16, fused-MM)\n    ublb       – UBLBCompressor        (nvcomp gdeflate UB/LB split, BF16)\n    zipserv    – ZipServCompressor     (TCA-TBE triple bitmap, BF16)\n    dietgpu    – DietGPUCompressor     (ANS exponent codec, BF16)\n    dietgpu_fp8 / zipserv_fp8          (FP8 e4m3 weights)\n\nFor each (weight, codec) it reports the compression ratio, compress and\ndecompress latency (ms, best of N runs), the compress/decompress throughput\nover the original weight bytes (GiB/s, 1024^3), and a bit-exact round-trip\ncheck.  These codecs are lossless, so ``OK`` should always be ✓.\n\nRun from the tiered-serve repo root (PYTHONPATH not required — the script\nadds the repo root to sys.path itself):\n  python benchmarks/weight_compress.py meta-llama/Llama-3.1-70B-Instruct\n  python benchmarks/weight_compress.py <model-id> --layer 0\n  python benchmarks/weight_compress.py <model-id> --group qkv,down\n  python benchmarks/weight_compress.py <model-id> --codec p4flat,zipserv\n  python benchmarks/weight_compress.py <model-id> --per-tensor --key q_proj\n\nModelled on /root/projects/LLM-bitfield-compressor/scripts/compress_weights.py\nbut driven entirely through the production tiered-serve compressor classes.\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport re\nimport sys\nimport time\nfrom collections import OrderedDict, defaultdict\n\n# Allow running as `python benchmarks/weight_compress.py ...` from the repo root\n# (or anywhere) without needing PYTHONPATH — add the repo root (parent of this\n# benchmarks/ dir) to sys.path so `import tiered_serve` resolves.\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nif _REPO_ROOT not in sys.path:\n    sys.path.insert(0, _REPO_ROOT)\n\n# Reduce fragmentation OOMs when the GPU is shared with another process (e.g. a\n# serving run); must be set before torch initialises CUDA.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")\n\nimport torch\nfrom safetensors import safe_open\n\n\n# ════════════════════════════════════════════════════════════════════\n#  HuggingFace cache resolution  (model id -> safetensors shard paths)\n# ════════════════════════════════════════════════════════════════════\n\ndef _hf_cache_roots():\n    \"\"\"Candidate HuggingFace hub cache directories, in priority order.\"\"\"\n    roots = []\n    for env in (\"HF_HUB_CACHE\", \"HUGGINGFACE_HUB_CACHE\"):\n        if os.environ.get(env):\n            roots.append(os.environ[env])\n    if os.environ.get(\"HF_HOME\"):\n        roots.append(os.path.join(os.environ[\"HF_HOME\"], \"hub\"))\n    roots.append(os.path.expanduser(\"~/.cache/huggingface/hub\"))\n    seen, uniq = set(), []\n    for r in roots:\n        r = os.path.abspath(r)\n        if r not in seen and os.path.isdir(r):\n            seen.add(r); uniq.append(r)\n    return uniq\n\n\ndef _resolve_hf_model(model_id):\n    \"\"\"Return safetensors paths for a HF model id (``org/name``) from the cache.\n\n    Picks the most recently modified snapshot that holds ``.safetensors`` files.\n    \"\"\"\n    if \"/\" not in model_id:\n        raise FileNotFoundError(\n            f\"Model id must look like 'org/name' (got {model_id!r})\")\n    org, name = model_id.split(\"/\", 1)\n    dir_name = f\"models--{org}--{name}\"\n    snapshots = []\n    for root in _hf_cache_roots():\n        snap_root = os.path.join(root, dir_name, \"snapshots\")\n        if os.path.isdir(snap_root):\n            snapshots += [os.path.join(snap_root, s) for s in os.listdir(snap_root)\n                          if os.path.isdir(os.path.join(snap_root, s))]\n    if not snapshots:\n        raise FileNotFoundError(\n            f\"No HF cache entry for {model_id!r}. Searched: \"\n            f\"{', '.join(_hf_cache_roots()) or '(none)'}\")\n    snapshots.sort(key=os.path.getmtime, reverse=True)\n    for snap in snapshots:\n        files = sorted(glob.glob(os.path.join(snap, \"*.safetensors\")))\n        if files:\n            return files\n    raise FileNotFoundError(\n        f\"{model_id!r} is cached but has no .safetensors shards.\")\n\n\ndef _resolve_inputs(inputs):\n    \"\"\"Expand file paths and HF model ids into a flat list of shard paths.\"\"\"\n    out = []\n    for s in inputs:\n        if os.path.isfile(s) and s.endswith(\".safetensors\"):\n            out.append(s)\n        elif os.path.isfile(s):\n            sys.exit(f\"Unsupported file (need .safetensors): {s}\")\n        elif \"/\" in s and not os.path.exists(s):\n            try:\n                resolved = _resolve_hf_model(s)\n            except FileNotFoundError as e:\n                sys.exit(str(e))\n            print(f\"  Resolved HF model {s!r} -> {len(resolved)} shard(s) in \"\n                  f\"{os.path.dirname(resolved[0])}\")\n            out += resolved\n        else:\n            sys.exit(f\"Not found: {s}\")\n    return out\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Weight-key filtering\n# ════════════════════════════════════════════════════════════════════\n\n_PROJ_NAMES = (\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n               \"gate_proj\", \"up_proj\", \"down_proj\",\n               \".wq.\", \".wk.\", \".wv.\", \".wo.\", \".w1.\", \".w2.\", \".w3.\")\n\n\ndef _filter_keys(keys, key, all_weights, layer, max_weights, already):\n    if key:\n        keys = [k for k in keys if key in k]\n    elif not all_weights:\n        keys = [k for k in keys if any(p in k for p in _PROJ_NAMES)]\n    if layer is not None:\n        keys = [k for k in keys if f\"layers.{layer}.\" in k]\n    if max_weights > 0:\n        keys = keys[:max(0, max_weights - already)]\n    return keys\n\n\ndef _short_name(name):\n    return (name.replace(\"model.layers.\", \"L\")\n                .replace(\".self_attn.\", \".attn.\")\n                .replace(\".weight\", \"\"))\n\n\ndef _fp8_kind(dtype):\n    s = str(dtype).lower()\n    if \"float8\" not in s:\n        return None\n    return \"e4m3\" if \"e4m3\" in s else \"e5m2\" if \"e5m2\" in s else \"unknown\"\n\n\n# ════════════════════════════════════════════════════════════════════\n#  Fused serving-weight reconstruction  (qkv / o / gateup / down)\n# ════════════════════════════════════════════════════════════════════\n#\n# tiered-serve serves the merged projections that vLLM builds:\n#   QKVParallelLinear     -> qkv    = cat(q_proj, k_proj, v_proj, dim=0)\n#   MergedColumnParallel  -> gateup = cat(gate_proj, up_proj,     dim=0)\n#   o_proj / down_proj stay as-is.\n# We reconstruct those from the per-projection safetensors so the benchmark\n# shapes match the production weight layout (and the _FUSED_MAX_N_TABLE tuning).\n\n_LAYER_RE = re.compile(r\"layers\\.(\\d+)\\.\")\n\n_ROLE_PATS = (\n    (\"q_proj\", \"q\"), (\"k_proj\", \"k\"), (\"v_proj\", \"v\"), (\"o_proj\", \"o\"),\n    (\"gate_proj\", \"gate\"), (\"up_proj\", \"up\"), (\"down_proj\", \"down\"),\n    (\".wq.\", \"q\"), (\".wk.\", \"k\"), (\".wv.\", \"v\"), (\".wo.\", \"o\"),\n    (\".w1.\", \"gate\"), (\".w3.\", \"up\"), (\".w2.\", \"down\"),\n)\n\n#: Fused group name -> the projection roles concatenated along dim 0.\n_GROUP_DEFS = OrderedDict([\n    (\"qkv\", (\"q\", \"k\", \"v\")),\n    (\"o\", (\"o\",)),\n    (\"gateup\", (\"gate\", \"up\")),\n    (\"down\", (\"down\",)),\n])\n\n\ndef _role(key):\n    for pat, r in _ROLE_PATS:\n        if pat in key:\n            return r\n    return None\n\n\ndef _build_layer_index(shards, layer_filter):\n    \"\"\"Map ``layer_idx -> {role: (shard_path, key)}`` across all shards.\"\"\"\n    index = {}\n    for shard in shards:\n        with safe_open(shard, framework=\"pt\") as sf:\n            for k in sf.keys():\n                r = _role(k)\n                if r is None:\n                    continue\n                m = _LAYER_RE.search(k)\n                if m is None:\n                    continue\n                li = int(m.group(1))\n                if layer_filter is not None and li != layer_filter:\n                    continue\n                index.setdefault(li, {})[r] = (shard, k)\n    return index\n\n\ndef _load_layer(parts):\n    \"\"\"Load every projection tensor for one layer; ``role -> CPU tensor``.\"\"\"\n    by_shard = {}\n    for role, (shard, key) in parts.items():\n        by_shard.setdefault(shard, []).append((role, key))\n    out = {}\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for role, key in items:\n                out[role] = sf.get_tensor(key)\n    return out\n\n\ndef _max_fused_numel(index, group_filter):\n    \"\"\"Largest element count among the fused groups that will be benchmarked.\n\n    Reads tensor shapes from the safetensors header (no data load) so the\n    DietGPU ANS workspace can be pre-sized to the biggest single compress\n    input — otherwise it ``cudaMalloc``s a fresh temp buffer on every call\n    for large weights (e.g. fused gateup), biasing its compress timing.\n    \"\"\"\n    by_shard = {}\n    for layer, parts in index.items():\n        for role, (shard, key) in parts.items():\n            by_shard.setdefault(shard, []).append((layer, role, key))\n    role_numel = {}  # (layer, role) -> numel\n    for shard, items in by_shard.items():\n        with safe_open(shard, framework=\"pt\") as sf:\n            for layer, role, key in items:\n                n = 1\n                for d in sf.get_slice(key).get_shape():\n                    n *= d\n                role_numel[(layer, role)] = n\n    best = 0\n    for layer in index:\n        for gname, roles in _GROUP_DEFS.items():\n            if group_filter is not None and gname not in group_filter:\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06fdb-bce9-7970-aa53-f50e95e053c6","create_time":1788583244.4553118}}}
