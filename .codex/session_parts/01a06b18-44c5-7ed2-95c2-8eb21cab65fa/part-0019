 frozen_split_dict: Dict[str, SplitStorageInfo] = {}\n\n            for name in self.tensor_names:\n                comp_key = self.tensor_to_component.get(name)\n                raw_mode = (\n                    self.layer_weight_comp[idx].get(\n                        comp_key, \"offload\")\n                    if comp_key else \"offload\")\n                mode = self._effective_mode(raw_mode, is_frozen)\n\n                leaf_name, _, tensor_name = name.rpartition(\".\")\n                leaf_module = blk.module.get_submodule(leaf_name)\n                target: torch.Tensor = getattr(\n                    leaf_module, tensor_name, None)\n                if target is None:\n                    raise RuntimeError(\n                        f\"Can't find {name} in {blk.module._get_name()}\")\n\n                if mode == \"offload\":\n                    # Always store uncompressed copy in DRAM.\n                    # After UVA conversion the param.data is a cuda view;\n                    # prefer the original CPU hugepage tensor stored by\n                    # immigrant_model_loader so secondary→primary copies\n                    # are proper H2D transfers.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n                    # When USE_WEIGHT_COMP=1, also store compressed copy\n                    if DualMemoryLoader.use_weight_comp:\n                        logger.info(\n                            f\"Compressing Decoder-{idx}.{name}\")\n                        with torch.cuda.stream(\n                                self.decomp_weight_stream):\n                            comped = self._compressor_for_cell(\n                                idx, comp_key, mode=mode).compress(\n                                target,\n                                temp_buffers[buffer_id][name])\n                            torch.cuda.synchronize()\n                            logger.info(\n                                f\"Decoder-{idx}.{name}: \"\n                                f\"Compression Ratio: \"\n                                f\"{target.nbytes/comped.nbytes:.2f}x\")\n                            comped.to_host(self.huge_page_allocator)\n                        comp_dict[name] = comped\n\n                elif mode == \"offload_uncompressed\":\n                    # Always store uncompressed in DRAM; skip compression\n                    # even when USE_WEIGHT_COMP=1.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n\n                elif mode == \"offload_compressed\":\n                    # Always store compressed in DRAM; also keep uncompressed\n                    # copy so prefill can bypass decompression.\n                    # Decompressed to primary buffer at inference time.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = target.data\n                    else:\n                        uncomp_dict[name] = target\n                    logger.info(\n                        f\"Compressing (offload_compressed) Decoder-{idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        comped = self._compressor_for_cell(\n                            idx, comp_key, mode=mode).compress(\n                            target,\n                            temp_buffers[buffer_id][name])\n                        torch.cuda.synchronize()\n                        logger.info(\n                            f\"Decoder-{idx}.{name}: \"\n                            f\"Compression Ratio: \"\n                            f\"{target.nbytes/comped.nbytes:.2f}x\")\n                        comped.to_host(self.huge_page_allocator)\n                    comp_dict[name] = comped\n\n                elif mode == \"frozen_compressed\":\n                    # Compress on GPU, keep compressed data on GPU.\n                    # Weight may arrive in CPU hugepage (moved there during\n                    # load_weights to prevent HBM exhaustion when total frozen\n                    # weights exceed GPU capacity, e.g. GH200 unified memory).\n                    # After UVA conversion hugepage tensors report\n                    # device.type==\"cuda\", so check _on_hugepage to\n                    # distinguish genuine GPU tensors from UVA views.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing \"\n                        f\"{'Frozen' if is_frozen else 'FrozenCompressed'}\"\n                        f\" Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            # Copy weight into frozen_primary_buffer on\n                            # the same stream as compress to guarantee\n                            # ordering. On GH200, a copy from UVA\n                            # hugepages on the default stream may not be\n                            # visible to decomp_weight_stream without\n                            # explicit synchro