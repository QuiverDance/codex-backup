{"timestamp":"2026-09-05T04:38:57.088Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06fdc-cf40-7f31-a271-e49bf7a5af86","call_id":"call_fgzEcxEUCZ6COiGYh0qyenLE","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"BF16 P4-flat weight compressor.\n\nPer-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa byte.\nOut-of-palette exponents are stored as a separate (index, value) list and\nre-injected by a patch kernel during decompress — so the result is\nbit-exact-equivalent to the original BF16 weight.\n\nCompress runs on the GPU (one CTA per 64×64 tile).  Both compress and\ndecompress are delivered by the native PyTorch C++ extension\n``tiered_serve.cpp_exts.zipserv_p4flat_ext``.  No native fused\ndecompress+MM kernel: ``linear_apply`` falls through to the base class\ndefault (``decompress + F.linear``) which empirically beats every fused\nvariant on real LLM weights for decode-N shapes.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\nlogger = logging.getLogger(\"vllm\")\n\n\ntry:\n    from tiered_serve.cpp_exts import zipserv_p4flat_ext as _p4f_ext\n    _HAS_P4FLAT = True\nexcept Exception as _e:\n    logger.warning(\n        f\"P4FlatCompressor disabled: failed to load \"\n        f\"zipserv_p4flat_ext ({type(_e).__name__}: {_e})\")\n    _p4f_ext = None\n    _HAS_P4FLAT = False\n\n\nclass CompressedP4FlatTensor:\n    \"\"\"Container around the native :class:`CompressedP4Flat` struct.\n\n    Mirrors GPU/host tensor fields onto Python instance attrs so the loader\n    can iterate ``_BUFFER_ATTRS`` and stage them through a pool, matching\n    the pattern used by :class:`CompressedZipServFP8GpuTensor`.\n    \"\"\"\n\n    _BUFFER_ATTRS = (\n        \"headers\", \"codes\", \"sign_mantissa\",\n        \"subtile_codec\",\n        \"exc_indices\", \"exc_values\",\n        \"exc_sorted_indices\", \"exc_sorted_values\",\n        \"exc_group_m\", \"exc_group_offsets\",\n    )\n    # Pre-computed (attr, d_attr) pairs — avoids 10 f-string allocations\n    # per .to() / register_temp_d_tensor call (320 calls/step → 3200 fewer\n    # transient str objects per decode step).\n    _BUFFER_ATTR_D_PAIRS = tuple((a, f\"_d_{a}\") for a in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        # Cached narrow views into GPU staging buffers, created once in\n        # register_temp_d_tensor and reused by every .to() call.  Eliminates\n        # 10 view + 10 setattr(self._c, ...) per .to() call (320 calls/step\n        # → 6400 fewer transient Python objects per decode step).\n        self._h2d_views: Optional[tuple] = None\n        self._h2d_srcs: Optional[tuple] = None\n        self._gpu_buf_cache: Optional[tuple] = None\n        for attr in self._BUFFER_ATTRS:\n            setattr(self, attr, getattr(c_struct, attr))\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def num_groups(self) -> int:\n        return int(self._c.num_groups)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2  # BF16 = 2 bytes / element\n\n    def register_temp_d_tensor(self, temp_d: torch.Tensor,\n                               gpu_pool: Optional[Dict[str, torch.Tensor]] = None\n                               ) -> None:\n        \"\"\"Bind decompress destination + per-attr GPU staging slots.\n\n        Pre-creates narrow views into the GPU staging buffers and pushes\n        them into the C struct once, so the per-decode ``.to()`` only does\n        ``copy_`` — no f-strings, no view creation, no per-call setattr.\n        \"\"\"\n        self.output_tensor = temp_d\n        device = temp_d.device\n        views = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            src = getattr(self, attr)\n            if gpu_pool is not None and attr in gpu_pool:\n                dst = gpu_pool[attr]\n            else:\n                dst = torch.empty_like(src, device=device)\n            setattr(self, d_attr, dst)\n            n = src.numel()\n            view = dst[:n] if n > 0 else dst\n            views.append(view)\n            # Set C struct tensor pointer once — the view object is reused\n            # across decode steps, so the pointer never changes.\n            setattr(self._c, attr, view)\n        self._h2d_views = tuple(views)\n        self._h2d_srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n        self._gpu_buf_cache = None  # invalidate get_gpu_buffers cache\n\n    def to_host(self, huge_page_allocator=None\n                ) -> \"CompressedP4FlatTensor\":\n        \"\"\"Move all compressed buffers to pinned/hugepage CPU memory.\"\"\"\n        for attr in self._BUFFER_ATTRS:\n            gpu_tensor = getattr(self, attr)\n            if gpu_tensor.numel() == 0:\n                cpu_tensor = gpu_tensor.to(\"cpu\")\n            elif huge_page_allocator is not None:\n                gpu_tensor = gpu_tensor.contiguous()\n                try:\n                    hp_tensor = huge_page_allocator.allocate(\n                        gpu_tensor.shape, gpu_tensor.stride(),\n                        gpu_tensor.dtype, page_type=\"weight\")\n                    hp_tensor.copy_(gpu_tensor)\n                    cpu_tensor = hp_tensor\n                except (MemoryError, ValueError):\n                    logger.warning(\n                        \"Hugepage exhausted for P4Flat to_host (attr=%s); \"\n                        \"falling back to pinned memory\", attr)\n                    cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            else:\n                cpu_tensor = gpu_tensor.to(\"cpu\").pin_memory()\n            setattr(self, attr, cpu_tensor)\n            setattr(self._c, attr, cpu_tensor)\n        for _attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, d_attr, None)\n        self._h2d_views = None\n        self._h2d_srcs = None\n        self._gpu_buf_cache = None\n        import gc\n        gc.collect()\n        torch.cuda.empty_cache()\n        return self\n\n    def to(self, device=\"cuda\", non_blocking=True) -> None:\n        \"\"\"H2D copy CPU-resident buffers into pre-bound GPU staging slots.\n\n        Hot path: called ~320×/step (4 components × ~80 layers).  Uses\n        pre-cached narrow views and source tensors from\n        ``register_temp_d_tensor`` and dispatches ALL 10 copies in a single\n        C++ call (``batch_h2d``), eliminating 10 Python → C++ frame\n        transitions per call (~2880/step) that were the dominant source of\n        CPython frame data-stack 16 KiB boundary crossings (mmap/munmap).\n        \"\"\"\n        del device\n        views = self._h2d_views\n        if views is None:\n            raise RuntimeError(\n                \"CompressedP4FlatTensor.to(): call register_temp_d_tensor first\")\n        srcs = self._h2d_srcs\n        if srcs is None:\n            srcs = tuple(getattr(self, a) for a in self._BUFFER_ATTRS)\n            self._h2d_srcs = srcs\n        # Single C++ dispatch: copies all 10 (src, dst) pairs on the current\n        # CUDA stream without leaving this Python frame.\n        _p4f_ext.batch_h2d(srcs, views)\n\n    def get_gpu_buffers(self):\n        cache = self._gpu_buf_cache\n        if cache is not None:\n            return cache\n        views = self._h2d_views\n        if views is not None:\n            # Reuse the same narrow views created by register_temp_d_tensor\n            # — the data is updated in-place by .to(), so the views always\n            # reflect the latest GPU staging contents.\n            self._gpu_buf_cache = views\n            return views\n        out = []\n        for attr, d_attr in self._BUFFER_ATTR_D_PAIRS:\n            n = getattr(self, attr).numel()\n            dst = getattr(self, d_attr)\n            out.append(dst[:n] if n > 0 else dst)\n        cache = tuple(out)\n        self._gpu_buf_cache = cache\n        return cache\n\n\nclass P4FlatCompressor(TensorCompressor):\n    \"\"\"BF16 P4-flat weight compressor backed by tiered-serve's\n    ``zipserv_p4flat_ext`` PyTorch C++ extension.\n\n    Per-tile 16-entry exponent palette + 4-bit code + raw sign|mantissa\n    byte. Out-of-palette exponents are stored as a separate (index,\n    value) list and reinjected by the patch kernel during decompress\n    — so the result is bit-exact-equivalent to the original BF16\n    weight.\n\n    Compress runs on the GPU (one CTA per 64x64 tile).  M and K must be\n    multiples of 64.\n\n    With ``HAS_FUSED_MM = True`` the inference hot path (``--fused-mm`` +\n    frozen_compressed) routes the forward through :meth:`linear_apply`, which\n    fuses decode into the P4-RS register-A WGMMA GEMM (the same RS-mode recipe\n    as ublb-flat, applied to the p4flat codec).  For token counts above the\n    per-shape :meth:`_fused_max_n_for` threshold it falls back to decompress +\n    ``F.linear`` (faster in the prefill / compute-bound regime).  The fused path\n    is bit-exact: the rare out-of-palette exceptions (decoded with a wrong\n    exponent on the RS kernel) are restored by a sparse rank-1 correction\n    (``p4_exc_correct``).\n    \"\"\"\n\n    HAS_FUSED_MM = True\n    _warned_exc = False\n\n    def __init__(self, comp_stream: Optional[torch.cuda.Stream] = None):\n        super().__init__(comp_stream)\n        if not _HAS_P4FLAT:\n            raise RuntimeError(\n                \"P4FlatCompressor requires tiered-serve's \"\n                \"P4FlatCompressor requires tiered-serve's \"\n                \"zipserv_p4flat_ext extension to build successfully.\")\n        # Per-shape fused threshold lives in _fused_max_n_for / _FUSED_MAX_N_TABLE.\n        # tests/benchmarks may set this instance attr directly to force-fuse at\n        # all N.  ``decompress`` runs on the current stream (no comp_stream\n        # switch), CUDA-graph capture-safe, so a captured decode batch above a\n        # shape's threshold can fall back to decompress without breaking capture.\n        self._fused_max_n_override = None\n\n    def compress(\n        self,\n        weight: torch.Tensor,\n        decomp_output_tensor: Optional[torch.Tensor] = None,\n        comp_output_tensor: Optional[CompressedP4FlatTensor] = None,\n        _sync: bool = True,\n    ) -> CompressedP4FlatTensor:\n        del comp_output_tensor\n        if weight.dtype != torch.bfloat16:\n            raise TypeError(\n                f\"P4FlatCompressor expects bfloat16, got {weight.dtype}\")\n        if weight.ndim != 2:\n            raise ValueError(\n                f\"P4FlatCompressor expects a 2-D tensor, got {tuple(weight.shape)}\")\n\n        c_struct = _p4f_ext.compress(weight)\n        comp = CompressedP4FlatTensor(c_struct)\n        if decomp_output_tensor is not None:\n            comp.output_tensor = decomp_output_tensor\n        if _sync:\n            ratio = weight.nbytes / max(1, comp.nbytes)\n            logger.info(\n                f\"P4Flat compress [{comp.M}x{comp.K}]: ratio={ratio:.2f}x  \"\n                f\"nbytes={comp.nbytes}  num_exceptions={comp.num_exceptions}\")\n        return comp\n\n    def decompress(\n        self,\n        comp: CompressedP4FlatTensor,\n        output: Optional[torch.Tensor] = None,\n        *,\n        begin_event: Optional[torch.cuda.Event] = None,\n        end_event: Optional[torch.cuda.Event] = None,\n    ) -> torch.Tensor:\n        if not isinstance(comp, CompressedP4FlatTensor):\n            raise TypeError(\n                f\"P4FlatCompressor.decompress expects CompressedP4FlatTensor, \"\n                f\"got {type(comp).__name__}\")\n        if output is None:\n            output = comp.output_tensor\n        # Single (current) stream — no comp_stream switch.  The decompressed\n        # weight is consumed immediately by the caller (F.linear), so running\n        # the decompress on a separate stream buys no overlap; it only (a) broke\n        # CUDA-graph capture (\"operation not permitted when stream is\n        # capturing\", since comp_stream isn't part of the capture) and (b) left\n        # a cross-stream ordering gap vs the consuming GEMM.  Running on the\n        # current stream is capture-safe and keeps decompress -> GEMM correctly\n        # ordered.  Timing events, when provided, record on the current stream.\n        if begin_event is not None:\n            begin_event.record()\n        result = _p4f_ext.decompress(comp._c, output)\n        if end_event is not None:\n            end_event.record()\n        return result\n\n    def compress_batch(self, *args, **kwargs):\n        return super().compress_batch(*args, **kwargs)\n\n    def decompress_batch(self, *args, **kwargs):\n        return super().decompress_batch(*args, **kwargs)\n\n    # Per-(M, K) fused threshold: use the P4-RS fused kernel for N <= value,\n    # else decompress + cuBLAS.  These MUST be tuned in the engine, not in an\n    # isolated GEMM bench: decomp+cuBLAS writes the full reconstructed BF16\n    # weight to HBM (O 134MB, Down 470MB, GateUp 940MB), and in the serving\n    # engine that write contends with the concurrent weight-offload H2D on the\n    # HBM write path.  An isolated sweep (/tmp/thr_sweep.py) has no H2D overlap\n    # so it wrongly favours decomp for O/Down; in-engine batch-128 the fused\n    # path (no HBM write, no contention) is faster for O/GateUp/Down.  Measured\n    # in-engine (vllm_offload_kvweight --batch 128):\n    # In-engine TPOT (vllm_offload_kvweight --batch N), measured 2026-06-05:\n    #   batch 128: O/GU/Down fused, QKV decomp = 189.65ms (all-fused incl QKV\n    #     192.30 -> QKV's RS kernel is too slow even with contention; decomp\n    #     O/Down per isolated-optimal = 194.20 -> WORSE, contention dominates).\n    #   batch 256: GU/Down fused (256) = 321.67 vs GU/Down decomp (192) = 331.11\n    #     -> fusing wins by 9.4ms even at N=256 (isolated bench says decomp here,\n    #     but the engine HBM-write contention flips it).\n    # That measurement supported fusing O/GateUp/Down broadly, but keep the\n    # live table scoped to the batch-128 serving range we are validating now;\n    # N>256 (prefill) decompresses anyway via fallback.\n    # The isolated+H2D benchmark below crossed over to decompress+cuBLAS earlier\n    # for O/Down, but the batch-128 serving trace regressed in exactly that\n    # region: dense materialization pushes the frozen-weight scheduling gap into\n    # every decode graph.  Keep QKV conservative, but restore O/Down to the\n    # in-engine batch-128 fused range.\n    _FUSED_MAX_N_TABLE = {\n        # Policy: fuse where fused WINS or is a noise-level TIE (<=2%) vs decmp\n        # under H2D -- a tie favours fused anyway (no dense-weight HBM write).\n        #\n        # QKV fuses (=64) like the rest.  The fused path is the RS kernel (approx) + a\n        # SEPARATE p4_exc_correct kernel (one block per out-of-palette exception);\n        # decompress pays no exception cost, so a HIGH-exception layer can flip\n        # fused below decomp.  But a PER-LAYER, real-weight sweep (all 80 Llama-70B\n        # layers @ N=64, H2D) showed fused WINS 78/80 QKV layers (~1.13x); only the\n        # 2 extreme early layers lose (layer0 314k exc -> 0.44x, layer1 39k ->\n        # 0.96x).  O 77/80 (3 are noise-level ~1.0x), GateUp 80/80 (even layer0\n        # 113k exc wins 1.31x -- its 940MB avoided write swamps exceptions), Down\n        # 80/80.  We accept the 1-2 extreme-outlier layers (e.g. QKV layer0)\n        # being slower rather than gate per layer -- aggregate TPOT cost ~0.1%.\n        # (Earlier QKV=0 was a layer-0 sampling artifact: the isolated bench's\n        # real-weight loader only ever sees layer 0, the 314k outlier.  Most QKV\n        # layers have ~1.6k exceptions and fuse-win.)\n        # best-N re-derived by an 8-step N sweep on a representative (median-exc)\n        # real layer (layer 40, N=8..256, H2D).  Cliff is structural: at N>64 the\n        # small-M shapes (QKV/O/Down) remap to the slow Npad=192 WGMMA tile\n        # (_pad_n), so they lose past 64; GateUp's large M keeps a clean Npad=128\n        # and keeps winning to 128.  Ratios @best-N: QKV 1.12x, O 1.09x, GateUp\n        # 1.20x@128, Down 1.49x.\n        (10240, 8192): 64,    # QKV    (wins N<=64 ~1.12x; N>=96 -> Npad=192 cliff)\n        (8192, 8192): 128,    # O      (serving batch-128: avoid dense WDecomp)\n        (57344, 8192): 128,   # GateUp (was 64; wins to 128, big M -> Npad=128)\n        (8192, 28672): 128,   # Down   (serving batch-128: avoid dense WDecomp)\n    }\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        \"\"\"Per-layer fused N threshold (0 = never fuse this shape); unknown\n        shapes fall back to 128.  An instance-level ``_fused_max_n_override``\n        (set by tests/benchmarks) overrides all shapes.\n        \"\"\"\n        if self._fused_max_n_override is not None:\n            return self._fused_max_n_override\n        return self._FUSED_MAX_N_TABLE.get((M, K), 128)\n\n    def linear_apply(self, comp, x, wdecomp_events=None):\n        \"\"\"Fused decode + GEMM forward: y = x @ W^T, x [..., K] -> [..., M].\n\n        Uses the P4-RS register-A WGMMA kernel for decode-N (N <=\n        ``_fused_max_n``); falls back to decompress + ``F.linear`` for large N\n        (prefill) or non-aligned shapes. The codec's GPU-resident buffers live\n        on ``comp._c`` (kept current by both ``.to()`` and ``build_split_shell``).\n\n        ``wdecomp_events`` = optional ``(begin, end)`` external events bracketing\n        ONLY the fallback ``decompress`` so --time-breakdown WDecomp reflects it\n        (the fused branch leaves them unrecorded — its decomp is fused into the\n        GEMM and inseparable, so it correctly stays inside Compute).\n        \"\"\"\n        import torch.nn.functional as F\n        M, K = int(comp.M), int(comp.K)\n        orig = x.shape\n        # profile_run / non-capturing graph warmup skip the weight-load orchestration\n        # (_before_replay), so comp's frozen_split staging is UNINITIALIZED.\n        # The decompress fallback's exception patch then reads garbage\n        # exc_indices and writes output[garbage] -> illegal memory access (the\n        # fused kernel tolerates garbage staging but the decompress path does\n        # not).  Profile only needs the output SHAPE for memory accounting, so\n        # short-circuit to zeros there.  During CUDA graph capture, however, the\n        # real op must be captured; shared staging is zero-initialized for this.\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        _dm = getattr(DualMemoryLoader, \"_v1_dm_ref\", None)\n        if _dm is not None and (getattr(_dm, \"is_profiling\", False)\n                                or getattr(_dm, \"is_graph_warming_up\", False)):\n            _capturing = (getattr(_dm, \"_v1_fused_capturing\", False)\n                          or torch.cuda.is_current_stream_capturing())\n            if not _capturing:\n                return x.new_zeros(*orig[:-1], M)\n        x2 = x.reshape(-1, K)\n        N = int(x2.shape[0])\n        codes = comp._c.codes\n        sm = comp._c.sign_mantissa\n        headers = comp._c.headers\n        codec = comp._c.subtile_codec\n        use_fused = (M % 64 == 0 and K % 64 == 0\n                     and 0 < N <= self._fused_max_n_for(M, K)\n                     and x2.dtype == torch.bfloat16 and x2.is_cuda\n                     and codes.is_cuda)\n        # Bit-exact: out-of-palette exceptions (decoded with the wrong exponent\n        # by the RS kernel) get a sparse rank-1 correction in a tiny SEPARATE\n        # kernel. A separate kernel beats fusing the correction into the GEMM\n        # epilogue here — the RS GEMM is register-tight, and the in-epilogue\n        # correction's extra live registers cut the main-loop occupancy enough\n        # to slow the whole kernel by more than the saved launch. Needs the exc\n        # buffers GPU-resident; else fall back to exact decompress.\n        n_exc = int(comp.num_exceptions)\n        exc_idx = getattr(comp._c, \"exc_indices\", None)\n        exc_val = getattr(comp._c, \"exc_values\", None)\n        have_exc = (exc_idx is not None and exc_val is not None\n                    and exc_idx.is_cuda and exc_idx.numel() >= n_exc)\n        if use_fused and n_exc > 0 and not have_exc:\n            use_fused = False\n            if not P4FlatCompressor._warned_exc:\n                P4FlatCompressor._warned_exc = True\n                logger.warning(\n                    \"P4Flat fused exact correction needs exc buffers on GPU \"\n                    \"(%d exceptions); falling back to decompress+linear.\", n_exc)\n\n        if use_fused:\n            from tiered_serve.compression.core.ublb_tbe import (\n                _get_rs_ext, _u4_split_k, _empty_f32, _pad_n)\n            ext = _get_rs_ext()\n            Npad = _pad_n(N, M)\n            # Reuse per-shape padded-input (Bp) + output (Cbuf) scratch buffers\n            # across decode steps and layers instead of allocating them every\n            # call. In real serving decode-N varies step to step, so per-call\n            # torch.empty/zeros of varying size churns the CUDA caching allocator\n            # (cudaMalloc/cudaFree -> continuous mmap/munmap in nsys). Npad only\n            # takes a few values ({64,128,192,256}) so a tiny per-(Npad,M) pool\n            # eliminates the churn. Buffers are filled fresh each step and this\n            # fused op is opaque (graph-break) + consumed sequentially in decode,\n            # so sharing them is safe. Padding rows [N:Npad] don't affect the\n            # [:N] output (per-n independent GEMM), so Bp needs no re-zero.\n            sc = self.__dict__.setdefault(\"_fused_scratch\", {})\n            skey = (Npad, M, K, x2.device.index)\n            slot = sc.get(skey)\n            if slot is None:\n                slot = (torch.empty(Npad, M, dtype=torch.bfloat16, device=x2.device),\n                        torch.empty(Npad, K, dtype=torch.bfloat16, device=x2.device))\n                sc[skey] = slot\n            Cbuf, Bpb = slot\n            if Npad == N:\n                Bp = x2.contiguous()\n            else:\n                Bpb[:N].copy_(x2)\n                Bp = Bpb\n            # Cbuf[n, m] = sum_k W[m,k]*x[n,k] = F.linear(x, W)[n, m].\n            # Split-K fills the GPU at decode N (see ublb _u4_split_k); the\n            # production p4 path passes no in-kernel exceptions so split-K is safe.\n            sk = _u4_split_k(M, Npad, K)\n            # Split-K fp32 partials: pool like Cbuf/Bpb (keyed by sk too) instead\n            # of torch.empty every call -- the kernel overwrites all sk*Npad*M\n            # partials before the in-launch reduce, so reuse is safe, and at\n            # decode-N this churned the caching allocator (size scales with M, so\n       