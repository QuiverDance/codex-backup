{"timestamp":"2026-09-05T04:37:59.572Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06fdb-ee94-77f2-89b4-82b52266bb75","call_id":"call_NoBum2KtIZQmj94QwYYe7UHQ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Lossless BF16 ChunkDelta3 compressor.\n\nChunkDelta3 stores the sign and mantissa byte verbatim.  Codes remain in\n16-value row chunks inside a 64x64 tile; a configurable row group can share one\n8-bit exponent base across 1, 16, 32, or 64 such chunks with the same column\nrange.  Exponent deltas use three bits.  Values outside the local range\nare restored from tile-local 20-bit ``(exponent8, position12)`` exceptions,\npacked three per aligned 64-bit word, making the codec bit exact.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport os\nfrom typing import Dict, Optional\n\nimport torch\n\nfrom tiered_serve.compressor_base import TensorCompressor\n\n\nlogger = logging.getLogger(\"vllm\")\n\n_BASE_ROWS = int(os.getenv(\"TIERED_SERVE_CD3_BASE_ROWS\", \"16\"))\nif _BASE_ROWS not in (1, 16, 32, 64):\n    raise ValueError(\n        \"TIERED_SERVE_CD3_BASE_ROWS must be 1, 16, 32, or 64\")\n\ntry:\n    from tiered_serve.cpp_exts import chunk_delta3_ext as _cd3_ext\n    _HAS_CHUNK_DELTA3 = True\nexcept Exception as _error:\n    logger.warning(\n        \"ChunkDelta3Compressor disabled: failed to load chunk_delta3_ext \"\n        \"(%s: %s)\", type(_error).__name__, _error)\n    _cd3_ext = None\n    _HAS_CHUNK_DELTA3 = False\n\n\nclass CompressedChunkDelta3Tensor:\n    \"\"\"Python staging adapter around the native compressed CD3 struct.\"\"\"\n\n    _BUFFER_ATTRS = (\n        \"codes\",\n        \"sign_mantissa\",\n        \"thread_bases\",\n        \"tile_exception_offsets\",\n        \"entries20x3\",\n    )\n    _BUFFER_ATTR_D_PAIRS = tuple(\n        (attr, f\"_d_{attr}\") for attr in _BUFFER_ATTRS)\n\n    def __init__(self, c_struct):\n        self._c = c_struct\n        self.output_tensor: Optional[torch.Tensor] = None\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\n        self._host_slab: Optional[torch.Tensor] = None\n        self._device_slab: Optional[torch.Tensor] = None\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\n        self._copy_slab = False\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n            setattr(self, attr, getattr(c_struct, attr))\n            setattr(self, device_attr, None)\n\n    @property\n    def M(self) -> int:\n        return int(self._c.M)\n\n    @property\n    def K(self) -> int:\n        return int(self._c.K)\n\n    @property\n    def num_exceptions(self) -> int:\n        return int(self._c.num_exceptions)\n\n    @property\n    def nbytes(self) -> int:\n        return int(self._c.nbytes)\n\n    @property\n    def total_compressed_size(self) -> int:\n        return self.nbytes\n\n    @property\n    def original_size(self) -> int:\n        return self.M * self.K * 2\n\n    @property\n    def frozen_hbm_bytes(self) -> int:\n        return int(self._c.frozen_hbm_bytes)\n\n    @property\n    def frozen_transfer_bytes(self) -> int:\n        return int(self._c.frozen_transfer_bytes)\n\n    def _set_native_buffers(self, views: tuple[torch.Tensor, ...]) -> None:\n        for attr, view in zip(self._BUFFER_ATTRS, views):\n            setattr(self._c, attr, view)\n\n    def register_temp_d_tensor(\n        self,\n        temp_d: torch.Tensor,\n        gpu_pool: Optional[Dict[str, torch.Tensor]] = None,\n    ) -> None:\n        \"\"\"Bind the dense output and reusable device staging buffers.\"\"\"\n        self.output_tensor = temp_d\n        views = []\n        self._copy_slab = self._host_slab is not None and gpu_pool is None\n        if self._copy_slab:\n            self._device_slab = torch.empty_like(\n                self._host_slab, device=temp_d.device)\n            assert self._slab_layout is not None\n            for attr, offset, shape, dtype, nbytes in self._slab_layout:\n                view = self._device_slab.narrow(0, offset, nbytes)\n                view = view.view(dtype).reshape(shape)\n                setattr(self, f\"_d_{attr}\", view)\n                views.append(view)\n        else:\n            self._device_slab = None\n            for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\n                source = getattr(self, attr)\n                destination = (\n                    gpu_pool[attr]\n                    if gpu_pool is not None and attr in gpu_pool\n                    else torch.empty_like(source, device=temp_d.device)\n                )\n                if destination.numel() < source.numel():\n                    raise ValueError(\n                        f\"GPU staging buffer {attr!r} is too small: \"\n                        f\"{destination.numel()} < {source.numel()}\")\n                view = destination.reshape(-1).narrow(0, 0, source.numel())\n                view = view.reshape(source.shape)\n                setattr(self, device_attr, destination)\n                views.append(view)\n        self._h2d_views = tuple(views)\n        self._h2d_sources = tuple(\n            getattr(self, attr) for attr in self._BUFFER_ATTRS)\n        self._set_native_buffers(self._h2d_views)\n\n    def to_host(self, huge_page_allocator=None) -> \"CompressedChunkDelta3Tensor\":\n        \"\"\"Pack all payloads into one pinned or hugepage-backed host slab.\"\"\"\n        sources = [getattr(self, attr).contiguous()\n                   for attr in self._BUFFER_ATTRS]\n        layout = []\n        offset = 0\n        for attr, tensor in zip(self._BUFFER_ATTRS, sources):\n            alignment = tensor.element_size()\n            offset = (offset + alignment - 1) // alignment * alignment\n            layout.append(\n                (attr, offset, tuple(tensor.shape), tensor.dtype, tensor.nbytes))\n            offset += tensor.nbytes\n\n        if huge_page_allocator is not None:\n            try:\n                host_slab = huge_page_allocator.allocate(\n                    (offset,), (1,), torch.uint8, page_type=\"weight\")\n            except (MemoryError, ValueError):\n                logger.warning(\n                    \"Hugepage exhausted while staging ChunkDelta3; using \"\n                    \"pinned host memory\")\n                host_slab = torch.empty(offset, dtype=torch.uint8,\n                                        pin_memory=True)\n        else:\n            host_slab = torch.empty(offset, dtype=torch.uint8, pin_memory=True)\n\n        host_views = []\n        for source, (attr, start, shape, dtype, nbytes) in zip(sources, layout):\n            view = host_slab.narrow(0, start, nbytes).view(dtype).reshape(shape)\n            view.copy_(source)\n            setattr(self, attr, view)\n            host_views.append(view)\n        self._host_slab = host_slab\n        self._slab_layout = tuple(layout)\n        self._device_slab = None\n        self._h2d_views = None\n        self._h2d_sources = None\n        self._copy_slab = False\n        self._set_native_buffers(tuple(host_views))\n        return self\n\n    def to(self, device=\"cuda\", non_blocking: bool = True):\n        \"\"\"Stage host-resident compressed data into registered GPU buffers.\"\"\"\n        if torch.device(device).type != \"cuda\":\n            raise ValueError(\"ChunkDelta3 staging only supports CUDA\")\n        if self._h2d_views is None:\n            raise RuntimeError(\n                \"CompressedChunkDelta3Tensor.to(): call \"\n                \"register_temp_d_tensor first\")\n        if self._copy_slab:\n            assert self._host_slab is not None and self._device_slab is not None\n            self._device_slab.copy_(self._host_slab,\n                                    non_blocking=non_blocking)\n        else:\n            assert self._h2d_sources is not None\n            for source, destination in zip(\n                    self._h2d_sources, self._h2d_views):\n                destination.copy_(source, non_blocking=non_blocking)\n        return self\n\n    def get_gpu_buffers(self) -> tuple[torch.Tensor, ...]:\n        if self._h2d_views is None:\n            raise RuntimeError(\"GPU staging buffers have not been registered\")\n        return self._h2d_views\n\n\nclass ChunkDelta3Compressor(TensorCompressor):\n    \"\"\"Production compressor wrapper for the CUDA ChunkDelta3 codec.\"\"\"\n\n    HAS_FUSED_MM = True\n    codec_name = \"chunk_delta3\"\n\n    # GH200/Llama-70B serving calibration covers the lossless Packed20x3\n    # kernels through N=128.  With concurrent weight H2D, all four projections\n    # win throughout N=65..128.  QKV wins on 79/80 real layers (layer 0 is the\n    # exception-heavy outlier) and still wins in the 80-layer aggregate.  At\n    # N=129 the activation tile expands from 128 to 192 and fused latency jumps\n    # by about 2x, so dense decompress+cuBLAS is the clear route above 128.\n    # Keep environment overrides for cross-GPU/model retuning.\n    _FUSED_MAX_N_TABLE = {\n        (10240, 8192): 128,\n        (8192, 8192): 128,\n        (57344, 8192): 128,\n        (8192, 28672): 128,\n    }\n\n    def __init__(\n        self,\n        comp_stream: Optional[torch.cuda.Stream] = None,\n        decomp_stream: Optional[torch.cuda.Stream] = None,\n    ):\n        super().__init__(comp_stream, decomp_stream)\n        if not _HAS_CHUNK_DELTA3:\n            raise RuntimeError(\n                \"ChunkDelta3Compressor requires chunk_delta3_ext to build \"\n                \"successfully\")\n        self._fused_max_n_override: Optional[int] = None\n        self._fused_max_n_by_shape_override: dict[tuple[int, int], int] = {}\n        # Serving-level experiments can override the calibrated crossover\n        # without rebuilding the extension.\n        fused_override = os.getenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\")\n        if fused_override is not None:\n            value = int(fused_override)\n            if value < 0:\n                raise ValueError(\n                    \"TIERED_SERVE_CD3_FUSED_MAX_N must be non-negative\")\n            self._fused_max_n_override = value\n\n        # Projection-specific overrides make route calibration possible without\n        # rebuilding the extension or editing the production table.  A shape\n        # override takes precedence over the uniform override above.\n        projection_shapes = {\n            \"QKV\": (10240, 8192),\n            \"O\": (8192, 8192),\n            \"GATE_UP\": (57344, 8192),\n            \"DOWN\": (8192, 28672),\n        }\n        for projection, shape in projection_shapes.items():\n            env_name = f\"TIERED_SERVE_CD3_FUSED_MAX_N_{projection}\"\n            raw_value = os.getenv(env_name)\n            if raw_value is None:\n                continue\n            value = int(raw_value)\n            if value < 0:\n                raise ValueError(f\"{env_name} must be non-negative\")\n            self._fused_max_n_by_shape_override[shape] = value\n\n    def _fused_max_n_for(self, M: int, K: int) -> int:\n        shape_override = self._fused_max_n_by_shape_override.get((M, K))\n        if shape_override is not None:\n            return int(shape_override)\n        if self._fused_max_n_override is not None:\n            return int(self._fused_max_n_override)\n        return int(self._FUSED_MAX_N_TABLE.get((M, K), 0))\n\n    @staticmethod\n    def _allocate_fused_scratch(\n        M: int,\n        K: int,\n        N: int,\n        device: torch.device,\n    ) -> dict:\n        from tiered_serve.compression.core.ublb_tbe import (\n            _empty_f32,\n            _u4_split_k,\n        )\n\n        # CD3's TileN=128 kernel carries substantially more decode state than\n        # P4/U4.  Do not inherit their small-M 128 -> 192 widening heuristic:\n        # it increases both WGMMA work and C