_raw_slots[layer_id].numel() > 0:\\n                n_total_slots = d_raw_slots[layer_id].numel() // slot_size\\n            pos_map: Dict[int, int] = {}\\n            size_map: Dict[int, Set[int]] = {}\\n            if n_total_slots > 0:\\n                pos_map[0] = n_total_slots\\n                size_map[n_total_slots] = {0}\\n            self._free_by_pos.append(pos_map)\\n            self._free_by_size.append(size_map)\\n\\n    # ── internal allocator ───────────────────────────────────────────\\n\\n    def _allocate_impl(\\n        self, layer_id: int, n_required: int\\n    ) -> Optional[Tuple[int, int]]:\\n        \\\"\\\"\\\"Best-fit allocation returning ``(start, end)`` or ``None``.\\\"\\\"\\\"\\n        free_by_pos = self._free_by_pos[layer_id]\\n        free_by_size = self._free_by_size[layer_id]\\n\\n        # Find smallest chunk >= n_required\\n        best_size: Optional[int] = None\\n        for sz in sorted(free_by_size.keys()):\\n            if sz >= n_required:\\n                best_size = sz\\n                break\\n        if best_size is None:\\n            return None\\n\\n        positions = free_by_size[best_size]\\n        start_pos = min(positions)\\n\\n        # Remove from both maps\\n        positions.discard(start_pos)\\n        if not positions:\\n            del free_by_size[best_size]\\n        del free_by_pos[start_pos]\\n\\n        # Leftover\\n        leftover = best_size - n_required\\n        if leftover > 0:\\n            leftover_pos = start_pos + n_required\\n            free_by_pos[leftover_pos] = leftover\\n            free_by_size.setdefault(leftover, set()).add(leftover_pos)\\n\\n        return (start_pos, start_pos + n_required)\\n\\n    def _free_impl(self, layer_id: int, slot_range: Tuple[int, int]) -> None:\\n        \\\"\\\"\\\"Return *slot_range* to the free-list, coalescing neighbours.\\\"\\\"\\\"\\n        free_by_pos = self._free_by_pos[layer_id]\\n        free_by_size = self._free_by_size[layer_id]\\n\\n        start, end = slot_range\\n        size = end - start\\n\\n        # Coalesce with next neighbour\\n        next_pos = end\\n        if next_pos in free_by_pos:\\n            next_size = free_by_pos[next_pos]\\n            # Remove next from maps\\n            free_by_size[next_size].discard(next_pos)\\n            if not free_by_size[next_size]:\\n                del free_by_size[next_size]\\n            del free_by_pos[next_pos]\\n            size += next_size\\n\\n        # Coalesce with previous neighbour\\n        # Find the block whose end == start\\n        prev_pos: Optional[int] = None\\n        for pos, sz in free_by_pos.items():\\n            if pos + sz == start:\\n                prev_pos = pos\\n                break\\n        if prev_pos is not None:\\n            prev_size = free_by_pos[prev_pos]\\n            free_by_size[prev_size].discard(prev_pos)\\n            if not free_by_size[prev_size]:\\n                del free_by_size[prev_size]\\n            del free_by_pos[prev_pos]\\n            start = prev_pos\\n            size += prev_size\\n\\n        # Re-insert coalesced block\\n        free_by_pos[start] = size\\n        free_by_size.setdefault(size, set()).add(start)\\n\\n    # ── public API ───────────────────────────────────────────────────\\n\\n    def allocate_and_copy_compressed(\\n        self,\\n        layer_id: int,\\n        block_id: int,\\n    def allocate_compressed_v_batch(\\n        self, layer_id: int, block_ids: List[int], sizes: torch.Tensor\\n    ) -> None:\\n        self._compressed.allocate_comped_v_batch(layer_id, block_ids, sizes)\\n\\n    def scatter_compressed_data(\\n        self,\\n        layer_id: int,\\n        block_ids: List[int],\\n        source_buffer: torch.Tensor,\\n        k_sizes: torch.Tensor,\\n        v_sizes: torch.Tensor,\\n    ) -> None:\\n        self._compressed.scatter_compressed_data(\\n            layer_id, block_ids, source_buffer, k_sizes, v_sizes)\\n\\n    def load_compressed(\\n        