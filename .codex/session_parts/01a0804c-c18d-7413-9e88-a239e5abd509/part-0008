rd, const CountArray& reverse) {\\n        if (block_ids.ndim() != 1 || valid.ndim() != 1 ||\\n            forward.ndim() != 1 || reverse.ndim() != 1) {\\n            throw py::value_error(\\\"KV retirement arrays must be one-dimensional\\\");\\n        }\\n        if (valid.size() != forward.size() || reverse.size() < capacity_) {\\n            throw py::value_error(\\\"KV retirement table lengths do not match\\\");\\n        }\\n        std::vector<int64_t> mapped_ids;\\n        std::vector<int64_t> mapped_slots;\\n        mapped_ids.reserve(block_ids.size());\\n        mapped_slots.reserve(block_ids.size());\\n        ValidationReset reset(validation_marks_, block_ids.size());\\n        const int64_t hwm = high_water();\\n        const int64_t* ids = block_ids.data();\\n        const uint8_t* validity = valid.data();\\n        const int32_t* slots = forward.data();\\n        const int32_t* owners = reverse.data();\\n        for (py::ssize_t index = 0; index < block_ids.size(); ++index) {\\n            const int64_t block = ids[index];\\n            if (block < 0 || block >= forward.size()) {\\n                throw std::runtime_error(\\\"KV block ID is outside the persistent table\\\");\\n            }\\n            if (index > 0 && block <= ids[index - 1]) {\\n                throw py::value_error(\\\"KV retirement block IDs must be sorted and unique\\\");\\n            }\\n            const int64_t slot = slots[block];\\n            if (slot < 0) {\\n                if (validity[block] != 0) {\\n                    throw std::runtime_error(\\\"KV valid block has no physical slot\\\");\\n                }\\n                continue;\\n            }\\n            if (slot >= hwm || slot >= capacity_) {\\n                throw std::runtime_error(\\\"KV block mapping is outside the active range\\\");\\n            }\\n            if (owners[slot] != block) {\\n                throw std::runtime_error(\\\"KV forward/reverse slot mapping mismatch\\\");\\n            }\\n            const size_t word = static_cast<size_t>(slot) / 64;\\n            const uint64_t bit = uint64_t{1} << (slot % 64);\\n            if ((occupied_[0][word] & bit) == 0) {\\n                throw std::runtime_error(\\\"KV physical slot is not occupied\\\");\\n            }\\n            if ((validation_marks_[word] & bit) != 0) {\\n                throw std::runtime_error(\\\"KV physical slot occurs twice in release\\\");\\n            }\\n            if (validation_marks_[word] == 0) {\\n                reset.touched.push_back(word);\\n            }\\n            validation_marks_[word] |= bit;\\n            mapped_ids.push_back(block);\\n            mapped_slots.push_back(slot);\\n        }\\n        SlotArray result_ids(mapped_ids.size());\\n        SlotArray result_slots(mapped_slots.size());\\n        std::copy(mapped_ids.begin(), mapped_ids.end(), result_ids.mutable_data());\\n        std::copy(mapped_slots.begin(), mapped_slots.end(), result_slots.mutable_data());\\n        return py::make_tuple(result_ids, result_slots);\\n    }\\n\\n    void release(const SlotArray& slots) {\\n        validate_occupied(slots);\\n        const int64_t* values = slots.data();\\n        for (py::ssize_t index = 0; index < slots.size(); ++index) {\\n            const size_t slot = static_cast<size_t>(values[index]);\\n            set_slot(occupied_, slot, false);\\n            set_slot(free_, slot, true);\\n        }\\n        occupied_count_ -= slots.size();\\n    }\\n\\n    int64_t capacity() const { return capacity_; }\\n    int64_t occupied_count() const { return occupied_count_; }\\n\\n    int64_t high_water() const {\\n// large counts cannot cause signed C++ overflow before conversion to Python.\\npy::int_ metadata_total(__int128 value) {\\n    if (value >= std::numeric_limits<int64_t>::min() &&\\n        value <= std::numeric_limits<int64_t>::max()) {\\n        return py::int_(static_cast<int64_t>(value));\\n    }\\n    const bool negative = value < 0;\\n    