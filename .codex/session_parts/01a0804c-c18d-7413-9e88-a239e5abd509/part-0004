  if (free_[level - 1][child] != 0) {\\n                    free_[level][child / 64] |= uint64_t{1} << (child % 64);\\n                }\\n            }\\n        }\\n    }\\n\\n    SlotArray allocate(int64_t count) {\\n        if (count < 0) {\\n            throw py::value_error(\\\"KV slot allocation count must be non-negative\\\");\\n        }\\n        if (count > capacity_ - occupied_count_) {\\n            throw std::runtime_error(\\\"KV persistent slot pool full\\\");\\n        }\\n        // Allocate Python-owned output before committing any slot. The loop\\n        // below needs no allocation and cannot fail after the capacity check.\\n        SlotArray result(count);\\n        int64_t* slots = result.mutable_data();\\n        for (int64_t index = 0; index < count; ++index) {\\n            const size_t slot = find_lowest(free_);\\n            set_slot(free_, slot, false);\\n            set_slot(occupied_, slot, true);\\n            slots[index] = static_cast<int64_t>(slot);\\n        }\\n        occupied_count_ += count;\\n        return result;\\n    }\\n\\n    void validate_occupied(const SlotArray& slots) {\\n        if (slots.ndim() != 1) {\\n            throw py::value_error(\\\"KV slots must be one-dimensional\\\");\\n        }\\n        // Scratch marks detect duplicates in O(batch size). They never own\