          view = view.view(dtype)\\n            pool[name] = view\\n            assert pool[name].shape == specs[name][0]\\n        pool[\\\"entries20x3\\\"] = self._alloc_host_tensor(\\n            specs[\\\"entries20x3\\\"][0], torch.int64, huge_page_allocator)\\n        pool[\\\"num_exceptions\\\"] = self._alloc_host_tensor(\\n            specs[\\\"num_exceptions\\\"][0], torch.int32, huge_page_allocator)\\n        return pool\\n\\n    def _gpu_csr_pool(self, rows: int) -> Dict[str, Dict[str, torch.Tensor]]:\\n        def side() -> Dict[str, torch.Tensor]:\\n            return {\\n                \\\"body\\\": torch.empty(\\n                    (rows, self._body_stride), dtype=torch.uint8,\\n                    device=\\\"cuda\\\"),\\n                \\\"entries20x3\\\": torch.empty(\\n                    (rows * self._packed_capacity,), dtype=torch.int64,\\n                    device=\\\"cuda\\\"),\\n                \\\"entry_word_offsets\\\": torch.empty(\\n                    (rows,), dtype=torch.int64, device=\\\"cuda\\\"),\\n            }\\n\\n        return {\\\"k\\\": side(), \\\"v\\\": side()}\\n\\n    def warmup_kv_buffers(\\n        self,\\n        block_shape: tuple,\\n        max_n_blocks: int,\\n    def _new_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Lazily allocate stable pinned CSR storage for one layer/side.\\\"\\\"\\\"\\n        host_rows = self._max_n_blocks + 1\\n        max_words = host_rows * self._packed_capacity\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        initial_words = min(\\n            max_words,\\n            max(1024, host_rows * self._csr_initial_words_per_slot),\\n        )\\n        state = _PersistentCSRState(\\n            entries=torch.empty(\\n                initial_words, dtype=torch.int64).pin_memory(),\\n            offsets=torch.zeros(\\n                host_rows, dtype=torch.int64).pin_memory(),\\n            word_counts=np.zeros(host_rows, dtype=np.int64),\\n            used_words=0,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Compact append garbage off the request path in the CPU worker.\\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n\\n    def _discard_persistent_csr_slot(\\n            self, layer_id: int, slot: int) -> None:\\n        self._discard_persistent_csr_slots(\\n            layer_id, np.asarray([slot], dtype=np.int64))\\n\\n    def _discard_persistent_csr_slots(\\n            self, layer_id: int, slots: np.ndarray) -> None:\\n        \\\"\\\"\\\"Make freed scratch rows compactable without touching H2D data.\\\"\\\"\\\"\\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\\n        if slots.size == 0:\\n            return\\n        for kv in (\\\"k\\\", \\\"v\\\"):\\n            pool = self._host_pools[layer_id][kv]\\n            pool[\\\"num_exceptions\\\"].numpy()[slots] = 0\\n            state = self._persistent_csr.get(layer_id, {}).get(kv)\\n            if state is not None:\\n                state.garbage_words += int(state.word_counts[slots].sum())\\n                state.word_counts[slots] = 0\\n\\n    def _acquire_csr_host_arena(\\n    def _release_physical_slots(\\n            self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Validate standalone/deferred releases before reclaiming storage.\\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        slots = np.unique(np.asarray(slots, dtype=np.int64))\\n        if slots.size == 0:\\n            return\\n        self._kv_slot_allocator[layer_id].validate_occupied(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_validate_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n        self._reclaim_validated_slots(layer_id, slots, _profile=_profile)\\n\\n    def _reclaim_validated_slots(\\n            self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Reclaim slots after validation under the slot-state lock.\\n\\n        The native occupied bitmap is the authority for both minimum-free\\n        allocation and exact high-water. Quarantined slots remain occupied\\n        until their writer has stopped and this method can clear their bits.\\n        \\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        self._discard_persistent_csr_slots(layer_id, slots)\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_csr_ns\\\"] += now_ns - started_ns\\n            started_ns = now_ns\\n        self._kv_slot_allocator[layer_id].release(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_allocator_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n            _profile[\\\"cd3_released_slots\\\"] += int(slots.size)\\n\\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\\n    def _prepare_layer_retirement(\\n            self, layer_id: int, block_ids: np.ndarray):\\n        valid = np.frombuffer(\\n            self._persistent_valid[layer_id], dtype=np.uint8)\\n        slot_table = self._kv_slot_np[layer_id]\\n        slots = np.asarray(slot_table[block_ids], dtype=np.int64)\\n        mapped = slots >= 0\\n        missing = (valid[block_ids] != 0) & ~mapped\\n        if bool(missing.any()):\\n            bad_id = int(block_ids[np.flatnonzero(missing)[0]])\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 valid block has no physical slot: \\\"\\n                f\\\"layer={layer_id} block={bad_id}\\\")\\n\\n        mapped_ids = block_ids[mapped]\\n        mapped_slots = slots[mapped]\\n        if mapped_slots.size:\\n            hwm = self._kv_slot_allocator[layer_id].high_water\\n            if (int(mapped_slots.min()) < 0\\n                    or int(mapped_slots.max()) >= hwm):\\n                raise RuntimeError(\\n                    \\\"ChunkDelta3 block mapping is outside the active range: \\\"\\n                    f\\\"layer={layer_id} slots={mapped_slots.tolist()} hwm={hwm}\\\")\\n            reverse = self._kv_slot_block[layer_id]\\n            mismatched = reverse[mapped_slots] != mapped_ids\\n            # Input block IDs are unique. A reverse owner cannot match two\\n            # different IDs, so this also detects physical-slot aliases without\\n            # a separate per-layer unique/sort pass.\\n            if bool(mismatched.any()):\\n                position = int(np.flatnonzero(mismatched)[0])\\n                block_id = int(mapped_ids[position])\\n                slot = int(mapped_slots[position])\\n                raise RuntimeError(\\n                    \\\"ChunkDelta3 forward/reverse slot mapping mismatch: \\\"\\n                    f\\\"layer={layer_id} block={block_id} slot={slot} \\\"\\n                    f\\\"owner={reverse[slot]}\\\")\\n            self._kv_slot_allocator[layer_id].validate_occupied(mapped_slots)\\n        return valid, slot_table, mapped_ids, mapped_slots\\n\\n    def _apply_layer_retirement(\\n            self, layer_id: int, block_ids: np.ndarray,\\n            retirement, *, _profile=None) -> None:\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        valid, slot_table, mapped_ids, mapped_slots = retirement\\n        valid[block_ids] = 0\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_mapping_ns\\\"] += now_ns - started_ns\\n            _profile[\\\"cd3_layers\\\"] += 1\\n            _profile[\\\"cd3_mapped_slots\\\"] += int(mapped_slots.size)\\n        if mapped_slots.size == 0:\\n            return\\n\\n        # Invalidate once before detaching every route represented by this\\n        # callback. Retired plans retain their pinned aliases until H2D ends.\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        self._invalidate_decode_plan(layer_id)\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_plan_ns\\\"] += now_ns - started_ns\\n            started_ns = now_ns\\n        slot_table[mapped_ids] = -1\\n        reverse = self._kv_slot_block[layer_id]\\n        reverse[mapped_slots] = -1\\n        if _profile is not None:\\n            _profile[\\\"cd3_mapping_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n\\n        # The CPU writer may rebuild the whole layer CSR, not just its input\\n        # rows. Keep every physical release in that layer quarantined until\\n        # the writer has retired, while logical ownership is already gone.\\n        if layer_id in self._pending_compress:\\n            if _profile is not None:\\n                started_ns = _time.perf_counter_ns()\\n            self._deferred_slot_frees.setdefault(\\n                layer_id, set()).update(mapped_slots.tolist())\\n            if _profile is not None:\\n                _profile[\\\"cd3_quarantine_ns\\\"] += (\\n                    _time.perf_counter_ns() - started_ns)\\n                _profile[\\\"cd3_quarantined_slots\\\"] += int(mapped_slots.size)\\n        else:\\n            self._reclaim_validated_slots(\\n                layer_id, mapped_slots, _profile=_profile)\\n\\n    def _retire_layer_blocks(\\n            self, layer_id: int, block_ids: np.ndarray) -> None:\\n        retirement = self._prepare_layer_retirement(layer_id, block_ids)\\n        self._apply_layer_retirement(layer_id, block_ids, retirement)\\n\\n    def free_persistent_blocks(self, block_ids, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Retire one callback batch across every warmed-up CD3 layer.\\n\\n        The diagnostic entry point supplies phase counters. Serving executes\\n        the identical lifecycle without allocating counters or reading clocks;\\n        profiling guards are per batch/layer, never inside the block loops.\\n        \\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        raw_ids = np.asarray(block_ids)\\n        if raw_ids.ndim != 1:\\n            raise ValueError(\\\"ChunkDelta3 block IDs must be one-dimensional\\\")\\n        if raw_ids.size == 0:\\n            if _profile is not None:\\n                _profile[\\\"cd3_validate_ns\\\"] += (\\n                    _time.perf_counter_ns() - started_ns)\\n            return\\n        if not np.issubdtype(raw_ids.dtype, np.integer):\\n            raise TypeError(\\\"ChunkDelta3 block IDs must be integers\\\")\\n        block_ids = np.unique(raw_ids.astype(np.int64, copy=False))\\n        if int(block_ids[0]) < 0:\\n            raise ValueError(\\\"ChunkDelta3 block IDs must be non-negative\\\")\\n        for layer_id in range(self._n_layers):\\n            slot_table = self._kv_slot_np.get(layer_id)\\n            if slot_table is None or int(block_ids[-1]) >= slot_table.size:\\n                raise ValueError(\\n                    \\\"ChunkDelta3 block ID is outside the persistent table: \\\"\\n                    f\\\"layer={layer_id} max_id={int(block_ids[-1])}\\\")\\n\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_validate_ns\\\"] += now_ns - started_ns\\n            started_ns = _time.perf_counter_ns()\\n        with self._slot_state_lock:\\n            if _profile is not None:\\n                now_ns = _time.perf_counter_ns()\\n                _profile[\\\"cd3_lock_wait_ns\\\"] += now_ns - started_ns\\n                started_ns = _time.perf_counter_ns()\\n            retirements = [\\n                self._prepare_layer_retirement(layer_id, block_ids)\\n                for layer_id in range(self._n_layers)\\n            ]\\n            if _profile is not None:\\n                _profile[\\\"cd3_validate_ns\\\"] += (\\n                    _time.perf_counter_ns() - started_ns)\\n            for layer_id, retirement in enumerate(retirements):\\n                self._apply_layer_retirement(\\n                    layer_id, block_ids, retirement, _profile=_profile)\\n\\n    def free_persistent_blocks_profiled(self, block_ids):\\n        \\\"\\\"\\\"Time synchronous retirement phases for one diagnostic callback.\\n\\n        Counts refer to physical slots across layers, not logical blocks.\\n        Quarantine measures enqueueing only; a later writer join drains those\\n        slots outside this callback and is deliberately not charged here.\\n        Phase times are disjoint subsets of the loader compressor interval.\\n        \\\"\\\"\\\"\\n        profile = dict.fromkeys((\\n            \\\"cd3_validate_ns\\\", \\\"cd3_lock_wait_ns\\\", \\\"cd3_plan_ns\\\",\\n            \\\"cd3_mapping_ns\\\", \\\"cd3_csr_ns\\\", \\\"cd3_allocator_ns\\\",\\n            \\\"cd3_quarantine_ns\\\", \\\"cd3_layers\\\", \\\"cd3_mapped_slots\\\",\\n            \\\"cd3_released_slots\\\", \\\"cd3_quarantined_slots\\\",\\n        ), 0)\\n        profile[\\\"cd3_profiled_callbacks\\\"] = 1\\n        self.free_persistent_blocks(block_ids, _profile=profile)\\n        return profile\\n\\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\\n        block_ids = np.asarray([block_id], dtype=np.int64)\\n        slot_table = self._kv_slot_np.get(layer_id)\\n        if slot_table is None or not 0 <= block_id < slot_table.size:\\n            return\\n        with self._slot_state_lock:\\n            self._retire_layer_blocks(layer_id, block_ids)\\n\\n    def _release_deferred_slots(self, layer_id: int) -> None:\\n        deferred = self._deferred_slot_frees.get(layer_id)\\n        if not deferred:\\n            return\\n        slots = np.asarray(sorted(deferred), dtype=np.int64)\\n        self._release_physical_slots(layer_id, slots)\\n        self._deferred_slot_frees.pop(layer_id, None)\\n\\n    def compress_batch_async_from_host(\\n#include <pybind11/numpy.h>\\n#include <pybind11/pybind11.h>\\n\\n#include <algorithm>\\n#include <cstdint>\\n#include <stdexcept>\\n#include <vector>\\n\\nnamespace py = pybind11;\\n\\nnamespace {\\n\\nusing SlotArray = py::array_t<int64_t, py::array::c_style>;\\nusing Bitmap = std::vector<std::vector<uint64_t>>;\\n\\nclass KVSlotAllocator {\\npublic:\\n    explicit KVSlotAllocator(int64_t capacity) : capacity_(capacity) {\\n        if (capacity < 0) {\\n            throw py::value_error(\\\"KV slot capacity must be non-negative\\\");\\n        }\\n        size_t words = std::max<size_t>(\\n            1, static_cast<size_t>(capacity / 64 + (capacity % 64 != 0)));\\n        validation_marks_.resize(words, 0);\\n        for (;;) {\\n            occupied_.emplace_back(words, 0);\\n            free_.emplace_back(words, 0);\\n            if (words == 1) {\\n                break;\\n            }\\n            words = words / 64 + (words % 64 != 0);\\n        }\\n\\n        // Only valid slots enter the free tree. Padding stays absent in both\\n        // trees, including at every summary level and for zero capacity.\\n        std::fill(free_[0].begin(), free_[0].end(), ~uint64_t{0});\\n        if (capacity == 0) {\\n            free_[0][0] = 0;\\n        } else if (capacity % 64 != 0) {\\n            free_[0].back() = (uint64_t{1} << (capacity % 64)) - 1;\\n        }\\n        for (size_t level = 1; level < free_.size(); ++level) {\\n            for (size_t child = 0; child < free_[level - 1].size(); ++child) {\\n                if (free_[level - 1][child] != 0) {\\n                    free_[level][child / 64] |= uint64_t{1} << (child % 64);\\n                }\\n            }\\n        }\\n    }\\n\\n    SlotArray allocate(int64_t count