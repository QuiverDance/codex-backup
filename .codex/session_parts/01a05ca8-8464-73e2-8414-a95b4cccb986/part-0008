ecomp_weight_stream)\n            for name, comped in comp_data.items():\n                self.weight_compressor.decompress(comped)\n            self.frozen_decomp_event.record(self.decomp_weight_stream)\n            # Mirror the whole-layer interval into the \"qkv\" per-comp\n            # END slot so the time-breakdown picks it up (pipelined\n            # paths fill all four slots; this path only fills \"qkv\").\n            if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                self.end_frozen_decomp_timing_events[\"qkv\"][\n                    layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen compressed weights with per-component events.\n\n        Unlike decompress_frozen_weight which records a single event after\n        all tensors, this records per-component events so exec_stream can\n        start each matmul as soon as its specific tensor is ready.\n\n        Honors per-cell compressor overrides from the YAML\n        ``layer_residency`` ``{mode, compressor}`` cells: each\n        component's decomp instance is looked up via\n        ``_compressor_for_cell``.  Cells without an override fall\n        through to the legacy global ``weight_compressor``.\n        \"\"\"\n        comp_data = self.frozen_comp_buffers[layer_id]\n        if comp_data is None:\n            return\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                if hasattr(self, \"begin_frozen_decomp_events\"):\n                    self.begin_frozen_decomp_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n                comp = self._compressor_for_cell(\n                    layer_id, comp_key, mode=\"frozen_compressed\")\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    comped = comp_data.get(name)\n                    if comped is not None:\n                        comp.decompress(comped)\n                self.frozen_decomp_events[comp_key][layer_id].record(\n                    self.decomp_weight_stream)\n                if hasattr(self, \"end_frozen_decomp_timing_events\"):\n                    self.end_frozen_decomp_timing_events[comp_key][\n                        layer_id].record(self.decomp_weight_stream)\n\n    def decompress_frozen_split_weight_pipelined(self, layer_id: int):\n        \"\"\"Decompress frozen_split weights with per-component events.\n\n        Two paths:\n          * Prefill: materialize the dense primary through the compressed\n            prefill-alt path below its codec cutoff, or H2D raw_bf16 at/above\n            that cutoff.  Alt payload H2D runs on load_weight_stream while its\n            decoder and consuming GEMM stay ordered on exec_stream.\n          * Decode: stream the backend-specific compressed buffers\n            (sign_mantissa-on-HBM stays put; the exp / aux side comes\n            from LPDDR through ``frozen_split_staging``) and run the\n            backend's decompress kernel.\n        \"\"\"\n        split_data = self.frozen_split_info[layer_id]\n        if split_data is None:\n            return\n        # Use batch_has_prefill (attn_metadata.max_query_len>1), not\n        # is_prefill (cudagraph mode==NONE): prefill-alt/raw selection is a\n        # phase policy even when a small chunk runs under a PIECEWISE graph.\n        # Gated on use_prefill_raw_bf16 so TIERED_SERVE_PREFILL_RAW_BF16=0 makes\n        # prefill fall through to the primary split reconstruct path below.\n        is_prefill = self.batch_has_prefill and self.use_prefill_raw_bf16\n        # staging and output buffers can have different parity depths —\n        # staging is gated by explicit kernel_done_event, output relies on\n        # parity-based separation to avoid an inter-stream WAR against\n        # exec_stream's GEMM.  See FROZEN_*_PARITY setup at init.\n        staging_parity = layer_id % self.FROZEN_STAGING_PARITY\n        output_parity = layer_id % self.FROZEN_DECOMP_PARITY\n        # The begin/end_frozen_decomp_timing and h2d_begin/end events are\n        # consumed only by the --time-breakdown diagnostic; record them only\n        # when it's enabled so the decode hot path stays event-light.\n        tb = self.time_breakdown\n        with torch.cuda.stream(self.decomp_weight_stream):\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                # WDecomp timing for the split path is recorded tightly\n                # around each _frozen_split_run_decompress kernel below\n                # (AFTER its H2D wait_event), NOT here.  The old coarse\n                # per-comp_key begin/end straddled every tensor's (and\n                # pipelined group's) H2D wait_event, so WDecomp absorbed the\n                # LPDDR->HBM load-wait bubble — already counted in WLoad —\n                # and read ~= GPUFwd while Compute looked tiny.  Per-kernel\n                # intervals are unioned into WDecomp via\n                # frozen_split_decomp_intervals; the load-wait now correctly\n                # surfaces as Stall.  (begin/end_frozen_decomp_events stay\n                # for the frozen_compressed path, which has no separate H2D.)\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    info = split_data.get(name)\n                    if info is None:\n                        continue\n                    staging = self.frozen_split_staging[name][staging_parity]\n                    output = self.frozen_primary_buffer_pair[name][output_parity]\n                    backend_compressor = self._resolve_backend_compressor(\n                        info, layer_id, comp_key)\n\n                    if is_prefill:\n                        # Prefill weight path. Two sub-cases:\n                        #  * Chunk < PREFILL_ALT_MAX_CHUNK WITH an alt codec\n                        #    stored: H2D the compressed exp into alt staging and\n                        #    decode it (less H2D than raw_bf16). The alt is the\n                        #    primary codec reused (unified) or a distinct\n                        #    fast-decode codec (e.g. p4flat).\n                        #  * Larger chunk or no alt: the big GEMM amortises the\n                        #    H2D, so take the raw_bf16 fast path (full BF16 copy,\n                        #    no reconstruct kernel at all).\n                        if (info.alt is not None\n                                and self.cur_num_tokens\n                                < self._alt_max_chunk_for(info.alt.backend)):\n                            alt = info.alt\n                            # Unified alt (same codec as primary) reuses the\n                            # already-resolved concrete compressor — the\n                            # zipserv/dietgpu decode needs its ._ext / workspace\n                            # helpers, which the _AutoWeightCompressor wrapper\n                            # that _get_or_make_backend returns does not expose.\n                            alt_comp = (\n                                backend_compressor\n                                if alt.backend == info.backend\n                                else self._get_or_make_backend(alt.backend))\n                            self._materialize_frozen_split_prefill_alt(\n                                layer_id, name, alt, output, alt_comp)\n                        else:\n                            src = info.lpddr_buffers[\"raw_bf16\"]\n                            # H2D on load_weight_stream (copy stream) so the\n                            # LPDDR→HBM transfer overlaps exec_stream's GEMMs\n                            # instead of blocking the compute stream.\n                            # decomp_weight_stream == exec_stream; the wait\n                            # below ensures frozen_decomp_events recorded on\n                            # decomp_weight_stream (line ~880) fire after the H2D.\n                            with torch.cuda.stream(self.load_weight_stream):\n                                if tb:\n                                    self._frozen_split_h2d_begin_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                                output.view(src.shape).copy_(\n                                    src, non_blocking=True)\n                                if tb:\n                                    self._frozen_split_h2d_end_timing_event(\n                                        layer_id, name).record(\n                                            self.load_weight_stream)\n                            self.decomp_weight_stream.wait_stream(\n                                self.load_weight_stream)\n                    elif self._ats_decomp_frozen:\n"},{"type":"input_text","text":"===== fused_route =====\n        cells (e.g. flexgen-comp).  Active whenever ``--fused-mm`` is on.\n\n        Runs AFTER the offload GPU staging (``_comp_transfer_bufs`` /\n        ``register_temp_d_tensor``) and the dense ``primary_buffers`` are bound,\n        so the shell can alias the per-decode ``_d_*`` staging and bind the\n        primary buffer as ``fused_mm``'s large-N decompress target.\n\n        Only codecs WITHOUT a per-shape ``_fused_max_n_for`` (zipserv via the\n        auto wrapper) are eligible: their ``fused_mm`` decides fused-kernel vs\n        decompress+cuBLAS internally per N, so decode never falls back to\n        ``orig_forward`` and the load path can unconditionally skip the dense\n        decompress.  Codecs that expose ``_fused_max_n_for`` (p4flat / ublb)\n        would need per-step dense/fused coordination on the load path — not\n        wired here.\n\n        WAR/RAW correctness: the load path (``_fused_offload_h2d``) WAR-waits\n        the per-(name, slot) kernel_done event before each H2D and then issues\n        ``decomp_weight_stream.wait_stream(load_weight_stream)`` so the exec\n        barrier the wrapper records (entry[4]) follows the H2D; the fused op\n        waits that barrier and records kernel_done (entry[5]).\n        \"\"\"\n        if not self._fused_mm_enabled():\n            return\n        installed = 0\n        for idx in self.not_frozen_layers:\n            comp_secondary = self.comp_secondary_buffers[idx]\n            if comp_secondary is None:\n                continue\n            block = self.torch_model.decoder_blocks[idx]\n            for name, comped in comp_secondary.items():\n                comp_key = self.tensor_to_component.get(name)\n                comp_id = _FUSED_MM_COMP_TO_ID.get(comp_key)\n                if comp_id is None:\n                    continue\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    block.is_frozen)\n                if mode != \"offload_compressed\":\n                    continue\n                compressor = self._compressor_for_cell(idx, comp_key, mode=mode)\n                if not getattr(compressor, \"HAS_FUSED_MM\", False):\n                    continue\n                # Per-step-threshold codecs (p4flat/ublb) fall back to\n                # orig_forward above their N threshold, which would read the\n                # dense primary buffer the fused load path stops populating —\n                # unsupported here; keep them on the dense decompress path.\n                if getattr(compressor, \"_fused_max_n_for\", None) is not None:\n                    logger.info(\n                        \"fused_mm: offload fused unsupported for per-threshold \"\n                        \"codec %s — skipping %s (keeps dense decompress)\",\n                        type(compressor).__name__, name)\n                    continue\n                primary = (self.primary_buffers[idx].get(name)\n                           if self.primary_buffers[idx] else None)\n                try:\n                    shell = compressor.build_offload_shell(comped, primary)\n                except (NotImplementedError, AttributeError,\n                        TypeError, RuntimeError) as e:\n                    logger.info(\n                        \"fused_mm: cannot build offload shell for %s via %s \"\n                        \"— skipping (%s)\", name, type(compressor).__name__, e)\n                    continue\n                leaf_name, _, _tn = name.rpartition(\".\")\n                leaf_module = block.module.get_submodule(leaf_name)\n                self._maybe_install_fused_mm(\n                    leaf_module, shell, compressor,\n                    layer_id=idx, comp_id=comp_id,\n                    mode=\"offload_compressed\", tensor_name=name)\n                if self._is_fused_offload_cell(idx, comp_id):\n                    installed += 1\n        if installed:\n"},{"type":"input_text","text":"===== suite_cd3_mapping =====\n      CONFIG_STEM=\"cao-p4-kvcomp\"\n      EXPECTED_CODEC=\"p4flat\"\n      FEATURE_ARGS=(--weight-comp p4flat --fused-mm --kv-comp \"$KV_BACKEND\")\n      ;;\n    cao-cd3)\n      METHOD_LABEL=\"C.A.O(w/ CD3)\"\n      CONFIG_STEM=\"cao-cd3-fused\"\n      EXPECTED_CODEC=\"chunk_delta3\"\n      FEATURE_ARGS=(--weight-comp chunk_delta3)\n      ;;\n    cao-cd3-fused)\n      METHOD_LABEL=\"C.A.O-fused(w/ CD3)\"\n      CONFIG_STEM=\"cao-cd3-fused\"\n      EXPECTED_CODEC=\"chunk_delta3\"\n      METHOD_ENV=(\"TIERED_SERVE_CD3_FUSED_MAX_N=128\")\n      FEATURE_ARGS=(--weight-comp chunk_delta3 --fused-mm)\n      ;;\n    cao-cd3-fused-kvcomp)\n      METHOD_LABEL=\"C.A.O-fused(w/ CD3)-kvcomp\"\n      CONFIG_STEM=\"cao-cd3-fused