{"timestamp":"2026-09-01T11:14:17.553Z","ordinal":222,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a05ca8-8464-73e2-8414-a95b4cccb986","turn_id":"01a05caa-86d2-74a0-902c-e1d114acee36","item":{"type":"FileChange","id":"exec-5335f1d1-4580-4a0b-a5f0-dbcee244646a","changes":{"/home/ubuntu/compressor-fix.rsx8GU/compressor.py":{"type":"delete","content":"from tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\n\nclass CompressorMixin:\n\n    def _auto_dietgpu_workspace_bytes(self) -> Optional[int]:\n        \"\"\"Compute a workspace size large enough for DietGPU to compress\n        the model's biggest tensor without falling back to ``cudaMalloc``.\n\n        The fallback path triggers HBM ``torch.empty`` at compress time,\n        which races a frozen_split-filled HBM and OOMs (e.g. on Qwen-110B\n        the ``gate_up_proj`` compress needs ~1031 MiB of scratch but the\n        upstream default workspace is only 384 MiB).  Sizing from the\n        actual model avoids the user having to hand-tune\n        ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB`` per model.\n\n        Returns ``None`` to defer to the env-var / module default when\n        the model walk can't find a suitable reference tensor.\n        \"\"\"\n        # User override always wins.\n        if os.getenv(\"TIERED_SERVE_DIETGPU_WORKSPACE_MIB\") is not None:\n            return None\n        ref_blk = self.torch_model.decoder_blocks[0]\n        max_numel = 0\n        for name in self.tensor_names:\n            leaf_name, _, tensor_name = name.rpartition(\".\")\n            try:\n                leaf = ref_blk.module.get_submodule(leaf_name)\n            except AttributeError:\n                continue\n            t = getattr(leaf, tensor_name, None)\n            if t is None:\n                continue\n            if t.numel() > max_numel:\n                max_numel = t.numel()\n        if max_numel == 0:\n            return None\n        # Empirically DietGPU's compress on a BF16 [M, K] tensor peaks at\n        # ~1.22 × (M*K) bytes of stack memory (sm + exp scratch + ANS\n        # state + histograms).  110B observation: M*K=805 MiB requested\n        # 984 MiB.  1.4× gives ~14% headroom for variation across\n        # tensor shapes / vocabularies; round up to MiB.\n        bytes_needed = int(max_numel * 1.4) + 1\n        # Round up to the next MiB to get a clean log line.\n        return ((bytes_needed + (1 << 20) - 1) >> 20) << 20\n\n    def _make_weight_compressor(self, backend: str, *, role: str):\n        \"\"\"Instantiate a single weight compressor for the given backend name.\n\n        ``role`` is \"split\" / \"offload\" / \"default\" and only affects the\n        log line so dual-compressor runs are debuggable.\n\n        ``_AutoWeightCompressor`` lazy-instantiates its BF16/FP8 sub-\n        compressors on first ``compress``/``decompress`` call.  That's\n        unsafe in mixed-backend mode: when the offload compressor is\n        DietGPU and the split compressor is ZipServ, all frozen_split\n        layers compress first and fill HBM with sign_mantissa; by the\n        time the first offload_compressed layer hits DietGPU, the ~1 GB\n        workspace ``torch.empty`` is racing fragmented HBM and OOMs.\n        Eagerly prime BF16 here so both workspaces are allocated up\n        front while HBM is still clean.  Today's targeted models\n        (Qwen/Llama bf16) always hit the BF16 path; FP8 stays lazy.\n\n        DietGPU workspaces are auto-sized from the largest model tensor\n        so users don't need to set ``TIERED_SERVE_DIETGPU_WORKSPACE_MIB``\n        per model (the env var, if set, still wins).\n        \"\"\"\n        stream = self.decomp_weight_stream\n        auto_ws = self._auto_dietgpu_workspace_bytes()\n        if backend in (\"zipserv\", \"dietgpu\"):\n            comp = _AutoWeightCompressor(\n                family=backend, comp_stream=stream,\n                dietgpu_workspace_bytes=auto_ws)\n            comp._bf16()\n            logger.info(\n                \"Weight compressor [%s]: %s (auto BF16/FP8, BF16 primed%s)\",\n                role, backend,\n                \"\" if auto_ws is None\n                else f\", DietGPU ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"zipserv_bf16\":\n            comp = ZipServCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ (BF16)\", role)\n        elif backend == \"dietgpu_bf16\":\n            comp = DietGPUCompressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU (BF16%s)\", role,\n                \"\" if auto_ws is None\n                else f\", ws={auto_ws / (1 << 20):.0f} MiB\")\n        elif backend == \"dietgpu_fp8\":\n            comp = DietGPUFP8Compressor(stream, workspace_bytes=auto_ws)\n            logger.info(\n                \"Weight compressor [%s]: DietGPU-FP8%s\", role,\n                \"\" if auto_ws is None\n                else f\" (ws={auto_ws / (1 << 20):.0f} MiB)\")\n        elif backend == \"zipserv_fp8\":\n            # Native GPU FP8 e4m3 path via tiered-serve's zipserv_fp8_ext\n            # (forked from LLM-bitfield-compressor, built in-tree). No\n            # CPU fallback — the legacy reference impl was removed.\n            comp = ZipServFP8GpuCompressor(stream)\n            logger.info(\"Weight compressor [%s]: ZipServ-TBE-FP8 (GPU)\", role)\n        elif backend == \"p4flat\":\n            # BF16 P4-flat (16-entry exponent palette + rank-1 exception\n            # patch fused MM); sources copied from LLM-bitfield-compressor,\n            # built via cpp_exts.zipserv_p4flat_ext.\n            from tiered_serve.tensor_compressor import P4FlatCompressor\n            comp = P4FlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 P4-flat\", role)\n        elif backend == \"chunk_delta3\":\n            from tiered_serve.tensor_compressor import ChunkDelta3Compressor\n            comp = ChunkDelta3Compressor(stream)\n            logger.info(\n                \"Weight compressor [%s]: BF16 ChunkDelta3 \"\n                \"(CPU encode, GPU decode/fused-MM)\", role)\n        elif backend == \"p4d16\":\n            # BF16 Global-P4-D16 (variant B): single tensor-global 16-entry\n            # exponent palette + 16x16 D16 codec markers + 4-bit codes +\n            # element-level exceptions. Built via cpp_exts.zipserv_p4d16_ext.\n            from tiered_serve.tensor_compressor import P4D16Compressor\n            comp = P4D16Compressor(stream)\n            logger.info(\"Weight compressor [%s]: BF16 Global-P4-D16\", role)\n        elif backend == \"p3flat_fp8\":\n            # FP8 e4m3 P3-flat (7-entry exp palette + marker code + 4-bit sm\n            # nibble); bit-exact reconstruction via per-tile exception\n            # substream + warp prefix-sum in decompress kernel.\n            from tiered_serve.tensor_compressor import P3FlatFP8Compressor\n            comp = P3FlatFP8Compressor(stream)\n            logger.info(\"Weight compressor [%s]: FP8 e4m3 P3-flat\", role)\n        elif backend == \"ublb_flat\":\n            # UB/LB byte-split BF16: upper byte = flat 4-bit palette code,\n            # lower byte raw (ratio 1.333x). With --fused-mm the hot path runs\n            # the RS-mode register-A WGMMA fused decode+GEMM kernel.\n            from tiered_serve.tensor_compressor import UBLBFlatCompressor\n            comp = UBLBFlatCompressor(stream)\n            logger.info(\"Weight compressor [%s]: UBLB-flat (BF16)\", role)\n        else:\n            raise ValueError(\n                f\"Unknown weight compressor backend ({role}): \"\n                f\"{backend!r}. Expected one of: \"\n                f\"zipserv, dietgpu, zipserv_bf16, dietgpu_bf16, \"\n                f\"zipserv_fp8, dietgpu_fp8, p4flat, p4d16, p3flat_fp8, \"\n                f\"ublb_flat, chunk_delta3.\")\n        self._configure_weight_compressor_runtime(comp)\n        return comp\n\n    def _configure_weight_compressor_runtime(self, comp):\n        \"\"\"Attach loader runtime constants to compressor objects.\"\"\"\n        if comp is None or not hasattr(self, \"_cudagraph_ceiling\"):\n            return\n        comp._cudagraph_ceiling = self._cudagraph_ceiling\n        bf16 = getattr(comp, \"_bf16_impl\", None)\n        if bf16 is not None:\n            bf16._cudagraph_ceiling = self._cudagraph_ceiling\n\n    def _compressor_for_mode(self, mode: str):\n        \"\"\"Return the weight compressor instance for a given residency mode.\n\n        ``frozen_split`` is routed to the split-tuned compressor; every\n        other mode that needs a compressor uses the offload one.  Falls\n        back to ``self.weight_compressor`` so this is safe to call even\n        before per-mode compressors are initialised (lazy paths).\n        \"\"\"\n        if mode == \"frozen_split\":\n            return self._compressor_split or self.weight_compressor\n        return self._compressor_offload or self.weight_compressor\n\n    def _compressor_for_cell(self, layer_id: int, comp_key: str,\n                             mode: \"Optional[str]\" = None):\n        \"\"\"Return the compressor instance to use for one (layer, component).\n\n        Honors per-cell compressor overrides from the YAML layer_residency\n        ``{mode, compressor}`` cells: when a cell pins ``compressor: X``,\n        we look up ``X`` in the per-backend pool (lazy-instantiating it\n        the first time) and return that instance.  Cells without an\n        explicit compressor fall through to the legacy\n        ``_compressor_for_mode`` behaviour.\n\n        ``mode`` is optional; when omitted, it's read from\n        ``self.torch_model.layer_weight_comp``.  Passing it explicitly\n        is a perf shortcut on hot paths that already have the mode.\n        \"\"\"\n        # Per-cell override has priority.\n        tm = getattr(self, \"torch_model\", None)\n        if tm is not None:\n            comps = getattr(tm, \"layer_weight_compressor\", None)\n            if comps is not None and 0 <= layer_id < len(comps):\n                backend = comps[layer_id].get(comp_key)\n                if backend is not None:\n                    return self._get_or_make_backend(backend)\n        # Fallback: legacy mode-based selection.\n        if mode is None and tm is not None:\n            mode = tm.layer_weight_comp[layer_id].get(comp_key, \"\")\n        return self._compressor_for_mode(mode or \"\")\n\n    def _get_or_make_backend(self, backend: str):\n        \"\"\"Lazy-instantiate (and memoise) a compressor for ``backend``.\n\n        Shares the split / offload instances when the requested\n        backend matches what was set up from env vars, so the pool\n        doesn't double-allocate the same codec's workspace.\n        \"\"\"\n        pool = getattr(self, \"_compressors_by_backend\", None)\n        if pool is None:\n            pool = {}\n            self._compressors_by_backend = pool\n        existing = pool.get(backend)\n        if existing is not None:\n            return existing\n        # Match the exact backend names configured for the split / offload\n        # instances created in __init__.\n        for slot_backend, slot in (\n                (getattr(self, \"_split_backend\", None),\n                 self._compressor_split),\n                (getattr(self, \"_offload_backend\", None),\n                 self._compressor_offload)):\n            if slot is not None and slot_backend == backend:\n                pool[backend] = slot\n                return slot\n        # Build a fresh instance — same path as init-time backend choice.\n        instance = self._make_weight_compressor(backend, role=\"cell\")\n        pool[backend] = instance\n        return instance\n\n    def _ensure_weight_compressor_lazy(self):\n        \"\"\"Initialise the per-mode weight compressors on demand.\n\n        Some code paths (legacy ``_init_weights_compressed_only`` and the\n        ``reconfigure_layer_residency`` transition handler) can introduce\n        a compressed mode after ``__init__`` has already run with\n        ``use_weight_comp=False``.  They previously bare-instantiated\n        ``ZipServCompressor`` straight into ``self.weight_compressor``.\n        Route those callers through here so the per-mode handles stay\n        consistent with the rest of the loader.\n        \"\"\"\n        if self._compressor_offload is None:\n            self._compressor_offload = ZipServCompressor(\n                self.decomp_weight_stream)\n        if self._compressor_split is None:\n            # Mirror the offload choice; if the user wanted them split they\n            # would have set USE_WEIGHT_COMP=1 up front.\n            self._compressor_split = self._compressor_offload\n        if self.weight_compressor is None:\n            self.weight_compressor = self._compressor_offload\n        self._configure_weight_compressor_runtime(self._compressor_offload)\n\n    def _resolve_backend_compressor(self, info, layer_id=None,\n                                    comp_key=None):\n        \"\"\"Return the concrete sub-compressor (with ``_ext`` / dietgpu\n        helpers) for a frozen_split tensor.  Handles both the directly-\n        instantiated ZipServ/DietGPU compressors and the auto-dispatching\n        wrapper ``_AutoWeightCompressor`` (which exposes its BF16/FP8\n        backends only through ``_bf16()`` / ``_fp8()``).\n\n        When the (layer, component) cell pinned a per-cell ``compressor``\n        in the YAML, resolve that backend instead of the global split one\n        so the reconstruct codec matches whatever compressed the cell at\n        init (see the frozen_split init branch, which keys off the same\n        ``layer_weight_compressor`` via ``_compressor_for_cell``).\"\"\"\n        wc = None\n        if layer_id is not None and comp_key is not None:\n            tm = getattr(self, \"torch_model\", None)\n            comps = getattr(tm, \"layer_weight_compressor\", None) if tm else None\n            if comps is not None and 0 <= layer_id < len(comps):\n                backend = comps[layer_id].get(comp_key)\n                if backend is not None:\n                    wc = self._get_or_make_backend(backend)\n        # No per-cell override → global split-tuned compressor.\n        if wc is None:\n            wc = self._compressor_split or self.weight_compressor\n        # _AutoWeightCompressor: dispatch via the SplitStorageInfo backend\n        # tag — BF16 weights produce backend \"zipserv\"/\"dietgpu\", FP8\n        # weights produce \"zipserv_fp8\"/\"dietgpu_fp8\".\n        if hasattr(wc, \"family\"):\n            if info.backend in (\"dietgpu_fp8\", \"zipserv_fp8\"):\n                return wc._fp8()\n            return wc._bf16()\n        return wc\n"}},"status":"completed","stdout":"Success. Updated the following files:\nD compressor-fix.rsx8GU/compressor.py\n","stderr":""},"started_at_ms":1788261257553,"completed_at_ms":1788261257553}}
