mp_stream,\n                    workspace_bytes=self._dietgpu_workspace_bytes)\n            logger.info(\n                \"AutoWeightCompressor: instantiated BF16 backend \"\n                f\"({self.family})\")\n        return self._bf16_impl\n\n    def _fp8(self):\n        if self._fp8_impl is None:\n            if self.family == \"zipserv\":\n                # Native GPU FP8 e4m3 path (no CPU fallback — the legacy\n                # reference impl has been removed in favour of the in-tree\n                # zipserv_fp8_ext extension).\n                self._fp8_impl = ZipServFP8GpuCompressor(self.comp_stream)\n            else:\n                self._fp8_impl = DietGPUFP8Compressor(\n                    self.comp_stream,\n                    workspace_bytes=self._dietgpu_workspace_bytes)\n            logger.info(\n                \"AutoWeightCompressor: instantiated FP8 backend \"\n                f\"({self.family}_fp8)\")\n        return self._fp8_impl\n\n    # ----- dispatch -----\n\n    def _pick_for_dtype(self, dtype):\n        if _fp8_kind_of(dtype) is not None:\n            return self._fp8()\n        if dtype == torch.bfloat16:\n            return self._bf16()\n        raise TypeError(\n            f\"AutoWeightCompressor: unsupported dtype {dtype}; expected \"\n            \"bfloat16 or float8_e4m3fn/float8_e5m2\")\n\n    def compress(self, weight, *args, **kwargs):\n        return self._pick_for_dtype(weight.dtype).compress(\n            weight, *args, **kwargs)\n\n    def decompress(self, comp, *args, **kwargs):\n        # Pick backend from the compressed-tensor class so this works\n        # after a round-trip through disk/pool.\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            return self._fp8().decompress(comp, *args, **kwargs)\n        return self._bf16().decompress(comp, *args, **kwargs)\n\n    def compress_batch(self, weights, *args, **kwargs):\n        # Loop fallback: per-tensor dispatch handles mixed dtypes.\n        return [self.compress(w, *args, **kwargs) for w in weights]\n\n    def decompress_batch(self, comps, outputs=None):\n        outs = outputs or [None] * len(comps)\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\n\n    def fused_mm(self, comp, *args, **kwargs):\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"fused_mm is only implemented for BF16 compressors\")\n        return self._bf16().fused_mm(comp, *args, **kwargs)\n\n    def linear_apply(self, comp, x, *args, **kwargs):\n        # Hot path under ``--fused-mm`` (see graph_wait_ops._fused_linear_apply\n        # _impl).  frozen_split shells are BF16; FP8 has no fused path.\n        if isinstance(comp, (CompressedDietGPUFP8Tensor,\n                             CompressedZipServFP8GpuTensor)):\n            raise NotImplementedError(\n                \"linear_apply (fused) is only implemented for BF16 compressors\")\n        return self._bf16().linear_apply(comp, x, *args, **kwargs)\n\n    def build_split_shell(self, info, staging_dict):\n        # frozen_split fused-MM install: delegate to the BF16 backend (the\n        # split codec compresses BF16 sign+mantissa).  Raises\n        # NotImplementedError if the backend lacks fused support; the\n        # DualMemoryLoader install loop catches it and skips the override.\n        return self._bf16().build_split_shell(info, staging_dict)\n\n    def build_offload_shell(self, comped, output_tensor=None):\n        # offload_compressed fused-MM install: delegate to the BF16 backend.\n        # AttributeError (backend lacks it) / NotImplementedError are caught by\n        # the install loop, which then leaves the cell on the dense path.\n        return self._bf16().build_offload_shell(comped, output_tensor)\n\n    # ----- workspace management -----\n\n    def shrink_workspace_for_decompress(self, target_bytes: int) -> int:\n        \"\"\"Forward the post-load workspace shrink to whichever sub-\n        compressors have been instantiated.  No-op for backends without\n        a shrinkable ANS workspace (e.g. ZipServ).\"\"\"\n        freed = 0\n        for impl in (self._bf16_impl, self._fp8_impl):\n            fn = getattr(impl, \"shrink_workspace_for_decompress\", None)\n            if fn is not None:\n                freed += fn(target_bytes)\n        return freed\n38bf1a9 Add barrier when yaml and args are different\n tiered_serve/dual_memory_loader/__init__.py        | 27 ++++++++++++++++++++--\n .../Llama-3.1-70B-Instruct/flexgen-comp.yaml       |  8 +++----\n 2 files changed, 29 insertions(+), 6 deletions(-)\ncommit 38bf1a93aafb4659a61b78e4e6b6cdecafc20090\nAuthor:     ItsAbdula <whchoi@csl.korea.ac.kr>\nAuthorDate: Tue Aug 18 02:37:50 2026 +0900\nCommit:     ItsAbdula <whchoi@csl.korea.ac.kr>\nCommitDate: Tue Aug 18 02:37:50 2026 +0900\n\n    Add barrier when yaml and args are different\n\ndiff --git a/tiered_serve/dual_memory_loader/__init__.py b/tiered_serve/dual_memory_loader/__init__.py\nindex c836786..9126274 100644\n--- a/tiered_serve/dual_memory_loader/__init__.py\n+++ b/tiered_serve/dual_memory_loader/__init__.py\n@@ -1120,6 +1120,29 @@ class DualMemoryLoader(\n             self.dst_comp.append([None for _ in range(len(self.tensor_names))])\n \n         # If n_weight_buffer is changed, this one might changed too\n+        self._preload_decoder_weights()\n+\n+    def _decompress_preload(self, src, layer_id: int, comp_key: str):\n+        \"\"\"Decompress a preloaded weight tensor, checking that the\n+        global ``weight_compressor`` matches the compressor actually\n+        used to compress this cell.  When YAML per-cell compressor\n+        overrides differ from the global ``TIERED_SERVE_WEIGHT_COMP_BACKEND``,\n+        the decompress would silently get the wrong codec — raise an\n+        explicit error so the user fixes the config instead.\n+        \"\"\"\n+        cell_comp = self._compressor_for_cell(layer_id, comp_key)\n+        if cell_comp is not self.weight_compressor:\n+            raise RuntimeError(\n+                f\"Preload decompress type mismatch for layer {layer_id} \"\n+                f\"{comp_key}: the global weight_compressor \"\n+                f\"({type(self.weight_compressor).__name__}) differs \"\n+                f\"from the per-cell compressor \"\n+                f\"({type(cell_comp).__name__}) that compressed this \"\n+                f\"tensor. Fix the YAML layer_weight_compressor or \"\n+                f\"TIERED_SERVE_WEIGHT_COMP_BACKEND so they agree.\")\n+        self.weight_compressor.decompress(src)\n+\n+    def _preload_decoder_weights(self):\n         preload_decoder = self.not_frozen_layers[:self.n_weight_buffers]\n         for idx in preload_decoder:\n             for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n@@ -1144,7 +1167,7 @@ class DualMemoryLoader(\n                         # LPDDR via host-mapped UVA.\n                         self.decomp_weight_stream.wait_stream(\n                             self.load_weight_stream)\n-                        self.weight_compressor.decompress(src)\n+                        self._decompress_preload(src, idx, comp_key)\n                         torch.cuda.synchronize()\n                     else:\n                         # Compressed: H2D + decompress\n@@ -1152,7 +1175,7 @@ class DualMemoryLoader(\n                             src.to(self.primary_device, non_blocking=True)\n                         self.decomp_weight_stream.wait_stream(\n                             self.load_weight_stream)\n-                        self.weight_compressor.decompress(src)\n+                        self._decompress_preload(src, idx, comp_key)\n                         torch.cuda.synchronize()\n             logger.info(f\"Preload layer {idx}: done\")\n \n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05ca8-c37b-7191-9553-badb97929a66","create_time":1788261004.5151668}}}
