pressor \"\n                f\"({type(cell_comp).__name__}) that compressed this \"\n                f\"tensor. Fix the YAML layer_weight_compressor or \"\n                f\"TIERED_SERVE_WEIGHT_COMP_BACKEND so they agree.\")\n        self.weight_compressor.decompress(src)\n\n    def _preload_decoder_weights(self):\n        preload_decoder = self.not_frozen_layers[:self.n_weight_buffers]\n        for idx in preload_decoder:\n            for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                begin, end = MODEL_TO_LOAD_TARGET[_get_model_id()][comp_key]\n                for tidx in range(begin, end):\n                    name = self.tensor_names[tidx]\n                    src = self._get_weight_source(idx, name)\n                    if src is None:\n                        continue\n\n                    dst = self.primary_buffers[idx]\n                    if dst is None:\n                        continue\n\n                    if isinstance(src, torch.Tensor):\n                        with torch.cuda.stream(self.load_weight_stream):\n                            dst[name].copy_(src, non_blocking=True)\n                        torch.cuda.synchronize()\n                    elif self._ats_decomp_offload:\n                        # ATS-decomp: skip H2D into GPU staging; decompress\n                        # kernel reads compressed buffers directly from\n                        # LPDDR via host-mapped UVA.\n                        self.decomp_weight_stream.wait_stream(\n                            self.load_weight_stream)\n                        self._decompress_preload(src, idx, comp_key)\n                        torch.cuda.synchronize()\n                    else:\n                        # Compressed: H2D + decompress\n                        with torch.cuda.stream(self.load_weight_stream):\n                            src.to(self.primary_device, non_blocking=True)\n                        self.decomp_weight_stream.wait_stream(\n                            self.load_weight_stream)\n                        self._decompress_preload(src, idx, comp_key)\n                        torch.cuda.synchronize()\n            logger.info(f\"Preload layer {idx}: done\")\n\n    # Modes that use the \"offload-style\" compressor (full-tensor compress\n    # per forward).  frozen_split is intentionally absent — it has its own\n"},{"type":"input_text","text":"===== init_cd3_routes =====\n                raw_mode = (\n                    self.layer_weight_comp[idx].get(\n                        comp_key, \"offload\")\n                    if comp_key else \"offload\")\n                mode = self._effective_mode(raw_mode, is_frozen)\n\n                leaf_name, _, tensor_name = name.rpartition(\".\")\n                leaf_module = blk.module.get_submodule(leaf_name)\n                target: torch.Tensor = getattr(\n                    leaf_module, tensor_name, None)\n                if target is None:\n                    raise RuntimeError(\n                        f\"Can't find {name} in {blk.module._get_name()}\")\n\n                if mode == \"offload\":\n                    # Always store uncompressed copy in DRAM.\n                    # After UVA conversion the param.data is a cuda view;\n                    # prefer the original CPU hugepage tensor stored by\n                    # immigrant_model_loader so secondary→primary copies\n                    # are proper H2D transfers.\n                    if isinstance(target, torch.nn.Parameter):\n                        uncomp_dict[name] = getattr(\n                            target, '_tiered_serve_cpu_data', target.data)\n                    else:\n                        uncomp_dict[name] = target\n                    # When USE_WEIGHT_COMP=1, also store compressed copy\n                    if DualMemoryLoader.use_weight_comp:\n                        logger.info(\n                            f\"Compressing Decoder-{idx}.{name}\")\n                        with torch.cuda.stream