uires_grad=False))\n\n                    # Install fused decompress+GEMM override if the user\n                    # enabled --fused-mm and the bound compressor exposes\n                    # a native fused kernel.  With fused_mm the dense\n                    # decompress kernel is skipped (see\n                    # decompress_frozen_tensors); the compressed buffer\n                    # is permanent HBM so no H2D is needed either.\n                    self._maybe_install_fused_mm(\n                        leaf_module, comped,\n                        self._compressor_for_cell(idx, comp_key, mode=mode),\n                        layer_id=idx,\n                        comp_id=_FUSED_MM_COMP_TO_ID.get(comp_key),\n                        mode=\"frozen_compressed\", tensor_name=name)\n\n                elif mode == \"frozen_split\":\n                    # Compress on GPU, keep sign_mantissa on HBM,\n                    # move remaining buffers to LPDDR hugepage.\n                    parity = idx % self.FROZEN_DECOMP_PARITY\n                    primary = self.frozen_primary_buffer_pair[name][parity]\n                    on_hugepage = getattr(target, '_on_hugepage', False)\n                    if is_frozen and target.device.type == \"cuda\" \\\n                            and not on_hugepage:\n                        gpu_target = target\n                    else:\n                        gpu_target = primary\n\n                    logger.info(\n                        f\"Compressing FrozenSplit Layer {idx}.{name}\")\n                    with torch.cuda.stream(self.decomp_weight_stream):\n                        if gpu_target is primary \\\n                                and gpu_target is not target:\n                            gpu_target.copy_(target, non_blocking=False)\n                        # Per-cell backend: the resulting CompressedTensor\n                        # type sets SplitStorageInfo.backend below, and the\n                        # decode reconstruct (