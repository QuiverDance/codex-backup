die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --breakdown)\n      BREAKDOWN=1\n      shift\n      ;;\n    --smoke)\n      SMOKE=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor codec in \"${CODECS[@]}\"; do\n  [[ \"$codec\" == p4flat || \"$codec\" == cd3 ]] \\\n    || die \"unsupported codec: ${codec}\"\ndone\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not-executable=${CLIENT_SCRIPT}\")\n\n  for required in nvidia-smi numactl setsid curl findmnt awk sed grep tee; do\n    command -v \"$required\" >/dev/null || problems+=(\"command-missing=${required}\")\n  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  local codec config expected\n  for codec in \"${CODECS[@]}\"; do\n    if [[ \"$codec\" == p4flat ]]; then\n      expected=p4flat\n      for config in \"$P4_RAW_CONFIG\" \"$P4_KVCOMP_CONFIG\"; do\n        [[ -e \"$config\" ]] || problems+=(\"missing=${config}\")\n        grep -Eq \"compressor:[[:space:]]*${expected}\" \"$config\" \\\n# Serving 실행 가이드\n\nOpenAI-compatible server의 기준 진입점은 `serve_offload_kvweight.py`다.\n이 launcher가 tiered 환경을 engine 생성 전에 고정하고 patched vLLM의\n`run_server()`를 시작한다. Startup과 request별 내부 순서는\n[Inference 수행 흐름](INFERENCE_FLOW.md)을 사용한다.\n\n모든 명령은 저장소 루트에서 실행한다.\n\n```bash\ncd /root/projects/tiered-serve\n```\n\n## 0. LD_PRELOAD: CPython frame-stack mmap/munmap 제거\n\nCPython 3.12은 interpreter frame data-stack을 16 KiB 단위로\n`mmap(MAP_ANONYMOUS)`/`munmap`으로 할당·해제한다. vLLM V1의 깊은\nper-piece call chain(~80 layer × 4 projection)이 이 경계를 반복적으로\n넘어 nsys에서 step당 수천 회의 `mmap64`/`munmap`을 발생시킨다.\n\n`etc/stack_pool.so`는 `mmap64`/`munmap`을 가로채서 16 KiB chunk를\nfree-list pool로 재사용한다. 반환 시 `memset`으로 zeroing하여\n`MAP_ANONYMOUS`의 zeroed-page 계약을 보존한다. 이로써 step당\nmmap/munmap을 0으로 만든다.\n\n**모든 실행 명령에 `LD_PRELOAD`를 붙인다.**\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so\n```\n\n`.so` 빌드 방법은 [구조 가이드의 Tips](LANDING_GUIDE.md#6-tips)를\n참고한다.\n\n## 1. 시작 전 확인\n\n```bash\nnvidia-smi\nfindmnt -no TARGET,FSTYPE,OPTIONS /mnt/hugepages\ntest -w /mnt/hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/nr_hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/free_hugepages\n\n./.venv/bin/python - <<'PY'\nimport torch\nimport vllm\nimport tiered_serve\n\nprint(\"vllm:\", vllm.__file__)\nprint(\"tiered_serve:\", tiered_serve.__file__)\nprint(\"cuda:\", torch.cuda.is_available())\nPY\n```\n\nGH200 CUDA가 보여야 하며 `/mnt/hugepages`는 16 GiB hugetlbfs `rw` mount여야\n하고 현재 사용자에게 쓰기 권한이 있어야 한다. Total/free page는 weight\nreservation(70B 14장, 8B 2장)보다 커야 하며 원하는 KV capacity만큼의 page가\n추가로 남아야 한다. 모델 checkpoint/tokenizer는 local cache에 있거나\nnetwork와 Hugging Face 인증으로 받을 수 있어야 한다. Sibling patch와 native\nABI 확인은 [구조 가이드](LANDING_GUIDE.md)를 따른다.\n\n## 2. Server 시작\n\n### 2.1 70B fused weight + KV compression\n\n`all-frozen-split-p4`와 `--fused-mm`을 함께 쓰면 P4Flat weight override를\n실제로 설치하면서 KV offload/compression도 사용하는 70B profile이 된다.\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so \\\nnumactl -m 0 ./.venv/bin/python serve_offload_kvweight.py \\\n  --model meta-llama/Llama-3.1-70B-Instruct \\\n  --weight-comp p4flat \\\n  --fused-mm \\\n  --kv-comp p4flat \\\n  --ts-configs cao-p4-fused \\\n```\n\nWeight placement을 바꾸고 싶다면 다음 profile을 사용한다.\n\n| 모델 | Config | Weight 실행 |\n|---|---|---|\n| 70B | `flexgen` | even HBM + odd raw weight offload |\n| 70B | `flexgen-comp-p4` | even HBM + odd P4Flat weight offload + dense decompress |\n| 70B | `all-frozen-split-p4` | `--fused-mm` 사용 시 P4Flat split-storage override |\n\nRaw config에서는 `--weight-comp p4flat`과 `--fused-mm`을 빼고, KV compression을 끄려면\n`--kv-comp p4flat`만 뺀다. KV offload까지 끄려면 두 번째 변경과 함께\n`--no-offload-kv`를 추가한다. `--no-offload-kv --kv-comp ...` 조합은\n허용되지 않는다.\n\nWeight placement는 CLI가 아니라 YAML residency가 결정한다. `--weight-comp`\n또는 `--kv-comp`는 값을 생략하면 `zipserv`, flag 자체를 생략하면 OFF다.\n`--ts-configs`는 필수이고 여러 값을 주면 첫 config가 primary env/log stem이\n된다. `--fused-mm`은 weight-only 요청이며 compression을 켜지 않는다. KV는\nraw 또는 compressed LPDDR에서 dense HBM으로 복원된 뒤 FlashAttention이 읽는다.\n\n## 3. Launcher가 고정하는 값\n\nServing CLI의 일부 vLLM 옵션은 launcher가 engine 생성 직전에 다음처럼\n고정한다.\n\n| Engine 값 | Serving 동작 |\n|---|---|\n| Process topology | API frontend와 EngineCore child 분리; child 안은 `UniProcExecutor` |\n| `block_size` | `16` |\n| `swap_space` | `0` |\n| `enforce_eager` | `False` |\n| `max_model_len` | `--max-context-len` |\n| `max_num_batched_tokens` | chunked prefill이면 `8192`, 아니면 context length |\n| `max_num_seqs` | 요청값, 미지정 시 `512`, 최대 `512` |\n| compile cache | 매 run 비활성화 |\n| request body logging | 비활성화 |\n| KV staging buffers | `2` |\n\n따라서 context는 `--max-context-len`, concurrency는 `--max-num-seqs`,\nprefill 정책은 `--chunked-prefill` 또는 `--no-chunked-prefill`로 설정한다.\n지원 기준은 BF16, TP=1, prefix caching off다.\n\n## 4. API smoke\n\nServer가 model load와 graph capture를 끝낸 뒤 별도 terminal에서 실행한다.\n\n```bash\ncurl -fsS http://127.0.0.1:8000/health\ncurl -fsS http://127.0.0.1:8000/v1/models\n\ncurl -fsS http://127.0.0.1:8000/v1/chat/completions \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"model\": \"meta-llama/Llama-3.1-70B-Instruct\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"What is the capital of France?\"}],\n    \"temperature\": 0,\n    \"max_tokens\": 16\n  }'\n```\n\n8B server에는 request의 `model`도 8B ID로 바꾼다. `--served-model-name`을\n사용했다면 그 alias를 넣는다. `/v1/completions`도 지원한다. `--api-key`를 사용했다면\nOpenAI API 요청에 `Authorization: Bearer <key>` header를 추가한다. 외부\n접속이 필요하지 않으면 `127.0.0.1` bind를 유지한다.\n\n## 5. Server-side logging\n\nLauncher log는 자동으로 다음 위치에 생긴다.\n\n```text\nlogs/serving/<model-id>/<config>/<timestamp>/<max-context-len>.log\n```\n\n요청 구간의 server logging은 다음 endpoint로 제어한다.\n\n```bash\ncurl -fsS -X POST http://127.0.0.1:8000/start_logging\n\n# workload 실행\n\ncurl -fsS -X POST http://127.0.0.1:8000/stop_logging \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"prompt\":\"manual\"}'\n```\n\n`<max-context-len>.log`는 항상 연결된 launcher log다. `/start_logging`은\n응답으로 `engine_id`와 `log_dir`를 반환하고 workload 구간에 같은 directory의\n`server.log` handler를 추가한다. `/stop_logging`의 `prompt` 값은 현재 파일명을\n바꾸지 않는다.\n\n`--collect-time`은 endpoint와 독립적으로 startup부터 CUDA-event timing을 켜고\n`<timestamp>_<engine-id>_collect_time.log`를 쓴다. Normal latency 비교에는\n사용하지 않는다.\n\n## 6. Torch profiler\n\nProfiler endpoint는 `--profiler-config`를 준 server에만 생긴다.\n\n```bash\nmkdir -p /tmp/tiered-serve-profile\ncurl -fsS -X POST http://127.0.0.1:8000/start_profile\n# workload 실행\ncurl -fsS -X POST http://127.0.0.1:8000/stop_profile\n```\n\nServer 명령에는 다음 인자를 추가한다.\n\n```text\n--profiler-config '{\"profiler\":\"torch\",\"torch_profiler_dir\":\"/tmp/tiered-serve-profile\"}'\n```\n\nTrace는 `torch_profiler_dir`에 저장된다. Profiler, `--collect-time`, server\nlogging은 서로 다른 기능이며 profiler와 collect-time에는 계측 overhead가 있다.\n\nAPI key middleware는 `/v1` request만 검사한다. `/health`, `/metrics`, docs,\nlogging/profile endpoint 등 non-`/v1` 경로는 reverse proxy나 firewall에서\n별도로 보호한다. `--host`를 생략하면 외부 interface에 bind될 수 있으므로 local\n실험은 `127.0.0.1`을 명시한다.\n\n## 7. Client 실행\n\n```text\nbash scripts/serving/client/azure_conv.sh <model-id> <config-id> <optinal: request-rate>\n# ex) \nbash scripts/serving/client/azure_conv.sh llama70b cao-p4-kvcomp 1.0\n```\n\n## 8. 종료와 실험 wrapper\n\nForeground server는 `Ctrl-C`로 종료한다. Background 실행은 위 command의\n마지막을 `--port 8000 > /tmp/tiered-serve.out 2>&1 &`로 바꾸고 즉시 PID를\n저장한다.\n\n```bash\nSERVER_PID=$!\n\n# workload가 끝난 뒤\nkill -INT \"$SERVER_PID\"\nwait \"$SERVER_PID\"\n```\n\nLauncher의 `finally`는 CUDA context가 살아 있을 때 C++ KV offload system을\n명시적으로 shutdown한다. `SIGKILL`은 이 경로와 hugetlbfs file cleanup을\n건너뛴다.\n\n`scripts/serving/run_experiment.sh`와\n`scripts/serving/run_experiment_tmux.sh`는 고정된 model/config/client sweep용\nwrapper다. 일반 server 기동에는 위 launcher 명령을 사용한다. 두 wrapper의\n`PORT`는 health check에 쓰이지만 server `--port`로 전달되지 않아 8000 이외의\n값은 직접 수정해야 한다. tmux wrapper는 timeout 뒤 `SIGKILL`, 이어서 container\n안의 모든 Python process cleanup까지 수행하므로 공유 container에서는 실행하지\n않는다.\n\n문제가 생기면 startup log에서 다음 순서로 확인한다.\n\n1. sibling vLLM import와 resolved weight residency\n2. `##### Using Fused MM` 요청과 installed override 또는 explicit fallback 수\n3. KV topology의 dedicated/offloadable/tail block 수\n4. `##### KV full-block-only enabled`와 compressor backend\n5. request 실패 직전 CUDA/engine traceback\n","exit_code":0,"duration":{"secs":0,"nanos":6848},"formatted_output":"#!/usr/bin/env bash\nset -Eeuo pipefail\n\nSCRIPT_DIR=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREPO_ROOT=\"$(cd -- \"${SCRIPT_DIR}/../..\" && pwd)\"\n\nPYTHON_BIN=\"${REPO_ROOT}/.venv/bin/python\"\nSERVER_SCRIPT=\"${REPO_ROOT}/serve_offload_kvweight.py\"\nCLIENT_SCRIPT=\"${REPO_ROOT}/scripts/serving/client/azure_conv.sh\"\nMODEL_CONFIG_DIR=\"${REPO_ROOT}/tiered_serve/model_configs/meta-llama/Llama-3.1-70B-Instruct\"\nP4_RAW_CONFIG=\"${MODEL_CONFIG_DIR}/cao-p4-fused.yaml\"\nP4_KVCOMP_CONFIG=\"${MODEL_CONFIG_DIR}/cao-p4-kvcomp.yaml\"\nCD3_CONFIG=\"${MODEL_CONFIG_DIR}/cao-cd3-fused.yaml\"\nSTACK_POOL_SO=\"${REPO_ROOT}/etc/stack_pool.so\"\n\nMODEL_ALIAS=\"llama70b\"\nMODEL_PATH=\"meta-llama/Llama-3.1-70B-Instruct\"\nPORT=8000\n\nCODECS=(p4flat cd3)\nMODES=(raw kvcomp)\nCHUNKS=(2048 4096 8192)\nREQUEST_RATES=(1.2)\nREPEATS=1\nMAX_NUM_SEQS=128\nMAX_CONTEXT_LEN=8192\nDEDICATED_KV_BLOCKS=2432\nWEIGHT_HUGE_PAGES=14\nWEIGHT_BUFFERS=2\nGPU_RESERVE_GIB=6\nKV_ADDR_ORDER=1\nKV_LOCALITY=0\nKV_RANDOM_ALLOC=0\n\nNUMA_NODE=0\nGPU_INDEX=0\nSTARTUP_TIMEOUT=900\nSHUTDOWN_TIMEOUT=120\nCLEANUP_TIMEOUT=180\nMAX_IDLE_HBM_MIB=1024\nOUTPUT_ROOT=\"${REPO_ROOT}/benchmark_results/serving_suite\"\nDRY_RUN=0\nCHECK_ONLY=0\nBREAKDOWN=0\nSMOKE=0\n\nusage() {\n  cat <<'EOF'\nUsage: scripts/serving/run_performance_suite.sh [options]\n\nRuns isolated llama70b serving experiments. Every combination of KV mode,\nchunk size, request rate, and repeat gets a fresh server process.\n\nOptions:\n  --codecs LIST                 p4flat,cd3 (default: p4flat,cd3)\n  --modes LIST                  raw,kvcomp (default: raw,kvcomp)\n  --chunks LIST                 Comma-separated max_num_batched_tokens\n                                (default: 2048,4096,8192)\n  --request-rates LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 1)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --breakdown                   Record a detailed timing breakdown for every\n                                server forward iteration\n  --smoke                       Run two requests without percentile trimming;\n                                validates startup and request handling only\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --codecs cd3\n  scripts/serving/run_performance_suite.sh --codecs p4flat,cd3 --chunks 8192\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\n  scripts/serving/run_performance_suite.sh --chunks 8192 --breakdown\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --codecs)\n      (($# >= 2)) || die \"--codecs requires a value\"\n      parse_csv \"$2\" CODECS\n      shift 2\n      ;;\n    --modes)\n      (($# >= 2)) || die \"--modes requires a value\"\n      parse_csv \"$2\" MODES\n      shift 2\n      ;;\n    --chunks)\n      (($# >= 2)) || die \"--chunks requires a value\"\n      parse_csv \"$2\" CHUNKS\n      shift 2\n      ;;\n    --request-rates)\n      (($# >= 2)) || die \"--request-rates requires a value\"\n      parse_csv \"$2\" REQUEST_RATES\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --max-num-seqs)\n      (($# >= 2)) || die \"--max-num-seqs requires a value\"\n      MAX_NUM_SEQS=\"$2\"\n      shift 2\n      ;;\n    --dedicated-kv-blocks)\n      (($# >= 2)) || die \"--dedicated-kv-blocks requires a value\"\n      DEDICATED_KV_BLOCKS=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --weight-buffers)\n      (($# >= 2)) || die \"--weight-buffers requires a value\"\n      WEIGHT_BUFFERS=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --breakdown)\n      BREAKDOWN=1\n      shift\n      ;;\n    --smoke)\n      SMOKE=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor codec in \"${CODECS[@]}\"; do\n  [[ \"$codec\" == p4flat || \"$codec\" == cd3 ]] \\\n    || die \"unsupported codec: ${codec}\"\ndone\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not-executable=${CLIENT_SCRIPT}\")\n\n  for required in nvidia-smi numactl setsid curl findmnt awk sed grep tee; do\n    command -v \"$required\" >/dev/null || problems+=(\"command-missing=${required}\")\n  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  local codec config expected\n  for codec in \"${CODECS[@]}\"; do\n    if [[ \"$codec\" == p4flat ]]; then\n      expected=p4flat\n      for config in \"$P4_RAW_CONFIG\" \"$P4_KVCOMP_CONFIG\"; do\n        [[ -e \"$config\" ]] || problems+=(\"missing=${config}\")\n        grep -Eq \"compressor:[[:space:]]*${expected}\" \"$config\" \\\n# Serving 실행 가이드\n\nOpenAI-compatible server의 기준 진입점은 `serve_offload_kvweight.py`다.\n이 launcher가 tiered 환경을 engine 생성 전에 고정하고 patched vLLM의\n`run_server()`를 시작한다. Startup과 request별 내부 순서는\n[Inference 수행 흐름](INFERENCE_FLOW.md)을 사용한다.\n\n모든 명령은 저장소 루트에서 실행한다.\n\n```bash\ncd /root/projects/tiered-serve\n```\n\n## 0. LD_PRELOAD: CPython frame-stack mmap/munmap 제거\n\nCPython 3.12은 interpreter frame data-stack을 16 KiB 단위로\n`mmap(MAP_ANONYMOUS)`/`munmap`으로 할당·해제한다. vLLM V1의 깊은\nper-piece call chain(~80 layer × 4 projection)이 이 경계를 반복적으로\n넘어 nsys에서 step당 수천 회의 `mmap64`/`munmap`을 발생시킨다.\n\n`etc/stack_pool.so`는 `mmap64`/`munmap`을 가로채서 16 KiB chunk를\nfree-list pool로 재사용한다. 반환 시 `memset`으로 zeroing하여\n`MAP_ANONYMOUS`의 zeroed-page 계약을 보존한다. 이로써 step당\nmmap/munmap을 0으로 만든다.\n\n**모든 실행 명령에 `LD_PRELOAD`를 붙인다.**\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so\n```\n\n`.so` 빌드 방법은 [구조 가이드의 Tips](LANDING_GUIDE.md#6-tips)를\n참고한다.\n\n## 1. 시작 전 확인\n\n```bash\nnvidia-smi\nfindmnt -no TARGET,FSTYPE,OPTIONS /mnt/hugepages\ntest -w /mnt/hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/nr_hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/free_hugepages\n\n./.venv/bin/python - <<'PY'\nimport torch\nimport vllm\nimport tiered_serve\n\nprint(\"vllm:\", vllm.__file__)\nprint(\"tiered_serve:\", tiered_serve.__file__)\nprint(\"cuda:\", torch.cuda.is_available())\nPY\n```\n\nGH200 CUDA가 보여야 하며 `/mnt/hugepages`는 16 GiB hugetlbfs `rw` mount여야\n하고 현재 사용자에게 쓰기 권한이 있어야 한다. Total/free page는 weight\nreservation(70B 14장, 8B 2장)보다 커야 하며 원하는 KV capacity만큼의 page가\n추가로 남아야 한다. 모델 checkpoint/tokenizer는 local cache에 있거나\nnetwork와 Hugging Face 인증으로 받을 수 있어야 한다. Sibling patch와 native\nABI 확인은 [구조 가이드](LANDING_GUIDE.md)를 따른다.\n\n## 2. Server 시작\n\n### 2.1 70B fused weight + KV compression\n\n`all-frozen-split-p4`와 `--fused-mm`을 함께 쓰면 P4Flat weight override를\n실제로 설치하면서 KV offload/compression도 사용하는 70B profile이 된다.\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so \\\nnumactl -m 0 ./.venv/bin/python serve_offload_kvweight.py \\\n  --model meta-llama/Llama-3.1-70B-Instruct \\\n  --weight-comp p4flat \\\n  --fused-mm \\\n  --kv-comp p4flat \\\n  --ts-configs cao-p4-fused \\\n```\n\nWeight placement을 바꾸고 싶다면 다음 profile을 사용한다.\n\n| 모델 | Config | Weight 실행 |\n|---|---|---|\n| 70B | `flexgen` | even HBM + odd raw weight offload |\n| 70B | `flexgen-comp-p4` | even HBM + odd P4Flat weight offload + dense decompress |\n| 70B | `all-frozen-split-p4` | `--fused-mm` 사용 시 P4Flat split-storage override |\n\nRaw config에서는 `--weight-comp p4flat`과 `--fused-mm`을 빼고, KV compression을 끄려면\n`--kv-comp p4flat`만 뺀다. KV offload까지 끄려면 두 번째 변경과 함께\n`--no-offload-kv`를 추가한다. `--no-offload-kv --kv-comp ...` 조합은\n허용되지 않는다.\n\nWeight placement는 CLI가 아니라 YAML residency가 결정한다. `--weight-comp`\n또는 `--kv-comp`는 값을 생략하면 `zipserv`, flag 자체를 생략하면 OFF다.\n`--ts-configs`는 필수이고 여러 값을 주면 첫 config가 primary env/log stem이\n된다. `--fused-mm`은 weight-only 요청이며 compression을 켜지 않는다. KV는\nraw 또는 compressed LPDDR에서 dense HBM으로 복원된 뒤 FlashAttention이 읽는다.\n\n## 3. Launcher가 고정하는 값\n\nServing CLI의 일부 vLLM 옵션은 launcher가 engine 생성 직전에 다음처럼\n고정한다.\n\n| Engine 값 | Serving 동작 |\n|---|---|\n| Process topology | API frontend와 EngineCore child 분리; child 안은 `UniProcExecutor` |\n| `block_size` | `16` |\n| `swap_space` | `0` |\n| `enforce_eager` | `False` |\n| `max_model_len` | `--max-context-len` |\n| `max_num_batched_tokens` | chunked prefill이면 `8192`, 아니면 context length |\n| `max_num_seqs` | 요청값, 미지정 시 `512`, 최대 `512` |\n| compile cache | 매 run 비활성화 |\n| request body logging | 비활성화 |\n| KV staging buffers | `2` |\n\n따라서 context는 `--max-context-len`, concurrency는 `--max-num-seqs`,\nprefill 정책은 `--chunked-prefill` 또는 `--no-chunked-prefill`로 설정한다.\n지원 기준은 BF16, TP=1, prefix caching off다.\n\n## 4. API smoke\n\nServer가 model load와 graph capture를 끝낸 뒤 별도 terminal에서 실행한다.\n\n```bash\ncurl -fsS http://127.0.0.1:8000/health\ncurl -fsS http://127.0.0.1:8000/v1/models\n\ncurl -fsS http://127.0.0.1:8000/v1/chat/completions \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"model\": \"meta-llama/Llama-3.1-70B-Instruct\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"What is the capital of France?\"}],\n    \"temperature\": 0,\n    \"max_tokens\": 16\n  }'\n```\n\n8B server에는 request의 `model`도 8B ID로 바꾼다. `--served-model-name`을\n사용했다면 그 alias를 넣는다. `/v1/completions`도 지원한다. `--api-key`를 사용했다면\nOpenAI API 요청에 `Authorization: Bearer <key>` header를 추가한다. 외부\n접속이 필요하지 않으면 `127.0.0.1` bind를 유지한다.\n\n## 5. Server-side logging\n\nLauncher log는 자동으로 다음 위치에 생긴다.\n\n```text\nlogs/serving/<model-id>/<config>/<timestamp>/<max-context-len>.log\n```\n\n요청 구간의 server logging은 다음 endpoint로 제어한다.\n\n```bash\ncurl -fsS -X POST http://127.0.0.1:8000/start_logging\n\n# workload 실행\n\ncurl -fsS -X POST http://127.0.0.1:8000/stop_logging \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"prompt\":\"manual\"}'\n```\n\n`<max-context-len>.log`는 항상 연결된 launcher log다. `/start_logging`은\n응답으로 `engine_id`와 `log_dir`를 반환하고 workload 구간에 같은 directory의\n`server.log` handler를 추가한다. `/stop_logging`의 `prompt` 값은 현재 파일명을\n바꾸지 않는다.\n\n`--collect-time`은 endpoint와 독립적으로 startup부터 CUDA-event timing을 켜고\n`<timestamp>_<engine-id>_collect_time.log`를 쓴다. Normal latency 비교에는\n사용하지 않는다.\n\n## 6. Torch profiler\n\nProfiler endpoint는 `--profiler-config`를 준 server에만 생긴다.\n\n```bash\nmkdir -p /tmp/tiered-serve-profile\ncurl -fsS -X POST http://127.0.0.1:8000/start_profile\n# workload 실행\ncurl -fsS -X POST http://127.0.0.1:8000/stop_profile\n```\n\nServer 명령에는 다음 인자를 추가한다.\n\n```text\n--profiler-config '{\"profiler\":\"torch\",\"torch_profiler_dir\":\"/tmp/tiered-serve-profile\"}'\n```\n\nTrace는 `torch_profiler_dir`에 저장된다. Profiler, `--collect-time`, server\nlogging은 서로 다른 기능이며 profiler와 collect-time에는 계측 overhead가 있다.\n\nAPI key middleware는 `/v1` request만 검사한다. `/health`, `/metrics`, docs,\nlogging/profile endpoint 등 non-`/v1` 경로는 reverse proxy나 firewall에서\n별도로 보호한다. `--host`를 생략하면 외부 interface에 bind될 수 있으므로 local\n실험은 `127.0.0.1`을 명시한다.\n\n## 7. Client 실행\n\n```text\nbash scripts/serving/client/azure_conv.sh <model-id> <config-id> <optinal: request-rate>\n# ex) \nbash scripts/serving/client/azure_conv.sh llama70b cao-p4-kvcomp 1.0\n```\n\n## 8. 종료와 실험 wrapper\n\nForeground server는 `Ctrl-C`로 종료한다. Background 실행은 위 command의\n마지막을 `--port 8000 > /tmp/tiered-serve.out 2>&1 &`로 바꾸고 즉시 PID를\n저장한다.\n\n```bash\nSERVER_PID=$!\n\n# workload가 끝난 뒤\nkill -INT \"$SERVER_PID\"\nwait \"$SERVER_PID\"\n```\n\nLauncher의 `finally`는 CUDA context가 살아 있을 때 C++ KV offload system을\n명시적으로 shutdown한다. `SIGKILL`은 이 경로와 hugetlbfs file cleanup을\n건너뛴다.\n\n`scripts/serving/run_experiment.sh`와\n`scripts/serving/run_experiment_tmux.sh`는 고정된 model/config/client sweep용\nwrapper다. 일반 server 기동에는 위 launcher 명령을 사용한다. 두 wrapper의\n`PORT`는 health check에 쓰이지만 server `--port`로 전달되지 않아 8000 이외의\n값은 직접 수정해야 한다. tmux wrapper는 timeout 뒤 `SIGKILL`, 이어서 container\n안의 모든 Python process cleanup까지 수행하므로 공유 container에서는 실행하지\n않는다.\n\n문제가 생기면 startup log에서 다음 순서로 확인한다.\n\n1. sibling vLLM import와 resolved weight residency\n2. `##### Using Fused MM` 요청과 installed override 또는 explicit fallback 수\n3. KV topology의 dedicated/offloadable/tail block 수\n4. `##### KV full-block-only enabled`와 compressor backend\n5. request 실패 직전 CUDA/engine traceback\n"},"started_at_ms":1788268823960,"completed_at_ms":1788268823961}}
{"timestamp":"2026-09-01T13:20:23.966Z","ordinal":731,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05d20-c59e-7b02-8f16-e8a62a3e2c92","call_id":"call_IQDN0mB8hX9pQWM1rklfL3oj","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env bash\nset -Eeuo pipefail\n\nSCRIPT_DIR=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREPO_ROOT=\"$(cd -- \"${SCRIPT_DIR}/../..\" && pwd)\"\n\nPYTHON_BIN=\"${REPO_ROOT}/.venv/bin/python\"\nSERVER_SCRIPT=\"${REPO_ROOT}/serve_offload_kvweight.py\"\nCLIENT_SCRIPT=\"${REPO_ROOT}/scripts/serving/client/azure_conv.sh\"\nMODEL_CONFIG_DIR=\"${REPO_ROOT}/tiered_serve/model_configs/meta-llama/Llama-3.1-70B-Instruct\"\nP4_RAW_CONFIG=\"${MODEL_CONFIG_DIR}/cao-p4-fused.yaml\"\nP4_KVCOMP_CONFIG=\"${MODEL_CONFIG_DIR}/cao-p4-kvcomp.yaml\"\nCD3_CONFIG=\"${MODEL_CONFIG_DIR}/cao-cd3-fused.yaml\"\nSTACK_POOL_SO=\"${REPO_ROOT}/etc/stack_pool.so\"\n\nMODEL_ALIAS=\"llama70b\"\nMODEL_PATH=\"meta-llama/Llama-3.1-70B-Instruct\"\nPORT=8000\n\nCODECS=(p4flat cd3)\nMODES=(raw kvcomp)\nCHUNKS=(2048 4096 8192)\nREQUEST_RATES=(1.2)\nREPEATS=1\nMAX_NUM_SEQS=128\nMAX_CONTEXT_LEN=8192\nDEDICATED_KV_BLOCKS=2432\nWEIGHT_HUGE_PAGES=14\nWEIGHT_BUFFERS=2\nGPU_RESERVE_GIB=6\nKV_ADDR_ORDER=1\nKV_LOCALITY=0\nKV_RANDOM_ALLOC=0\n\nNUMA_NODE=0\nGPU_INDEX=0\nSTARTUP_TIMEOUT=900\nSHUTDOWN_TIMEOUT=120\nCLEANUP_TIMEOUT=180\nMAX_IDLE_HBM_MIB=1024\nOUTPUT_ROOT=\"${REPO_ROOT}/benchmark_results/serving_suite\"\nDRY_RUN=0\nCHECK_ONLY=0\nBREAKDOWN=0\nSMOKE=0\n\nusage() {\n  cat <<'EOF'\nUsage: scripts/serving/run_performance_suite.sh [options]\n\nRuns isolated llama70b serving experiments. Every combination of KV mode,\nchunk size, request rate, and repeat gets a fresh server process.\n\nOptions:\n  --codecs LIST                 p4flat,cd3 (default: p4flat,cd3)\n  --modes LIST                  raw,kvcomp (default: raw,kvcomp)\n  --chunks LIST                 Comma-separated max_num_batched_tokens\n                                (default: 2048,4096,8192)\n  --request-rates LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 1)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --breakdown                   Record a detailed timing breakdown for every\n                                server forward iteration\n  --smoke                       Run two requests without percentile trimming;\n                                validates startup and request handling only\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --codecs cd3\n  scripts/serving/run_performance_suite.sh --codecs p4flat,cd3 --chunks 8192\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\n  scripts/serving/run_performance_suite.sh --chunks 8192 --breakdown\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --codecs)\n      (($# >= 2)) || die \"--codecs requires a value\"\n      parse_csv \"$2\" CODECS\n      shift 2\n      ;;\n    --modes)\n      (($# >= 2)) || die \"--modes requires a value\"\n      parse_csv \"$2\" MODES\n      shift 2\n      ;;\n    --chunks)\n      (($# >= 2)) || die \"--chunks requires a value\"\n      parse_csv \"$2\" CHUNKS\n      shift 2\n      ;;\n    --request-rates)\n      (($# >= 2)) || die \"--request-rates requires a value\"\n      parse_csv \"$2\" REQUEST_RATES\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --max-num-seqs)\n      (($# >= 2)) || die \"--max-num-seqs requires a value\"\n      MAX_NUM_SEQS=\"$2\"\n      shift 2\n      ;;\n    --dedicated-kv-blocks)\n      (($# >= 2)) || die \"--dedicated-kv-blocks requires a value\"\n      DEDICATED_KV_BLOCKS=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --weight-buffers)\n      (($# >= 2)) || die \"--weight-buffers requires a value\"\n      WEIGHT_BUFFERS=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --breakdown)\n      BREAKDOWN=1\n      shift\n      ;;\n    --smoke)\n      SMOKE=1\n      shift\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor codec in \"${CODECS[@]}\"; do\n  [[ \"$codec\" == p4flat || \"$codec\" == cd3 ]] \\\n    || die \"unsupported codec: ${codec}\"\ndone\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not-executable=${CLIENT_SCRIPT}\")\n\n  for required in nvidia-smi numactl setsid curl findmnt awk sed grep tee; do\n    command -v \"$required\" >/dev/null || problems+=(\"command-missing=${required}\")\n  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  local codec config expected\n  for codec in \"${CODECS[@]}\"; do\n    if [[ \"$codec\" == p4flat ]]; then\n      expected=p4flat\n      for config in \"$P4_RAW_CONFIG\" \"$P4_KVCOMP_CONFIG\"; do\n        [[ -e \"$config\" ]] || problems+=(\"missing=${config}\")\n        grep -Eq \"compressor:[[:space:]]*${expected}\" \"$config\" \\\n# Serving 실행 가이드\n\nOpenAI-compatible server의 기준 진입점은 `serve_offload_kvweight.py`다.\n이 launcher가 tiered 환경을 engine 생성 전에 고정하고 patched vLLM의\n`run_server()`를 시작한다. Startup과 request별 내부 순서는\n[Inference 수행 흐름](INFERENCE_FLOW.md)을 사용한다.\n\n모든 명령은 저장소 루트에서 실행한다.\n\n```bash\ncd /root/projects/tiered-serve\n```\n\n## 0. LD_PRELOAD: CPython frame-stack mmap/munmap 제거\n\nCPython 3.12은 interpreter frame data-stack을 16 KiB 단위로\n`mmap(MAP_ANONYMOUS)`/`munmap`으로 할당·해제한다. vLLM V1의 깊은\nper-piece call chain(~80 layer × 4 projection)이 이 경계를 반복적으로\n넘어 nsys에서 step당 수천 회의 `mmap64`/`munmap`을 발생시킨다.\n\n`etc/stack_pool.so`는 `mmap64`/`munmap`을 가로채서 16 KiB chunk를\nfree-list pool로 재사용한다. 반환 시 `memset`으로 zeroing하여\n`MAP_ANONYMOUS`의 zeroed-page 계약을 보존한다. 이로써 step당\nmmap/munmap을 0으로 만든다.\n\n**모든 실행 명령에 `LD_PRELOAD`를 붙인다.**\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so\n```\n\n`.so` 빌드 방법은 [구조 가이드의 Tips](LANDING_GUIDE.md#6-tips)를\n참고한다.\n\n## 1. 시작 전 확인\n\n```bash\nnvidia-smi\nfindmnt -no TARGET,FSTYPE,OPTIONS /mnt/hugepages\ntest -w /mnt/hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/nr_hugepages\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/free_hugepages\n\n./.venv/bin/python - <<'PY'\nimport torch\nimport vllm\nimport tiered_serve\n\nprint(\"vllm:\", vllm.__file__)\nprint(\"tiered_serve:\", tiered_serve.__file__)\nprint(\"cuda:\", torch.cuda.is_available())\nPY\n```\n\nGH200 CUDA가 보여야 하며 `/mnt/hugepages`는 16 GiB hugetlbfs `rw` mount여야\n하고 현재 사용자에게 쓰기 권한이 있어야 한다. Total/free page는 weight\nreservation(70B 14장, 8B 2장)보다 커야 하며 원하는 KV capacity만큼의 page가\n추가로 남아야 한다. 모델 checkpoint/tokenizer는 local cache에 있거나\nnetwork와 Hugging Face 인증으로 받을 수 있어야 한다. Sibling patch와 native\nABI 확인은 [구조 가이드](LANDING_GUIDE.md)를 따른다.\n\n## 2. Server 시작\n\n### 2.1 70B fused weight + KV compression\n\n`all-frozen-split-p4`와 `--fused-mm`을 함께 쓰면 P4Flat weight override를\n실제로 설치하면서 KV offload/compression도 사용하는 70B profile이 된다.\n\n```bash\nLD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so \\\nnumactl -m 0 ./.venv/bin/python serve_offload_kvweight.py \\\n  --model meta-llama/Llama-3.1-70B-Instruct \\\n  --weight-comp p4flat \\\n  --fused-mm \\\n  --kv-comp p4flat \\\n  --ts-configs cao-p4-fused \\\n```\n\nWeight placement을 바꾸고 싶다면 다음 profile을 사용한다.\n\n| 모델 | Config | Weight 실행 |\n|---|---|---|\n| 70B | `flexgen` | even HBM + odd raw weight offload |\n| 70B | `flexgen-comp-p4` | even HBM + odd P4Flat weight offload + dense decompress |\n| 70B | `all-frozen-split-p4` | `--fused-mm` 사용 시 P4Flat split-storage override |\n\nRaw config에서는 `--weight-comp p4flat`과 `--fused-mm`을 빼고, KV compression을 끄려면\n`--kv-comp p4flat`만 뺀다. KV offload까지 끄려면 두 번째 변경과 함께\n`--no-offload-kv`를 추가한다. `--no-offload-kv --kv-comp ...` 조합은\n허용되지 않는다.\n\nWeight placement는 CLI가 아니라 YAML residency가 결정한다. `--weight-comp`\n또는 `--kv-comp`는 값을 생략하면 `zipserv`, flag 자체를 생략하면 OFF다.\n`--ts-configs`는 필수이고 여러 값을 주면 첫 config가 primary env/log stem이\n된다. `--fused-mm`은 weight-only 요청이며 compression을 켜지 않는다. KV는\nraw 또는 compressed LPDDR에서 dense HBM으로 복원된 뒤 FlashAttention이 읽는다.\n\n## 3. Launcher가 고정하는 값\n\nServing CLI의 일부 vLLM 옵션은 launcher가 engine 생성 직전에 다음처럼\n고정한다.\n\n| Engine 값 | Serving 동작 |\n|---|---|\n| Process topology | API frontend와 EngineCore child 분리; child 안은 `UniProcExecutor` |\n| `block_size` | `16` |\n| `swap_space` | `0` |\n| `enforce_eager` | `False` |\n| `max_model_len` | `--max-context-len` |\n| `max_num_batched_tokens` | chunked prefill이면 `8192`, 아니면 context length |\n| `max_num_seqs` | 요청값, 미지정 시 `512`, 최대 `512` |\n| compile cache | 매 run 비활성화 |\n| request body logging | 비활성화 |\n| KV staging buffers | `2` |\n\n따라서 context는 `--max-context-len`, concurrency는 `--max-num-seqs`,\nprefill 정책은 `--chunked-prefill` 또는 `--no-chunked-prefill`로 설정한다.\n지원 기준은 BF16, TP=1, prefix caching off다.\n\n## 4. API smoke\n\nServer가 model load와 graph capture를 끝낸 뒤 별도 terminal에서 실행한다.\n\n```bash\ncurl -fsS http://127.0.0.1:8000/health\ncurl -fsS http://127.0.0.1:8000/v1/models\n\ncurl -fsS http://127.0.0.1:8000/v1/chat/completions \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"model\": \"meta-llama/Llama-3.1-70B-Instruct\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"What is the capital of France?\"}],\n    \"temperature\": 0,\n    \"max_tokens\": 16\n  }'\n```\n\n8B server에는 request의 `model`도 8B ID로 바꾼다. `--served-model-name`을\n사용했다면 그 alias를 넣는다. `/v1/completions`도 지원한다. `--api-key`를 사용했다면\nOpenAI API 요청에 `Authorization: Bearer <key>` header를 추가한다. 외부\n접속이 필요하지 않으면 `127.0.0.1` bind를 유지한다.\n\n## 5. Server-side logging\n\nLauncher log는 자동으로 다음 위치에 생긴다.\n\n```text\nlogs/serving/<model-id>/<config>/<timestamp>/<max-context-len>.log\n```\n\n요청 구간의 server logging은 다음 endpoint로 제어한다.\n\n```bash\ncurl -fsS -X POST http://127.0.0.1:8000/start_logging\n\n# workload 실행\n\ncurl -fsS -X POST http://127.0.0.1:8000/stop_logging \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"prompt\":\"manual\"}'\n```\n\n`<max-context-len>.log`는 항상 연결된 launcher log다. `/start_logging`은\n응답으로 `engine_id`와 `log_dir`를 반환하고 workload 구간에 같은 directory의\n`server.log` handler를 추가한다. `/stop_logging`의 `prompt` 값은 현재 파일명을\n바꾸지 않는다.\n\n`--collect-time`은 endpoint와 독립적으로 startup부터 CUDA-event timing을 켜고\n`<timestamp>_<engine-id>_collect_time.log`를 쓴다. Normal latency 비교에는\n사용하지 않는다.\n\n## 6. Torch profiler\n\nProfiler endpoint는 `--profiler-config`를 준 server에만 생긴다.\n\n```bash\nmkdir -p /tmp/tiered-serve-profile\ncurl -fsS -X POST http://127.0.0.1:8000/start_profile\n# workload 실행\ncurl -fsS -X POST http://127.0.0.1:8000/stop_profile\n```\n\nServer 명령에는 다음 인자를 추가한다.\n\n```text\n--profiler-config '{\"profiler\":\"torch\",\"torch_profiler_dir\":\"/tmp/tiered-serve-profile\"}'\n```\n\nTrace는 `torch_profiler_dir`에 저장된다. Profiler, `--collect-time`, server\nlogging은 서로 다른 기능이며 profiler와 collect-time에는 계측 overhead가 있다.\n\nAPI key middleware는 `/v1` request만 검사한다. `/health`, `/metrics`, docs,\nlogging/profile endpoint 등 non-`/v1` 경로는 reverse proxy나 firewall에서\n별도로 보호한다. `--host`를 생략하면 외부 interface에 bind될 수 있으므로 local\n실험은 `127.0.0.1`을 명시한다.\n\n## 7. Client 실행\n\n```text\nbash scripts/serving/client/azure_conv.sh <model-id> <config-id> <optinal: request-rate>\n# ex) \nbash scripts/serving/client/azure_conv.sh llama70b cao-p4-kvcomp 1.0\n```\n\n## 8. 종료와 실험 wrapper\n\nForeground server는 `Ctrl-C`로 종료한다. Background 실행은 위 command의\n마지막을 `--port 8000 > /tmp/tiered-serve.out 2>&1 &`로 바꾸고 즉시 PID를\n저장한다.\n\n```bash\nSERVER_PID=$!\n\n# workload가 끝난 뒤\nkill -INT \"$SERVER_PID\"\nwait \"$SERVER_PID\"\n```\n\nLauncher의 `finally`는 CUDA context가 살아 있을 때 C++ KV offload system을\n명시적으로 shutdown한다. `SIGKILL`은 이 경로와 hugetlbfs file cleanup을\n건너뛴다.\n\n`scripts/serving/run_experiment.sh`와\n`scripts/serving/run_experiment_tmux.sh`는 고정된 model/config/client sweep용\nwrapper다. 일반 server 기동에는 위 launcher 명령을 사용한다. 두 wrapper의\n`PORT`는 health check에 쓰이지만 server `--port`로 전달되지 않아 8000 이외의\n값은 직접 수정해야 한다. tmux wrapper는 timeout 뒤 `SIGKILL`, 이어서 container\n안의 모든 Python process cleanup까지 수행하므로 공유 container에서는 실행하지\n않는다.\n\n문제가 생기면 startup log에서 다음 순서로 확인한다.\n\n1. sibling vLLM import와 resolved weight residency\n2. `##### Using Fused MM` 요청과 installed override 또는 explicit fallback 수\n3. KV topology의 dedicated/offloadable/tail block 수\n4. `##### KV full-block-only enabled`와 compressor backend\n5. request 실패 직전 CUDA/engine traceback\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a05d20-abc4-70d3-9de2-f8479db7c6a9","create_time":1788268823.9662635}}}
