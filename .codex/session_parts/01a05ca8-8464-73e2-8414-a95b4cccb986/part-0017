120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --breakdown                   Record a detailed timing breakdown for every\n                                server forward iteration\n  --smoke                       Run two requests without percentile trimming;\n                                validates startup and request handling only\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --codecs cd3\n  scripts/serving/run_performance_suite.sh --codecs p4flat,cd3 --chunks 8192\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\n  scripts/serving/run_performance_suite.sh --chunks 8192 --breakdown\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --codecs)\n      (($# >= 2)) || die \"--codecs requires a value\"\n      parse_csv \"$2\" CODECS\n 