ue\\\"\\n      MAX_IDLE_HBM_MIB=\\\"$2\\\"\\n      shift 2\\n      ;;\\n    --cleanup-timeout)\\n      (($# >= 2)) || die \\\"--cleanup-timeout requires a value\\\"\\n      CLEANUP_TIMEOUT=\\\"$2\\\"\\n      shift 2\\n      ;;\\n    --output-root)\\n      (($# >= 2)) || die \\\"--output-root requires a value\\\"\\n      OUTPUT_ROOT=\\\"$2\\\"\\n      shift 2\\n      ;;\\n    --start-from)\\n      (($# >= 2)) || die \\\"--start-from requires a value\\\"\\n      START_FROM=\\\"$2\\\"\\n      shift 2\\n      ;;\\n    --breakdown)\\n      BREAKDOWN=1\\n      shift\\n      ;;\\n    --dry-run)\\n      DRY_RUN=1\\n      shift\\n      ;;\\n    --check-only)\\n      CHECK_ONLY=1\\n      shift\\n      ;;\\n    -h|--help)\\n      usage\\n      exit 0\\n      ;;\\n    *)\\n      die \\\"unknown option: $1\\\"\\n      ;;\\n  esac\\ndone\\n\\nrequire_uint --repeats \\\"$REPEATS\\\"\\nrequire_uint --input-seq-len \\\"$INPUT_SEQ_LEN\\\"\\nrequire_uint --gen \\\"$GEN_TOKENS\\\"\\nrequire_uint --warmup \\\"$WARMUP\\\"\\nrequire_uint --prefill-chunk \\\"$PREFILL_CHUNK\\\"\\nrequire_uint --gpu-index \\\"$GPU_INDEX\\\"\\nrequire_uint --numa-node \\\"$NUMA_NODE\\\"\\nrequire_uint --weight-huge-pages \\\"$WEIGHT_HUGE_PAGES\\\"\\nrequire_uint --max-idle-hbm-mib \\\"$MAX_IDLE_HBM_MIB\\\"\\nrequire_uint --cleanup-timeout \\\"$CLEANUP_TIMEOUT\\\"\\n((REPEATS > 0)) || die \\\"--repeats must be greater than zero\\\"\\n((INPUT_SEQ_LEN > 0)) || die \\\"--input-seq-len must be greater than zero\\\"\\n((GEN_TOKENS > 0)) || die \\\"--gen must be greater than zero\\\"\\n((PREFILL_CHUNK > 0)) || die \\\"--prefill-chunk must be greater than zero\\\"\\n((CLEANUP_TIMEOUT > 0)) || die \\\"--cleanup-timeout must be greater than zero\\\"\\n((${#BATCHES[@]} > 0)) || die \\\"--batches must not be empty\\\"\\nfor batch in \\\"${BATCHES[@]}\\\"; do\\n  require_uint --batches \\\"$batch\\\"\\n  ((batch > 0)) || die \\\"batch sizes must be greater than zero\\\"\\ndone\\n\\ncase \\\"$KV_BACKEND\\\" in\\n  zipserv|dietgpu|mantexp|p4flat|p4flatcpu|ublb_flat|chunk_delta3) ;;\\n  *) die \\\"unsupported --kv-backend: ${KV_BACKEND}\\\" ;;\\nesac\\n\\nif [[ -n \\\"$START_FROM\\\" ]]; then\\n  selected_methods=()\\n  found_start=0\\n  for method in \\\"${METHODS[@]}\\\"; do\\n    if [[ \\\"$method\\\" == \\\"$START_FROM\\\" ]]; then\\n      found_start=1\\n    fi\\n    if ((found_start)); then\\n      selected_methods+=(\\\"$method\\\")\\n    fi\\n  done\\n  ((found_start)) || die \\\"unknown --start-from method: ${START_FROM}\\\"\\n  METHODS=(\\\"${selected_methods[@]}\\\")\\nfi\\n\\nMODEL_OWNER=\\\"${MODEL%%/*}\\\"\\nMODEL_NAME=\\\"${MODEL##*/}\\\"\\nCONFIG_ROOT=\\\"${REPO_ROOT}/tiered_serve/model_configs/${MODEL_OWNER}/${MODEL_NAME}\\\"\\n\\n# Sets METHOD_LABEL, CONFIG_STEM, EXPECTED_CODEC, METHOD_ENV, and FEATURE_ARGS.\\nbuild_method() {\\n  local method=\\\"$1\\\"\\n  FEATURE_ARGS=()\\n  METHOD_ENV=()\\n  EXPECTED_CODEC=\\\"\\\"\\n  case \\\"$method\\\" in\\n    flexgen)\\n      METHOD_LABEL=\\\"FlexGen\\\"\\n      CONFIG_STEM=\\\"flexgen\\\"\\n      ;;\\n    flexgen-zipserv)\\n      METHOD_LABEL=\\\"FlexGen(w/ zipserv)\\\"\\n      # Fused-MM is a CLI feature. This YAML is the current ZipServ\\n      # offload_compressed placement and is valid with or without the flag.\\n      # flexgen-comp.yaml cannot be used here: it is currently P4Flat.\\n      CONFIG_STEM=\\\"flexgen-comp-fused\\\"\\n      EXPECTED_CODEC=\\\"zipserv\\\"\\n      FEATURE_ARGS=(--weight-comp zipserv)\\n      ;;\\n    flexgen-zipserv-fused)\\n# tiered-serve 구조와 개발 가이드\\n\\n이 문서는 런타임 구조와 변경 시 지켜야 할 불변조건만 설명한다. 기능 조합은\\n[EXPERIMENT_GUIDE.md](EXPERIMENT_GUIDE.md), 단일 실행은\\n[OFFLINE_GUIDE.md](OFFLINE_GUIDE.md), 서버 운영은\\n[SERVING_GUIDE.md](SERVING_GUIDE.md), class별 state owner와 주요 변수는\\n[CORE_CLASSES.md](CORE_CLASSES.md), engine startup과 request별 시간 순서는\\n[INFERENCE_FLOW.md](INFERENCE_FLOW.md)를 사용한다.\\n\\n## 1. 지원 범위와 workspace\\n\\n현재 기준 경로는 다음과 같다.\\n\\n- Grace-Hopper/GH200, BF16\\n- patched vLLM V1, EngineCore와 executor worker가 같은 process\\n- tensor parallel size 1\\n- KV block size 16\\n- full-block KV compression에서 prefix caching과 speculative decoding off\\n\\nServing의 API frontend는 별도 EngineCore child와 통신하지만, 그 child 안의\\nscheduler와 executor worker는 `UniProcExecutor`로 함께 실행된다. EngineCore와\\nworker를 다시 분리하는 일반 V1 worker multiprocessing은 지원하지 않는다.\\nScheduler callback, resident-tail 상태와 `DualMemoryLoader`의 class state가\\n이 경계용 protocol로 직렬화되지 않기 때문이다.\\n\\n```text\\n/root/projects/\\n├── tiered-serve/       # 배치 정책, loader, codec, transfer orchestration\\n├── vllm/               # scheduler/worker/attention 연결 patch\\n├── vllm-flash-attn/    # dedicated/shared dense KV reader\\n└── pytorch/            # GH200 host-allocation 보정\\n```\\n\\nCUTLASS는 optional weight fused-MM을 빌드할 때만 필요하다. 모든 Python\\n명령은 `tiered-serve/.venv/bin/python`을 사용한다.\\n\\n주 진입점은 다음 세 개다.\\n\\n| 파일 | 용도 |\\n|---|---|\\n| `offline_offload_kvweight.py` | correctness, token dump, TTFT/TPOT; [실행법](OFFLINE_GUIDE.md) |\\n| `vllm_offload_kvweight_prefill.py` | mixed-prefill과 active KV 진단 |\\n| `serve_offload_kvweight.py` | OpenAI-compatible server; [실행법](SERVING_GUIDE.md) |\\n\\n실행 전 import와 장치를 확인한다.\\n\\n```bash\\ncd /root/projects/tiered-serve\\n\\n./.venv/bin/python - <<'PY'\\nimport torch\\nimport vllm\\nimport tiered_serve\\n\\nprint(\\\"torch:\\\", torch.__version__, torch.__file__)\\nprint(\\\"vllm:\\\", vllm.__version__, vllm.__file__)\\nprint(\\\"tiered_serve:\\\", tiered_serve.__file__)\\nprint(\\\"cuda:\\\", torch.cuda.is_available())\\nif torch.cuda.is_available():\\n    print(\\\"device:\\\", torch.cuda.get_device_name(0))\\nPY\\n\\nfindmnt -no TARGET,FSTYPE,OPTIONS /mnt/hugepages\\ncat /sys/kernel/mm/hugepages/hugepages-16777216kB/free_hugepages\\n```\\n\\n`vllm.__file__`은 sibling checkout을, `tiered_serve.__file__`은 현재\\n저장소를 가리켜야 한다. `/mnt/hugepages`는 16 GiB hugetlbfs로\\nread-write mount되어 있고 실행에 필요한 free page가 있어야 한다.\\n\\n## 2. vLLM과 tiered-serve의 상호작용\\n\\n이 절은 owner와 patch boundary를 요약한다. Startup부터 한 token step까지의\\n순서는 [Inference 수행 흐름](INFERENCE_FLOW.md)을 따른다.\\n\\n역할 경계는 단순하다.\\n\\n| 소유자 | 책임 |\\n|---|---|\\n| vLLM | API/engine, request scheduling, canonical KV block ID, block table, model execution과 attention 호출 |\\n| tiered-serve | YAML weight 배치, hugepage/codec, HBM·LPDDR buffer, KV tail lifecycle, CUDA stream/event |\\n| vLLM patch | external loader, scheduler callback, physical KV route, graph/attention ABI 연결 |\\n| vLLM-FlashAttention patch | dedicated cache와 shared dense buffer를 읽는 attention reader |\\n\\n전체 흐름은 다음과 같다.\\n\\n```text\\nlauncher\\n  ├─ tiered 환경 고정 + ImmigrantModelLoader 등록\\n  └─ patched vLLM V1\\nNVIDIA GH200 480GB, 5 MiB, 0 %\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a089c1-c3b0-79e1-ab17-202752277aa7","create_time":1789017592.2528057}}}
