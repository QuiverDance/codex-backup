ds_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        required = (\\n            \\\"decompress_chunk_delta3_batched_csr_pair_stream\\\",\\n            \\\"pack_host_chunk_delta3_entries_csr\\\",\\n            \\\"prepare_chunk_delta3_kv_decode\\\",\\n            \\\"KVSlotAllocator\\\",\\n            \\\"retire_kv_csr_slots\\\",\\n            \\\"prepare_host_chunk_delta3_csr_append\\\",\\n            \\\"append_host_chunk_delta3_csr\\\",\\n        )\\n        if (not _HAS_CHUNK_DELTA3\\n                or any(not hasattr(_cd3_ext, name) for name in required)):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the CSR KV decoder and native slot allocator\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n\\\"\\\"\\\"Opt-in CD3 CPU diagnostics for the in-process offline runner.\\n\\nWorker timestamps use the same monotonic CPU clock as consumer timestamps.\\nNo waits, CUDA events, or file I/O are introduced by this module. Records are\\nowned by one queued job; its worker finishes writing before the existing done\\nevent wakes the consumer. Snapshotting never waits for unfinished workers.\\n\\\"\\\"\\\"\\nimport time\\n\\n\\nCOLUMNS = (\\n    \\\"enqueue_batch\\\", \\\"enqueue_step\\\", \\\"consume_batch\\\", \\\"consume_step\\\",\\n    \\\"layer\\\", \\\"blocks\\\", \\\"join_site\\\", \\\"worker_done\\\", \\\"joined\\\",\\n    \\\"enqueue_ns\\\", \\\"worker_start_ns\\\", \\\"worker_done_ns\\\", \\\"join_start_ns\\\",\\n    \\\"join_end_ns\\\", \\\"queue_ms\\\", \\\"raw_d2h_wait_ms\\\", \\\"prior_h2d_wait_ms\\\",\\n    \\\"encode_ms\\\", \\\"csr_ms\\\", \\\"worker_ms\\\", \\\"worker_wait_ms\\\",\\n    \\\"publish_ms\\\", \\\"deferred_free_ms\\\", \\\"join_ms\\\",\\n)\\n_enabled = False\\n_batch = -1\\n_step = -1\\n_records = []\\n\\n\\ndef begin_run(enabled):\\n    global _enabled, _batch, _step\\n    _enabled = enabled\\n    _batch = _step = -1\\n    _records.clear()\\n\\n\\ndef set_step(batch, step):\\n    global _batch, _step\\n    _batch, _step = batch, step\\n\\n\\ndef new_job(layer, blocks):\\n    if not _enabled:\\n        return None\\n    record = dict.fromkeys(COLUMNS)\\n    record.update(\\n        enqueue_batch=_batch, enqueue_step=_step, layer=layer, blocks=blocks,\\n        worker_done=0, joined=0, encode_ms=0.0, csr_ms=0.0,\\n        enqueue_ns=time.perf_counter_ns(),\\n    )\\n    _records.append(record)\\n    return record\\n\\n\\ndef begin_join(record, site):\\n    record.update(consume_batch=_batch, consume_step=_step, join_site=site,\\n                  join_start_ns=time.perf_counter_ns())\\n\\n\\ndef snapshot():\\n    # Copy each record once. Do not force completion of terminal jobs merely\\n    # to populate a diagnostic CSV. Missing measurements remain NA, not zero.\\n    return [record.copy() for record in _records]\\n\\n\\ndef write_csv(file):\\n    file.write(\\\" \\\".join(COLUMNS) + \\\"\\\\n\\\")\\n    for record in snapshot():\\n        file.write(\\\" \\\".join(\\n            \\\"NA\\\" if record[column] is None else str(record[column])\\n            for column in COLUMNS) + \\\"\\\\n\\\")\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a089c4-8931-71f3-8f2c-ed6f7b629326","create_time":1789017762.9423392}}}
