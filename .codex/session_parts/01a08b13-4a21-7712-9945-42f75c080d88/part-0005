ow: dict\\n+    native: object\\n+    events: dict = field(default_factory=dict)\\n+    used_events: set = field(default_factory=set)\\n+    dense_events: tuple | None = None\\n+\\n+    def event_handles(self, name):\\n+        pair = self.events.get(name)\\n+        if pair is None:\\n+            return 0, 0\\n+        self.used_events.add(name)\\n+        return pair[0].cuda_event, pair[1].cuda_event\\n+\\n+    def wait_for_ring(self, stream, dependency):\\n+        pair = self.events.get(\\\"ring_wait_ms\\\")\\n+        if pair is not None:\\n+            pair[0].record(stream)\\n+        stream.wait_event(dependency)\\n+        if pair is not None:\\n+            pair[1].record(stream)\\n+            self.used_events.add(\\\"ring_wait_ms\\\")\\n+\\n+\\n+def _new_event_pair():\\n+    import torch\\n+    pair = (torch.cuda.Event(enable_timing=True),\\n+            torch.cuda.Event(enable_timing=True))\\n+    # Materialize handles before passing them to native code. At begin_run\\n+    # these records are outside measured steps. Pools are reused thereafter.\\n+    for event in pair:\\n+        event.record()\\n+    return pair\\n+\\n+\\n+def _new_event_group():\\n+    return {name: _new_event_pair() for name in (\\n+        \\\"h2d_window_ms\\\", \\\"decode_window_ms\\\", \\\"ring_wait_ms\\\",\\n+        \\\"dense_wait_ms\\\")}\\n+\\n+\\n+def begin_run(active, n_layers=1):\\n+    global enabled, _batch, _step, _sample_layer, _forward_count, _n_layers\\n+    enabled = bool(active)\\n+    _batch = _step = _sample_layer = -1\\n+    _forward_count = 0\\n+    _n_layers = max(1, int(n_layers))\\n+    _records.clear()\\n+    _pending.clear()\\n+    _event_pool.clear()\\n+    _dense_waits.clear()\\n+    _retired_waits.clear()\\n+    _chunks.clear()\\n+    if enabled:\\n+        # One sampled layer normally has one load; reserve a second group\\n+        # for multi-chunk or delayed-completion steps without a hot allocation.\\n+        _event_pool.extend([_new_event_group(), _new_event_group()])\\n+\\n+\\n+def set_step(batch, step):\\n+    global _batch, _step\\n+    _batch, _step = batch, step\\n+\\n+\\n+def set_forward(is_prefill, tokens, active_blocks):\\n+    global _phase, _tokens, _active_blocks, _sample_layer, _forward_count\\n+    _phase = \\\"prefill\\\" if is_prefill else \\\"decode\\\"\\n+    _tokens, _active_blocks = int(tokens), int(active_blocks)\\n+    _sample_layer = _forward_count % _n_layers\\n+    _forward_count += 1\\n+    _chunks.clear()\\n+\\n+\\n+def wait_for_dense(layer, stream, dependency):\\n+    \\\"\\\"\\\"Bracket the existing wait, without adding a new dependency.\\\"\\\"\\\"\\n+    if layer != _sample_layer:\\n+        stream.wait_event(dependency)\\n+        return\\n+    group = _event_pool.pop() if _event_pool else _new_event_group()\\n+    pair = group[\\\"dense_wait_ms\\\"]\\n+    pair[0].record(stream)\\n+    stream.wait_event(dependency)\\n+    pair[1].record(stream)\\n+    previous = _dense_waits.pop(layer, None)\\n+    if previous is not None:\\n+        _retired_waits.append(previous)\\n+    _dense_waits[layer] = group\\n+\\n+\\n+def new_load(layer, backend, requested_blocks):\\n+    if not enabled:\\n+        return None\\n+    import torch\\n+    chunk = _chunks.get(layer, 0)\\n+    _chunks[layer] = chunk + 1\\n+    row = dict.fromkeys(COLUMNS)\\n+    row.update(batch=_batch, step=_step, phase=_phase, tokens=_tokens,\\n+               active_blocks=_active_blocks, layer=layer, chunk=chunk,\\n+               backend=backend, requested_blocks=requested_blocks,\\n+               gpu_sampled=int(layer == _sample_layer), gpu_complete=0)\\n+    record = LoadRecord(row, torch.zeros(6, dtype=torch.int64))\\n+    if layer == _sample_layer:\\n+        group = _dense_waits.pop(layer, None)\\n+        if group is not None:\\n+            record.dense_events = group[\\\"dense_wait_ms\\\"]\\n+        else:\\n+            group = _event_pool.pop() if _event_pool else _new_event_group()\\n+        record.events = group\\n+    _records.append(record)\\n+    _pending.append(record)\\n+    return record\\n+\\n+\\n+def finish_step():\\n+    \\\"\\\"\\\"Read completed samples only, after the existing engine.step timer.\\\"\\\"\\\"\\n+    remaining = []\\n+    for record in _pending:\\n+        row = record.row\\n+        if row[\\\"native_prepare_cpu_ms\\\"] is None:\\n+            prepare, sort, submit, spans, copies, nbytes = record.native.tolist()\\n+            row.update(native_prepare_cpu_ms=prepare / 1e6,\\n+                       native_sort_cpu_ms=sort / 1e6,\\n+                       native_submit_cpu_ms=submit / 1e6)\\n+            # Non-native paths explicitly keep these fields unavailable.\\n+            if copies:\\n+                row.update(copy_spans=spans, copy_descriptors=copies,\\n+                           wire_bytes=nbytes)\\n+            if row[\\\"wire_bytes\\\"]:\\n+                row[\\\"wire_ratio\\\"] = row[\\\"raw_bytes\\\"] / row[\\\"wire_bytes\\\"]\\n+        pairs = {name: record.events[name] for name in record.used_events}\\n+        if record.dense_events is not None:\\n+            pairs[\\\"dense_wait_ms\\\"] = record.dense_events\\n+        if pairs and not all(end.query() for _, end in pairs.values()):\\n+            remaining.append(record)\\n+            continue\\n+        for name, (begin, end) in pairs.items():\\n+            row[name] = begin.elapsed_time(end)\\n+        row[\\\"gpu_complete\\\"] = int(bool(pairs))\\n+        if record.events:\\n+            _event_pool.append(record.events)\\n+            record.events = {}\\n+            record.dense_events = None\\n+            record.used_events.clear()\\n+    _pending[:] = remaining\\n+    _retired_waits.extend(_dense_waits.values())\\n+    _dense_waits.clear()\\n+    waiting = []\\n+    for group in _retired_waits:\\n+        if group[\\\"dense_wait_ms\\\"][1].query():\\n+            _event_pool.append(group)\\n+        else:\\n+            waiting.append(group)\\n+    _r