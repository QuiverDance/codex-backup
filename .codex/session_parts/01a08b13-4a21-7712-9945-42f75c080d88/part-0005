{"timestamp":"2026-09-10T11:28:12.399Z","type":"event_msg","payload":{"type":"patch_apply_end","call_id":"exec-4a1aec96-d502-4538-bb67-c42bd1755353","turn_id":"01a089c4-8931-71f3-8f2c-ed6f7b629326","stdout":"Success. Updated the following files:\nA /home/ubuntu/kvcomp-instrumentation/tiered_serve/kv_load_profile.py\nA /home/ubuntu/kvcomp-instrumentation/tiered_serve/compression/cuda/kv_load_profile.h\n","stderr":"","success":true,"changes":{"/home/ubuntu/kvcomp-instrumentation/tiered_serve/compression/cuda/kv_load_profile.h":{"type":"add","content":"#pragma once\n\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <chrono>\n#include <numeric>\n#include <optional>\n\n// Optional CPU output: preparation ns (includes sort), sort ns, submission ns,\n// source spans, copy descriptors, actual submitted bytes. No device readback.\nclass KVLoadProbe {\n public:\n  explicit KVLoadProbe(const std::optional<torch::Tensor>& output) {\n    if (output.has_value()) {\n      const auto& tensor = *output;\n      TORCH_CHECK(tensor.device().is_cpu() && tensor.is_contiguous()\n                      && tensor.scalar_type() == at::kLong\n                      && tensor.numel() == 6,\n                  \"KV load profile must be contiguous CPU int64[6]\");\n      values_ = tensor.data_ptr<int64_t>();\n      started_ = timestamp();\n    }\n  }\n\n  int64_t timestamp() const {\n    if (values_ == nullptr) return 0;\n    return std::chrono::duration_cast<std::chrono::nanoseconds>(\n        std::chrono::steady_clock::now().time_since_epoch()).count();\n  }\n\n  void prepared(int64_t spans, const std::vector<size_t>& sizes,\n                int64_t sort_ns = 0) {\n    if (values_ == nullptr) return;\n    values_[1] = sort_ns;\n    values_[3] = spans;\n    values_[4] = sizes.size();\n    values_[5] = std::accumulate(sizes.begin(), sizes.end(), int64_t{0});\n    submitted_ = timestamp();\n    values_[0] = submitted_ - started_;\n  }\n\n  void submitted() {\n    if (values_ != nullptr) values_[2] = timestamp() - submitted_;\n  }\n\n private:\n  int64_t* values_ = nullptr;\n  int64_t started_ = 0;\n  int64_t submitted_ = 0;\n};\n\ninline void record_kv_load_event(int64_t handle, cudaStream_t stream) {\n  if (handle == 0) return;\n  auto event = reinterpret_cast<cudaEvent_t>(static_cast<uintptr_t>(handle));\n  auto error = cudaEventRecord(event, stream);\n  TORCH_CHECK(error == cudaSuccess, \"KV load profile event: \",\n              cudaGetErrorString(error));\n}\n"},"/home/ubuntu/kvcomp-instrumentation/tiered_serve/kv_load_profile.py":{"type":"add","content":"\"\"\"Buffered, nonblocking KV-load diagnostics for offline --time-breakdown.\n\nCPU/byte records cover every load. Extra GPU events sample one rotating layer\nper engine step; their windows are not estimates of a full step's GPU time.\nNo device reads, stream waits, synchronization, or hot-path file I/O are added.\n\"\"\"\nfrom dataclasses import dataclass, field\nimport time\n\n\nCOLUMNS = (\n    \"batch\", \"step\", \"phase\", \"tokens\", \"active_blocks\", \"layer\", \"chunk\",\n    \"backend\", \"requested_blocks\", \"loaded_blocks\", \"raw_bytes\",\n    \"body_bytes\", \"metadata_bytes\", \"entry_bytes\", \"active_entry_bytes\",\n    \"extra_entry_bytes\", \"csr_garbage_bytes\", \"wire_bytes\", \"wire_ratio\",\n    \"copy_spans\", \"copy_descriptors\", \"plan_hit\", \"split_h2d\",\n    \"scheduler_cpu_ms\", \"plan_cpu_ms\", \"stage_cpu_ms\",\n    \"native_prepare_cpu_ms\", \"native_sort_cpu_ms\", \"native_submit_cpu_ms\",\n    \"kernel_submit_cpu_ms\", \"gpu_sampled\", \"gpu_complete\",\n    \"h2d_window_ms\", \"decode_window_ms\", \"ring_wait_ms\", \"dense_wait_ms\",\n)\nenabled = False\n_batch = _step = -1\n_phase = \"unknown\"\n_tokens = _active_blocks = 0\n_sample_layer = -1\n_forward_count = 0\n_n_layers = 1\n_records = []\n_pending = []\n_event_pool = []\n_dense_waits = {}\n_retired_waits = []\n_chunks = {}\n\n\n@dataclass\nclass LoadRecord:\n    row: dict\n    native: object\n    events: dict = field(default_factory=dict)\n    used_events: set = field(default_factory=set)\n    dense_events: tuple | None = None\n\n    def event_handles(self, name):\n        pair = self.events.get(name)\n        if pair is None:\n            return 0, 0\n        self.used_events.add(name)\n        return pair[0].cuda_event, pair[1].cuda_event\n\n    def wait_for_ring(self, stream, dependency):\n        pair = self.events.get(\"ring_wait_ms\")\n        if pair is not None:\n            pair[0].record(stream)\n        stream.wait_event(dependency)\n        if pair is not None:\n            pair[1].record(stream)\n            self.used_events.add(\"ring_wait_ms\")\n\n\ndef _new_event_pair():\n    import torch\n    pair = (torch.cuda.Event(enable_timing=True),\n            torch.cuda.Event(enable_timing=True))\n    # Materialize handles before passing them to native code. At begin_run\n    # these records are outside measured steps. Pools are reused thereafter.\n    for event in pair:\n        event.record()\n    return pair\n\n\ndef _new_event_group():\n    return {name: _new_event_pair() for name in (\n        \"h2d_window_ms\", \"decode_window_ms\", \"ring_wait_ms\",\n        \"dense_wait_ms\")}\n\n\ndef begin_run(active, n_layers=1):\n    global enabled, _batch, _step, _sample_layer, _forward_count, _n_layers\n    enabled = bool(active)\n    _batch = _step = _sample_layer = -1\n    _forward_count = 0\n    _n_layers = max(1, int(n_layers))\n    _records.clear()\n    _pending.clear()\n    _event_pool.clear()\n    _dense_waits.clear()\n    _retired_waits.clear()\n    _chunks.clear()\n    if enabled:\n        # One sampled layer normally has one load; reserve a second group\n        # for multi-chunk or delayed-completion steps without a hot allocation.\n        _event_pool.extend([_new_event_group(), _new_event_group()])\n\n\ndef set_step(batch, step):\n    global _batch, _step\n    _batch, _step = batch, step\n\n\ndef set_forward(is_prefill, tokens, active_blocks):\n    global _phase, _tokens, _active_blocks, _sample_layer, _forward_count\n    _phase = \"prefill\" if is_prefill else \"decode\"\n    _tokens, _active_blocks = int(tokens), int(active_blocks)\n    _sample_layer = _forward_count % _n_layers\n    _forward_count += 1\n    _chunks.clear()\n\n\ndef wait_for_dense(layer, stream, dependency):\n    \"\"\"Bracket the existing wait, without adding a new dependency.\"\"\"\n    if layer != _sample_layer:\n        stream.wait_event(dependency)\n        return\n    group = _event_pool.pop() if _event_pool else _new_event_group()\n    pair = group[\"dense_wait_ms\"]\n    pair[0].record(stream)\n    stream.wait_event(dependency)\n    pair[1].record(stream)\n    previous = _dense_waits.pop(layer, None)\n    if previous is not None:\n        _retired_waits.append(previous)\n    _dense_waits[layer] = group\n\n\ndef new_load(layer, backend, requested_blocks):\n    if not enabled:\n        return None\n    import torch\n    chunk = _chunks.get(layer, 0)\n    _chunks[layer] = chunk + 1\n    row = dict.fromkeys(COLUMNS)\n    row.update(batch=_batch, step=_step, phase=_phase, tokens=_tokens,\n               active_blocks=_active_blocks, layer=layer, chunk=chunk,\n               backend=backend, requested_blocks=requested_blocks,\n               gpu_sampled=int(layer == _sample_layer), gpu_complete=0)\n    record = LoadRecord(row, torch.zeros(6, dtype=torch.int64))\n    if layer == _sample_layer:\n        group = _dense_waits.pop(layer, None)\n        if group is not None:\n            record.dense_events = group[\"dense_wait_ms\"]\n        else:\n            group = _event_pool.pop() if _event_pool else _new_event_group()\n        record.events = group\n    _records.append(record)\n    _pending.append(record)\n    return record\n\n\ndef finish_step():\n    \"\"\"Read completed samples only, after the existing engine.step timer.\"\"\"\n    remaining = []\n    for record in _pending:\n        row = record.row\n        if row[\"native_prepare_cpu_ms\"] is None:\n            prepare, sort, submit, spans, copies, nbytes = record.native.tolist()\n            row.update(native_prepare_cpu_ms=prepare / 1e6,\n                       native_sort_cpu_ms=sort / 1e6,\n                       native_submit_cpu_ms=submit / 1e6)\n            # Non-native paths explicitly keep these fields unavailable.\n            if copies:\n                row.update(copy_spans=spans, copy_descriptors=copies,\n                           wire_bytes=nbytes)\n            if row[\"wire_bytes\"]:\n                row[\"wire_ratio\"] = row[\"raw_bytes\"] / row[\"wire_bytes\"]\n        pairs = {name: record.events[name] for name in record.used_events}\n        if record.dense_events is not None:\n            pairs[\"dense_wait_ms\"] = record.dense_events\n        if pairs and not all(end.query() for _, end in pairs.values()):\n            remaining.append(record)\n            continue\n        for name, (begin, end) in pairs.items():\n            row[name] = begin.elapsed_time(end)\n        row[\"gpu_complete\"] = int(bool(pairs))\n        if record.events:\n            _event_pool.append(record.events)\n            record.events = {}\n            record.dense_events = None\n            record.used_events.clear()\n    _pending[:] = remaining\n    _retired_waits.extend(_dense_waits.values())\n    _dense_waits.clear()\n    waiting = []\n    for group in _retired_waits:\n        if group[\"dense_wait_ms\"][1].query():\n            _event_pool.append(group)\n        else:\n            waiting.append(group)\n    _retired_waits[:] = waiting\n\n\ndef write_csv(file):\n    # Do not force completion of terminal GPU work to fill missing values.\n    finish_step()\n    file.write(\" \".join(COLUMNS) + \"\\n\")\n    for record in _records:\n        file.write(\" \".join(\n            \"NA\" if record.row[column] is None else str(record.row[column])\n            for column in COLUMNS) + \"\\n\")\n"}},"status":"completed"}}
