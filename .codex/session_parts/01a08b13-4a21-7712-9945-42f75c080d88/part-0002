egister BlockPool callbacks so that vLLMKVCache.free_block_ids\\n        and used_block_ids stay in sync with the V1 scheduler's block\\n        allocator.  Also wires in the unload_targets / free_slot helpers\\n        from tiered_serve.vllm_block_decorator.\\\"\\\"\\\"\\n        block_pool = getattr(\\n            getattr(\\n                getattr(self.scheduler, \\\"kv_cache_manager\\\", None),\\n                \\\"coordinator\\\", None),\\n            \\\"block_pool\\\", None)\\n        if block_pool is None:\\n            logger.warning(\\n                \\\"tiered-serve: could not find BlockPool on scheduler; \\\"\\n                \\\"free_block_ids will not be updated.\\\")\\n            return\\n\\n        from tiered_serve.vllm_block_decorator import (\\n            final_reference_blocks,\\n            on_blocks_allocated_v1,\\n            on_blocks_freed_v1,\\n        )\\n        from tiered_serve.kv_cache import vLLMKVCache\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n        if (\\n            DualMemoryLoader.kv_full_block_only\\n            and self.scheduler.kv_cache_manager.enable_caching\\n        ):\\n            raise RuntimeError(\\n                \\\"Tiered-serve full-block KV compression requires prefix \\\"\\n                \\\"caching to be disabled (--no-enable-prefix-caching)\\\")\\n\\n        num_ded = DualMemoryLoader.num_dedicated_blocks\\n        if num_ded is None:\\n            raise RuntimeError(\\n                \\\"tiered-serve dedicated/offloadable KV boundary was not \\\"\\n                \\\"published by the worker before scheduler initialization\\\")\\n        if (DualMemoryLoader.kv_full_block_only\\n                and DualMemoryLoader.tail_manager is None):\\n            raise RuntimeError(\\n                \\\"tiered-serve full-block KV mode was enabled but the fixed \\\"\\n                \\\"resident-tail pool was not initialized\\\")\\n\\n        def _on_allocated(blocks):\\n            on_blocks_allocated_v1(blocks)\\n            for blk in blocks:\\n                bid = blk.block_id\\n                if bid < len(vLLMKVCache.free_block_ids):\\n                    vLLMKVCache.free_block_ids[bid] = False\\n                    vLLMKVCache.used_block_ids[bid] = True\\n\\n        def _on_freed(blocks):\\n            final_blocks = final_reference_blocks(blocks)\\n            for blk in final_blocks:\\n                bid = blk.block_id\\n                # The callback fires before ref_cnt is decremented. Cancel any\\n                # tail state only when this is the final reference.\\n                if bid >= num_ded:\\n                    DualMemoryLoader.free_tail_block(bid)\\n            on_blocks_freed_v1(blocks, final_blocks=final_blocks)\\n            for blk in final_blocks:\\n                bid = blk.block_id\\n                # The callback fires before ref_cnt is decremented.\\n                # Only mark free when ref_cnt will drop to 0.\\n                if bid < len(vLLMKVCache.free_block_ids):\\n                    vLLMKVCache.free_block_ids[bid] = True\\n                    vLLMKVCache.used_block_ids[bid] = False\\n\\n        block_pool.on_blocks_allocated = _on_allocated\\n        block_pool.on_blocks_freed = _on_freed\\n\\n        # tiered-serve: track tail blocks (dirty) for unload\\n        kv_cache_manager = self.scheduler.kv_cache_manager\\n\\n        def _on_blocks_written(writes: list[KVBlockWrite]) -> None:\\n            for write in writes:\\n                bid = write.block_id\\n                if bid >= num_ded:\\n                    DualMemoryLoader.record_tail_write(write)\\n                    if (\\n                        not DualMemoryLoader.kv_full_block_only\\n                        or write.post_valid == write.block_size\\n                    ):\\n                        DualMemoryLoader.append_unload_target(bid)\\n\\n        kv_cache_manager.on_blocks_written = _on_blocks_written\\n\\n        # Tell the free-block queue about the dedicated/offloadable boundary\\n        # so that freed dedicated blocks are re-inserted at the front.\\n        if vLLMKVCache.num_dedicated_blocks is not None:\\n            block_pool.free_block_queue.num_dedicated_blocks = (\\n                vLLMKVCache.num_dedicated_blocks)\\n            logger.info(\\n                \\\"tiered-serve: dedicated-first block allocation enabled \\\"\\n                \\\"(D=%d)\\\", vLLMKVCache.num_dedicated_blocks)\\n            # Build the offline random-allocation permutation now, outside the\\n            # first request/TTFT path. This is a no-op unless explicitly\\n            # enabled by vllm_offload_kvweight.py.\\n            block_pool.initialize_random_alloc_order()\\n\\n        logger.info(\\\"tiered-serve: registered BlockPool callbacks \\\"\\n                     \\\"for free_block_ids / used_block_ids tracking\\\")\\n\\n    def get_supported_tasks(self) -> tuple[SupportedTask, ...]:\\n        return self.model_executor.supported_tasks\\n        if (raw_load_kv_stream is not dm.load_kv_stream\\n                and dm._prefill_uses_dedicated_raw_kv_stream()):\\n            # Prefill pipelines L+1 and can leave the wraparound KV0 H2D after\\n            # the last attention piece. Make later block free/reuse and the\\n            # next forward depend on that read without a CPU synchronize.\\n            cur = torch.cuda.current_stream(_cuda_device())\\n            TieredServeCUDAGraphWrapper._cached_stream_wait(\\n                dm, cur, raw_load_kv_stream, \\\"afm_raw_load_kv\\\")\\n            dm._raw_prefill_end_joined = True\\n        dm.end_forward_event.record()\\n\\n        if getattr(dm, \\\"collect_times\\\", False):\\n            # Synchronize to ensure all events across all streams are\\n            # recorded before reading elapsed_time.  Prefill-alt and decode\\n            # record reconstruct events on decomp_weight_stream, while raw\\n            # prefill and compressed staging record readiness on load streams.\\n            # Missing any participating stream makes the first timed step race\\n            # CPU vs GPU and raises\\n            # \\\"Both events must be completed before calculating elapsed\\n            # time.\\\"  unload_kv_stream sits in the same boat.\\n            torch.cuda.current_stream(_cuda_device()).synchronize()\\n            dm.load_weight_stream.synchronize()\\n            dm.decomp_weight_stream.synchronize()\\n            dm.load_kv_stream.synchronize()\\n            if dm.raw_load_kv_stream is not dm.load_kv_stream:\\n                dm.raw_load_kv_stream.synchronize()\\n            dm.unload_kv_stream.synchronize()\\n            dm.calc_times(0)\\n\\n        # Close the per-step NVTX range opened in _do_before_model_forward.\\n        if _ENV_FORWARD_NVTX:\\n            torch.cuda.nvtx.range_pop()  # forward_step\\n\\n    @staticmethod\\n    def _wload_graph_on(dm):\\n        \\\"\\\"\\\"TIERED_SERVE_WLOAD_GRAPH=1: capture the per-piece weight H2D inside\\n        the piece's cudagraph (read once).\\\"\\\"\\\"\\n        return _ENV_WLOAD_GRAPH\\n\\n    @staticmethod\\n    def _frozen_idx_map(dm):\\n        \\\"\\\"\\\"(frozen_idx_map, n_not_frozen) cached on ``dm``.  ``not_frozen_layers``\\n        is run-invariant, so this dict was needlessly rebuilt as a comprehension\\n        2x per graph (before + after replay) = ~160 dict builds/step.  Keyed on\\n        the list identity so a (hypothetical) change is a clean miss.\\\"\\\"\\\"\\n        nfl = dm.not_frozen_layers\\n        # needs it.\\n        if hasattr(dm, 'frozen_decomp_event'):\\n            if ((graph_idx == 0 or not self._can_lookahead_frozen_decomp(dm))\\n                    and not self._wload_graph_on(dm)):\\n                # WLOAD_GRAPH: the per-piece capture prehook issues this instead.\\n                self._cached_stream_wait(\\n                    dm, dm.decomp_weight_stream, cur_stream,\\n                    (\\\"before_replay_frozen\\\", graph_idx))\\n                self._schedule_frozen_decomp_for_graph(\\n                    dm, graph_idx, n_graphs)\\n            if not uses_component_weight_waits:\\n                if _ENV_V1_DETAILED_NVTX:\\n                    torch.cuda.nvtx.range_push(\\n                        f\\\"wait_frozen_decomp G{graph_idx}\\\")\\n                cur_stream.wait_event(\\n                    self._ensure_v1_frozen_events(dm, n_graphs)[graph_idx])\\n                if _ENV_V1_DETAILED_NVTX:\\n                    torch.cuda.nvtx.range_pop()\\n\\n        # ── Wait for C++ KV compress pipeline ──\\n        # Per-layer KV slots are independent, so layer G's compress completion\\n        # gates nothing in layers >G.  Default is a lazy per-layer join: only\\n        # publish layer G's worker result here when it is actually pending.\\n        # TIERED_SERVE_KV_COMPRESS_WAIT_AT_END=1 restores the older end-batch\\n        # join of all layers at the final graph, which is useful for debugging\\n        # but can delay the next step's CUDA graph launch on the CPU.\\n        if dm.use_kv_comp and hasattr(dm_cls, \\\"kv_offload_system\\\"):\\n            kvsys = dm_cls.kv_offload_system\\n            if _ENV_KV_COMPRESS_WAIT_AT_END:\\n                if idx == n_graphs - 1:\\n                    if _ENV_KV_CPU_PROFILE:\\n                        _t0 = time.perf_counter()\\n                    for _L in range(n_layers):\\n                        kvsys.wait_for_layer_pipeline_cpp(\\n                            _L, kv_compressor=dm.kv_compressor,\\n                            block_shape=tuple(\\n                                dm_cls.primary_k_caches[_L].shape[1:]))\\n                    if _ENV_KV_CPU_PROFILE:\\n                        self._cw_acc = getattr(self, \\\"_cw_acc\\\", 0.0) \\\\\\n                            + (time.perf_counter() - _t0)\\n                        self._cw_n = getattr(self, \\\"_cw_n\\\", 0) + 1\\n\"}"}],"internal_chat_message_metadata_pas