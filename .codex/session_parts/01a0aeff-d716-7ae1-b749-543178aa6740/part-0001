{"timestamp":"2026-09-17T10:57:10.221Z","ordinal":78,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0af03-644c-7dd1-bfcf-fa6e7798e622","call_id":"call_EmyIKJCyeymQ36zdEh4yyvCc","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"[{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"a749ba\",\"wall_time_seconds\":0.000001888,\"exit_code\":0,\"original_token_count\":3810,\"output\":\"\\\"\\\"\\\"ChunkDelta3 backend for persistent offloaded KV blocks.\\n\\nKV exponent deltas use three bits by default, or four with\\nTIERED_SERVE_KV_CD3_DELTA_BITS=4. Weight CD3 remains three-bit.\\nEach host slot keeps a fixed CD3 body and bounded CPU-encode scratch.  CPU\\nencode workers append the exact Packed20 words to persistent CSR storage, so\\nthe per-forward decode plan only references already-packed pinned memory.\\nRecords whose exact compressed representation is not smaller than raw BF16\\nare restored from authoritative secondary KV.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport ctypes\\nimport glob\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time as _time\\nfrom dataclasses import dataclass, field\\nfrom typing import Any, Dict, Tuple\\n\\nimport numpy as np\\nimport torch\\n\\nfrom tiered_serve import kv_cpu_profile, kv_load_metrics\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\\nfrom tiered_serve.compression.core.chunk_delta3 import (\\n    _HAS_CHUNK_DELTA3,\\n    _cd3_ext,\\n)\\n\\n\\nlogger = logging.getLogger(__name__)\\n\\n\\n@dataclass\\nclass _PersistentCSRState:\\n    entries: torch.Tensor\\n    offsets: torch.Tensor\\n    word_counts: np.ndarray\\n    used_words: int\\n    garbage_words: int\\n    max_words: int\\n    gpu_words: int\\n\\n\\n@dataclass\\nclass _DecodePlan:\\n    layer_id: int\\n    block_ids: np.ndarray\\n    block_ids_tensor: torch.Tensor | None\\n    block_ids_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event | None\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n    profile_active_entry_bytes: int | None = None\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\n        # Give CPU workers a completed initial event for layers that have not\\n        # loaded persistent compressed data yet.\\n        with torch.cuda.stream(self.batch_decomp_stream):\\n            for event in self._kv_dec_h2d:\\n                event.record(self.batch_decomp_stream)\\n            for event in self._kv_h2d_begin:\\n                event.record(self.batch_decomp_stream)\\n            for event in self._kv_decode_begin:\\n                event.record(self.batch_decomp_stream)\\n            for events in self._kv_load_probe_events:\\n                for event in events:\\n                    event.record(self.batch_decomp_stream)\\n        self._kv_pools_ready = True\\n\\n        slot_bytes = self.compute_per_block_compressed_bytes(block_numel)\\n        logger.info(\\n            \\\"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \\\"\\n            \\\"delta_bits=%d decode_threads=%d \\\"\\n            \\\"entry_capacity=%d body=%d host_slot=%d bytes \\\"\\n            \\\"(%.3fx raw worst-case allocation) \\\"\\n            \\\"max_blocks=%d layers=%d\\\",\\n            block_shape, M_b, K_b, delta_bits,\\n            _cd3_ext.compiled_kv_decode_threads(), entry_capacity, self._body_stride,\\n            slot_bytes,\\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\\n\\n    def _new_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Lazily allocate stable pinned CSR storage for one layer/side.\\\"\\\"\\\"\\n        host_rows = self._max_n_blocks + 1\\n        max_words = host_rows * self._packed_capacity\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        initial_words = min(\\n            max_words,\\n            max(1024, host_rows * self._csr_initial_words_per_slot),\\n        )\\n        state = _PersistentCSRState(\\n            entries=torch.empty(\\n                initial_words, dtype=torch.int64).pin_memory(),\\n            offsets=torch.zeros(\\n                host_rows, dtype=torch.int64).pin_memory(),\\n            word_counts=np.zeros(host_rows, dtype=np.int64),\\n            used_words=0,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Compact append garbage off the request path in the CPU worker.\\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n        rows = self._kv_slot_allocator[layer_id].high_water\\n        slots = np.arange(rows, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[:rows]\\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        if total_words > max_words:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 persistent CSR exceeds host slot capacity: \\\"\\n                f\\\"layer={layer_id} side={kv} words={total_words} \\\"\\n                f\\\"capacity={max_words}\\\")\\n        previous = self._persistent_csr[layer_id][kv]\\n        previous_capacity = (\\n            previous.entries.numel() if previous is not None else 0)\\n        capacity = max(\\n            1024, total_words,\\n            min(max_words, previous_capacity),\\n        )\\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\\n        offsets = torch.zeros(\\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\\n        if rows:\\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n                pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n                torch.from_numpy(slots), entries[:total_words],\\n                offsets[:rows])\\n        state = _PersistentCSRState(\\n            entries=entries,\\n            offsets=offsets,\\n            word_counts=np.zeros(\\n                self._max_n_blocks + 1, dtype=np.int64),\\n            used_words=total_words,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        state.word_counts[:rows] = word_counts\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _append_persistent_csr(\\n            self, layer_id: int, kv: str, slots: torch.Tensor) -> None:\\n        \\\"\\\"\\\"Append encoded slots using one native count/prefix calculation.\\\"\\\"\\\"\\n        count = slots.numel()\\n        if count == 0:\\n            return\\n        scratch = self._csr_append_scratch.get(layer_id)\\n        if scratch is None or scratch.shape[1] < count:\\n            capacity = max(count, 2 * scratch.shape[1] if scratch is not None else 0)\\n            scratch = torch.empty((2, capacity), dtype=torch.int64)\\n            self._csr_append_scratch[layer_id] = scratch\\n        new_word_counts = scratch[0, :count]\\n        relative_offsets = scratch[1, :count]\\n        pool = self._host_pools[layer_id][kv]\\n        state = self._persistent_csr[layer_id][kv]\\n        if state is None:\\n            state = self._new_persistent_csr(layer_id, kv)\\n        append_words, old_words = _cd3_ext.prepare_host_chunk_delta3_csr_append(\\n            pool[\\\"num_exceptions\\\"], slots, state.word_counts,\\n            new_word_counts, relative_offsets, self._packed_capacity)\\n\\n        required = int(state.used_words) + append_words\\n        # Reuse/re-encode churn can leave unreachable append records.  Only\\n        # compact in the worker when it avoids growth or is required to stay\\n        # within the fixed GPU CSR staging capacity.\\n        should_compact = required > state.max_words\\n        should_compact |= (\\n            required > state.gpu_words\\n            and self._kv_slot_allocator[layer_id].high_water\\n            <= self._max_gpu_decomp_blocks + 1)\\n        should_compact |= (\\n            required > state.entries.numel()\\n            and state.garbage_words + old_words >= append_words)\\n        if should_compact:\\n            # Scratch rows already contain the just-encoded values, so one\\n            # rebuild publishes both the old live set and this update.\\n            self._rebuild_persistent_csr(layer_id, kv)\\n            return\\n\\n        if required > state.entries.numel():\\n            capacity = min(\\n                state.max_words,\\n                max(required, state.entries.numel() * 2),\\n            )\\n      