ts\\n            assert plan.native.segment_cache_misses == segment_misses\\n            assert plan.native.bundle_cache_hits == bundle_hits\\n            assert plan.native.bundle_cache_misses == bundle_misses\\n            assert plan.staged_bytes <= plan.payload_bytes * 1.05\\n            assert plan.storage_rows == len(ids)\\n            for cache, source in zip(caches, sources):\\n                _assert_bit_exact(cache[ids].cpu(), source[ids])\\n                omitted = sorted(set(range(72)) - set(ids))\\n                assert torch.count_nonzero(cache[omitted]).item() == 0\\n            return plan\\n\\n        active = list(range(68))\\n        encode(active)\\n        for pool in pools.values():\\n            sizes = pool[\\\"total_size\\\"].to(torch.int64)\\n            # Segment 1 starts immediately after segment 0's payload, not at\\n            # its old worst-case reservation. Only the bundle has tail slack.\\n            assert int(pool[\\\"record_offsets\\\"][4]) == int(((sizes[:4] + 127) // 128 * 128).sum())\\n            assert int(pool[\\\"record_offsets\\\"][32]) == 32 * compressor._record_stride\\n            assert int(pool[\\\"record_offsets\\\"][64]) == 64 * compressor._record_stride\\n        plan = decode(active, 0, 17, 0, 3, 17)\\n        assert plan.native.bundle_count == 3\\n        assert plan.native.copy_count == 7  # Three K/V spans plus one route table.\\n        assert plan.staged_bytes == plan.payload_bytes + len(active) * 24\\n\\n        # Appending a new version preserves every published source byte, even\\n        # if a preceding H2D on the other ring is still reading that bundle.\\n        old_prefixes = {}\\n        for side, pool in pools.items():\\n            end = int(pool[\\\"record_offsets\\\"][31] + pool[\\\"total_size\\\"][31])\\n            old_prefixes[side] = pool[\\\"blob\\\"].flatten()[:end].clone()\\n        compressor.decompress_batch(0, active, caches)\\n        for source in sources:\\n            source[0]