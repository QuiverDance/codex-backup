rom tiered_serve.compression.core.chunk_delta3 import _cd3_ext\\n\\n    rows, capacity = 32, 32768\\n    host = _cd3_ext.allocate_chunk_delta3_host_bytes(rows * capacity).view(rows, capacity)\\n    host.zero_()\\n    offsets = torch.arange(rows, dtype=torch.int64) * record_size\\n    host.flatten()[offsets] = torch.arange(rows, dtype=torch.uint8)\\n    sizes = torch.full((rows,), record_size, dtype=torch.int32)\\n    selected = list(range(0, rows, 2)) if fragmented else [i for i in range(rows) if i != 15]\\n    n = len(selected)\\n    metadata = _cd3_ext.allocate_chunk_delta3_host_bytes(3 * n * 8).view(torch.int64)\\n    k_ring = [torch.empty((n, capacity), dtype=torch.uint8, device=\\\"cuda\\\") for _ in range(2)]\\n    v_ring = [torch.empty_like(t) for t in k_ring]\\n    ids_ring = [torch.empty(3 * n, dtype=torch.int64, device=\\\"cuda\\\") for _ in range(2)]\\n    plan = _cd3_ext.ChunkDelta3KVDecodePlan(\\n        torch.tensor(selected), torch.arange(rows, dtype=torch.int32), metadata,\\n        host, host, sizes, sizes, offsets, offsets, k_ring, v_ring, ids_ring,\\n        22656, rows, rows)\\n    stream = torch.cuda.Stream()\\n    stream.wait_stream(torch.cuda.current_stream())\\n    plan.submit(0, stream.cuda_stream)\\n    stream.synchronize()\\n    assert plan.payload_bytes == n * record_size * 2\\n    assert plan.wire_bytes <= plan.payload_bytes * 1.05\\n    # One missing small record fits the wire and GPU budgets. Near-raw records\\n    # cannot include that hole without growing GPU staging, so keep two spans.\\n    expected_copies = 2 * n + 1 if fragmented else (3 if record_size == 22656 else 5)\\n    assert plan.copy_count == expected_copies\\n    for side, gpu in enumerate((k_ring[0], v_ring[0])):\\n        for i, block in enumerate(selected):\\n            assert int(gpu.flatten()[int(metadata[(side + 1) * n + i])]) == block\\n\\n\\ndef test_cpu_kv_append_preserves_records_and_collects_only_on_pressure(monkeypatch):\\ndef test_cpu_kv_transfer_bundles_pr