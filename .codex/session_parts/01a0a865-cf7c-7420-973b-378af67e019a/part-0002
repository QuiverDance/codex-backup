 mapped_ids, mapped_slots\\n\\n    def _apply_layer_retirement(\\n            self, layer_id: int, block_ids: np.ndarray,\\n            retirement, *, _profile=None) -> None:\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        valid, slot_table, mapped_ids, mapped_slots = retirement\\n        valid[block_ids] = 0\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_mapping_ns\\\"] += now_ns - started_ns\\n            _profile[\\\"cd3_layers\\\"] += 1\\n            _profile[\\\"cd3_mapped_slots\\\"] += int(mapped_slots.size)\\n        if mapped_slots.size == 0:\\n            return\\n\\n        # Invalidate once before detaching every route represented by this\\n        # callback. Retired plans retain their pinned aliases until H2D ends.\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        self._invalidate_decode_plan(layer_id)\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_plan_ns\\\"] += now_ns - started_ns\\n            started_ns = now_ns\\n        slot_table[mapped_ids] = -1\\n        reverse = self._kv_slot_block[layer_id]\\n        reverse[mapped_slots] = -1\\n        if _profile is not None:\\n            _profile[\\\"cd3_mapping_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n\\n        # Keep physical slots quarantined until the pending writer retires,\\n        # so its captured destinations cannot be assigned to another owner.\\n        if layer_id in self._pending_compress:\\n            if _profile is not None:\\n                started_ns = _time.perf_counter_ns()\\n            self._deferred_slot_frees.setdefault(\\n                layer_id, set()).update(mapped_slots.tolist())\\n            if _profile is not None:\\n                _profile[\\\"cd3_quarantine_ns\\\"] += (\\n                    _time.perf_counter_ns()