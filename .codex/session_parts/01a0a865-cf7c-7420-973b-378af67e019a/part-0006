                 ignore_eos=True,\\n                    ),\\n                )\\n                req_id += 1\\n\\n            active_request_ids = set(submit_times)\\n            phase = 0\\n            gen_tokens = {}   # req_id -> generated token_ids (correctness dump)\\n            while engine.has_unfinished_requests():\\n                engine.collective_rpc(\\\"ts_set_phase\\\", args=(phase,))\\n\\n                if nsys_cap is not None:\\n                    _cb, _cs, _cn = nsys_cap\\n                    if batch == _cb and phase == _cs:\\n                        torch.cuda.synchronize()\\n                        cuda_profiler.start()\\n                    elif batch == _cb and phase == _cs + _cn:\\n                        torch.cuda.synchronize()\\n                        cuda_profiler.stop()\\n\\n                active_before = len(active_request_ids)\\n                free_record_start = (\\n                    kv_free_profile_checkpoint()\\n                    if args.time_breakdown else 0\\n                )\\n                if args.time_breakdown:\\n                    kv_cpu_profile.set_step(batch, phase)\\n                kv_load_metrics.set_context(batch, phase, cfg_stem)\\n                t0 = time.perf_counter()\\n                request_outputs = engine.step()\\n                step_done = time.perf_counter()\\n                latency = (step_done - t0) * 1000  # ms\\n                if args.time_breakdown:\\n                    kv_cpu_profile.collect_loads()\\n                free_record_end = (\\n  command -v findmnt >/dev/null || die \\\"findmnt is required\\\"\\n\\n  local method\\n  for method in \\\"${METHODS[@]}\\\"; do\\n    build_method \\\"$method\\\"\\n    [[ -f \\\"$CONFIG_PATH\\\" ]] || die \\\"config not found: ${CONFIG_PATH}\\\"\\n    if [[ -n \\\"$EXPECTED_CODEC\\\" ]] &&\\n       ! grep -q \\\"compressor: ${EXPECTED_CODEC}\\\" \\\"$CONFIG_PATH\\\"; then\\n      die \\\"${method}: ${CONFIG_PATH} does not declare ${EXPECTED_CODEC}\\\"\\n    fi\\n  done\\n}\\n\\n# Clear every inherited tiered-serve knob. Each child receives only the common\\n# values below and the flags selected by build_method().\\nENV_PREFIX=(env)\\nwhile IFS='=' read -r env_name _; do\\n  if [[ \\\"$env_name\\\" == TIERED_SERVE_* ]]; then\\n    ENV_PREFIX+=(-u \\\"$env_name\\\")\\n  fi\\ndone < <(env)\\nENV_PREFIX+=(\\n  \\\"PYTHONHASHSEED=0\\\"\\n  \\\"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\\\"\\n  \\\"LD_PRELOAD=${STACK_POOL}\\\"\\n  \\\"VLLM_DISABLE_COMPILE_CACHE=1\\\"\\n  \\\"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\\\"\\n  \\\"TIERED_SERVE_N_WEIGHT_BUFFERS=2\\\"\\n  \\\"TIERED_SERVE_KV_METRICS=1\\\"\\n)\\n\\nbuild_command() {\\n  local method=\\\"$1\\\"\\n  local -a timing_args=()\\n  build_method \\\"$method\\\"\\n  if ((BREAKDOWN)); then\\n    timing_args=(--time-breakdown)\\n  fi\\n  CMD=(\\n    \\\"${ENV_PREFIX[@]}\\\"\\n    \\\"${METHOD_ENV[@]}\\\"\\n    \\\"TIERED_SERVE_KV_METRICS_DIR=${KV_METRICS_DIR:-/tmp/offline-suite-kv-metrics}\\\"\\n    numactl -m \\\"$NUMA_NODE\\\"\\n    \\\"$PYTHON\\\" \\\"$DRIVER\\\"\\n    --model \\\"$MODEL\\\"\\n    --dtype bfloat16\\n    --tensor-parallel-size 1\\n    --block-size 16\\n    --no-enable-prefix-caching\\n    --batch \\\"${BATCHES[@]}\\\"\\n    --inputseqlen \\\"$INPUT_SEQ_LEN\\\"\\n    --gen \\\"$GEN_TOKENS\\\"\\n    --fixed-generation-length\\n    --prefill-chunk \\\"$PREFILL_CHUNK\\\"\\n    --warmup \\\"$WARMUP\\\"\\n    --ts-configs \\\"$CONFIG_PATH\\\"\\n    \\\"${FEATURE_ARGS[@]}\\\"\\n    \\\"${timing_args[@]}\\\"\\n  )\\n}\\n\\nactive_tiered_processes() {\\n  local pid stat args\\n  while read -r pid stat args; do\\n    [[ \\\"$stat\\\" == Z* ]] && continue\\n    case \\\"$args\\\" in\\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\\n        printf '%s %s %s\\\\n' \\\"$pid\\\" \\\"$stat\\\" \\\"$args\\\"\\n        ;;\\n    esac\\n  done < <(ps -eo pid=,stat=,args=)\\n}\\n\\nLAST_STATE_DETAIL=\\\"\\\"\\ncapture_clean_