from pathlib import Path\\n\\n# goodput SLO (ms) 와 측정 백분위\\nSLO_MS = float(os.environ.get(\\\"TS_GOODPUT_SLO_MS\\\", \\\"200\\\"))\\nGOODPUT_PCTS = (90, 95, 99)\\n\\n# CSV 컬럼 순서 (JSON 에 없으면 빈 칸)\\nFIELDS = [\\n    \\\"model\\\", \\\"ts_config\\\", \\\"request_rate\\\", \\\"date\\\",\\n    \\\"num_prompts\\\", \\\"completed\\\", \\\"failed\\\", \\\"duration\\\",\\n    \\\"request_throughput\\\", \\\"output_throughput\\\", \\\"total_token_throughput\\\",\\n    \\\"max_output_tokens_per_s\\\", \\\"max_concurrent_requests\\\",\\n    \\\"mean_ttft_ms\\\", \\\"median_ttft_ms\\\", \\\"p90_ttft_ms\\\",\\n    \\\"mean_tpot_ms\\\", \\\"median_tpot_ms\\\", \\\"p90_tpot_ms\\\",\\n    \\\"mean_itl_ms\\\", \\\"median_itl_ms\\\", \\\"p90_itl_ms\\\",\\n    \\\"goodput_slo_ms\\\",\\n    \\\"p90_goodput_reqs\\\", \\\"p90_goodput_frac\\\",\\n    \\\"p95_goodput_reqs\\\", \\\"p95_goodput_frac\\\",\\n    \\\"p99_goodput_reqs\\\", \\\"p99_goodput_frac\\\",\\n    \\\"total_input_tokens\\\", \\\"total_output_tokens\\\",\\n]\\n\\n\\ndef _percentile(sorted_vals: list, q: float) -> float:\\n    \\\"\\\"\\\"numpy.percentile 기본(linear interpolation) 과 동일한 백분위.\\n\\n    기존 p90_*_ms 필드(vllm 의 np.percentile)와 계산 방식을 맞춘다.\\n    \\\"\\\"\\\"\\n    n = len(sorted_vals)\\n    if n == 1:\\n        return sorted_vals[0]\\n    rank = (q / 100.0) * (n - 1)\\n    lo = int(math.floor(rank))\\n    hi = int(math.ceil(rank))\\n    if lo == hi:\\n        return sorted_vals[lo]\\n    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * (rank - lo)\\n\\n\\ndef compute_goodput(data: dict) -> dict:\\n    \\\"\\\"\\\"per-request itls 의 p90/p95/p99 가 SLO 이하인 요청을 good 으로 집계.\\n\\n    - itls 는 초 단위라 ms 로 환산한다.\\n    - error 가 있는 요청은 무조건 not-good.\\n    - 출력 토큰이 1개라 itl 이 비어 있는 요청은 token 지연 위반이 없으므로 good.\\n    - reqs = good / duration (req/s), frac = good / 전체 요청수.\\n    \\\"\\\"\\\"\\n    itls = data.get(\\\"itls\\\") or []\\n    errors = data.get(\\\"errors\\\") or [None] * len(itls)\\n    duration = data.g