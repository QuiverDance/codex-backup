ize:Number(m[3])});\n}\nconst [parentSha, baseTreeSha, localTreeSha] = refsBlock.trim().split(\"\\n\");\nif (changed.length !== 97) throw new Error(`expected 97 changed paths, got ${changed.length}`);\nfor (const path of changed) if (!metas.has(path)) throw new Error(`missing tree metadata: ${path}`);\n\nconst entries = [];\nconst batchSize = 6;\nfor (let offset = 0; offset < changed.length; offset += batchSize) {\n  const batch = changed.slice(offset, offset + batchSize);\n  const reads = await Promise.all(batch.map(async path => {\n    const meta = metas.get(path);\n    const r = await tools.exec_command({\n      cmd: `git show ${q(`HEAD:${path}`)} | base64 -w0`,\n      workdir: repoDir,\n      yield_time_ms: 10000,\n      max_output_tokens: 250000\n    });\n    if (r.exit_code !== 0) throw new Error(`read failed ${path}: ${r.output}`);\n    const expectedLen = Math.ceil(meta.size / 3) * 4;\n    if (r.output.length !== expectedLen) {\n      throw new Error(`base64 truncated ${path}: ${r.output.length} != ${expectedLen}; tokens=${r.original_token_count}`);\n    }\n    return {path, meta, content:r.output};\n  }));\n  const blobs = await Promise.all(reads.map(x =>\n    tools.mcp__codex_apps__github_create_blob({\n      repository_full_name: repo,\n      content: x.content,\n      encoding: \"base64\"\n    })\n  ));\n  for (let i = 0; i < reads.length; i++) {\n    const remoteSha = topSha(blobs[i]);\n    const {path, meta} = reads[i];\n    if (remoteSha !== meta.sha) throw new Error(`blob SHA mismatch ${path}: ${remoteSha} != ${meta.sha}`);\n    entries.push({path, mode:meta.mode, type:\"blob\", sha:remoteSha});\n  }\n  if (offset + batch.length === changed.length || (offset + batch.length) % 24 === 0) {\n    notify(`GitHub blob 검증 업로드: ${offset + batch.length}/${changed.length}`);\n  }\n}\n\nconst treeResult = await tools.mcp__codex_apps__github_create_tree({\n  repository_full_name: repo,\n  base_tree_sha: baseTreeSha,\n  tree_elements: entries\n});\nconst remoteTreeSha = topSha(treeResult);\nif (remoteTreeSha !== localTreeSha) {\n  throw new Error(`tree SHA mismatch ${remoteTreeSha} != ${localTreeSha}`);\n}\n\nconst commitResult = await tools.mcp__codex_apps__github_create_commit({\n  repository_full_name: repo,\n  message: \"backup all GH200 Codex sessions\",\n  parent_sha: parentSha,\n  tree_sha: remoteTreeSha\n});\nconst remoteCommitSha = topSha(commitResult);\nif (!remoteCommitSha) throw new Error(`no commit SHA: ${JSON.stringify(commitResult).slice(0,1000)}`);\n\nconst updateResult = await tools.mcp__codex_apps__github_update_ref({\n  repository_full_name: repo,\n  branch_name: branch,\n  sha: remoteCommitSha,\n  force: false\n});\ntext({\n  uploaded_and_verified_blobs: entries.length,\n  parent_sha: parentSha,\n  tree_sha: remoteTreeSha,\n  commit_sha: remoteCommitSha,\n  ref_update_sha: topSha(updateResult)\n});\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a03db0-aaff-7d32-b826-28614be3cf73","create_time":1787741756.992792}}}
