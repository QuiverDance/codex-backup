                       origin, [begin], [end], total_ms,\n                        require_contained=activity == \"PRODUCTIVE\", count_invalid=False)\n            if source == \"dense_fallback\":\n                # Subtract only this projection's fallback decode. Another\n                # layer's concurrent decode must not erase its dense GEMM.\n                entry = self._fused_reg[4 * layer + components.index(component)]\n                fallback = self._calc_intervals(\n                    origin, [entry[8]], [entry[9]], total_ms,\n                    require_contained=True, count_invalid=False)\n                pairs = self._subtract_intervals(pairs, fallback)\n            for start, stop in pairs:\n                rows.append(dict(layer=layer, activity=activity, component=component,\n                                 source=source, begin_ms=start, end_ms=stop))\n\n        for index, (begin, end) in enumerate(zip(\n                self.begin_kernel_events, self.end_kernel_events)):\n            source = (\"fused_weight_compute\" if index in fused_ids else\n                      \"dense_fallback\" if index in fallback_ids else \"dense_compute\")\n            add(index // 5, \"PRODUCTIVE\",\n                (\"qkv\", \"o\", \"attention\", \"gate_up\", \"down\")[index % 5],\n                source, begin, end)\n        if getattr(self, \"aux_timing_enabled\", False):\n            for component, begin, end in zip(\n                    (\"embed\", \"final_norm\"),\n                    self.begin_aux_compute_events[:2], self.end_aux_compute_events[:2]):\n                add(-1, \"PRODUCTIVE\", component, \"aux_compute\", begin, end)\n\n        for activity, begins, ends, source in (\n                (\"LOAD\", self.begin_memcpy_weight_events,\n                 self.end_memcpy_weight_events, \"weight_h2d\"),\n                (\"WDECOMP\", self.begin_decomp_events,\n                 self.end_decomp_events, \"weight_decode\"),\n                (\"WAIT\", self._v1_wwait_begin_events,\n                 self._v1_wwait_end_events, \"weight_wait\")):\n            if activity == \"WDECOMP\" and not (\n                    DualMemoryLoader.use_weight_comp and DualMemoryLoader.load_comp_weight):\n                continue\n            for index, (begin, end) in enumerate(zip(begins, ends)):\n                if activity != \"WAIT\" and index // 4 not in self.not_frozen_layers:\n                    continue\n                add(index // 4, activity, components[index % 4], source, begin, end)\n\n        if DualMemoryLoader.use_weight_comp:\n            for component_id, component in enumerate(components):\n                begins = getattr(self, \"begin_frozen_decomp_events\", {}).get(component, [])\n                ends = getattr(self, \"end_frozen_decomp_timing_events\", {}).get(component, [])\n                for layer, (begin, end) in enumerate(zip(begins, ends)):\n                    source = (\"fused_fallback\" if 5 * layer + kernel_slots[component_id]\n                              in fallback_ids else \"frozen_weight_decode\")\n                    add(layer, \"WDECOMP\", component, source, begin, end)\n\n        for activity, begin_attr, end_attr, source in (\n                (\"LOAD\", \"_frozen_split_h2d_begin_events_cache\",\n                 \"_frozen_split_h2d_end_timing_events_cache\", \"split_weight_h2d\"),\n                (\"WDECOMP\", \"_frozen_split_decomp_begin_timing_events_cache\",\n                 \"_frozen_split_decomp_end_timing_events_cache\", \"split_weight_decode\")):\n            begins, ends = getattr(self, begin_attr, {}), getattr(self, end_attr, {})\n            for key in begins.keys() & ends.keys():\n                layer, name = key[:2]\n                component = next((comp for comp in components if f\"{comp}_proj\" in name),\n                                 \"unknown\")\n                add(layer, activity, component, source, begins[key], ends[key])\n\n        for item in transfers:\n            if item.events is not None:\n                add(item.layer, \"LOAD\", \"kv\", \"kv_h2d_submission\", *item.events)\n        if DualMemoryLoader.use_kv_comp:\n            compressor = getattr(self, \"kv_compressor\", None)\n            begins = getattr(compressor, \"_kv_decode_begin\", None)\n            if begins is None or len(begins) != len(self.end_kv_decomp_events):\n                begins = getattr(compressor, \"_kv_dec_h2d\", None)\n            if begins is None or len(begins) != len(self.end_kv_decomp_events):\n                begins = self.begin_kv_decomp_events\n            for layer, (begin, end) in enumerate(zip(begins, self.end_kv_decomp_events)):\n                add(layer, \"KVDECOMP\", \"kv\", \"kv_decode\", begin, end)\n        for layer, (begin, end) in enumerate(zip(\n                self._v1_kv_wait_begin_events, self._v1_kv_wait_end_events)):\n            if layer < self.n_layers:\n                add(layer, \"WAIT\", \"kv\", \"kv_wait\", begin, end)\n        ready_events = dict(getattr(self, \"weight_wait_events\", {}))\n        ready_events.update({(layer, \"kv\"): event for layer, event in enumerate(\n            getattr(self, \"exec_attn_barriers\", ()))})\n        ready_owners = Counter(id(event) for event in ready_events.values() if event is not None)\n        for (layer, component), event in ready_events.items():\n            if event is None or ready_owners[id(event)] != 1:\n                continue\n            issue = getattr(self, \"prefetch_issue_host_ms\", {}).get((layer, component))\n            if issue is not None and issue[2] > 1:\n                # A reused readiness slot cannot identify which submission the\n                # consumer waited on. Do not silently attribute the last one.\n                continue\n            try:\n                ready = self._event_offset(origin, event)\n            except RuntimeError:\n                continue\n            rows.append(dict(layer=layer, activity=\"READY\", component=component,\n                             source=\"consumer_wait_event\", begin_ms=ready, end_ms=ready))\n        return rows\n\n    def record_prefetch_issue(self, layer, component):\n        \"\"\"CPU scheduling entry on a host clock, with no GPU marker or dependency.\"\"\"\n        if not self._breakdown_collecting:\n            return\n        key = (layer, component)\n        now = (perf_counter() - self._forward_host_start) * 1000\n        previous = self.prefetch_issue_host_ms.get(key)\n        if previous is None:\n            self.prefetch_issue_host_ms[key] = (now, now, 1)\n        else:\n            self.prefetch_issue_host_ms[key] = (previous[0], now, previous[2] + 1)\n\n    def _prefetch_issue_times(self):\n        return [dict(layer=layer, component=component, first_issue_host_ms=first,\n                     last_issue_host_ms=last, issue_count=count)\n                for (layer, component), (first, last, count)\n                in self.prefetch_issue_host_ms.items()]\n\n    def _flush_pending_breakdown(self, final=False):\n        pending = self._pending_breakdown\n        if pending is None:\n            return\n        origin, frame = pending\n        if self._pending_logits_recorded:\n            if final:\n                # Shutdown only; the inference path never waits for these\n                # extra markers or widens the old synchronization scope.\n                self.end_logits_event.synchronize()\n            if self.end_logits_event.query():\n                begin = origin.elapsed_time(self.begin_aux_compute_events[2])\n                end = origin.elapsed_time(self.end_aux_compute_events[2])\n                if frame[\"total_ms\"] <= begin <= end:\n                    frame[\"post_model\"] = dict(\n                        lm_head_ms=end - begin,\n                        logits_span_ms=self.begin_aux_compute_events[2].elapsed_time(\n                            self.end_logits_event),\n                        intervals=[dict(layer=-1, activity=\"PRODUCTIVE\", component=\"lm_head\",\n                                        source=\"aux_compute\", begin_ms=begin, end_ms=end)])\n        self.breakdown_writer.submit(frame)\n        self._pending_breakdown = None\n        self._pending_logits_recorded = False\n\n    def _event_offset(self, origin, event):\n        # Each CUDA timestamp is read once per model snapshot, then shared by\n        # legacy aggregates and detailed attribution. No extra CUDA records.\n        cache = getattr(self, \"_timing_offsets\", None)\n        if cache is None:\n            return origin.elapsed_time(event)\n        key = (id(origin), id(event))\n        if key not in cache:\n            cache[key] = origin.elapsed_time(event)\n        return cache[key]\n\n    def _subtract_intervals(\n        self,\n        intervals_a: List[Tuple[float, float]],\n        intervals_b: List[Tuple[float, float]],\n    ) -> List[Tuple[float, float]]:\n        \"\"\"Return ``intervals_a`` minus ``intervals_b`` as a sorted,\n        non-overlapping list.  Both inputs must already be sorted by\n        start time and individually non-overlapping (same precondition\n        as :func:`_calculate_total_overlap`).\"\"\"\n        if not intervals_b:\n            return [(s, e) for s, e in intervals_a]\n        result: List[Tuple[float, float]] = []\n        bi = 0\n        for a_start, a_end in intervals_a:\n            cur = a_start\n            # Advance bi past intervals strictly before cur.\n            while bi < len(intervals_b) and intervals_b[bi][1] <= cur:\n                bi += 1\n            j = bi\n            while cur < a_end and j < len(intervals_b):\n                b_start, b_end = intervals_b[j]\n                if b_start >= a_end:\n                    break\n                if b_start > cur:\n                    result.append((cur, min(b_start, a_end)))\n                cur = max(cur, b_end)\n                j += 1\n            if cur < a_end:\n                result.append((cur, a_end))\n        return result\n\n    def _calculate_total_overlap(\n        self,\n        intervals_a: List[Tuple[float, float]],\n        intervals_b: List[Tuple[float, float]],\n    ) -> float:\n        \"\"\"\n        두 개의 시간 간격 리스트가 겹치는 총 시간을 효율적으로 계산합니다.\n        (각 리스트는 내부적으로 겹치지 않고 정렬되어 있다고 가정합니다.)\n\n        Args:\n            intervals_a: 첫 번째 시간 간격 리스트\n            intervals_b: 두 번째 시간 간격 리스트\n\n        Returns:\n            두 리스트가 겹치는 총 시간 (float)\n        \"\"\"\n        # 두 리스트가 시작 시간 기준으로 정렬되어 있어야 합니다.\n\n","exit_code":0,"duration":{"secs":0,"nanos":4704},"formatted_output":" M docs/OFFLINE_GUIDE.md\n M docs/SERVING_GUIDE.md\n M scripts/offline/run_performance_suite.sh\n M scripts/serving/run_performance_suite.sh\n M tests/test_kv_load_metrics.py\n M tiered_serve/dual_memory_loader/__init__.py\n M tiered_serve/dual_memory_loader/frozen_split.py\n M tiered_serve/dual_memory_loader/init.py\n M tiered_serve/dual_memory_loader/kv.py\n M tiered_serve/dual_memory_loader/timing.py\n M tiered_serve/dual_memory_loader/weights.py\n M tiered_serve/graph_wait_ops.py\n M tiered_serve/immigrant_model_loader.py\n M tiered_serve/kv_load_metrics.py\n M tiered_serve/torch_hooks.py\n M tiered_serve/v1_cuda_graph_wrapper.py\n?? docs/BREAKDOWN_GUIDE.md\n?? etc/stack_pool_diag.c\n?? etc/stack_pool_diag.so\n?? scripts/summarize_breakdown_intervals.py\n?? tests/test_breakdown_intervals.py\n?? tiered_serve/breakdown_intervals.py\n?? tiered_serve/breakdown_markers.py\n?? tiered_serve/breakdown_output.py\n?? tiered_serve/breakdown_worker.py\nf4ab632457015f416d7d09ebde83f284d6062582\n\"\"\"Bounded, nonblocking handoff of numeric snapshots to a CPU-only process.\"\"\"\nimport atexit\nimport json\nimport logging\nimport queue\nimport struct\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom pathlib import Path\nfrom multiprocessing.util import Finalize\n\nimport msgspec\n\n\nclass AsyncBreakdownWriter:\n    def __init__(self, directory, suffix, capacity=64):\n        self.directory =