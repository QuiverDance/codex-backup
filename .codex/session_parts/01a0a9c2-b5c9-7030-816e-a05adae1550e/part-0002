_h2d_bytes\\\")\\n\\n\\ndef summarize(paths):\\n    groups = {}\\n    for path in paths:\\n        with open(path, newline=\\\"\\\") as source:\\n            for row in csv.DictReader(source):\\n                key = (row[\\\"config\\\"], row[\\\"batch\\\"], row[\\\"phase\\\"])\\n                if key not in groups:\\n                    groups[key] = dict(\\n                        config=key[0], batch=key[1], phase=key[2],\\n                        forwards=0, transfers=0, bytes_complete_forwards=0,\\n                        timed_forwards=0, **dict.fromkeys(BYTE_FIELDS, 0),\\n                        kvload_total_ms=0.0)\\n                group = groups[key]\\n                group[\\\"forwards\\\"] += 1\\n                group[\\\"transfers\\\"] += int(row[\\\"transfers\\\"])\\n                if row[\\\"bytes_complete\\\"] == \\\"1\\\":\\n                    group[\\\"bytes_complete_forwards\\\"] += 1\\n                    for field in BYTE_FIELDS:\\n                        group[field] += int(row[field])\\n                if row[\\\"timing_complete\\\"] == \\\"1\\\":\\n                    group[\\\"timed_forwards\\\"] += 1\\n                    group[\\\"kvload_total_ms\\\"] += float(row[\\\"kvload_ms\\\"])\\n    for group in groups.values():\\n        if group[\\\"bytes_complete_forwards\\\"] != group[\\\"forwards\\\"]:\\n            for field in BYTE_FIELDS:\\n                group[field] = None\\n        raw = group[\\\"kv_raw_bytes\\\"]\\n        payload, wire = group[\\\"kv_payload_bytes\\\"], group[\\\"kv_h2d_bytes\\\"]\\n        group[\\\"kv_compression_ratio\\\"] = raw / payload if payload else None\\n        group[\\\"kv_transfer_ratio\\\"] = raw / wire if wire else None\\n        if group[\\\"timed_forwards\\\"] != group[\\\"forwards\\\"]:\\n            group[\\\"kvload_total_ms\\\"] = None\\n        elapsed = group[\\\"kvload_total_ms\\\"]\\n        group[\\\"kvload_mean_ms\\\"] = (elapsed / group[\\\"forwards\\\"]\\n                                   if elapsed is not None else None)\\n    return list(groups.values())\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"directory\\\", type=Path)\\n    parser.add_argument(\\\"--output\\\", required=True, type=Path)\\n    args = parser.parse_args()\\n    rows = summarize(sorted(args.directory.glob(\\\"kv_metrics.*.csv\\\")))\\n    if not rows:\\n        parser.error(f\\\"no recorded KV metrics in {args.directory}\\\")\\n    with args.output.open(\\\"w\\\", newline=\\\"\\\") as output:\\n        writer = csv.DictWriter(output, fieldnames=list(rows[0]))\\n        writer.writeheader()\\n        for row in rows:\\n            writer.writerow({key: \\\"NA\\\" if value is None else value\\n                             for key, value in row.items()})\\n    print(f\\\"KV metrics summary: {args.output}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n#!/usr/bin/env bash\\n# Run the canonical 70B offline performance matrix in isolated processes.\\n\\nset -Eeuo pipefail\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\nREPO_ROOT=\\\"$(cd \\\"${SCRIPT_DIR}/../..\\\" && pwd)\\\"\\n\\nMODEL=\\\"meta-llama/Llama-3.1-70B-Instruct\\\"\\nINPUT_SEQ_LEN=1020\\nGEN_TOKENS=129\\nWARMUP=16\\nPREFILL_CHUNK=8192\\nREPEATS=3\\nKV_BACKEND=\\\"p4flat\\\"\\nCD3_KV_DELTA_BITS=3\\nCD3_KV_DECODE_THREADS=auto\\nGPU_INDEX=0\\nNUMA_NODE=0\\nWEIGHT_HUGE_PAGES=14\\nMAX_IDLE_HBM_MIB=1024\\nCLEANUP_TIMEOUT=120\\nOUTPUT_ROOT=\\\"${REPO_ROOT}/benchmark_results/offline_suite\\\"\\nDRY_RUN=0\\nCHECK_ONLY=0\\nBREAKDOWN=0\\nSTART_FROM=\\\"\\\"\\nBATCHES=(1 16 32 64 96 128)\\n\\nPYTHON=\\\"${REPO_ROOT}/.venv/bin/python\\\"\\nDRIVER=\\\"${REPO_ROOT}/offline_offload_kvweight.py\\\"\\nSTACK_POOL=\\\"${REPO_ROOT}/etc/stack_pool.so\\\"\\nHUGEPAGE_SYSFS=\\\"/sys/kernel/mm/hugepages/hugepages-16777216kB\\\"\\n\\nMETHODS=(\\n    \\\"PYTHONHASHSEED=0\\\"\\n    \\\"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\\\"\\n    \\\"LD