[k] / samples[group][k]\\n                    if samples[group][k] else \\\"NA\\\" for k in metrics})\\n        step_rows.append(row)\\n    write(directory / \\\"interval_summary.csv\\\",\\n          (*GROUP, \\\"forwards\\\", \\\"complete_forwards\\\", *(\\\"mean_\\\" + k for k in metrics)), step_rows)\\n\\n    # Activity and exact-state sums use complete forwards as the denominator.\\n    # Absent activity in an otherwise complete forward contributes zero.\\n    for table, dimensions, values in (\\n            (\\\"activity\\\", (\\\"region\\\", \\\"layer\\\", \\\"activity\\\", \\\"component\\\"), (\\\"active_ms\\\", \\\"only_ms\\\")),\\n            (\\\"states\\\", (\\\"region\\\", \\\"state\\\"), (\\\"duration_ms\\\",))):\\n        fields = GROUP + dimensions\\n        totals = defaultdict(Counter)\\n        for row in records(sorted(directory.glob(f\\\"breakdown_{table}.*.csv\\\"))):\\n            if table == \\\"activity\\\" and row[\\\"only_ms\\\"] == \\\"NA\\\":\\n                continue\\n            key = tuple(row[k] for k in fields)\\n            for value in values:\\n                totals[key][value] += float(row[value])\\n        rows = []\\n        for key in sorted(totals):\\n            n = valid[key[:len(GROUP)]]\\n            rows.append(dict(zip(fields, key), complete_forwards=n,\\n                             **{\\\"mean_\\\" + v: totals[key][v] / n for v in values}))\\n        write(directory / f\\\"interval_{table}_summary.csv\\\",\\n              (*fields, \\\"complete_forwards\\\", *(\\\"mean_\\\" + v for v in values)), rows)\\n    return step_rows\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"directory\\\", type=Path)\\n    args = parser.parse_args()\\n    try:\\n        rows = summarize(args.directory)\\n    except ValueError as error:\\n        parser.exit(1, f\\\"{error}\\\\n\\\")\\n    print(f\\\"Interval breakdown summary: {args.directory / 'interval_summary.csv'}\\\")\