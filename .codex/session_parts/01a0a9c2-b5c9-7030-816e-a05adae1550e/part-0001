n compressed) ──\\n        weight_decomp_time = 0.0\\n        overlap_time = 0.0\\n        weight_decomp_intervals = []\\n        if use_weight_comp and load_comp_weight:\\n            # Include all not-frozen layers' decomp events.\\n            # Stale events (from layers that didn't actually decompress)\\n            # are filtered by the begin_time / duration checks below.\\n            weight_decomp_intervals = self._calc_intervals(\\n                init_event,\\n                [e for i, e in enumerate(self.begin_decomp_events)\\n                 if (i // 4) in self.not_frozen_layers],\\n                [e for i, e in enumerate(self.end_decomp_events)\\n                 if (i // 4) in self.not_frozen_layers],\\n            )\\n            weight_decomp_time = sum(\\n                e - b for b, e in weight_decomp_intervals)\\n            overlap_time = self._calculate_total_overlap(\\n                llm_intervals, weight_decomp_intervals)\\n\\n        # ── KV comp / decomp (only when KV compression enabled) ──\\n        kv_comp_time = 0.0\\n        kv_decomp_time = 0.0\\n        kv_h2d_intervals: List[Tuple[float, float]] = []\\n        if use_kv_comp:\\n            kv_comp_intervals = self._calc_intervals(\\n                init_event,\\n                self.begin_kv_comp_events,\\n                self.end_kv_comp_events)\\n            kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\\n\\n            # KVDecomp must be the DECODE KERNEL only.  The loader's interval\\n            # [begin_kv_decomp, end_kv_decomp] covers H2D and stream waits.\\n            # _kv_dec_h2d is the H2D-producer event; using it as the decode\\n            # begin still absorbs older work / the decode-buffer WAR wait\\n            # already queued on batch_decomp_stream.  The compressor therefore\\n            # records _kv_decode_begin on the consumer stream after every wait\\n            # and immediately before the codec launch. H2D uses the common\\n            # per-transfer native windows below.\\n            _kc = getattr(self, \\\"kv_compressor\\\", None)\\n            h2d_e = getattr(_kc, \\\"_kv_dec_h2d\\\", None)\\n            kernel_b = getattr(_kc, \\\"_kv_decode_begin\\\", None)\\n            _n = len(self.begin_kv_decomp_events)\\n            if kernel_b is not None and len(kernel_b) == _n:\\n                kv_decomp_intervals = self._calc_intervals(\\n                    init_event, kernel_b, self.end_kv_decomp_events)\\n            elif h2d_e is not None and len(h2d_e) == _n:\\n                # Older compressors expose only the producer-side H2D-done\\n                # event.  This is less precise but still excludes the copy.\\n                kv_decomp_intervals = self._calc_intervals(\\n                    init_event, h2d_e, self.end_kv_decomp_events)\\n            else:\\n                kv_decomp_intervals = self._calc_intervals(\\n                    init_event,\\n                    self.begin_kv_decomp_events,\\n                    self.end_kv_decomp_events)\\n            kv_decomp_time = sum((e - b) for b, e in kv_decomp_intervals)\\n\\n        # ── Memcpy intervals (only recorded in compressed load path) ──\\n        weight_load_time = 0.0\\n        kv_load_time = 0.0\\n\\n        weight_memcpy_times = self._calc_intervals(init_event, [\\n            e for i, e in enumerate(self.begin_memcpy_weight_events)\\n            if (i // 4) in self.not_frozen_layers\\n        ], [\\n            e for i, e in enumerate(self.end_memcpy_weight_events)\\n            if (i // 4) in self.not_frozen_layers\\n        ])\\n        # frozen_split layers ride the SAME load_weight_stream but record\\n        # their LPDDR→staging H2D through separate per-(layer,name) timing\\n        # events (frozen layers are excluded from the offload filter above),\\n        # so the memcpy aggregation misses them entirely.  Fold those\\n        # intervals in here, then merge the union so overlapping/back-to-back\\n        # copies on the one stream aren't double-counted.\\n        fs_begin = getattr(self, \\\"_frozen_split_h2d_begin_events_cache\\\", None)\\n        fs_end = getattr(self, \\\"_frozen_split_h2d_end_timing_events_cache\\\",\\n                         None)\\n        if fs_begin and fs_end:\\n            _fs_keys = [k for k in fs_begin if k in fs_end]\\n            weight_memcpy_times = weight_memcpy_times + self._calc_intervals(\\n                init_event,\\n                [fs_begin[k] for k in _fs_keys],\\n                [fs_end[k] for k in _fs_keys])\\n        # Merge overlapping intervals before summing (all on load_weight_stream).\\n        weight_load_time = self._merge_union(weight_memcpy_times)\\n\\n        kv_memcpy_times = self._calc_intervals(init_event,\\n                                               self.begin_memcpy_kv_events,\\n                                               self.end_memcpy_kv_events)\\n        # Canonical KVLoad is the sum of native H2D submission windows for\\n        # every transfer, including mixed raw/compressed layers and chunks.\\n        # Explicit buffer waits and CPU preparation precede these events.\\n        # Engine contention/submission gaps inside the window remain included.\\n        torch.cuda.nvtx.mark(msg)\\n\\n        # ── Per-stream breakdown: LLM / WDecomp / KVDecomp / WLoad /\\n        #    KVLoad / Stall ──\\n        # Each metric is the wall-clock union of the recorded CUDA\\n        # events on that stream (events overlap across streams, so we\\n        # de-dupe via _calc_exec_times rather than summing).\\n        #\\n        # Notes on what this CAN'T see:\\n        # 1) frozen_compressed layers don't H2D during decode (the\\n        #    compressed bytes already live in HBM).  frozen_split\\n        #    layers DO H2D the compressed-exp/aux LPDDR buffers every\\n        #    decode step on load_weight_stream; those are captured via\\n        #    _frozen_split_h2d_(begin|end_timing)_events_cache below.\\n        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\\n        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\\n        #    into the decomp kernel (LPDDR is read directly via\\n        #    host-mapped UVA), so those H2D bytes don't surface as a\\n        #    separate event — they are folded into the WDecomp time\\n        #    instead.\\n        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\\n        #    → end_forward).  Python-loop TPOT additionally includes\\n        #    scheduler / sampling / output assembly on CPU.  See the\\n        #    [Step] StepLatency log emitted by\\n        #    offline_offload_kvweight.py for the perf_counter step time.\\n        if self.time_breakdown:\\n            # ── Subtract in-graph cur_stream waits from LLM intervals ──\\n            # Two distinct barriers block cur_stream INSIDE the\\n            # [begin_exec, end_exec] window — during either, cur_stream is\\n            # stalled, NOT running GEMM/attention:\\n            #   1. KV-barrier wait: the wrapper's `_after_replay` does\\n            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\\n            #      (see v1_cuda_graph_wrapper.py) before eager attention.\\n            #      Timed by `_v1_kv_wait_*`.\\n            #   2. In-graph weight-ready wait: the FX-injected\\n            #      `wait_frozen_weight` op blocks each projection GEMM until\\n            #      its weight H2D/decomp lands (see graph_wait_ops.py).\\n            #      Timed per (layer, component) by `_v1_wwait_*`.\\n            # Counting either as LLM busy inflates ComputeUnion and hides\\n            # stall.  The legacy \\\"Exec\\\" line subtracts BOTH (via\\n            # attn_barrier_wait + weight_stall), so LLM here must subtract\\n            # both too — otherwise the breakdown LLM reads high by the\\n            # weight-wait time.  Subtract the union of all wait sub-intervals\\n            # so LLM reflects actual compute on cur_stream and the stall calc\\n            # treats wait time as compute-idle.\\n            wait_intervals: List[Tuple[float, float]] = []\\n            for wbe, wee in (\\n                    (getattr(self, '_v1_kv_wait_begin_events', None),\\n                     getattr(self, '_v1_kv_wait_end_events', None)),\\n                    (getattr(self, '_v1_wwait_begin_events', None),\\n                     getattr(self, '_v1_wwait_end_events', None))):\\n                if not wbe or not wee:\\n                    continue\\n                wait_intervals.extend(self._calc_intervals(\\n                    init_event, wbe, wee, total_time))\\n            # KV and weight waits all live on cur_stream and run sequentially,\\n            # so they are already non-overlapping — a sort is enough to meet\\n            # _subtract_intervals' \\\"sorted AND non-overlapping\\\" precondition\\n            # (no union-merge needed).  Likewise llm_intervals: the per-kernel\\n            # exec intervals don't overlap (single cur_stream), so subtract\\n            # directly without unioning first.\\n            wait_intervals.sort(key=lambda x: x[0])\\n            # Compute = exec minus cur_stream waits; decomp is carved out\\n            # further down (once its intervals are built).  llm_brk is\\n            # computed there, NOT here.\\n            exec_residual_intervals = self._subtract_intervals(\\n                llm_intervals, wait_intervals)\\n\\n            # Frozen weight decomp uses a separate event pair\\n            # (begin_frozen_decomp_events /\\n            #  end_frozen_decomp_timing_events) keyed by\\n            # (comp_key, layer_id), distinct from the sync-only\\n            # frozen_decomp_events used for cross-stream waits and from\\n            # the per-layer begin/end_decomp_events used by the native\\n            # offload path.  The same pool also times fused-override fallback\\n            # decompression, including on non-frozen layers.\\n            frozen_decomp_intervals = []\\n            if (use_weight_comp\\n                    and hasattr(self, \\\"begin_frozen_decomp_events\\\")\\n                    and hasattr(self, \\\"end_frozen_decomp_timing_events\\\")):\\n                frozen_decomp_begin = []\\n                frozen_decomp_end = []\\n                for comp_key in (\\\"qkv\\\", \\\"o\\\", \\\"gate_up\\\", \\\"down\\\"):\\n                    begin_list = self.begin_frozen_decomp_events.get(\\n                        comp_key, [])\\n                    end_list = self.end_frozen_decomp_timing_events.get(\\n                        comp_key, [])\\n                    # These pools are also bound to fused overrides on\\n                    # offload_compressed (non-frozen) layers.  Such a cell can\\n                    # take the runtime decompress+linear fallback and records\\n                    # its WDecomp here, not in begin/end_decomp_events.\\n                    for layer_id in range(self.n_layers):\\n                        if (layer_id >= len(begin_list)\\n                                or layer_id >= len(end_list)):\\n                            continue\\n                        frozen_decomp_begin.append(begin_list[layer_id])\\n                        frozen_decomp_end.append(end_list[layer_id])\\n                frozen_decomp_intervals = self._calc_intervals(\\n                    init_event, frozen_decomp_begin, frozen_decomp_end,\\n                    total_time)\\n\\n            # frozen_split's per-(layer,name) decomp kernel uses its\\n            # own lazy timing cache (the per-comp_key\\n            # end_frozen_decomp_timing_events slots are written by the\\n            # frozen_compressed paths, not by\\n            # _decompress_frozen_split_for_name).\\n            frozen_split_decomp_intervals = []\\n            sd_begin_cache = getattr(\\n                self,\\n                \\\"_frozen_split_decomp_begin_timing_events_cache\\\",\\n                None)\\n            sd_end_cache = getattr(\\n                self,\\n                \\\"_frozen_split_decomp_end_timing_events_cache\\\",\\n                None)\\n            if sd_begin_cache and sd_end_cache:\\n                split_decomp_keys = [\\n                    key for key in sd_begin_cache if key in sd_end_cache]\\n                frozen_split_decomp_intervals = self._calc_intervals(\\n                    init_event,\\n                    [sd_begin_cache[key] for key in split_decomp_keys],\\n                    [sd_end_cache[key] for key in split_decomp_keys],\\n                    total_time)\\n\\n            all_weight_decomp_intervals = (\\n                weight_decomp_intervals\\n                + frozen_decomp_intervals\\n                + frozen_split_decomp_intervals)\\n            wdecomp_union: List[Tuple[float, float]] = []\\n            wdecomp_brk = 0.0\\n            if all_weight_decomp_intervals:\\n                wdecomp_union = self._calc_exec_times(\\n                    all_weight_decomp_intervals, [])\\n                wdecomp_brk = sum(e - b for b, e in wdecomp_union)\\n\\n            kvdecomp_union: List[Tuple[float, float]] = []\\n            kvdecomp_brk = 0.0\\n            if use_kv_comp and kv_decomp_intervals:\\n                kvdecomp_union = self._calc_exec_times(\\n                    kv_decomp_intervals, [])\\n                kvdecomp_brk = sum(e - b for b, e in kvdecomp_union)\\n\\n            # ── Productive Compute vs graph-piece residual ──\\n            # Keep the historical subtraction only as ExecResidual.  It cannot\\n            # establish productive-kernel time because an unobserved transitive\\n            # weight dependency remains inside the graph-piece envelope.  The\\n            # authoritative Compute source is the complete set of projection /\\n            # attention markers assembled near the top of calc_times.\\n            if wdecomp_union:\\n                exec_residual_intervals = self._subtract_intervals(\\n                    exec_residual_intervals, wdecomp_union)\\n            exec_residual_brk = sum(\\n                e - b for b, e in exec_residual_intervals)\\n            llm_active_intervals = productive_compute_intervals\\n            productive_compute_brk = (\\n                sum(e - b for b, e in llm_active_intervals)\\n                if compute_markers_valid else None)\\n            dense_compute_brk = (\\n                sum(e - b for b, e in dense_compute_intervals)\\n                if compute_markers_valid else None)\\n            fused_weight_compute_brk = (\\n                sum(e - b for b, e in fused_weight_compute_intervals)\\n                if compute_markers_valid else None)\\n            llm_brk = dense_compute_brk\\n\\n            # Frozen_split mode H2D's the compressed-exp / aux LPDDR\\n            # buffers every decode step on load_weight_stream (see\\n            # _decompress_frozen_split_for_name).  These do NOT land in\\n            # begin/end_memcpy_weight_events.  We pair the timing-only\\n            # BEGIN/END cache (the sync _frozen_split_h2d_events is not\\n            # enable_timing).\\n            frozen_split_h2d_intervals = []\\n            begin_cache = getattr(\\n                self, \\\"_frozen_split_h2d_begin_events_cache\\\", None)\\n            end_cache = getattr(\\n                self, \\\"_frozen_split_h2d_end_timing_events_cache\\\", None)\\n            if begin_cache and end_cache:\\n                split_h2d_keys = [\\n                    key for key in begin_cache if key in end_cache]\\n                frozen_split_h2d_intervals = self._calc_intervals(\\n                    init_event,\\n                    [begin_cache[key] for key in split_h2d_keys],\\n                    [end_cache[key] for key in split_h2d_keys],\\n                    total_time)\\n\\n            all_weight_load_intervals = (\\n                weight_memcpy_times + frozen_split_h2d_intervals)\\n            wload_union: List[Tuple[float, float]] = []\\n            wload_brk = 0.0\\n            if all_weight_load_intervals:\\n                wload_union = self._calc_exec_times(\\n                    all_weight_load_intervals, [])\\n                wload_brk = sum(e - b for b, e in wload_union)\\n\\n            # Diagnostic: count how many intervals reached each bucket so\\n            # we can tell whether wload_brk is low because intervals were\\n            # filtered (stale events) or because the union truly is small.\\n            if not self.batch_has_prefill and os.getenv(\\n                    \\\"TIERED_SERVE_BREAKDOWN_VERBOSE\\\", \\\"0\\\") == \\\"1\\\":\\n                wmt_sum = sum(e - b for b, e in weight_memcpy_times)\\n                fsi_sum = sum(e - b for b, e in frozen_split_h2d_intervals)\\n                logger.info(\\n                    \\\"[WLoadDbg] weight_memcpy: n=%d sum=%.2fms | \\\"\\n                    \\\"frozen_split_h2d: n=%d sum=%.2fms | \\\"\\n                    \\\"union=%.2fms (cache_size begin=%d end=%d)\\\",\\n                    len(weight_memcpy_times), wmt_sum,\\n                    len(frozen_split_h2d_intervals), fsi_sum,\\n                    wload_brk,\\n                    len(begin_cache or {}),\\n                    len(end_cache or {}))\\n\\n            kvload_brk = kv_metrics[\\\"kvload_ms\\\"]\\n\\n            # ExposedLoad = recorded load windows not overlapped by productive\\n            # compute/decompression.  This is not total GPU idle, so keep the\\n            # legacy Stall field only as a compatibility alias.\\n            compute_intervals = (\\n                all_weight_decomp_intervals\\n                + (kv_decomp_intervals if use_kv_comp else []))\\n            if compute_markers_valid:\\n                compute_union = self._calc_exec_times(\\n                    llm_active_intervals, compute_intervals)\\n            else:\\n                compute_union = []\\n            canonical_kv_load_intervals = kv_h2d_intervals\\n            load_union_all = self._calc_exec_times(\\n                all_weight_load_intervals, canonical_kv_load_intervals)\\n            load_total = sum(e - b for b, e in load_union_all)\\n            if compute_markers_valid and kv_metrics[\\\"timing_complete\\\"]:\\n                load_in_compute = self._calculate_total_overlap(\\n                    load_union_all, compute_union)\\n                exposed_load_brk = max(0.0, load_total - load_in_compute)\\n                recorded_activity_union = self._calc_exec_times(\\n                    compute_union, load_union_all)\\n                unclassified_brk = max(\\n                    0.0,\\n                    total_time - sum(\\n                        e - b for b, e in recorded_activity_union))\\n            else:\\n                exposed_load_brk = None\\n                unclassified_brk = None\\n            stall_brk = exposed_load_brk\\n\\n            # GPUFwd here is wall time between begin_forward_event and\\n            # end_forward_event — pure GPU forward.  Python-side TPOT\\n            # (engine.step()) additionally includes scheduler, sampling,\\n            # logits processing and output assembly running on CPU\\n            # serially after the GPU forward finishes; that gap is\\n            # visible by comparing this line to the [Step] StepLatency\\n            # line emitted by offline_offload_kvweight.py.\\n            # Reported metrics (per-step wall-clock on GPU):\\n            #   Compute/DenseCompute — attention, native projections, raw-BF16\\n            #              prefill projections, and the dense-GEMM portion of\\n            #              runtime fused-codec fallbacks.\\n            #   FusedWeightCompute — projections that actually selected an\\n            #              inseparable fused weight-decode + GEMM kernel.\\n            #   ProductiveCompute — union of DenseCompute and\\n            #              FusedWeightCompute.\\n            #   ExecResidual — graph-piece envelope after known waits/WDecomp;\\n            #              diagnostic only, never substituted for Compute.\\n            #   WDecomp  — weight decompression on decomp_weight_stream\\n            #   KVDecomp — KV decompression on the KV decomp stream(s).  This\\n            #              runs CONCURRENTLY with ProductiveCompute (it is\\n            #              prefetched a layer ahead), so it is NOT carved out and\\n            #              is NOT part of the additive GPUFwd tiling — it is a\\n            #              standalone stream-busy figure that overlaps it.\\n            #   WLoad    — weight H2D on load_weight_stream\\n            #   KVLoad   — KV H2D on load_kv_stream\\n            #   ExposedLoad — load-active wall time with no recorded productive\\n            #              compute/decompression.  Stall is a compatibility\\n            #              alias, not total GPU idle.\\n            def _fmt_metric(value):\\n                return \\\"NA\\\" if value is None else f\\\"{value:.4f}\\\"\\n\\n            def _fmt_bytes(value):\\n                return \\\"NA\\\" if value is None else str(value)\\n\\n            brk_msg = (\\n                f\\\"{prefix} [Breakdown] \\\"\\n                f\\\"GPUFwd: {total_time:.4f} | \\\"\\n                f\\\"Compute: {_fmt_metric(llm_brk)} \\\"\\n                f\\\"WDecomp: {wdecomp_brk:.4f} \\\"\\n                f\\\"KVDecomp: {kvdecomp_brk:.4f} \\\"\\n                f\\\"WLoad: {wload_brk:.4f} \\\"\\n                f\\\"KVLoad: {_fmt_metric(kvload_brk)} \\\"\\n                f\\\"KVLoadResidualEstimate: {kv_load_residual:.4f} \\\"\\n                f\\\"KVRawBytes: {_fmt_bytes(kv_metrics['kv_raw_bytes'])} \\\"\\n                f\\\"KVPayloadBytes: {_fmt_bytes(kv_metrics['kv_payload_bytes'])} \\\"\\n                f\\\"KVH2DBytes: {_fmt_bytes(kv_metrics['kv_h2d_bytes'])} \\\"\\n                f\\\"KVCompressionRatio: {_fmt_metric(kv_metrics['kv_compression_ratio'])} \\\"\\n                f\\\"KVTransferRatio: {_fmt_metric(kv_metrics['kv_transfer_ratio'])} \\\"\\n                f\\\"Stall: {_fmt_metric(stall_brk)} \\\"\\n                f\\\"DenseCompute: {_fmt_metric(dense_compute_brk)} \\\"\\n                f\\\"FusedWeightCompute: \\\"\\n                f\\\"{_fmt_metric(fused_weight_compute_brk)} \\\"\\n                f\\\"ProductiveCompute: \\\"\\n                f\\\"{_fmt_metric(productive_compute_brk)} \\\"\\n                f\\\"ExecResidual: {exec_residual_brk:.4f} \\\"\\n                f\\\"ExposedLoad: {_fmt_metric(exposed_load_brk)} \\\"\\n                f\\\"Unclassified: {_fmt_metric(unclassified_brk)} \\\"\\n                f\\\"ComputeMarkers: {len(kernel_intervals)}/\\\"\\n                f\\\"{expected_compute_markers} \\\"\\n                f\\\"FusedRoutes: {len(actual_fused_event_ids)}/\\\"\\n                f\\\"{len(fallback_dense_event_ids)}/\\\"\\n                f\\\"{len(fused_override_entries)} \\\"\\n                f\\\"RawPrefillDense: {len(raw_prefill_dense_event_ids)} \\\"\\n                f\\\"WindowClip: {self._timing_window_clip_count} \\\"\\n                f\\\"WindowDrop: {self._timing_window_drop_count} \\\"\\n                f\\\"Instrumented: 1\\\")\\n            # Both phases' breakdowns are accumulated (see below) and logged\\n            # once per batch by the benchmark driver\\n            # (offline_offload_kvweight.py); the per-step console line is\\n            # suppressed for BOTH so the console isn't spammed one line per\\n            # step.  File + nvtx keep the full per-step record regardless.\\n            if self._time_log_file is not None:\\n                self._time_log_file.write(brk_msg + \\\"\\\\n\\\")\\n                self._time_log_file.flush()\\n            torch.cuda.nvtx.mark(brk_msg)\\n\\n            # Expose the breakdown as a plain dict for the benchmark driver\\n            # and diagnostics.  Overwritten each calc_times call; prefill /\\n            # decode are distinguishable via the \\\"is