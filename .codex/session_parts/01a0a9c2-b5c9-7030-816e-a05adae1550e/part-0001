               self._timing_window_drop_count = getattr(\\n                        self, \\\"_timing_window_drop_count\\\", 0) + 1\\n                continue\\n            begin_time = max(0.0, raw_begin)\\n            end_time = min(window_end_ms, raw_end)\\n            if end_time - begin_time < 0.001:\\n                if count_invalid:\\n                    self._timing_window_drop_count = getattr(\\n                        self, \\\"_timing_window_drop_count\\\", 0) + 1\\n                continue\\n            if begin_time != raw_begin or end_time != raw_end:\\n                self._timing_window_clip_count = getattr(\\n                    self, \\\"_timing_window_clip_count\\\", 0) + 1\\n            intervals.append((begin_time, end_time))\\n        intervals.sort(key=lambda x: x[0])\\n\\n        return intervals\\n\\n    @staticmethod\\n    def _merge_union(intervals):\\n        \\\"\\\"\\\"Length of the interval union, with overlapping windows counted once.\\n\\n        Event-window unions can contain gaps/waits; this does not by itself\\n        establish copy-engine activity or exclusive transfer time.\\n        \\\"\\\"\\\"\\n        total = 0.0\\n        mb = me = None\\n        for b, e in sorted(intervals, key=lambda x: x[0]):\\n            if me is None or b > me:\\n                if me is not None:\\n                    total += me - mb\\n                mb, me = b, e\\n            else:\\n                me = max(me, e)\\n        if me is not None:\\n            total += me - mb\\n        return total\\n\\n    def reset_events(self):\\n        for e in self.begin_exec_events + self.end_exec_events:\\n            e.record()\\n        for e in self.begin_kernel_events + self.end_kernel_events:\\n            e.record()\\n        for e in self.begin_decomp_events + self.end_decomp_events:\\n            e.record()\\n        for e in (self.begin_memcpy_weight_events +\\n                  self.end_memcpy_weight_events):\\n            e.record()\\n       