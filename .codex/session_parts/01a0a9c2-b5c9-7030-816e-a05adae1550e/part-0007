ward is not used by LogitsProcessor: measure the actual\n    # quant_method.apply GEMM, excluding gather, scaling and other processing.\n    apply = model.lm_head.quant_method.apply\n\n    def timed_lm_head(layer, *args, **kwargs):\n        timed = dm._breakdown_pending and layer is model.lm_head\n        if timed:\n            dm.begin_aux_compute_events[2].record()\n        output = apply(layer, *args, **kwargs)\n        if timed:\n            dm.end_aux_compute_events[2].record()\n        return output\n\n    model.lm_head.quant_method.apply = timed_lm_head\n    compute_logits = model.compute_logits\n\n    def timed_compute_logits(*args, **kwargs):\n        output = compute_logits(*args, **kwargs)\n        if dm._breakdown_pending:\n            dm.end_forward_event.record()\n            # This replaces the earlier model-only diagnostic synchronization.\n            # Read all producer events only after logits and side streams finish.\n            torch.cuda.synchronize()\n            dm.calc_times(0)\n            dm.kv_load_metrics.finish_forward()\n            dm._breakdown_pending = False\n        return output\n\n    model.compute_logits = timed_compute_logits\n\"\"\"CPU interval attribution for the existing diagnostic CUDA event windows.\n\nActivity rows are unions per (layer, activity, component), and can overlap\nother rows. State rows partition GPU-forward wall time without double counting.\nNo event creation, synchronization or changes to GPU scheduling live here.\n\"\"\"\nimport atexit\nimport csv\nfrom collections import Counter, defaultdict\nfrom pathlib import Path\n\n\nCONTEXT = (\"forward\", \"batch\", \"step\", \"config\", \"phase\", \"tokens\")\nCOLUMNS = {\n    \"intervals\": (\"layer\", \"activity\", \"component\", \"source\", \"begin_ms\", \"end_ms\"),\n    \"activity\": (\"region\", \"layer\", \"activity\", \"component\", \"active_ms\", \"only_ms\"),\n    \"states\": (\"region\", \"state\", \"duration_ms\"),\n    \"waits\": (\"layer\", \"component\", \"need_ms\", \"wait_end_ms\", \"wait_ms\",\n              \"ready_ms\", \"lateness_ms\", \"slack_ms\", \"ready_source\"),\n    \"prefetch\": (\"layer\", \"component\", \"issue_host_ms\", \"issue_compute_ms\",\n                 \"h2d_begin_ms\", \"h2d_end_ms\", \"issue_to_h2d_ms\", \"need_ms\",\n                 \"ready_ms\", \"consumer_begin_ms\", \"lateness_ms\"),\n    \"steps\": (\"gpu_fwd_ms\", \"complete\", \"first_productive_ms\", \"last_load_ms\",\n              \"load_only_ms\", \"compute_only_ms\", \"overlap_ms\", \"unclassified_ms\",\n              \"startup_load_only_ms\", \"middle_load_only_ms\", \"drain_load_only_ms\",\n              \"startup_compute_only_ms\", \"middle_compute_only_ms\", \"drain_compute_only_ms\",\n              \"model_fwd_ms\"),\n}\nCOMPUTE = (\"PRODUCTIVE\", \"WDECOMP\", \"KVDECOMP\")\n\n\ndef analyze(intervals, total_ms, *, complete):\n    \"\"\"Sweep half-open intervals, preserving concurrent activities as a state.\n\n    Startup ends at the first productive marker. Drain starts at the later\n    of that boundary and the last load end, making the three regions disjoint\n    even when all transfers finish before compute starts. With no loads,\n    compute after startup belongs to drain. Missing productive markers leave\n    region boundaries unavailable, rather than inventing a pipeline tail.\n    \"\"\"\n    productive = [r[\"begin_ms\"] for r in intervals if r[\"activity\"] == \"PRODUCTIVE\"]\n    loads = [r[\"end_ms\"] for r in intervals if r[\"activity\"] == \"LOAD\"]\n    first = min(productive) if productive else None\n    last = max(loads) if loads else None\n    drain = max(first, last or 0.0) if first is not None else None\n    events = defaultdict(list)\n    events[0.0]\n    events[total_ms]\n    if first is not None:\n        events[first]\n        events[drain]\n    for row in intervals:\n        if row[\"activity\"] not in (\"LOAD\", *COMPUTE):\n            continue\n        key = (row[\"layer\"], row[\"activity\"], row[\"component\"])\n        events[row[\"begin_ms\"]].append((key, 1))\n        events[row[\"end_ms\"]].append((key, -1))\n\n    active = Counter()\n    activities = defaultdict(lambda: [0.0, 0.0])\n    states = defaultdict(float)\n    totals = {key: 0.0 for key in COLUMNS[\"steps\"][4:-1]}\n    times = sorted(events)\n    for index, begin in enumerate(times[:-1]):\n        for key, delta in events[begin]:\n            active[key] += delta\n            if not active[key]:\n                del active[key]\n        duration = times[index + 1] - begin\n        region = (\"unknown\" if first is None else \"startup\" if begin < first\n                  else \"middle\" if begin < drain else \"drain\")\n        kinds = {key[1] for key in active}\n        load = \"LOAD\" in kinds\n        compute = bool(kinds.intersection(COMPUTE))\n        bucket = (\"overlap_ms\" if load and compute else \"load_only_ms\" if load\n                  else \"compute_only_ms\" if compute else \"unclassified_ms\")\n        totals[bucket] += duration\n        if region != \"unknown\" and bucket in (\"load_only_ms\", \"compute_only_ms\"):\n            totals[f\"{region}_{bucket}\"] += duration\n        state = \"+\".join(k for k in (\"LOAD\", *COMPUTE) if k in kinds) or \"UNCLASSIFIED\"\n        states[region, state] += duration\n        for layer, activity, component in active:\n            values = activities[region, layer, activity, component]\n            values[0] += duration\n            if (activity == \"LOAD\" and not compute) or (activity in COMPUTE and not load):\n                values[1] += duration\n\n    # Incomplete coverage must not masquerade as exclusive wall time.\n    activity_rows = [dict(region=k[0], layer=k[1], activity=k[2], component=k[3],\n                          active_ms=v[0], only_ms=v[1] if complete else None)\n                     for k, v in sorted(activities.items())]\n    state_rows = [dict(region=k[0], state=k[1], duration_ms=v)\n                  for k, v in sorted(states.items())] if complete else []\n    if not complete:\n        totals = dict.fromkeys(totals)\n    elif first is None:\n        for key in totals:\n            if key.startswith((\"startup_\", \"middle_\", \"drain_\")):\n                totals[key] = None\n    return activity_rows, state_rows, dict(\n        gpu_fwd_ms=total_ms, complete=int(complete), first_productive_ms=first,\n        last_load_ms=last, **totals)\n\n\ndef consumer_waits(intervals):\n    \"\"\"Join wait starts to observed prerequisite completion in this forward.\n\n    Producer timing markers approximate readiness; they are not the sync-only\n    barrier itself. In-graph fallback decode after the wait is not a prerequisite\n    of that wait. Missing producers (e.g. resident weights) remain unavailable.\n    Signed lateness measures this local consumer dependency, not causal GPU idle.\n    \"\"\"\n    producers = defaultdict(list)\n    for row in intervals:\n        if row[\"activity\"] in (\"LOAD\", \"WDECOMP\", \"KVDECOMP\"):\n            if row[\"source\"] == \"fused_fallback\":\n                continue\n            producers[row[\"layer\"], row[\"component\"]].append(row)\n    result = []\n    for row in intervals:\n        if row[\"activity\"] != \"WAIT\":\n            continue\n        need, end = row[\"begin_ms\"], row[\"end_ms\"]\n        candidates = [p for p in producers[row[\"layer\"], row[\"component\"]]\n                      if p[\"end_ms\"] <= end]\n        producer = max(candidates, key=lambda p: p[\"end_ms\"], default=None)\n        ready = producer[\"end_ms\"] if producer else None\n        result.append(dict(\n            layer=row[\"layer\"], component=row[\"component\"], need_ms=need,\n            wait_end_ms=end, wait_ms=end - need, ready_ms=ready,\n            lateness_ms=ready - need if ready is not None else None,\n            slack_ms=max(0.0, need - ready) if ready is not None else None,\n            ready_source=producer[\"source\"] if producer else \"unavailable\"))\n    return result\n\n\ndef prefetch_timelines(intervals, issues, waits):\n    loads = defaultdict(list)\n    computes = defaultdict(list)\n    for row in intervals:\n        key = (row[\"layer\"], row[\"component\"])\n        if row[\"activity\"] == \"LOAD\":\n            loads[key].append(row)\n        elif row[\"activity\"] == \"PRODUCTIVE\":\n            component = \"kv\" if row[\"component\"] == \"attention\" else row[\"component\"]\n            computes[row[\"layer\"], component].append(row[\"begin_ms\"])\n    wait_by_key = {(r[\"layer\"], r[\"component\"]): r for r in waits}\n    rows = []\n    for issue in issues:\n        key = (issue[\"layer\"], issue[\"component\"])\n        begin = min((r[\"begin_ms\"] for r in loads[key]), default=None)\n        end = max((r[\"end_ms\"] for r in loads[key]), default=None)\n        wait = wait_by_key.get(key, {})\n        gpu_issue = issue[\"issue_compute_ms\"]\n        rows.append(dict(\n            issue, h2d_begin_ms=begin, h2d_end_ms=end,\n            issue_to_h2d_ms=begin - gpu_issue if begin is not None and gpu_issue is not None else None,\n            need_ms=wait.get(\"need_ms\"), ready_ms=wait.get(\"ready_ms\"),\n            consumer_begin_ms=min(computes[key], default=None),\n            lateness_ms=wait.get(\"lateness_ms\")))\n    return rows\n\n\nclass BreakdownWriter:\n    \"\"\"Flush all tables once per forward; keep no run-long per-layer history.\"\"\"\n\n    def __init__(self, directory, suffix):\n        self.directory = Path(directory)\n        self.directory.mkdir(parents=True, exist_ok=True)\n        self.files = {}\n        self.writers = {}\n        for name, columns in COLUMNS.items():\n            file = open(self.directory / f\"breakdown_{name}.{suffix}.csv\", \"w\")\n            self.files[name] = file\n            writer = csv.DictWriter(file, fieldnames=CONTEXT + columns)\n            writer.writeheader()\n            self.writers[name] = writer\n        atexit.register(self.