oad_compressed    (compress / decompress in DRAM via GPU)\\n          offload <-> offload_uncompressed  (add/remove comp buffer)\\n          offload_compressed <-> offload_uncompressed\\n\\n        Disk I/O and initial weight loading are NOT repeated.\\n        \\\"\\\"\\\"\\n        self._breakdown_layout_cache = None\\n\\n        if isinstance(yaml_path_or_dict, dict):\\n            raw_lr = yaml_path_or_dict\\n        else:\\n            import yaml as yaml_mod\\n            data = yaml_mod.safe_load(open(yaml_path_or_dict))\\n            raw_lr = data.get(\\\"layer_residency\\\", {})\\n\\n        # Diagnostic: surface every distinct mode the incoming cfg\\n        # requests so any unexpected mode is visible upstream of the\\n        # per-pass dispatch.\\n        _modes_seen: Dict[str, int] = {}\\n        for _lc in raw_lr.get(\\\"layers\\\", {}).values():\\n            if isinstance(_lc, dict):\\n                for _m in _lc.values():\\n                    # A cell is either a bare mode string or the\\n                    # ``{mode: ..., compressor: ...}`` mapping; key the\\n                    # diagnostic tally by the base mode in both cases.\\n                    if isinstance(_m, str):\\n                        _modes_seen[_m] = _modes_seen.get(_m, 0) + 1\\n                    elif isinstance(_m, dict) and \\\"mode\\\" in _m:\\n                        _modes_seen[_m[\\\"mode\\\"]] = _modes_seen.get(\\n                            _m[\\\"mode\\\"], 0) + 1\\n        for _section in (\\\"default\\\", \\\"frozen\\\"):\\n            _val = raw_lr.get(_section, {})\\n            if isinstance(_val, dict):\\n                    \\\"kv_cpu_fast_finalize_ms\\\": float(getattr(\\n                        _kc, \\\"_step_cpu_fast_finalize_ms\\\", 0.0)),\\n                    \\\"kv_cpu_legacy_get_ms\\\": float(getattr(\\n                        _kc, \\\"_step_cpu_legacy_get_ms\\\", 0.0)),\\n                    \\\"kv_cpu_legacy_finalize_ms\\\": float(getattr(\\n                        _kc, \\\"_step_cpu_legacy_finalize_ms\\\", 0.0)),\\n                    \\\"kv_cpu_fast_candidates\\\": int(getattr(\\n                        _kc, \\\"_step_cpu_fast_candidates\\\", 0)),\\n                    \\\"kv_cpu_fast_hits\\\": int(getattr(\\n                        _kc, \\\"_step_cpu_fast_hits\\\", 0)),\\n                    \\\"kv_cpu_fast_fallbacks\\\": int(getattr(\\n                        _kc, \\\"_step_cpu_fast_fallbacks\\\", 0)),\\n                    \\\"kv_cpu_raw_blocks\\\": int(getattr(\\n                        _kc, \\\"_step_cpu_raw_blocks\\\", 0)),\\n                })\\n            if self.batch_has_prefill:\\n                DualMemoryLoader.prefill_breakdowns.append(self.last_breakdown)\\n            else:\\n                # Stash the per-component stall/load arrays computed in the\\n                # decode stall block above so the driver can print one\\n                # batch-averaged BarrierWait / ComponentLoad line.\\n                self.last_breakdown[\\\"comp_stall\\\"] = list(comp_stall)\\n                self.last_breakdown[\\\"attn_barrier_wait\\\"] = attn_barrier_wait\\n                self.last_breakdown[\\\"weight_stall\\\"] = weight_stall\\n                self.last_breakdown[\\\"comp_load\\\"] = list(comp_load)\\n                self.last_breakdown[\\\"kv_load_ms\\\"] = kv_load_ms\\n                DualMemoryLoader.decode_breakdowns.append(self.last_breakdown)\\n\\n        self.reset_events()\\n\\n    def _snapshot_layout(self):\\n        \\\"\\\"\\\"Prepare stable event metadata once, outside steady-state collection.\\n\\n        Lazy split pools can grow when a new route first executes. Rebuild when\\n        that happens, or when reconfiguration/capture changes the wait target.\\n        No CUDA events enter the transport frame; only their numeric IDs do.\\n        \\\"\\\"\\\"\\n        cache_names = (\\n            \\\"_frozen_split_h2d_begin_events_cache\\\", \\\"_frozen_split_h2d_end_timing_events_ca