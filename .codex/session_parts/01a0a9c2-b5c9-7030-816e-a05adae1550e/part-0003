{"timestamp":"2026-09-16T10:42:31.863Z","ordinal":200,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0a9cf-a137-70a0-b834-d468350d34e8","call_id":"call_ROfYrvYjmX3eNDJ3dtG3DSPG","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"d5b133\",\"wall_time_seconds\":0.00000288,\"exit_code\":0,\"original_token_count\":7484,\"output\":\"import logging\\nimport os\\nfrom typing import TYPE_CHECKING\\n\\nimport numpy as np\\nimport torch\\n\\nif TYPE_CHECKING:\\n    from tiered_serve.kv_cache import vLLMKVCache\\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\nlogger = logging.getLogger(\\\"vllm\\\")\\n\\n# Read once at import — ``after_exec_attn`` runs per layer per decode step, and\\n# re-parsing this env var there put an ~3-frame ``os.getenv`` chain on the\\n# per-step hot path (a feeder of the 16 KiB data-stack churn). Constant for the\\n# process.\\n_OFF_MP_UNLOAD = bool(os.getenv(\\\"TIERED_SERVE_OFF_MP_UNLOAD\\\"))\\n\\n\\ndef before_forward_event(self, input):\\n    if torch.cuda.is_current_stream_capturing():\\n        return\\n    self.begin_exec_events[self.phase].record()\\n\\n\\ndef after_forward_event(self, input, result):\\n    if torch.cuda.is_current_stream_capturing():\\n        return\\n    self.end_exec_events[self.phase].record()\\n\\n\\ndef count_contiguous_groups(numbers: list[int]) -> int:\\n    \\\"\\\"\\\"\\n    정렬된 정수 리스트에서 연속된 숫자 그룹의 개수를 셉니다.\\n\\n    Args:\\n        numbers: 오름차순으로 정렬된 정수 리스트.\\n\\n    Returns:\\n        연속된 숫자 그룹의 총 개수.\\n    \\\"\\\"\\\"\\n    # 리스트가 비어있으면 그룹은 0개입니다.\\n    if not numbers:\\n        return 0\\n\\n    # 리스트에 원소가 하나라도 있으면 최소 1개의 그룹이 존재합니다.\\n    group_count = 1\\n\\n    # 두 번째 원소부터 이전 원소와 비교를 시작합니다.\\n    for i in range(1, len(numbers)):\\n        # 현재 숫자가 이전 숫자 + 1이 아니라면, 새로운 그룹이 시작된 것입니다.\\n        if numbers[i] != numbers[i - 1] + 1:\\n            group_count += 1\\n\\n    return group_count\\n\\n\\ndef _batch_has_prefill(fctx, default: bool = False) -> bool:\\n    \\\"\\\"\\\"Return True if the current batch contains any prefill chunk.\\n\\n    V1 FlashAttentionMetadata carries ``max_query_len`` (==1 for a pure\\n    decode batch, >1 when any request contributes more than one query\\n    token, i.e. a prefill / chunked-prefill chunk).  ``fctx.attn_metadata``\\n    is a dict[layer_name -> metadata] (or a list of such dicts for\\n    multiple KV-cache groups); any layer's metadata carries the same\\n    max_query_len, so we read the first available one.  Returns ``default``\\n    when metadata is missing (e.g. profiling/warmup) so callers can fall\\n    back to the cudagraph-mode heuristic.\\n    \\\"\\\"\\\"\\n    am = getattr(fctx, \\\"attn_metadata\\\", None)\\n    if am is None:\\n        return default\\n    if isinstance(am, (list, tuple)):\\n        am = am[0] if am else None\\n    if isinstance(am, dict):\\n        am = next(iter(am.values()), None)\\n    mql = getattr(am, \\\"max_query_len\\\", None)\\n    if mql is None:\\n        return default\\n    return mql > 1\\n\\n\\ndef _num_batch_tokens(fctx, default: int = 1) -> int:\\n    \\\"\\\"\\\"Return the current batch's total token count (``num_actual_tokens``),\\n    or ``default`` when attn_metadata is unavailable. Mirrors\\n    :func:`_batch_has_prefill`'s metadata traversal. Falls back to the last\\n    ``query_start_loc`` entry when ``num_actual_tokens`` is absent.\\\"\\\"\\\"\\n    am = getattr(fctx, \\\"attn_metadata\\\", None)\\n    if am is None:\\n        return default\\n    if isinstance(am, (list, tuple)):\\n        am = am[0] if am else None\\n    if isinstance(am, dict):\\n        am = next(iter(am.values()), None)\\n    n = getattr(am, \\\"num_actual_tokens\\\", None)\\n    if n is not None:\\n        return int(n)\\n    qsl = getattr(am, \\\"query_start_loc\\\", None)\\n    if qsl is not None and len(qsl) > 0:\\n        return int(qsl[-1])\\n    return default\\n\\n\\ndef _attn_metadata(fctx):\\n    \\\"\\\"\\\"Return a single AttentionMetadata from the forward context, mirroring\\n    the dict/list traversal of :func:`_batch_has_prefill`.  ``None`` when\\n    unavailable (profiling / warmup).\\\"\\\"\\\"\\n    am = getattr(fctx, \\\"attn_metadata\\\", None)\\n    if am is None:\\n        return None\\n    if isinstance(am, (list, tuple)):\\n        am = am[0] if am else None\\n    if isinstance(am, dict):\\n        am = next(iter(am.values()), None)\\n    return am\\n\\n\\ndef _kv_block_valid_tokens(fctx, num_dedicated: int, num_primary,\\n                           block_size: int) -> dict:\\n    \\\"\\\"\\\"Map offload ``buffer_id -> valid (written) token count`` for the *tail*\\n    (partial) block of each scheduled request, from vLLM ``attn_metadata``.\\n\\n    Only tail blocks can be partial — every earlier block of a sequence is\\n    full (``block_size`` tokens) and is left out of the map (the compressor\\n    defaults missing ids to full).  vLLM's ``on_tail_block`` callback offloads\\n    exactly these tail blocks every step, so this is the set the P4Flat\\n    occupancy encoder benefits from.\\n\\n    Returns ``{}`` on any failure so the caller transparently falls back to\\n    full-block compression (no crash, no behaviour change).\\\"\\\"\\\"\\n    try:\\n        import torch  # local — keep module import cost off the cold path\\n        am = _attn_metadata(fctx)\\n        if am is None:\\n            return {}\\n        seq_lens = getattr(am, \\\"seq_lens\\\", None)\\n        block_table = getattr(am, \\\"block_table\\\", None)\\n        if seq_lens is None or block_table is None or block_size <= 0:\\n            return {}\\n        qsl = getattr(am, \\\"query_start_loc\\\", None)\\n        n_req = (qsl.numel() - 1) if qsl is not None else seq_lens.shape[0]\\n        n_req = int(min(n_req, seq_lens.shape[0], block_table.shape[0]))\\n        if n_req <= 0:\\n            return {}\\n        dev = block_table.device\\n        sl = seq_lens[:n_req].to(torch.int64)\\n        nb = (sl + (block_size - 1)) // block_size          # blocks per seq\\n        rem = sl - (nb - 1) * block_size                    # tail valid (1..bs)\\n        max_idx = block_table.shape[1] - 1\\n        tail_idx = (nb - 1).clamp(min=0, max=max_idx).to(dev)\\n        ar = torch.arange(n_req, device=dev)\\n        tail_phys = block_table[ar, tail_idx]               # [n_req] gather\\n        # Single small D2H each (n_req scalars).\\n        sl_l = sl.tolist()\\n        rem_l = rem.tolist()\\n        tp_l = tail_phys.to(\\\"cpu\\\").tolist()\\n        out = {}\\n        for i in range(n_req):\\n            if sl_l[i] <= 0:\\n                continue\\n            r = rem_l[i]\\n            if r >= block_size:        # full tail → leave default (full)\\n                continue\\n            bid = int(tp_l[i]) - num_dedicated\\n            if num_primary is not None and not (0 <= bid < num_primary):\\n                continue\\n            prev = out.get(bid)\\n            out[bid] = r if prev is None else min(prev, r)\\n        return out\\n    except Exception:\\n        return {}\\n\\n\\ndef before_model_forward(self, input):\\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\\n    from tiered_serve.kv_cache import vLLMKVCache\\n\\n    dm_loader: DualMemoryLoader = getattr(self, \\\"cache_loader\\\", None)\\n    if torch.cuda.is_current_stream_capturing():\\n        return\\n    if dm_loader.is_profiling or dm_loader.is_graph_warming_up:\\n        return\\n    torch.cuda.nvtx.range_push(\\\"BEFORE_MODEL_FORWARD\\\")\\n    dm_loader.did_skip = False\\n    dm_loader.prefill_kv_comp_load_layers = 0\\n    dm_loader._raw_prefill_end_joined = False\\n    # Clear the per-forward idempotency flag so calc_times runs once\\n    # for this forward (either from v1_cuda_graph_wrapper's\\n    # _do_after_model_forward or from after_model_forward, whichever\\n    # fires first — typically the wrapper).\\n    dm_loader._calc_times_done = False\\n    # Reset foreground ZipServ join counters exactly once per model forward.\\n    # Layer-0 resets are unsafe because unload(0) can run after decode(0) and\\n    # erase a real wait from the same step.\\n    _kv_compressor = getattr(dm_loader, \\\"kv_compressor\\\", None)\\n    if (_kv_compressor is not None\\n            and getattr(_kv_compressor, \\\"_cpu_profile_enabled\\\", False)):\\n        _kv_compressor.reset_cpu_profile_step()\\n\\n    # V1: plain forward (no CUDA graph) means prefill\\n    from vllm.forward_context import get_forward_context\\n    fctx = get_forward_context()\\n    if hasattr(fctx, 'cudagraph_runtime_mode'):\\n        from vllm.config import CUDAGraphMode\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader as _DML\\n        # ran_eager: did THIS forward run eager (no CUDA graph)?  Used ONLY\\n        # to choose which stream the forward-timing events get recorded on\\n        # (eager => current/exec_stream, graph => replay_stream).  This is a\\n        # stream/execution property, NOT a prefill signal.\\n        _DML.ran_eager = (\\n            fctx.cudagraph_runtime_mode == CUDAGraphMode.NONE)\\n        # batch_has_prefill: does the batch contain ANY prefill chunk\\n        # (attn_metadata.max_query_len > 1)?  Single source of truth for\\n        # every prefill-vs-decode decision (weight path, KV path, breakdown\\n        # labels).  Unlike ran_eager it is True even for a prefill chunk\\n        # running under a PIECEWISE graph.  Falls back to ran_eager when\\n        # attn_metadata is unavailable (profiling/warmup).\\n        _DML.batch_has_prefill = _batch_has_prefill(\\n            fctx, default=_DML.ran_eager)\\n        # Batch token count — drives the prefill weight-codec choice.\\n        _DML.cur_num_tokens = _num_batch_tokens(fctx, default=1)\\n        # load_comp_weight: load compressed weights (decode) vs the\\n        # uncompressed DRAM copy (prefill).  The V0 path set this in\\n        # vllm/core/scheduler.py (patches/vllm.patch) from the token budget;\\n        # that scheduler never runs under V1, so without this the flag stayed\\n        # pinned at its init value (== use_weight_comp) and prefill always took\\n        # the compressed path — the uncompressed weight load was never\\n        # triggered.  Re-derive it here from the V1-native prefill signal:\\n        # compress only on pure-decode batches, load uncompressed whenever the\\n        # batch contains any prefill chunk.\\n        _DML.load_comp_weight = (\\n            _DML.use_weight_comp and not _DML.batch_has_prefill)\\n\\n    if dm_loader.kv_load_metrics is not None:\\n        dm_loader.kv_load_metrics.begin_forward(\\n            dm_loader.batch_has_prefill, dm_loader.cur_num_tokens)\\n\\n    # Save the original stream so after_model_forward can restore it.\\n    # exec_stream must wait for pending work on the current stream\\n    # (e.g. input preparation) before we switch.\\n    dm_loader._prev_stream = torch.cuda.current_stream()\\n    dm_loader.exec_stream.wait_stream(dm_loader._prev_stream)\\n    torch.cuda.set_stream(dm_loader.exec_stream)\\n\\n    if DualMemoryLoader.use_kv_comp:\\n        # Publish the canonical active set once per forward.  CD3 uses the\\n        # held list identity plus a content version to skip an O(N) active-set\\n        # comparison in every layer; codecs without this optional hook retain\\n        # their existing path unchanged.\\n        kc = getattr(dm_loader, \\\"kv_compressor\\\", None)\\n        prepare_active = getattr(kc, \\\"prepare_active_set\\\", None)\\n        if prepare_active is not None:\\n            prepare_active(\\n                dm_loader.active_kv_buffer_ids,\\n                dm_loader.np_active_kv_buffer_ids,\\n            )\\n        # Publish the per-step occupancy map for the P4Flat KV compressor\\n        # (only when occupancy mode is enabled).  Replaced (not mutated) each\\n        # step so in-flight compress workers keep their own step's snapshot.\\n        if kc is not None and getattr(kc, \\\"_occupancy_enabled\\\", False):\\n            bs = (DualMemoryLoader.primary_k_caches[0].shape[1]\\n                  if hasattr(DualMemoryLoader, \\\"primary_k_caches\\\")\\n                  and DualMemoryLoader.primary_k_caches else 0)\\n            kc._block_valid_tokens = _kv_block_valid_tokens(\\n                fctx, DualMemoryLoader.num_dedicated_blocks, num_primary, bs)\\n        dm_loader.prepare_decomp_kv()\\n        torch.cuda.nvtx.range_pop()  # BEFORE_MODEL_FORWARD\\n\\n\\ndef after_model_forward(self, input, result):\\n    dm_loader: DualMemoryLoader = getattr(self, \\\"cache_loader\\\", None)\\n    if torch.cuda.is_current_stream_capturing():\\n        return\\n    if dm_loader.is_profiling or dm_loader.is_graph_warming_up:\\n        return\\n    raw_load_kv_stream = dm_loader.raw_load_kv_stream\\n    if (not dm_loader._raw_prefill_end_joined\\n            and raw_load_kv_stream is not dm_loader.load_kv_stream\\n            and dm_loader._prefill_uses_dedicated_raw_kv_stream()):\\n        # V0/fallback counterpart of the V1 wrapper's end-of-forward join.\\n        # wait_stream is asynchronous on the CPU; it only orders subsequent\\n        # block reuse behind the final wraparound raw KV read.\\n        torch.cuda.current_stream().wait_stream(raw_load_kv_stream)\\n        dm_loader._raw_prefill_end_joined = True\\n    if dm_loader.ran_eager:\\n        dm_loader.end_forward_event.record()\\n    else:\\n        dm_loader.end_forward_event.record(dm_loader.replay_stream)\\n\\n    # Restore the original stream so that subsequent vLLM code\\n    # (e.g. _update_states, scheduler) runs on the expected stream.\\n    prev = getattr(dm_loader, '_prev_stream', None)\\n    if prev is not None:\\n        prev.wait_stream(dm_loader.exec_stream)\\n        torch.cuda.set_stream(prev)\\n        dm_loader._prev_stream = None\\n\\n    if getattr(dm_loader, \\\"collect_times\\\", False):\\n        torch.cuda.current_stream().synchronize()\\n        dm_loader.load_weight_stream.synchronize()\\n        dm_loader.load_kv_stream.synchronize()\\n        if dm_loader.raw_load_kv_stream is not dm_loader.load_kv_stream:\\n            dm_loader.raw_load_kv_stream.synchronize()\\n        dm_loader.calc_times(0)\\n    if dm_loader.kv_load_metrics is not None:\\n        dm_loader.kv_load_metrics.finish_forward()\\n\\n\\ndef before_exec_decoder(self, input):\\n    dm_loader: \\\"DualMemoryLoader\\\" = self.cache_loader\\n    kv_cache: vLLMKVCache = self.ts_kv_cache\\n    is_capturing = dm_loader.is_graph_capturing or torch.cuda.is_current_stream_capturing()\\n    record_fn = torch.cuda.Event.record  # external=True events auto-handle graph capture\\n    wait_fn = torch.cuda.Stream.wait_event  # external=True events auto-handle graph capture\\n\\n    if is_capturing:\\n        return\\n\\n    record_fn(dm_loader.begin_exec_events[kv_cache.layer_id],\\n              torch.cuda.current_stream())\\n\\n    if dm_loader.is_profiling or dm_loader.is_graph_warming_up:\\n        return\\n\\n    if logger.isEnabledFor(logging.DEBUG):\\n        if _ENV_V1_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_pop()  # before_replay\\n\\n        if dm._v1_prefill_eager_lookahead_active:\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_push(f\\\"prefetch_before_eager P{idx}\\\")\\n            self._prefetch_frozen_before_eager(\\n                dm, idx, n_graphs, cur_stream)\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # prefetch_before_eager\\n\\n        # Record start of compute for THIS graph piece.\\n        # All barrier waits done, compute about to start.\\n        if do_timing:\\n            dm.begin_exec_events[idx].record(cur_stream)\\n\\n        # ── Compute this piece ──\\n        # PIECEWISE: super().__call__ captures (first time) / replays the\\n        # piece's cudagraph.  NONE: run the inductor-compiled piece eagerly\\n        # via self.runnable (no capture).  Either way the load orchestration\\n        # above + the FX-pass in-graph weight waits keep the GEMMs correct.\\n        if is_none_path:\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_push(f\\\"eager_run G{idx}\\\")\\n            output = self.runnable(*args, **kwargs)\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # eager_run\\n        else:\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_push(f\\\"graph_replay G{idx}\\\")\\n            output = super().__call__(*args, **kwargs)\\n            if _ENV_V1_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # graph_replay\\n\\n        if dm._v1_prefill_eager_lookahead_active:\\n            self._record_prefill_raw_war_for_piece(dm, idx, n_graphs)\\n\\n        # ── Post-replay orchestration ──\\n        if _ENV_V1_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_push(f\\\"after_replay G{idx}\\\")\\n        self._after_replay(dm, idx, n_graphs, n_layers, kv_split)\\n        if _ENV_V1_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_pop()  # after_replay\\n\\n        if (do_timing and not is_none_path\\n                and idx < n_layers and idx < n_graphs - 1):\\n            # The KV-ready wait in _after_replay has completed; the next GPU\\n            # work on current_stream is this layer's eager attention.\\n            dm.begin_kernel_events[5 * idx + 2].record(cur_stream)\\n\\n        # For last graph, no attention follows → record end immediately\\n        if do_timing and idx == n_graphs - 1:\\n            dm.end_exec_events[idx].record(cur_stream)\\n\\n        # ── after_model_forward logic on last graph ──\\n        if idx == n_graphs - 1:\\n            self._do_after_model_forward(dm)\\n\\n        return output\\n\\n    # ------------------------------------------------------------------\\n    # before_model_forward equivalent (called once per forward, at idx=0)\\n    # ------------------------------------------------------------------\\n    @staticmethod\\n    def _do_before_model_forward(dm):\\n        \\\"\\\"\\\"Stream-sync setup before the first piecewise graph runs.\\n\\n        kv_buffer_ids / active_kv_buffer_ids / unload_targets bookkeeping is\\n        already handled by ``torch_hooks.before_model_forward`` (registered\\n        as a forward_pre_hook on the model in immigrant_model_loader.py).\\n        Rebuilding here would wipe that work — it observed an already-cleared\\n        unload_targets and produced an empty kv_buffer_ids, suppressing the\\n        whole KV compress pipeline.  We keep only the wrapper-unique work.\\n        \\\"\\\"\\\"\\n        # Open the per-step NVTX range. Closed by _do_after_model_forward.\\n        if _ENV_FORWARD_NVTX:\\n            torch.cuda.nvtx.range_push(\\\"forward_step\\\")\\n        # Sync loading streams with current stream so they pick up any\\n        # input-prep work that ran on current_stream before model forward.\\n        cur = torch.cuda.current_stream(_cuda_device())\\n        TieredServeCUDAGraphWrapper._cached_stream_wait(\\n            dm, dm.load_weight_stream, cur, \\\"bfm_load_weight\\\")\\n        TieredServeCUDAGraphWrapper._cached_stream_wait(\\n            dm, dm.decomp_weight_stream, cur, \\\"bfm_decomp_weight\\\")\\n        TieredServeCUDAGraphWrapper._cached_stream_wait(\\n            dm, dm.load_kv_stream, cur, \\\"bfm_load_kv\\\")\\n        raw_load_kv_stream = dm.raw_load_kv_stream\\n        if (raw_load_kv_stream is not dm.load_kv_stream\\n                and dm._prefill_uses_dedicated_raw_kv_stream()):\\n            # The previous step's attention may have written a resident tail\\n            # that this prefill will read for rollover. Join the dedicated raw\\n            # stream once per prefill forward; keep pure-decode overhead zero.\\n            TieredServeCUDAGraphWrapper._cached_stream_wait(\\n                dm, raw_load_kv_stream, cur, \\\"bfm_raw_load_kv\\\")\\n        TieredServeCUDAGraphWrapper._cached_stream_wait(\\n            dm, dm.unload_kv_stream, cur, \\\"bfm_unload_kv\\\")\\n        if (getattr(type(dm), \\\"kv_full_block_only\\\", False)\\n                and getattr(dm, \\\"kv_compressor\\\", None) is not None):\\n            # Resident tail rows were last written by attention on the\\n            # execution stream. A completion step may have no persistent\\n            # compressed rows, in which case rollover tail->shared is queued\\n            # directly on batch_decomp_stream without an intervening KV H2D\\n            # event. Join that stream once at the step boundary so its D2D\\n            # source read cannot race the prior step's tail write.\\n            TieredServeCUDAGraphWrapper._cached_stream_wait(\\n                dm,\\n                dm.kv_compressor.batch_decomp_stream,\\n                cur,\\n                \\\"bfm_tail_decomp\\\",\\n            )\\n\\n    # ------------------------------------------------------------------\\n    # after_model_forward equivalent\\n    # ------------------------------------------------------------------\\n    @staticmethod\\n    def _do_after_model_forward(dm):\\n        \\\"\\\"\\\"Replicate the active parts of ``after_model_forward``.\\n        We skip stream switching (V1 stays on current_stream).\\n        \\\"\\\"\\\"\\n        raw_load_kv_stream = dm.raw_load_kv_stream\\n        if (raw_load_kv_stream is not dm.load_kv_stream\\n                and dm._prefill_uses_dedicated_raw_kv_stream()):\\n            # Prefill pipelines L+1 and can leave the wraparound KV0 H2D after\\n            # the last attention piece. Make later block free/reuse and the\\n            # next forward depend on that read without a CPU synchronize.\\n            cur = torch.cuda.current_stream(_cuda_device())\\n            TieredServeCUDAGraphWrapper._cached_stream_wait(\\n                dm, cur, raw_load_kv_stream, \\\"afm_raw_load_kv\\\")\\n            dm._raw_prefill_end_joined = True\\n        dm.end_forward_event.record()\\n\\n        if getattr(dm, \\\"collect_times\\\", False):\\n            # Synchronize to ensure all events across all streams are\\n            # recorded before reading elapsed_time.  Prefill-alt and decode\\n            # record reconstruct events on decomp_weight_stream, while raw\\n            # prefill and compressed staging record readiness on load streams.\\n            # Missing any participating stream makes the first timed step race\\n            # CPU vs GPU and raises\\n            # \\\"Both events must be completed before calculating elapsed\\n            # time.\\\"  unload_kv_stream sits in the same boat.\\n            torch.cuda.current_stream(_cuda_device()).synchronize()\\n            dm.load_weight_stream.synchronize()\\n            dm.decomp_weight_stream.synchronize()\\n            dm.load_kv_stream.synchronize()\\n            if dm.raw_load_kv_stream is not dm.load_kv_stream:\\n                dm.raw_load_kv_stream.synchronize()\\n            dm.unload_kv_stream.synchronize()\\n            dm.calc_times(0)\\n        if dm.kv_load_metrics is not None:\\n            dm.kv_load_metrics.finish_forward()\\n\\n        # Close the per-step NVTX range opened in _do_before_model_forward.\\n        if _ENV_FORWARD_NVTX:\\n            torch.cuda.nvtx.range_pop()  # forward_step\\n\\n    @staticmethod\\n    def _wload_graph_on(dm):\\n        \\\"\\\"\\\"TIERED_SERVE_WLOAD_GRAPH=1: capture the per-piece weight H2D inside\\n        the piece's cudagraph (read once).\\\"\\\"\\\"\\n        return _ENV_WLOAD_GRAPH\\n\\n    @staticmethod\\n    def _frozen_idx_map(dm):\\n        \\\"\\\"\\\"(frozen_idx_map, n_not_frozen) cached on ``dm``.  ``not_frozen_layers``\\n        is run-invariant, so this dict was needlessly rebuilt as a comprehension\\n        2x per graph (before + after replay) = ~160 dict builds/step.  Keyed on\\n    op_func=_wait_frozen_weight_impl,\\n    fake_impl=_wait_frozen_weight_fake,\\n    mutates_args=[\\\"weight\\\"],\\n    target_lib=_lib,\\n)\\n\\n\\ndef _record_weight_compute_end_impl(output: torch.Tensor, layer_id: int,\\n                                    comp_id: int) -> None:\\n    \\\"\\\"\\\"Record the productive projection boundary inside a compiled graph.\\\"\\\"\\\"\\n    try:\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n        dm = getattr(DualMemoryLoader, \\\"_v1_dm_ref\\\", None)\\n        comp = _ID_TO_COMP.get(int(comp_id))\\n        if dm is None or comp is None or not getattr(dm, \\\"collect_times\\\", False):\\n            return\\n        stream = torch.cuda.current_stream(output.device)\\n        kernel_slot = _COMP_TO_KERNEL_SLOT[comp]\\n        dm.end_kernel_events[5 * int(layer_id) + kernel_slot].record(stream)\\n    except Exception:\\n        # Timing must never make model execution fail.\\n        return\\n\\n\\ndef _record_weight_compute_end_fake(output: torch.Tensor, layer_id: int,\\n                                    comp_id: int) -> None:\\n    return\\n\\n\\n# The op has no tensor result, so declare a (logical-only) mutation to retain\\n# it through DCE and keep it ordered after the projection producing ``output``.\\ndirect_register_custom_op(\\n    op_name=\\\"record_weight_compute_end\\\",\\n    op_func=_record_weight_compute_end_impl,\\n    fake_impl=_record_weight_compute_end_fake,\\n    mutates_args=[\\\"output\\\"],\\n    target_lib=_lib,\\n)\\n\\n\\n_COMP_SUBSTR = (\\n    (\\\"self_attn_modules_qkv_proj\\\", \\\"qkv\\\"),\\n    (\\\"self_attn_modules_o_proj\\\", \\\"o\\\"),\\n    (\\\"mlp_modules_gate_up_proj\\\", \\\"gate_up\\\"),\\n    (\\\"mlp_modules_down_proj\\\", \\\"down\\\"),\\n    # Looser variants seen in post-grad get_attr / placeholder names across\\n    # torch/vLLM versions (module-path mangling differs).\\n    (\\\"qkv_proj\\\", \\\"qkv\\\"),\\n    (\\\"o_proj\\\", \\\"o\\\"),\\n    (\\\"gate_up_proj\\\", \\\"gate_up\\\"),\\n    (\\\"down_proj\\\", \\\"down\\\"),\\n)\\n\\n\\ndef component_from_weight_name(name: str) -> tuple[int, str] | None:\\n    \\\"\\\"\\\"Best-effort (layer_id, comp) extraction from a weight node name.\\n\\n    Tries the strict Dynamo get_attr mangling first, then a looser fallback\\n    that just needs a ``layers.<N>`` index and one of the four projection\\n    substrings somewhere in the name.  Returns None if neither matches.\\n    \\\"\\\"\\\"\\n    match = _LAYER_RE.search(name)\\n    if match is not None:\\n        layer_id = int(match.group(1))\\n        path = match.group(2)\\n        for sub, comp in _COMP_SUBSTR:\\n            if sub in path:\\n                return layer_id, comp\\n\\n    # Looser fallback.\\n    lm = _LAYER_NUM_RE.search(name)\\n    if lm is None:\\n        return None\\n    layer_id = int(lm.group(1))\\n    for sub, comp in _COMP_SUBSTR:\\n        if sub in name:\\n            return layer_id, comp\\n    return None\\n\\n\\ndef _is_linear_like(node) -> tuple[bool, int]:\\n    \\\"\\\"\\\"Return (is_linear, weight_arg_idx) for a call_function node.\\n\\n    Post-grad graphs have linear decomposed to aten.mm / aten.addmm /\\n    aten._scaled_mm (FP8); pre-grad may still carry aten.linear.  Weight is\\n    args[1] for mm/_scaled_mm/linear and args[2] for addmm (bias, input, w).\\n    \\\"\\\"\\\"\\n    if node.op != \\\"call_function\\\":\\n        return False, -1\\n    target = node.target\\n    target_name = getattr(target, \\\"name\\\", lambda: str(target))()\\n    if target_name == \\\"aten::addmm\\\":\\n        return (len(node.args) >= 3), 2\\n    if target_name in (\\\"aten::linear\\\", \\\"aten::mm\\\", \\\"aten::_scaled_mm\\\") \\\\\\n            or target is torch._C._nn.linear \\\\\\n            or \\\"built-in function linear\\\" in str(target):\\n        return (len(node.args) >= 2), 1\\n    return False, -1\\n\\n\\ndef insert_frozen_weight_waits(graph_or_gm) -> int:\\n    \\\"\\\"\\\"Insert a per-component ``wait_frozen_weight`` op before each projection\\n    GEMM so the wait is baked into the captured graph.\\n\\n    Accepts either a ``torch.fx.Graph`` (vLLM ``post_grad_custom_post_pass``\\n    calling convention) or a ``torch.fx.GraphModule``.  Runs once per\\n    piecewise subgraph, so it is invoked many times; the totals are\\n    accumulated on ``DualMemoryLoader._v1_weight_waits_inserted`` and gate the\\n    wrapper's coarse-wait fallback.\\n    \\\"\\\"\\\"\\n    import logging\\n\\n    logger = logging.getLogger(\\\"vllm\\\")\\n\\n    if isinstance(graph_or_gm, torch.fx.GraphModule):\\n        graph = graph_or_gm.graph\\n        owner_gm = graph_or_gm\\n    else:\\n        graph = graph_or_gm\\n        owner_gm = None\\n\\n    inserted = 0\\n    linear_seen = 0\\n    unmatched = []  # (target_name, weight_node_name, weight_node_op)\\n    for node in list(graph.nodes):\\n        is_lin, weight_arg_idx = _is_linear_like(node)\\n        if not is_lin:\\n            continue\\n        linear_seen += 1\\n        weight_arg = node.args[weight_arg_idx]\\n        if not isinstance(weight_arg, torch.fx.Node):\\n            continue\\n        # get_attr nodes carry the qualified param path in .target; placeholder\\n        # / other nodes only in .name — try both.\\n        cand_names = [weight_arg.name]\\n        if isinstance(getattr(weight_arg, \\\"target\\\", None), str):\\n            cand_names.append(weight_arg.target)\\n        parsed = None\\n        for nm in cand_names:\\n            parsed = component_from_weight_name(nm)\\n            if parsed is not None:\\n                break\\n        if parsed is None:\\n            if len(unmatched) < 8:\\n                tname = getattr(node.target, \\\"name\\\",\\n                                lambda: str(node.target))()\\n                unmatched.append((tname, weight_arg.name, weight_arg.op))\\n            continue\\n        layer_id, comp = parsed\\n        with graph.inserting_before(node):\\n            graph.call_function(\\n                torch.ops.tiered_serve.wait_frozen_weight.default,\\n                args=(weight_arg, layer_id, _COMP_TO_ID[comp]),\\n            )\\n        with graph.inserting_after(node):\\n            graph.call_function(\\n                torch.ops.tiered_serve.record_weight_compute_end.default,\\n                args=(node, layer_id, _COMP_TO_ID[comp]),\\n            )\\n        # Don't replace the GEMM's weight arg. The wait op is a side-effect\\n        # barrier — declaring `mutates_args=[\\\"weight\\\"]` prevents DCE and\\n        # forces the op to run before any subsequent op that reads `weight`.\\n        inserted += 1\\n\\n    if inserted:\\n        graph.lint()\\n        if owner_gm is not None:\\n            owner_gm.recompile()\\n\\n    # Observability: this pass is unverifiable without a real compile, so make\\n    # the match outcome loud.  inserted==0 while linear_seen>0 means the\\n    # weight-node naming didn't match — the dumped sample shows what to tune.\\n    if inserted == 0 and linear_seen > 0:\\n        logger.warning(\\n            \\\"[ts-fx-wait] 0/%d linear nodes matched for weight-wait \\\"\\n            \\\"insertion; weight-node naming unrecognized. Samples \\\"\\n            \\\"(gemm, weight_name, weight_op): %s\\\",\\n            linear_seen, unmatched)\\n    else:\\n        logger.info(\\n            \\\"[ts-fx-wait] inserted %d weight-wait op(s) over %d linear \\\"\\n            \\\"node(s) in this piece\\\", inserted, linear_seen)\\n\\n    # Accumulate + flip the wrapper's per-component path on, so coarse\\n    # per-piece waits are skipped only when in-graph waits actually exist.\\n    try:\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n        DualMemoryLoader._v1_weight_waits_inserted = (\\n            getattr(DualMemoryLoader, \\\"_v1_weight_waits_inserted\\\", 0)\\n      