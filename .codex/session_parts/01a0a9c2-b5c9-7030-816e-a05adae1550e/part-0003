\\\")\\n\\n\\ndef analyze(intervals, total_ms, *, complete):\\n    \\\"\\\"\\\"Sweep half-open intervals, preserving concurrent activities as a state.\\n\\n    Startup ends at the first productive marker. Drain starts at the later\\n    of that boundary and the last load end, making the three regions disjoint\\n    even when all transfers finish before compute starts. With no loads,\\n    compute after startup belongs to drain. Missing productive markers leave\\n    region boundaries unavailable, rather than inventing a pipeline tail.\\n    \\\"\\\"\\\"\\n    productive = [r[\\\"begin_ms\\\"] for r in intervals if r[\\\"activity\\\"] == \\\"PRODUCTIVE\\\"]\\n    loads = [r[\\\"end_ms\\\"] for r in intervals if r[\\\"activity\\\"] == \\\"LOAD\\\"]\\n    first = min(productive) if productive else None\\n    last = max(loads) if loads else None\\n    drain = max(first, last or 0.0) if first is not None else None\\n    events = defaultdict(list)\\n    events[0.0]\\n    events[total_ms]\\n    if first is not None:\\n        events[first]\\n        events[drain]\\n    for row in intervals:\\n        if row[\\\"activity\\\"] not in (\\\"LOAD\\\", *COMPUTE):\\n            continue\\n        key = (row[\\\"layer\\\"], row[\\\"activity\\\"], row[\\\"component\\\"])\\n        events[row[\\\"begin_ms\\\"]].append((key, 1))\\n        events[row[\\\"end_ms\\\"]].append((key, -1))\\n\\n    active = Counter()\\n    activities = defaultdict(lambda: [0.0, 0.0])\\n    states = defaultdict(float)\\n    totals = {key: 0.0 for key in COLUMNS[\\\"steps\\\"][4:]}\\n    times = sorted(events)\\n    for index, begin in enumerate(times[:-1]):\\n        for key, delta in events[begin]:\\n            active[key] += delta\\n            if not active[key]:\\n                del active[key]\\n        duration = times[index + 1] - begin\\n        region = (\\\"unknown\\\" if first is None else \\\"startup\\\" if begin < first\\n                  else \\\"middle\\\" if begin < drain else \\\"drain\\\")\\n        kinds = {key[1] for key in active}\\n        load = \\\"LOAD\\\" in kinds\\n        compute = bool(kinds.intersection(COMPUTE))\\n        bucket = (\\\"overlap_ms\\\" if load and compute else \\\"load_only_ms\\\" if load\\n                  else \\\"compute_only_ms\\\" if compute else \\\"unclassified_ms\\\")\\n        totals[bucket] += duration\\n        if region != \\\"unknown\\\" and bucket in (\\\"load_only_ms\\\", \\\"compute_only_ms\\\"):\\n            totals[f\\\"{region}_{bucket}\\\"] += duration\\n        state = \\\"+\\\".join(k for k in (\\\"LOAD\\\", *COMPUTE) if k in kinds) or \\\"UNCLASSIFIED\\\"\\n        states[region, state] += duration\\n        for layer, activity, component in active:\\n            values = activities[region, layer, activity, component]\\n            values[0] += duration\\n            if (activity == \\\"LOAD\\\" and not compute) or (activity in COMPUTE and not load):\\n                values[1] += duration\\n\\n    # Incomplete coverage must not masquerade as exclusive wall time.\\n    activity_rows = [dict(region=k[0], layer=k[1], activity=k[2], component=k[3],\\n                          active_ms=v[0], only_ms=v[1] if complete else None)\\n                     for k, v in sorted(activities.items())]\\n    state_rows = [dict(region=k[0], state=k[1], duration_ms=v)\\n                  for k, v in sorted(states.items())] if complete else []\\n    if not complete:\\n        totals = dict.fromkeys(totals)\\n    elif first is None:\\n        for key in totals:\\n            if key.startswith((\\\"startup_\\\", \\\"middle_\\\", \\\"drain_\\\")):\\n                totals[key] = None\\n    return activity_rows, state_rows, dict(\\n        gpu_fwd_ms=total_ms, complete=int(complete), first_productive_ms=first,\\n        last_load_ms=last, **totals)\\n\\n\\ndef consumer_waits(intervals):\\n    \\\"\\\"\\\"Join wait starts to observed prerequisite completion in this forward.\\n\\n    Producer timing markers approximate readiness; they are not the sync-only\\n    barrier itself. In-graph fallback decode after the wait is not a prerequisite\\n    of that wait. Missing producers (e.g. resident weights) remain unavailable.\\n    Signed lateness measures this local consumer dependency, not causal GPU idle.\\n    \\\"\\\"\\\"\\n    producers = defaultdict(list)\\n    for row in intervals:\\n        if row[\\\"activity\\\"] in (\\\"LOAD\\\", \\\"WDECOMP\\\", \\\"KVDECOMP\\\"):\\n            if row[\\\"source\\\"] == \\\"fused_fallback\\\":\\n                continue\\n            producers[row[\\\"layer\\\"], row[\\\"component\\\"]].append(row)\\n    result = []\\n    for row in intervals:\\n        if row[\\\"activity\\\"] != \\\"WAIT\\\":\\n            continue\\n        need, end = row[\\\"begin_ms\\\"], row[\\\"end_ms\\\"]\\n        candidates = [p for p in producers[row[\\\"layer\\\"], row[\\\"component\\\"]]\\n                      if p[\\\"end_ms\\\"] <= end]\\n        producer = max(candidates, key=lambda p: p[\\\"end_ms\\\"], default=None)\\n        ready = producer[\\\"end_ms\\\"] if producer else None\\n        result.append(dict(\\n            layer=row[\\\"layer\\\"], component=row[\\\"component\\\"], need_ms=need,\\n            wait_end_ms=end, wait_ms=end - need, ready_ms=ready,\\n            lateness_ms=ready - need if ready is not None else None,\\n            slack_ms=max(0.0, need - ready) if ready is not None else None,\\n            ready_source=producer[\\\"source\\\"] if producer else \\\"unavailable\\\"))\\n    return result\\n\\n\\nclass BreakdownWriter:\\n    \\\"\\\"\\\"Flush all tables once per forward; keep no run-long per-layer history.\\\"\\\"\\\"\\n\\n    def __init__(self, directory, suffix):\\n        self.directory = Path(directory)\\n        self.directory.mkdir(parents=True, exist_ok=True)\\n        self.files = {}\\n        self.writers = {}\\n        for name, columns in COLUMNS.items():\\n            file = open(self.directory / f\\\"breakdown_{name}.{suffix}.csv\\\", \\\"w\\\")\\n            self.files[name] = file\\n            writer = csv.DictWriter(file, fieldnames=CONTEXT + columns)\\n            writer.writeheader()\\n            self.writers[name] = writer\\n        atexit.register(self.close)\\n\\n    def write(self, context, intervals, total_ms, *, complete):\\n        activity, states, step = analyze(intervals, total_ms, complete=complete)\\n        tables = dict(intervals=intervals, activity=activity, states=states,\\n                      waits=consumer_waits(intervals), steps=[step])\\n        prefix = {key: context[key] for key in CONTEXT}\\n        for name, rows in tables.items():\\n            self.writers[name].writerows(\\n                {key: \\\"NA\\\" if value is None else value\\n                 for key, value in dict(prefix, **row).items()} for row in rows)\\n            self.files[name].flush()\\n        return step\\n\\n    def close(self):\\n        for file in self.files.values():\\n            file.close()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Average diagnostic interval tables by config, batch and phase (all forwards).\\\"\\\"\\\"\\nimport argparse\\nimport csv\\nfrom collections import Counter, defaultdict\\nfrom pathlib import Path\\n\\n\\nGROUP = (\\\"config\\\", \\\"batch\\\", \\\"phase\\\")\\n\\n\\ndef records(paths):\\n    for path in paths:\\n        with path.open() as file:\\n            yield from csv.DictReader(file)\\n\\n\\ndef write(path, fields, rows):\\n    with path.open(\\\"w\\\") as file:\\n        writer = csv.DictWriter(file, fieldnames=fields)\\n        writer.writeheader()\\n        writer.writerows(rows)\\n\\n\\ndef summarize(directory):\\n    directory = Path(directory)\\n    steps = list(records(sorted(directory.glob(\\\"breakdown_steps.*.csv\\\"))))\\n    if not steps:\\n        raise ValueError(f\\\"no completed forward interval records in {directory}\\\")\\n    count = Counter(tuple(r[k] for k in GROUP) for r in steps)\\n    valid = Counter(tuple(r[k] for k in GROUP) for r in steps if r[\\\"complete\\\"] == \\\"1\\\")\\n    metrics = [k for k in steps[0] if k.endswith(\\\"_ms\\\")]\\n    sums, samples = defaultdict(Counter), defaultdict(Counter)\\n    for row in steps:\\n        group = tuple(row[k] for k in GROUP)\\n        for metric in metrics:\\n            if row[metric] != \\\"NA\\\":\\n                sums[group][metric] += float(row[metric])\\n                samples[group][metric] += 1\\n    step_rows = []\\n    for group in sorted(count):\\n        row = dict(zip(GROUP, group), forwards=count[group], complete_forwards=valid[group])\\n        row.update({\\\"mean_\\\" + k: sums[group][k] / samples[group][k]\\n                    if samples[group][k] else \\\"NA\\\" for k in metrics})\\n        step_rows.append(row)\\n    write(directory / \\\"interval_summary.csv\\\",\\n          (*GROUP, \\\"forwards\\\", \\\"complete_forwards\\\", *(\\\"mean_\\\" + k for k in metrics)), step_rows)\\n\\n    # Activity and exact-state sums use complete forwards as the denominator.\\n    # Absent activity in an otherwise complete forward contributes zero.\\n    for table, dimensions, values in (\\n            (\\\"activity\\\", (\\\"region\\\", \\\"layer\\\", \\\"activity\\\", \\\"component\\\"), (\\\"active_ms\\\", \\\"only_ms\\\")),\\n            (\\\"states\\\", (\\\"region\\\", \\\"state\\\"), (\\\"duration_ms\\\",))):\\n        fields = GROUP + dimensions\\n        totals = defaultdict(Counter)\\n        for row in records(sorted(directory.glob(f\\\"breakdown_{table}.*.csv\\\"))):\\n            if table == \\\"activity\\\" and row[\\\"only_ms\\\"] == \\\"NA\\\":\\n                continue\\n            key = tuple(row[k] for k in fields)\\n            for value in values:\\n                totals[key][value] += float(row[value])\\n        rows = []\\n        for key in sorted(totals):\\n            n = valid[key[:len(GROUP)]]\\n            rows.append(dict(zip(fields, key), complete_forwards=n,\\n                             **{\\\"mean_\\\" + v: totals[key][v] / n for v in values}))\\n        write(directory / f\\\"interval_{table}_summary.csv\\\",\\n              (*fields, \\\"complete_forwards\\\", *(\\\"mean_\\\" + v for v in values)), rows)\\n    return step_rows\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"directory\\\", type=Path)\\n    args = parser.parse_args()\\n    try:\\n        rows = summarize(args.directory)\\n    except ValueError as error:\\n        parser.exit(1, f\\\"{error}\\\\n\\\")\\n    print(f\\\"Interval breakdown summary: {args.directory / 'interval_summary.csv'}\\\")\\n    for row in rows:\\n        print(\\\"[Intervals] \\\" + \\\" \\\".join(f\\\"{key}={value}\\\" for key, value in row.items()))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0a9c2-f935-7412-a1bb-3e1f203faa17","create_time":1789555241.0794291}}}
