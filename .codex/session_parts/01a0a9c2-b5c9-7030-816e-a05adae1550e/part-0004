t_kv_idx\\n            load_kv_stream = dm._kv_load_stream_for(decode_tgt)\\n            if not load_only_kv:\\n                cur_nf = frozen_idx_map[graph_idx]\\n                nxt_nf = (cur_nf + 1) % n_not_frozen\\n                target_decoder_idx = dm.not_frozen_layers[nxt_nf]\\n\\n        # ── V1 only: record unloaded_kv for PREVIOUS layer ──\\n        # In V0, unloaded_kv[k] is recorded on replay_stream right after\\n        # graph replay (which includes attention k).  In V1, attention k\\n        # runs on current_stream AFTER wrapper_k returns.  So we record\\n        # unloaded_kv[k-1] here in wrapper_k.before_replay, because\\n        # attention k-1 has already completed on current_stream by now.\\n        if idx > 0 and idx < n_graphs:\\n            prev_attn_layer = idx - 1\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_push(f\\\"brp_unload L{prev_attn_layer}\\\")\\n            dm.unloaded_kv[prev_attn_layer].record(cur_stream)\\n            dm.unload_kv_barriers[prev_attn_layer].record(cur_stream)\\n\\n            # Wait until attention on compute stream finishes reading KV\\n            dm.unload_kv_stream.wait_event(\\n                dm.unload_kv_barriers[prev_attn_layer])\\n\\n            # Start KV unload for previous layer\\n            dm.unload_kv_mp(\\n                prev_attn_layer,\\n                dm.unload_kv_ipc_handles[prev_attn_layer],\\n            )\\n            if _ENV_OFF_MP_UNLOAD:\\n                dm.unload_kv_stream.wait_event(\\n                    dm.unloaded_kv[prev_attn_layer])\\n                dm.unload_kv(prev_attn_layer)\\n                dm.unloaded_kv[prev_attn_layer].record(\\n                    dm.unload_kv_stream)\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # brp_unload\\n\\n            # With one shared decode buffer, unload(k-1)'s D2H reads the same\\n            # storage that attention(k) will overwrite, so the compute stream\\n            # must wait for the read to finish.  On the dense-decode path with\\n            # parity >= 2, k and k-1 use disjoint buffers; the real same-parity\\n            # WAR (decode(L) versus unload(L-P)) is already gated on\\n            # batch_decomp_stream in KVMixin.start_kv_decompress.  Retaining\\n            # this legacy L-1 gate there needlessly puts every D2H on the graph\\n            # critical path.\\n            if dm.use_kv_comp and kv_parity == 1:\\n                cur_stream.wait_event(dm.kv_unload_done[prev_attn_layer])\\n\\n        # ── Pipeline: load NEXT layer's QKV weights + KV cache ──\\n        if include_attn:\\n            # Load QKV weights for next non-frozen layer\\n            if not load_only_kv:\\n                if _ENV_V1_DETAILED_NVTX:\\n                    torch.cuda.nvtx.range_push(\\n                        f\\\"brp_qkv_load L{target_decoder_idx}\\\")\\n                for _ in range(tp_iters):\\n                    dm.load_self_attn_qkv_weight(target_decoder_idx)\\n                    barrier = dm.exec_qkv_barriers[target_decoder_idx]\\n                    if not use_weight_comp:\\n                        barrier.record(load_weight_stream)\\n                    else:\\n                        barrier.record(decomp_weight_stream)\\n                if _ENV_V1_DETAILED_NVTX:\\n                    torch.cuda.nvtx.range_pop()  # brp_qkv_load\\n\\n            # Signal that QKV loading is done -> KV stream can start.\\n            # KV_H2D_ON_WEIGHT aliases load_kv_stream to load_weight_stream for\\n            # the KVCOMP path ONLY (the kv-unload gate below is skipped there, so\\n            # nothing KV-dependent precedes the weight prefetch on the shared\\n            # stream).  The RAW path always keeps a SEPARATE load_kv_stream — its\\n            # unload gate (line ~631) waits on the prev attention, and aliasing\\n            # would stall the weight prefetch behind it.  So this record+wait is\\n            # real ordering for raw (separate streams) and a no-op self-order for\\n            # kvcomp (same stream) — the identity check picks the right one.\\n            if load_kv_stream is not load_weight_stream:\\n                barrier = dm.load_kv_barriers[decode_tgt]\\n                barrier.record(load_weight_stream)\\n                load_kv_stream.wait_event(barrier)\\n\\n            # Wait for previous layer's KV to be fully unloaded — RAW path only.\\n            # The gate makes the KV LOAD wait for the prev layer's unload to\\n            # finish reading the SHARED decode buffer before the load overwrites\\n            # it.  That is real for RAW (target_cache.load writes the shared\\n            # buffer directly), but for KVCOMP the \\\"load\\\" is just the compressed\\n            # blob H2D into the STAGING blob — it never touches the shared decode\\n            # buffer.  The shared-buffer writer for dense KVCOMP decode is the\\n            # decode kernel on batch_decomp_stream, and start_kv_decompress gates\\n            # it on the exact same-parity unload(L-P).  Ordering versus the prior\\n            # attention is automatic (decode(L+1) follows attention(L) in exec\\n            # program order).  So this load-stream gate is a raw-path leftover\\n            # for KVCOMP, and under the single-stream H2D-on-weight layout it\\n            # needlessly stalls the WEIGHT H2D queued behind the KV on the same\\n            # stream (measured Stall 68→12 ms, TPOT 264→211 ms when removed).\\n            # Skip it for KVCOMP decode.\\n            prev_kv_idx = (decode_tgt - kv_parity + n_layers) % n_layers\\n            if not dm.use_kv_comp:\\n                load_kv_stream.wait_event(dm.unloaded_kv[prev_kv_idx])\\n            elif not dm._uses_compressed_kv_load(decode_tgt):\\n                # Raw H2D writes the shared dense cache directly.  Protect it\\n                # from the prior same-parity offload reader.  Persistent\\n                # compressed H2D writes only a staging blob; its later dense\\n                # decode is gated on kv_unload_done in start_kv_decompress.\\n                load_kv_stream.wait_event(dm.kv_unload_done[prev_kv_idx])\\n\\n        # ── Split-phase KV decompress ──\\n        kv_split = False\\n        if include_attn:\\n            if _ENV_KV_CPU_PROFILE:\\n                # Optional CPU dispatch probe; keep it off in throughput runs\\n                # because this hook is on the per-graph launch path.\\n                _dec_t0 = time.perf_counter()\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_push(f\\\"brp_kv_decomp L{decode_tgt}\\\")\\n            kv_split = dm.start_kv_decompress(decode_tgt)\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()  # brp_kv_decomp\\n            if _ENV_KV_CPU_PROFILE:\\n                self._brp_dec = getattr(self, \\\"_brp_dec\\\", 0.0) + (\\n                    time.perf_counter() - _dec_t0)\\n                self._brp_n = getattr(self, \\\"_brp_n\\\", 0) + 1\\n                if self._brp_n >= 2000:\\n                    logger.warning(\\n                        \\\"[before_replay] start_kv_decompress CPU: avg %.3f \\\"\\n                        \\\"ms/graph (= %.0f ms/step @~%d graphs)\\\",\\n                        self._brp_dec / self._brp_n * 1e3,\\n                        self._brp_dec / self._brp_n * 1e3 * n_graphs,\\n                        n_graphs)\\n                    self._brp_dec, self._brp_n = 0.0, 0\\n            if not kv_split:\\n                # kv_split=False -> load_kv loaded _decode_tgt (graph_idx under\\n                # JIT, idx+1 otherwise); record THAT layer's attn barrier so its\\n                # attention waits the right load (JIT: was wrongly target_kv_idx).\\n                barrier = dm.exec_attn_barriers[decode_tgt]\\n                # False can mean either raw H2D, or compressed mode with no\\n                # persistent rows (where tail rollover staging is still queued\\n                # on batch_decomp_stream).  Choose by the actual layer policy.\\n                if not dm._uses_compressed_kv_load(decode_tgt):\\n                    barrier.record(load_kv_stream)\\n                else:\\n                    barrier.record(dm.kv_compressor.batch_decomp_stream)\\n\\n        # ── Wait for weights needed by THIS graph's ops ──\\n        # Graph 0: embed + L0 QKV → needs exec_qkv_barriers[0]\\n        # Graph k: L(k-1) O+MLP + L(k) QKV → needs O/MLP barriers for\\n        #          k-1, QKV barrier for k\\n        # Last graph: L(N-1) O+MLP + norm + head → needs O/MLP for N-1\\n        #\\n        # With complete component waits (see\\n        # ``_uses_component_weight_waits``), each GEMM waits for its own\\n        # buffer inside the captured graph, so this coarse per-piece wait is\\n        # redundant and would only serialize the whole piece behind its\\n        # slowest weight.  We still RECORD these barriers above / in\\n        # _after_replay; only the coarse wait is skipped.\\n        if not uses_component_weight_waits:\\n            # Only STREAMED (non-frozen) layers re-record their\\n            # exec_*_barriers each step — the loads above are gated on\\n            # ``not load_only_kv`` and ``target_decoder_idx`` only ever\\n    def _after_replay(self, dm, idx: int, n_graphs: int,\\n                      n_layers: int, kv_split: bool):\\n        \\\"\\\"\\\"Post-replay orchestration.\\n\\n        In V0, this section (after graph.replay()) handles:\\n        1. Finish split-phase KV decompress\\n        2. Record unloaded_kv / unload_kv_barriers (after attn completes)\\n        3. KV unload\\n        4. O+MLP weight loads\\n        5. Record load_qkv_barriers for layer+2\\n\\n        In V1, attention runs AFTER this wrapper returns on current_stream.\\n        So steps 2-3 (which depend on attention completion) are DEFERRED to\\n        wrapper_{k+1}._before_replay.  We handle 1, 4, 5 here.\\n\\n        We DO need to ensure KV for THIS layer is loaded before attention\\n        runs (immediately after this wrapper returns).  So we wait on\\n        exec_attn_barriers[graph_idx] on current_stream.\\n        \\\"\\\"\\\"\\n        skip_frozen_lookahead = dm._v1_prefill_eager_lookahead_active\\n        graph_idx = idx\\n        include_attn = idx < n_graphs - 1\\n        cur_stream = torch.cuda.current_stream(_cuda_device())\\n\\n        load_weight_stream = dm.load_weight_stream\\n        decomp_weight_stream = dm.decomp_weight_stream\\n\\n        tp_iters = _ENV_TP_SIZE\\n        use_weight_comp = dm.use_weight_comp\\n\\n        frozen_idx_map, n_not_frozen = self._frozen_idx_map(dm)\\n\\n        load_only_kv = False\\n        target_decoder_idx = -1\\n        jit_decode_this = False\\n        load_kv_stream = dm.load_kv_stream\\n\\n        if include_attn:\\n            load_only_kv = dm._v1_load_only_kv[graph_idx]\\n            target_kv_idx = (graph_idx + 1) % n_layers\\n            jit_decode_this = self._jit_current_kv(dm)\\n            decode_tgt = (graph_idx if jit_decode_this else target_kv_idx)\\n            load_kv_stream = dm._kv_load_stream_for(decode_tgt)\\n            if not load_only_kv:\\n                cur_nf = frozen_idx_map[graph_idx]\\n                nxt_nf = (cur_nf + 1) % n_not_frozen\\n                target_decoder_idx = dm.not_frozen_layers[nxt_nf]\\n\\n        # ── 1. Finish split-phase KV decompress ──\\n        if kv_split:\\n            # JIT finishes the current layer; non-JIT finishes the prefetched\\n            # next layer.  In both cases the barrier must be recorded *after*\\n            # finish launches the decode kernels, not after start's H2D only.\\n            target_kv_local = (graph_idx if jit_decode_this\\n                               else (graph_idx + 1) % n_layers)\\n            dm.finish_kv_decompress(target_kv_local)\\n            barrier = dm.exec_attn_barriers[target_kv_local]\\n            barrier.record(dm.kv_compressor.batch_decomp_stream)\\n\\n        # ── Frozen weight lookahead: keep the decomp/H2D pipeline DEPTH\\n        #    graphs ahead of the graph that will read it ──\\n        # Queue as soon as the current graph is submitted, before any KV wait\\n        # for eager attention, to give the decomp stream + copy engine the\\n        # largest possible window.  Prefetching only +1 (the old behaviour)\\n        # left the big gate_up/down weights with a single attention of lead\\n        # time, so their H2D+decomp spilled into the consuming GEMM; with the\\n        # unified pool's parity-3 buffers we can keep DEPTH(=2) layers in\\n        # flight.  A high-water mark advances one graph per step so each graph\\n        # is scheduled exactly once: _before_replay(0) primes graph 0, then at\\n        # _after_replay(K) we top the pipeline up to graph K+DEPTH.\\n        if (hasattr(dm, \\\"frozen_decomp_event\\\")\\n                and self._can_lookahead_frozen_decomp(dm)\\n                and not self._wload_graph_on(dm)\\n                and not skip_frozen_lookahead):\\n            # WLOAD_GRAPH: each piece's capture prehook issues its own weight\\n            # H2D into its cudagraph, so the eager lookahead prefetch is off.\\n            if graph_idx == 0:\\n                # _before_replay(0) already scheduled graph 0 this step.\\n                dm._frozen_sched_hwm = 0\\n            depth = self._frozen_lookahead_depth(dm)\\n            target = min(graph_idx + depth, n_graphs - 1)\\n            hwm = getattr(dm, \\\"_frozen_sched_hwm\\\", graph_idx)\\n            if target > hwm:\\n                # One cached stream join covers every decomp queued below: each writes\\n                # parity slot g%P whose previous reader is graph(g-P).  Since\\n                # g <= K+DEPTH and DEPTH <= P-1, graph(K) — waited on here — is\\n                # strictly past graph(g-P), so the WAR hazard is safe.\\n                self._cached_stream_wait(\\n    