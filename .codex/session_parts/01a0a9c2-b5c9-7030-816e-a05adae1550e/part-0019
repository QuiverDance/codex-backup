: float(getattr(\n                        _kc, \"_step_cpu_legacy_get_ms\", 0.0)),\n                    \"kv_cpu_legacy_finalize_ms\": float(getattr(\n                        _kc, \"_step_cpu_legacy_finalize_ms\", 0.0)),\n                    \"kv_cpu_fast_candidates\": int(getattr(\n                        _kc, \"_step_cpu_fast_candidates\", 0)),\n                    \"kv_cpu_fast_hits\": int(getattr(\n                        _kc, \"_step_cpu_fast_hits\", 0)),\n                    \"kv_cpu_fast_fallbacks\": int(getattr(\n                        _kc, \"_step_cpu_fast_fallbacks\", 0)),\n                    \"kv_cpu_raw_blocks\": int(getattr(\n                        _kc, \"_step_cpu_raw_blocks\", 0)),\n                })\n            if self.batch_has_prefill:\n                DualMemoryLoader.prefill_breakdowns.append(self.last_breakdown)\n            else:\n                # Stash the per-component stall/load arrays computed in the\n                # decode stall block above so the driver can print one\n                # batch-averaged BarrierWait / ComponentLoad line.\n                self.last_breakdown[\"comp_stall\"] = list(comp_stall)\n                self.last_breakdown[\"attn_barrier_wait\"] = attn_barrier_wait\n                self.last_breakdown[\"weight_stall\"] = weight_stall\n                self.last_breakdown[\"comp_load\"] = list(comp_load)\n                self.last_breakdown[\"kv_load_ms\"] = kv_load_ms\n                DualMemoryLoader.decode_breakdowns.append(self.last_breakdown)\n\n        self.reset_events()\n\n    def _snapshot_layout(self):\n        \"\"\"Prepare stable event metadata once, outside steady-state collection.\n\n        Lazy split pools can grow when a new route first executes. Rebuild when\n        that happens, or when reconfiguration/capture changes the wait target.\n        No CUDA events enter the transport frame; only their numeric IDs do.\n        \"\"\"\n        cache_names = (\n            \"_frozen_split_h2d_begin_events_cache\", \"_frozen_split_h2d_end_timing_events_cache\",\n            \"_frozen_split_decomp_begin_timing_events_cache\", \"_frozen_split_decomp_end_timing_events_cache\")\n        caches = [getattr(self, name, {}) for name in cache_names]\n        compressor = getattr(self, \"kv_compressor\", None)\n        kv_begin = getattr(compressor, \"_kv_decode_begin\", None)\n        if kv_begin is None or len(kv_begin) != len(self.end_kv_decomp_events):\n            kv_begin = getattr(compressor, \"_kv_dec_h2d\", None)\n        if kv_begin is None or len(kv_begin) != len(self.end_kv_decomp_events):\n            kv_begin = self.begin_kv_decomp_events\n        signature = (tuple(len(cache) for cache in caches), id(kv_begin),\n                     id(getattr(self, \"_fused_reg\", None)),\n                     bool(DualMemoryLoader.use_weight_comp), bool(DualMemoryLoader.use_kv_comp))\n        cached = getattr(self, \"_breakdown_layout_cache\", None)\n        if cached is not None and cached[0] == signature:\n            return cached[1], cached[2]\n        components = (\"qkv\", \"o\", \"gate_up\", \"down\")\n        slots = (0, 1, 3, 4)\n\n        def pairs(begins, ends):\n            return [(id(begin), id(end)) for begin, end in zip(begins, ends)]\n\n        layout = dict(kernel=pairs(self.begin_kernel_events, self.end_kernel_events),\n                      aux=pairs(self.begin_aux_compute_events[:2], self.end_aux_compute_events[:2])\n                      if self.aux_timing_enabled else [], fallback={}, frozen_decode=[],\n                      kv_decode=pairs(kv_begin, self.end_kv_decomp_events)\n                      if DualMemoryLoader.use_kv_comp else [],\n                      kv_wait=pairs(self._v1_kv_wait_begin_events[:self.n_layers],\n                                    self._v1_kv_wait_end_events[:self.n_layers]))\n        for group, begins, ends in (\n                (\"weight_load\", self.begin_memcpy_weight_events, self.end_memcpy_weight_events),\n             