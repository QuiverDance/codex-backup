one\n        if contained and (begin < 0 or end > total):\n            return None\n        if end - begin < 0.001 or end <= 0 or begin >= total:\n            return None\n        begin, end = max(0, begin), min(total, end)\n        return (begin, end) if end - begin >= 0.001 else None\n\n    def append(layer, activity, component, source, span):\n        if span is not None:\n            rows.append(dict(layer=layer, activity=activity, component=component,\n                             source=source, begin_ms=span[0], end_ms=span[1]))\n\n    for index, pair in enumerate(layout[\"kernel\"]):\n        span = interval(pair, contained=True)\n        source = \"fused_weight_compute\" if index in fused else \"dense_compute\"\n        if index in fallback:\n            source = \"dense_fallback\"\n            decode = interval(layout[\"fallback\"][index], contained=True)\n            if span is not None and decode is not None:\n                if span[0] < decode[0]:\n                    append(index // 5, \"PRODUCTIVE\", KERNEL_COMPONENTS[index % 5],\n                           source, (span[0], min(span[1], decode[0])))\n                span = (max(span[0], decode[1]), span[1])\n                if span[0] >= span[1]:\n                    span = None\n        append(index // 5, \"PRODUCTIVE\", KERNEL_COMPONENTS[index % 5], source, span)\n    for component, pair in zip((\"embed\", \"final_norm\"), layout[\"aux\"]):\n        append(-1, \"PRODUCTIVE\", component, \"aux_compute\", interval(pair, contained=True))\n\n    for group, activity, source in (\n            (\"weight_load\", \"LOAD\", \"weight_h2d\"),\n            (\"weight_decode\", \"WDECOMP\", \"weight_decode\"),\n            (\"frozen_decode\", \"WDECOMP\", \"frozen_weight_decode\"),\n            (\"split_load\", \"LOAD\", \"split_weight_h2d\"),\n            (\"split_decode\", \"WDECOMP\", \"split_weight_decode\"),\n            (\"weight_wait\", \"WAIT\", \"weight_wait\")):\n        if group == \"weight_decode\" and not frame[\"native_wdecomp\"]:\n            continue\n        for layer, component, pair in layout[group]:\n            row_source = source\n            if group == \"frozen_decode\":\n                event_id = 5 * layer + KERNEL_SLOTS[COMPONENTS.index(component)]\n                if event_id in fallback:\n                    row_source = \"fused_fallback\"\n            append(layer, activity, component, row_source,\n                   interval(pair, wait=activity == \"WAIT\"))\n    for layer, begin_id, end_id in frame[\"transfers\"]:\n        append(layer, \"LOAD\", \"kv\", \"kv_h2d_submission\", interval((begin_id, end_id)))\n    for layer, pair in enumerate(layout[\"kv_decode\"]):\n        append(layer, \"KVDECOMP\", \"kv\", \"kv_decode\", interval(pair))\n    for layer, pair in enumerate(layout[\"kv_wait\"]):\n        append(layer, \"WAIT\", \"kv\", \"kv_wait\", interval(pair, wait=True))\n\n    issues = frame[\"issues\"]\n    for layer, component, event_id in layout[\"ready\"]:\n        issue = issues.get(layer * 5 + COMPONENTS.index(component))\n        ready = offsets.get(event_id)\n        if ready is not None and not (issue is not None and issue[2] > 1):\n            append(layer, \"READY\", component, \"consumer_wait_event\", (ready, ready))\n    prefetch = [dict(layer=index // 5, component=COMPONENTS[index % 5],\n                     first_issue_host_ms=value[0], last_issue_host_ms=value[1], issue_count=value[2])\n                for index, value in issues.items()]\n    post_model = None\n    if frame.get(\"logits\") is not None:\n        begin, end, span = frame[\"logits\"]\n        post_model = dict(lm_head_ms=end - begin, logits_span_ms=span,\n                          intervals=[dict(layer=-1, activity=\"PRODUCTIVE\", component=\"lm_head\",\n                                          source=\"aux_compute\", begin_ms=begin, end_ms=end)])\n    return dict(context=frame[\"context\"], intervals=rows, total_ms=total,\n                complete=frame[\"complete\"], prefetch_issues=prefetch,\n                post_model=post_model, capture_cpu_ms=frame[\"capture_cpu_ms\"])\n# Corrected breakdown verification\n\nApplied to `tiered-serve:/root/projects/tiered-serve`, uncommitted, on\n`f4ab632457015f416d7d09ebde83f284d6062582`. The 23 final task files were compared\nbyte-for-byte with the host copy; hashes are in `source-sha256.txt`. The final\nfeature patch is `interval-breakdown.patch`. Unrelated stack-pool diagnostics\nwere preserved.\n\n## Correctness changes\n\n- GPUFwd is the model-forward window again. Separate lm_head/logits timing does\n  not extend the model tiling or count CPU collection as a GPU pipeline bubble.\n- No per-forward device synchronization at compute_logits. Its events are read\n  at the next existing model collection point, with two retained origin events.\n  Only final shutdown drains the last pending logits measurement.\n- Readiness comes from the actual CUDA event that the consumer waited on. Its\n  existing record/wait is reused with timing enabled. Missing, shared/ambiguous,\n  or subsequently re-recorded events remain unavailable; no producer proxy.\n- Removed approximately 400 prefetch CUDA event records per 80-layer forward.\n  Host issue observations remain, but no CPU/GPU clock subtraction or alleged\n  queue delay is emitted.\n- Numeric event snapshots are sent through a bounded queue to a CPU-only spool\n  process. MessagePack serialization contains no executable pickle objects.\n  During inference the worker only writes binary records. Interval analysis and\n  CSV generation run after inference exits, automatically from both suites.\n- Queue overflow, truncated output, worker failure and abnormal EOF invalidate\n  the diagnostic run instead of silently dropping samples or blocking inference.\n- Legacy aggregates and detailed capture reuse timestamp and interval reads.\n\n## Tests and actual flows\n\n18 tests passed; one opt-in full GPU feature matrix skipped. This includes the\nrepos