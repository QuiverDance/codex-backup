self.directory.mkdir(parents=True, exist_ok=True)\n        self.suffix = suffix\n        self.pending = queue.Queue(maxsize=capacity)\n        self.attempted = self.submitted = self.dropped = 0\n        self.enqueue_cpu_ms = 0.0\n        self.serialization_cpu_ms = 0.0\n        self.error = None\n        self.closed = False\n        self.before_close = None\n        # No torch import, forked CUDA context, or inherited serving SIGINT.\n        # EOF shuts down the child even if its parent is killed unexpectedly.\n        worker = Path(__file__).with_name(\"breakdown_worker.py\")\n        self.process = subprocess.Popen(\n            [sys.executable, str(worker), str(self.directory), suffix],\n            stdin=subprocess.PIPE, start_new_session=True)\n        self.thread = threading.Thread(target=self._send, daemon=True,\n                                       name=\"breakdown-output\")\n        self.thread.start()\n        atexit.register(self.close)\n        self.finalizer = Finalize(None, self.close, exitpriority=10)\n\n    def submit(self, frame):\n        self.attempted += 1\n        if self.error is not None or self.closed:\n            self.dropped += 1\n            return\n        started = time.perf_counter()\n        # Ownership transfers to the transport. The producer must never mutate\n        # this frame or its numeric buffers after submission.\n        try:\n            self.pending.put_nowait(frame)\n            self.submitted += 1\n        except queue.Full:\n            self.dropped += 1\n            self.error = \"breakdown output backlog exceeded capacity\"\n            logging.getLogger(\"vllm\").error(\"%s; diagnostic run is incomplete\", self.error)\n        self.enqueue_cpu_ms += (time.perf_counter() - started) * 1000\n\n    def _send(self):\n        try:\n            while True:\n                frame = self.pending.get()\n                if frame is None:\n                    break\n                started = time.perf_counter()\n                data = msgspec.msgpack.encode(frame)\n                self.serialization_cpu_ms += (time.perf_counter() - started) * 1000\n                self.process.stdin.write(struct.pack(\"!Q\", len(data)))\n                self.process.stdin.write(data)\n            self.process.stdin.flush()\n        except Exception as error:\n            self.error = str(error)\n        finally:\n            self.process.stdin.close()\n\n    def close(self):\n        if self.closed:\n            return\n        # Only shutdown may drain outstanding work and wait for disk I/O.\n        # The model owner uses this to read the final logits events.\n        if self.before_close is not None:\n            self.before_close()\n        self.closed = True\n        deadline = time.monotonic() + 60\n        trailer = dict(finish=True, expected=self.submitted)\n        for item in (trailer, None):\n            while self.thread.is_alive():\n                try:\n                    self.pending.put(item, timeout=0.1)\n                    break\n                except queue.Full:\n                    if time.monotonic() >= deadline:\n                        self.error = \"breakdown shutdown drain timed out\"\n                        break\n        self.thread.join(timeout=max(0, deadline - time.monotonic()))\n        try:\n            self.process.wait(timeout=max(0.1, deadline - time.monotonic()))\n        except subprocess.TimeoutExpired:\n            self.process.terminate()\n            self.process.wait(timeout=5)\n            self.error = \"breakdown worker shutdown timed out\"\n        status = dict(\n            attempted=self.attempted, submitted=self.submitted, dropped=self.dropped,\n            enqueue_cpu_ms=self.enqueue_cpu_ms, serialization_cpu_ms=self.serialization_cpu_ms,\n            worker_exit=self.process.returncode,\n            error=self.error, complete=not self.error and not self.dropped\n            and self.process.returncode == 0)\n        path = self.directory / f\"break