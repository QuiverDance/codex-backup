nsfers\\\", \\\"bytes_complete\\\", \\\"timing_complete\\\",\\n)\\n_collector = None\\n_generation = 0\\n\\n\\nclass Transfer:\\n    def __init__(self, timing):\\n        # Native staging fills this reusable list before the begin event.\\n        self.stats = [0, 0, 0]  # dense-equivalent, encoded payload, H2D\\n        self.layer = -1\\n        self.events = None\\n        self.handles = (0, 0)\\n        if timing:\\n            import torch\\n            self.events = tuple(torch.cuda.Event(enable_timing=True)\\n                                for _ in range(2))\\n            for event in self.events:\\n                event.record()  # Materialize native handles once.\\n            self.handles = tuple(event.cuda_event for event in self.events)\\n\\n    def begin(self, stream):\\n        if self.events:\\n            self.events[0].record(stream)\\n\\n    def end(self, stream):\\n        if self.events:\\n            self.events[1].record(stream)\\n\\n\\nclass KVLoadMetrics:\\n    def __init__(self, *, timing=False, path=None, capacity=0):\\n        self.timing = timing\\n        self.active = False\\n        self.forward = -1\\n        self.batch = self.step = -1\\n        self.config = \\\"serving\\\"\\n        self.pool = [Transfer(timing) for _ in range(capacity)]\\n        self.layer = -1\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.last = None\\n        self.file = None\\n        if path:\\n            Path(path).parent.mkdir(parents=True, exist_ok=True)\\n            # One write per forward, never per layer; line buffering also\\n            # preserves completed forwards when a serving worker is stopped.\\n            self.file = open(path, \\\"w\\\", buffering=1)\\n            self.writer = csv.DictWriter(self.file, fieldnames=COLUMNS)\\n            self.writer.writeheader()\\n            atexit.register(self.close)\\n\\n    def close(self):\\n        if self.file:\\n            