ws.append(dict(layer=layer, activity=\\\"READY\\\", component=component,\\n                             source=\\\"consumer_wait_event\\\", begin_ms=ready, end_ms=ready))\\n        return rows\\n\\n    def record_prefetch_issue(self, layer, component):\\n        \\\"\\\"\\\"CPU scheduling entry on a host clock, with no GPU marker or dependency.\\\"\\\"\\\"\\n        if not self._breakdown_collecting:\\n            return\\n        key = (layer, component)\\n        now = (perf_counter() - self._forward_host_start) * 1000\\n        previous = self.prefetch_issue_host_ms.get(key)\\n        if previous is None:\\n            self.prefetch_issue_host_ms[key] = (now, now, 1)\\n        else:\\n            self.prefetch_issue_host_ms[key] = (previous[0], now, previous[2] + 1)\\n\\nimport os\\nfrom collections import Counter\\nfrom time import perf_counter\\n\\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\\n\\n\\nclass TimingMixin:\\n\\n    def calc_times(self, total_time: float):\\n        if not self.collect_times:\\n            return\\n\\n        # Idempotency guard. V1 graph wrappers and the outer model hook can call this\\n        # function twice per forward — once from\\n        # _do_after_model_forward (inside the last graph piece) and\\n        # again from after_model_forward (the model's forward_hook).\\n        # The first call's reset_events() invalidates the per-layer\\n        # exec/decomp event timestamps, and the second call re-records\\n        # end_forward_event on a different stream, so the second\\n        # invocation produces garbage (negative Exec, doubled Total).\\n        # Run only once per forward; the flag is cleared in\\n        # before_model_forward at the start of the next forward.\\n        if getattr(self, \\\"_calc_times_done\\\", False):\\n            return\\n        self._calc_times_done = True\\n        self._flush_pending_breakdown()\\n        self._timing_offsets = {}\\n        self._timing_interval_pairs = {}\\n\\n        # Guard against the \\\"Both events must be completed\\\" race we saw\\n        # when calc_times runs before the recording streams finish.\\n        # synchronize() is cheap relative to the per-step work and only\\n        # runs in collect_times mode (off by default).\\n        try:\\n            total_time = self.begin_forward_event.elapsed_time(\\n                self.end_forward_event)\\n        except RuntimeError:\\n            torch.cuda.synchronize()\\n            total_time = self.begin_forward_event.elapsed_time(\\n                self.end_forward_event)\\n        idx_to_weight_name = [\\n            \\\"self_attn.qkv_proj.weight\\\", \\\"self_attn.o_proj.weight\\\",\\n            \\\"mlp.gate_up_proj.weight\\\", \\\"mlp.down_proj.weight\\\"\\n        ]\\n\\n        init_event = self.begin_forward_event\\n        use_weight_comp = DualMemoryLoader.use_weight_comp\\n        load_comp_weight = DualMemoryLoader.load_comp_weight\\n        use_kv_comp = DualMemoryLoader.use_kv_comp\\n\\n        # Count/clamp every timing interval against this forward.  Reset the\\n        # diagnostics before the first _calc_intervals call.\\n        self._timing_window_clip_count = 0\\n        self._timing_window_drop_count = 0\\n\\n        # ── Compute intervals ──\\n        # begin_exec/end_exec is a graph-piece ENVELOPE.  It includes queue and\\n        # transitive dependency idle, so it is useful for diagnostics but is\\n        # never a valid source for productive Compute.\\n        llm_intervals = self._calc_intervals(\\n            init_event, self.begin_exec_events, self.end_exec_events,\\n            total_time)\\n        if llm_intervals:\\n            llm_intervals = self._calc_exec_times(llm_intervals, [])\\n\\n        # Productive projection markers are baked into compiled graph pieces by\\n        # graph_wait_ops; V1 eager attention is bracketed by its neighbouring\\n        # graph wrappers.  Require the full 5-per-layer set.  A partial s