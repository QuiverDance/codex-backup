tate = _PersistentCSRState(\n            entries=torch.empty(\n                initial_words, dtype=torch.int64).pin_memory(),\n            offsets=torch.zeros(\n                host_rows, dtype=torch.int64).pin_memory(),\n            word_counts=np.zeros(host_rows, dtype=np.int64),\n            used_words=0,\n            garbage_words=0,\n            max_words=max_words,\n            gpu_words=gpu_words,\n        )\n        self._persistent_csr[layer_id][kv] = state\n        return state\n\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\n        \"\"\"Compact append garbage off the request path in the CPU worker.\"\"\"\n        pool = self._host_pools[layer_id][kv]\n        rows = self._kv_slot_allocator[layer_id].high_water\n        slots = np.arange(rows, dtype=np.int64)\n        counts = pool[\"num_exceptions\"].numpy()[:rows]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        total_words = int(word_counts.sum())\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\n                     * self._packed_capacity)\n        if total_words > max_words:\n            raise RuntimeError(\n                \"ChunkDelta3 persistent CSR exceeds host slot capacity: \"\n                f\"layer={layer_id} side={kv} words={total_words} \"\n                f\"capacity={max_words}\")\n        previous = self._persistent_csr[layer_id][kv]\n        previous_capacity = (\n            previous.entries.numel() if previous is not None else 0)\n        capacity = max(\n            1024, total_words,\n            min(max_words, previous_capacity),\n        )\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\n        offsets = torch.zeros(\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\n        if rows:\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                torch.from_numpy(slots), entries[:total_words],\n                offsets[:rows])\n        state = _PersistentCSRState(\n            entries=entries,\n            offsets=offsets,\n            word_counts=np.zeros(\n                self._max_n_blocks + 1, dtype=np.int64),\n            used_words=total_words,\n            garbage_words=0,\n            max_words=max_words,\n            gpu_words=gpu_words,\n        )\n        state.word_counts[:rows] = word_counts\n        self._persistent_csr[layer_id][kv] = state\n        return state\n\n    def _append_persistent_csr(\n            self, layer_id: int, kv: str, slots: np.ndarray) -> None:\n        \"\"\"Publish freshly encoded slots into the persistent CSR arena.\"\"\"\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\n        if slots.size == 0:\n            return\n        pool = self._host_pools[layer_id][kv]\n        counts = pool[\"num_exceptions\"].numpy()[slots]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        new_word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        append_words = int(new_word_counts.sum())\n        state = self._persistent_csr[layer_id][kv]\n        if state is None:\n            state = self._new_persistent_csr(layer_id, kv)\n\n        old_words = int(state.word_counts[slots].sum())\n        required = int(state.used_words) + append_words\n        # Reuse/re-encode churn can leave unreachable append records.  Only\n        # compact in the worker when it avoids growth or is required to stay\n        # within the fixed GPU CSR staging capacity.\n        should_compact = required > state.max_words\n        should_compact |= (\n            required > state.gpu_words\n            and self._kv_slot_allocator[layer_id].high_water\n            <= self._max_gpu_decomp_blocks + 1)\n        should_compact |= (\n            required > state.entries.numel()\n            and state.garbage_words + old_words >= append_words)\n        if should_compact:\n            # Scratch rows already contain the just-encoded values, so one\n            # rebuild publishes both the old live set and this update.\n            self._rebuild_persistent_csr(layer_id, kv)\n            return\n\n        if required > state.entries.numel():\n            capacity = min(\n                state.max_words,\n                max(required, state.entries.numel() * 2),\n            )\n            entries = torch.empty(\n                capacity, dtype=torch.int64).pin_memory()\n            entries[:state.used_words].copy_(\n                state.entries[:state.used_words])\n            offsets = state.offsets.clone().pin_memory()\n            state.entries = entries\n            state.offsets = offsets\n\n        base = int(state.used_words)\n        relative_offsets = torch.empty(slots.size, dtype=torch.int64)\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\n            pool[\"entries20x3\"], pool[\"num_exceptions\"],\n            torch.from_numpy(slots),\n            state.entries[base:base + append_words],\n            relative_offsets)\n        state.offsets.numpy()[slots] = (\n            relative_offsets.numpy() + base)\n        state.word_counts[slots] = new_word_counts\n        state.used_words = required\n        state.garbage_words += old_words\n\n    def _discard_persistent_csr_slot(\n        block_array = np.asarray(block_ids, dtype=np.int64)\n        if block_array.size:\n            block_array = block_array[\n                (block_array >= 0) & (block_array < num_source_blocks)]\n        if block_array.size == 0:\n            return\n        decode_event_handle = int(\n            self._kv_dec_h2d[layer_id].cuda_event)\n        with self._slot_state_lock:\n            slots = self._assign_kv_slots(layer_id, block_array)\n            valid = self._persistent_valid[layer_id]\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\n            self._invalidate_decode_plan(layer_id)\n            state = self._worker_state_for_layer(layer_id)\n            state[\"error\"] = None\n            state[\"done\"].clear()\n            profile = kv_cpu_profile.new_job(layer_id, int(block_array.size))\n            pending = {\n                \"profile\": profile,\n                \"state\": state,\n                \"buffer_ids\": block_array,\n                \"physical_slots\": slots,\n            }\n            self._pending_compress[layer_id] = pending\n            try:\n                self._work_queue.put((\n                    state,\n                    (layer_id, host_k, host_v, block_array, slots,\n                     int(wait_event_handle), decode_event_handle, profile),\n                ))\n            except BaseException:\n                if self._pending_compress.get(layer_id) is pending:\n                    self._pending_compress.pop(layer_id, None)\n                state[\"done\"].set()\n                raise\n\n    def _encode_chunk(\n        self,\n        layer_id: int,\n        host_k: torch.Tensor,\n        host_v: torch.Tensor,\n        block_ids: np.ndarray,\n        slots: np.ndarray,\n        raw_event_handle: int,\n        decode_event_handle: int,\n        profile=None,\n    ) -> None:\n        self._pin_worker_thread()\n        if profile is not None:\n            started_ns = _time.perf_counter_ns()\n        _sync_cuda_event(raw_event_handle)\n        if profile is not None:\n            now_ns = _time.perf_counter_ns()\n            profile[\"raw_d2h_wait_ms\"] = (now_ns - started_ns) / 1e6\n            started_ns = now_ns\n        _sync_cuda_event(decode_event_handle)\n        if profile is not None:\n            profile[\"prior_h2d_wait_ms\"] = (\n                _time.perf_counter_ns() - started_ns) / 1e6\n        # A 56-thread team is counterproductive when only 8-64 fresh blocks\n        # exist (the normal serving case).  Shrink the team for small calls;\n        # default eight-worker serving already clamps each worker to seven\n        # CPUs, so this mainly fixes explicit workers=1 deployments.\n        worker_index = int(getattr(self._pin_tls, \"index\", 0))\n        maximum_threads = self._worker_omp_threads.get(\n            worker_index, self._omp_thread_cap)\n        block_count = int(block_ids.size)\n        if block_count <= 8:\n            omp_threads = min(maximum_threads, 8)\n        elif block_count <= 64:\n            omp_threads = min(maximum_threads, 16)\n        elif block_count <= 256:\n            omp_threads = min(maximum_threads, 32)\n        else:\n            omp_threads = maximum_threads\n        if self._omp_lib is not None:\n            self._omp_lib.omp_set_num_threads(int(max(1, omp_threads)))\n        block_tensor = torch.from_numpy(block_ids)\n        slot_tensor = torch.from_numpy(slots)\n        for source, kv in ((host_k, \"k\"), (host_v, \"v\")):\n            pool = self._host_pools[layer_id][kv]\n            if profile is not None:\n                started_ns = _time.perf_counter_ns()\n            _cd3_ext.host_encode_chunk_delta3_blocks(\n                source.view(torch.int16), block_tensor, slot_tensor,\n                pool[\"codes\"], pool[\"sign_mantissa\"],\n                pool[\"thread_bases\"], pool[\"tile_exception_offsets\"],\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                self._M_b, self._K_b,\n            )\n            if profile is not None:\n                now_ns = _time.perf_counter_ns()\n                profile[\"encode_ms\"] += (now_ns - started_ns) / 1e6\n                started_ns = _time.perf_counter_ns()\n            self._append_persistent_csr(layer_id, kv, slots)\n            if profile is not None:\n                profile[\"csr_ms\"] += (\n                    _time.perf_counter_ns() - started_ns) / 1e6\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0, *,