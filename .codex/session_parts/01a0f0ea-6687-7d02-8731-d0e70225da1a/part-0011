             (diagnostic; client perf is invalid)\\n  --dataset-path PATH           Azure conversation CSV for client requests\\n                                (default: vLLM's Azure conversation trace)\\n  --smoke                       Run two requests without percentile trimming;\\n                                validates startup and request handling only\\n  --check-only                  Validate files, dependencies, and clean state\\n  --dry-run                     Print the complete matrix and commands\\n  -h, --help                    Show this help\\nrequire_uint stop-after-request \\\"$STOP_AFTER_REQUEST\\\"\\nrequire_positive_int nsys-start-request \\\"$NSYS_START_REQUEST\\\"\\nrequire_positive_int nsys-forwards \\\"$NSYS_FORWARDS\\\"\\n[[ \\\"$NSYS_GRAPH_MODE\\\" == auto || \\\"$NSYS_GRAPH_MODE\\\" == node || \\\"$NSYS_GRAPH_MODE\\\" == node:nvtx-precapture ]] \\\\\\n  || die \\\"unsupported --nsys-graph-mode: $NSYS_GRAPH_MODE\\\"\\nif ((NSYS)); then\\n  ((BREAKDOWN == 0 && KV_BYTE_METRICS == 0 && CD3_CPU_PROFILE == 0 && SMOKE == 0)) \\\\\\n    || die \\\"--nsys requires breakdown/byte-metrics/cpu-profile/smoke to be OFF\\\"\\n  ((${#CODECS[@]} == 1)) && [[ \\\"${CODECS[0]}\\\" == cd3 ]] \\\\\\n    || die \\\"this Nsight preset supports --codecs cd3 only\\\"\\n  ((NSYS_START_REQUEST < NUM_PROMPTS)) \\\\\\n    || die \\\"Nsight trigger must precede the last offered request\\\"\\n  if ((STOP_AFTER_REQUEST > 0)); then\\n    ((STOP_AFTER_REQUEST > NSYS_START_REQUEST)) \\\\\\n      || die \\\"--stop-after-request must exceed the Nsight trigger ordinal\\\"\\n  fi\\nfi\\n\\nCLIENT_NUM_PROMPTS=$((SMOKE ? 2 : NUM_PROMPTS))\\nCLIENT_SKIP_FIRST_N_REQUESTS=$((SMOKE ? 0 : SKIP_FIRST_N_REQUESTS))\\nCLIENT_SKIP_LAST_N_REQUESTS=$((SMOKE ? 0 : SKIP_LAST_N_REQUESTS))\\n((CLIENT_SKIP_FIRST_N_REQUESTS + CLIENT_SKIP_LAST_N_REQUESTS\\n    < CLIENT_NUM_PROMPTS)) \\\\\\n  || die \\\"request trimming must leave at least one measured request\\\"\\nif ((STOP_AFTER_REQUEST > 0)); then\\n  ((STOP_AFTER_REQUEST <= CLIENT_NUM_PROMPTS)) \\\\\\n    || die \\\"--stop-after-request (${STOP_AFTER_REQUEST}) exceeds num prompts (${CLIENT_NUM_PROMPTS})\\\"\\n  ((STOP_AFTER_REQUEST > CLIENT_SKIP_FIRST_N_REQUESTS)) \\\\\\n    || die \\\"--stop-after-request must leave at least one measured request after the leading trim\\\"\\nfi\\n\\n\\nfor codec in \\\"${CODECS[@]}\\\"; do\\n  [[ \\\"$codec\\\" == p4flat || \\\"$codec\\\" == cd3 ]] \\\\\\n    || die \\\"unsupported codec: ${codec}\\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0f1f9-ea2a-7ed0-9c9c-8570ca87d69d","create_time":1790766089.110154}},{"type":"reasoning","id":"rs_04e034edfe997a38016abcec0c9edc87d1b353d5ecd95e8139","summary":[],"content":null,"encrypted_content":"gAAAAABqvOwccysfYHWxb82KlvVAtx50nuOhFfmbltrPiw09O1MbBAoVf0bCyldhTYGO0sNv2llWgj9uNSkNp8q1EBo5SWStwBYlL4W8xkc_8_l6tuxJoeWXHTEXDuPI1WoHAgvVtJL846JGVlQrdn7ayaA85fsmccUuiR8i5PqZozGOWyzN53taruP6YtinfPxY-3FDdSp4Or-XQA_ZgszmrW6WCoPatiLV2DFTl7cheBxfntI_AHnYqJPCDjE_z3Hd0E_3c4YQq8vx6sIQL4kQkUtg-oVMgjXXwzGmYshFl0GBRISfg3PilNgIRYQUUYjzXZDJxY6fgk4bcdAJlK9u7XkaRzfPj8HpvAXo1zf1dksIqDRIKwaTmMjJz4Qu821SXPbI0LaYJzW3I-jQZIcLs546vzr2yiZfbYK_MfQQhQxo3WidilwAm7REb0Z0qljhIngK0b8FM2-G26T83P-iz-lVZYFFSvkfT6lulwi2rtD-1U1YInYYCltSlcQByFSZeni6pc38PKcnL0mP4Ov2Wo1Ke1N61EBP6p-FOrjQFq7O0_XoR_HSKjfqsBHTJ67lOAgd0Gs4j1UTV9SXXqkAt4wbNTS7JEdFdUI3MezebijOebeqbi4qwCn8QLHb2S6ObtNB3YG3hFnShzBcLATXEUklT24ybwG1gifOoXl2ShzfzExZO8q2mSjChsx69rfJCaeRaRa4IrSwt7aS-FYNNM3mophfmFlr49H5HKs7W3ceYABws71iyJNrsfA3u794SLE4fgvK9HD6y62Hpq4eegEt2Si9iHms7ROnrPBlOrIgP2EHZwRBVXM8vhmJjeXfCXQ6tuNQNlu3ZmtEOXieAGt4n4dA7l7uL6Z2qSGiRHfsmyY4wtE42XfnLj-pDF0KmCIv-FieXvpGCsHAzedoQ5ElgNAzkHHRo6GiUgGPPt9u6Hl0TAo2W1gUAG4urIEBHIdIknU3WtrkBy9a34nlMGNnTxaT6RGm0LQC1Y0r2bFJdp2brPICGDIM3enqgZM4qBqQB7Z3ohYtbJey_nSzhx076-ij111NtfwdNjsiV3y4aBLsJAiSOUOpluguhz5U25oYBGXlaSKv0n7Ry61HUNWUq6ro11hJ1t1OvcoHXFUd3WfvRrmDqWIF1prmTxdYITjz8VMh9TpkVz-KiTvH5NsQp-F_uKX-hBaGb8dQPn9d--Cl2amCPJCxunQvAKwsycXPGPnr-p