ine,\\nraw-overflow fallback, and the loader's start/finish protocol.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\nfrom contextlib import ExitStack\\nfrom dataclasses import asdict, dataclass\\nimport hashlib\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time\\nimport numpy as np\\nimport torch\\nfrom tiered_serve.chunk_delta3_inline_layout import align, make_budget\\nfrom tiered_serve import cd3_cpu_profile, kv_cpu_profile, kv_load_metrics, nsys_trace\\n\\nlog = logging.getLogger(__name__)\\n\\n\\n@dataclass\\nclass _InlinePlan:\\n    native: object\\n    h2d_done: object\\n    output_buffers: tuple\\n    h2d_submitted: bool = False\\n    completion_valid: bool = True\\n\\n\\ndef inline_compressor_class(base):\\n    # Called at the end of the original module, once all its definitions exist.\\n    from tiered_serve.chunk_delta3_kv_compressor import _cd3_ext as ext, _factor_64, _sync_cuda_event\\n    from tiered_serve.kv_codec_spec import (\\n        chunk_delta3_base_rows, chunk_delta3_exception_capacity,\\n        chunk_delta3_body_bytes, chunk_delta3_body_stride)\\n\\n    class InlineChunkDelta3KVCompressor(base):\\n        # RAW mixed/prefill loads and inline decode never consume legacy pointer tables.\\n        uses_legacy_decomp_metadata = False\\n\\n        def __init__(self, comp_stream):\\n            if os.getenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", \\\"hybrid\\\") != \\\"csr\\\":\\n                raise ValueError(\\\"CD3_INLINE=1 requires TIERED_SERVE_KV_CD3_STORAGE=csr\\\")\\n            if os.getenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"0\\\") != \\\"1\\\":\\n                raise ValueError(\\\"CD3 inline requires TIERED_SERVE_KV_FULL_BLOCK_ONLY=1\\\")\\n            if (getattr(ext, \\\"inline_abi_version\\\", 0) != 1\\n                    or not getattr(ext, \\\"inline_batch_supported\\\", False)):\\n                raise RuntimeError(\\\"Rebuild CD3 with the inline patch and CUDA >=12.8\\\")\\n            sup