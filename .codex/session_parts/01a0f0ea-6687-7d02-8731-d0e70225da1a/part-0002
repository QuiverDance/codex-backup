"INLINE_PIPELINE_MIN_SIDE_BYTES is out of range\\\")\\n+PIPELINE_MIN_SIDE_BYTES = _SIZE_MAX if PIPELINE_MODE == \\\"serial\\\" else 0 if PIPELINE_MODE == \\\"pipeline\\\" else _MIN_SIDE\\n+PLAN_DEFERRED = object()\\n+\\n+\\n+def defer_current_plan(dm, layer: int, n_graphs: int, n_layers: int,\\n+                       jit_current: bool, allow_defer: bool) -> bool:\\n+    \\\"\\\"\\\"A conservative miss hint. It never replaces the reader's real validation.\\n+\\n+    Only the captured, attention-split interior pieces are eligible. Raw,\\n+    mixed/eager, G0, the last piece, warming and profiling keep baseline order.\\n+    Actual pending encoder joins and snapshot building remain in the reader,\\n+    after the independent graph is enqueued but before attention's KV wait.\\n+    \\\"\\\"\\\"\\n+    if (not GRAPH_FIRST or not allow_defer or not jit_current\\n+            or n_graphs != n_layers + 1 or not 0 < layer < n_layers\\n+            or not dm.use_kv_comp or dm.batch_has_prefill\\n+            or getattr(dm, \\\"is_graph_warming_up\\\", False)\\n+            or getattr(dm, \\\"is_profiling\\\", False)\\n+            or not dm.active_kv_buffer_ids):\\n+        return False\\n+    kc = dm.kv_compressor\\n+    if getattr(kc, \\\"storage_backend\\\", None) != \\\"inline\\\" or not dm._uses_compressed_kv_load(layer):\\n+        return False\\n+    predicate = getattr(kc, \\\"inline_plan_needs_prepare\\\", None)\\n+    if predicate is None:\\n+        return False\\n+    return predicate(layer, type(dm).primary_k_caches[layer], type(dm).primary_v_caches[layer])\\ndiff --git a/tiered_serve/compression/cuda/chunk_delta3_inline_schedule.h b/tiered_serve/compression/cuda/chunk_delta3_inline_schedule.h\\nnew file mode 100644\\n--- /dev/null\\n+++ b/tiered_serve/compression/cuda/chunk_delta3_inline_schedule.h\\n@@ -0,0 +1,52 @@\\n+#pragma once\\n+// Submission layout only: never changes, copies, or reallocates stored KV payload.\\n+#include \\\"chunk_delta3_inline_core.h\