nts * 3 // 8\\n            self._base_bytes = self._tiles_per_block * (256 // chunk_delta3_base_rows())\\n            self._entry_capacity = chunk_delta3_exception_capacity(elements)\\n            self._packed_capacity = self._entry_capacity // 3\\n            self._build_body_layout()\\n            assert self._record_body_bytes == chunk_delta3_body_bytes(elements)\\n            assert self._body_stride == chunk_delta3_body_stride(elements)\\n            self._max_n_blocks, self._max_gpu_decomp_blocks, self._n_layers = int(max_n_blocks), max_gpu_decomp_blocks, n_layers\\n            budget = make_budget(elements=elements, body_bytes=self._record_body_bytes,\\n                                 body_stride=self._body_stride, packed_capacity=self._packed_capacity,\\n                                 host_rows=host_n, gpu_rows=gpu_n, layers=n_layers, workers=self._n_workers)\\n            self._inline_budget = budget\\n            self._inline_layers = tuple(threading.RLock() for _ in range(n_layers))\\n            self._inline_allocator = huge_page_allocator\\n            self._encode_chunk_blocks = budget.scratch_rows\\n            # All persistent payload and pinned metadata are reserved here, not in a plan build.\\n            # Keep each allocator request bounded; native slabs never span backing allocations.\\n            def arenas(total):\\n                output = []\\n                target = align(max(4 * 1024 * 1024, min(512 * 1024 * 1024, total // (2 * n_layers))))\\n                while total:\\n                    size = min(target, total)\\n                    output.append(self._alloc_host_tensor((size,), torch.uint8, huge_page_allocator))\\n                    total -= size\\n                return output\\n            self._inline_payload_arenas = arenas(budget.payload_bytes)\\n            self._inline_metadata_arenas = arenas(budget.metadata_bytes)\\n            self._inline_payload_pool = ext.InlinePool(self._inline_payload_arenas)\\n            self