ation=generation) for bid in blocks)\\n        compressor.compress_batch_async_from_host(\\n            layer_id, blocks, *(source if values is None else values), ownership=routing)\\n        compressor.wait_compress_async(layer_id, (64, 64))\\n\\n    def decode(blocks, layer_id=0, expected_source=None):\\n        metrics.begin_forward(False, len(blocks))\\n        metrics.layer = layer_id\\n        compressor.prepare_active_set(blocks, np.array(blocks, dtype=np.int64))\\n        compressor.decompress_batch(layer_id, blocks, output)\\n        compressor.batch_decomp_stream.synchronize()\\n        for actual, expected in zip(output, source if expected_source is None else expected_source):\\n            assert torch.equal(actual[blocks].cpu().view(torch.int16), expected[blocks].view(torch.int16))\\n        snapshot = metrics.snapshot()\\n        assert snapshot[\\\"bytes_complete\\\"] == snapshot[\\\"timing_complete\\\"] == 1\\n        assert snapshot[\\\"cd3_k_h2d_bytes\\\"] + snapshot[\\\"cd3_v_h2d_bytes\\\"] == snapshot[\\\"kv_h2d_bytes\\\"]\\n        assert snapshot[\\\"cd3_copy_descriptors\\\"] > 0\\n        if storage == \\\"hybrid\\\":\\n            assert snapshot[\\\"kv_h2d_bytes\\\"] == (snapshot[\\\"kv_payload_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_metadata_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_alignment_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_page_over_transfer_bytes\\\"])\\n            assert snapshot[\\\"cd3_gap_bytes\\\"] == snapshot[\\\"cd3_page_over_transfer_bytes\\\"]\\n        else:\\n            assert snapshot[\\\"cd3_csr_garbage_bytes\\\"] <= snapshot[\\\"cd3_gap_bytes\\\"]\\n        assert snapshot[\\\"cd3_storage\\\"] == storage\\n        assert snapshot[\\\"cd3_execution\\\"] == (\\\"serial\\\" if storage == \\\"csr\\\" else \\\"pipeline\\\")\\n        return snapshot\\n\\n    try:\\n        submit(ids, 1)\\n        # Exercise the serving CPU profiler through a real decode and its JSON\\n        # output. The remaining submissions run with the usual profiling state.\\n        with monkeypatch.context() as profiling:\\n            profiling.setattr(cd3_cpu_profile, \\\"enabled\\\", True)\\n            profiling.setattr(cd3_cpu_profile, \\\"_totals\\\", {})\\n            profiling.setenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\", str(tmp_path))\\n            decode(ids[:2])\\n            cd3_cpu_profile.flush()\\n            report = next(tmp_path.glob(\\\"cd3_cpu_profile.*.json\\\"))\\n            categories = json.loads(report.read_text())[\\\"categories\\\"]\\n            for field in (\\\"plan_cpu_ms\\\", \\\"stage_cpu_ms\\\"):\\n                assert categories[f\\\"load.{field}\\\"][\\\"calls\\\"] == 1\\n                assert categories[f\\\"load.{field}\\\"][\\\"total_ms\\\"] > 0\\n            if storage == \\\"hybrid\\\":\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"calls\\\"] == 1\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"total_ms\\\"] > 0\\n        cached_plan = compressor._decode_plans[0]\\n        if storage == \\\"csr\\\":\\n            native = cached_plan.serial_native\\n            assert native is not None\\n            assert native.copy_count == (2 * native.span_count + 3\\n                                         + sum(words > 0 for words in cached_plan.entry_words))\\n            assert native.wire_bytes == (sum(cached_plan.side_payload)\\n                                         + sum(cached_plan.side_alignment)\\n                                         + sum(cached_plan.side_gap)\\n                                         + cached_plan.storage_rows * 24)\\n        submit(ids[:2], 1, layer_id=1, values=other_source)\\n        # Interleaved layers bring the cached plan back to its original\\n        # ring. Different layer data makes stale ring contents observable.\\n        decode(ids[:2], layer_id=1