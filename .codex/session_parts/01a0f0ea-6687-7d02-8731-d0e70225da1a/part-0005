)\\n\\n    @cd3_cpu_profile.timed(\\\"callback.free\\\")\\n    @nsys_trace.call(\\\"CPU.KV.INLINE.Free.BATCH\\\", \\\"free\\\")\\n    def free_persistent_blocks(self, block_ids, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Retire one callback batch across every warmed-up CD3 layer.\\n\\n        The diagnostic entry point supplies phase counters. Serving executes\\n        the identical lifecycle without allocating counters or reading clocks;\\n        profiling guards are per batch/layer, never inside the block loops.\\n        \\\"\\\"\\\"\\n        with ExitStack() as gates:\\n            for gate in self._layer_gates:\\n                gates.enter_context(gate)\\n            if _profile is not None:\\n                started_ns = time.perf_counter_ns()\\n            raw_ids = np.asarray(block_ids)\\n            if raw_ids.ndim != 1:\\n                raise ValueError(\\\"ChunkDelta3 block IDs must be one-dimensional\\\")\\n            if raw_ids.size == 0:\\n                if _profile is not None:\\n                    _profile[\\\"cd3_validate_ns\\\"] += (\\n                        time.perf_counter_ns() - started_ns)\\n                return\\n            if not np.issubdtype(raw_ids.dtype, np.integer):\\n                raise TypeError(\\\"ChunkDelta3 block IDs must be integers\\\")\\n            block_ids = np.unique(raw_ids.astype(np.int64, copy=False))\\n            if int(block_ids[0]) < 0:\\n                raise ValueError(\\\"ChunkDelta3 block IDs must be non-negative\\\")\\n            for layer_id in range(self._n_layers):\\n                slot_table = self._kv_slot_np.get(layer_id)\\n                if slot_table is None or int(block_ids[-1]) >= slot_table.size:\\n                    raise ValueError(\\n                        \\\"ChunkDelta3 block ID is outside the persistent table: \\\"\\n                        f\\\"layer={layer_id} max_id={int(block_ids[-1])}\\\")\\n\\n            if _profile is not None:\\n                now_ns = time.per