trace.call(\\\"CPU.KV.Encode.WaitAndPublish\\\", \\\"wait\\\", key=\\\"layer_id\\\")\\\\n'\\ns=s.replace(decorators,'')\\nstart=s.index('        if profile is not None:\\\\n            end_ns = time.perf_counter_ns()',s.index('    def _join_compress_worker'))\\nend=s.index('    def wait_compress_async(',start)\\nprofile_finish=s[start:end].rstrip()+'\\\\n'\\ns=s[:start]+decorators+s[end:]\\ns=s.replace('        with self._layer_gates[layer_id]:\\\\n            pending = self._pending_compress.get(layer_id)\\\\n            try:', '        with self._layer_gates[layer_id]:\\\\n            pending = self._pending_compress.get(layer_id)\\\\n            profile = pending.get(\\\"profile\\\") if pending is not None else None\\\\n            try:')\\nend=s.index('    def _decode_raw_from_secondary')\\ns=s[:end].rstrip()+'\\\\n'+''.join('    '+line if line.strip() else line for line in profile_finish.splitlines(keepends=True))+'\\\\n'+s[end:]\\ns=s.replace('            now = time.perf_counter_ns(); profile[\\\"raw_d2h_wait_ms\\\"] = (now - started) / 1e6; started = now', '            now = time.perf_counter_ns()\\\\n            profile[\\\"raw_d2h_wait_ms\\\"] = (now - started) / 1e6\\\\n            started = now')\\ns=s.replace('                    now = time.perf_counter_ns(); profile[\\\"encode_ms\\\"] = (profile.get(\\\"encode_ms\\\") or 0.0) + (now - started) / 1e6; started = now', '                    now = time.perf_counter_ns()\\\\n                    profile[\\\"encode_ms\\\"] = (profile.get(\\\"encode_ms\\\") or 0.0) + (now - started) / 1e6\\\\n                    started = now')\\nimport ast\\nast.parse(s)\\np.write_text(s)\\nPY\",\"workdir\":\"/tmp/tieredserve-inline-default\",\"max_output_tokens\":1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0f1bb-e9f8-7252-8f12-841b3fee1e2b","create_time":1790763062.480169}}}
