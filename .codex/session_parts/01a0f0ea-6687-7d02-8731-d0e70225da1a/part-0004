e, alignment in (\\n            (\\\"codes\\\", self._code_bytes, torch.uint8, 1),\\n            (\\\"sign_mantissa\\\", self._block_numel, torch.uint8, 1),\\n            (\\\"thread_bases\\\", self._base_bytes, torch.uint8, 1),\\n            (\\\"tile_exception_offsets\\\", self._tiles_per_block + 1,\\n             torch.int32, 4),\\n        ):\\n            offset = _align_up(offset, alignment)\\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\\n            layout[name] = (offset, nbytes, width, dtype)\\n            offset += nbytes\\n        self._body_stride = _align_up(offset, 128)\\n        self._body_layout = layout\\n        self._record_body_bytes = offset\\n\\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\\n        if huge_page_allocator is not None:\\n            numel = 1\\n            for size in shape:\\n                numel *= size\\n            # A configured serving allocator has already budgeted the CD3 KV\\n            # pool.  Falling through to weight pages or a large pinned tensor\\n            # hides planner errors and can OOM the host much later in warmup.\\n            return huge_page_allocator.allocate(\\n                (numel,), (1,), dtype, page_type=\\\"kv\\\").view(shape)\\n        return torch.empty(shape, dtype=dtype, device=\\\"cpu\\\").pin_memory()\\n\\n    def _host_pool(self, rows: int, huge_page_allocator=None, *, scratch=False, body_only=False\\n                   ) -> Dict[str, torch.Tensor]:\\n        specs = {\\n            \\\"codes\\\": ((rows, self._code_bytes), torch.uint8),\\n            \\\"sign_mantissa\\\": ((rows, self._block_numel), torch.uint8),\\n            \\\"thread_bases\\\": ((rows, self._base_bytes), torch.uint8),\\n            \\\"tile_exception_offsets\\\": (\\n                (rows, self._tiles_per_block + 1), torch.int32),\\n            \\\"entries20x3\\\": ((rows, self._packed_capacity), torch.int64),\\n            \\\"num_exceptions\\\": ((rows,), torch.int32),\\n        }\\n        def allocate(shape, dtype):\\n            if scratch:\\n                return torch.empty(shape, dtype=dtype, device=\\\"cpu\\\")\\n            return self._alloc_host_tensor(shape, dtype, huge_page_allocator)\\n\\n        body = allocate((rows, self._body_stride), torch.uint8)\\n        pool = {\\\"body\\\": body}\\n        for name, (offset, nbytes, width, dtype) in self._body_layout.items():\\n            view = body[:, offset:offset + nbytes]\\n            if dtype != torch.uint8:\\n                view = view.view(dtype)\\n            pool[name] = view\\n            assert pool[name].shape == specs[name][0]\\n        if not body_only:\\n            pool[\\\"entries20x3\\\"] = allocate(specs[\\\"entries20x3\\\"][0], torch.int64)\\n        pool[\\\"num_exceptions\\\"] = (torch.zeros(rows, dtype=torch.int32) if body_only\\n                                  else allocate(specs[\\\"num_exceptions\\\"][0], torch.int32))\\n        return pool\\n\\n    def _gpu_csr_pool(self, rows: int) -> Dict[str, Dict[str, torch.Tensor]]:\\n        def side() -> Dict[str, torch.Tensor]:\\n            return {\\n                \\\"body\\\": torch.empty(\\n                    (rows, self._body_stride), dtype=torch.uint8,\\n                    device=\\\"cuda\\\"),\\n                \\\"entries20x3\\\": torch.empty(\\n                    (rows * self._packed_capacity,), dtype=torch.int64,\\n                    device=\\\"cuda\\\"),\\n                \\\"entry_word_offsets\\\": torch.empty(\\n                    (rows,), dtype=torch.int64, device=\\\"cuda\\\"),\\n            }\\n\\n        return {\\\"k\\\": side(), \\\"v\\\": side()}\\n\\n    def warmup_kv_buffers(\\n        self,\\n    def _acquire_csr_host_arena(\\n            self, length: int) -> Tuple[torch.Tensor, torch.Tensor | None]:\\n        \\\"\\\"\\\"Return an exact view backed by a retained pinned int64 arena.\\\"\\\"\\\"\\n        if length == 0:\\n            return self._csr_host_tensor(0), None\\n        capacity = 1 << (length - 1).bit_length()\\n        available = min((size for size in self._free_csr_host_arenas\\n                         if size >= capacity), default=None)\\n        if available is not None:\\n            bucket = self._free_csr_host_arenas[available]\\n            arena = bucket.pop()\\n            if not bucket:\\n                del self._free_csr_host_arenas[available]\\n        else:\\n            arena = self._csr_host_tensor(capacity)\\n        return arena[:length], arena\\n\\n    def _release_csr_plan(self, plan: _DecodePlan | None) -> None:\\n        if plan is None:\\n            return\\n        if hasattr(plan, \\\"native_plan\\\"):\\n            if plan.native_plan is not None:\\n                plan.native_plan.release_sources()\\n                plan.native_plan = None\\n            plan.h2d_done = None\\n            plan.h2d_submitted = False\\n            return\\n        plan.serial_native = None\\n        for arena in plan.host_owners:\\n            self._free_csr_host_arenas.setdefault(arena.numel(), []).append(arena)\\n        if plan.h2d_done is not None:\\n            self._free_csr_h2d_events.append(plan.h2d_done)\\n            plan.h2d_done = None\\n        plan.h2d_submitted = False\\n        plan.host_owners.clear()\\n        # Drop aliases before an arena is filled for a new generation.\\n        plan.host_offsets = ()\\n        plan.host_entries = ()\\n        plan.block_ids_cpu = None\\n\\n    def _reclaim_csr_plans(self) -> None:\\n        pending = []\\n        for plan in self._retired_csr_plans:\\n            if not getattr(plan, \\\"completion_valid\\\", True):\\n                pending.append(plan)\\n            elif plan.h2d_submitted and not plan.h2d_done.query():\\n                pending.append(plan)\\n            else:\\n                self._release_csr_plan(plan)\\n        self._retired_csr_plans = pending\\n\\n    def _retire_decode_plan(self, plan: _DecodePlan | None) -> None:\\n        if plan is None:\\n            return\\n        if not getattr(plan, \\\"completion_valid\\\", True):\\n            self._retired_csr_plans.append(plan)\\n            return\\n        if not plan.h2d_submitted:\\n            self._release_csr_plan(plan)\\n            return\\n        try:\\n            h2d_done = plan.h2d_done.query()\\n        except Exception:\\n            # A readiness-query failure cannot make request retirement\\n            # partially commit across layers.  Conservatively retain the\\n            # pinned aliases and finish detaching logical ownership; the next\\n            # reclamation/join query will surface a persistent CUDA error.\\n            self._retired_csr_plans.append(plan)\\n            return\\n        if h2d_done:\\n            self._release_csr_plan(plan)\\n        else:\\n            self._retired_csr_plans.append(plan)\\n\\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\\n        self._decode_generation[layer_id] = (\\n            self._decode_generation.get(layer_id, 0) + 1)\\n        self._decode_filtered.pop(layer_id, None)\\n        self._retire_layer_decode_plans(layer_id)\\n\\n    def _retire_layer_decode_plans(self, layer_id):\\n        self._retire_decode_plan(self._decode_plans.pop(layer_id, None))\\n        for plan in self._decode_extra_plans.pop(layer_id, {}).values():\\n            self._retire_decode_plan(plan)\\n        self._decode_chunks.pop(layer_id, None)\\n\\n    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\\n        \\\"\\\"\\\"Publish the canonical active set once for the upcoming forward.\\n\\n        ``torch_hooks.before_model_forward`` already materializes a sorted\\n        int64 NumPy array and its corresponding Python list once per step.\\n        Holding both references lets every layer replace an O(N) content\\n        comparison with an identity + integer-version check.  Direct users\\n        that do not call this method continue through the original defensive\\n        filter/content-compare path.\\n        \\\"\\\"\\\"\\n        # Timing events are unique per submitted chunk within a forward.\\n        # The loader consumes their numeric snapshots before the next reset.\\n        self._kv_side_intervals.clear()\\n        self._kv_decode_intervals.clear()\\n        self._kv_timed_layers.clear()\\n        if active_array is None:\\n            active_array = active_block_ids\\n        candidates = np.asarray(active_array, dtype=np.int64)\\n        if not candidates.flags.c_contiguous:\\n            candidates = np.ascontiguousarray(candidates)\\n        if (candidates.size > 1\\n                and bool((candidates[1:] < candidates[:-1]).any())):\\n            candidates = np.sort(candidates)\\n\\n        previous = self._prepared_active_candidates\\n        if previous is None or not np.array_equal(previous, candidates):\\n            self._prepared_active_version += 1\\n        # Keep the current step's objects alive.  The loader replaces rather\\n        # than mutates them on the next step, so no per-step copy is needed.\\n        self._prepared_active_list = active_block_ids\\n        self._prepared_active_candidates = candidates\\n\\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= bid < table.size:\\n            return -1\\n        return int(table[bid])\\n\\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\\n        if self.storage_backend == \\\"hybrid\\\":\\n            self.free_persistent_block(layer_id, block_id)\\n            return\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= block_id < table.size:\\n            return\\n        slot = int(table[block_id])\\n        if slot < 0:\\n            return\\n        self._invalidate_decode_plan(layer_id)\\n        table[block_id] = -1\\n        self._kv_slot_block[layer_id][slot] = -1\\n        self._release_physical_slot(layer_id, slot)\\n\\n    def _release_physical_slot(self, layer_id: int, slot: int) -> None:\\n        self._release_physical_slots(\\n            layer_id, np.asarray([slot], dtype=np.int64))\\n\\n    def _release_physical_slots(\\n            self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Validate standalone/deferred releases before reclaiming storage.\\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        slots = np.unique(np.asarray(slots, dtype=np.int64))\\n        if slots.size == 0:\\n            return\\n        self._kv_slot_allocator[layer_id].validate_occupied(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_validate_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n        self._reclaim_validated_slots(layer_id, slots, _profile=_profile)\\n\\n    def _reclaim_validated_slots(\\n            self, layer_id: int, slots: np.ndarray, *, _profile=None) -> None:\\n        \\\"\\\"\\\"Reclaim slots after validation under the slot-state lock.\\n\\n        The native occupied bitmap is the authority for both minimum-free\\n        allocation and exact high-water. Quarantined slots remain occupied\\n        until their writer has stopped and this method can clear their bits.\\n        \\\"\\\"\\\"\\n        if _profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        if getattr(self, \\\"storage_backend\\\", \\\"csr\\\") == \\\"hybrid\\\":\\n            for side in (\\\"k\\\", \\\"v\\\"):\\n                self._host_num_exceptions_np[layer_id][side][slots] = 0\\n        else:\\n            self._discard_persistent_csr_slots(layer_id, slots)\\n        if _profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            _profile[\\\"cd3_csr_ns\\\"] += now_ns - started_ns\\n            started_ns = now_ns\\n        self._kv_slot_allocator[layer_id].release(slots)\\n        if _profile is not None:\\n            _profile[\\\"cd3_allocator_ns\\\"] += (\\n                _time.perf_counter_ns() - started_ns)\\n            _profile[\\\"cd3_released_slots\\\"] += int(slots.size)\\n\\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\\n                         output_buffers) -> None:\\n        \\\"\\\"\\\"Decode the active set published once at the forward boundary.\\\"\\\"\\\"\\n        if self.storage_backend == \\\"hybrid\\\":\\n            self._decompress_blocks(layer_id, chunk, k_cache, v_cache,\\n                                    chunk_index=index)\\n\\n    def _restore_secondary_fallbacks(\\n            self, layer_id: int, candidates: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\\n        \\\"\\\"\\\"Restore exception-overflow rows from authoritative raw KV.\\n\\n        The host encoder retains the true exception count while safely\\n        truncating Packed20 writes at the fixed row capacity.  If either side\\n        of a K/V pair overflowed, restore both sides from ``secondary_kv`` and\\n        remove that block from the CD3 launch.  Normal rows pay no per-step\\n        metadata scan until a layer has observed an overflow.\\n        \\\"\\\"\\\"\\n        if (not self._secondary_fallback_possible.get(layer_id, False)\\n                or candidates.size == 0):\\n            return candidates\\n\\n        slots = self._kv_slot_np[layer_id][candidates]\\n        slot_ok = slots >= 0\\n        if not bool(slot_ok.any()):\\n            return candidates\\n        probe_positions = np.flatnonzero(slot_ok)\\n        probe_slots = slots[slot_ok]\\n        pools = self._host_pools[layer_id]\\n        overflow = (\\n            pools[\\\"k\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        overflow |= (\\n            pools[\\\"v\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        if not bool(overflow.any()):\\n            return candidates\\n\\n        fallback_positions = probe_positions[overflow]\\n        fallback_ids = np.ascontiguousarray(\\n            candidates[fallback_positions], dtype=np.int64)\\n        self._decode_raw_from_secondary(\\n            layer_id, fallback_ids, k_cache, v_cache)\\n        keep = np.ones(candidates.size, dtype=np.bool_)\\n        keep[fallback_positions] = False\\n        return np.ascontiguousarray(candidates[keep])\\n\\n    def _decode_raw_from_secondary(\\n            self, layer_id: int, block_ids: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n        if layer_id >= len(DualMemoryLoader.kv_caches):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV overflow fallback requires raw secondary KV, \\\"\\n                f\\\"but layer {layer_id} has no DualMemoryLoader cache\\\")\\n        secondary = getattr(\\n            DualMemoryLoader.kv_caches[layer_id], \\\"secondary_kv\\\", None)\\n        if secondary is None:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV overflow fallback requires raw secondary KV, \\\"\\n                f\\\"but layer {layer_id} has no secondary_kv\\\")\\n\\n        profile = kv_cpu_profile.new_load(layer_id, \\\"cd3_raw_fallback\\\", len(block_ids))\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        host_ids = torch.from_numpy(block_ids)\\n        with torch.cuda.stream(self.batch_decomp_stream):\\n            device_ids = kv_load_metrics.h2d(host_ids, k_cache.device)\\n            k_cache.index_copy_(\\n                0, device_ids,\\n                kv_load_metrics.h2d(secondary[0][host_ids], k_cache.device, raw=True))\\n            v_cache.index_copy_(\\n                0, device_ids,\\n                kv_load_metrics.h2d(secondary[1][host_ids], v_cache.device, raw=True))\\n\\n        if profile is not None:\\n            raw_bytes = len(block_ids) * self._block_numel * 4\\n            profile.update(raw_bytes=raw_bytes, wire_bytes=raw_bytes + len(block_ids) * 8,\\n                           body_bytes=raw_bytes, entry_bytes=0, active_entry_bytes=0,\\n                           extra_entry_bytes=0, stage_cpu_ms=(_time.perf_counter_ns() - started) / 1e6)\\n\\n    def _pack_csr_entries(\\n            self, pool: Dict[str, torch.Tensor],\\n    if result != 0:\\n        raise RuntimeError(\\n            f\\\"cudaEventSynchronize failed for CD3 CPU encode: {result}\\\")\\n\\n\\nclass ChunkDelta3KVCompressor(_ChunkDelta3KVStorage):\\n    \\\"\\\"\\\"CPU OpenMP CD3 encoder with the standard GPU CD3 decoder.\\n\\n    Raw KV is copied once to ``secondary_kv``.  A background worker waits for\\n    that D2H event and encodes directly from the host tensor into persistent\\n    physical slots, keeping encode kernels off the fused-MM critical path.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        if not _HAS_CHUNK_DELTA3 or not hasattr(\\n                _cd3_ext, \\\"host_encode_chunk_delta3_kv_blocks\\\"):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3KVCompressor requires the CPU host encoder\\\")\\n        super().__init__(comp_stream)\\n        _get_cudart()\\n        self._slot_state_lock = threading.RLock()\\n        self._deferred_slot_frees: Dict[int, set[int]] = {}\\n        self._work_queue = queue.SimpleQueue()\\n        self._work_states: Dict[int, Dict[str, Any]] = {}\\n        # Grace serving usually produces only eight newly-full blocks per\\n        # layer/step.  One large OpenMP team pays its startup cost 80 times in\\n        # series; eight small teams instead pipeline independent layers across\\n        # the same CPU budget.  Retain the established one-worker x86 default.\\n        default_workers = \\\"8\\\" if os.uname().machine == \\\"aarch64\\\" 