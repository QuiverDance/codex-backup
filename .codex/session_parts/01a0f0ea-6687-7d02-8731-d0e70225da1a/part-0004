  Required API\\n    # ------------------------------------------------------------------\\n\\n    @abstractmethod\\n    def compress(\\n        self,\\n        weight: torch.Tensor,\\n        decomp_output_tensor: Optional[torch.Tensor] = None,\\n        comp_output_tensor: Optional[CompressedTensor] = None,\\n        _sync: bool = True,\\n    ) -> CompressedTensor:\\n        \\\"\\\"\\\"Compress ``weight`` and return a :class:`CompressedTensor`.\\\"\\\"\\\"\\n\\n    @abstractmethod\\n    def decompress(\\n        self,\\n        comp: CompressedTensor,\\n        output: Optional[torch.Tensor] = None,\\n    ) -> torch.Tensor:\\n        \\\"\\\"\\\"Decompress ``comp`` into ``output`` (allocated when ``None``).\\\"\\\"\\\"\\n\\n    # ------------------------------------------------------------------\\n    #  Batched API (override for truly-batched kernels)\\n    # ------------------------------------------------------------------\\n\\n    @abstractmethod\\n    def compress_batch(\\n        self,\\n        weights: \\\"list[torch.Tensor]\\\",\\n        decomp_output_tensors: \\\"Optional[list[torch.Tensor]]\\\" = None,\\n        comp_output_tensors: \\\"Optional[list[CompressedTensor]]\\\" = None,\\n        _sync: bool = True,\\n    ) -> \\\"list[CompressedTensor]\\\":\\n        \\\"\\\"\\\"Compress a batch of weights in a single launch.\\n\\n        Subclasses with a true batched primitive (e.g. nvcomp's\\n        ``BatchedXXXCompressAsync``) should override this to avoid the\\n        per-tensor host sync incurred by the default fallback.  The base\\n        implementation (callable via ``super().compress_batch(...)``)\\n        loops over :meth:`compress`.\\n        \\\"\\\"\\\"\\n        n = len(weights)\\n        decomp_outs = decomp_output_tensors or [None] * n\\n        comp_outs = comp_output_tensors or [None] * n\\n        results: \\\"list[CompressedTensor]\\\" = []\\n        for w, d_out, c_out in zip(weights, decomp_outs, comp_outs):\\n            results.append(self.compress(w, d_out, c_out, _sync=_sync))\\n        return results\\n\\n    @abstractmethod\\n    def decompress_batch(\\n        self,\\n        comps: \\\"list[CompressedTensor]\\\",\\n        outputs: \\\"Optional[list[torch.Tensor]]\\\" = None,\\n    ) -> \\\"list[torch.Tensor]\\\":\\n        \\\"\\\"\\\"Decompress a batch of compressed tensors in a single launch.\\n\\n        Subclasses with a true batched primitive should override.  The\\n        base implementation (callable via\\n        ``super().decompress_batch(...)``) loops over :meth:`decompress`.\\n        \\\"\\\"\\\"\\n        outs = outputs or [None] * len(comps)\\n        return [self.decompress(c, o) for c, o in zip(comps, outs)]\\n\\n    # ------------------------------------------------------------------\\n    #  Async batch API\\n    # ------------------------------------------------------------------\\n    #\\n    # ``compress_batch_async`` schedules batch compression and returns\\n    # immediately; ``wait_compress_async`` blocks until the previously\\n    # scheduled work completes.  Used by the KV offload pipeline to\\n    # overlap compress with the next layer's GPU compute.\\n    #\\n    # The default implementation runs ``compress_batch`` on a private\\n    # background thread and returns a ``concurrent.futures.Future``.  This\\n    # works for any backend whose ``compress_batch`` releases the GIL\\n    # (true for the C++ ZipServ ext and for GPU paths that just enqueue\\n    # CUDA work).\\n    #\\n    # Backends with native async (e.g. KV worker pool, GPU CUDA streams)\\n    # override BOTH methods with their own signatures — typically a\\n    # caller-supplied key (such as ``layer_id``) instead of a Future.\\n    # The convention is: ``wait_compress_async`` accepts whatever object\\n    # ``compress_batch_async`` returned, OR the same key the caller\\n    # passed in.  Signatures are intentionally ``*args, **kwargs`` in\\n    # the base because per-backend they vary (KV need