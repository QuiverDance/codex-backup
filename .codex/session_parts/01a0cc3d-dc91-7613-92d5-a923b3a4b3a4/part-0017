original_token_count\":0,\"output\":\"\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"1a00a8\",\"wall_time_seconds\":0.000011073,\"exit_code\":0,\"original_token_count\":1059,\"output\":\"\\\"\\\"\\\"CPU-only checks for mixed KV transfers, missing timing and byte ratios.\\\"\\\"\\\"\\nimport csv\\nimport importlib.util\\nfrom pathlib import Path\\n\\n\\nROOT = Path(__file__).resolve().parents[1]\\n\\n\\ndef load(path):\\n    spec = importlib.util.spec_from_file_location(path.stem, path)\\n    module = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(module)\\n    return module\\n\\n\\ndef test_mixed_transfers_and_no_load_do_not_reuse_previous_values(tmp_path):\\n    module = load(ROOT / \\\"tiered_serve/kv_load_metrics.py\\\")\\n    metrics = module.KVLoadMetrics(path=tmp_path / \\\"kv_metrics.1.csv\\\")\\n    metrics.begin_forward(False, 16)\\n    metrics.transfer(1000, 1000).stats[2] = 1200  # Raw span includes holes.\\n    metrics.transfer(2000, 800).stats[2] = 1000   # Compressed plus metadata.\\n    metrics.transfer(500, 500).stats[2] = 500     # Raw overflow fallback.\\n    metrics.finish_forward()\\n    first = metrics.last\\n    assert first[\\\"kv_raw_bytes\\\"] == 3500\\n    assert first[\\\"kv_payload_bytes\\\"] == 2300\\n    assert first[\\\"kv_h2d_bytes\\\"] == 2700\\n    assert first[\\\"kv_compression_ratio\\\"] == 3500 / 2300\\n    assert first[\\\"kv_transfer_ratio\\\"] == 3500 / 2700\\n    assert first[\\\"kvload_ms\\\"] is None\\n    metrics.finish_forward()  # Both model hook and V1 wrapper may finish.\\n    metrics.begin_forward(True, 128)\\n    metrics.finish_forward()\\n    assert metrics.last[\\\"kv_h2d_bytes\\\"] == 0\\n    assert metrics.last[\\\"kv_compression_ratio\\\"] is None\\n    metrics.close()\\n    with open(tmp_path / \\\"kv_metrics.1.csv\\\") as source:\\n        assert len(list(csv.DictReader(source))) == 2\\n\\n\\ndef test_event_windows_are_summed_without_weight_subtraction_or_synchronizing():\\n    module = load(ROOT / \\\"tiered_serve/kv_load_metrics.py\\\")\\n    metrics = module.KVLoadMetrics()\\n    metrics.begin_forward(False, 16)\\n\\n    class Event:\\n        def __init__(self, timestamp, ready=True):\\n            self.timestamp, self.ready = timestamp, ready\\n\\n        def query(self):\\n            return self.ready\\n\\n        def elapsed_time(self, end):\\n            assert end.ready\\n            return end.timestamp - self.timestamp\\n\\n    # Overlapping windows on different streams are per-transfer elapsed sums.\\n    first = metrics.transfer(100, 100)\\n    first.stats[2] = 100\\n    first.events = (Event(0), Event(6))\\n    second = metrics.transfer(100, 50)\\n    second.stats[2] = 60\\n    second.events = (Event(4), Event(9))\\n    metrics.timing = True\\n    assert metrics.snapshot()[\\\"kvload_ms\\\"] == 11\\n    second.events[1].ready = False\\n    assert metrics.snapshot()[\\\"kvload_ms\\\"] is None\\n    assert metrics.snapshot()[\\\"kv_h2d_bytes\\\"] == 160\\n\\n\\ndef test_summary_uses_byte_sums_and_does_not_turn_missing_samples_into_zero(tmp_path):\\n    module = load(ROOT / \\\"tiered_serve/kv_load_metrics.py\\\")\\n    summary = load(ROOT / \\\"scripts/summarize_kv_metrics.py\\\")\\n    path = tmp_path / \\\"kv_metrics.1.csv\\\"\\n    metrics = module.KVLoadMetrics(path=path)\\n    for raw, payload, wire in ((100, 10, 20), (900, 450, 600)):\\n        metrics.begin_forward(False, 16)\\n        metrics.transfer(raw, payload).stats[2] = wire\\n        metrics.finish_forward()\\n    metrics.close()\\n    result, = summary.summarize([path])\\n    assert result[\\\"kv_compression_ratio\\\"] == 1000 / 460\\n    assert result[\\\"kv_transfer_ratio\\\"] == 1000 / 620\\n    assert result[\\\"kvload_total_ms\\\"] is None\\n    assert result[\\\"timed_forwards\\\"] == 0\\n\\n\\ndef test_unknown_transfer_coverage_is_explicitly_unavailable():\\n    module = load(ROOT / \\\"tiered_serve/kv_load_metrics.py\\\")\\n    metrics = module.KVLoadMetrics()\\n    metrics.begin_forward(False, 16)\\n    metrics.complete = False\\n    metrics.transfer(100, 50).stats[2] = 60\\n    result = metrics.snapshot()\\n    assert result[\\\"bytes_complete\\\"] == 0\\n    assert result[\\\"kv_h2d_bytes\\\"] is None\\n    assert result[\\\"kv_compression_ratio\\\"] is None\\n\\n\\ndef test_reused_transfer_keeps_the_current_layer_and_resets_between_forwards():\\n    module = load(ROOT / \\\"tiered_serve/kv_load_metrics.py\\\")\\n    metrics = module.KVLoadMetrics()\\n    metrics.begin_forward(False, 16)\\n    metrics.layer = 7\\n    first = metrics.transfer()\\n    assert first.layer == 7\\n    metrics.begin_forward(False, 16)\\n    second = metrics.transfer()\\n    assert second is first\\n    assert second.layer == -1\\n    metrics.layer = 3\\n    assert metrics.transfer().layer == 3\\n\"}}"},{"type":"input_text","text":"{\"current_time\":\"2026-09-23 05:03:16 UTC\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0cc9e-4b8e-7211-ba96-c841b5155eb7","create_time":1790139796.5412607}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
