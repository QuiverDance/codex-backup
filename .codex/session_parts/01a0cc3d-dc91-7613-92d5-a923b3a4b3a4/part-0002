\\"cd3_alignment_bytes\\\"])\\n            assert snapshot[\\\"cd3_gap_bytes\\\"] == 0\\n        return snapshot\\n\\n    try:\\n        submit(ids, 1)\\n        decode(ids[:2])\\n        cached_plan = compressor._decode_plans[0]\\n        if storage == \\\"hybrid\\\":\\n            other_source = [torch.full_like(values, 7).pin_memory() for values in source]\\n            submit(ids[:2], 1, layer_id=1, values=other_source)\\n            # Interleaved layers bring the cached plan back to its original\\n            # ring. Different layer data makes stale ring contents observable.\\n            decode(ids[:2], layer_id=1, expected_source=other_source)\\n        decode(ids[:2])\\n        assert compressor._decode_plans[0] is cached_plan\\n        if storage == \\\"hybrid\\\":\\n            assert cached_plan.native_plan is not None\\n            assert not hasattr(cached_plan, \\\"native_plans\\\")  # One plan for both rings.\\n            # A subsequent submission uses the other ring with the same plan.\\n            decode(ids[:2])\\n            assert compressor._decode_plans[0] is cached_plan\\n        decode(ids)  # Multiple staging chunks, including both ring slots.\\n        decode(ids[::2])  # Sparse records must not copy inactive prefixes.\\n        compressor.free_persistent_blocks([3, 8])\\n        for values in source:\\n            values[3].fill_(2)\\n            values[8].fill_(4)\\n        submit([3, 8], 2)\\n        decode(ids)\\n        assert torch.all(output[0][0] == -5)\\n        if storage == \\\"hybrid\\\" and execution == \\\"pipeline\\\":\\n            old_values = [values[3].clone() for values in source]\\n            with torch.cuda.stream(compressor.load_kv_stream):\\n                torch.cuda._sleep(10_000_000)\\n            compressor.prepare_active_set(ids, np.asarray(ids, dtype=np.int64))\\n            compressor.decompress_batch(0, ids, output)\\n            with torch.cuda.stream(compressor.batch_decomp_stream):\\n                old_output = [values[3].clone() for values in output]\\n            # Reuse the physical slot while its preceding H2D is still queued.\\n            # The encoder must wait before overwriting that body's source row.\\n            compressor.free_persistent_blocks([3])\\n            for values in source:\\n                values[3].fill_(8)\\n            submit([3], 3)\\n            decode(ids)\\n            for actual, expected in zip(old_output, old_values):\\n                assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n        compressor.stop_kv_compress_workers()  # Explicit cleanup is idempotent.\\n        metrics.close()\\n\\\"\\\"\\\"Opt-in CD3 CPU diagnostics for the in-process offline runner.\\n\\nWorker timestamps use the same monotonic CPU clock as consumer timestamps.\\nNo waits, CUDA events, or file I/O are introduced by this module. Records are\\nowned by one queued job; its worker finishes writing before the existing done\\nevent wakes the consumer. Snapshotting never waits for unfinished workers.\\n\\\"\\\"\\\"\\nimport time\\n\\n\\nCOLUMNS = (\\n    \\\"enqueue_batch\\\", \\\"enqueue_step\\\", \\\"consume_batch\\\", \\\"consume_step\\\",\\n    \\\"layer\\\", \\\"blocks\\\", \\\"join_site\\\", \\\"worker_done\\\", \\\"joined\\\",\\n    \\\"enqueue_ns\\\", \\\"worker_start_ns\\\", \\\"worker_done_ns\\\", \\\"join_start_ns\\\",\\n    \\\"join_end_ns\\\", \\\"queue_ms\\\", \\\"raw_d2h_wait_ms\\\", \\\"prior_h2d_wait_ms\\\",\\n    \\\"encode_ms\\\", \\\"csr_ms\\\", \\\"worker_ms\\\", \\\"worker_wait_ms\\\",\\n    \\\"publish_ms\\\", \\\"deferred_free_ms\\\", \\\"join_ms\\\", \\\"packing_ms\\\",\\n)\\n_enabled = False\\n_batch = -1\\n_step = -1\\n_records = []\\n_loads = []\\n_pending_loads = []\\n_sampled_load = False\\nLOAD_COLUMNS = (\\n    \\\"batch\\\", \\\"step\\\", \\\"layer\\\", \\\"backend\\\", \\\"blocks\\\", \\\"raw_bytes\\\", \\\"wire_bytes\\\",\\n    \\\"body_bytes\\\", \\\"entry_bytes\\\", \\\"active_entry_bytes\\\", \\\"extra_entry_bytes\\\",\\n    \\\"span_count\\\", \\\"copy_count\\\", \\\"plan_hit\\\", \\\"plan_cpu_ms\\\", \\\"stage_cpu_ms\\\",\\n    \\\"native_prepare_cpu_ms\\\", \\\"native_sort_cpu_ms\\\", \\\"gpu_sampled\\\",\\n    \\\"gpu_complete\\\", \\\"h2d_window_ms\\\", \\\"decode_window_ms\\\", \\\"ring_wait_ms\\\",\\n    \\\"k_h2d_ms\\\", \\\"v_h2d_ms\\\", \\\"k_decomp_ms\\\", \\\"v_decomp_ms\\\", \\\"chunk_ready_ms\\\",\\n    \\\"k_decomp_v_load_overlap_ms\\\", \\\"batch_api_calls\\\", \\\"effective_execution\\\",\\n    \\\"live_payload_bytes\\\", \\\"segment_capacity_bytes\\\", \\\"dead_bytes\\\", \\\"unused_bytes\\\",\\n    \\\"scratch_bytes\\\", \\\"gpu_staging_bytes\\\", \\\"planner_reserved_bytes\\\",\\n    \\\"planner_visited_records\\\", \\\"planner_selected_segments\\\", \\\"planner_new_allocations\\\",\\n)\\n\\n\\n\\ndef begin_run(enabled):\\n    global _enabled, _batch, _step, _sampled_load\\n    _sampled_load = False\\n    _enabled = enabled\\n    _batch = _step = -1\\n    _records.clear()\\n    _loads.clear()\\n    _pending_loads.clear()\\n\\n\\ndef set_step(batch, step):\\n    global _batch, _step, _sampled_load\\n    _batch, _step = batch, step\\n    _sampled_load = False\\n\\n\\ndef new_job(layer, blocks):\\n    if not _enabled:\\n        return None\\n    record = dict.fromkeys(COLUMNS)\\n    record.update(\\n        enqueue_batch=_batch, enqueue_step=_step, layer=layer, blocks=blocks,\\n        worker_done=0, joined=0, encode_ms=0.0, csr_ms=0.0, packing_ms=0.0,\\n        enqueue_ns=time.perf_counter_ns(),\\n    )\\n    _records.append(record)\\n    return record\\n\\n\\ndef begin_join(record, site):\\n    record.update(consume_batch=_batch, consume_step=_step, join_site=site,\\n                  join_start_ns=time.perf_counter_ns())\\n\\n\\ndef snapshot():\\n    # Copy each record once. Do not force completion of terminal jobs merely\\n    # to populate a diagnostic CSV. Missing measurements remain NA, not zero.\\n    return [record.copy() for record in _records]\\n\\n\\ndef write_csv(file):\\n    file.write(\\\" \\\".join(COLUMNS) + \\\"\\\\n\\\")\\n    for record in snapshot():\\n        file.write(\\\" \\\".join(\\n            \\\"NA\\\" if record[column] is None else str(record[column])\\n            for column in COLUMNS) + \\\"\\\\n\\\")\\n\\n\\ndef new_load(layer, backend, blocks, n_layers=1):\\n    global _sampled_load\\n    if not _enabled:\\n        return None\\n    sample = (backend == \\\"cd3\\\" and layer == _step % n_layers\\n              and not _sampled_load)\\n    _sampled_load |= sample\\n    record = dict.fromkeys(LOAD_COLUMNS)\\n    record.update(batch=_batch, step=_step, layer=layer, backend=backend,\\n                  blocks=blocks, gpu_sampled=int(sample), gpu_complete=0)\\n    _loads.append(record)\\n    _pending_loads.append(record)\\n    return record\\n\\n\\ndef collect_loads():\\n    # Called after the existing engine.step timer. Never wait or keep event\\n    # references that may be re-recorded by the next step. Incomplete = NA.\\n    for record in _pending_loads:\\n        pairs = record.pop(\\\"_events\\\", ())\\n        if pairs and all(end.query() for _, _, end in pairs):\\n            for name, begin, end in pairs:\\n                record[name] = begin.elapsed_time(end)\\n            pipeline_events = record.pop(\\\"_pipeline_events\\\", None)\\n            if pipeline_events is not None:\\n                origin = pipeline_events[0]\\n                k_begin, k_end, v_begin, v_end = (\\n                    origin.elapsed_time(pipeline_events[index]) for index in (4, 5, 2, 3))\\n                record[\\\"k_decomp_v_load_overlap_ms\\\"] = max(\\n                    0.0, min(k_end, v_end) - max(k_begin, v_begin))\\n            record[\\\"gpu_complete\\\"] = 1\\n    _pending_loads.clear()\\n\\n\\ndef write_load_csv(file):\\n    file.write(\\\" \\\".join(LOAD_COLUMNS) + \\\"\\\\n\\\")\\n    for record in _loads:\\n        file.write(\\\" \\\".join(\\n            \\\"NA\\\" if record[column] is None else str(record[column])\\n            for column in LOAD_COLUMNS) + \\\"\\\\n\\\")\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Summarize KV traffic across workers, without importing torch or CUDA.\\n\\nThe byte sums cover recorded model forwards (including repeated KV loads).\\nServing rows are not attributable to the client's trimmed request cohort.\\n\\\"\\\"\\\"\\nimport argparse\\nimport csv\\nfrom pathlib import Path\\n\\n\\nBYTE_FIELDS = (\\\"kv_raw_bytes\\\", \\\"kv_payload_bytes\\\", \\\"kv_h2d_bytes\\\")\\nCD3_FIELDS = (\\\"cd3_k_h2d_bytes\\\", \\\"cd3_v_h2d_bytes\\\", \\\"cd3_metadata_bytes\\\",\\n              \\\"cd3_alignment_bytes\\\", \\\"cd3_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\")\\n\\n\\ndef summarize(paths):\\n    groups = {}\\n    for path in paths:\\n        with open(path, newline=\\\"\\\") as source:\\n            for row in csv.DictReader(source):\\n                key = (row[\\\"config\\\"], row[\\\"batch\\\"], row[\\\"phase\\\"])\\n                if key not in groups:\\n                    groups[key] = dict(\\n                        config=key[0], batch=key[1], phase=key[2],\\n                        forwards=0, transfers=0, bytes_complete_forwards=0,\\n                        timed_forwards=0, **dict.fromkeys(BYTE_FIELDS, 0),\\n                        kvload_total_ms=0.0)\\n                    groups[key].update(dict.fromkeys(CD3_FIELDS, 0))\\n                    groups[key][\\\"cd3_accounted_forwards\\\"] = 0\\n                group = groups[key]\\n                group[\\\"forwards\\\"] += 1\\n                group[\\\"transfers\\\"] += int(row[\\\"transfers\\\"])\\n                if row[\\\"bytes_complete\\\"] == \\\"1\\\":\\n                    group[\\\"bytes_complete_forwards\\\"] += 1\\n                    for field in BYTE_FIELDS:\\n                        group[field] += int(row[field])\\n                if row[\\\"timing_complete\\\"] == \\\"1\\\":\\n                    group[\\\"timed_forwards\\\"] += 1\\n                    group[\\\"kvload_total_ms\\\"] += float(row[\\\"kvload_ms\\\"])\\n                if row.get(\\\"cd3_k_h2d_bytes\\\") not in (None, \\\"NA\\\", \\\"\\\"):\\n                    group[\\\"cd3_accounted_forwards\\\"] += 1\\n                    for field in CD3_FIELDS:\\n                        group[field] += int(row[field])\\n    for group in groups.values():\\n        if group[\\\"bytes_complete_forwards\\\"] != group[\\\"forwards\\\"]:\\n            for field in BYTE_FIELDS:\\n                group[field] = None\\n        raw = group[\\\"kv_raw_bytes\\\"]\\n        payload, wire = group[\\\"kv_payload_bytes\\\"], group[\\\"kv_h2d_bytes\\\"]\\n        group[\\\"kv_compression_ratio\\\"] = raw / payload if payload else None\\n        group[\\\"kv_transfer_ratio\\\"] = raw / wire if wire else None\\n        group[\\\"kv_h2d_payload_ratio\\\"] = wire / payload if payload else None\\n        if not group[\\\"cd3_accounted_forwards\\\"]:\\n            for field in CD3_FIELDS:\\n                group[field] = None\\n        if group[\\\"timed_forwards\\\"] != group[\\\"forwards\\\"]:\\n            group[\\\"kvload_total_ms\\\"] = None\\n        elapsed = group[\\\"kvload_total_ms\\\"]\\n        group[\\\"kvload_mean_ms\\\"] = (elapsed / group[\\\"forwards\\\"]\\n                                   if elapsed is not None else None)\\n    return list(groups.values())\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"directory\\\", type=Path)\\n    parser.add_argument(\\\"--output\\\", required=True, type=Path)\\n    args = parser.parse_args()\\n    rows = summarize(sorted(args.directory.glob(\\\"kv_metrics.*.csv\\\")))\\n    if not rows:\\n        parser.error(f\\\"no recorded KV metrics in {args.directory}\\\")\\n    with args.output.open(\\\"w\\\", newline=\\\"\\\") as output:\\n        writer = csv.DictWriter(output, fieldnames=list(rows[0]))\\n        writer.writeheader()\\n        for row in rows:\\n            writer.writerow({key: \\\"NA\\\" if value is None else value\\n                             for key, value in row.items()})\\n    print(f\\\"KV metrics summary: {args.output}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0cc3d-e258-7f21-a2a5-f8814ec55fb0","create_time":1790133209.490574}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
