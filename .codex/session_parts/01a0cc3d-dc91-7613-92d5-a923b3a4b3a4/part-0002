value\\n\\n    def add_payload(self, raw_bytes, payload_bytes):\\n        self.raw_bytes += raw_bytes\\n        self.payload_bytes += payload_bytes\\n\\n    def transfer(self, raw_bytes=0, payload_bytes=0):\\n        if self.count == len(self.pool):\\n            self.pool.append(Transfer(self.timing))\\n        item = self.pool[self.count]\\n        self.count += 1\\n        item.layer = self.layer\\n        item.stats[:] = [raw_bytes, payload_bytes, 0]\\n        return item\\n\\n    def transfers(self):\\n        return [item for item in self.pool[:self.count] if item.stats[2] > 0]\\n\\n    def snapshot(self):\\n        items = self.transfers()\\n        raw, payload, wire = (sum(item.stats[i] for item in items)\\n                              for i in range(3))\\n        raw += self.raw_bytes\\n        payload += self.payload_bytes\\n        timing_complete = self.timing and self.complete\\n        elapsed = 0.0\\n        if timing_complete:\\n            for item in items:\\n                begin, end = item.events\\n                if not end.query():\\n                    timing_complete = False\\n                    break\\n                elapsed += begin.elapsed_time(end)\\n        result = dict(\\n            forward=self.forward, batch=self.batch, step=self.step,\\n            config=self.config, phase=self.phase, tokens=self.tokens,\\n            kv_raw_bytes=raw if self.complete else None,\\n            kv_payload_bytes=payload if self.complete else None,\\n            kv_h2d_bytes=wire if self.complete else None,\\n            kv_compression_ratio=(raw / payload if payload and self.complete else None),\\n            kv_transfer_ratio=(raw / wire if wire and self.complete else None),\\n            kvload_ms=elapsed if timing_complete else None,\\n            transfers=len(items), bytes_complete=int(self.complete),\\n            timing_complete=int(timing_complete))\\n        result.update({key: self.cd3.get(key) for key in (*CD3_COUNTERS, *CD3_MODES)})\\n        return result\\n\\n    def finish_forward(self):\\n        if not self.active:\\n            return\\n        self.last = self.snapshot()\\n        if self.file:\\n            self.writer.writerow({key: \\\"NA\\\" if value is None else value\\n                                  for key, value in self.last.items()})\\n        self.active = False\\n\\n\\ndef configure(*, timing=False, log_dir=None, capacity=0):\\n    global _collector, _generation\\n    if _collector:\\n        _collector.close()\\n    enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n    if not enabled and not timing:\\n        _collector = None\\n        return None\\n    directory = os.getenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\") or log_dir\\n    _generation += 1\\n    path = (str(Path(directory) / f\\\"kv_metrics.{os.getpid()}.{_generation}.csv\\\")\\n            if enabled and directory else None)\\n    _collector = KVLoadMetrics(timing=timing, path=path, capacity=capacity)\\n    return _collector\\n\\n\\ndef current():\\n    return _collector if _collector is not None and _collector.active else None\\n\\n\\ndef set_context(batch, step, config):\\n    if _collector is not None:\\n        _collector.batch, _collector.step, _collector.config = batch, step, config\\n\\n\\ndef h2d(source, device, *, raw=False):\\n    \\\"\\\"\\\"Account for a standalone H2D, keeping destination allocation outside timing.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return source.to(device, non_blocking=True)\\n    size = source.nbytes\\n    item = metrics.transfer(size if raw else 0, size if raw else 0)\\n    if metrics.timing:\\n        import torch\\n        destination = torch.empty_like(source, device=device)\\n        stream = torch.cuda.current_stream(device)\\n        item.begin(stream)\\n        destination.copy_(source, non_blocking=True)\\n        item.end(stream)\\n    else:\\n        destination = source.to(device, non_blocking=True)\\n    item.stats[2] = size\\n    return destination\\n\\n\\ndef copy_into(destination, source):\\n    metrics = current()\\n    if metrics is None:\\n        return destination.copy_(source, non_blocking=True)\\n    import torch\\n    item = metrics.transfer()\\n    stream = torch.cuda.current_stream(destination.device)\\n    item.begin(stream)\\n    destination.copy_(source, non_blocking=True)\\n    item.end(stream)\\n    item.stats[2] = source.nbytes\\n    return destination\\n\\n\\ndef submit(function, *args):\\n    \\\"\\\"\\\"Native descriptor builders return actual H2D bytes after submission.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return function(*args)\\n    item = metrics.transfer()\\n    item.stats[2] = function(*args, *item.handles)\\n    return item.stats[2]\\n\\n    def stop_kv_compress_workers(self) -> None:\\n        workers = list(getattr(self, \\\"_workers\\\", ()))\\n        for _ in workers:\\n            self._work_queue.put(None)\\n        for worker in workers:\\n            worker.join()\\n        self._workers = []\\n        errors = []\\n        for layer_id in list(self._pending_compress):\\n            try:\\n                self.wait_compress_async(layer_id, self._block_shape, _join_site=\\\"shutdown\\\")\\n            except BaseException as error:\\n                errors.append(error)\\n        # Explicit shutdown may drain; final-reference free callbacks never do.\\n        if self._kv_pools_ready:\\n            if self.load_kv_stream is not None:\\n                self.load_kv_stream.synchronize()\\n            self.batch_decomp_stream.synchronize()\\n            for plan in self._decode_plans.values():\\n                self._release_csr_plan(plan)\\n            self._decode_plans.clear()\\n            for plan in self._retired_csr_plans:\\n                self._release_csr_plan(plan)\\n            self._retired_csr_plans.clear()\\n            for store in self._hybrid_stores.values():\\n                store.clear()\\n            self._hybrid_stores.clear()\\n            if self._entry_pool is not None:\\n                self._entry_pool.close()\\n                self._entry_pool = None\\n                if self._hybrid_allocator is not None:\\n                    for arena in self._entry_arenas:\\n                        self._hybrid_allocator.free(arena)\\n                self._entry_arenas.clear()\\n                self._worker_encode_scratch.clear()\\n                while not self._hybrid_scratch_queue.empty():\\n                    self._hybrid_scratch_queue.get_nowait()\\n                for ownership in self._hybrid_ownership.values():\\n                    ownership.clear()\\n        if errors:\\n            raise errors[0]\\n\"}}"},{"type":"input_text","text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"d93744\",\"wall_time_seconds\":0.000016672,\"exit_code\":0,\"original_token_count\":3616,\"output\":\"\\\"\\\"\\\"Hybrid body slots and exception scratch must use independent row routing.\\\"\\\"\\\"\\n\\nimport pytest\\nimport torch\\n\\n\\ndef body_fields(slots, rows, columns, delta_bits, base_rows):\\n    tiles = rows * columns // 4096\\n    widths = (rows * columns * delta_bits // 8, rows * columns,\\n              tiles * (256 // base_rows), (tiles + 1) * 4)\\n    stride = (sum(widths) + 127) // 128 * 128\\n    storage = torch.full((slots, stride), 0xA5, dtype=torch.uint8)\\n    fields = []\\n    offset = 0\\n    for index, width in enumerate(widths):\\n        field = storage[:, offset:offset + width]\\n        fields.append(field.view(torch.int32) if index == 3 else field)\\n        offset += width\\n    return storage, fields\\n\\n\\ndef scratch(rows, capacity):\\n    # Strides also differ from persistent body strides.\\n    entries = torch.full((rows, capacity + 2), -1, dtype=torch.int64)[:, :capacity]\\n    counts = torch.full((rows * 2,), -1, dtype=torch.int32)[::2]\\n    return entries, counts\\n\\n\\n@pytest.mark.parametrize(\\\"capacity\\\", [1, (128 * 128 + 2) // 3])\\ndef test_hybrid_matches_existing_encoder_with_independent_scratch_rows(capacity):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext as ext\\n\\n    rows = columns = 128\\n    generator = torch.Generator().manual_seed(731)\\n    sources = [torch.randint(-32768, 32768, (4, rows, columns),\\n                             dtype=torch.int16, generator=generator)\\n               for _ in range(2)]\\n    sources[0][0].zero_()  # Include a record with no exception entries.\\n    ids = torch.tensor([3, 0, 2], dtype=torch.int64)\\n    slots = torch.tensor([5, 1, 4], dtype=torch.int64)\\n    existing = [body_fields(7, rows, columns, ext.kv_delta_bits,\\n                            ext.compiled_base_rows()) for _ in range(2)]\\n    hybrid = [body_fields(7, rows, columns, ext.kv_delta_bits,\\n                          ext.compiled_base_rows()) for _ in range(2)]\\n    old_scratch = [scratch(7, capacity) for _ in range(2)]\\n    chunk_scratch = [scratch(4, capacity) for _ in range(2)]\\n    ext.host_encode_chunk_delta3_kv_blocks(\\n        *sources, ids, slots,\\n        [*existing[0][1], *old_scratch[0]],\\n        [*existing[1][1], *old_scratch[1]], rows, columns)\\n    ext.host_encode_chunk_delta3_kv_hybrid_blocks(\\n        *sources, ids, slots, hybrid[0][1], hybrid[1][1],\\n        chunk_scratch[0][0], chunk_scratch[1][0],\\n        chunk_scratch[0][1], chunk_scratch[1][1], rows, columns)\\n\\n    for (expected_body, _), (actual_body, _), old, new in zip(\\n            existing, hybrid, old_scratch, chunk_scratch):\\n        assert torch.equal(actual_body, expected_body)\\n        assert torch.equal(new[0][:len(ids)], old[0][slots])\\n        assert torch.equal(new[1][:len(ids)], old[1][slots])\\n        assert (new[0][len(ids):] == -1).all()\\n        assert (new[1][len(ids):] == -1).all()\\n        if capacity == 1:\\n            # Report the true count so the caller can select raw fallback.\\n            assert int(new[1][0]) > capacity * 3\\n        else:\\n            assert (new[1][:len(ids)] <= capacity * 3).all()\\n\\n\\n@pytest.mark.parametrize(\\\"invalid\\\", [\\\"scratch_rows\\\", \\\"body_slot\\\", \\\"duplicate_slot\\\"])\\ndef test_hybrid_rejects_invalid_routing_before_either_side_writes(invalid):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext as ext\\n\\n    rows = columns = 64\\n    sources = [torch.zeros((3, rows, columns), dtype=torch.int16) for _ in range(2)]\\n    ids = torch.tensor([2, 0, 1], dtype=torch.int64)\\n    slots = torch.tensor([4, 1, 3], dtype=torch.int64)\\n    bodies = [body_fields(5, rows, columns, ext.kv_delta_bits,\\n                          ext.compiled_base_rows()) for _ in range(2)]\\n    chunks = [scratch(3, 1), scratch(2 if invalid == \\\"scratch_rows\\\" else 3, 1)]\\n    if invalid == \\\"body_slot\\\":\\n        slots[-1] = 5\\n    elif invalid == \\\"duplicate_slot\\\":\\n        slots[-1] = slots[0]\\n    with pytest.raises(RuntimeError, match=\\\"entries20x3|slot\\\"):\\n        ext.host_encode_chunk_delta3_kv_hybrid_blocks(\\n            *sources, ids, slots, bodies[0][1], bodies[1][1],\\n            chunks[0][0], chunks[1][0], chunks[0][1], chunks[1][1], rows, columns)\\n    assert all((storage == 0xA5).all() for storage, _ in bodies)\\n    assert all((buffer == -1).all() for side in chunks for buffer in side)\\n#!/usr/bin/env bash\\n# Run the canonical 70B offline performance matrix in isolated processes.\\n\\nset -Eeuo pipefail\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\nREPO_ROOT=\\\"$(cd \\\"${SCRIPT_DIR}/../..\\\" && pwd)\\\"\\n\\nMODEL=\\\"meta-llama/Llama-3.1-70B-Instruct\\\"\\nINPUT_SEQ_LEN=1020\\nGEN_TOKENS=129\\nWARMUP=16\\nPREFILL_CHUNK=8192\\nREPEATS=3\\nKV_BACKEND=\\\"p4flat\\\"\\nCD3_KV_DELTA_BITS=3\\nCD3_KV_DECODE_THREADS=auto\\nCD3_KV_STORAGE=hybrid\\nCD3_KV_EXECUTION=pipeline\\nDEDICATED_KV_BLOCKS=auto\\nGPU_INDEX=0\\nNUMA_NODE=0\\nWEIGHT_HUGE_PAGES=14\\nMAX_IDLE_HBM_MIB=1024\\nCLEANUP_TIMEOUT=120\\nOUTPUT_ROOT=\\\"${REPO_ROOT}/benchmark_results/offline_suite\\\"\\nDRY_RUN=0\\nCHECK_ONLY=0\\nBREAKDOWN=0\\nSTART_FROM=\\\"\\\"\\nBATCHES=(1 16 32 64 96 128)\\n\\nPYTHON=\\\"${REPO_ROOT}/.venv/bin/python\\\"\\nDRIVER=\\\"${REPO_ROOT}/offline_offload_kvweight.py\\\"\\nSTACK_POOL=\\\"${REPO_ROOT}/etc/stack_pool.so\\\"\\nHUGEPAGE_SYSFS=\\\"/sys/kernel/mm/hugepages/hugepages-16777216kB\\\"\\n\\nMETHODS=(\\n  flexgen\\n  flexgen-zipserv\\n  flexgen-zipserv-fused\\n  cao-zipserv\\n  cao-zipserv-fused\\n  cao-zipserv-fused-kvcomp\\n  cao-p4flat-fused\\n  cao-p4flat-fused-kvcomp\\n  cao-cd3\\n  cao-cd3-fused\\n  cao-cd3-fused-kvcomp\\n)\\n\\nusage() {\\n  cat <<'EOF'\\nUsage: bash scripts/offline/run_performance_suite.sh [OPTIONS]\\n\\nKV byte counts and compression/transfer ratios are always saved to the\\nper-run kv_metrics directory and linked from summary.tsv. GPU timing remains\\nopt-in through --breakdown.\\n\\nRuns the configured offline performance matrix. Every configuration and\\nrepeat starts a fresh Python process. The next run starts only after the GPU,\\n16 GiB HugePages, and tiered-serve processes return to an idle state.\\n\\nOptions:\\n  --methods LIST          Comma/space-separated method IDs (default: all)\\n  --batches LIST          Comma/space-separated batches (default: 1,16,32,64,96,128)\\n  --repeats N             Fresh-process repeats per method (default: 3)\\n  --input-seq-len N       Random input tokens per request (default: 1020)\\n  --gen N                 Tokens generated per request (default: 129)\\n  --warmup N              Initial per-request token intervals excluded (default: 16)\\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\\n  --kv-backend NAME       KV codec for configurable kvcomp cells (default: p4flat)\\n  --cd3-kv-delta-bits N   KV exponent delta width: 3 or 4 (default: 3);\\n                          only cao-cd3-fused-kvcomp changes, weights stay 3-bit\\n  --cd3-kv-decode-