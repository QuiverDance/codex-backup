\\\", \\\"serial\\\"), (\\\"hybrid\\\", \\\"pipeline\\\"),\\n])\\ndef test_cd3_async_storage_and_pipeline(monkeypatch, storage, execution):\\n    if not torch.cuda.is_available():\\n        pytest.skip(\\\"CUDA required\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", storage)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_EXECUTION\\\", execution)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_WORKERS\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_PIN\\\", \\\"0\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\\\", \\\"2\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"1\\\")\\n    from tiered_serve import kv_load_metrics\\n    from tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3KVCompressor\\n    from tiered_serve.kv_tail_residency import KVBlockOwnership\\n\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.Stream())\\n    compressor.load_kv_stream = torch.cuda.Stream()\\n    compressor._tb = True\\n    compressor.warmup_kv_buffers(\\n        (64, 64), 16, n_layers=2 if storage == \\\"hybrid\\\" else 1,\\n        max_gpu_decomp_blocks=2)\\n    if storage == \\\"hybrid\\\":\\n        def unexpected_backing_allocation(*args, **kwargs):\\n            raise AssertionError(\\\"hybrid append must reuse its reserved backing arenas\\\")\\n        monkeypatch.setattr(compressor, \\\"_alloc_host_tensor\\\", unexpected_backing_allocation)\\n    metrics = kv_load_metrics.configure(timing=True)\\n    ids = [1, 3, 4, 8, 12]\\n    source = [torch.ones((17, 64, 64), dtype=torch.bfloat16).pin_memory() for _ in range(2)]\\n    for side, values in enumerate(source):\\n        bits = values.view(torch.int16).view(17, -1)\\n        for index, block in enumerate(ids):\\n            # Vary exact exception counts and include signed zero, infinity,\\n            # subnormal and NaN payloads without overflowing