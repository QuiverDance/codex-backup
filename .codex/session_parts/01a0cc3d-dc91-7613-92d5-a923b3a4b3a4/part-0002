_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\",\\n\\\"\\\"\\\"KV H2D accounting shared by offline and serving.\\n\\nBytes count submitted memcpy payloads, not link-protocol traffic. Compression\\nratio is dense-equivalent bytes / active encoded payload bytes; transfer ratio\\nalso includes routing metadata, padding, and extra rows actually copied.\\nRatios over multiple forwards must be computed from byte sums, not averaged.\\nCUDA timing is opt-in and reports a submission window, not copy-engine activity.\\n\\\"\\\"\\\"\\nimport atexit\\nimport csv\\nimport os\\nfrom pathlib import Path\\n\\n\\nCOLUMNS = (\\n    \\\"forward\\\", \\\"batch\\\", \\\"step\\\", \\\"config\\\", \\\"phase\\\", \\\"tokens\\\", \\\"kv_raw_bytes\\\", \\\"kv_payload_bytes\\\",\\n    \\\"kv_h2d_bytes\\\", \\\"kv_compression_ratio\\\", \\\"kv_transfer_ratio\\\",\\n    \\\"kvload_ms\\\", \\\"transfers\\\", \\\"bytes_complete\\\", \\\"timing_complete\\\",\\n    \\\"cd3_k_h2d_bytes\\\", \\\"cd3_v_h2d_bytes\\\", \\\"cd3_metadata_bytes\\\",\\n    \\\"cd3_alignment_bytes\\\", \\\"cd3_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\",\\n    \\\"cd3_storage_requested\\\", \\\"cd3_storage_effective\\\", \\\"cd3_execution_requested\\\",\\n    \\\"cd3_execution_effective\\\", \\\"cd3_fallback_reason\\\",\\n)\\nCD3_COUNTERS = COLUMNS[15:22]\\nCD3_MODES = COLUMNS[22:]\\n_collector = None\\n_generation = 0\\n\\n\\nclass Transfer:\\n    def __init__(self, timing):\\n        # Native staging fills this reusable list before the begin event.\\n        self.stats = [0, 0, 0]  # dense-equivalent, encoded payload, H2D\\n        self.layer = -1\\n        self.events = None\\n        self.handles = (0, 0)\\n        if timing:\\n            import torch\\n            self.events = tuple(torch.cuda.Event(enable_timing=True)\\n                                for _ in range(2))\\n            for event in self.events:\\n                event.record()  # Materialize native handles