1:]:\n            values[block].view(-1)[::32] = 0\n    routing = tuple(KVBlockOwnership(\n        block_id=bid, canonical_block_id=bid + 100, request_id=f\"req-{bid}\",\n        block_index=bid, generation=1) for bid in ids)\n    output = [torch.empty_like(values, device=\"cuda\") for values in source]\n    try:\n        compressor.compress_batch_async_from_host(0, ids, *source, ownership=routing)\n        compressor.wait_compress_async(0, (64, 64))\n        # Inactive exception-bearing rows exceed GPU staging. The requested\n        # row has no exceptions, so selected-entry repacking returns no bytes.\n        capacity = compressor._gpu_decomp_pool_ring[0][\"k\"][\"entries20x3\"].numel()\n        assert compressor._persistent_csr[0][\"k\"].used_words > capacity\n        selected = [1]\n        compressor.prepare_active_set(selected, np.asarray(selected, dtype=np.int64))\n        compressor.decompress_batch(0, selected, output)\n        compressor.batch_decomp_stream.synchronize()\n        plan = compressor._decode_plans[0]\n        assert plan.offsets_are_compact and plan.entry_words == (0, 0)\n        for actual, expected in zip(output, source):\n            assert torch.equal(actual[1].cpu().view(torch.int16), expected[1].view(torch.int16))\n    finally:\n        compressor.stop_kv_compress_workers()\n"}},"status":"completed"}}
