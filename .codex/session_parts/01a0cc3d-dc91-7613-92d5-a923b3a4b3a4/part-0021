ffsets(std::move(k_offsets_)), v_offsets(std::move(v_offsets_)),\\n          output_blocks(std::move(output_blocks_)),\\n          output_blocks_host(std::move(output_blocks_host_)),\\n          k_offsets_host(std::move(k_offsets_host_)),\\n          v_offsets_host(std::move(v_offsets_host_)),\\n          k_entry_word_counts_host(std::move(k_entry_word_counts_host_)),\\n          v_entry_word_counts_host(std::move(v_entry_word_counts_host_)),\\n          device(k_body.device())\\n    {\\n        TORCH_CHECK(device.is_cuda(), \\\"CD3 staging must be on CUDA\\\");\\n        TORCH_CHECK(rows_ > 0 && columns_ > 0 && rows_ % kTileDim == 0\\n                        && columns_ % kTileDim == 0\\n                        && rows_ <= (std::numeric_limits<int>::max() / 2) / columns_,\\n                    \\\"CD3 block dimensions must be positive multiples of 64 within int32\\\");\\n        rows = rows_;\\n        columns = columns_;\\n        block_elements = rows * columns;\\n        tiles_per_block = block_elements / kTileElements;\\n        sm_offset = tiles_per_block * (kTileElements * kKVDeltaBits / 8);\\n        base_offset = sm_offset + block_elements;\\n        offsets_offset = (base_offset + tiles_per_block * kBasesPerTile + 3) / 4 * 4;\\n        body_bytes = (offsets_offset + (tiles_per_block + 1) * 4 + 7) / 8 * 8;\\n        check_host_long_vector(output_blocks_host, \\\"output blocks\\\");\\n        TORCH_CHECK(output_blocks_host.numel() > 0\\n                        && output_blocks_host.numel() <= 65535,\\n                    \\\"CD3 staging chunk must contain 1..65535 records\\\");\\n        num_blocks = output_blocks_host.numel();\\n        check_device_vector(output_blocks, \\\"output blocks\\\");\\n        std::vector<int64_t> ids(output_blocks_host.data_ptr<int64_t>(),\\n                                 output_blocks_host.data_ptr<int64_t>() + num_blocks);\\n        std::sort(ids.begin(), ids.end());\\n        TORCH_CHECK(ids.front() >= 0\\n                        && std::adjacent_find(ids.begin(), ids.end()) == ids.end(),\\n                    \\\"CD3 output blocks must be distinct and nonnegative\\\");\\n        max_output_block = ids.back();\\n        validate_side(k_body, k_entries, k_offsets, k_offsets_host,\\n                      k_entry_word_counts_host, k_copies);\\n        validate_side(v_body, v_entries, v_offsets, v_offsets_host,\\n                      v_entry_word_counts_host, v_copies);\\n        k_copies.require_metadata_copy(output_blocks_host, output_blocks, num_blocks);\\n        k_copies.require_metadata_copy(k_offsets_host, k_offsets, num_blocks);\\n        v_copies.require_metadata_copy(v_offsets_host, v_offsets, num_blocks);\\n\\n        std::vector<std::pair<uintptr_t, uintptr_t>> ranges;\\n        for (const auto* batch : {&k_copies, &v_copies}) {\\n            for (size_t i = 0; i < batch->sizes.size(); ++i) {\\n                const auto begin = reinterpret_cast<uintptr_t>(batch->destination_addresses[i]);\\n                ranges.emplace_back(begin, begin + batch->sizes[i]);\\n            }\\n        }\\n        std::sort(ranges.begin(), ranges.end());\\n        for (size_t index = 1; index < ranges.size(); ++index) {\\n            TORCH_CHECK(ranges[index - 1].second <= ranges[index].first,\\n                        \\\"CD3 H2D destinations must not overlap\\\");\\n        }\\n    }\\n\\n    void check_device_vector(const torch::Tensor& tensor, const char* name) const\\n    {\\n        TORCH_CHECK(tensor.device() == device && tensor.is_contiguous()\\n                        && tensor.dim() == 1 && tensor.scalar_type() == at::kLong\\n                        && tensor.numel() >= num_blocks,\\n                    \\\"invalid CD3 \\\", name, \\\" CUDA metadata capacity\\\");\\n    }\\n\\n    void validate_side(const torch::Tensor& body, const torch::Tensor& entries,\\n                       const torch::Tensor& offsets, const torch::Tensor& host_offsets,\\n                       const torch::Tensor& word_counts, const KVTransferBatch& copies) const\\n    {\\n        TORCH_CHECK(body.device() == device && body.is_contiguous()\\n                        && body.scalar_type() == at::kByte\\n                        && reinterpret_cast<uintptr_t>(body.data_ptr()) % 16 == 0,\\n                    \\\"CD3 body must be a 16-byte aligned contiguous CUDA byte tensor\\\");\\n        check_device_vector(offsets, \\\"entry word offsets\\\");\\n        check_host_long_vector(host_offsets, \\\"host entry word offsets\\\");\\n        check_host_long_vector(word_counts, \\\"host entry word counts\\\");\\n        TORCH_CHECK(host_offsets.numel() >= num_blocks && word_counts.numel() >= num_blocks,\\n                    \\\"CD3 host entries metadata is too small\\\");\\n        TORCH_CHECK(body.dim() == 2 && body.size(0) >= num_blocks\\n                        && body.size(1) >= body_bytes && body.size(1) % 16 == 0\\n                        && body.size(1) <= std::numeric_limits<int>::max(),\\n                    \\\"invalid CD3 CSR body capacity or alignment\\\");\\n        TORCH_CHECK(entries.device() == device && entries.is_contiguous()\\n                        && entries.scalar_type() == at::kLong && entries.dim() == 1\\n                        && reinterpret_cast<uintptr_t>(entries.data_ptr()) % 8 == 0,\\n                    \\\"invalid CD3 CSR entries\\\");\\n        copies.require_destination_range(body.data_ptr(), num_blocks * body.size(1));\\n        const auto* starts = host_offsets.data_ptr<int64_t>();\\n        const auto* counts = word_counts.data_ptr<int64_t>();\\n        for (int index = 0; index < num_blocks; ++index) {\\n            const int64_t start = starts[index];\\n            const int64_t count = counts[index];\\n            TORCH_CHECK(start >= 0 && start <= entries.numel()\\n                            && count >= 0 && count <= entries.numel() - start,\\n                        \\\"CD3 CSR entry range exceeds capacity\\\");\\n            if (count > 0) {\\n                copies.require_destination_range(\\n                    entries.data_ptr<int64_t>() + start, count * sizeof(int64_t));\\n            }\\n        }\\n    }\\n\\n    void check_dense_output(const torch::Tensor& output) const\\n    {\\n        TORCH_CHECK(output.device() == device && output.is_contiguous()\\n                        && output.scalar_type() == at::kBFloat16 && output.dim() == 3\\n                        && output.size(0) > max_output_block\\n                        && output.size(1) == rows && output.size(2) == columns\\n                        && reinterpret_cast<uintptr_t>(output.data_ptr()) % 16 == 0,\\n                    \\\"CD3 dense output has invalid shape, device, alignment or routing capacity\\\");\\n    }\\n\\n    void decode_side(bool is_key, const torch::Tensor& output, cudaStream_t stream) const\\n    {\\n        const auto& body = is_key ? k_body : v_body;\\n        const auto& offsets = is_key ? k_offsets : v_offsets;\\n        const auto& entries = is_key ? k_entries : v_entries;\\n        check_cuda_error(CD3_DecompressBatchedCSR(\\n            stream, body.data_ptr<uint8_t>(), body.size(1),\\n            sm_offset, base_offset, offsets_offset,\\n            reinterpret_cast<const uint64_t*>(entries.data_ptr<int64_t>()),\\n            offsets.data_ptr<int64_t>(), nullptr, output_blocks.data_ptr<int64_t>(),\\n            reinterpret_cast<uint16_t*>(output.data_ptr()),\\n            num_blocks, tiles_per_block, block_elements, columns),\\n            \\\"CD3_DecompressBatchedCSR\\\");\\n    }\\n\\n    void decode_side_stream(bool is_key, torch::Tensor output,\\n                            int64_t stream_handle, int64_t begin_event,\\n                            int64_t end_event) const\\n    {\\n        check_dense_output(output);\\n        TORCH_CHECK(stream_handle != 0, \\\"CD3 decode stream must be nonzero\\\");\\n        const c10::cuda::CUDAGuard guard(device);\\n        auto stream = reinterpret_cast<cudaStream_t>(stream_handle);\\n        py::gil_scoped_release no_gil;\\n        record_kv_probe_event(begin_event, stream);\\n        decode_side(is_key, output, stream);\\n        record_kv_probe_event(end_event, stream);\\n    }\\n\\n    void submit(torch::Tensor k_output, torch::Tensor v_output,\\n                int64_t h2d_stream_handle, int64_t decomp_stream_handle,\\n                int64_t k_done, int64_t v_done, int64_t h2d_done,\\n                int64_t plan_h2d_done, int64_t consumed, bool pipeline,\\n                std::vector<int64_t> events)\\n    {\\n        check_dense_output(k_output);\\n        check_dense_output(v_output);\\n        const uintptr_t k_begin = reinterpret_cast<uintptr_t>(k_output.data_ptr());\\n        const uintptr_t v_begin = reinterpret_cast<uintptr_t>(v_output.data_ptr());\\n        TORCH_CHECK(k_begin + k_output.nbytes() <= v_begin\\n                        || v_begin + v_output.nbytes() <= k_begin,\\n                    \\\"CD3 K/V dense outputs must not overlap\\\");\\n        TORCH_CHECK(h2d_stream_handle != 0 && decomp_stream_handle != 0\\n                        && k_done != 0 && v_done != 0 && consumed != 0,\\n                    \\\"CD3 pipeline requires streams and completion events\\\");\\n        TORCH_CHECK(events.empty() || events.size() == 8,\\n                    \\\"CD3 probe events must be empty or contain eight handles\\\");\\n        if (events.empty()) {\\n            events.resize(8, 0);\\n        }\\n        const c10::cuda::CUDAGuard guard(device);\\n        auto h2d_stream = reinterpret_cast<cudaStream_t>(h2d_stream_handle);\\n        auto decomp_stream = reinterpret_cast<cudaStream_t>(decomp_stream_handle);\\n        auto wait = [](cudaStream_t stream, int64_t event) {\\n            check_cuda_error(cudaStreamWaitEvent(\\n                stream, reinterpret_cast<cudaEvent_t>(event), 0),\\n                \\\"cudaStreamWaitEvent(CD3 pipeline)\\\");\\n        };\\n        py::gil_scoped_release no_gil;\\n        // Reuse covers routing and both sides' staging buffers. An event that\\n        // has never been recorded is already complete on the first use.\\n        wait(h2d_stream, consumed);\\n        record_kv_probe_event(events[0], h2d_stream);\\n        k_copies.submit(h2d_stream);\\n        record_kv_probe_event(events[1], h2d_stream);\\n        record_kv_probe_event(k_done, h2d_stream);\\n        record_kv_probe_event(events[2], h2d_stream);\\n        v_copies.submit(h2d_stream);\\n        record_kv_probe_event(events[3], h2d_stream);\\n        record_kv_probe_event(v_done, h2d_stream);\\n        record_kv_probe_event(h2d_done, h2d_stream);\\n        record_kv_probe_event(plan_h2d_done, h2d_stream);\\n\\n        const bool effective_pipeline = pipeline && h2d_stream != decomp_stream;\\n        wait(decomp_stream, effective_pipeline ? k_done : v_done);\\n        record_kv_probe_event(events[4], decomp_stream);\\n        decode_side(true, k_output, decomp_stream);\\n        record_kv_probe_event(events[5], decomp_stream);\\n        if (effective_pipeline) {\\n            wait(decomp_stream, v_done);\\n        }\\n        record_kv_probe_event(events[6], decomp_stream);\\n        decode_side(false, v_output, decomp_stream);\\n        record_kv_probe_event(events[7], decomp_stream);\\n        record_kv_probe_event(consumed, decomp_stream);\\n    }\\n};\\n\\n#include \\\"chunk_delta3_hybrid.h\\\"\\n\\nvoid prepare_chunk_delta3_kv_decode(\\n    torch::Tensor block_ids,\\n    torch::Tensor slot_table,\\n    torch::Tensor sorted_block_ids_host,\\n    torch::Tensor host_k_body,\\n    torch::Tensor host_v_body,\\n    torch::Tensor host_k_offsets,\\n    torch::Tensor host_v_offsets,\\n    torch::Tensor host_k_entries,\\n    torch::Tensor host_v_entries,\\n    torch::Tensor gpu_k_body,\\n    torch::Tensor gpu_v_body,\\n    torch::Tensor gpu_k_offsets,\\n    torch::Tensor gpu_v_offsets,\\n    torch::Tensor gpu_block_ids,\\n    torch::Tensor gpu_k_entries,\\n    torch::Tensor gpu_v_entries,\\n    bool offsets_are_compact,\\n    int64_t active_slots,\\n    int64_t stream_handle, py::object profile,\\n    int64_t begin_event, int64_t end_event,\\n    int64_t load_begin_event, int64_t load_end_event, py::object load_stats)\\n{\\n    using Clock = std::chrono::steady_clock;\\n    const bool profiling = !profile.is_none();\\n    const auto started = profiling ? Clock::now() : Clock::time_point{};\\n    TORCH_CHECK(stream_handle != 0, \\\"CUDA stream handle must be nonzero\\\");\\n    TORCH_CHECK(\\n        block_ids.device().is_cpu()\\n            && block_ids.scalar_type() == at::kLong\\n            && block_ids.is_contiguous(),\\n        \\\"block_ids must be contiguous CPU int64\\\");\\n    TORCH_CHECK(\\n        slot_table.device().is_cpu()\\n            && slot_table.scalar_type() == at::kInt\\n            && slot_table.is_contiguous(),\\n        \\\"slot_table must be contiguous CPU int32\\\");\\n    TORCH_CHECK(\\n        sorted_block_ids_host.device().is_cpu()\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"f6b3e5\",\"wall_time_seconds\":0.000014753,\"exit_code\":0,\"original_token_count\":2018,\"output\":\"\\\"\\\"\\\"KV H2D accounting shared by offline and serving.\\n\\nBytes count submitted memcpy payloads, not link-protocol traffic. Compression\\nratio is dense-equivalent bytes / active encoded payload bytes; transfer ratio\\nalso includes routing metadata, padding, and extra rows actually copied.\\nRatios over multiple forwards must be computed from byte sums, not averaged.\\nCUDA timing is opt-in and reports a submission window, not copy-engine activity.\\n\\\"\\\"\\\"\\nimport atexit\\nimport csv\\nimport os\\nfrom pathlib import Path\\n\\n\\nCOLUMNS = (\\n    \\\"forward\\\", \\\"batch\\\", \\\"step\\\", \\\"config\\\", \\\"phase\\\", \\\"tokens\\\", \\\"kv_raw_bytes\\\", \\\"kv_payload_bytes\\\",\\n    \\\"kv_h2d_bytes\\\", \\\"kv_compression_ratio\\\", \\\"kv_transfer_ratio\\\",\\n    \\\"kvload_ms\\\", \\\"transfers\\\", \\\"bytes_complete\\\", \\\"timing_complete\\\",\\n    \\\"cd3_k_h2d_bytes\\\", \\\"cd3_v_h2d_bytes\\\", \\\"cd3_metadata_bytes\\\",\\n    \\\"cd3_alignment_bytes\\\", \\\"cd3_gap_bytes\\\", \\\"cd3_copy_descriptors\\\", \\\"cd3_batch_calls\\\",\\n    \\\"cd3_csr_garbage_bytes\\\",\\n    \\\"cd3_storage_requested\\\", \\\"cd3_storage_effective\\\", \\\"cd3_execution_requested\\\",\\n    \\\"cd3_execution_effective\\\", \\\"cd3_fallback_reason\\\",\\n    \\\"cd3_csr_policy\\\",\\n)\\nCD3_COUNTERS = COLUMNS[15:23]\\nCD3_MODES = COLUMNS[23:]\\n_collector = None\\n_generation = 0\\n\\n\\nclass Transfer:\\n    def __init__(self, timing):\\n        # Native staging fills this reusable list before the begin event.\\n        self.stats = [0, 0, 0]  # dense-equivalent, encoded payload, H2D\\n        self.layer = -1\\n        self.events = None\\n        self.handles = (0, 0)\\n        if timing:\\n            import torch\\n            self.events = tuple(torch.cuda.Event(enable_timing=True)\\n                                for _ in range(2))\\n            for event in self.events:\\n                event.record()  # Materialize native handles once.\\n            self.handles = tuple(event.cuda_event for event in self.events)\\n\\n    def begin(self, stream):\\n        if self.events:\\n            self.events[0].record(stream)\\n\\n    def end(self, stream):\\n        if self.events:\\n            self.events[1].record(stream)\\n\\n\\nclass KVLoadMetrics:\\n    def __init__(self, *, timing=False, path=None, capacity=0):\\n        self.timing = timing\\n        self.active = False\\n        self.forward = -1\\n        self.batch = self.step = -1\\n        self.config = \\\"serving\\\"\\n        self.pool = [Transfer(timing) for _ in range(capacity)]\\n        self.layer = -1\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.last = None\\n        self.cd3 = {}\\n        self.file = None\\n        if path:\\n            Path(path).parent.mkdir(parents=True, exist_ok=True)\\n            # One write per forward, never per layer; line buffering also\\n            # preserves completed forwards when a serving worker is stopped.\\n            self.file = open(path, \\\"w\\\", buffering=1)\\n            self.writer = csv.DictWriter(self.file, fieldnames=COLUMNS)\\n            self.writer.writeheader()\\n            atexit.register(self.close)\\n\\n    def close(self):\\n        if self.file:\\n            self.file.close()\\n            self.file = None\\n\\n    def begin_forward(self, is_prefill, tokens):\\n        self.forward += 1\\n        self.layer = -1\\n        self.phase = \\\"prefill\\\" if is_prefill else \\\"decode\\\"\\n        self.tokens = tokens\\n        self.count = 0\\n        self.complete = True\\n        self.raw_bytes = self.payload_bytes = 0\\n        self.active = True\\n        self.cd3 = {}\\n\\n    def record_cd3(self, *, modes, counters):\\n        for key, value in modes.items():\\n            self.cd3[key] = value\\n        for key, value in counters.items():\\n            self.cd3[key] = self.cd3.get(key, 0) + value\\n\\n    def add_payload(self, raw_bytes, payload_bytes):\\n        self.raw_bytes += raw_bytes\\n        self.payload_bytes += payload_bytes\\n\\n    def transfer(self, raw_bytes=0, payload_bytes=0):\\n        if self.count == len(self.pool):\\n            self.pool.append(Transfer(self.timing))\\n        item = self.pool[self.count]\\n        self.count += 1\\n        item.layer = self.layer\\n        item.stats[:] = [raw_bytes, payload_bytes, 0]\\n        return item\\n\\n    def transfers(self):\\n        return [item for item in self.pool[:self.count] if item.stats[2] > 0]\\n\\n    def snapshot(self):\\n        items = self.transfers()\\n        raw, payload, wire = (sum(item.stats[i] for item in items)\\n                              for i in range(3))\\n        raw += self.raw_bytes\\n        payload += self.payload_bytes\\n        timing_complete = self.timing and self.complete\\n        elapsed = 0.0\\n        if timing_complete:\\n            for item in items:\\n                begin, end = item.events\\n                if not end.query():\\n                    timing_complete = False\\n                    break\\n                elapsed += begin.elapsed_time(end)\\n        result = dict(\\n            forward=self.forward, batch=self.batch, step=self.step,\\n            config=self.config, phase=self.phase, tokens=self.tokens,\\n            kv_raw_bytes=raw if self.complete else None,\\n            kv_payload_bytes=payload if self.complete else None,\\n            kv_h2d_bytes=wire if self.complete else None,\\n            kv_compression_ratio=(raw / payload if payload and self.complete else None),\\n            kv_transfer_ratio=(raw / wire if wire and self.complete else None),\\n            kvload_ms=elapsed if timing_complete else None,\\n            transfers=len(items), bytes_complete=int(self.complete),\\n            timing_complete=int(timing_complete))\\n        result.update({key: self.cd3.get(key) for key in (*CD3_COUNTERS, *CD3_MODES)})\\n        return result\\n\\n    def finish_forward(self):\\n        if not self.active:\\n            return\\n        self.last = self.snapshot()\\n        if self.file:\\n            self.writer.writerow({key: \\\"NA\\\" if value is None else value\\n                                  for key, value in self.last.items()})\\n        self.active = False\\n\\n\\ndef configure(*, timing=False, log_dir=None, capacity=0):\\n    global _collector, _generation\\n    if _collector:\\n        _collector.close()\\n    enabled = os.getenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"0\\\") == \\\"1\\\"\\n    if not enabled and not timing:\\n        _collector = None\\n        return None\\n    directory = os.getenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\") or log_dir\\n    _generation += 1\\n    path = (str(Path(directory) / f\\\"kv_metrics.{os.getpid()}.{_generation}.csv\\\")\\n            if enabled and directory else None)\\n    _collector = KVLoadMetrics(timing=timing, path=path, capacity=capacity)\\n    return _collector\\n\\n\\ndef current():\\n    return _collector if _collector is not None and _collector.active else None\\n\\n\\ndef set_context(batch, step, config):\\n    if _collector is not None:\\n        _collector.batch, _collector.step, _collector.config = batch, step, config\\n\\n\\ndef h2d(source, device, *, raw=False):\\n    \\\"\\\"\\\"Account for a standalone H2D, keeping destination allocation outside timing.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return source.to(device, non_blocking=True)\\n    size = source.nbytes\\n    item = metrics.transfer(size if raw else 0, size if raw else 0)\\n    if metrics.timing:\\n        import torch\\n        destination = torch.empty_like(source, device=device)\\n        stream = torch.cuda.current_stream(device)\\n        item.begin(stream)\\n        destination.copy_(source, non_blocking=True)\\n        item.end(stream)\\n    else:\\n        destination = source.to(device, non_blocking=True)\\n    item.stats[2] = size\\n    return destination\\n\\n\\ndef copy_into(destination, source):\\n    metrics = current()\\n    if metrics is None:\\n        return destination.copy_(source, non_blocking=True)\\n    import torch\\n    item = metrics.transfer()\\n    stream = torch.cuda.current_stream(destination.device)\\n    item.begin(stream)\\n    destination.copy_(source, non_blocking=True)\\n    item.end(stream)\\n    item.stats[2] = source.nbytes\\n    return destination\\n\\n\\ndef submit(function, *args):\\n    \\\"\\\"\\\"Native descriptor builders return actual H2D bytes after submission.\\\"\\\"\\\"\\n    metrics = current()\\n    if metrics is None:\\n        return function(*args)\\n    item = metrics.transfer()\\n    item.stats[2] = function(*args, *item.handles)\\n    return item.stats[2]\\n\"}"},{"type":"input_text","text":"