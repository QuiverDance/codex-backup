dule. Records are\\nowned by one queued job; its worker finishes writing before the existing done\\nevent wakes the consumer. Snapshotting never waits for unfinished workers.\\n\\\"\\\"\\\"\\nimport time\\n\\n\\nCOLUMNS = (\\n    \\\"enqueue_batch\\\", \\\"enqueue_step\\\", \\\"consume_batch\\\", \\\"consume_step\\\",\\n    \\\"layer\\\", \\\"blocks\\\", \\\"join_site\\\", \\\"worker_done\\\", \\\"joined\\\",\\n    \\\"enqueue_ns\\\", \\\"worker_start_ns\\\", \\\"worker_done_ns\\\", \\\"join_start_ns\\\",\\n    \\\"join_end_ns\\\", \\\"queue_ms\\\", \\\"raw_d2h_wait_ms\\\", \\\"prior_h2d_wait_ms\\\",\\n    \\\"encode_ms\\\", \\\"csr_ms\\\", \\\"worker_ms\\\", \\\"worker_wait_ms\\\",\\n    \\\"publish_ms\\\", \\\"deferred_free_ms\\\", \\\"join_ms\\\", \\\"packing_ms\\\",\\n)\\n_enabled = False\\n_batch = -1\\n_step = -1\\n_records = []\\n_loads = []\\n_pending_loads = []\\n_sampled_load = False\\nLOAD_COLUMNS = (\\n    \\\"batch\\\", \\\"step\\\", \\\"layer\\\", \\\"backend\\\", \\\"blocks\\\", \\\"raw_bytes\\\", \\\"wire_bytes\\\",\\n    \\\"body_bytes\\\", \\\"entry_bytes\\\", \\\"active_entry_bytes\\\", \\\"extra_entry_bytes\\\",\\n    \\\"span_count\\\", \\\"copy_count\\\", \\\"plan_hit\\\", \\\"plan_cpu_ms\\\", \\\"stage_cpu_ms\\\",\\n    \\\"native_prepare_cpu_ms\\\", \\\"native_sort_cpu_ms\\\", \\\"gpu_sampled\\\",\\n    \\\"gpu_complete\\\", \\\"h2d_window_ms\\\", \\\"decode_window_ms\\\", \\\"ring_wait_ms\\\",\\n    \\\"k_h2d_ms\\\", \\\"v_h2d_ms\\\", \\\"k_decomp_ms\\\", \\\"v_decomp_ms\\\", \\\"chunk_ready_ms\\\",\\n    \\\"k_decomp_v_load_overlap_ms\\\", \\\"batch_api_calls\\\", \\\"effective_execution\\\",\\n    \\\"live_payload_bytes\\\", \\\"segment_capacity_bytes\\\", \\\"dead_bytes\\\", \\\"unused_bytes\\\",\\n    \\\"scratch_bytes\\\", \\\"gpu_staging_bytes\\\", \\\"planner_reserved_bytes\\\",\\n    \\\"planner_visited_records\\\", \\\"planner_selected_segments\\\", \\\"planner_new_allocations\\\",\\n)\\n\\n\\n\\ndef begin_run(enabled):\\n    global _enabled, _batch, _step, _sampled_load\\n    _sampled_load = False\\n    _enabled = enabled\\n    _batch = _step = -1\\n    _records.clear()\\n    _loads.clear()\\n    _pending_loads.clear()\\n\\n\\ndef set_step(batch, step):\\n    global _batch, _step, _sampled_load\\n    _batch, _step = batch, step\\n    _sampled_load = False\\n\\n\\ndef new_job(layer, blocks):\\n    if not _enabled:\\n        return None\\n    record = dict.fromkeys(COLUMNS)\\n    record.update(\\n        enqueue_batch=_batch, enqueue_step=_step, layer=layer, blocks=blocks,\\n        worker_done=0, joined=0, encode_ms=0.0, csr_ms=0.0, packing_ms=0.0,\\n        enqueue_ns=time.perf_counter_ns(),\\n    )\\n    _records.append(record)\\n    return record\\n\\n\\ndef begin_join(record, site):\\n    record.update(consume_batch=_batch, consume_step=_step, join_site=site,\\n                  join_start_ns=time.perf_counter_ns())\\n\\n\\ndef snapshot():\\n    # Copy each record once. Do not force completion of terminal jobs merely\\n    # to populate a diagnostic CSV. Missing measurements remain NA, not zero.\\n    return [record.copy() for record in _records]\\n\\n\\ndef write_csv(file):\\n    file.write(\\\" \\\".join(COLUMNS) + \\\"\\\\n\\\")\\n    for record in snapshot():\\n        file.write(\\\" \\\".join(\\n            \\\"NA\\\" if record[column] is None else str(record[column])\\n            for column in COLUMNS) + \\\"\\\\n\\\")\\n\\n\\ndef new_load(layer, backend, blocks, n_layers=1):\\n    global _sampled_load\\n    if not _enabled:\\n        return None\\n    sample = (backend == \\\"cd3\\\" and layer == _step % n_layers\\n              and not _sampled_load)\\n    _sampled_load |= sample\\n    record = dict.fromkeys(LOAD_COLUMNS)\\n    record.update(batch=_batch, step=_step, layer=layer, backend=backend,\\n                  blocks=blocks, gpu_sampled=int(sample), gpu_complete=0)\\n    _loads.append(record)\\n    _pending_loads.append(record)\\n    return record\\n\\n\\ndef collect_loads(