\n        # Timing events are unique per submitted chunk within a forward.\\n        # The loader consumes their numeric snapshots before the next reset.\\n        self._kv_side_intervals.clear()\\n        self._kv_decode_intervals.clear()\\n        self._kv_timed_layers.clear()\\n        if active_array is None:\\n            active_array = active_block_ids\\n        candidates = np.asarray(active_array, dtype=np.int64)\\n        if not candidates.flags.c_contiguous:\\n            candidates = np.ascontiguousarray(candidates)\\n        if (candidates.size > 1\\n                and bool((candidates[1:] < candidates[:-1]).any())):\\n            candidates = np.sort(candidates)\\n\\n        previous = self._prepared_active_candidates\\n        if previous is None or not np.array_equal(previous, candidates):\\n            self._prepared_active_version += 1\\n        # Keep the current step's objects alive.  The loader replaces rather\\n        # than mutates them on the next step, so no per-step copy is needed.\\n        self._prepared_active_list = active_block_ids\\n        self._prepared_active_candidates = candidates\\n\\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= bid < table.size:\\n            return -1\\n        return int(table[bid])\\n\\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\\n        if self.storage_backend == \\\"hybrid\\\":\\n            self.free_persistent_block(layer_id, block_id)\\n            return\\n        table = self._kv_slot_np.get(layer_id)\\n        if table is None or not 0 <= block_id < table.size:\\n            return\\n        slot = int(table[block_id])\\n        if slot < 0:\\n            return\\n        self._invalidate_decode_plan(layer_id)\\n        table[block_id] = -1\\n        self._kv_slot_block[layer_id][slot] = -1\\n        self._release_physical_slot(layer_id, slot)\\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\\n                         output_buffers) -> None:\\n        \\\"\\\"\\\"Decode the active set published once at the forward boundary.\\\"\\\"\\\"\\n        k_cache, v_cache = output_buffers\\n        if self._tb:\\n            self._kv_timed_layers.add(layer_id)\\n        valid = self._persistent_valid.get(layer_id)\\n        if valid is None or len(active_block_ids) == 0:\\n            return\\n        if (active_block_ids is not self._prepared_active_list\\n                or self._prepared_active_candidates is None):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV active set was not prepared before decode\\\")\\n        candidates = self._prepared_active_candidates\\n        limit = min(int(k_cache.shape[0]), len(valid))\\n        if (candidates.size\\n                and (int(candidates[0]) < 0\\n                     or int(candidates[-1]) >= limit)):\\n            raise RuntimeError(\\\"ChunkDelta3 KV active block is out of range\\\")\\n        generation = self._decode_generation.get(layer_id, 0)\\n        version = self._prepared_active_version\\n        cached = self._decode_filtered.get(layer_id)\\n        if (cached is not None\\n                and cached[0] == generation\\n                and cached[3] == version):\\n            filtered = cached[2]\\n        else:\\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\\n            filtered = np.ascontiguousarray(\\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\\n            self._decode_filtered[layer_id] = (\\n                generation, candidates, filtered, version)\\n        if filtered.size == 0:\\n            return\\n\\n        filtered = self._restore_secondary_fallbacks(\\n            layer_id, filtered, k_cache, v_cache)\\n        if filtered.size == 0:\\n            return\\n\\n        capacity = self._max_gpu_decomp_blocks\\n        if filtered.size <= capacity:\\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\\n            return\\n        for start in range(0, filtered.size, capacity):\\n            self._decompress_blocks(\\n                layer_id, filtered[start:start + capacity],\\n                k_cache, v_cache)\\n\\n    def _restore_secondary_fallbacks(\\n            self, layer_id: int, candidates: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\\n        \\\"\\\"\\\"Restore exception-overflow rows from authoritative raw KV.\\n\\n        The host encoder retains the true exception count while safely\\n        truncating Packed20 writes at the fixed row capacity.  If either side\\n        of a K/V pair overflowed, restore both sides from ``secondary_kv`` and\\n        remove that block from the CD3 launch.  Normal rows pay no per-step\\n        metadata scan until a layer has observed an overflow.\\n        \\\"\\\"\\\"\\n        if (not self._secondary_fallback_possible.get(layer_id, False)\\n                or candidates.size == 0):\\n            return candidates\\n\\n        slots = self._kv_slot_np[layer_id][candidates]\\n        slot_ok = slots >= 0\\n        if not bool(slot_ok.any()):\\n            return candidates\\n        probe_positions = np.flatnonzero(slot_ok)\\n        probe_slots = slots[slot_ok]\\n        pools = self._host_pools[layer_id]\\n        overflow = (\\n            pools[\\\"k\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        overflow |= (\\n            pools[\\\"v\\\"][\\\"num_exceptions\\\"].numpy()[probe_slots]\\n            > self._entry_capacity)\\n        if not bool(overflow.any()):\\n            return candidates\\n\\n        fallback_positions = probe_positions[overflow]\\n        fallback_ids = np.ascontiguousarray(\\n            candidates[fallback_positions], dtype=np.int64)\\n        self._decode_raw_from_secondary(\\n            layer_id, fallback_ids, k_cache, v_cache)\\n        keep = np.ones(candidates.size, dtype=np.bool_)\\n        keep[fallback_positions] = False\\n        return np.ascontiguousarray(candidates[keep])\\n\\n    def _decode_raw_from_secondary(\\n            self, layer_id: int, block_ids: np.ndarray,\\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\\n\\n        if layer_id >= len(DualMemoryLoader.kv_caches):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 KV overflow fallback requires raw secondary KV, \\\"\\n                f\\\"but layer {layer_id} has no DualMemoryLoader cache\\\")\\n        secondary = getattr(\\n            DualMemoryLoader.kv_caches[layer_id], \\\"secondary_kv\\\", None)\\n        if secondary is None:\\n\\n    def compress_batch_async_from_host(\\n        self,\\n        layer_id: int,\\n        block_ids: list,\\n        host_k: torch.Tensor,\\n        host_v: torch.Tensor,\\n        wait_event_handle: int = 0,\\n        *, ownership=(),\\n    ) -> None:\\n        if not self._kv_pools_ready:\\n            raise RuntimeError(\\n                \\\"compress_batch_async_from_host requires warmup_kv_buffers\\\")\\n        if not self._workers:\\n            raise RuntimeError(\\\"CD3 encode submitted after worker shutdown\\\")\\n        if layer_id in self._pending_compress:\\n            self.wait_compress_async(\\n                layer_id, tuple(host_k.shape[1:]), _join_site=\\\"resubmit\\\")\\n        num_source_blocks = host_k.shape[0]\\n        block_array = np.asarray(block_ids, dtype=np.int64)\\n        if block_array.size:\\n            block_array = block_array[\\n                (block_array >= 0) & (block_array < num_source_blocks)]\\n        if block_array.size == 0:\\n            return\\n        ownership = tuple(ownership or ())\\n        routing = {record.block_id: record for record in ownership}\\n        if self.storage_backend == \\\"hybrid\\\":\\n            if len(routing) != len(ownership) or any(\\n                    int(block_id) not in routing for block_id in block_array):\\n                raise RuntimeError(\\\"CD3 hybrid encode requires exact immutable block ownership\\\")\\n            ownership = tuple(routing[int(block_id)] for block_id in block_array)\\n            if any(not record.request_id or record.generation <= 0\\n                   or record.block_index < 0 for record in ownership):\\n                raise ValueError(\\\"CD3 hybrid encode received invalid block ownership\\\")\\n        decode_event_handle = int(\\n            self._kv_dec_h2d[layer_id].cuda_event)\\n        with self._slot_state_lock:\\n            self._reclaim_csr_plans()\\n            slots = self._assign_kv_slots(layer_id, block_array)\\n            valid = self._persistent_valid[layer_id]\\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\\n            self._invalidate_decode_plan(layer_id)\\n            state = self._worker_state_for_layer(layer_id)\\n            state[\\\"error\\\"] = None\\n            state[\\\"done\\\"].clear()\\n            self._record_generations[layer_id][block_array] += 1\\n            generations = np.ascontiguousarray(\\n                self._record_generations[layer_id][block_array], dtype=np.int64)\\n            if self.storage_backend == \\\"hybrid\\\":\\n                self._hybrid_ownership[layer_id].update(routing)\\n            hybrid_results = []\\n            profile = kv_cpu_profile.new_job(layer_id, int(block_array.size))\\n            pending = {\\n                \\\"profile\\\": profile,\\n                \\\"state\\\": state,\\n                \\\"buffer_ids\\\": block_array,\\n                \\\"physical_slots\\\": slots,\\n                \\\"generations\\\": generations,\\n                \\\"hybrid_results\\\": hybrid_results,\\n                \\\"ownership\\\": ownership,\\n            }\\n            self._pending_compress[layer_id] = pending\\n            profile[\\\"encode_ms\\\"] = (_time.perf_counter_ns() - started_ns) / 1e6\\n            started_ns = _time.perf_counter_ns()\\n        for kv in (\\\"k\\\", \\\"v\\\"):\\n            self._append_persistent_csr(layer_id, kv, slot_tensor)\\n        if profile is not None:\\n            profile[\\\"csr_ms\\\"] = (_time.perf_counter_ns() - started_ns) / 1e6\\n\\n    def _encode_hybrid_records(self, layer_id, host_k, host_v, block_ids, slots,\\n                               ownership, generations, results, profile):\\n        scratch = self._hybrid_scratch_queue.get()\\n        outputs = self._host_encode_outputs[layer_id]\\n        store = self._hybrid_stores[layer_id]\\n        try:\\n            for start in range(0, len(block_ids), self._encode_chunk_blocks):\\n                end = min(start + self._encode_chunk_blocks, len(block_ids))\\n                ids = block_ids[start:end]\\n                body_slots = slots[start:end]\\n                begin = _time.perf_counter_ns() if profile is not None else 0\\n                _cd3_ext.host_encode_chunk_delta3_kv_hybrid_blocks(\\n                    host_k.view(torch.int16), host_v.view(torch.int16),\\n                    torch.from_numpy(ids), torch.from_numpy(body_slots),\\n                    outputs[\\\"k\\\"], outputs[\\\"v\\\"],\\n                    scratch[\\\"k\\\"][\\\"entries20x3\\\"], scratch[\\\"v\\\"][\\\"entries20x3\\\"],\\n                    scratch[\\\"k\\\"][\\\"num_exceptions\\\"], scratch[\\\"v\\\"][\\\"num_exceptions\\\"],\\n                    self._M_b, self._K_b)\\n                if profile is not None:\\n                    profile[\\\"encode_ms\\\"] += (_time.perf_counter_ns() - begin) / 1e6\\n                    begin = _time.perf_counter_ns()\\n                batch = store.stage(\\n                    ids, body_slots, generations[start:end],\\n                    [owner.request_id for owner in ownership[start:end]],\\n                    scratch[\\\"k\\\"][\\\"entries20x3\\\"], scratch[\\\"v\\\"][\\\"entries20x3\\\"],\\n                    scratch[\\\"k\\\"][\\\"num_exceptions\\\"], scratch[\\\"v\\\"][\\\"num_exceptions\\\"])\\n                results.append((start, end, batch))\\n                if profile is not None:\\n                    profile[\\\"packing_ms\\\"] += (_time.perf_counter_ns() - begin) / 1e6\\n        finally:\\n            self._hybrid_scratch_queue.put(scratch)\\n\\n    def _finish_hybrid_results(self, layer_id, pending, *, publish):\\n        ids = pending[\\\"buffer_ids\\\"]\\n        mask = np.zeros(len(ids), dtype=np.uint8)\\n        if publish:\\n                    wait_started_ns = _time.perf_counter_ns()\\n                self._wait_worker_state(pending[\\\"state\\\"], timeout_sec)\\n                if profile is not None:\\n                    profile[\\\"worker_wait_ms\\\"] = (\\n                        _time.perf_counter_ns() - wait_started_ns) / 1e6\\n                worker_retired = True\\n                slots = np.asarray(\\n                    pending[\\\"physical_slots\\\"], dtype=np.int64)\\n                overflow_seen = False\\n                for kv in (() if self.storage_backend == \\\"hybrid\\\" else (\\\"k\\\", \\\"v\\\")):\\n                    counts = self._host_pools[\\n                        layer_id][kv][\\\"num_exceptions\\\"].numpy()[slots]\\n                    overflow = np.flatnonzero(counts > self._entry_capacity)\\n                    if overflow.size:\\n                        overflow_seen = True\\n                if overflow_seen:\\n                    self._secondary_fallback_possible[layer_id] = True\\n            except BaseException as worker_error:\\n                if not worker_retired:\\n                    worker_retired = pending[\\\"state\\\"][\\\"done\\\"].is_set()\\n                cleanup_error = None\\n                with self._slot_state_lock:\\n                    if (worker_retired and\\n                            self._pending_compress.get(layer_id) is pending):\\n                        try:\\n                            if self.storage_backend == \\\"hybrid\\\":\\n                                self._finish_hybrid_results(layer_id, pending, publish=False)\\n                            self._release_deferred_slots(layer_id)\\n                            self._reclaim_csr_plans()\\n                        except BaseException as error:\\n                            # The writer has stopped, so retire its lifecycle\\n                            # even when an invariant prevents reclamation.  The\\n                            # deferred set remains quarantined for safety.\\n                            cleanup_error = error\\n                        finally:\\n                            self._pending_compress.pop(layer_id, None)\\n                if cleanup_error is not None:\\n                    worker_error.add_note(\\n                        \\\"ChunkDelta3 deferred-slot cleanup also failed: \\\"\\n                        f\\\"{cleanup_error!r}\\\")\\n                    raise worker_error from cleanup_error\\n                raise\\n            else:\\n                buffer_ids = pending[\\\"buffer_ids\\\"]\\n                with self._slot_state_lock:\\n                    if self._pending_compress.get(layer_id) is pending:\\n                        try:\\n                            if self.storage_backend == \\\"hybrid\\\":\\n                                self._finish_hybrid_results(layer_id, pending, publish=True)\\n                            block_array = np.asarray(\\n                                buffer_ids, dtype=np.int64)\\n                            captured = np.asarray(\\n                                pending[\\\"physical_slots\\\"], dtype=np.int64)\\n                            current = self._kv_slot_np[layer_id][block_array]\\n                            owned_mask = (current >= 0) & (current == captured)\\n                            if \\\"generations\\\" in pending:\\n                                owned_mask &= (self._record_generations[layer_id][block_array]\\n                                               == pending[\\\"generations\\\"])\\n                            owned = block_array[owned_mask]\\n                            if owned.size:\\n                                self._invalidate_decode_plan(layer_id)\\n                                np.frombuffer(\\n                                    self._persistent_valid[layer_id],\\n                                    dtype=np.uint8)[owned] = 1\\n                            if profile is not None:\\n                                free_started_ns = _time.perf_counter_ns()\\n                            self._release_deferred_slots(layer_id)\\n                            if profile is not None:\\n                                profile[\\\"deferred_free_ms\\\"] = (\\n                                    _time.perf_counter_ns() - free_started_ns) / 1e6\\n                        finally:\\n\"}}"},{"type":"input_text","text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"acbc84\",\"wall_time_seconds\":0.00001136,\"exit_code\":0,\"original_token_count\":202,\"output\":\"INFO 09-23 12:30:53 [init.py:2140] Weight initialization done | GPU weight: 63.81 GiB (compressed=63.81 GiB, uncompressed=0.00 GiB)\\nINFO 09-23 12:30:53 [init.py:2198] Weight initialization done | GPU aux: total=5.85 GiB (unified_primary=3.19 GiB, split_staging=0.71 GiB, non_decoder_resident=1.96 GiB)\\n[2026-09-23 12:31:22] INFO chunk_delta3_kv_compressor.py:553: CD3 hybrid host budget=76345064320 body=52804792320 entries=21611937792 scratch=10342400 counts=9322880 planner=1908651840 transfer=0 segment=65536 entry_transfer=direct\\n[2026-09-23 12:31:22] INFO chunk_delta3_kv_compressor.py:488: ChunkDelta3 KV buffers: block_shape=(16, 8, 128) matrix=128x128 delta_bits=3 decode_threads=128 entry_capacity=3786 body=22656 host_slot=32756 bytes (1.000x raw worst-case allocation) max_blocks=14566 layers=80\\n\"}}"},{"type":"input_text","text":"{\"i\":2,\"status\":\"fulfilled\",\"value\":\"CUDA Best Practices Guide — CUDA C++ Best Practices Guide 13.4 documentation (https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/)\\nciteturn1view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\\\"ref_id\\\":\\\"https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/\\\",\\\"lineno\\\":null}); Total lines: 1958\\n--------------------------------------------------------------------------------\\nCUDA Best Practices Guide — CUDA C++ Best Practices Guide 13.4 documentation (https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/)\\nciteturn1view1 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\\\"ref_id\\\":\\\"https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/\\\",\\\"pattern\\\":\\\"overlap\\\"}); Total lines: 1958\\nL350: ### 10.1.2. Asynchronous and Overlapping Transfers with Computationcite67† L351: Data transfers between the host and the device using `cudaMemcpy()` are blocking transfers; that is, control is returned to the host thread only after the data transfer is complete. The `cudaMemcpyAsync()` function is a non-blocking variant of `cudaMemcpy()` in which control is returned immediately to the host thread. In contrast with `cudaMemcpy()`, the asynchronous transfer version requires pinned host memory (see cite66†Pinned Memory ), and it contains an additional argument, a stream ID.\\nL352: A stream is simply a sequence of operations that are performed in order on the device. Operations in different streams can be interleaved and in some cases overlapped - a property that can be used to hide data transfers between the host and the device.\\nL353: Asynchronous transfers enable overlap of data transfers with computation in two different ways. On all CUDA-enabled devices, it is possible to overlap host computation with asynchronous data transfers and with device computations. For example, cite68†Asynchronous and Overlapping Transfers with Computation demonstrates how host computation in the routine `cpuFunction()` is performed while data is transferred to the device and a kernel using the device is executed.\\nL354: Overlapping computation and data transfers\\nL355: \\nL356:     cudaMemcpyAsync(a_d, a_h, size, cudaMemcpyHostToDevice, 0);\\nL357:     kernel<<<grid, block>>>(a_d);\\nL358:     cpuFunction();\\nL359: The last argument to the `cudaMemcpyAsync()` function is the stream ID, which in this case uses the default stream, stream 0. The kernel also uses the default stream, and it will not begin execution until the memory copy completes; therefore, no explicit synchronization is needed. Because the memory copy and the kernel both return control to the host immediately, the host function `cpuFunction()` overlaps their execution.\\nL360: In cite68†Asynchronous and Overlapping Transfers with Computation , the memory copy and kernel execution occur sequentially. On devices that are capable of concurrent copy and compute, it is possible to overlap kernel execution on the device with data transfers between the host and the device. Whether a device has this capability is indicated by the `asyncEngineCount` field of the `cudaDeviceProp` structure (or listed in the output of the `deviceQuery` CUDA Sample).\\nL361: On devices that have this capability, the overlap once again requires pinned host memory, and, in addition, the data transfer and kernel must use different, non-default streams (streams with non-zero stream IDs).\\nL362: Non-default streams are required for this overlap because memory copy, memory set functions, and kernel calls that use the default stream begin only after all preceding calls on the device (in any stream) have completed, and no operation on the device (in any stream) commences until they are finished.\\nL363: cite68†Asynchronous and Overlapping Transfers with Computation illustrates the basic technique.\\nL364: \\nL365: Concurrent copy and execute\\nL366: \\nL367:     cudaStreamCreate(&stream1);\\nL368:     cudaStreamCreate(&stream2);\\nL369:     cudaMemcpyAsync(a_d, a_h, size, cudaMemcpyHostToDevice, stream1);\\nL370:     kernel<<<grid, block, 0, stream2>>>(otherData_d);\\nL371: In this code, two streams are created and used in the data transfer and kernel executions as specified in the last arguments of the `cudaMemcpyAsync` call and the kernel’s execution configuration.\\nL372: cite68†Asynchronous and Overlapping Transfers with Computation demonstrates how to overlap kernel execution with asynchronous data transfer. This technique could be used when the data dependency is such that the data can be broken into chunks and transferred in multiple stages, launching multiple kernels to operate on each chunk as it arrives. cite69†Sequential copy and execute and cite70†Staged concurrent copy and execute demonstrate this. They produce equivalent results.\\nL373: The first segment shows the reference sequential implementation, which transfers and operates on an array of N floats (where N is assumed to be evenly divisible by nThreads).\\nL374: Sequential copy and execute\\nL375: \\nL376:     cudaMemcpy(a_d, a_h, N*sizeof(float), dir);\\nL377:     kernel<<<N/nThreads, nThreads>>>(a_d);\\nL378: \\nL379: \\nL380: cite70†Staged concurrent copy and execute shows how the transfer and kernel execution can be broken up into nStreams stages. This approach permits some overlapping of the data transfer and execution.\\nL381: Staged concurrent copy and execute\\nL382: \\nL383:     size=N*sizeof(float)/nStreams;\\nL384:     for (i=0; i<nStreams; i++) {\\nL385:         offset = i*N/nStreams;\\nL386:         cudaMemcpyAsync(a_d+offset, a_h+offset, size, dir, stream[i]);\\nL387:         kernel<<<N/(nThreads*nStreams), nThreads, 0,\\nL388:                  stream[i]>>>(a_d+offset);\\nL389:     }\\nL390: (In cite70†Staged concurrent copy and execute , it is assumed that N is evenly divisible by `nThreads*nStreams`.) Because execution within a stream occurs sequentially, none of the kernels will launch until the data transfers in their respective streams complete. Current GPUs can simultaneously process asynchronous data transfers and execute kernels.\\nL391: GPUs with a single copy engine can perform one asynchronous data transfer and execute kernels whereas GPUs with two copy engines can simultaneously perform one asynchronous data transfer from the host to the device, one asynchronous data transfer from the device to the host, and execute kernels. The number of copy engines on a GPU is given by the `asyncEngineCount` field of the `cudaDeviceProp` structure, which is also listed in the output of the `deviceQuery` CUDA Sample.\\nL392: (It should be mentioned that it is not possible to overlap a blocking transfer with an asynchronous transfer, because the blocking transfer occurs in the default stream, so it will not begin until all previous CUDA calls complete. It will not allow any other CUDA call to begin until it has completed.) A diagram depicting the timeline of execution for the two code segments is shown in cite71†Figure 1 , and `nStreams` is equal to 4 for cite70†Staged concurrent copy and execute in the bottom half of the figure.\\nL393: cite72†Image: Timeline comparison for copy and kernel execution L394: \\nL395: Figure 1 Timeline comparison for copy and kernel executioncite71† L396: \\nL397: Top\\nL398: \\nL399: \\nL400: Sequential\\nL401: \\nL402: Bottom\\nL403: \\nL404: \\nL405: Concurrent\\nL406: For this example, it is assumed that the data transfer and kernel execution times are comparable. In such cases, and when the execution time (tE) exceeds the transfer time (tT), a rough estimate for the overall time is tE + tT/nStreams for the staged version versus tE + tT for the sequential version. If the transfer time exceeds the execution time, a rough estimate for the overall time is tT + tE/nStreams.\\nL407: ### 10.1.3. Zero Copycite73† L408: Zero copy is a feature that was added in version 2.2 of the CUDA Toolkit. It enables GPU threads to directly access host memory. For this purpose, it requires mapped pinned (non-pageable) memory. On integrated GPUs (i.e., GPUs with the integrated field of the CUDA device properties structure set to 1), mapped pinned memory is always a performance gain because it avoids superfluous copies as integrated GPU and CPU memory are physically the same.\\nL409: On discrete GPUs, mapped pinned memory is advantageous only in certain cases. Because the data is not cached on the GPU, mapped pinned memory should be read or written only once, and the global loads and stores that read and write the memory should be coalesced. Zero copy can be used in place of streams because kernel-originated data transfers automatically overlap kernel execution without the overhead of setting up and determining the optimal number of streams.\\nL410: Note\\nL411: \\nL412: Low Priority: Use zero-copy operations on integrated GPUs for CUDA Toolkit version 2.2 and later.\\nL413: \\nL414: The host code in cite74†Zero-copy host code shows how zero copy is typically set up.\\nL415: Zero-copy host code\\nL416: \\nL417:     float *a_h, *a_map;\\nL418:     ...\\nL419:     cudaGetDeviceProperties(&prop, 0);\\nL420:     if (!prop.canMapHostMemory)\\nL421:         exit(0);\\nL422:     cudaSetDeviceFlags(cudaDeviceMapHost);\\nL423:     cudaHostAlloc(&a_h, nBytes, cudaHostAllocMapped);\\nL424:     cudaHostGetDevicePointer(&a_map, a_h, 0);\\nL425:     kernel<<<gridSize, blockSize>>>(a_map);\\nL426: In this code, the `canMapHostMemory` field of the structure returned by `cudaGetDeviceProperties()` is used to check that the device supports mapping host memory to the device’s address space. Page-locked memory mapping is enabled by calling `cudaSetDeviceFlags()` with `cudaDeviceMapHost`. Note that `cudaSetDeviceFlags()` must be called prior to setting a device or making a CUDA call that requires state (that is, essentially, before a context is created).\\nL427: Page-locked mapped host memory is allocated using `cudaHostAlloc()`, and the pointer to the mapped device address space is obtained via the function `cudaHostGetDevicePointer()`. In the code in cite74†Zero-copy host code , `kernel()` can reference the mapped pinned host memory using the pointer `a_map` in exactly the same was as it would if a_map referred to a location in device memory.\\nL428: Note\\nL429: \\nL430: Mapped pinned host memory allows you to overlap CPU-GPU memory transfers with computation while avoiding the use of CUDA streams. But since any repeated access to such memory areas causes repeated CPU-GPU transfers, consider creating a second area in device memory to manually cache the previously read host memory data.\\nL431: ### 10.1.4. Unified Virtual Addressingcite75† L432: \\nL433: Devices of cite48†compute capability 2.0 and later support a special addressing mode called Unified Virtual Addressing (UVA) on 64-bit Linux and Windows. With UVA, the host memory and the device memories of all installed supported devices share a single virtual address space.\\nL434: Prior to UVA, an application had to keep track of which pointers referred to device memory (and for which device) and which referred to host memory as a separate bit of metadata (or as hard-coded information in the program) for each pointer. Using UVA, on the other hand, the physical memory space to which a pointer points can be determined simply by inspecting the value of the pointer using `cudaPointerGetAttributes()`.\\nL435: Under UVA, pinned host memory allocated with `cudaHostAlloc()` will have identical host and device pointers, so it is not necessary to call `cudaHostGetDevicePointer()` for such allocations. Host memory allocations pinned after-the-fact via `cudaHostRegister()`, however, will continue to have different device pointers than their host pointers, so `cudaHostGetDevicePointer()` remains necessary in that case.\\nL436: UVA is also a necessary precondition for enabling peer-to-peer (P2P) transfer of data directly across the PCIe bus or NVLink for supported GPUs in supported configurations, bypassing host memory.\\nL437: \\nL438: See the CUDA Programming Guide for further explanations and software requirements for UVA and P2P.\\nL756: #### 10.2.3.4. Asynchronous Copy from Global Memory to Shared Memorycite119† L757: \\nL758: CUDA 11.0 introduces an async-copy feature that can be used within device code to explicitly manage the asynchronous copying of data from global memory to shared memory. This feature enables CUDA kernels to overlap copying data from global to shared memory with computation. It also avoids an intermediary register file access traditionally present between the global memory read and the shared memory write.\\nL914: As described in cite146†Asynchronous and Overlapping Transfers with Computation , CUDA streams can be used to overlap kernel execution with data transfers. On devices that are capable of concurrent kernel execution, streams can also be used to execute multiple kernels simultaneously to more fully take advantage of the device’s multiprocessors.\\nL1276: Certain hardware features are not described by the compute capability. For example, the ability to overlap kernel execution with asynchronous data transfers between the host and the device is available on most but not all GPUs irrespective of the compute capability. In such cases, call `cudaGetDeviceProperties()` to determine whether the device is capable of a certain feature.\\n--------------------------------------------------------------------------------\\nCUDA Best Practices Guide — CUDA C++ Best Practices Guide 13.4 documentation (https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/)\\nciteturn1view2 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\\\"ref_id\\\":\\\"https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/\\\",\\\"pattern\\\":\\\"batching many small transfers\\\"}); Total lines: 1958\\nL331: # 10. Memory Optimizationscite59† L332: \\nL333: Memory optimizations are the most important area for performance. The goal is to maximize the use of the hardware by maximizing bandwidth. Bandwidth is best served by using as much fast memory and as little slow-access memory as possible. This chapter discusses the various kinds of memory on the host and device and how best to set up data items to use the memory effectively.\\nL334: ## 10.1. Data Transfer Between Host and Devicecite18† L335: The peak theoretical bandwidth between the device memory and the GPU is much higher (898 GB/s on the NVIDIA Tesla V100, for example) than the peak theoretical bandwidth between host memory and device memory (16 GB/s on the PCIe x16 Gen3). Hence, for best overall application performance, it is important to minimize data transfer between the host and the device, even if that means running kernels on the GPU that do not demonstrate any speedup compared with running them on the host CPU.\\nL336: \\nL337: Note\\nL338: High Priority: Minimize data transfer between the host and the device, even if it means running some kernels on the device that do not show performance gains when compared with running them on the host CPU.\\nL339: \\nL340: Intermediate data structures should be created in device memory, operated on by the device, and destroyed without ever being mapped by the host or copied to host memory.\\nL341: Also, because of the overhead associated with each transfer, batching many small transfers into one larger transfer performs significantly better than making each transfer separately, even if doing so requires packing non-contiguous regions of memory into a contiguous buffer and then unpacking after the transfer.\\nL342: Finally, higher bandwidth between the host and the device is achieved when using page-locked (or pinned) memory, as discussed in the CUDA Programming Guide and the cite66†Pinned Memory section of this document.\\nL343: ### 10.1.1. Pinned Memorycite66† L344: \\nL345: Page-locked or pinned memory transfers attain the highest bandwidth between the host and the device. On PCIe x16 Gen3 cards, for example, pinned memory can attain roughly 12 GB/s transfer rates.\\nL346: \\nL347: Pinned memory is allocated using the `cudaHostAlloc()` functions in the Runtime API. The `bandwidthTest` CUDA Sample shows how to use these functions as well as how to measure memory transfer performance.\\nL348: For regions of system memory that have already been pre-allocated, `cudaHostRegister()` can be used to pin the memory on-the-fly without the need to allocate a separate buffer and copy the data into it.\\nL349: Pinned memory should not be overused. Excessive use can reduce overall system performance because pinned memory is a scarce resource, but how much is too much is difficult to know in advance. Furthermore, the pinning of system memory is a heavyweight operation compared to most normal system memory allocations, so as with all optimizations, test the application and the systems it runs on for optimal performance parameters.\\nL350: ### 10.1.2. Asynchronous and Overlapping Transfers with Computationcite67† L351: Data transfers between the host and the device using `cudaMemcpy()` are blocking transfers; that is, control is returned to the host thread only after the data transfer is complete. The `cudaMemcpyAsync()` function is a non-blocking variant of `cudaMemcpy()` in which control is returned immediately to the host thread. In contrast with `cudaMemcpy()`, the asynchronous transfer version requires pinned host memory (see cite66†Pinned Memory ), and it contains an additional argument, a stream ID.\\nL352: A stream is simply a sequence of operations that are performed in order on the device. Operations in different streams can be interleaved and in some cases overlapped - a property that can be used to hide data transfers between the host and the device.\\nL353: Asynchronous transfers enable overlap of data transfers with computation in two different ways. On all CUDA-enabled devices, it is possible to overlap host computation with asynchronous data transfers and with device computations. For example, cite68†Asynchronous and Overlapping Transfers with Computation demonstrates how host computation in the routine `cpuFunction()` is performed while data is transferred to the device and a kernel using the device is executed.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0cc6a-30e8-7792-8c60-9918e333c5a4","create_time":1790135945.1802485}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
