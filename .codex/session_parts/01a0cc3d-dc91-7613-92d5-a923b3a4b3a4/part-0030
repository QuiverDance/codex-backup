mpressor._decode_plans[0] is cached_plan\\n        if storage == \\\"hybrid\\\":\\n            assert cached_plan.native_plan is not None\\n            assert not hasattr(cached_plan, \\\"native_plans\\\")  # One plan for both rings.\\n            # A subsequent submission uses the other ring with the same plan.\\n            decode(ids[:2])\\n            assert compressor._decode_plans[0] is cached_plan\\n        decode(ids)  # Multiple staging chunks, including both ring slots.\\n        if storage == \\\"csr\\\" and execution == \\\"serial\\\" and csr_policy == \\\"append\\\":\\n            plans = [compressor._decode_plans[0],\\n                     *compressor._decode_extra_plans[0].values()]\\n            decode(ids)\\n            assert [compressor._decode_plans[0],\\n                    *compressor._decode_extra_plans[0].values()] == plans\\n        decode(ids[::2])  # Sparse records must not copy inactive prefixes.\\n        if csr_policy == \\\"compact\\\":\\n            # Re-encoding a live slot must use its fresh exception payload,\\n            # even when an old packed record could otherwise be retained.\\n            for values in source:\\n                bits = values.view(torch.int16)\\n                bits[bits == 1] = 32640\\n            submit(ids, 2)\\n            decode(ids)\\n        compressor.free_persistent_blocks([3, 8])\\n        if csr_policy == \\\"compact\\\":\\n            assert all(state.garbage_words == 0 for state in compressor._persistent_csr[0].values())\\n        for values in source:\\n            values[3].fill_(2)\\n            values[8].fill_(4)\\n            values[3].view(-1)[::137] = 0\\n            values[8].view(-1)[::149] = 0\\n        submit([3, 8], 2)\\n        decode(ids)\\n        assert torch.all(output[0][0] == -5)\\n        if csr_policy != \\\"append\\\" or (storage == \\\"hybrid\\\" and execution == \\\"pipeline\\\"):\\n            old_values = [values[3].clone() for values in source]\\n            delayed_stream = (compressor.load_kv_stream if execution == \\\"pipeline\\\"\\n                              else compressor.batch_decomp_stream)\\n            with torch.cuda.stream(delayed_stream):\\n                torch.cuda._sleep(10_000_000)\\n            compressor.prepare_active_set(ids, np.asarray(ids, dtype=np.int64))\\n            compressor.decompress_batch(0, ids, output)\\n            with torch.cuda.stream(compressor.batch_decomp_stream):\\n                old_output = [values[3].clone() for values in output]\\n            # Reuse the physical slot while its preceding H2D is still queued.\\n            # The encoder must wait before overwriting that body's source row.\\n            compressor.free_persistent_blocks([3])\\n            for values in source:\\n                values[3].fill_(8)\\n                values[3].view(-1)[::171] = 0\\n            submit([3], 3)\\n            decode(ids)\\n            for actual, expected in zip(old_output, old_values):\\n                assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n        if csr_policy == \\\"reuse\\\":\\n            assert sum(stats[\\\"reuse_words\\\"] for stats in compressor._csr_stats.values()) > 0\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n        compressor.stop_kv_compress_workers()  # Explicit cleanup is idempotent.\\n        metrics.close()\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"5c94bf\",\"wall_time_seconds\":0.000016864,\"exit_code\":0,\"original_token_count\":362,\"output\":\"{\\n  \\\"status\\\": \\\"complete\\\",\\n  \\\"summary\\\": \\\"benchmark_results/cd3_csr/append/20260923T050559Z/summary.tsv\\\",\\n  \\\"client_json\\\": \\\"/root/projects/tiered-serve/benchmark_results/cd3_csr/append/20260923T050559Z/r01-cd3-kvcomp-c8192-q4-g16-d3-csr-append-serial/client/rate_4.json\\\",\\n  \\\"server_exit\\\": \\\"0\\\",\\n  \\\"performance\\\": {\\n    \\\"num_prompts\\\": 192,\\n    \\\"skip_first_n_requests\\\": 16,\\n    \