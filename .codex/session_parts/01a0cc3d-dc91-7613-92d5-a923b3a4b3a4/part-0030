{"timestamp":"2026-09-23T06:35:49.044Z","ordinal":2512,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0ccfa-45b4-79f2-bb26-df0ec6f15c32","call_id":"call_sbeGPgx2ldOhpMNdHGkYwDoO","output":[{"type":"input_text","text":"Script completed\nWall time 5.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"1d36fe\",\"wall_time_seconds\":0.000014688,\"exit_code\":0,\"original_token_count\":878,\"output\":\"class AzureDataset(BenchmarkDataset):\\n    \\\"\\\"\\\"\\n    Loads Azure LLM inference trace CSV files with ContextTokens and\\n    GeneratedTokens columns.  Generates synthetic prompts matching the\\n    token-length distribution from the trace.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, swap: bool = False, **kwargs) -> None:\\n        super().__init__(**kwargs)\\n        self.swap = swap\\n        self.load_data()\\n\\n    def load_data(self) -> None:\\n        if self.dataset_path is None:\\n            raise ValueError(\\n                \\\"dataset_path must be provided for AzureDataset.\\\")\\n        df = pd.read_csv(self.dataset_path)\\n        if self.swap:\\n            df = df.rename(columns={\\n                \\\"ContextTokens\\\": \\\"GeneratedTokens\\\",\\n                \\\"GeneratedTokens\\\": \\\"ContextTokens\\\",\\n            })\\n        self.data = df\\n\\n    def sample(\\n        self,\\n        tokenizer: TokenizerLike,\\n        num_requests: int,\\n        request_id_prefix: str = \\\"\\\",\\n        no_oversample: bool = False,\\n        **kwargs,\\n    ) -> list[SampleRequest]:\\n        if len(self.data) < num_requests:\\n            raise ValueError(\\n                f\\\"Dataset has only {len(self.data)} rows but \\\"\\n                f\\\"{num_requests} were requested.\\\")\\n        df_sample = self.data.head(num_requests).reset_index(drop=True)\\n        input_lens = df_sample[\\\"ContextTokens\\\"].astype(int).tolist()\\n        output_lens = df_sample[\\\"GeneratedTokens\\\"].astype(int).tolist()\\n\\n        samples: list[SampleRequest] = []\\n        vocab_size = tokenizer.vocab_size\\n        for i, (inp_len, out_len) in enumerate(\\n                zip(input_lens, output_lens)):\\n            token_ids = [(i + j) % vocab_size for j in range(inp_len)]\\n            prompt = tokenizer.decode(token_ids)\\n            samples.append(\\n                SampleRequest(\\n                    prompt=prompt,\\n                    prompt_len=inp_len,\\n                    expected_output_len=out_len,\\n                    request_id=request_id_prefix + str(i),\\n                ))\\n        return samples\\n\\n\\n# -----------------------------------------------------------------------------\\n# BurstGPT Dataset Implementation\\n# -----------------------------------------------------------------------------\\n\\n\\nclass BurstGPTDataset(BenchmarkDataset):\\n    \\\"\\\"\\\"\\n    Implements the BurstGPT dataset.  Loads data from a CSV file and generates\\n    sample requests based on synthetic prompt generation. Only rows with Model\\n    \\\"GPT-4\\\" and positive response tokens are used.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, **kwargs) -> None:\\n        super().__init__(**kwargs)\\n        self.load_data()\\n\\n    def load_data(\\n        self,\\n    ):\\n        if self.dataset_path is None:\\n            raise ValueError(\\\"dataset_path must be provided for loading data.\\\")\\n\\n        df = pd.read_csv(self.dataset_path)\\n        # Filter to keep only GPT-4 rows.\\n        gpt4_df = df[df[\\\"Model\\\"] == \\\"GPT-4\\\"]\\n        # Remove failed requests (where Response tokens is 0 or less).\\n        gpt4_df = gpt4_df[gpt4_df[\\\"Response tokens\\\"] > 0]\\n        # Sample the desired number of rows.\\n        self.data = gpt4_df\\n\\n    def _sample_loaded_data(self, num_requests: int) -> list:\\n        if num_requests <= len(self.data):\\n            data = self.data.sample(n=num_requests, random_state=self.random_seed)\\n        else:\\n            data = self.data.sample(\\n                n=num_requests,\\n                random_state=self.random_seed,\\n                replace=True,\\n            )\\n        # Convert the dataframe to a list of lists.\\n        return data.values.tolist()\\n\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"e40a1c\",\"wall_time_seconds\":5.001250509,\"session_id\":86448,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ccc1-54b0-7be0-97d5-272ff0bcc061","create_time":1790145349.044899}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
