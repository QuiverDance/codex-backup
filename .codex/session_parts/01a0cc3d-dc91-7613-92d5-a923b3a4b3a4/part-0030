 (\\\"csr\\\", \\\"serial\\\", \\\"reuse\\\"), (\\\"csr\\\", \\\"pipeline\\\", \\\"reuse\\\"),\\n    (\\\"hybrid\\\", \\\"serial\\\", \\\"append\\\"), (\\\"hybrid\\\", \\\"pipeline\\\", \\\"append\\\"),\\n])\\ndef test_cd3_async_storage_and_pipeline(monkeypatch, storage, execution, csr_policy):\\n    if not torch.cuda.is_available():\\n        pytest.skip(\\\"CUDA required\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", storage)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_EXECUTION\\\", execution)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_CSR_POLICY\\\", csr_policy)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_WORKERS\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_PIN\\\", \\\"0\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\\\", \\\"2\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"1\\\")\\n    from tiered_serve import kv_load_metrics\\n    from tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3KVCompressor\\n    from tiered_serve.kv_tail_residency import KVBlockOwnership\\n\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.Stream())\\n    compressor.load_kv_stream = torch.cuda.Stream()\\n    compressor._tb = True\\n    compressor.warmup_kv_buffers(\\n        (64, 64), 16, n_layers=2,\\n        max_gpu_decomp_blocks=8 if csr_policy != \\\"append\\\" else 2)\\n    if storage == \\\"hybrid\\\":\\n        def unexpected_backing_allocation(*args, **kwargs):\\n            raise AssertionError(\\\"hybrid append must reuse its reserved backing arenas\\\")\\n        monkeypatch.setattr(compressor, \\\"_alloc_host_tensor\\\", unexpected_backing_allocation)\\n    metrics = kv_load_metrics.configure(timing=True)\\n    ids = [1, 3, 4, 8, 12]\\n    source = [torch.ones((17, 64, 64), dtype=torch.bfloat16).pin_memory() for _ in range(2)]\\n    for side, values in enumerate(source):\\n        bits = values.view(torch.int16).view(17, -1)\\n        for index, block in enumerate(ids):\\n            # Vary exact exception counts and include signed zero, infinity,\\n            # subnormal and NaN payloads without overflowing encode scratch.\\n            patterns = torch.tensor([0, -32768, 1, 32640, 32705], dtype=torch.int16)\\n            positions = torch.arange(0, 4096, 71 + index * 13 + side)\\n            bits[block, positions] = patterns[torch.arange(len(positions)) % len(patterns)]\\n    output = [torch.full_like(source[0], -5, device=\\\"cuda\\\") for _ in range(2)]\\n\\n    def submit(blocks, generation, layer_id=0, values=None):\\n        routing = tuple(KVBlockOwnership(\\n            block_id=bid, canonical_block_id=bid + 100, request_id=f\\\"req-{bid // 5}\\\",\\n            block_index=bid, generation=generation) for bid in blocks)\\n        compressor.compress_batch_async_from_host(\\n            layer_id, blocks, *(source if values is None else values), ownership=routing)\\n        compressor.wait_compress_async(layer_id, (64, 64))\\n\\n    def decode(blocks, layer_id=0, expected_source=None):\\n        metrics.begin_forward(False, len(blocks))\\n        metrics.layer = layer_id\\n        compressor.prepare_active_set(blocks, np.array(blocks, dtype=np.int64))\\n        compressor.decompress_batch(layer_id, blocks, output)\\n        compressor.batch_decomp_stream.synchronize()\\n        for actual, expected in zip(output, source if expected_source is None else expected_source):\\n            assert torch.equal(actual[blocks].cpu().view(torch.int16), expected[blocks].view(torch.int16))\\n        snapshot = metrics.snapshot()\\n        assert snapshot[\\\"bytes_complete\\\"] == snapshot[\\\"timing_complete\\\"] == 1\\n        assert snapshot[\\\"cd3_k_h2d_bytes\\\"] + snapshot[\\\"cd3_v_h2d_bytes\\\"] == snapshot[\\\"kv_h2d_bytes\\\"]\\n        assert snapshot[\\\"cd3_copy_descriptors\\\"] > 0\\n        if storage == \\\"hybrid\\\":\\n      