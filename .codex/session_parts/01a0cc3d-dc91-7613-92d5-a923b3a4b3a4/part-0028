imits<uintptr_t>::max() - bytes,\\n                name, \\\" address range overflows\\\");\\n    return {begin, begin + bytes};\\n}\\n\\nbool csr_compact_ranges_overlap(\\n    CSRCompactByteRange lhs, CSRCompactByteRange rhs)\\n{\\n    return lhs.begin != lhs.end && rhs.begin != rhs.end\\n        && lhs.begin < rhs.end && rhs.begin < lhs.end;\\n}\\n\\nint64_t compact_host_chunk_delta3_csr(\\n    torch::Tensor source_entries,\\n    torch::Tensor source_offsets,\\n    const HostWordCounts& source_word_counts,\\n    torch::Tensor updated_slots,\\n    torch::Tensor updated_word_counts,\\n    torch::Tensor updated_entries20x3,\\n    torch::Tensor destination_entries,\\n    torch::Tensor destination_offsets,\\n    HostWordCounts destination_word_counts)\\n{\\n    check_host_long_vector(source_entries, \\\"source_entries\\\");\\n    check_host_long_vector(source_offsets, \\\"source_offsets\\\");\\n    check_host_long_vector(updated_slots, \\\"updated_slots\\\");\\n    check_host_long_vector(updated_word_counts, \\\"updated_word_counts\\\");\\n    check_host_long_vector(destination_entries, \\\"destination_entries\\\");\\n    check_host_long_vector(destination_offsets, \\\"destination_offsets\\\");\\n    TORCH_CHECK(updated_entries20x3.device().is_cpu()\\n                    && updated_entries20x3.scalar_type() == at::kLong\\n                    && updated_entries20x3.dim() == 2\\n                    && updated_entries20x3.stride(1) == 1\\n                    && updated_entries20x3.stride(0) >= updated_entries20x3.size(1),\\n                \\\"updated_entries20x3 must be a row-major CPU int64 matrix\\\");\\n    TORCH_CHECK(source_word_counts.ndim() == 1\\n                    && destination_word_counts.ndim() == 1\\n                    && destination_word_counts.writeable(),\\n                \\\"CSR word counts must be vectors with writable destination\\\");\\n    const int64_t num_slots = source_offsets.numel();\\n    TORCH_CHECK(source_word_counts.size() == num_slots\\n