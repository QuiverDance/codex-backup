{"timestamp":"2026-09-23T04:56:27.745Z","ordinal":1401,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0cc9f-4f61-7030-a280-c853dbfda65c","call_id":"call_09UUQASmTbczDSU9Gu9Kxe9j","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"655923\",\"wall_time_seconds\":0.000013632,\"exit_code\":0,\"original_token_count\":18,\"output\":\"HEAD is now at 19a15c5 Add hybrid KV storage and pipelined transfers\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"346ced\",\"wall_time_seconds\":0.000011616,\"exit_code\":0,\"original_token_count\":0,\"output\":\"\"}"},{"type":"input_text","text":"{\"chunk_id\":\"14a544\",\"wall_time_seconds\":0.000013536,\"exit_code\":0,\"original_token_count\":0,\"output\":\"\"}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"1857a1\",\"wall_time_seconds\":0.000010592,\"exit_code\":0,\"original_token_count\":4506,\"output\":\"\\\"\\\"\\\"ChunkDelta3 backend for persistent offloaded KV blocks.\\n\\nKV exponent deltas use three bits by default, or four with\\nTIERED_SERVE_KV_CD3_DELTA_BITS=4. Weight CD3 remains three-bit.\\nEach host slot keeps a fixed CD3 body and bounded CPU-encode scratch.  CPU\\nencode workers append the exact Packed20 words to persistent CSR storage, so\\nthe per-forward decode plan only references already-packed pinned memory.\\nRecords whose exact compressed representation is not smaller than raw BF16\\nare restored from authoritative secondary KV.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport ctypes\\nimport glob\\nimport logging\\nimport os\\nimport queue\\nimport threading\\nimport time as _time\\nfrom dataclasses import dataclass, field\\nfrom typing import Any, Dict, Tuple\\n\\nimport numpy as np\\nimport torch\\n\\nfrom tiered_serve import kv_cpu_profile, kv_load_metrics\\nfrom tiered_serve.compressor_base import TensorCompressor\\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\\nfrom tiered_serve.compression.core.chunk_delta3 import (\\n    _HAS_CHUNK_DELTA3,\\n    _cd3_ext,\\n)\\n\\n\\nlogger = logging.getLogger(__name__)\\n\\n\\n@dataclass\\nclass _PersistentCSRState:\\n    entries: torch.Tensor\\n    offsets: torch.Tensor\\n    word_counts: np.ndarray\\n    used_words: int\\n    garbage_words: int\\n    max_words: int\\n    gpu_words: int\\n\\n\\n@dataclass\\nclass _DecodePlan:\\n    layer_id: int\\n    block_ids: np.ndarray\\n    block_ids_tensor: torch.Tensor | None\\n    block_ids_cpu: torch.Tensor | None\\n    generation: int\\n    slots_gpu: torch.Tensor\\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\\n    host_offsets: Tuple[torch.Tensor, ...]\\n    host_entries: Tuple[torch.Tensor, ...]\\n    offsets_are_compact: bool\\n    storage_rows: int\\n    entry_words: Tuple[int, int]\\n    staged_bytes: int\\n    h2d_done: torch.cuda.Event | None\\n    host_owners: list[torch.Tensor] = field(default_factory=list)\\n    h2d_submitted: bool = False\\n    completion_valid: bool = True\\n    profile_active_entry_bytes: int | None = None\\n    native_plans: list = field(default_factory=list)\\n    side_payload: tuple = (0, 0)\\n    side_alignment: tuple = (0, 0)\\n    side_gap: tuple = (0, 0)\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef _factor_64(numel: int) -> Tuple[int, int]:\\n    \\\"\\\"\\\"Choose a compact 64-aligned 2-D view for one KV block.\\\"\\\"\\\"\\n    if numel <= 0 or numel % 4096:\\n        raise ValueError(\\n            f\\\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\\\")\\n    root = int(numel ** 0.5)\\n    for k in range((root // 64) * 64, 63, -64):\\n        if numel % k == 0 and (numel // k) % 64 == 0:\\n            return numel // k, k\\n    return numel // 64, 64\\n\\n\\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\\n    \\\"\\\"\\\"Persistent CD3 KV storage and batched GPU decode implementation.\\\"\\\"\\\"\\n\\n    kv_load_metrics_supported = True\\n    supports_kv_ownership = True\\n\\n    def __init__(self, comp_stream: torch.cuda.Stream):\\n        required = (\\n            \\\"decompress_chunk_delta3_batched_csr_pair_stream\\\",\\n            \\\"pack_host_chunk_delta3_entries_csr\\\",\\n            \\\"prepare_chunk_delta3_kv_decode\\\",\\n            \\\"KVSlotAllocator\\\",\\n            \\\"retire_kv_csr_slots\\\",\\n            \\\"prepare_host_chunk_delta3_csr_append\\\",\\n            \\\"append_host_chunk_delta3_csr\\\",\\n        )\\n        if (not _HAS_CHUNK_DELTA3\\n                or any(not hasattr(_cd3_ext, name) for name in required)):\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 requires the CSR KV decoder and native slot allocator\\\")\\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\\n        # constructor allocates an unrelated ANS workspace.  Initialise only\\n        # the common TensorCompressor and bookkeeping used by those helpers.\\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\\n        self.comp_stream = comp_stream\\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\\n        self.load_kv_stream = None\\n        self._kv_split_h2d_enabled = (\\n            os.getenv(\\\"TIERED_SERVE_KV_NO_SPLIT\\\", \\\"0\\\") != \\\"1\\\")\\n        # Two-stream event/ring overhead dominates small copies. Decide from\\n        # the bytes actually staged, not the requested-row count: a sparse\\n        # active set can have few rows but a much larger metadata payload.\\n        split_min_bytes = os.getenv(\\n            \\\"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\\\")\\n        self._kv_split_min_bytes = (\\n                (size,), torch.uint8, huge_page_allocator))\\n            remaining -= size\\n        self._entry_pool = _cd3_ext.HybridEntryPool(self._entry_arenas, segment_bytes)\\n        self._hybrid_ownership = {layer: {} for layer in range(n_layers)}\\n        logger.info(\\\"CD3 hybrid host budget=%d body=%d entries=%d scratch=%d counts=%d planner=%d segment=%d\\\",\\n                    budget.total_bytes, budget.body_bytes, pool_bytes, budget.scratch_bytes,\\n                    budget.count_bytes, self._hybrid_planner_bytes, segment_bytes)\\n\\n    def _new_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Lazily allocate stable pinned CSR storage for one layer/side.\\\"\\\"\\\"\\n        host_rows = self._max_n_blocks + 1\\n        max_words = host_rows * self._packed_capacity\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        initial_words = min(\\n            max_words,\\n            max(1024, host_rows * self._csr_initial_words_per_slot),\\n        )\\n        state = _PersistentCSRState(\\n            entries=torch.empty(\\n                initial_words, dtype=torch.int64).pin_memory(),\\n            offsets=torch.zeros(\\n                host_rows, dtype=torch.int64).pin_memory(),\\n            word_counts=np.zeros(host_rows, dtype=np.int64),\\n            used_words=0,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\\n        \\\"\\\"\\\"Compact append garbage off the request path in the CPU worker.\\\"\\\"\\\"\\n        pool = self._host_pools[layer_id][kv]\\n        rows = self._kv_slot_allocator[layer_id].high_water\\n        slots = np.arange(rows, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[:rows]\\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\\n                     * self._packed_capacity)\\n        if total_words > max_words:\\n            raise RuntimeError(\\n                \\\"ChunkDelta3 persistent CSR exceeds host slot capacity: \\\"\\n                f\\\"layer={layer_id} side={kv} words={total_words} \\\"\\n                f\\\"capacity={max_words}\\\")\\n        previous = self._persistent_csr[layer_id][kv]\\n        previous_capacity = (\\n            previous.entries.numel() if previous is not None else 0)\\n        capacity = max(\\n            1024, total_words,\\n            min(max_words, previous_capacity),\\n        )\\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\\n        offsets = torch.zeros(\\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\\n        if rows:\\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n                pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n                torch.from_numpy(slots), entries[:total_words],\\n                offsets[:rows])\\n        state = _PersistentCSRState(\\n            entries=entries,\\n            offsets=offsets,\\n            word_counts=np.zeros(\\n                self._max_n_blocks + 1, dtype=np.int64),\\n            used_words=total_words,\\n            garbage_words=0,\\n            max_words=max_words,\\n            gpu_words=gpu_words,\\n        )\\n        state.word_counts[:rows] = word_counts\\n        self._persistent_csr[layer_id][kv] = state\\n        return state\\n\\n    def _append_persistent_csr(\\n            self, layer_id: int, kv: str, slots: torch.Tensor) -> None:\\n        \\\"\\\"\\\"Append encoded slots using one native count/prefix calculation.\\\"\\\"\\\"\\n        count = slots.numel()\\n        if count == 0:\\n            return\\n        scratch = self._csr_append_scratch.get(layer_id)\\n        if scratch is None or scratch.shape[1] < count:\\n            capacity = max(count, 2 * scratch.shape[1] if scratch is not None else 0)\\n            scratch = torch.empty((2, capacity), dtype=torch.int64)\\n            self._csr_append_scratch[layer_id] = scratch\\n        new_word_counts = scratch[0, :count]\\n        relative_offsets = scratch[1, :count]\\n        pool = self._host_pools[layer_id][kv]\\n        state = self._persistent_csr[layer_id][kv]\\n        if state is None:\\n            state = self._new_persistent_csr(layer_id, kv)\\n        append_words, old_words = _cd3_ext.prepare_host_chunk_delta3_csr_append(\\n            pool[\\\"num_exceptions\\\"], slots, state.word_counts,\\n            new_word_counts, relative_offsets, self._packed_capacity)\\n\\n        required = int(state.used_words) + append_words\\n        # Reuse/re-encode churn can leave unreachable append records.  Only\\n        # compact in the worker when it avoids growth or is required to stay\\n        # within the fixed GPU CSR staging capacity.\\n        should_compact = required > state.max_words\\n        should_compact |= (\\n            required > state.gpu_words\\n            and self._kv_slot_allocator[layer_id].high_water\\n            <= self._max_gpu_decomp_blocks + 1)\\n        should_compact |= (\\n            required > state.entries.numel()\\n            and state.garbage_words + old_words >= append_words)\\n        if should_compact:\\n            # Scratch rows already contain the just-encoded values, so one\\n            # rebuild publishes both the old live set and this update.\\n            self._rebuild_persistent_csr(layer_id, kv)\\n            return\\n\\n        if required > state.entries.numel():\\n            capacity = min(\\n                state.max_words,\\n                max(required, state.entries.numel() * 2),\\n            )\\n            entries = torch.empty(\\n                capacity, dtype=torch.int64).pin_memory()\\n            entries[:state.used_words].copy_(\\n                state.entries[:state.used_words])\\n            offsets = state.offsets.clone().pin_memory()\\n            state.entries = entries\\n            state.offsets = offsets\\n\\n        _cd3_ext.append_host_chunk_delta3_csr(\\n            pool[\\\"entries20x3\\\"], slots, new_word_counts, relative_offsets,\\n            state.entries, state.offsets, state.word_counts,\\n            int(state.used_words), append_words)\\n        state.used_words = required\\n        state.garbage_words += old_words\\n\\n    def _discard_persistent_csr_slot(\\n            self, layer_id: int, slot: int) -> None:\\n        self._discard_persistent_csr_slots(\\n            layer_id, np.asarray([slot], dtype=np.int64))\\n\\n    def _discard_persistent_csr_slots(\\n            self, layer_id: int, slots: np.ndarray) -> None:\\n        \\\"\\\"\\\"Retire K/V scratch metadata together without touching H2D data.\\\"\\\"\\\"\\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\\n        if slots.size == 0:\\n            return\\n        counts = self._host_num_exceptions_np[layer_id]\\n        states = self._persistent_csr.get(layer_id, {})\\n        k_state, v_state = states.get(\\\"k\\\"), states.get(\\\"v\\\")\\n        # CSR rebuild replaces its state/word-count arrays. Resolve them now;\\n        # only the fixed scratch-pool views above are cached across callbacks.\\n        k_garbage, v_garbage = _cd3_ext.retire_kv_csr_slots(\\n            slots, counts[\\\"k\\\"], counts[\\\"v\\\"],\\n            k_state.word_counts if k_state is not None else None,\\n            v_state.word_counts if v_state is not None else None,\\n        )\\n        if k_state is not None:\\n            k_state.garbage_words += k_garbage\\n        if v_state is not None:\\n            v_state.garbage_words += v_garbage\\n\\n    def _acquire_csr_host_arena(\\n            self, length: int) -> Tuple[torch.Tensor, torch.Tensor | None]:\\n        \\\"\\\"\\\"Return an exact view backed by a retained pinned int64 arena.\\\"\\\"\\\"\\n        if length == 0:\\n            return torch.empty(0, dtype=torch.int64).pin_memory(), None\\n        capacity = 1 << (length - 1).bit_length()\\n        available = min((size for size in self._free_csr_host_arenas\\n                         if size >= capacity), default=None)\\n        if available is not None:\\n            bucket = self._free_csr_host_arenas[available]\\n            arena = bucket.pop()\\n            if not bucket:\\n                del self._free_csr_host_arenas[available]\\n    def _build_decode_plan(\\n            self, layer_id: int,\\n            block_ids: np.ndarray) -> _DecodePlan:\\n        self._reclaim_csr_plans()\\n        if self.storage_backend == \\\"hybrid\\\":\\n            from tiered_serve.chunk_delta3_kv_plan import prepare_hybrid_plan\\n            return prepare_hybrid_plan(self, layer_id, block_ids)\\n        n = len(block_ids)\\n        hwm = self._kv_slot_allocator[layer_id].high_water\\n        states = self._persistent_csr[layer_id]\\n        if states[\\\"k\\\"] is None or states[\\\"v\\\"] is None:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 persistent CSR is missing for layer={layer_id}\\\")\\n\\n        slots = np.ascontiguousarray(\\n            self._kv_slot_np[layer_id][block_ids], dtype=np.int32)\\n        if bool((slots < 0).any()):\\n            missing = int(block_ids[np.flatnonzero(slots < 0)[0]])\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV has no slot for layer={layer_id} \\\"\\n                f\\\"block={missing}\\\")\\n\\n        block_ids_tensor = torch.from_numpy(\\n            np.ascontiguousarray(block_ids, dtype=np.int64))\\n        block_ids_cpu, block_ids_owner = self._acquire_csr_host_arena(n)\\n        host_owners = [block_ids_owner] if block_ids_owner is not None else []\\n\\n        gpu_entry_capacity = self._gpu_decomp_pool_ring[0][\\\"k\\\"][\\n            \\\"entries20x3\\\"].numel()\\n        repack = any(\\n            states[kv].used_wor