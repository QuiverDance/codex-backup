cd3_pinned_routing_growth_after_reuse():\\n    \\\"\\\"\\\"The loaded runtime must honor the clean PyTorch allocator contract.\\\"\\\"\\\"\\n    if not torch.cuda.is_available():\\n        pytest.skip(\\\"CUDA required\\\")\\n    from tiered_serve.chunk_delta3_kv_plan import pinned_int64\\n\\n    torch._C._host_emptyCache()\\n    small = pinned_int64(np.arange(1527, dtype=np.int64))\\n    del small\\n    # Both allocations use the allocator's 16-KiB bucket. Its physical\\n    # reservation must cover the entire bucket, even after a smaller request.\\n    large = pinned_int64(np.arange(2048, dtype=np.int64))\\n    neighbor = pinned_int64(np.full(512, -1, dtype=np.int64))\\n    overlap = max(0, min(large.data_ptr() + large.nbytes,\\n                         neighbor.data_ptr() + neighbor.nbytes)\\n                  - max(large.data_ptr(), neighbor.data_ptr()))\\n    assert overlap == 0, \\\"loaded PyTorch pinned allocator returned overlapping storage\\\"\\n    assert torch.equal(large, torch.arange(2048, dtype=torch.int64))\\n    assert torch.equal(large.to(\\\"cuda\\\").cpu(), large)\\n\\n\\n@pytest.mark.parametrize(\\\"storage,execution\\\", [\\n    (\\\"csr\\\", \\\"serial\\\"), (\\\"csr\\\", \\\"pipeline\\\"),\\n    (\\\"hybrid\\\", \\\"serial\\\"), (\\\"hybrid\\\", \\\"pipeline\\\"),\\n])\\ndef test_cd3_async_storage_and_pipeline(monkeypatch, storage, execution):\\n    if not torch.cuda.is_available():\\n        pytest.skip(\\\"CUDA required\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", storage)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_EXECUTION\\\", execution)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_WORKERS\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_PIN\\\", \\\"0\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\\\", \\\"2\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"1\\\")\\n    from tiered_serve import kv_load_metrics\\n    from tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3KVCompressor\\n    from tiered_serve.kv_tail_residency import KVBlockOwnership\\n\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.Stream())\\n    compressor.load_kv_stream = torch.cuda.Stream()\\n    compressor._tb = True\\n    compressor.warmup_kv_buffers(\\n        (64, 64), 16, n_layers=2 if storage == \\\"hybrid\\\" else 1,\\n        max_gpu_decomp_blocks=2)\\n    if storage == \\\"hybrid\\\":\\n        def unexpected_backing_allocation(*args, **kwargs):\\n            raise AssertionError(\\\"hybrid append must reuse its reserved backing arenas\\\")\\n        monkeypatch.setattr(compressor, \\\"_alloc_host_tensor\\\", unexpected_backing_allocation)\\n    metrics = kv_load_metrics.configure(timing=True)\\n    ids = [1, 3, 4, 8, 12]\\n    source = [torch.ones((17, 64, 64), dtype=torch.bfloat16).pin_memory() for _ in range(2)]\\n    for side, values in enumerate(source):\\n        bits = values.view(torch.int16).view(17, -1)\\n        for index, block in enumerate(ids):\\n            # Vary exact exception counts and include signed zero, infinity,\\n            # subnormal and NaN payloads without overflowing encode scratch.\\n            patterns = torch.tensor([0, -32768, 1, 32640, 32705], dtype=torch.int16)\\n            positions = torch.arange(0, 4096, 71 + index * 13 + side)\\n            bits[block, positions] = patterns[torch.arange(len(positions)) % len(patterns)]\\n    output = [torch.full_like(source[0], -5, device=\\\"cuda\\\") for _ in range(2)]\\n\\n    def submit(blocks, generation, layer_id=0, values=None):\\n        routing = tuple(KVBlockOwnership(\\n            block_id=bid, canonical_block_id=bid + 100, request_id=f\\\"req-{bid // 5}\\\",\\n            block_index=bid, generation=generation) for bid in blocks)\\n        compressor.compress_batch_async_from_host(\\n            layer_id, blocks, *(source if values is None else values), ownership=routing)\\n        compressor.wait_compress_async(layer_id, (64, 64))\\n\\n    def decode(blocks, layer_id=0, expected_source=None):\\n        metrics.begin_forward(False, len(blocks))\\n        metrics.layer = layer_id\\n        compressor.prepare_active_set(blocks, np.array(blocks, dtype=np.int64))\\n        compressor.decompress_batch(layer_id, blocks, output)\\n        compressor.batch_decomp_stream.synchronize()\\n        for actual, expected in zip(output, source if expected_source is None else expected_source):\\n            assert torch.equal(actual[blocks].cpu().view(torch.int16), expected[blocks].view(torch.int16))\\n        snapshot = metrics.snapshot()\\n        assert snapshot[\\\"bytes_complete\\\"] == snapshot[\\\"timing_complete\\\"] == 1\\n        assert snapshot[\\\"cd3_k_h2d_bytes\\\"] + snapshot[\\\"cd3_v_h2d_bytes\\\"] == snapshot[\\\"kv_h2d_bytes\\\"]\\n        assert snapshot[\\\"cd3_copy_descriptors\\\"] > 0\\n        if storage == \\\"hybrid\\\":\\n            assert snapshot[\\\"kv_h2d_bytes\\\"] == (snapshot[\\\"kv_payload_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_metadata_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_alignment_bytes\\\"])\\n            assert snapshot[\\\"cd3_gap_bytes\\\"] == 0\\n        return snapshot\\n\\n    try:\\n        submit(ids, 1)\\n        decode(ids[:2])\\n        cached_plan = compressor._decode_plans[0]\\n        if storage == \\\"hybrid\\\":\\n            other_source = [torch.full_like(values, 7).pin_memory() for values in source]\\n            submit(ids[:2], 1, layer_id=1, values=other_source)\\n            # Interleaved layers bring the cached plan back to its original\\n            # ring. Different layer data makes stale ring contents observable.\\n            decode(ids[:2], layer_id=1, expected_source=other_source)\\n        decode(ids[:2])\\n        assert compressor._decode_plans[0] is cached_plan\\n        if storage == \\\"hybrid\\\":\\n            assert cached_plan.native_plan is not None\\n            assert not hasattr(cached_plan, \\\"native_plans\\\")  # One plan for both rings.\\n            # A subsequent submission uses the other ring with the same plan.\\n            decode(ids[:2])\\n            assert compressor._decode_plans[0] is cached_plan\\n        decode(ids)  # Multiple staging chunks, including both ring slots.\\n        decode(ids[::2])  # Sparse records must not copy inactive prefixes.\\n        compressor.free_persistent_blocks([3, 8])\\n        for values in source:\\n            values[3].fill_(2)\\n            values[8].fill_(4)\\n        submit([3, 8], 2)\\n        decode(ids)\\n        assert torch.all(output[0][0] == -5)\\n        if storage == \\\"hybrid\\\" and execution == \\\"pipeline\\\":\\n            old_values = [values[3].clone() for values in source]\\n            with torch.cuda.stream(compressor.load_kv_stream):\\n                torch.cuda._sleep(10_000_000)\\n            compressor.prepare_active_set(ids, np.asarray(ids, dtype=np.int64))\\n            compressor.decompress_batch(0, ids, output)\\n            with torch.cuda.stream(compressor.batch_decomp_stream):\\n                old_output = [values[3].clone() for values in output]\\n            # Reuse the physical slot while its preceding H2D is still queued.\\n            # The encoder must wait before overwriting that body's source row.\\n            compressor.free_persistent_blocks([3])\\n            for values in source:\\n                values[3].fill_(8)\\n            submit([3], 3)\\n            decode(ids)\\n            for actual, expected in zip(old_output, old_values):\\n                assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n        compressor.stop_kv_compress_workers()  # Explicit cleanup is idempotent.\\n        metrics.close()\\n\"}"}],"internal_ch