{"timestamp":"2026-08-26T10:07:12.290Z","ordinal":301,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d89-bda2-7092-8b10-6421247f79f9","call_id":"call_paSwlPEVyuYjnMviLZ60uJiq","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        self,\n        num_gpu_blocks: int,\n        enable_caching: bool,\n        hash_block_size: int,\n        enable_kv_cache_events: bool = False,\n        metrics_collector: KVCacheMetricsCollector | None = None,\n        shared_block_mode: bool = False,\n    ):\n        assert isinstance(num_gpu_blocks, int) and num_gpu_blocks > 0\n        self.num_gpu_blocks = num_gpu_blocks\n        self.enable_caching = enable_caching\n        self.hash_block_size = hash_block_size\n        # All kv-cache blocks.\n        self.blocks: list[KVCacheBlock] = [\n            KVCacheBlock(idx) for idx in range(num_gpu_blocks)\n        ]\n        # Free block queue that constructs and manipulates a doubly linked\n        # list of free blocks (including eviction candidates when caching is\n        # enabled).\n        self.free_block_queue = FreeKVCacheBlockQueue(self.blocks)\n\n        # Cache for block lookup\n        self.cached_block_hash_to_block: BlockHashToBlockMap = BlockHashToBlockMap()\n\n        # To represent a placeholder block with block_id=0.\n        # The ref_cnt of null_block is not maintained, needs special care to\n        # avoid freeing it.\n        self.null_block = self.free_block_queue.popleft()\n        self.null_block.is_null = True\n\n        self.enable_kv_cache_events = enable_kv_cache_events\n        self.kv_event_queue: list[KVCacheEvent] = []\n\n        self.metrics_collector = metrics_collector\n\n        # Tiered-serve: optional callbacks after block allocation/free\n        self.on_blocks_allocated: Any | None = None  # Callable[[list[KVCacheBlock]], None]\n        self.on_blocks_freed: Any | None = None  # Callable[[list[KVCacheBlock]], None]\n\n        # Tiered-serve SharedBlockAllocator: round-robin allocation,\n        # free is no-op, scheduler always sees full capacity.\n        self.shared_block_mode = shared_block_mode\n        self._shared_alloc_counter = 0\n\n        # Tiered-serve offline fragmentation benchmark: select physical\n        # offloadable blocks from a seeded random permutation at allocation\n        # time. Cache every setting here so get_new_blocks() does not read the\n        # environment on the scheduler hot path.\n        self._random_alloc_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_RANDOM_ALLOC\", \"0\") == \"1\")\n        self._random_alloc_seed = int(\n            os.getenv(\"TIERED_SERVE_KV_RANDOM_ALLOC_SEED\", \"0\"))\n        self._random_alloc_group_size = int(\n            os.getenv(\"TIERED_SERVE_KV_RANDOM_ALLOC_GROUP_SIZE\", \"1\"))\n        self._random_alloc_order: list[int] | None = None\n        self._random_alloc_cursor = 0\n        self._random_alloc_boundary: int | None = None\n        if self._random_alloc_enabled:\n            if self._random_alloc_group_size < 1:\n                raise ValueError(\n                    \"TIERED_SERVE_KV_RANDOM_ALLOC_GROUP_SIZE must be >= 1\")\n            if self.enable_caching:\n                raise ValueError(\n                    \"random KV allocation requires prefix caching to be \"\n                    \"disabled\")\n            if self.shared_block_mode:\n                raise ValueError(\n                    \"random KV allocation is incompatible with \"\n                    \"shared_block_mode\")\n            if os.getenv(\"TIERED_SERVE_KV_LOCALITY\", \"0\") == \"1\":\n                raise ValueError(\n                    \"random KV allocation is incompatible with \"\n                    \"TIERED_SERVE_KV_LOCALITY=1\")\n            if getattr(self.free_block_queue, \"_addr_order\", False):\n                raise ValueError(\n                    \"random KV allocation is incompatible with \"\n                    \"TIERED_SERVE_KV_ADDR_ORDER=1\")\n            logger.info(\n                \"tiered-serve: random KV allocation enabled \"\n                \"(seed=%d, group_size=%d)\",\n                self._random_alloc_seed, self._random_alloc_group_size)\n\n    def get_cached_block(\n        self, block_hash: BlockHash, kv_cache_group_ids: list[int]\n    ) -> list[KVCacheBlock] | None:\n        \"\"\"Get the cached block by the block hash for each group in\n        `kv_cache_group_ids`, or None if cache miss for any group.\n        If there are duplicated blocks, we return the first block in the cache.\n\n        Args:\n            block_hash: The hash value of the block.\n            kv_cache_group_ids: The ids of the KV cache groups.\n\n        Returns:\n            The cached blocks if exists, or None.\n        \"\"\"\n\n        if self._random_alloc_enabled:\n            ret = self._get_new_blocks_randomized(num_blocks)\n        else:\n            ret = self.free_block_queue.popleft_n(num_blocks)\n\n        # In order to only iterate the list once, we duplicated code a bit\n        if self.enable_caching:\n            for block in ret:\n                self._maybe_evict_cached_block(block)\n                assert block.ref_cnt == 0\n                block.ref_cnt += 1\n                if self.metrics_collector:\n                    self.metrics_collector.on_block_allocated(block)\n        else:\n            for block in ret:\n                assert block.ref_cnt == 0\n                block.ref_cnt += 1\n                if self.metrics_collector:\n                    self.metrics_collector.on_block_allocated(block)\n\n        if self.on_blocks_allocated is not None:\n            self.on_blocks_allocated(ret)\n\n        return ret\n\n    def initialize_random_alloc_order(self) -> None:\n        \"\"\"Precompute the optional random order during engine initialization.\"\"\"\n        if not self._random_alloc_enabled:\n            return\n        boundary = self.free_block_queue.num_dedicated_blocks\n        if boundary is None:\n            raise RuntimeError(\n                \"random KV allocation requires num_dedicated_blocks to be \"\n                \"initialized before the first request\")\n        if (self._random_alloc_order is not None\n                and self._random_alloc_boundary == boundary):\n            return\n\n        # Block 0 is vLLM's null block. The dedicated range is selected from\n        # the normal queue head; only offloadable physical IDs participate in\n        # the random permutation.\n        first_offloadable = max(int(boundary), 1)\n        ids = list(range(first_offloadable, self.num_gpu_blocks))\n        group_size = self._random_alloc_group_size\n        groups = [\n            ids[start:start + group_size]\n            for start in range(0, len(ids), group_size)\n        ]\n        random.Random(self._random_alloc_seed).shuffle(groups)\n        self._random_alloc_order = [\n            block_id for group in groups for block_id in group\n        ]\n        self._random_alloc_cursor = 0\n        self._random_alloc_boundary = int(boundary)\n        logger.info(\n            \"tiered-serve: initialized random KV allocation order \"\n            \"(D=%d, offloadable=%d, groups=%d)\",\n            boundary, len(ids), len(groups))\n\n    @staticmethod\n    def _random_alloc_is_free(block: KVCacheBlock) -> bool:\n        return (block.ref_cnt == 0\n                and block.prev_free_block is not None\n                and block.next_free_block is not None\n                and not block.is_null)\n\n    def _get_new_blocks_randomized(\n            self, num_blocks: int) -> list[KVCacheBlock]:\n        \"\"\"Remove blocks from the free pool using the random allocation order.\n\n        Free dedicated blocks remain first priority. Offloadable blocks follow\n        a seeded permutation and are removed from the linked free queue in\n        O(1) each; a cyclic scan skips blocks that are currently in use.\n        \"\"\"\n        if num_blocks == 0:\n            return []\n\n        free_queue = self.free_block_queue\n        if self._random_alloc_order is None:\n            raise RuntimeError(\n                \"random KV allocation order was not initialized before the \"\n                \"first request\")\n        if (free_queue.num_dedicated_blocks\n                != self._random_alloc_boundary):\n            raise RuntimeError(\n                \"random KV allocation dedicated boundary changed after \"\n                f\"initialization: initialized={self._random_alloc_boundary}, \"\n                f\"current={free_queue.num_dedicated_blocks}\")\n        # A fully idle pool marks a new independent request wave. Restart the\n        # seeded offloadable order so repeated batches/configs do not depend on\n        # the previous wave's cursor.\n        if free_queue.num_free_blocks == self.num_gpu_blocks - 1:\n            self._random_alloc_cursor = 0\n        boundary = self._random_alloc_boundary or 0\n        selected: list[KVCacheBlock] = []\n\n        # Preserve tiered-serve's dedicated-first policy. Dedicated frees are\n        # inserted at the queue head, and the initial queue is address ordered.\n        while len(selected) < num_blocks:\n            block = free_queue.fake_free_list_head.next_free_block\n            if (block is None\n                    or block is free_queue.fake_free_list_tail\n                    or block.block_id >= boundary):\n                break\n            selected.append(free_queue.popleft())\n\n        remaining = num_blocks - len(selected)\n        order = self._random_alloc_order\n        if remaining == 0:\n            return selected\n        if not order:\n            raise RuntimeError(\n                \"random KV allocation has no offloadable block IDs\")\n\n        scanned = 0\n        while remaining > 0 and scanned < len(order):\n            block_id = order[self._random_alloc_cursor]\n            self._random_alloc_cursor = (\n                self._random_alloc_cursor + 1) % len(order)\n            scanned += 1\n            block = self.blocks[block_id]\n            if not self._random_alloc_is_free(block):\n                continue\n            free_queue.remove(block)\n            selected.append(block)\n            remaining -= 1\n\n        if remaining:\n            raise RuntimeError(\n                \"random KV allocation could not find enough offloadable \"\n                f\"blocks: requested={num_blocks}, selected={len(selected)}, \"\n                f\"free={free_queue.num_free_blocks}\")\n        return selected\n\n    # ── tiered-serve: locality-aware allocation ──────────────────────────\n    # Gated by TIERED_SERVE_KV_LOCALITY=1.  Goal: keep each sequence's\n    # offloadable blocks contiguous so the KV-offload transfer planner emits\n    # few, hole-free memcpy ranges.  Strategy:\n    #   1. decode: extend from last_block_by_req[req] + 1 (\"+1 chain\"),\n    #   2. prefill / shortfall: grab a contiguous free run via a cursor,\n    #   3. fallback: popleft, de-prioritising other requests' reserved\n    #      successors.\n    # Free-queue membership (block in list ⇔ prev_free_block is not None and\n    # ref_cnt == 0) is the is-free oracle, so no external bitmap to keep in\n    # sync.  Post-processing (eviction/ref/metrics/callback) mirrors\n    # get_new_blocks() exactly so cache bookkeeping is identical.\n    def _locality_on(self) -> bool:\n        v = getattr(self, \"_locality_enabled_cached\", None)\n        if v is None:\n            v = os.getenv(\"TIERED_SERVE_KV_LOCALITY\", \"0\") == \"1\"\n            self._locality_enabled_cached = v\n        return v\n\n    def _loc_init_state(self) -> None:\n        if not hasattr(self, \"_last_block_by_req\"):\n            self._last_block_by_req: dict[str, int] = {}\n            self._protected_successors: dict[int, str] = {}\n            self._locality_cursor = 0\n            logger.info(\n                \"tiered-serve: KV locality allocator ACTIVE \"\n                \"(num_dedicated_blocks=%s)\",\n                self.free_block_queue.num_dedicated_blocks)\n\n    def _loc_is_free(self, block: KVCacheBlock) -> bool:\n        return (block.ref_cnt == 0\n                and block.prev_free_block is not None\n                and not block.is_null)\n\n    def _loc_find_run(self, n: int, nded: int, nblk: int,\n                      request_id: str) -> int | None:\n        \"\"\"Find a start s with [s, s+n) all free (and not reserved by other\n        reqs).  Forward scan from the cursor; returns None if none found.\"\"\"\n        start = max(self._locality_cursor, nded)\n        if start + n > nblk:\n            start = nded\n    in O(1) time. To close the performance gap to the builtin deque which is\n    implemented in C++, this class does not allocate any Python objects when\n    manipulating the linked list. Instead, this class manipulates the\n    prev_free_block and next_free_block attributes of the given blocks.\n\n    The queue is ordered by block ID in the beginning. When a block is allocated\n    and then freed, it will be appended back with the eviction order:\n    1. The least recent used block is at the front (LRU).\n    2. If two blocks have the same last accessed time (allocated by the\n       same sequence), the one with more hash tokens (the tail of a block\n       chain) is at the front.\n    Note that we maintain this order by reversing the block order when free\n    blocks of a request. This operation is outside of this class.\n\n    Args:\n        blocks: A list of KVCacheBlock objects.\n    \"\"\"\n\n    def __init__(self, blocks: list[KVCacheBlock]) -> None:\n        self.num_free_blocks = len(blocks)\n        # When set, freed dedicated blocks (block_id < boundary) are\n        # re-inserted near the head so they are allocated before offloadable\n        # blocks.  Set by tiered-serve after initialization.\n        self.num_dedicated_blocks: int | None = None\n\n        # tiered-serve: address-ordered first-fit.  When enabled, freed blocks\n        # are re-inserted in block_id-sorted position so allocation always\n        # hands out the lowest free block.  Because dedicated ids [0,D) sort\n        # below offloadable [D,N), this preserves dedicated-first AND keeps the\n        # in-use offloadable set packed at low indices (high avg_run), so heavy\n        # phases don't fragment LPDDR5 staging for later phases.  Default off;\n        # the linked list is initialized sorted, so the invariant holds once on.\n        self._addr_order = (\n            os.getenv(\"TIERED_SERVE_KV_ADDR_ORDER\", \"1\") == \"1\")\n\n        # Initialize doubly links of consecutive blocks\n        for i in range(self.num_free_blocks):\n            if i > 0:\n                blocks[i].prev_free_block = blocks[i - 1]\n            if i < self.num_free_blocks - 1:\n                blocks[i].next_free_block = blocks[i + 1]\n\n        # Create a fake head and a tail block for the doubly linked list to\n        # reduce branching in the code\n        #\n        # The implementation guaranteed that the fake head and tail\n        # are NEVER got popped, so we could safely assume each real blocks\n        # in the queue has prev and next blocks.\n        self.fake_free_list_head = KVCacheBlock(block_id=-1)\n        self.fake_free_list_tail = KVCacheBlock(block_id=-1)\n        if self.num_free_blocks > 0:\n            # Connect fake_head and fake_tail to the first and last block\n            # respectively.\n            self.fake_free_list_head.next_free_block = blocks[0]\n            blocks[0].prev_free_block = self.fake_free_list_head\n            self.fake_free_list_tail.prev_free_block = blocks[-1]\n            blocks[-1].next_free_block = self.fake_free_list_tail\n        else:\n            # For empty list, simply connect the fake head and tail.\n            self.fake_free_list_head.next_free_block = self.fake_free_list_tail\n            self.fake_free_list_tail.prev_free_block = self.fake_free_list_head\n\n    def popleft(self) -> KVCacheBlock:\n        \"\"\"Pop the first free block and reduce num_free_blocks by 1.\n\n        Returns:\n            The first free block.\n        \"\"\"\n        if (\n            self.fake_free_list_head.next_free_block is self.fake_free_list_tail\n            or self.fake_free_list_head.next_free_block is None\n        ):\n            assert self.num_free_blocks == 0, (\n                f\"num_free_blocks ({self.num_free_blocks}) is out of sync \"\n                \"with the free list.\"\n            )\n            raise ValueError(\"No free blocks available\")\n\n        first_block: KVCacheBlock = self.fake_free_list_head.next_free_block\n\n        if first_block.next_free_block is None:\n            # This should not happen if the block is from the free list.\n            # It indicates a bug in the caller's logic.\n            raise RuntimeError(\n                \"Invalid block found in popleft() \"\n                \"which doesn't have a valid next_free_block\"\n            )\n\n        # Connect fake_head and the next block of first_block (i.e. second block\n        # or fake tail).\n        self.fake_free_list_head.next_free_block = first_block.next_free_block\n        first_block.next_free_block.prev_free_block = self.fake_free_list_head\n\n        # Remove the block from the linked list.\n        first_block.prev_free_block = first_block.next_free_block = None\n\n        self.num_free_blocks -= 1\n        return first_block\n\n    def popleft_n(self, n: int) -> list[KVCacheBlock]:\n        \"\"\"Pop the first n free blocks and reduce num_free_blocks by n.\n\n        Args:\n            n: The number of blocks to pop.\n\n        Returns:\n            A list of n free blocks.\n        \"\"\"\n        if n == 0:\n            return []\n        assert self.num_free_blocks >= n\n        self.num_free_blocks -= n\n\n        curr_block = self.fake_free_list_head.next_free_block\n        # Pop n blocks from the head of the list\n        ret = []\n        for _ in range(n):\n            assert curr_block is not None\n            ret.append(curr_block)\n            last_block = curr_block\n            curr_block = curr_block.next_free_block\n            # Reset prev_free_block and next_free_block of all popped blocks\n            last_block.prev_free_block = None\n            last_block.next_free_block = None\n\n        if curr_block is not None:\n            # The queue is not empty, connect the fake head to\n            # the new first block.\n            self.fake_free_list_head.next_free_block = curr_block\n            curr_block.prev_free_block = self.fake_free_list_head\n        return ret\n\n    def remove(self, block: KVCacheBlock) -> None:\n        \"\"\"Remove a block in the free list and reduce num_free_blocks by 1.\n\n        Args:\n            block: The block to remove.\n        \"\"\"\n        if block.prev_free_block is None or block.next_free_block is None:\n            # This should not happen if the block is from the free list.\n            # It indicates a bug in the caller's logic.\n            raise RuntimeError(f\"remove() called on an invalid block: {block}\")\n\n        # Link the previous block to the next block.\n        block.prev_free_block.next_free_block = block.next_free_block\n        # Link the next block to the previous block.\n        block.next_free_block.prev_free_block = block.prev_free_block\n\n        # Remove the block from the linked list.\n        block.prev_free_block = block.next_free_block = None\n        self.num_free_blocks -= 1\n\n    def _append_after(self, anchor: KVCacheBlock,\n                       block: KVCacheBlock) -> None:\n        \"\"\"Insert *block* immediately after *anchor* in the linked list.\"\"\"\n        next_block = anchor.next_free_block\n        assert next_block is not None\n        anchor.next_free_block = block\n        block.prev_free_block = anchor\n        block.next_free_block = next_block\n        next_block.prev_free_block = block\n\n    def _insert_one_sorted(self, block: \"KVCacheBlock\") -> None:\n        \"\"\"Insert *block* into its block_id-sorted position. Walks from the\n        nearer end to bound the scan; the list is kept fully sorted so the\n        in-use set stays packed at low indices. Used only when _addr_order.\"\"\"\n        bid = block.block_id\n        head = self.fake_free_list_head\n        tail = self.fake_free_list_tail\n        first = head.next_free_block\n        last = tail.prev_free_block\n        if first is tail:                       # empty list\n            self._append_after(head, block)\n            return\n        if bid <= first.block_id:               # new minimum → front\n            self._append_after(head, block)\n            return\n        if bid >= last.block_id:                # new maximum → tail\n            last.next_free_block = block\n            block.prev_free_block = last\n            block.next_free_block = tail\n            tail.prev_free_block = block\n            return\n        # Interior: scan from whichever end is closer in id space.\n        if bid - first.block_id <= last.block_id - bid:\n            cur = first\n            while cur is not tail and cur.block_id < bid:\n                cur = cur.next_free_block\n            self._append_after(cur.prev_free_block, block)\n        else:\n            cur = last\n            while cur is not head and cur.block_id > bid:\n                cur = cur.prev_free_block\n            self._append_after(cur, block)\n\n    def append(self, block: KVCacheBlock) -> None:\n        \"\"\"Put a block back into the free list and increase\n        num_free_blocks by 1.\n\n        If *num_dedicated_blocks* is set and the block is a dedicated block\n        (block_id < num_dedicated_blocks), it is inserted right after\n        fake_free_list_head so that dedicated blocks are always popped\n        before offloadable blocks.\n\n        Args:\n            block: The block to append.\n        \"\"\"\n        if self.fake_free_list_tail.prev_free_block is None:\n            raise RuntimeError(\n                \"prev_free_block of fake_free_list_tail should always exist\"\n            )\n\n        if self._addr_order:\n            self._insert_one_sorted(block)\n            self.num_free_blocks += 1\n            return\n\n        if (self.num_dedicated_blocks is not None\n                and block.block_id < self.num_dedicated_blocks):\n            # Dedicated block → insert at front (after fake head)\n            self._append_after(self.fake_free_list_head, block)\n        else:\n            # Offloadable (or no boundary set) → append at tail\n            last_block = self.fake_free_list_tail.prev_free_block\n            last_block.next_free_block = block\n            block.prev_free_block = last_block\n            block.next_free_block = self.fake_free_list_tail\n            self.fake_free_list_tail.prev_free_block = block\n\n        self.num_free_blocks += 1\n\n    def append_n(self, blocks: list[KVCacheBlock]) -> None:\n        \"\"\"Put a list of blocks back into the free list.\n\n        When *num_dedicated_blocks* is set, dedicated blocks are inserted\n        at the front and offloadable blocks at the tail so that dedicated\n        blocks are always allocated first.\n\n        Args:\n            blocks: The blocks to append.\n        \"\"\"\n        if len(blocks) == 0:\n            return\n\n        if self._addr_order:\n            # Insert ascending so each insert tends to extend the previous\n            # one's position (cheap when freeing a packed low-id run).\n            for block in sorted(blocks, key=lambda b: b.block_id):\n                self._insert_one_sorted(block)\n            self.num_free_blocks += len(blocks)\n            return\n\n        boundary = self.num_dedicated_blocks\n        if boundary is not None:\n            dedicated = [b for b in blocks if b.block_id < boundary]\n            offloadable = [b for b in blocks if b.block_id >= boundary]\n        else:\n            dedicated = []\n            offloadable = blocks\n\n        # Prepend dedicated blocks right after fake_head\n        if dedicated:\n            # Build a sub-chain: dedicated[0] <-> ... <-> dedicated[-1]\n            for i in range(len(dedicated) - 1):\n                dedicated[i].next_free_block = dedicated[i + 1]\n                dedicated[i + 1].prev_free_block = dedicated[i]\n            # Splice into list: fake_head <-> dedicated_chain <-> old_first\n            old_first = self.fake_free_list_head.next_free_block\n            assert old_first is not None\n            self.fake_free_list_head.next_free_block = dedicated[0]\n            dedicated[0].prev_free_block = self.fake_free_list_head\n            dedicated[-1].next_free_block = old_first\n            old_first.prev_free_block = dedicated[-1]\n\n        # Append offloadable blocks at the tail\n        if offloadable:\n            last_block = self.fake_free_list_tail.prev_free_block\n            assert last_block is not None\n            for block in offloadable:\n                block.prev_free_block = last_block\n                last_block.next_free_block = block\n                last_block = block\n            last_block.next_free_block = self.fake_free_list_tail\n            self.fake_free_list_tail.prev_free_block = last_block\n\n        self.num_free_blocks += len(blocks)\n\n    def get_all_free_blocks(self) -> list[KVCacheBlock]:\n        \"\"\"Get all free blocks in the free list. Mainly used for testing.\n\n        Returns:\n            A list of free blocks.\n        \"\"\"\n        ret = []\n        if self.fake_free_list_head.next_free_block is None:\n            raise RuntimeError(\nimport logging\nimport os\nfrom typing import List, Tuple\n\nimport numpy as np\nimport torch\n\nlogger = logging.getLogger(__name__)\n\n\nclass KVOffloadScheduler:\n    \"\"\"\n    C++에서 제거된 스케줄링 및 병합 로직(Control Plane)을\n    Python에서 수행하는 클래스.\n    \"\"\"\n    def __init__(\n        self,\n        uncompressed_k_cache_tensors: List[torch.Tensor],\n        # PipelineWorkerManager로 전달할 Span의 최대 크기 (Bytes)\n        pipeline_max_span_bytes: int = 1 * 1024 * 1024, # 1MB\n        \n        # Load/Unload 시 병합할 최대 크기 (Bytes)\n        transfer_max_span_bytes: int = 64 * 1024 * 1024 # 64MB\n    ):\n        self.pipeline_max_span_bytes = pipeline_max_span_bytes\n        self.transfer_max_span_bytes = transfer_max_span_bytes\n\n        k_tensor_0 = uncompressed_k_cache_tensors[0]\n        self.common_stride_bytes = k_tensor_0.stride(0) * k_tensor_0.element_size()\n        self.log_copy_waste = os.getenv(\"TIERED_SERVE_LOG_KV_COPY_WASTE\", \"0\") == \"1\"\n\n        # ── Merge policy ─────────────────────────────────────────────────\n        # 'span'    : legacy span-cap merge (default).\n        # 'gap_cost': count-based — emit at most ``max_copy_calls`` memcpy\n        #   ranges by merging the smallest gaps first.  This path is\n        #   launch/CPU-bound, so the *number* of memcpy calls dominates; we\n        #   cap it directly instead of reasoning about wasted bytes.  Ranges\n        #   are merged only when there are more than max_copy_calls of them,\n        #   so a small/contiguous working set pays zero extra copy.\n        self.merge_policy = os.getenv(\n            \"TIERED_SERVE_KV_MERGE_POLICY\", \"span\").lower()\n        self.max_copy_calls = int(\n            os.getenv(\"TIERED_SERVE_KV_MAX_COPY_CALLS\", \"8\"))\n        # Cache hot-path env read ONCE here — os.getenv() per unload/load call\n        # (×n_layers ×step) is needless function-call + dict-lookup overhead on\n        # the dispatch path we're trying to keep light.\n        self._batch_unload = os.getenv(\n            \"TIERED_SERVE_KV_UNLOAD_BATCH\", \"1\") == \"1\"\n\n        logger.info(\n            \"KVOffloadScheduler merge_policy=%s max_copy_calls=%d \"\n            \"kv_locality=%s\",\n            self.merge_policy, self.max_copy_calls,\n            os.getenv(\"TIERED_SERVE_KV_LOCALITY\", \"0\"))\n        self.last_copy_waste_stats = {\n            \"load_uncompressed\": None,\n            \"unload_uncompressed\": None,\n            \"pipeline_offload\": None,\n        }\n\n        # Step-level load-span cache: every layer of a step passes the SAME\n        # active-id list object (built once per step in torch_hooks), so the\n        # sort + consecutive-merge (+ span merge) runs once per step instead\n        # of x n_layers.  Keyed on object IDENTITY with the reference HELD —\n        # holding the key keeps the list alive so its identity cannot be\n        # recycled for a different list (same safety argument as the\n        # decompress-filter cache in p4flat_kv_compressor).\n        self._load_span_cache_key = None\n        self._load_span_cache = None\n        self._unload_span_cache_key = None\n        self._unload_span_cache = None\n\n    def _calc_copy_waste_stats(\n        self,\n        block_ids: List[int],\n        final_spans: List[Tuple[int, int]],\n        stride_bytes: int,\n        mode: str,\n        max_span_bytes: int,\n    ) -> dict:\n        requested_count = len(block_ids)\n        copied_blocks = 0\n        for start, end in final_spans:\n            copied_blocks += (end - start)\n\n        copied_bytes = copied_blocks * stride_bytes\n        needed_bytes = requested_count * stride_bytes\n        waste_blocks = max(0, copied_blocks - requested_count)\n        waste_bytes = max(0, copied_bytes - needed_bytes)\n        waste_ratio = (waste_bytes / copied_bytes) if copied_bytes > 0 else 0.0\n\n        max_blocks_per_span = max_span_bytes // stride_bytes if stride_bytes > 0 else 0\n        worst_waste_per_span_bytes = (\n            max(0, max_blocks_per_span - 2) * stride_bytes if max_blocks_per_span > 0 else 0\n        )\n\n        stats = {\n            \"mode\": mode,\n            \"policy\": self.merge_policy,\n            \"requested_blocks\": requested_count,\n            \"num_spans\": len(final_spans),\n            \"copied_blocks\": copied_blocks,\n            \"waste_blocks\": waste_blocks,\n            \"stride_bytes\": stride_bytes,\n            \"copied_bytes\": copied_bytes,\n            \"needed_bytes\": needed_bytes,\n            \"waste_bytes\": waste_bytes,\n            \"waste_ratio\": waste_ratio,\n            \"max_span_bytes\": max_span_bytes,\n            \"max_blocks_per_span\": max_blocks_per_span,\n            \"worst_waste_per_span_bytes\": worst_waste_per_span_bytes,\n        }\n        return stats\n\n    def _record_copy_waste_stats(self, key: str, stats: dict):\n        self.last_copy_waste_stats[key] = stats\n        if self.log_copy_waste:\n            logger.info(\n                \"[KV_COPY_WASTE] mode=%s policy=%s req=%d spans=%d copied=%d \"\n                \"waste_blocks=%d waste_bytes=%d waste_ratio=%.4f\",\n                stats['mode'], stats['policy'], stats['requested_blocks'],\n                stats['num_spans'], stats['copied_blocks'],\n                stats['waste_blocks'], stats['waste_bytes'],\n                stats['waste_ratio'])\n\n    def get_last_copy_waste_stats(self, key: str = None):\n        if key is None:\n            return self.last_copy_waste_stats\n        return self.last_copy_waste_stats.get(key)\n\n    def _merge_consecutive_blocks(\n        self, block_ids: List[int]\n    ) -> List[Tuple[int, int]]:\n        \"\"\"\n        정렬된 블록 ID 리스트를 받아, 연속된 블록들을 범위(range)로 1차 병합합니다.\n        (예: [1, 2, 3, 5, 6, 8] -> [(1, 4), (5, 7), (8, 9)])\n\n        Vectorized: run boundaries fall where the id step != 1 (np.diff),\n        so the merge is three numpy ops instead of a Python loop over every\n        id — this ran per layer per step on the forward thread and was the\n        bulk of the nsys CPU gap before the load's cudaMemcpyBatchAsync\n        (~0.5 ms of pure Python at ~6k active ids).\n        \"\"\"\n        n = len(block_ids)\n        if n == 0:\n        return contiguous_blocks\n\n    def load(self, non_blocking=True):\n        t = self._get_cont_blks()\n        if logger.isEnabledFor(logging.DEBUG) and t:\n            logger.debug(f\"LOAD KVCACHE {self.layer_id} {t}\")\n        torch.cuda.nvtx.mark(f\"LOAD KVCACHE {self.layer_id} {t}\")\n\n        if not t:\n            return\n\n        # Flatten [(b0,e0),(b1,e1),...] → [b0,e0,b1,e1,...] and let C++\n        # subtract ded_offset and compute pointers — zero per-element\n        # Python overhead.\n        ranges_flat = [v for pair in t for v in pair]\n        stream = torch.cuda.current_stream()\n\n        if self.layer_id == 0 and vLLMKVCache._resolve_log_copy_waste():\n            cls = vLLMKVCache\n            # Read PREVIOUS step's layer-0 memcpy time (events done by now) and\n            # emit it with that step's stashed fragmentation.\n            if cls._inflight_frag is not None and cls._load_evt_b is not None:\n                try:\n                    ms = cls._load_evt_a.elapsed_time(cls._load_evt_b)\n                    f = cls._inflight_frag\n                    # Bytes staged = blocks * (K + V per-block bytes). load\n                    # copies K from primary_kv, V from secondary_kv.\n                    per_block = (\n                        self.primary_kv[0].stride(0)\n                        * self.primary_kv[0].element_size()\n                        + self.secondary_kv[0].stride(0)\n                        * self.secondary_kv[0].element_size())\n                    mb = f[\"blocks\"] * per_block / 1e6\n                    bw = (mb / ms) if ms > 0 else 0.0  # MB/ms = GB/s\n                    logger.info(\n                        \"KV LOAD WASTE: spans=%d calls=%d blocks=%d \"\n                        \"avg_run=%.1f holes=%d memcpy_ms=%.3f MB=%.1f \"\n                        \"bw=%.1f GB/s\",\n                        f[\"spans\"], f[\"calls\"], f[\"blocks\"],\n                        f[\"avg_run\"], f[\"holes\"], ms, mb, bw)\n                except Exception:\n                    pass\n            if cls._load_evt_a is None:\n                cls._load_evt_a = torch.cuda.Event(enable_timing=True)\n                cls._load_evt_b = torch.cuda.Event(enable_timing=True)\n            cls._load_evt_a.record(stream)\n            _get_zipserv().batch_kv_memcpy(\n                self.primary_kv[0], self.primary_kv[1],\n                self.secondary_kv[0], self.secondary_kv[1],\n                ranges_flat, self.num_dedicated_blocks,\n                stream.cuda_stream)\n            cls._load_evt_b.record(stream)\n            cls._inflight_frag = cls._cur_frag\n        else:\n            _get_zipserv().batch_kv_memcpy(\n                self.primary_kv[0], self.primary_kv[1],\n                self.secondary_kv[0], self.secondary_kv[1],\n                ranges_flat, self.num_dedicated_blocks,\n                stream.cuda_stream)\n\n    def _get_cont_blks(self):\n        if self.layer_id == 0:\n            raw_blocks = vLLMKVCache.calc_cont_bit_blocks()\n\n            # --- [수정] Dedicated 블록 필터링 로직 추가 ---\n            filtered_blocks = []\n            for start, end in raw_blocks:\n                # 1. 블록이 dedicated 영역에 걸쳐 있는 경우, 복사할 부분만 잘라내서 추가\n                # 예: num_dedicated_blocks=16, block=(10, 20) -> (16, 20)만 추가\n                if (start < self.num_dedicated_blocks\n                        and end > self.num_dedicated_blocks):\n                    filtered_blocks.append((self.num_dedicated_blocks, end))\n\n                # 2. 블록 전체가 복사 대상인 경우 (가장 흔한 케이스)\n                elif start >= self.num_dedicated_blocks:\n                    filtered_blocks.append((start, end))\n\n                # 3. 블록 전체가 dedicated 