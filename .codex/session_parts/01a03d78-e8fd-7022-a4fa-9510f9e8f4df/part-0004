       min(d_max_hbm,\n                            num_blocks_total - o_max,\n                            num_blocks_total - 1))\n                    # Determinism: vLLM's profiling measures gpu_avail with a few\n                    # MB of run-to-run jitter -> num_dedicated_hbm flips by +-1\n                    # block run-to-run, which SHIFTS the dedicated/offloadable\n                    # boundary (block_id >= num_dedicated => offloadable).  With\n                    # the KV-offload pipeline that changes WHICH blocks are\n                    # offloaded+recompressed and makes the decode nondeterministic\n                    # (a boundary request's tokens diverge run-to-run).  Round the\n                    # boundary DOWN to a stable granularity so the jitter is\n                    # absorbed; the few reclaimed blocks just become offloadable.\n                    _g = int(os.getenv(\n                        \"TIERED_SERVE_KV_DEDICATED_GRANULARITY\", \"16\"))\n                    if _g > 1:\n                        num_dedicated_hbm = max(\n                            MIN_DED, (num_dedicated_hbm // _g) * _g)\n                    # Cap offloadable at o_max (physical hugepage/LPDDR\n                    # capacity).  The granularity round-down above lowers\n                    # num_dedicated_hbm, which would otherwise push\n                    # (num_blocks_total - num_dedicated_hbm) ABOVE o_max -- and\n                    # since num_dedicated was already pinned by the\n                    # (num_blocks_total - o_max) term, offloadable was sitting\n                    # exactly at o_max before rounding.  Without the cap each\n                    # per-layer secondary_kv requests > o_max_frag blocks and\n                    # overflows its hugepage block -> MemoryError.  The few\n                    # blocks reclaimed by the round-down just stay UNALLOCATED\n                    # (handled by the usable-shrink below), they cannot become\n                    # offloadable when offloadable is already at its physical\n                    # maximum.\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n                    logger.info(\n                        \"Tiered-serve dedicated KV: auto logical D=%d \"\n                        \"+ tail=%d -> %d physical HBM rows\",\n                        num_dedicated_hbm - tail_slots, tail_slots,\n                        num_dedicated_hbm)\n\n            logger.info(\n                \"Tiered-serve hugepage alloc: total=%d, dedicated=%d \"\n                \"(HBM), offloadable=%d (buffer+LPDDR5), \"\n                \"per_block_raw=%d, per_block_lpddr=%d bytes, \"\n                \"gpu_avail=%.2f GiB, lpddr5=%.2f GiB, \"\n                \"o_max_lpddr=%d, o_max_frag=%d\",\n                num_blocks_total, num_dedicated_hbm, num_offloadable_lpddr,\n                per_block_bytes_raw, per_block_bytes_lpddr,\n                gpu_avail / 1024**3,\n                lpddr5_bytes / 1024**3,\n                o_max_lpddr if per_block_bytes_raw > 0 else 0,\n                o_max_frag if per_block_bytes_raw > 0 else 0)\n\n            if tail_slots:\n                min_general_dedicated = 16\n                if num_dedicated_hbm < tail_slots + min_general_dedicated:\n                    raise RuntimeError(\n                        \"Tiered-serve full-block KV compression needs one \"\n                        \"resident-tail HBM row per max_num_reqs plus at least \"\n                        f\"{min_general_dedicated} normal dedicated rows, but \"\n                        f\"the HBM planner produced {num_dedicated_hbm} rows \"\n                        f\"for max_num_reqs={tail_slots}. Lower --max-num-seqs \"\n                        \"or increase the KV HBM budget.\"\n                    )\n\n            # Store the split for gpu_worker. The raw tensors below retain all\n            # physical HBM rows; only the canonical scheduler