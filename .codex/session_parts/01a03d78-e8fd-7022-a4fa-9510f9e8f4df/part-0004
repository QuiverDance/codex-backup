{"timestamp":"2026-08-26T09:54:03.326Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d7d-b3be-7493-8366-b3fd2361575a","call_id":"call_Bzu5fBldqIQLBvgtQOdCYHv7","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"613:def _save_client_log(\n635:    successful = [o for o in windowed_outputs if o.success]\n716:    csv_path = os.path.join(log_dir, \"summary.csv\")\n717:    TTFT_SLO_MS = 2000.0\n739:        sum(1 for t in ttfts_ms if t <= TTFT_SLO_MS) / n_total * 100\n753:        return o.ttft * 1000 <= TTFT_SLO_MS and o.tpot * 1000 <= tpot_slo_ms\n998:    # SLO attainment(누적) 설정: summary.csv 의 request_{200,250}_att 와 동일 정의.\n    skip_first_n: int = 0,\n    skip_last_n: int = 0,\n) -> None:\n    \"\"\"Save client benchmark results to the server's log directory.\"\"\"\n    log_path = os.path.join(log_dir, \"client.log\")\n\n    # Warmup/cooldown trim: aggregate only the send-order window\n    # [win_lo, win_hi); the per-request table below still lists every request.\n    n_out = len(outputs)\n    win_lo = max(0, skip_first_n)\n    win_hi = n_out - max(0, skip_last_n)\n    if win_hi <= win_lo:\n        win_lo, win_hi = 0, n_out\n    windowed_outputs = outputs[win_lo:win_hi]\n\n    successful = [o for o in windowed_outputs if o.success]\n    ttfts_ms = [o.ttft * 1000 for o in successful if o.ttft > 0]\n    tpots_ms = [o.tpot * 1000 for o in successful if o.tpot > 0]\n    itls_ms = [t * 1000 for o in successful for t in o.itl if t > 0]\n    e2els_ms = [o.latency * 1000 for o in successful]\n\n    def fmt_percentiles(data: list[float], name: str) -> str:\n        if not data:\n            return f\"  {name}: no data\\n\"\n        arr = np.array(data)\n        return (\n            f\"  {name:<6} \"\n            f\"avg={np.mean(arr):>9.2f}   \"\n            f\"p50={np.percentile(arr, 50):>9.2f}   \"\n            f\"p90={np.percentile(arr, 90):>9.2f}   \"\n            f\"p95={np.percentile(arr, 95):>9.2f}   \"\n            f\"p99={np.percentile(arr, 99):>9.2f}\\n\"\n        )\n\n    with open(log_path, \"a\") as f:\n        f.write(f\"\\n{'=' * 70}\\n\")\n        f.write(f\"  Client Benchmark: model={model_id}, rate={request_rate} qps\\n\")\n        f.write(f\"  Timestamp: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\")\n        f.write(f\"{'=' * 70}\\n\")\n        f.write(f\"{'Successful requests:':<40} {metrics.completed}\\n\")\n        f.write(f\"{'Failed requests:':<40} {metrics.failed}\\n\")\n        f.write(f\"{'Benchmark duration (s):':<40} {benchmark_duration:.2f}\\n\")\n        f.write(\n            f\"{'Request throughput (req/s):':<40} \"\n            f\"{metrics.request_throughput:.2f}\\n\"\n        )\n        if isinstance(metrics, BenchmarkMetrics):\n            f.write(\n                f\"{'Output token throughput (tok/s):':<40} \"\n                f\"{metrics.output_throughput:.2f}\\n\"\n            )\n            f.write(\n                f\"{'Total token throughput (tok/s):':<40} \"\n                f\"{metrics.total_token_throughput:.2f}\\n\"\n            )\n\n        f.write(f\"\\n--- Percentile Summary (ms) ---\\n\")\n        f.write(fmt_percentiles(ttfts_ms, \"TTFT\"))\n        f.write(fmt_percentiles(tpots_ms, \"TPOT\"))\n        f.write(fmt_percentiles(itls_ms, \"ITL\"))\n        f.write(fmt_percentiles(e2els_ms, \"E2EL\"))\n\n        f.write(f\"\\n--- Per-Request Metrics ---\\n\")\n        if (win_lo, win_hi) != (0, n_out):\n            f.write(\n                f\"(aggregation window: idx [{win_lo}, {win_hi}) of {n_out}; \"\n                f\"first {skip_first_n} and last {skip_last_n} excluded \"\n                f\"from the summary/CSV above)\\n\"\n            )\n        header = (\n            f\"{'idx':<6} {'success':<9} {'prompt_len':<12} \"\n            f\"{'output_tokens':<15} {'ttft_ms':<12} {'tpot_ms':<12} \"\n            f\"{'itl_p50_ms':<12} {'itl_p90_ms':<12} \"\n            f\"{'itl_p95_ms':<12} {'itl_p99_ms':<12} \"\n            f\"{'latency_ms':<12}\\n\"\n        )\n        f.write(header)\n        for i, o in enumerate(outputs):\n            if o.itl:\n                itl_arr = np.array(o.itl) * 1000\n                itl_p50 = float(np.percentile(itl_arr, 50))\n                itl_p90 = float(np.percentile(itl_arr, 90))\n                itl_p95 = float(np.percentile(itl_arr, 95))\n                itl_p99 = float(np.percentile(itl_arr, 99))\n            else:\n                itl_p50 = itl_p90 = itl_p95 = itl_p99 = 0.0\n            f.write(\n                f\"{i:<6} {str(o.success):<9} {o.prompt_len:<12} \"\n                f\"{o.output_tokens:<15} {o.ttft * 1000:<12.2f} \"\n                f\"{o.tpot * 1000:<12.2f} {itl_p50:<12.2f} \"\n                f\"{itl_p90:<12.2f} {itl_p95:<12.2f} \"\n                f\"{itl_p99:<12.2f} {o.latency * 1000:<12.2f}\\n\"\n            )\n        f.write(f\"{'=' * 70}\\n\\n\")\n\n    # --- Append one row to the cumulative CSV summary ---\n    csv_path = os.path.join(log_dir, \"summary.csv\")\n    TTFT_SLO_MS = 2000.0\n    TPOT_SLO_200_MS = 200.0\n    TPOT_SLO_250_MS = 250.0\n\n    def _pcts(data: list[float]) -> tuple[float, float, float, float]:\n        if not data:\n            return (0.0, 0.0, 0.0, 0.0)\n        arr = np.array(data)\n        return (\n            float(np.percentile(arr, 50)),\n            float(np.percentile(arr, 90)),\n            float(np.percentile(arr, 95)),\n            float(np.percentile(arr, 99)),\n        )\n\n    ttft_p50, ttft_p90, ttft_p95, ttft_p99 = _pcts(ttfts_ms)\n    tpot_p50, tpot_p90, tpot_p95, tpot_p99 = _pcts(tpots_ms)\n    itl_p50, itl_p90, itl_p95, itl_p99 = _pcts(itls_ms)\n    e2el_p50, e2el_p90, e2el_p95, e2el_p99 = _pcts(e2els_ms)\n\n    n_total = len(successful)\n    prefill_att = (\n        sum(1 for t in ttfts_ms if t <= TTFT_SLO_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_200_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_200_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_250_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_250_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    # Request-level attainment: a request is counted only if it meets BOTH the\n    # prefill (TTFT) and decode (TPOT) SLOs.\n    def _meets_slo(o: RequestFuncOutput, tpot_slo_ms: float) -> bool:\n        return o.ttft * 1000 <= TTFT_SLO_MS and o.tpot * 1000 <= tpot_slo_ms\n\n    request_200_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_200_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    request_250_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_250_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    # Server-side batch statistics over this benchmark window: parse the\n    # scheduler's per-step \"Schedule Info\" lines from server.log and split them\n    # into prefill-containing vs decode-only batches.\n    window_end = datetime.now()\n    window_start = window_end - timedelta(seconds=benchmark_duration)\n    batch_stats = _server_batch_stats(log_dir, window_start, window_end)\n    if batch_stats is not None:\n        bs = batch_stats\n        batch_cols = (\n            f\"{bs['n_batches']} \"\n            f\"{bs['prefill_pct']:.2f} {bs['decode_pct']:.2f} \"\n            f\"{bs['sz_avg']:.2f} {bs['sz_p50']:.2f} \"\n            f\"{bs['sz_p90']:.2f} {bs['sz_max']:.0f}\"\n        )\n    else:\n        batch_cols = \"NA NA NA NA NA NA NA\"\n\n    csv_header = (\n        \"request_rate \"\n        \"ttft_p50 ttft_p90 ttft_p95 ttft_p99 \"\n        \"tpot_p50 tpot_p90 tpot_p95 tpot_p99 \"\n        \"itl_p50 itl_p90 itl_p95 itl_p99 \"\n        \"e2el_p50 e2el_p90 e2el_p95 e2el_p99 \"\n        \"prefill_att(%) decode_200_att(%) decode_250_att(%) \"\n        \"request_200_att(%) request_250_att(%) \"\n        \"n_batches prefill_batch(%) decode_batch(%) \"\n        \"batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\"\n    )\n    )\n    write_header = not os.path.exists(csv_path)\n    with open(csv_path, \"a\") as cf:\n        if write_header:\n            cf.write(csv_header + \"\\n\")\n        cf.write(\n            f\"{request_rate} \"\n            f\"{ttft_p50:.2f} {ttft_p90:.2f} {ttft_p95:.2f} {ttft_p99:.2f} \"\n            f\"{tpot_p50:.2f} {tpot_p90:.2f} {tpot_p95:.2f} {tpot_p99:.2f} \"\n            f\"{itl_p50:.2f} {itl_p90:.2f} {itl_p95:.2f} {itl_p99:.2f} \"\n            f\"{e2el_p50:.2f} {e2el_p90:.2f} {e2el_p95:.2f} {e2el_p99:.2f} \"\n            f\"{prefill_att:.2f} {decode_200_att:.2f} {decode_250_att:.2f} \"\n            f\"{request_200_att:.2f} {request_250_att:.2f} \"\n            f\"{batch_cols}\\n\"\n        )\n    print(f\"Summary CSV row appended to {csv_path}\")\n\n    print(f\"Client benchmark results saved to {log_path}\")\n\n\nasync def benchmark(\n    task_type: TaskType,\n    endpoint_type: str,\n    api_url: str,\n    base_url: str,\n    model_id: str,\n    model_name: str,\n    tokenizer: TokenizerLike,\n    input_requests: list[SampleRequest],\n    logprobs: int | None,\n    request_rate: float,\n    burstiness: float,\n    disable_tqdm: bool,\n    num_warmups: int,\n    profile: bool,\n    selected_percentile_metrics: list[str],\n    selected_percentiles: list[float],\n    ignore_eos: bool,\n    goodput_config_dict: dict[str, float],\n    max_concurrency: int | None,\n    lora_modules: Iterable[str] | None,\n    extra_headers: dict | None,\n    extra_body: dict | None,\n    ramp_up_strategy: Literal[\"linear\", \"exponential\"] | None = None,\n    ramp_up_start_rps: int | None = None,\n    ramp_up_end_rps: int | None = None,\n    ready_check_timeout_sec: int = 600,\n    skip_first_n_requests: int = 0,\n    skip_last_n_requests: int = 0,\n):\n    try:\n        request_func = ASYNC_REQUEST_FUNCS[endpoint_type]\n    except KeyError:\n        raise ValueError(f\"Unknown backend: {endpoint_type}\") from None\n\n    # Reuses connections across requests to reduce TLS handshake overhead.\n    connector = aiohttp.TCPConnector(\n        limit=max_concurrency or 0,\n        limit_per_host=max_concurrency or 0,\n        ttl_dns_cache=300,\n        use_dns_cache=True,\n        keepalive_timeout=60,\n        enable_cleanup_closed=True,\n        force_close=False,\n        ssl=(\"https://\" in api_url),\n    )\n\n    session = aiohttp.ClientSession(\n        connector=connector,\n        trust_env=True,\n        timeout=aiohttp.ClientTimeout(total=6 * 60 * 60),\n    )\n\n    print(\"Starting initial single prompt test run...\")\n    test_prompt, test_prompt_len, test_output_len, test_mm_content = (\n        input_requests[0].prompt,\n        input_requests[0].prompt_len,\n        input_requests[0].expected_output_len,\n        input_requests[0].multi_modal_data,\n    )\n\n    assert (\n        test_mm_content is None\n        or isinstance(test_mm_content, dict)\n        or (\n            isinstance(test_mm_content, list)\n            and all(isinstance(item, dict) for item in test_mm_content)\n        )\n    ), \"multi_modal_data must be a dict or list[dict]\"\n    test_input = RequestFuncInput(\n        model=model_id,\n        model_name=model_name,\n        prompt=test_prompt,\n        api_url=api_url,\n        prompt_len=test_prompt_len,\n        output_len=test_output_len,\n        logprobs=logprobs,\n        multi_modal_content=test_mm_content,\n        ignore_eos=ignore_eos,\n        extra_headers=extra_headers,\n        extra_body=extra_body,\n    )\n\n    if ready_check_timeout_sec > 0:\n        test_output = await wait_for_endpoint(\n            request_func,\n            test_input,\n            session,\n            timeout_seconds=ready_check_timeout_sec,\n        )\n        if not test_output.success:\n            raise ValueError(\n                \"Initial test run failed - Please make sure benchmark \"\n                \"arguments are correctly specified. \"\n                f\"Error: {test_output.error}\"\n            )\n        else:\n            print(\"Initial test run completed.\")\n    else:\n        print(\"Skipping endpoint ready check.\")\n\n    if num_warmups > 0:\n        print(f\"Warming up with {num_warmups} requests...\")\n        warmup_pbar = None if disable_tqdm else tqdm(total=num_warmups)\n        warmup_semaphore = (\n            asyncio.Semaphore(max_concurrency)\n            if max_concurrency\n            else contextlib.nullcontext()\n        )\n        warmup_tasks = []\n\n        async def warmup_limited_request_func():\n            async with warmup_semaphore:\n                return await request_func(\n                    request_func_input=test_input, session=session, pbar=warmup_pbar\n                )\n\n        for _ in range(num_warmups):\n            request_task = asyncio.create_task(warmup_limited_request_func())\n            warmup_tasks.append(request_task)\n        _ = await asyncio.gather(*warmup_tasks)\n\n        if warmup_pbar is not None:\n            warmup_pbar.close()\n        print(\"Warmup run completed.\")\n\n    print(\"Starting main benchmark run...\")\n\n    if lora_modules:\n        # For each input request, choose a LoRA module at random.\n        lora_modules = iter(\n            [random.choice(lora_modules) for _ in range(len(input_requests))]\n        )\n\n    if profile:\n        print(\"Starting profiler...\")\n        profile_input = RequestFuncInput(\n            model=model_id,\n            model_name=model_name,\n            prompt=test_prompt,\n            api_url=base_url + \"/start_profile\",\n            prompt_len=test_prompt_len,\n            output_len=test_output_len,\n            logprobs=logprobs,\n            multi_modal_content=test_mm_content,\n            ignore_eos=ignore_eos,\n            extra_headers=extra_headers,\n            extra_body=extra_body,\n        )\n        profile_output = await request_func(\n            request_func_input=profile_input, session=session\n"}],"internal_c