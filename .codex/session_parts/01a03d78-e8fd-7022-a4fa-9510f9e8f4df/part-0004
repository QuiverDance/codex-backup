ng above used the original (profiled) num_blocks.\n        if kv_offload:\n            _usable = (\n                num_dedicated_hbm - tail_slots + num_offloadable_lpddr\n            )\n            if 0 < _usable < kv_cache_config.num_blocks:\n                logger.info(\n                    \"Tiered-serve: dedicated request shrank usable blocks \"\n                    \"%d -> %d (D=%d + tail=%d + O=%d physical; \"\n                    \"tail rows are not scheduler blocks); %d blocks left \"\n                    \"unallocated\",\n                    kv_cache_config.num_blocks, _usable,\n                    num_dedicated_hbm - tail_slots, tail_slots,\n                    num_offloadable_lpddr,\n\n        if self.vllm_config.model_config.enable_sleep_mode:\n            from vllm.device_allocator.cumem import CuMemAllocator\n\n            allocator = CuMemAllocator.get_instance()\n            with allocator.use_memory_pool(tag=\"kv_cache\"):\n                self.model_runner.initialize_kv_cache(kv_cache_config)\n        else:\n            self.model_runner.initialize_kv_cache(kv_cache_config)\n\n        # Tiered-serve: let external cache loader configure buffer KV caches\n        self._maybe_init_tiered_serve()\n\n    def get_kv_cache_num_blocks(self) -> int:\n        \"\"\"Return the worker's post-allocation physical KV block capacity.\n\n        Tiered-serve can shrink the worker-local KVCacheConfig while laying\n        out dedicated HBM and offloadable LPDDR pools.  EngineCore queries\n        this after initialization so its scheduler cannot allocate block ids\n        that have no physical backing.\n        \"\"\"\n        return int(self.model_runner.kv_cache_config.num_blocks)\n\n    def _maybe_init_tiered_serve(self) -> None:\n        \"\"\"If tiered-serve is active, let the external cache loader\n        configure buffer KV caches on attention layers.\"\"\"\n        if not os.getenv(\"TIERED_SERVE_OFFLOAD_TYPE\"):\n            return\n        cache_loader 