When a memory ballast is present (simulated HBM\n                    # limit), (total - gpu_free) includes the ballast,\n                    # making act_est negative.  In that case fall back\n                    # to the profiled budget which is already safe.\n                    _act_est = (_gpu_free - _profiled\n                                - _gpu_total * (1 - _util))\n                    if _act_est > 0:\n                        # Normal system: reclaim util headroom\n                        _act_peak = _act_est\n                        hbm_avail = max(0, _gpu_free - _act_peak)\n                    else:\n                        # Model nearly fills HBM (or memory ballast\n                        # present) so the profiled budget is\n                        # non-positive.  Use actual free GPU memory;\n                        # gpu_reserve (subtracted later) covers peak\n                        # activations, CUDA graphs, and cuBLAS\n                        # workspace.\n                        _act_peak = 0\n                        hbm_avail = _gpu_free\n\n                    logger.info(\n                        \"Tiered-serve KV: %.2f GiB HBM available \"\n                        \"(free=%.2f, act=%.2f, reserve=%.2f) + \"\n                        \"%.2f GiB LPDDR5 (%d layers)\",\n                        hbm_avail / 1024**3,\n                        _gpu_free / 1024**3, _act_peak / 1024**3,\n                        gpu_reserve / 1024**3,\n                        lpddr5_bytes / 1024**3,\n                        n_layers,\n                    )\n                    # Hugepage: precise budget from three\n                    # constraints –\n                    #   1. LPDDR5: O × n_layers × pb_total ≤ LPDDR5\n                    #   2. Hugepage packing: O × pb_total fits\n                    #      ceil(n_layers/n_kv_pages) per page\n                    #   3. HBM: D×n_layers×pb + O×pb ≤ HBM_avail\n                    # When KV compression is enabled, BOTH raw secondary\n                    # AND persistent compressed pools are stored on\n                    # LPDDR (raw is needed for prefill latency, compressed\n                    # for memory savings on decode).  pb_total = pb_raw +\n                    # pb_compressed.  Otherwise pb_total == pb.\n                    # N = D + O (total blocks)\n                    first_spec = next(\n                        iter(kv_cache_specs[0].values()))\n                    pb = first_spec.page_size_bytes\n\n                    # Compute LPDDR per-block size accounting for\n                    # compressed pool.  When KV compression is on, LPDDR\n                    # holds BOTH the raw secondary (needed for prefill\n                    # latency) AND the persistent compressed pool (decode),\n                    # so pb_lpddr = pb_raw + 2*per_side (K+V).  Each backend\n                    # exposes a static ``compute_per_block_compressed_bytes``\n                    # returning the worst-case per-side host-pool bytes.\n                    pb_lpddr = pb\n                    use_kv_comp_env = (\n                        os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\")\n                    if use_kv_comp_env:\n                        kv_backend = os.getenv(\n                            \"TIERED_SERVE_KV_COMP_BACKEND\",\n                            \"zipserv\").lower()\n                        # Resolve the backend's per-side compressed-pool\n                        # estimator.  Backends not listed here (dietgpu /\n                        # mantexp) have a dynamically-varying footprint that\n                        # is not yet modelled — they fall through to the\n                        # conservative raw-pb-only path below.\n                        _per_side_fn = None\n                        try:\n                            if kv_backend == \"zipserv\":\n                                from tiered_serve.tensor_compressor import (\n                                    ZipServCompressor,\n                                )\n                                _per_side_fn = (\n                                    ZipServCompressor\n                                    .compute_per_block_compressed_bytes)\n                            elif kv_backend in (\"p4flat\", \"p4flatcpu\",\n                                                \"ublb_flat\", \"ublb_tbe\"):\n                                # p4flatcpu (C++ CPU encode) and the UB/LB-split\n                                # codecs (ublb_flat/ublb_tbe, P4Flat-based) all\n                                # share p4flat's on-host blob pool layout\n                                # ([host_n, align(raw,128)] + meta), so the\n                                # per-block compressed-pool size is identical\n                                # (inherited static method).  All MUST be\n                                # modelled or the unbudgeted compressed pool\n                                # over-offloads and OOM-kills the host at warmup.\n                                from tiered_serve.p4flat_kv_compressor import (\n                                    P4FlatKVCompressor,\n                                )\n                                _per_side_fn = (\n                                    P4FlatKVCompressor\n                                    .compute_per_block_compressed_bytes)\n                        except Exception as _e:\n                            logger.warning(\n                                \"Tiered-serve: failed to import %s \"\n                                \"compressor for KV budget (%s); using raw \"\n                                \"pb only\", kv_backend, _e)\n                        # block_elements = block_size *\n                        #   num_kv_heads * head_size  (one side, K or V)\n                        _bs = first_spec.block_size\n                        _nkv = getattr(first_spec, \"num_kv_heads\", 0)\n                        _hd = getattr(first_spec, \"head_size\", 0)\n                        _block_elements = _bs * _nkv * _hd\n                        if _per_side_fn is not None and _block_elements > 0:\n                            try:\n                                _per_side = _per_side_fn(_block_elements)\n                                # K + V compressed pool bytes per block\n                                pb_compressed = 2 * _per_side\n                                pb_lpddr = pb + pb_compressed\n                                logger.info(\n                                    \"Tiered-serve KV comp budget: \"\n                                    \"backend=%s pb_raw=%d, pb_comp=%d \"\n                                    \"(%.2fx), pb_lpddr_total=%d\",\n                                    kv_backend, pb, pb_compressed,\n                                    pb_compressed / pb if pb else 0,\n                                    pb_lpddr)\n                            except Exception as _e:\n                                logger.warning(\n                                    \"Tiered-serve: failed to size \"\n                                    \"compressed pool for %s (%s); using \"\n                                    \"raw pb only\", kv_backend, _e)\n                        else:\n                            logger.info(\n                                \"Tiered-serve KV comp budget: backend=%s \"\n                                \"compressed pool not modeled; using \"\n                                \"raw pb only\",\n                                kv_backend)\n\n                    o_lpddr = (lpddr5_bytes // (n_layers * pb_lpddr)\n                               if n_layers > 0 and pb_lpddr > 0 else 0)\n                    lpp = -(-n_layers // n_kv_pages)  # ceil div\n                    o_frag = (hp_size // (lpp * pb_lpddr)\n                              if lpp > 0 and pb_lpddr > 0 else 0)\n                    o_max = min(o_lpddr, o_frag)\n\n                    MIN_DED = 16  # dedicated HBM blocks (never offloaded)\n                    budgets = []\n                    for mem in available_gpu_memory:\n                        hbm = max(0, hbm_avail - gpu_reserve)\n                        hbm_blks = hbm // pb if pb > 0 else 0\n                        if n_layers > 1:\n                            d = max(0,\n                                    (hbm_blks - o_max) // n_layers)\n                        else:\n                            d = hbm_blks\n                        # Dedicated blocks must be >= MIN_DED;\n                        # reduce offloadable count if necessary so\n                        # HBM constraint holds:\n                        #   D*n_layers*pb + O*pb <= hbm\n                        d = max(d, MIN_DED)\n                        o_hbm = max(0, hbm_blks - d * n_layers)\n                        o = min(o_max, o_hbm)\n                        n = d + o\n                        budgets.append(n * n_layers * pb)\n                    available_gpu_memory = budgets\n                    logger.info(\n                        \"Tiered-serve budget: o=%d (max=%d, \"\n                        \"lpddr=%d, frag=%d, hbm=%d), d=%d, N=%d, \"\n                        \"budget=%.2f GiB, pb=%d\",\n                        o, o_max, o_lpddr, o_frag, o_hbm,\n                        d, n,\n                        budgets[0] / 1024**3 if budgets else 0,\n                        pb)\n            else:\n                # reduce-kv: SharedBlockAllocator reuses a small set of\n                # physical blocks round-robin.  The profiled budget can\n                # be negative when model weights nearly fill HBM.  Use\n                # actual free GPU memory so vLLM allocates whatever\n                # physical blocks fit; the scheduler never blocks anyway.\n                import torch as _torch\n                _gpu_free, _ = _torch.cuda.mem_get_info()\n                gpu_reserve = int(os.getenv(\n                    \"TIERED_SERVE_GPU_RESERVE_GIB\", \"5\")) * (1 << 30)\n                _profiled = (available_gpu_memory[0]\n                             if available_gpu_memory else 0)\n                hbm_budget = max(0, _gpu_free - gpu_reserve)\n                available_gpu_memory = [hbm_budget] * len(\n                    available_gpu_memory)\n                logger.info(\n                    \"Tiered-serve reduce-kv: using actual free GPU \"\n                    \"memory %.2f GiB (free=%.2f, reserve=%.2f) \"\n                    \"as KV budget (profiled=%.2f)\",\n                    hbm_budget / 1024**3,\n                    _gpu_free / 1024**3,\n                    gpu_reserve / 1024**3,\n                    _profiled / 1024**3)\n\n        kv_cache_configs = get_kv_cache_configs(\n            vllm_config, kv_cache_specs, available_gpu_memory\n        )\n\n        # Initialize kv cache and warmup the execution\n        self.model_executor.initialize_from_config(kv_cache_configs)\n\n        # tiered-serve may shrink KVCacheConfig.num_blocks while allocating\n        # the physical dedicated/offloadable split (for example when the\n        # requested dedicated boundary leaves a small fragment that cannot be\n        # backed by LPDDR hugepages).  Build the scheduler configuration only\n        # after that adjustment.  Otherwise BlockPool retains the profiled\n        # count and can hand out block ids beyond the compressor's persistent\n        # tables and the physical KV tensors.\n        scheduler_kv_cache_config = generate_scheduler_kv_cache_config(\n            kv_cache_configs)\n        profiled_num_gpu_blocks = scheduler_kv_cache_config.num_blocks\n        if offload_type and \"kv\" in offload_type.lower():\n            worker_block_counts = self.model_executor.collective_rpc(\n                \"get_kv_cache_num_blocks\")\n            if not worker_block_counts:\n                raise RuntimeError(\n                    \"workers did not report physical KV capacity\")\n            physical_num_gpu_blocks = min(\n                int(value) for value in worker_block_counts)\n            if physical_num_gpu_blocks <= 0:\n                raise RuntimeError(\n                    \"workers reported a non-positive physical KV capacity: \"\n                    f\"{worker_block_counts}\")\n            if physical_num_gpu_blocks > profiled_num_gpu_blocks:\n                raise RuntimeError(\n                    \"worker physical KV capacity exceeds the scheduler \"\n                    f\"profile: workers={worker_block_counts}, \"\n                    f\"profiled={profiled_num_gpu_blocks}\")\n            if physical_num_gpu_blocks < profiled_num_gpu_blocks:\n                for tensor in scheduler_kv_cache_config.kv_cache_tensors:\n                    if tensor.size % profiled_num_gpu_blocks != 0:\n                        raise RuntimeError(\n                            \"cannot shrink scheduler KV tensor \"\n                            f\"proportionally: size={tensor.size}, \"\n                            f\"blocks={profiled_num_gpu_blocks}\")\n                    per_block_size = tensor.size // profiled_num_gpu_blocks\n                    tensor.size = per_block_size * physical_num_gpu_blocks\n                scheduler_kv_cache_config.num_blocks = physical_num_gpu_blocks\n                logger.info(\n                    \"Tiered-serve: propagated physical KV block shrink to \"\n                    \"scheduler: %d -> %d (workers=%s)\",\n                    profiled_num_gpu_blocks, physical_num_gpu_blocks,\n                    worker_block_counts)\n        num_gpu_blocks = scheduler_kv_cache_config.num_blocks\n        num_cpu_blocks = 0\n\n        elapsed = time.time() - start\n        logger.info_once(\n            \"init engine (profile, create kv cache, warmup model) took %.2f seconds\",\n            elapsed,\n            scope=\"local\",\n        )\n        return num_gpu_blocks, num_cpu_blocks, scheduler_kv_cache_config\n\n    def _register_tiered_serve_block_callbacks(self) -> None:\n        \"\"\"Register BlockPool callbacks so that vLLMKVCache.free_block_ids\n        and used_block_ids stay in sync with the V1 scheduler's block\n        allocator.  Also wires in the unload_targets / free_slot helpers\n        from tiered_serve.vllm_block_decorator.\"\"\"\n        block_pool = getattr(\n            getattr(\n                getattr(self.scheduler, \"kv_cache_manager\", None),\n                \"coordinator\", None),\n            \"block_pool\", None)\n        if block_pool is None:\n            logger.warning(\n                \"tiered-serve: could not find BlockPool on scheduler; \"\n                \"free_block_ids will not be updated.\")\n                # When KV compression is enabled, LPDDR holds BOTH raw\n                # secondary AND persistent compressed pools.  Size LPDDR\n                # constraints against pb_lpddr = pb_raw + pb_compressed\n                # (HBM constraint still uses pb_raw — GPU stores raw only).\n                per_block_bytes_lpddr = per_block_bytes_raw\n                use_kv_comp_env = (\n                    os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\")\n                if use_kv_comp_env:\n                    kv_backend = os.getenv(\n                        \"TIERED_SERVE_KV_COMP_BACKEND\",\n                        \"zipserv\").lower()\n                    # Resolve the backend's per-side compressed-pool estimator\n                    # so the LPDDR budget accounts for BOTH raw secondary and\n                    # the persistent compressed pool.  Backends not listed\n                    # (dietgpu / mantexp) have a dynamic footprint and fall\n                    # through to the conservative raw-pb-only path.  p4flatcpu\n                    # and ublb_flat/ublb_tbe share p4flat's blob-pool storage\n                    # layout (same inherited static) — all MUST be modelled or\n                    # the unbudgeted compressed pool over-offloads -> host OOM.\n                    try:\n                        _per_side_fn = None\n                        if kv_backend == \"zipserv\":\n                            from tiered_serve.tensor_compressor import (\n                                ZipServCompressor,\n                            )\n                            _per_side_fn = (\n                                ZipServCompressor\n                                .compute_per_block_compressed_bytes)\n                        elif kv_backend in (\"p4flat\", \"p4flatcpu\",\n                                            \"ublb_flat\", \"ublb_tbe\"):\n                            from tiered_serve.p4flat_kv_compressor import (\n                                P4FlatKVCompressor,\n                            )\n                            _per_side_fn = (\n                                P4FlatKVCompressor\n                                .compute_per_block_compressed_bytes)\n                        _spec = None\n                        if kv_cache_config.kv_cache_groups:\n                            _spec = (kv_cache_config.kv_cache_groups[0]\n                                     .kv_cache_spec)\n                        if _per_side_fn is not None and _spec is not None:\n                            _bs = _spec.block_size\n                            _nkv = getattr(_spec, \"num_kv_heads\", 0)\n                            _hd = getattr(_spec, \"head_size\", 0)\n                            _block_elements = _bs * _nkv * _hd\n                            if _block_elements > 0:\n                                _per_side = _per_side_fn(_block_elements)\n                                per_block_bytes_lpddr = (\n                                    per_block_bytes_raw + 2 * _per_side)\n                        elif _per_side_fn is None:\n                            logger.info(\n                                \"Tiered-serve hugepage alloc: backend=%s \"\n                                \"compressed pool not modeled; using raw \"\n                                \"pb only\", kv_backend)\n                    except Exception as _e:\n                        logger.warning(\n                            \"Tiered-serve hugepage alloc: failed to \"\n                            \"size compressed pool (%s); using raw \"\n                            \"pb only\", _e)\n\n                # Max offloadable blocks from LPDDR5:\n                # O × n_kv_layers × pb_lpddr ≤ lpddr5\n                o_max_lpddr = lpddr5_bytes // (\n                    n_kv_layers * per_block_bytes_lpddr)\n                # Max offloadable blocks from hugepage packing:\n                # each page must fit ceil(n_kv_layers/n_kv_pages)\n                # layer-secondaries (raw + compressed)\n                n_kv_hp = hp_allocator.n_kv_pages\n                lpp = _math.ceil(n_kv_layers / n_kv_hp) if n_kv_hp else 1\n                o_max_frag = (hp_allocator.hp_size\n                              // (lp…325 tokens truncated…nts run with a different D.\n                _env_blocks = os.getenv(\n                    \"TIERED_SERVE_DEDICATED_KV_BLOCKS\")\n                _env_size_gb = os.getenv(\n                    \"TIERED_SERVE_DEDICATED_KV_SIZE_GB\")\n                if (_env_blocks is not None and _env_blocks.strip()\n                        and _env_size_gb is not None\n                        and _env_size_gb.strip()):\n                    raise RuntimeError(\n                        \"Set only one of TIERED_SERVE_DEDICATED_KV_BLOCKS \"\n                        \"and TIERED_SERVE_DEDICATED_KV_SIZE_GB\")\n\n                _requested_logical_d = None\n                if _env_blocks is not None and _env_blocks.strip():\n                    _requested_logical_d = int(_env_blocks)\n                elif _env_size_gb is not None and _env_size_gb.strip():\n                    _gb = float(_env_size_gb)\n                    if _gb <= 0:\n                        raise RuntimeError(\n                            \"TIERED_SERVE_DEDICATED_KV_SIZE_GB must be > 0, \"\n                            f\"got