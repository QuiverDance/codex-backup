{"timestamp":"2026-08-26T10:20:50.270Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d96-38de-7263-b69e-1886771bac56","call_id":"call_rVWcjf4MliwH4um1P9mBRJXA","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"#!/bin/bash\n# Usage: bash scripts/serving/client/azure_conv.sh MODEL_ALIAS [TS_CONFIG] [REQUEST_RATE...]\n#   MODEL_ALIAS  : llama70b, llama70b-fp8, qwen72b\n#   TS_CONFIG    : (선택) 실행 중인 ts-config 이름 또는 경로. 결과 저장 디렉토리 키로 사용.\n#                  생략 시 \"manual\". 오케스트레이터가 $cfg를 그대로 넘김.\n#   REQUEST_RATE : (선택) 측정할 request rate. 1개 이상 지정 시 모델별 스윕 대신 그 값들만 측정.\n#                  예: ... llama70b manual 0.8 1.0 1.2\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/../model_map.sh\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS [TS_CONFIG] (e.g. llama70b, llama70b-fp8, qwen72b)}\"\nresolve_model \"$MODEL_ALIAS\"\n\n# ── 결과 저장 키 유도 (서버 로그 명명 규칙과 일치) ────────────────────\n# 서버: ts_config_name = Path(ts_configs[0]).stem,\n#       model_id = model.split('/')[-1].lower().replace('-','_').replace('.','_')\nTS_CONFIG=\"${2:-manual}\"\nTS_NAME=\"$(basename \"$TS_CONFIG\")\"; TS_NAME=\"${TS_NAME%.yaml}\"; TS_NAME=\"${TS_NAME%.yml}\"\nMODEL_ID=\"$(echo \"${MODEL##*/}\" | tr '[:upper:]' '[:lower:]' | tr '.-' '__')\"\nRESULT_DIR=\"${RESULT_DIR:-logs/serving/$MODEL_ID/$TS_NAME/client}\"\nmkdir -p \"$RESULT_DIR\"\necho \"Saving results to: $RESULT_DIR\"\n\n# ── request rate 결정 ────────────────────────────────────────────────\n# 3번째 이후 인자로 rate를 1개 이상 주면 스윕 대신 그 값들만 측정.\nREQUEST_RATE_ARGS=(\"${@:3}\")\nif [ \"${#REQUEST_RATE_ARGS[@]}\" -gt 0 ]; then\n  REQUEST_RATES=\"${REQUEST_RATE_ARGS[*]}\"\nelse\n  case \"$MODEL_ALIAS\" in\n    qwen72b)\n      REQUEST_RATES=$(seq 0.5 0.1 1.2)\n      ;;\n    llama70b)\n      REQUEST_RATES=$(seq 1.6 -0.2 0.6)\n      ;;\n    llama70b-fp8)\n      REQUEST_RATES=$(seq 1.6 0.2 3.0)\n      ;;\n    *)\n      REQUEST_RATES=$(seq 0.4 0.2 2.0)\n      ;;\n  esac\nfi\n\necho \"Running benchmark with MODEL: $MODEL\"\necho \"Request rates to be tested: $REQUEST_RATES\"\n\nfor rate in $REQUEST_RATES\ndo\n  echo \"-----------------------------------------\"\n  echo \"Benchmarking with request-rate: $rate\"\n  echo \"-----------------------------------------\"\n  python -m vllm.entrypoints.cli.main bench serve \\\n    --model \"$MODEL\" \\\n    --dataset-name azure_conv \\\n    --ignore-eos \\\n    --num-prompts 1200 \\\n    --skip-first-n-requests 100 \\\n    --skip-last-n-requests 100 \\\n    --metric-percentiles='90' \\\n    --request-rate \"$rate\" \\\n    --save-result \\\n    --save-detailed \\\n    --result-dir \"$RESULT_DIR\" \\\n    --result-filename \"rate_${rate}.json\" \\\n    --metadata ts_config=\"$TS_NAME\" model=\"$MODEL_ID\"\ndone\n\necho \"Benchmark finished.\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d90-6eef-7460-be37-d0055a7c7c31","create_time":1787739650.2706072}}}
