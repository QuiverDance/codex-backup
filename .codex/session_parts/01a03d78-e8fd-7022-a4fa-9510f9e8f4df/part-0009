{"timestamp":"2026-08-26T10:20:36.185Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d96-01d9-7191-9995-0c1624321bd8","call_id":"call_JZByYhIffrwBRhPo7If1fQES","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    parser = FlexibleArgumentParser(\n        description=\"vLLM OpenAI-Compatible RESTful API server.\")\n    parser = make_arg_parser(parser)\n    parser.add_argument(\n        \"--max-context-len\",\n        type=int,\n        default=8192,\n        help=\n        \"Max context(input + ouput)'s length which Inference Engine can handle\",\n    )\n    parser.add_argument(\"-d\",\n                        \"--debug\",\n                        action=\"store_true\",\n                        help=\"Active Debug Log Level(+ nvtx)\")\n    _COMP_CHOICES = [\"zipserv\", \"dietgpu\",\n                     \"zipserv_bf16\", \"dietgpu_bf16\",\n                     \"zipserv_fp8\", \"dietgpu_fp8\",\n                     \"p4flat\", \"p4d16\", \"p3flat_fp8\",\n                     \"ublb_flat\"]\n    parser.add_argument(\"--weight-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Enable Weight Compression. Optional value \"\n                             \"selects backend (default: zipserv = auto \"\n                             \"BF16/FP8 based on weight dtype). Use the \"\n                             \"_bf16/_fp8 suffix to pin a specific variant.\")\n    parser.add_argument(\"--split-compressor\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Override compressor backend for the \"\n                             \"frozen_split residency mode only. Falls back \"\n                             \"to --weight-comp if not set.\")\n    parser.add_argument(\"--offload-compressor\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Override compressor backend for the \"\n                             \"offload_compressed and frozen_compressed \"\n                             \"residency modes. Falls back to --weight-comp \"\n                             \"if not set. Use together with --split-compressor \"\n                             \"to mix backends across modes.\")\n    parser.add_argument(\"--prefill-alt-comp\",\n                        nargs=\"?\",\n                        const=\"p4flat\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Phase-adaptive prefill codec. For prefill chunks \"\n                             \"below the per-codec threshold \"\n                             \"(TIERED_SERVE_PREFILL_ALT_MAX_CHUNK) this codec is \"\n                             \"decoded from LPDDR instead of H2D'ing raw_bf16, \"\n                             \"while DECODE keeps the --split-compressor codec. \"\n                             \"'p4flat' (the no-value default) is the supported \"\n                             \"DISTINCT fast-decode alt: it shares the HBM \"\n                             \"sign|mantissa with a zipserv primary \"\n                             \"(canonical-sm), so e.g. `--weight-comp zipserv \"\n                             \"--prefill-alt-comp` = zipserv decode + p4flat \"\n                             \"prefill. Naming the SAME codec as the primary \"\n                             \"gives the unified path (reuse primary buffers, no \"\n                             \"extra copy). Sets TIERED_SERVE_PREFILL_ALT_BACKEND.\")\n    parser.add_argument(\"--prefill-alt-max-chunk\",\n                        default=None,\n                        metavar=\"N|MAP\",\n                        help=\"Override the prefill-alt chunk threshold: a single \"\n                             \"int (one threshold for every codec) or a per-codec \"\n                             \"map 'p4flat=1330,zipserv=830,...'. Unset uses the \"\n                             \"calibrated built-in per-codec defaults \"\n                             \"(see runs/bench_prefill_alt_crossover.py). Sets \"\n                             \"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK.\")\n    parser.add_argument(\"--offload-prefill-max-chunk\",\n                        default=None,\n                        metavar=\"N|MAP\",\n                        help=\"Phase-adaptive prefill for OFFLOAD_COMPRESSED \"\n                             \"weights (distinct from --prefill-alt-*, which is \"\n                             \"frozen_split). Prefill chunks below this threshold \"\n                             \"decode the compressed LPDDR copy (less H2D) \"\n                             \"instead of H2D'ing the uncompressed one; larger \"\n                             \"chunks keep uncompressed. Single int or per-codec \"\n                             \"map 'zipserv=600,...'. Lossless codecs only; OFF by \"\n                             \"default. Sets TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK.\")\n    parser.add_argument(\"--fused-mm\",\n                        action=\"store_true\",\n                        help=\"Request the weight compressor's \"\n                             \"decompress+GEMM execution path. An override is \"\n                             \"installed only for compressor/residency pairs \"\n                             \"that support it; other cells keep dense \"\n                             \"decompress+matmul. P4Flat frozen_compressed and \"\n                             \"frozen_split install overrides, while P4Flat \"\n                             \"offload_compressed keeps the dense path. This \"\n                             \"flag does not enable weight compression.\")\n    parser.add_argument(\"--ats-decomp-frozen\",\n                        action=\"store_true\",\n                        help=\"frozen_split decode reads compressed bytes \"\n                             \"directly from LPDDR via host-mapped UVA, \"\n                             \"skipping the H2D copy into GPU staging. \"\n                             \"Recommended on GH200.\")\n    parser.add_argument(\"--ats-decomp-offload\",\n                        action=\"store_true\",\n                        help=\"offload_compressed load+decompress reads \"\n                             \"compressed bytes directly from LPDDR via \"\n                             \"host-mapped UVA, skipping the H2D copy \"\n                             \"into GPU staging. Recommended on GH200.\")\n    parser.add_argument(\"--kv-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=[\"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\",\n                                 \"p4flatcpu\", \"ublb_flat\", \"ublb_tbe\"],\n                        help=\"Enable KV Compression. Optional value selects \"\n                             \"backend (default: zipserv when flag is given \"\n                             \"without value). 'zipserv' uses the accelerated \"\n                             \"C++ CPU worker pool after raw KV is swapped to \"\n                             \"host memory. 'mantexp' selects the \"\n                             \"sign+mantissa / compressed-exponent split \"\n                             \"backend (equivalent to --mantexp-split-kv). \"\n                             \"'p4flat' selects the BF16 P4-flat per-tile \"\n                             \"exponent-palette codec (GPU encode by default). \"\n                             \"'p4flatcpu' is the same codec with the C++ \"\n                             \"OpenMP CPU host encoder (cpu_after_raw_swap). \"\n                             \"'ublb_flat'/'ublb_tbe' are the UB/LB-split codecs \"\n                             \"(P4Flat-based, CPU encode + GPU batched decode): \"\n             \"split storage for KV only. Forces --kv-comp=mantexp.\")\n    parser.add_argument(\n        \"--mantexp-kv-codec\",\n        default=None,\n        choices=[\"raw\", \"dietgpu\", \"nvcomp_ans\", \"nvcomp_bitcomp\",\n                 \"zipserv\"],\n        help=\"Exponent-stream codec for split-KV path. Default: dietgpu. \"\n             \"'zipserv' is rejected at runtime (ZipServ is itself a BF16 \"\n             \"split codec; pair with --kv-comp zipserv WITHOUT \"\n             \"--mantexp-split-kv instead). Sets TIERED_SERVE_KV_MANT_CODEC.\")\n    parser.add_argument(\n        \"--hbm-limit\",\n        type=float,\n        default=None,\n        metavar=\"GiB\",\n        help=\"Simulate reduced HBM by capping usable GPU memory to this \"\n             \"many GiB (e.g. 48 to mimic an H100-class GPU).\")\n    parser.add_argument(\n        \"--ts-configs\",\n        type=str,\n        nargs=\"+\",\n        required=True,\n        metavar=\"YAML\",\n        help=\"One or more module_block_config YAML paths. \"\n             \"The first is used as the primary config.\",\n    )\n\n    args = parser.parse_args()\n    # Keep the serving scheduler/KV topology deterministic.  Normalize both\n    # policies even when a caller passes their opposite CLI flags.\n    args.enable_prefix_caching = False\n    args.chunked_prefill = True\n\n    args.ts_configs = [resolve_ts_config(c, args.model) for c in args.ts_configs]\n\n    context_len = args.max_context_len\n    # ``--max-num-batched-tokens`` comes from vLLM's base serving parser.\n    # Preserve the tiered-serving default when the option is omitted, while\n    # allowing an explicit CLI value to control the chunked-prefill budget.\n    max_num_batched_tokens = (\n        args.max_num_batched_tokens\n        if args.max_num_batched_tokens is not None\n        else 1024\n    )\n    model_id = args.model.split('/')[-1].lower().replace('-', '_').replace('.', '_')\n    ts_config_name = Path(args.ts_configs[0]).stem\n    log_level = logging.DEBUG if args.debug else logging.INFO\n\n    os.environ[\"TIERED_SERVE_PRIMARY_DEVICE\"] = \"cuda:0\"\n    os.environ[\"TIERED_SERVE_SECONDARY_DEVICE\"] = \"cpu\"\n\n    os.environ[\"TIERED_SERVE_OFFLOAD_TYPE\"] = \"KVWeight\"\n\n    os.environ[\"TIERED_SERVE_MODEL_ID\"] = model_id\n    os.environ[\"TIERED_SERVE_MODEL_HF_ID\"] = args.model\n    os.environ[\"TIERED_SERVE_MODULE_BLOCK_CONFIG_PATH\"] = args.ts_configs[0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d90-6eef-7460-be37-d0055a7c7c31","create_time":1787739636.1856818}}}
