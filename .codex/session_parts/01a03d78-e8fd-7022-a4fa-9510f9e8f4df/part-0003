ht\",\n            \"mlp.gate_up_proj.weight\", \"mlp.down_proj.weight\"\n        ]\n\n        init_event = self.begin_forward_event\n        use_weight_comp = DualMemoryLoader.use_weight_comp\n        load_comp_weight = DualMemoryLoader.load_comp_weight\n        use_kv_comp = DualMemoryLoader.use_kv_comp\n\n        # ── Compute intervals ──\n        # The V1 wrapper records begin_exec/end_exec around every graph piece\n        # for BOTH prefill and decode.  These are the source of truth: module\n        # hooks are baked out of captured/compiled pieces, so their per-kernel\n        # events can remain stale during mixed prefill and previously produced\n        # overlapping intervals whose raw sum exceeded GPUFwd.\n        llm_intervals = self._calc_intervals(\n            init_event, self.begin_exec_events, self.end_exec_events)\n        if llm_intervals:\n            llm_intervals = self._calc_exec_times(llm_intervals, [])\n        elif self.batch_has_prefill:\n            # V0 fallback: eager module hooks still provide kernel intervals.\n            # Merge their union before summing because nested/duplicate hooks\n            # are legal and must never count the same GPU time twice.\n            kernel_intervals = self._calc_intervals(\n                init_event, self.begin_kernel_events, self.end_kernel_events)\n            if kernel_intervals:\n                total_end = init_event.elapsed_time(self.end_forward_event)\n                first_start = min(total_end, kernel_intervals[0][0])\n                last_end = min(\n                    total_end, max(e for _, e in kernel_intervals))\n                if first_start > 0.001:\n                    kernel_intervals.append((0.0, first_start))\n                if total_end > last_end + 0.001:\n                    kernel_intervals.append((last_end, total_end))\n                llm_intervals = self._calc_exec_times(kernel_intervals, [])\n        llm_time = sum(e - b for b, e in llm_intervals)\n\n        # ── We