{"timestamp":"2026-08-26T09:55:25.791Z","ordinal":151,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a03d7e-f5df-7090-aecc-ea5d53f5682f","call_id":"call_6RnYpHqesMkNrqJX3FD1CrWs","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"                f\"GPUFwd: {total_time:.4f} | \"\n                f\"Compute: {llm_brk:.4f} \"\n                f\"WDecomp: {wdecomp_brk:.4f} \"\n                f\"KVDecomp: {kvdecomp_brk:.4f} \"\n                f\"WLoad: {wload_brk:.4f} \"\n                f\"KVLoad: {kvload_brk:.4f} \"\n                f\"Stall: {stall_brk:.4f}\")\n            # Both phases' breakdowns are accumulated (see below) and logged\n            # once per batch by the benchmark driver\n            # (offline_offload_kvweight.py); the per-step console line is\n            # suppressed for BOTH so the console isn't spammed one line per\n            # step.  File + nvtx keep the full per-step record regardless.\n            if self._time_log_file is not None:\n                self._time_log_file.write(brk_msg + \"\\n\")\n                self._time_log_file.flush()\n            torch.cuda.nvtx.mark(brk_msg)\n\n            # Expose the breakdown as a plain dict for the benchmark driver\n            # and diagnostics.  Overwritten each calc_times call; prefill /\n            # decode are distinguishable via the \"is_prefill\" field.\n            self.last_breakdown = {\n                \"is_prefill\": self.batch_has_prefill,\n                \"gpu_fwd_ms\": total_time,\n                \"compute_ms\": llm_brk,\n                \"wdecomp_ms\": wdecomp_brk,\n                \"kvdecomp_ms\": kvdecomp_brk,\n                \"wload_ms\": wload_brk,\n                \"kvload_ms\": kvload_brk,\n                \"stall_ms\": stall_brk,\n            }\n            if (not self.batch_has_prefill and use_kv_comp\n                    and getattr(_kc, \"_cpu_profile_enabled\", False)):\n                _join_total = float(getattr(\n                    _kc, \"_step_cpu_join_total_ms\", 0.0))\n                _worker_wait = float(getattr(\n                    _kc, \"_step_cpu_worker_wait_ms\", 0.0))\n                self.last_breakdown.update({\n                    \"kv_cpu_join_ms\": _join_total,\n                    \"kv_cpu_worker_wait_ms\": _worker_wait,\n                    \"kv_cpu_publish_ms\": max(\n                        0.0, _join_total - _worker_wait),\n                    \"kv_cpu_join_calls\": int(getattr(\n                        _kc, \"_step_cpu_join_calls\", 0)),\n                    \"kv_cpu_join_blocks\": int(getattr(\n                        _kc, \"_step_cpu_join_blocks\", 0)),\n                    \"kv_cpu_join_max_ms\": float(getattr(\n                        _kc, \"_step_cpu_join_max_ms\", 0.0)),\n                    \"kv_cpu_fast_commit_ms\": float(getattr(\n                        _kc, \"_step_cpu_fast_commit_ms\", 0.0)),\n                    \"kv_cpu_fast_finalize_ms\": float(getattr(\n                        _kc, \"_step_cpu_fast_finalize_ms\", 0.0)),\n                    \"kv_cpu_legacy_get_ms\": float(getattr(\n                        _kc, \"_step_cpu_legacy_get_ms\", 0.0)),\n                    \"kv_cpu_legacy_finalize_ms\": float(getattr(\n                        _kc, \"_step_cpu_legacy_finalize_ms\", 0.0)),\n                    \"kv_cpu_fast_candidates\": int(getattr(\n                        _kc, \"_step_cpu_fast_candidates\", 0)),\n                    \"kv_cpu_fast_hits\": int(getattr(\n                        _kc, \"_step_cpu_fast_hits\", 0)),\n                    \"kv_cpu_fast_fallbacks\": int(getattr(\n                        _kc, \"_step_cpu_fast_fallbacks\", 0)),\n            pool['is_raw'], pool['valid_rows'], M_b, K_b, valid_tm)\n\n    def _encode_chunk(self, layer_id: int, host_k: torch.Tensor,\n                      host_v: torch.Tensor, bid_arr, slots_arr,\n                      wait_handle: int, bvt=None, dec_h2d_handle: int = 0) -> None:\n        # Reads raw secondary KV (gated by the primary->secondary D2H event) and\n        # OVERWRITES the persistent pool slots.  The pool write must follow the\n        # decode's in-flight H2D read of those slots, so wait on the decode-H2D\n        # event too — both waits run here on the worker thread (not the forward\n        # thread), so they never serialize the main decode loop.\n        self._pin_worker_thread()\n        _t0 = time.perf_counter()\n        _sync_cuda_event(wait_handle)      # raw-D2H: unload input ready\n        _ta = time.perf_counter()\n        _sync_cuda_event(dec_h2d_handle)   # decode-H2D: slots free to overwrite\n        _t1 = time.perf_counter()  # GPU event wait done; encode starts\n        M_b, K_b = self._M_b, self._K_b\n        ntm = M_b // 64\n        bs, hd = self._block_size, self._hd\n\n        # Group blocks by valid_tm.  Occupancy OFF (no bvt) => every block is\n        # full (valid_tm == ntm) => a SINGLE group, tensors built zero-copy from\n        # the numpy arrays (torch.from_numpy, no per-block Python loop).\n        # Occupancy ON => one cheap list-comp (dict.get + arithmetic, no .item()).\n        # Each group is one C++ OpenMP call that reads src[block_ids[b]] directly\n        # from the host KV tensor (no gather copy) and writes serialized blobs +\n        # meta into the pool slots, GIL released.  ``host`` is the contiguous\n        # secondary-KV tensor [n_off, *block_shape]; its int16 view is\n        # flat-equivalent to [n_off, M_b, K_b].\n        if bvt is None or not bs or not hd:\n            groups = [(ntm, torch.from_numpy(bid_arr),\n                       torch.from_numpy(slots_arr))]\n        else:\n            from collections import defaultdict\n            gb = defaultdict(list)\n            gs = defaultdict(list)\n            for bid, slot in zip(bid_arr.tolist(), slots_arr.tolist()):\n                vt = max(1, min((int(bvt.get(bid, bs)) * hd + 4095) // 4096,\n                                ntm))\n                gb[vt].append(bid)\n                gs[vt].append(slot)\n            groups = [(vt, torch.from_numpy(np.asarray(gb[vt], dtype=np.int64)),\n                       torch.from_numpy(np.asarray(gs[vt], dtype=np.int64)))\n                      for vt in gb]\n\n        for valid_tm, bidx, slots_t in groups:\n            for host, kv in ((host_k, 'k'), (host_v, 'v')):\n                pool = self._host_pools[layer_id][kv]\n                self._invoke_host_encode(\n                    host.view(torch.int16), bidx, slots_t, pool,\n                    M_b, K_b, valid_tm)\n        if self._blob_stride < self._raw_bytes:\n            pools = self._host_pools[layer_id]\n            slots = np.asarray(slots_arr, dtype=np.int64)\n            if (((pools['k']['is_raw'].numpy()[slots] >= 2)\n                    | (pools['v']['is_raw'].numpy()[slots] >= 2)).any()):\n                self._secondary_fallback_possible[layer_id] = True\n        _t2 = time.perf_counter()  # encode done\n        with self._pin_lock:\n            self._wt_wraw += (_ta - _t0)\n            self._wt_wait += (_t1 - _t0)\n            self._wt_comp += (_t2 - _t1)\n            self._wt_n += 1\n            if self._wt_n >= 2000:\n                _n = self._wt_n\n                logger.warning(\n                    \"[kv-compress] per-call: raw-D2H wait %.2f ms | \"\n                    \"decode-H2D wait %.2f ms | encode %.2f ms | %d calls\",\n                    self._wt_wraw / _n * 1e3,\n                    (self._wt_wait - self._wt_wraw) / _n * 1e3,\n                    self._wt_comp / _n * 1e3, _n)\n                self._wt_wraw = self._wt_wait = self._wt_comp = 0.0\n                self._wt_n = 0\n\n    def wait_compress_async(self, layer_id: int, block_shape: tuple,\n                            timeout_sec: float = -1.0) -> None:\n        # Keep the pending entry visible while Event.wait() releases the GIL.\n        # A scheduler/free callback running on another Python thread must still\n        # quarantine the worker's captured physical slots instead of returning\n        # them to the allocation heap before the old worker retires.\n        with self._slot_state_lock:\n            state = self._pending_compress.get(layer_id)\n        if state is not None:\n            try:\n                if 'state' in state:\n                    self._wait_worker_state(state['state'], timeout_sec)\n                else:\n                    for f in state['futures']:\n                        f.result()   # join + propagate worker exceptions\n            except BaseException:\n                if 'state' in state:\n        self._ext = zipserv_ext.ZipServCompressor()\n        self._zipserv_mod = zipserv_ext\n        # Single stream for compress path (gather → compress → D2H).\n        super().__init__(comp_stream)\n        # Low priority so concurrent GEMM on the exec stream is not slowed.\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        # Wired by DualMemoryLoader for KV transfers.\n        self.load_kv_stream = None\n        # Set by DualMemoryLoader after construction.  Keep breakdown-only\n        # event records out of the serving hot path unless timing is enabled.\n        self._tb = False\n        self._kv_h2d_begin: List[torch.cuda.Event] = []\n        self._kv_dec_h2d: List[torch.cuda.Event] = []\n        self._kv_decode_begin: List[torch.cuda.Event] = []\n        # Optional foreground CPU accounting.  Read once at construction;\n        # wait/decode paths only consult this cached bool.\n        self._cpu_profile_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_CPU_PROFILE\", \"0\") == \"1\")\n        self.reset_cpu_profile_step()\n        # Per-head BaseExp configuration (None = global mode)\n        self._base_exp_config = base_exp_config\n        # Compressed KV store: {layer_id: dict | tuple(old prefill path)}\n        self._compressed_kv: Dict[int, Any] = {}\n        # Pre-allocated buffer pools (populated by warmup_kv_buffers)\n        self._kv_pools_ready = False\n        # Per-block flat GPU compress output pools: 2 sets (K, V)\n        self._kv_comp_gpu: List[Dict[str, torch.Tensor]] = []\n        # Per-block flat GPU decompress input pools: 2 sets (K, V)\n        self._kv_decomp_gpu: List[Dict[str, torch.Tensor]] = []\n        # Host pinned 3-pool split: {layer_id: [k_pool, v_pool]}\n        # Each pool dict carries meta/sm/cf backing tensors and offsets.\n        self._kv_host_pools: Dict[int, list] = {}\n        self._kv_host_packed = True  # always 3-pool split under ZipServ now\n        self._kv_packed_offsets_bytes: List[int] = []\n        self._kv_packed_attr_sizes_bytes: List[int] = []\n        self._kv_packed_h2d_attr_sizes_bytes: List[int] = []\n        self._kv_packed_block_bytes: int = 0  # worst-case block bytes\n        self._kv_packed_h2d_block_bytes: int = 0\n        self._kv_packed_gpu_blocks: int = 0\n        self._kv_attr_elem_sizes: Dict[str, int] = {}\n        self._kv_decomp_packed_gpu: List[torch.Tensor] = []\n        self._kv_offsets_gpu: Dict[int, list] = {}\n        self._kv_offsets_on_hbm = False\n        # ── C++ slub-pool path marker ──\n        self._append_pool: Optional[object] = None\n        self._sm_pool_bytes: int = 0\n        self._cf_pool_bytes: int = 0\n        self._sm_max_bytes: int = 0    # uint8 m*k\n        self._cf_max_bytes: int = 0    # bf16 m*k*2\n        self._meta_total_bytes: int = 0\n        # Per-block strides for flat buffer indexing\n        self._kv_strides: Dict[str, int] = {}\n        # Old-path compat: decompress output buffers & buffer_ids\n        self._kv_decomp_outputs: List[Optional[torch.Tensor]] = []\n        self._kv_gpu_pools: List[Dict[str, torch.Tensor]] = []\n        self._kv_buffer_ids_gpu: Optional[torch.Tensor] = None\n        self._kv_buffer_ids_cpu: Dict[int, torch.Tensor] = {}\n        # C++ compress worker manager (initialised by init_kv_compress_workers)\n        self._kv_compress_mgr = None\n        self._kv_compress_batch_capacity: int = 0\n        # Existing loader code uses this marker to join a layer before its next\n        # decode/unload.  That also prevents the next raw D2H from overwriting\n        # secondary_kv while host-zero-copy workers still read it.\n        self._pending_compress: Dict[int, dict] = {}\n        # Eviction invalidates immediately, but physical reclamation waits for\n        # an in-flight layer generation to finish.\n        self._pending_kv_evictions: Dict[int, set] = {}\n        # Per-layer mask aligned with the currently enqueued block_ids.  True\n        # rows had no physical metadata slot at enqueue and must be published\n        # from logical backing after compression.\n        self._kv_meta_needs_publish: Dict[int, torch.Tensor] = {}\n        # ── Persistent compressed KV store ──\n        # Per-layer, per-block metadata for persistent compressed KV.\n        # _persistent_kv_meta[layer_id][block_id] = {'k_meta': dict, 'v_meta': dict, 'm': int, 'k': int}\n        # Actual compressed bytes live in _kv_host_pools at block_id * stride.\n        self._persistent_kv_meta: Dict[int, Dict[int, dict]] = {}\n        self._kv_max_n_blocks: int = 0\n        # Pending split-phase decompress state (set by start_kv_h2d_persistent,\n        # consumed by finish_kv_decompress_persistent).\n        self._pending_decomp: Optional[dict] = None\n        # Pre-allocated pinned buffers for prep_layer_decomp_split outputs\n        # (populated lazily on first use in start_kv_h2d_persistent).  Each\n        # decode-step layer call reuses these buffers; counts are returned\n        # by the C++ call and used to narrow each tensor.\n        self._prep_buffers: Optional[dict] = None\n        # Cache the split-h2d env var lookup at init.  start_kv_h2d_persistent\n        # is hot path (80x per decode step) and os.getenv + str.lower + tuple\n        # membership cost ~5-10 µs each call.\n        self._spli