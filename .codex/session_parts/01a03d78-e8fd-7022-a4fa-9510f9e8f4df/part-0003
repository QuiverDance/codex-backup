not in (\"compressed\", \"raw\"):\n            raise ValueError(\n                f\"Unknown TIERED_SERVE_KV_DECODE_LOAD: \"\n                f\"{self.kv_decode_load_backend!r}. Expected 'compressed' \"\n                \"or 'raw'.\")\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV decode load backend: %s\",\n                self.kv_decode_load_backend)\n        _prefill_comp_requested = (\n            os.getenv(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if _prefill_comp_requested and not DualMemoryLoader.use_kv_comp:\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 requires \"\n                \"TIERED_SERVE_USE_KV_COMP=1\"\n            )\n        if (\n            _prefill_comp_requested\n            and self.kv_decode_load_backend != \"compressed\"\n        ):\n            raise ValueError(\n                \"TIERED_SERVE_KV_COMP_PREFILL_LOAD=1 conflicts with \"\n                \"TIERED_SERVE_KV_DECODE_LOAD=raw\"\n            )\n        self.kv_comp_prefill_load = bool(_prefill_comp_requested)\n        DualMemoryLoader.kv_comp_prefill_load = (\n            self.kv_comp_prefill_load\n        )\n        # A mixed prefill needs current-layer KV materialisation: a preceding\n        # decode may have left a different parity-sharing layer in the dense\n        # staging cache.  The offline benchmark enables this for both its raw\n        # and compressed arms so they use the same safe schedule.  Resolve the\n        # policy once here; the per-piece wrapper only reads the cached bool.\n        self.kv_prefill_jit_current = (\n            os.getenv(\n                \"TIERED_SERVE_KV_PREFILL_JIT_CURRENT\", \"0\"\n            ).lower()\n            in (\"1\", \"true\", \"on\")\n        )\n        if DualMemoryLoader.use_kv_comp:\n            logger.info(\n                \"KV prefill load backend: %s\",\n                (\n                    \"compressed\"\n                    if self.kv_comp_prefill_load\n                    else \"raw\"\n                ),\n            )\n        if self.kv_prefill_jit_current:\n            logger.info(\"KV prefill scheduling: current-layer JIT\")\n\n        # Per-step CPU-timer accumulators for the KV-comp pipeline.  Reset\n        # at layer 0 (step start) inside the load/unload paths; logged at\n        # the last layer (step end) inside unload_comped_kv.\n        self._step_unload_disp_ms = 0.0\n        self._step_comp_wait_ms = 0.0\n        # Reset once per forward in torch_hooks.before_model_forward.  The\n        # mixed-prefill benchmark uses this as a structural proof that at\n        # least one layer actually launched persistent compressed KV H2D,\n        # rather than merely having offloadable active block ids.\n        self.prefill_kv_comp_load_layers = 0\n\n        self._time_log_file = None\n        if self.collect_times:\n            log_dir = os.getenv(\"TIERED_SERVE_LOG_DIR\")\n            if log_dir:\n        )\n        if layer_id == 0:\n            self._tail_rollover_d2d_l0_blocks += len(dst_ids)\n            if not self._tail_logged_first_rollover_d2d:\n                self._tail_logged_first_rollover_d2d = True\n                logger.info(\n                    \"[kv-full-block] first rollover D2D submitted: \"\n                    \"step=%d blocks=%d\",\n                    self._tail_steps, len(dst_ids))\n        return True\n\n    @classmethod\n    def _init_kv_caches(cls, n_layers: int):\n        cls.kv_caches = [vLLMKVCache(idx) for idx in range(n_layers)]\n\n    @classmethod\n    def append_unload_target(cls, blk_id: int):\n        cls.unload_targets.add(blk_id)\n\n    @classmethod\n    def clear_unload_targets(cls):\n        cls.unload_targets.clear()\n\n    def _uses_compressed_kv_load(self, layer_id: int) -> bool:\n        \"\"\"Whether this layer reconstructs active KV from compressed storage.\n\n        Prefill traditionally forced the raw secondary cache. The opt-in\n        mixed-prefill path instead passes the whole active set to the\n        compressor, whose persistent-valid filter reconstructs only historical\n        blocks; fresh prompt blocks are left untouched until the current\n        attention writes them.\n        \"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and layer_id in self.kv_comp_targets\n            and self.kv_decode_load_backend == \"compressed\"\n            and (\n                not self.batch_has_prefill\n                or self.kv_comp_prefill_load\n            )\n        )\n\n    def _prefill_uses_dedicated_raw_kv_stream(self) -> bool:\n        \"\"\"Whether this prefill step has any raw-secondary KV layer.\"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and self.batch_has_prefill\n            and (\n                not self.kv_comp_prefill_load\n                or self.kv_decode_load_backend != \"compressed\"\n                or len(self.kv_comp_targets) != self.n_layers\n            )\n        )\n\n    def _kv_load_stream_for(self, layer_id: int):\n        \"\"\"Return the stream that actually materializes this layer's KV.\n\n        KVCOMP decode may intentionally put compressed-blob H2D on the weight\n        stream. A prefill-bearing batch uses raw secondary KV by default and\n        carries a same-parity unload dependency; keep that dependency on the\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int):\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        # Clean up persistent compressed KV metadata\n        if cls.use_kv_comp and hasattr(cls, '_kv_compressor_ref') and cls._kv_compressor_ref is not None:\n            kc = cls._kv_compressor_ref\n            # free_persistent_block compacts the persistent pool via a\n            # swap-with-last that CPU-memcpys host-pool slots (_move_host_slot).\n            # Drain the decode stream first so an in-flight decode H2D isn't\n            # reading those host-pool rows while the compaction moves them\n            # (torn read -> corrupt blob -> decode OOB).  Cheap: by free time the\n            # prior step's decode is essentially done.\n            # NOTE: the serve IMA root cause was the valid/slot desync (fixed in\n            # wait_compress_async).  The previous per-free compress-WORKER join\n            # was removed — it drained the whole single-worker compress backlog\n            # (big per-free latency) and isn't needed for correctness now.\n            # load_kv_stream is drained too: under the KV-H2D split the staging\n            # blob H2D (which READS the host pool) runs there, not on\n            # batch_decomp_stream — without this the compaction races the in-\n            # flight staging copy (torn read -> IMA, seen at larger batches\n            # where frees are frequent).\n            for _s in (getattr(kc, 'batch_decomp_stream', None),\n                       getattr(kc, 'load_kv_stream', None),\n                       getattr(kc, 'comp_stream', None)):\n                if _s is not None:\n                    _s.synchronize()\n            for layer_id in range(n_layers):\n                kc.free_persistent_block(layer_id, block_id)\n\n    # @log_sparse(stack_depth=5)\n    def load_kv(self, layer_id: int, force=False, non_blocking=True):\n\n        def get_ptr_tensor(tensor_list):\n            \"\"\"\n            텐서 리스트로부터 각 텐서의 데이터 포인터를 담은 텐서를 생성합니다.\n            \"\"\"\n            return torch.tensor([t.data_ptr() for t in tensor_list],\n                                dtype=torch.int64,\n                                device=tensor_list[0].device)\n\n        if self.is_graph_warming_up:\n            return\n\n        load_kv_stream = self._kv_load_stream_for(layer_id)\n\n        if DualMemoryLoader.use_kv_comp:\n            kv_sys = DualMemoryLoader.kv_offload_system\n\n            # Legacy prefill route: raw secondary KV. The benchmark's opt-in\n            # compressed-prefill mode falls through to the persistent decode\n            # branch below and filters fresh prompt blocks by validity.\n            if (\n                self.batch_has_prefill\n                and not self.kv_comp_prefill_load\n            ):\n                # 1. Waits for previous KV unloading complete\n\n                # 2. Load from Uncomped KV\n                # torch.cuda.nvtx.mark(\n                #     f\"BEGIN load_kv().load_uncompressed() Prefill LayerID: {layer_id} n_buffer_ids: {len(self.np_active_kv_buffer_ids)}\"\n                # )\n                self.begin_memcpy_kv_events[layer_id].record(\n                    load_kv_stream)\n                DualMemoryLoader.kv_offload_scheduler.schedule_load_uncompressed(\n                    kv_sys, layer_id, self.active_kv_buffer_ids,\n                    self.kv_load_done[layer_id].cuda_event,\n                    load_kv_stream.cuda_stream)\n                self._stage_tail_rollovers(\n                    layer_id, load_kv_stream)\n                self.end_memcpy_kv_events[layer_id].record(load_kv_stream)\n                # torch.cuda.nvtx.mark(\n                #     f\"END load_kv().load_uncompressed() Prefill LayerID: {layer_id}\"\n                # )\n            # Decode, or opt-in mixed/