s LIST          Comma-separated rates; each gets a fresh server\n                                (default: 1.2)\n  --repeats N                   Full matrix repetitions (default: 3)\n  --max-num-seqs N              vLLM max_num_seqs (default: 128)\n  --dedicated-kv-blocks N       Logical dedicated KV blocks (default: 2432)\n  --weight-huge-pages N         16-GiB weight huge pages (default: 14)\n  --weight-buffers N            Weight staging buffers (default: 2)\n  --numa-node N                 NUMA node for the server (default: 0)\n  --gpu-index N                 CUDA/nvidia-smi GPU index (default: 0)\n  --startup-timeout SEC         Server readiness timeout (default: 900)\n  --shutdown-timeout SEC        Graceful shutdown timeout (default: 120)\n  --cleanup-timeout SEC         Clean-state boundary timeout (default: 180)\n  --max-idle-hbm-mib N          Maximum HBM considered idle (default: 1024)\n  --output-root PATH            Suite output root\n  --check-only                  Validate files, dependencies, and clean state\n  --dry-run                     Print the complete matrix and commands\n  -h, --help                    Show this help\n\nExamples:\n  scripts/serving/run_performance_suite.sh\n  scripts/serving/run_performance_suite.sh --request-rates 1.0,1.2,1.4\n  scripts/serving/run_performance_suite.sh --chunks 2048,4096,8192 --repeats 1\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nparse_csv() {\n  local input=\"$1\"\n  local output_name=\"$2\"\n  local -n output_ref=\"$output_name\"\n  local i\n  IFS=',' read -r -a output_ref <<<\"$input\"\n  for i in \"${!output_ref[@]}\"; do\n    output_ref[$i]=\"${output_ref[$i]//[[:space:]]/}\"\n    [[ -n \"${output_ref[$i]}\" ]] || die \"empty item in list: ${input}\"\n  done\n}\n\nrequire_uint() {\n  local name=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${name} must be a non-negative integer: ${value}\"\n}\n\nrequire_positive_int() {\n  local name=\"$1\"\n  local value=\"$2\"\n  require_uint \"$name\" \"$value\"\n  ((value > 0)) || die \"${name} must be greater than zero\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --modes)\n      (($# >= 2)) || die \"--modes requires a value\"\n      parse_csv \"$2\" MODES\n      shift 2\n      ;;\n    --chunks)\n      (($# >= 2)) || die \"--chunks requires a value\"\n      parse_csv \"$2\" CHUNKS\n      shift 2\n      ;;\n    --request-rates)\n      (($# >= 2)) || die \"--request-rates requires a value\"\n      parse_csv \"$2\" REQUEST_RATES\n      shift 2\n      ;;\n    --repeats)\n      (($# >= 2)) || die \"--repeats requires a value\"\n      REPEATS=\"$2\"\n      shift 2\n      ;;\n    --max-num-seqs)\n      (($# >= 2)) || die \"--max-num-seqs requires a value\"\n      MAX_NUM_SEQS=\"$2\"\n      shift 2\n      ;;\n    --dedicated-kv-blocks)\n      (($# >= 2)) || die \"--dedicated-kv-blocks requires a value\"\n      DEDICATED_KV_BLOCKS=\"$2\"\n      shift 2\n      ;;\n    --weight-huge-pages)\n      (($# >= 2)) || die \"--weight-huge-pages requires a value\"\n      WEIGHT_HUGE_PAGES=\"$2\"\n      shift 2\n      ;;\n    --weight-buffers)\n      (($# >= 2)) || die \"--weight-buffers requires a value\"\n      WEIGHT_BUFFERS=\"$2\"\n      shift 2\n      ;;\n    --numa-node)\n      (($# >= 2)) || die \"--numa-node requires a value\"\n      NUMA_NODE=\"$2\"\n      shift 2\n      ;;\n    --gpu-index)\n      (($# >= 2)) || die \"--gpu-index requires a value\"\n      GPU_INDEX=\"$2\"\n      shift 2\n      ;;\n    --startup-timeout)\n      (($# >= 2)) || die \"--startup-timeout requires a value\"\n      STARTUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --shutdown-timeout)\n      (($# >= 2)) || die \"--shutdown-timeout requires a value\"\n      SHUTDOWN_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --cleanup-timeout)\n      (($# >= 2)) || die \"--cleanup-timeout requires a value\"\n      CLEANUP_TIMEOUT=\"$2\"\n      shift 2\n      ;;\n    --max-idle-hbm-mib)\n      (($# >= 2)) || die \"--max-idle-hbm-mib requires a value\"\n      MAX_IDLE_HBM_MIB=\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$RAW_CONFIG\" \"$KVCOMP_CONFIG\" \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not