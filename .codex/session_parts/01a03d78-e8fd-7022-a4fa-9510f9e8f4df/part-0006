\"$2\"\n      shift 2\n      ;;\n    --output-root)\n      (($# >= 2)) || die \"--output-root requires a value\"\n      OUTPUT_ROOT=\"$2\"\n      shift 2\n      ;;\n    --check-only)\n      CHECK_ONLY=1\n      shift\n      ;;\n    --dry-run)\n      DRY_RUN=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      die \"unknown option: $1\"\n      ;;\n  esac\ndone\n\nrequire_positive_int repeats \"$REPEATS\"\nrequire_positive_int max-num-seqs \"$MAX_NUM_SEQS\"\nrequire_positive_int dedicated-kv-blocks \"$DEDICATED_KV_BLOCKS\"\nrequire_positive_int weight-huge-pages \"$WEIGHT_HUGE_PAGES\"\nrequire_positive_int weight-buffers \"$WEIGHT_BUFFERS\"\nrequire_uint numa-node \"$NUMA_NODE\"\nrequire_uint gpu-index \"$GPU_INDEX\"\nrequire_positive_int startup-timeout \"$STARTUP_TIMEOUT\"\nrequire_positive_int shutdown-timeout \"$SHUTDOWN_TIMEOUT\"\nrequire_positive_int cleanup-timeout \"$CLEANUP_TIMEOUT\"\nrequire_uint max-idle-hbm-mib \"$MAX_IDLE_HBM_MIB\"\n\nfor mode in \"${MODES[@]}\"; do\n  [[ \"$mode\" == raw || \"$mode\" == kvcomp ]] || die \"unsupported mode: ${mode}\"\ndone\nfor chunk in \"${CHUNKS[@]}\"; do\n  require_positive_int chunk \"$chunk\"\ndone\nfor rate in \"${REQUEST_RATES[@]}\"; do\n  [[ \"$rate\" =~ ^[0-9]+([.][0-9]+)?$ ]] || die \"invalid request rate: ${rate}\"\n  awk -v rate=\"$rate\" 'BEGIN { exit !(rate > 0) }' || die \"request rate must be greater than zero: ${rate}\"\ndone\n\nHUGEPAGE_SYSFS=\"/sys/devices/system/node/node${NUMA_NODE}/hugepages/hugepages-16777216kB\"\n\npreflight() {\n  local -a problems=()\n  local required\n\n  for required in \"$PYTHON_BIN\" \"$SERVER_SCRIPT\" \"$CLIENT_SCRIPT\" \\\n      \"$RAW_CONFIG\" \"$KVCOMP_CONFIG\" \"$STACK_POOL_SO\"; do\n    [[ -e \"$required\" ]] || problems+=(\"missing=${required}\")\n  done\n  [[ -x \"$PYTHON_BIN\" ]] || problems+=(\"not-executable=${PYTHON_BIN}\")\n  [[ -x \"$CLIENT_SCRIPT\" ]] || problems+=(\"not-executable=${CLIENT_SCRIPT}\")\n\n  for required in nvidia-smi numactl setsid curl findmnt awk sed grep tee; do\n    command -v \"$required\" >/dev/null || problems+=(\"command-missing=${required}\")\n  done\n\n  [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]] || problems+=(\"16GiB-hugepage-sysfs-missing=${HUGEPAGE_SYSFS}\")\n  grep -Eq 'compressor:[[:space:]]*p4flat' \"$RAW_CONFIG\" 2>/dev/null || problems+=(\"raw-config-is-not-p4flat=${RAW_CONFIG}\")\n  grep -Eq 'compressor:[[:space:]]*p4flat' \"$KVCOMP_CONFIG\" 2>/dev/null || problems+=(\"kvcomp-config-is-not-p4flat=${KVCOMP_CONFIG}\")\n\n  if ((${#problems[@]})); then\n    printf '[suite] ERROR: preflight failed: %s\\n' \"$(IFS='; '; echo \"${problems[*]}\")\" >&2\n    return 1\n  fi\n}\n\nmapfile -t INHERITED_TIERED_ENV < <(compgen -e | awk '/^TIERED_SERVE_/ { print }' | sort)\nCLEAN_ENV=(env -u LD_PRELOAD -u RESULT_DIR -u CUDA_VISIBLE_DEVICES \\\n  -u VLLM_DISABLE_COMPILE_CACHE -u PYTORCH_CUDA_ALLOC_CONF)\nfor inherited_var in \"${INHERITED_TIERED_ENV[@]}\"; do\n  CLEAN_ENV+=(-u \"$inherited_var\")\ndone\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+=(\"nvidia-smi-query-failed\")\n    gpu_line=\",\"\n  fi\n  IFS=',' read -r hbm_used gpu_util <<<\"$gpu_line\"\n  if [[ ! \"$hbm_used\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-hbm=${hbm_used:-empty}\")\n  elif ((hbm_used > MAX_IDLE_HBM_MIB)); then\n    problems+=(\"hbm=${hbm_used}MiB>${MAX_IDLE_HBM_MIB}MiB\")\n  fi\n  if [[ ! \"$gpu_util\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-gpu-util=${gpu_util:-empty}\")\n  elif ((gpu_util != 0)); then\n    problems+=(\"gpu-util=${gpu_util}%\")\n  fi\n\n  gpu_apps=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-compute-apps=pid,process_name,used_memory \\\n      --format=csv,noheader,nounits 2>/dev/null | sed '/^[[:space:]]*$/d' || true)\"\n  [[ -z \"$gpu_apps\" ]] || problems+=(\"gpu-processes=${gpu_apps//$'\\n'/ | }\")\n\n  if [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]]; then\n    hp_total=\"$(<\"${HUGEPAGE_SYSFS}/nr_hugepages\")\"\n    hp_free=\"$(<\"${HUGEPAGE_SYSFS}/free_hugepages\")\"\n    hp_reserved=\"$(<\"${HUGEPAGE_SYSFS}/resv_hugepages\")\"\n    if [[ \"$hp_total\" =~ ^[0-9]+$ ]] && ((hp_total < WEIGHT_HUGE_PAGES)); then\n      problems+=(\"hugepages-total=${hp_total}<weight-pages=${WEIGHT_HUGE_PAGES}\")\n    fi\n    [[ \"$hp_total\" == \"$hp_free\" ]] || problems+=(\"hugepages-free=${hp_free}/${hp_total}\")\n    [[ \"$hp_reserved\" == 0 ]] || problems+=(\"hugepages-reserved=${hp_reserved}\")\n  else\n    hp_total=\"?\"\n    hp_free=\"?\"\n    hp_reserved=\"?\"\n    problems+=(\"16GiB-hugepage-sysfs-missing\")\n  fi\n\n  mount_type=\"$(findmnt -n -o FSTYPE /mnt/hugepages 2>/dev/null || true)\"\n  [[ \"$mount_type\" == hugetlbfs ]] || problems+=(\"/mnt/hugepages=${mount_type:-not-mounted}\")\n\n  if ((${#problems[@]})); then\n    LAST_STATE_DETAIL=\"$(IFS='; '; echo \"${problems[*]}\")\"\n    return 1\n  fi\n  LAST_STATE_DETAIL=\"gpu=${GPU_INDEX} hbm=${hbm_used}MiB util=${gpu_util}% hugepages=${hp_free}/${hp_total}\"\n  return 0\n}\n\nwait_for_clean_state() {\n  local context=\"$1\"\n  local deadline=$((SECONDS + CLEANUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ! capture_clean_state; do\n    if ((SECONDS >= deadline)); then\n      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n      next_report=$((SECONDS + 15))\n    fi\n    sleep 2\n  done\n  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n}\n\nsanitize_id() {\n  local value=\"$1\"\n  value=\"${value//./p}\"\n  value=\"${value//\\//_}\"\n  printf '%s' \"$value\"\n}\n\nquote_command() {\n  printf '%q ' \"$@\"\n  printf '\\n'\n}\n\nCMD=()\nbuild_server_command() {\n  local mode=\"$1\"\n  local chunk=\"$2\"\n  local config\n  local -a mode_args=()\n\n  if [[ \"$mode\" == kvcomp ]]; then\n    config=\"$KVCOMP_CONFIG\"\n    mode_args=(--kv-comp \"$KV_BACKEND\")\n  else\n    config=\"$RAW_CONFIG\"\n  fi\n\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n    \"LD_PRELOAD=${STACK_POOL_SO}\"\n    \"VLLM_DISABLE_COMPILE_CACHE=1\"\n    \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True\"\n    \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n    \"TIERED_SERVE_N_WEIGHT_BUFFERS=${WEIGHT_BUFFERS}\"\n    \"TIERED_SERVE_DEDICATED_KV_BLOCKS=${DEDICATED_KV_BLOCKS}\"\n    \"TIERED_SERVE_GPU_RESERVE_GIB=${GPU_RESERVE_GIB}\"\n    \"TIERED_SERVE_KV_ADDR_ORDER=${KV_ADDR_ORDER}\"\n    numactl --cpunodebind=\"$NUMA_NODE\" --membind=\"$NUMA_NODE\"\n    \"$PYTHON_BIN\" \"$SERVER_SCRIPT\"\n    --model \"$MODEL_PATH\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --no-enable-prefix-caching\n    --chunked-prefill\n    --max-context-len \"$MAX_CONTEXT_LEN\"\n    --max-num-batched-tokens \"$chunk\"\n    --max-num-seqs \"$MAX_NUM_SEQS\"\n    --weight-comp p4flat\n    --fused-mm\n    \"${mode_args[@]}\"\n    --ts-configs \"$config\"\n    --host 127.0.0.1\n    --port \"$PORT\"\n  )\n}\n\nbuild_client_command() {\n  local result_dir=\"$1\"\n  local label=\"$2\"\n  local rate=\"$3\"\n  CMD=(\n    \"${CLEAN_ENV[@]}\"\n    \"PYTHONHASHSEED=0\"\n    \"CUDA_VISIBLE_DEVICES=\"\n    \"PATH=${REPO_ROOT}/.venv/bin:${PATH}\"\n    \"RESULT_DIR=${result_dir}\"\n    bash \"$CLIENT_SCRIPT\" \"$MODEL_ALIAS\" \"$label\" \"$rate\"\n  )\n}\n\nwait_for_server() {\n  local pid=\"$1\"\n  local deadline=$((SECONDS + STARTUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ((SECONDS < deadline)); do\n    if curl -fsS \"http://127.0.0.1:${PORT}/health\" >/dev/null 2>&1; then\n      echo \"[suite] server is ready\"\n      return 0\n    fi\n    if ! kill -0 \"$pid\" 2>/dev/null; then\n      echo \"[suite] ERROR: server exited before becoming ready\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for server readiness\"\n      next_report=$((SECONDS + 30))\n    fi\n    sleep 2\n  done\n  echo \"[suite] ERROR: server readiness timed out after ${STARTUP_TIMEOUT}s\" >&2\n  return 1\n}\n\nprocess_group_alive() {\n  local pgid=\"$1\"\n  ps -eo pgid=,stat= | awk -v pgid=\"$pgid\" '$1 == pgid && $2 !~ /^Z/ { found=1 } END { exit !found }'\n}\n\nwait_for_group_exit() {\n  local pgid=\"$1\"\n  local timeout=\"$2\"\n  local deadline=$((SECONDS + timeout))\n  while process_group_alive \"$pgid\"; do\n    ((SECONDS < deadline)) || return 1\n    sleep 1\n  done\n  return 0\n}\n\nSERVER_PGID=\"\"\nCLIENT_PGID=\"\"\nSERVER_EXIT_STATUS=\"-\"\nSERVER_STOP_KIND=\"not-started\"\n\nstop_server() {\n  local pgid=\"$SERVER_PGID\"\n  [[ -n \"$pgid\" ]] || return 0\n\n  if process_group_alive \"$pgid\"; then\n    SERVER_STOP_KIND=\"interrupt\"\n    echo \"[suite] stopping server process group ${pgid} with SIGINT\"\n    kill -INT -- \"-${pgid}\" 2>/dev/null || true\n    if ! wait_for_group_exit \"$pgid\" \"$SHUTDOWN_TIMEOUT\"; then\n      SERVER_STOP_KIND=\"term\"\n      echo \"[suite] server did not stop after SIGINT; sending SIGTERM\" >&2\n      kill -TERM --