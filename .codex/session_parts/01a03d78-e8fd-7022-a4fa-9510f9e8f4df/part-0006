\\n+        SERVER_STOP_KIND=\\\"kill\\\"\\n+        echo \\\"[suite] server did not stop after SIGTERM; sending SIGKILL\\\" >&2\\n+        kill -KILL -- \\\"-${pgid}\\\" 2>/dev/null || true\\n+        wait_for_group_exit \\\"$pgid\\\" 15 || true\\n+      fi\\n+    fi\\n+  else\\n+    SERVER_STOP_KIND=\\\"already-exited\\\"\\n+  fi\\n+\\n+  set +e\\n+  wait \\\"$pgid\\\" 2>/dev/null\\n+  SERVER_EXIT_STATUS=$?\\n+  set -e\\n+  SERVER_PGID=\\\"\\\"\\n+}\\n+\\n+stop_client() {\\n+  local pgid=\\\"$CLIENT_PGID\\\"\\n+  [[ -n \\\"$pgid\\\" ]] || return 0\\n+  if process_group_alive \\\"$pgid\\\"; then\\n+    echo \\\"[suite] stopping client process group ${pgid}\\\" >&2\\n+    kill -TERM -- \\\"-${pgid}\\\" 2>/dev/null || true\\n+    if ! wait_for_group_exit \\\"$pgid\\\" 30; then\\n+      kill -KILL -- \\\"-${pgid}\\\" 2>/dev/null || true\\n+      wait_for_group_exit \\\"$pgid\\\" 15 || true\\n+    fi\\n+  fi\\n+  set +e\\n+  wait \\\"$pgid\\\" 2>/dev/null\\n+  set -e\\n+  CLIENT_PGID=\\\"\\\"\\n+}\\n+\\n+cleanup_active_groups() {\\n+  set +e\\n+  stop_client\\n+  stop_server\\n+  set -e\\n+}\\n+\\n+on_signal() {\\n+  local signal=\\\"$1\\\"\\n+  trap - INT TERM\\n+  echo \\\"[suite] received ${signal}; cleaning only this suite's active process groups\\\" >&2\\n+  cleanup_active_groups\\n+  exit 130\\n+}\\n+\\n+trap 'on_signal INT' INT\\n+trap 'on_signal TERM' TERM\\n+trap cleanup_active_groups EXIT\\n+\\n+preflight\\n+\\n+CELLS=()\\n+for chunk in \\\"${CHUNKS[@]}\\\"; do\\n+  for rate in \\\"${REQUEST_RATES[@]}\\\"; do\\n+    for mode in \\\"${MODES[@]}\\\"; do\\n+      CELLS+=(\\\"${mode}|${chunk}|${rate}\\\")\\n+    done\\n+  done\\n+done\\n+\\n+if ((DRY_RUN)); then\\n+  echo \\\"[suite] dry-run: ${#CELLS[@]} cells x ${REPEATS} repeats\\\"\\n+  for ((round = 1; round <= REPEATS; round++)); do\\n+    if ((round % 2 == 1)); then\\n+      indices=()\\n+      for ((i = 0; i < ${#CELLS[@]}; i++)); do indices+=(\\\"$i\\\"); done\\n+    else\\n+      indices=()\\n+      for