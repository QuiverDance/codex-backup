vent)))\n-            llm_intervals.sort(key=lambda x: x[0])\n-            llm_time = sum(e - b for b, e in llm_intervals)\n-        else:\n-            # Decode: kernel events not recorded during CUDA graph replay.\n-            # Use begin_exec_events / end_exec_events recorded in the\n-            # V1 wrapper (or V0 multi_cuda_graph_runner) around each\n-            # graph piece + attention.\n-            llm_intervals = []\n-            n_exec = len(self.begin_exec_events)  # n_layers + 1\n-            for i in range(n_exec):\n-                begin_time = init_event.elapsed_time(\n-                    self.begin_exec_events[i])\n-                end_time = init_event.elapsed_time(\n-                    self.end_exec_events[i])\n-                if begin_time >= -0.01 and end_time > begin_time + 0.001:\n-                    llm_intervals.append((begin_time, end_time))\n-            llm_intervals.sort(key=lambda x: x[0])\n-            llm_time = sum(e - b for b, e in llm_intervals)\n+        # The V1 wrapper records begin_exec/end_exec around every graph piece\n+        # for BOTH prefill and decode.  These are the source of truth: module\n+        # hooks are baked out of captured/compiled pieces, so their per-kernel\n+        # events can remain stale during mixed prefill and previously produced\n+        # overlapping intervals whose raw sum exceeded GPUFwd.\n+        llm_intervals = self._calc_intervals(\n+            init_event, self.begin_exec_events, self.end_exec_events)\n+        if llm_intervals:\n+            llm_intervals = self._calc_exec_times(llm_intervals, [])\n+        elif self.batch_has_prefill:\n+            # V0 fallback: eager module hooks still provide kernel intervals.\n+            # Merge their union before summing because nested/duplicate hooks\n+            # are legal and must never count the same GPU time twice.\n+            kernel_intervals = self._calc_intervals(\n+                init_event, self.begin_kernel_events, self.end_kernel_events)\n+            if kernel_intervals:\n+                total_end = init_event.elapsed_time(self.end_forward_event)\n+                first_start = min(total_end, kernel_intervals[0][0])\n+                last_end = min(\n+                    total_end, max(e for _, e in kernel_intervals))\n+                if first_start > 0.001:\n+                    kernel_intervals.append((0.0, first_start))\n+                if total_end > last_end + 0.001:\n+                    kernel_intervals.append((last_end, total_end))\n+                llm_intervals = self._calc_exec_times(kernel_intervals, [])\n+        llm_time = sum(e - b for b, e in llm_intervals)\n \n         # ── Weight decompression intervals (only when compressed) ──\n         weight_decomp_time = 0.0\n@@ -112,19 +107,29 @@ class TimingMixin:\n             kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\n \n             # KVDecomp must be the DECODE KERNEL only.  The loader's interval\n-            # [begin_kv_decomp, end_kv_decomp] (batch_decomp_stream) also covers\n-            # the compressed LPDDR→HBM H2D.  The compressor brackets that H2D\n-            # with tight events (_kv_h2d_begin .. _kv_dec_h2d), so measure the\n-            # H2D separately (→ KVLoad) and start the decode at _kv_dec_h2d.\n+            # [begin_kv_decomp, end_kv_decomp] covers H2D and stream waits.\n+            # _kv_dec_h2d is the H2D-producer event; using it as the decode\n+            # begin still absorbs older work / the decode-buffer WAR wait\n+            # already queued on batch_decomp_stream.  The compressor therefore\n+            # records _kv_decode_begin on the consumer stream after every wait\n+            # and immediately before the codec launch.  H2D remains measured by\n+            # _kv_h2d_begin .. _kv_dec_h2d and is attributed to KVLoad.\n             _kc = getattr(self, \"kv_compressor\", None)\n             h2d_b = getattr(_kc, \"_kv_h2d_begin\", None)\n             h2d_e = getattr(_kc, 