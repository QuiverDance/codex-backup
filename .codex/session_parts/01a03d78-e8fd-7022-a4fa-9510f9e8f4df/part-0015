rd_event)\n        except RuntimeError:\n            torch.cuda.synchronize()\n            total_time = self.begin_forward_event.elapsed_time(\n                self.end_forward_event)\n        idx_to_weight_name = [\n            \"self_attn.qkv_proj.weight\", \"self_attn.o_proj.weight\",\n            \"mlp.gate_up_proj.weight\", \"mlp.down_proj.weight\"\n        ]\n\n        init_event = self.begin_forward_event\n        use_weight_comp = DualMemoryLoader.use_weight_comp\n        load_comp_weight = DualMemoryLoader.load_comp_weight\n        use_kv_comp = DualMemoryLoader.use_kv_comp\n\n        # ── Compute intervals ──\n        # The V1 wrapper records begin_exec/end_exec around every graph piece\n        # for BOTH prefill and decode.  These are the source of truth: module\n        # hooks are baked out of captured/compiled pieces, so their per-kernel\n        # events can remain stale during mixed prefill and previously produced\n        # overlapping intervals whose raw sum exceeded GPUFwd.\n        llm_intervals = self._calc_intervals(\n            init_event, self.begin_exec_events, self.end_exec_events)\n        if llm_intervals:\n            llm_intervals = self._calc_exec_times(llm_intervals, [])\n        elif self.batch_has_prefill:\n            # V0 fallback: eager module hooks still provide kernel intervals.\n            # Merge their union before summing because nested/duplicate hooks\n            # are legal and must never count the same GPU time twice.\n            kernel_intervals = self._calc_intervals(\n                init_event, self.begin_kernel_events, self.end_kernel_events)\n            if kernel_intervals:\n                total_end = init_event.elapsed_time(self.end_forward_event)\n                first_start = min(total_end, kernel_intervals[0][0])\n                last_end = min(\n                    total_end, max(e for _, e in kernel_intervals))\n                if first_start > 0.001:\n                    kernel_intervals.append((0.0, first_start))\n                if total_end > last_end + 0.001:\n                    kernel_intervals.append((last_end, total_end))\n                llm_intervals = self._calc_exec_times(kernel_intervals, [])\n        llm_time = sum(e - b for b, e in llm_intervals)\n\n        # ── Weight decompression intervals (only when compressed) ──\n        weight_decomp_time = 0.0\n        overlap_time = 0.0\n        weight_decomp_intervals = []\n        if use_weight_comp and load_comp_weight:\n            # Include all not-frozen layers' decomp events.\n            # Stale events (from layers that didn't actually decompress)\n            # are filtered by the begin_time / duration checks below.\n            weight_decomp_intervals = self._calc_intervals(\n                init_event,\n                [e for i, e in enumerate(self.begin_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n                [e for i, e in enumerate(self.end_decomp_events)\n                 if (i // 4) in self.not_frozen_layers],\n            )\n            weight_decomp_time = sum(\n                e - b for b, e in weight_decomp_intervals)\n            overlap_time = self._calculate_total_overlap(\n                llm_intervals, weight_decomp_intervals)\n\n        # ── KV comp / decomp (only when KV compression enabled) ──\n        kv_comp_time = 0.0\n        kv_decomp_time = 0.0\n        # Compressed-KV H2D split out of decomp and folded into KVLoad below\n        # (directly summed with the load_kv_stream copies, no overlap accounting).\n        kv_comp_h2d_time = 0.0\n        kv_h2d_intervals: List[Tuple[float, float]] = []\n        if use_kv_comp:\n            kv_comp_intervals = self._calc_intervals(\n                init_event,\n                self.begin_kv_comp_events,\n                self.end_kv_comp_events)\n            kv_comp_time = sum((e - b) for b, e in kv_comp_intervals)\n\n            # KVDecomp must be the DECODE KERNEL only.  The loader's interval\n       