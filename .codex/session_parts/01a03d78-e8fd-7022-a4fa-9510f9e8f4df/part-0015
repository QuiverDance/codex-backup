arries ``max_query_len`` (==1 for a pure\n    decode batch, >1 when any request contributes more than one query\n    token, i.e. a prefill / chunked-prefill chunk).  ``fctx.attn_metadata``\n    is a dict[layer_name -> metadata] (or a list of such dicts for\n    multiple KV-cache groups); any layer's metadata carries the same\n    max_query_len, so we read the first available one.  Returns ``default``\n    when metadata is missing (e.g. profiling/warmup) so callers can fall\n    back to the cudagraph-mode heuristic.\n    \"\"\"\n    am = getattr(fctx, \"attn_metadata\", None)\n    if am is None:\n        return default\n    if isinstance(am, (list, tuple)):\n        am = am[0] if am else None\n    if isinstance(am, dict):\n        am = next(iter(am.values()), None)\n    mql = getattr(am, \"max_query_len\", None)\n    if mql is None:\n        return default\n    return mql > 1\n\n\ndef _num_batch_tokens(fctx, default: int = 1) -> int:\n    \"\"\"Return the current batch's total token count (``num_actual_tokens``),\n    or ``default`` when attn_metadata is unavailable. Mirrors\n    :func:`_batch_has_prefill`'s metadata traversal. Falls back to the last\n    ``query_start_loc`` entry when ``num_actual_tokens`` is absent.\"\"\"\n    am = getattr(fctx, \"attn_metadata\", None)\n    if am is None:\n        return default\n    if isinstance(am, (list, tuple)):\n        am = am[0] if am else None\n    if isinstance(am, dict):\n        am = next(iter(am.values()), None)\n    n = getattr(am, \"num_actual_tokens\", None)\n    if n is not None:\n        return int(n)\n    qsl = getattr(am, \"query_start_loc\", None)\n    if qsl is not None and len(qsl) > 0:\n        return int(qsl[-1])\n    return default\n\n\ndef _attn_metadata(fctx):\n    \"\"\"Return a single AttentionMetadata from the forward context, mirroring\n    the dict/list traversal of :func:`_batch_has_prefill`.  ``None`` when\n    unavailable (profiling / warmup).\"\"\"\n    am = getattr(fctx, \"attn_metadata\", None)\n    if am is None:\n        return None\n    if isinstance(am, (list, tuple)):\n        am = am[0] if am else None\n    if isinstance(am, dict):\n        am = next(iter(am.values()), None)\n    return am\n\n\ndef _kv_block_valid_tokens(fctx, num_dedicated: int, num_primary,\n                           block_size: int) -> dict:\n    \"\"\"Map offload ``buffer_id -> valid (written) token count`` for the *tail*\n    (partial) block of each scheduled request, from vLLM ``attn_metadata``.\n\n    Only tail blocks can be partial — every earlier block of a sequence is\n    full (``block_size`` tokens) and is left out of the map (the compressor\n    defaults missing ids to full).  vLLM's ``on_tail_block`` callback offloads\n    exactly these tail blocks every step, so this is the set the P4Flat\n    occupancy encoder benefits from.\n\n    Returns ``{}`` on any failure so the caller transparently falls back to\ndef before_model_forward(self, input):\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\n    from tiered_serve.kv_cache import vLLMKVCache\n\n    dm_loader: DualMemoryLoader = getattr(self, \"cache_loader\", None)\n    if torch.cuda.is_current_stream_capturing():\n        return\n    if dm_loader.is_profiling or dm_loader.is_graph_warming_up:\n        return\n    torch.cuda.nvtx.range_push(\"BEFORE_MODEL_FORWARD\")\n    dm_loader.did_skip = False\n    dm_loader.prefill_kv_comp_load_layers = 0\n    dm_loader._raw_prefill_end_joined = False\n    # Clear the per-forward idempotency flag so calc_times runs once\n    # for this forward (either from v1_cuda_graph_wrapper's\n    # _do_after_model_forward or from after_model_forward, whichever\n    # fires first — typically the wrapper).\n    dm_loader._calc_times_done = False\n    # Reset foreground ZipServ join counters exactly once per model forward.\n    # Layer-0 resets are unsafe because unload(0) can run after decode(0) and\n    # erase a real wait from the same step.\n    _kv_compressor = getattr(dm_loader, \"kv_compressor\", None)\n    if (_kv_compressor is not None\n            and getattr(_kv_compressor, \"_cpu_profile_enabled\", False)):\n        _kv_compressor.reset_cpu_profile_step()\n\n    # V1: plain forward (no CUDA graph) means prefill\n    from vllm.forward_context import get_forward_context\n    fctx = get_forward_context()\n    if hasattr(fctx, 'cudagraph_runtime_mode'):\n        from vllm.config import CUDAGraphMode\n        from tiered_serve.dual_memory_loader import DualMemoryLoader as _DML\n        # ran_eager: did THIS forward run eager (no CUDA graph)?  Used ONLY\n        # to choose which stream the forward-timing events get recorded on\n        # (eager => current/exec_stream, graph => replay_stream).  This is a\n        # stream/execution property, NOT a prefill signal.\n        _DML.ran_eager = (\n            fctx.cudagraph_runtime_mode == CUDAGraphMode.NONE)\n        # batch_has_prefill: does the batch contain ANY prefill chunk\n        # (attn_metadata.max_query_len > 1)?  Single source of truth for\n        # every prefill-vs-decode decision (weight path, KV path, breakdown\n        # labels).  Unlike ran_eager it is True even for a prefill chunk\n        # running under a PIECEWISE graph.  Falls back to ran_eager when\n        # attn_metadata is unavailable (profiling/warmup).\n        _DML.batch_has_prefill = _batch_has_prefill(\n            fctx, default=_DML.ran_eager)\n        # Batch token count — drives the prefill weight-codec choice.\n        _DML.cur_num_tokens = _num_batch_tokens(fctx, default=1)\n        # load_comp_weight: load compressed weights (decode) vs the\n        # uncompressed DRAM copy (prefill).  The V0 path set this in\n        # vllm/core/scheduler.py (patches/vllm.patch) from the token budget;\n        # that scheduler never runs under V1, so without this the flag stayed\n        # pinned at its init value (== use_weight_comp) and prefill always took\n        # the compressed path — the uncompressed weight load was never\n        # triggered.  Re-derive it here from the V1-native prefill signal:\n        # compress only on pure-decode batches, load uncompressed whenever the\n        # batch contains any prefill chunk.\n        _DML.load_comp_weight = (\n            _DML.use_weight_comp and not _DML.batch_has_prefill)\n\n    # Save the original stream so after_model_forward can restore it.\n    # exec_stream must wait for pending work on the current stream\n    # (e.g. input preparation) before we switch.\n    dm_loader._prev_stream = torch.cuda.current_stream()\n    dm_loader.exec_stream.wait_stream(dm_loader._prev_stream)\n    torch.cuda.set_stream(dm_loader.exec_stream)\n\n    if dm_loader.ran_eager:\n        dm_loader.begin_forward_event.record()\n    else:\n        dm_loader.begin_forward_event.record(dm_loader.replay_stream)\n\n    # TODO: Make funct on DualMemoryLoader\n    dm_loader.kv_buffer_ids = []\n    num_primary = (\n        DualMemoryLoader.primary_k_caches[0].shape[0]\n        dm_loader._raw_prefill_end_joined = True\n    if dm_loader.ran_eager:\n        dm_loader.end_forward_event.record()\n    else:\n        dm_loader.end_forward_event.record(dm_loader.replay_stream)\n\n    # Restore the original stream so that subsequent vLLM code\n    # (e.g. _update_states, scheduler) runs on the expected stream.\n    prev = getattr(dm_loader, '_prev_stream', None)\n    if prev is not None:\n        prev.wait_stream(dm_loader.exec_stream)\n        torch.cuda.set_stream(prev)\n        dm_loader._prev_stream = None\n\n    if getattr(dm_loader, \"collect_times\", False):\n        torch.cuda.current_stream().synchronize()\n        dm_loader.load_weight_stream.synchronize()\n        dm_loader.load_kv_stream.synchronize()\n        if dm_loader.raw_load_kv_stream is not dm_loader.load_kv_stream:\n            dm_loader.raw_load_kv_stream.synchronize()\n        dm_loader.calc_times(0)\n\n\ndef before_exec_decoder(self, input):\n    dm_loader: \"DualMemoryLoader\" = self.cache_loader\n    kv_cache: vLLMKVCache = self.ts_kv_cache\n    is_capturing = dm_loader.is_graph_capturing or torch.cuda.is_current_stream_capturing()\n    record_fn = torch.cuda.Event.record  # external=True events auto-handle graph capture\n    wait_fn = torch.cuda.Stream.wait_event  # external=True events auto-handle graph capture\n\n    if is_capturing:\n        return\n\n    record_fn(dm_loader.begin_exec_events[kv_cache.layer_id],\n              torch.cuda.current_stream())\n\n                and dm._prefill_uses_dedicated_raw_kv_stream()):\n            # Prefill pipelines L+1 and can leave the wraparound KV0 H2D after\n            # the last attention piece. Make later block free/reuse and the\n            # next forward depend on that read without a CPU synchronize.\n            cur = torch.cuda.current_stream(_cuda_device())\n            TieredServeCUDAGraphWrapper._cached_stream_wait(\n                dm, cur, raw_load_kv_stream, \"afm_raw_load_kv\")\n            dm._raw_prefill_end_joined = True\n        dm.end_forward_event.record()\n\n        if getattr(dm, \"collect_times\", False):\n            # Synchronize to ensure all events across all streams are\n            # recorded before reading elapsed_time.  Prefill-alt and decode\n            # record reconstruct events on decomp_weight_stream, while raw\n            # prefill and compressed staging record readiness on load streams.\n            # Missing any participating stream makes the first timed step race\n            # CPU vs GPU and raises\n            # \"Both events must be completed before calculating elapsed\n            # time.\"  unload_kv_stream sits in the same boat.\n            torch.cuda.current_stream(_cuda_device()).synchronize()\n            dm.load_weight_stream.synchronize()\n            dm.decomp_weight_stream.synchronize()\n            dm.load_kv_stream.synchronize()\n            if dm.raw_load_kv_stream is not dm.load_kv_stream:\n                dm.raw_load_kv_stream.synchronize(