s: float\n    std_e2el_ms: float\n    percentiles_e2el_ms: list[tuple[float, float]]\n    # Max output tokens per second and concurrent requests at that peak\n    max_output_tokens_per_s: float\n    max_concurrent_requests: int\n\n\n@dataclass\nclass EmbedBenchmarkMetrics:\n    completed: int\n    failed: int\n    total_input: int\n    request_throughput: float\n    total_token_throughput: float\n    mean_e2el_ms: float\n    std_e2el_ms: float\n    median_e2el_ms: float\n    percentiles_e2el_ms: float\n\n            total_input += outputs[i].prompt_len\n        else:\n            failed += 1\n\n    if completed == 0:\n        warnings.warn(\n            \"All requests failed. This is likely due to a misconfiguration \"\n            \"on the benchmark arguments.\",\n            stacklevel=2,\n        )\n    metrics = EmbedBenchmarkMetrics(\n        completed=completed,\n        failed=failed,\n        total_input=total_input,\n        request_throughput=completed / dur_s,\n        total_token_throughput=total_input / dur_s,\n        mean_e2el_ms=np.mean(e2els or 0) * 1000,\n        std_e2el_ms=np.std(e2els or 0) * 1000,\n        median_e2el_ms=np.median(e2els or 0) * 1000,\n        percentiles_e2el_ms=[\n            (p, np.percentile(e2els or 0, p) * 1000) for p in selected_percentiles\n        ],\n    )\n    return metrics\n\n\ndef calculate_metrics(\n    input_requests: list[SampleRequest],\n    outputs: list[RequestFuncOutput],\n    dur_s: float,\n    tokenizer: TokenizerLike,\n    selected_percentiles: list[float],\n    goodput_config_dict: dict[str, float],\n    skip_first_n: int = 0,\n    skip_last_n: int = 0,\n) -> tuple[BenchmarkMetrics, list[int]]:\n    \"\"\"Calculate the metrics for the benchmark.\n\n    Args:\n        input_requests: The input requests.\n        outputs: The outputs of the requests.\n        dur_s: The duration of the benchmark.\n        tokenizer: The tokenizer to use.\n        selected_percentiles: The percentiles to select.\n        goodput_config_dict: The goodput configuration.\n        skip_first_n: Number of leading requests (in send order) to exclude\n            from the aggregated metrics (warmup).\n        skip_last_n: Number of trailing requests (in send order) to exclude\n            from the aggregated metrics (cooldown).\n\n    Returns:\n        A tuple of the benchmark metrics and the actual output lengths.\n    \"\"\"\n    n = len(outputs)\n    # Warmup/cooldown trim: only requests whose send-order index falls in\n    # [window_lo, window_hi) are counted toward the aggregated metrics. The\n    # per-request detail (``actual_output_lens`` and ``outputs[i].tpot``) is\n    # still populated for every request so detailed dumps stay aligned.\n    window_lo = max(0, skip_first_n)\n    window_hi = n - max(0, skip_last_n)\n    if window_hi <= window_lo:\n        # Degenerate window (would skip everything) — disable trimming.\n        window_lo, window_hi = 0, n\n\n    actual_output_lens: list[int] = []\n    total_input = 0\n    total_output = 0\n    completed = 0\n    good_completed = 0\n    itls: list[float] = []\n    tpots: list[float] = []\n    all_tpots: list[float] = []\n    ttfts: list[float] = []\n    e2els: list[float] = []\n    for i in range(len(outputs)):\n        in_window = window_lo <= i < window_hi\n        if outputs[i].success:\n            output_len = outputs[i].output_tokens\n\n            if not output_len:\n                # We use the tokenizer to count the number of output tokens\n                # for some serving backends instead of looking at\n                # len(outputs[i].itl) since multiple output tokens may be\n                # bundled together\n                # Note : this may inflate the output token count slightly\n                output_len = len(\n                    tokenizer(\n                        outputs[i].generated_text, add_special_tokens=False\n                    ).input_ids\n                )\n            actual_output_lens.append(output_len)\n            tpot = 0\n            if output_len > 1:\n                latency_minus_ttft = outputs[i].latency - outputs[i].ttft\n                tpot = latency_minus_ttft / (output_len - 1)\n            outputs[i].tpot = tpot\n            if in_window:\n                total_input += input_requests[i].prompt_len\n                total_output += output_len\n                if output_len > 1:\n                    tpots.append(tpot)\n                # Note: if output_len <= 1, we regard tpot as 0 for goodput\n                all_tpots.append(tpot)\n                itls += outputs[i].itl\n                ttfts.append(outputs[i].ttft)\n                e2els.append(outputs[i].latency)\n                completed += 1\n        else:\n            actual_output_lens.append(0)\n\n    if goodput_config_dict:\n        valid_metrics = []\n        slo_values = []\n\n        if \"ttft\" in goodput_config_dict:\n            valid_metrics.append(ttfts)\n            slo_values.append(\n                goodput_config_dict[\"ttft\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n        if \"tpot\" in goodput_config_dict:\n            valid_metrics.append(all_tpots)\n            slo_values.append(\n                goodput_config_dict[\"tpot\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n        if \"e2el\" in goodput_config_dict:\n            valid_metrics.append(e2els)\n            slo_values.append(\n                goodput_config_dict[\"e2el\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n\n        for req_metric in zip(*valid_metrics):\n            is_good_req = all([s >= r for s, r in zip(slo_values, req_metric)])\n            if is_good_req:\n                good_completed += 1\n\n    if completed == 0:\n        warnings.warn(\n            \"All requests failed. This is likely due to a misconfiguration \"\n            \"on the benchmark arguments.\",\n            stacklevel=2,\n        )\n\n    # Calculate max output tokens per second metric\n    max_output_tokens_per_s = 0.0\n    max_concurrent_requests = 0\n\n    # Find the time range across the windowed successful requests. Warmup /\n    # cooldown requests outside [window_lo, window_hi) are excluded so the\n    # throughput and peak-rate metrics reflect steady state only.\n    successful_outputs = [\n        outputs[i]\n        for i in range(n)\n        if outputs[i].success and window_lo <= i < window_hi\n    ]\n    failed_outputs = [\n        outputs[i]\n        for i in range(n)\n        if (not outputs[i].success) and window_lo <= i < window_hi\n    ]\n    # When trimming is active, measure throughput over the wall-clock span of\n    # the windowed requests rather than the full benchmark duration.\n    throughput_dur_s = dur_s\n    if (window_lo, window_hi) != (0, n) and successful_outputs:\n        win_start = min(output.start_time for output in successful_outputs)\n        win_end = max(\n            output.start_time + output.latency for output in successful_outputs\n        )\n        throughput_dur_s = max(win_end - win_start, 1e-9)\n    if successful_outputs:\n        min_start_time = min(output.start_time for output in successful_outputs)\n        max_end_time = max(\n            output.start_time + output.latency for output in successful_outputs\n        )\n\n        # Create second buckets (ceiling to ensure we capture all time)\n        duration_seconds = int(np.ceil(max_end_time - min_start_time)) + 1\n        tokens_per_second = np.zeros(duration_seconds)\n        concurrent_requests_per_second = np.zeros(duration_seconds)\n\n        for i, output in enumerate(successful_outputs):\n            # Calculate token generation timestamp using\n            # start_time, ttft, and itl\n            token_times = [output.start_time + output.ttft]\n            current_time = token_times[0]\n            for itl_value in output.itl:\n                current_time += itl_value\n                token_times.append(current_time)\n\n            # Add tokens to second buckets\n            for token_time in token_times:\n                second_bucket = int(token_time - min_start_time)\n                if 0 <= second_bucket < duration_seconds:\n                    tokens_per_second[second_bucket] += 1\n\n            # Track concurrent requests for each second this request was active\n            request_start_second = int(output.start_time - min_start_time)\n            request_end_second = int(\n                (output.start_time + output.latency) - min_start_time\n            )\n\n            for second in range(request_start_second, request_end_second + 1):\n                concurrent_requests_per_second[second] += 1\n\n        # Find the maximum tokens per second and corresponding\n        # concurrent requests\n        if len(tokens_per_second) > 0:\n            max_output_tokens_per_s = float(np.max(tokens_per_second))\n            max_concurrent_requests = int(np.max(concurrent_requests_per_second))\n\n        if TERM_PLOTLIB_AVAILABLE:\n            import termplotlib as tpl\n\n            fig = tpl.figure()\n            fig.plot(\n                np.arange(len(tokens_per_second)),\n                tokens_per_second,\n                title=\"Output tokens per second\",\n            )\n            fig.plot(\n                np.arange(len(concurrent_requests_per_second)),\n                concurrent_requests_per_second,\n                title=\"Concurrent requests per second\",\n            )\n            fig.show()\n        else:\n            print(\"tip: install termplotlib and gnuplot to plot the metrics\")\n\n    metrics = BenchmarkMetrics(\n        completed=completed,\n        failed=len(failed_outputs),\n        total_input=total_input,\n        total_output=total_output,\n        request_throughput=completed / throughput_dur_s,\n        request_goodput=good_completed / throughput_dur_s,\n        output_throughput=total_output / throughput_dur_s,\n        total_token_throughput=(total_input + total_output) / throughput_dur_s,\n        mean_ttft_ms=np.mean(ttfts or 0)\n        * 1000,  # ttfts is empty if streaming is not supported by the endpoint\n        std_ttft_ms=np.std(ttfts or 0) * 1000,\n        median_ttft_ms=np.median(ttfts or 0) * 1000,\n        percentiles_ttft_ms=[\n            (p, np.percentile(ttfts or 0, p) * 1000) for p in selected_percentiles\n        ],\n        mean_tpot_ms=np.mean(tpots or 0) * 1000,\n        std_tpot_ms=np.std(tpots or 0) * 1000,\n        median_tpot_ms=np.median(tpots or 0) * 1000,\n        percentiles_tpot_ms=[\n            (p, np.percentile(tpots or 0, p) * 1000) for p in selected_percentiles\n        ],\n        mean_itl_ms=np.mean(itls or 0) * 1000,\n        std_itl_ms=np.std(itls or 0) * 1000,\n        median_itl_ms=np.median(itls or 0) * 1000,\n        percentiles_itl_ms=[\n            (p, np.percentile(itls or 0, p) * 1000) for p in selected_percentiles\n        ],\n        mean_e2el_ms=np.mean(e2els or 0) * 1000,\n        std_e2el_ms=np.std(e2els or 0) * 1000,\n        median_e2el_ms=np.median(e2els or 0) * 1000,\n        percentiles_e2el_ms=[\n            (p, np.percentile(e2els or 0, p) * 1000) for p in selected_percentiles\n        ],\n                itl_p50 = float(np.percentile(itl_arr, 50))\n                itl_p90 = float(np.percentile(itl_arr, 90))\n                itl_p95 = float(np.percentile(itl_arr, 95))\n                itl_p99 = float(np.percentile(itl_arr, 99))\n            else:\n                itl_p50 = itl_p90 = itl_p95 = itl_p99 = 0.0\n            f.write(\n                f\"{i:<6} {str(o.success):<9} {o.prompt_len:<12} \"\n                f\"{o.output_tokens:<15} {o.ttft * 1000:<12.2f} \"\n                f\"{o.tpot * 1000:<12.2f} {itl_p50:<12.2f} \"\n                f\"{itl_p90:<12.2f} {itl_p95:<12.2f} \"\n                f\"{itl_p99:<12.2f} {o.latency * 1000:<12.2f}\\n\"\n            )\n        f.write(f\"{'=' * 70}\\n\\n\")\n\n    # --- Append one row to the cumulative CSV summary ---\n    csv_path = os.path.join(log_dir, \"summary.csv\")\n    TTFT_SLO_MS = 2000.0\n    TPOT_SLO_200_MS = 200.0\n    TPOT_SLO_250_MS = 250.0\n\n    def _pcts(data: list[float]) -> tuple[float, float, float, float]:\n        if not data:\n            return (0.0, 0.0, 0.0, 0.0)\n        arr = np.array(data)\n        return (\n            float(np.percentile(arr, 50)),\n            float(np.percentile(arr, 90)),\n            float(np.percentile(arr, 95)),\n            float(np.percentile(arr, 99)),\n        )\n\n    ttft_p50, ttft_p90, ttft_p95, ttft_p99 = _pcts(ttfts_ms)\n    tpot_p50, tpot_p90, tpot_p95, tpot_p99 = _pcts(tpots_ms)\n    itl_p50, itl_p90, itl_p95, itl_p99 = _pcts(itls_ms)\n    e2el_p50, e2el_p90, e2el_p95, e2el_p99 = _pcts(e2els_ms)\n\n    n_total = len(successful)\n    prefill_att = (\n        sum(1 for t in ttfts_ms if t <= TTFT_SLO_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_200_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_200_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    decode_250_att = (\n        sum(1 for t in tpots_ms if t <= TPOT_SLO_250_MS) / n_total * 100\n        if n_total else 0.0\n    )\n    # Request-level attainment: a request is counted only if it meets BOTH the\n    # prefill (TTFT) and decode (TPOT) SLOs.\n    def _meets_slo(o: RequestFuncOutput, tpot_slo_ms: float) -> bool:\n        return o.ttft * 1000 <= TTFT_SLO_MS and o.tpot * 1000 <= tpot_slo_ms\n\n    request_200_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_200_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    request_250_att = (\n        sum(1 for o in successful if _meets_slo(o, TPOT_SLO_250_MS)) / n_total * 100\n        if n_total else 0.0\n    )\n    # Server-side batch statistics over this benchmark window: parse the\n    # scheduler's per-step \"Schedule Info\" lines from server.log and split them\n    # into prefill-containing vs decode-only batches.\n    window_end = datetime.now()\n    window_start = window_end - timedelta(seconds=benchmark_duration)\n    batch_stats = _server_batch_stats(log_dir, window_start, window_end)\n    if batch_stats is not None:\n        bs = batch_stats\n        batch_cols = (\n            f\"{bs['n_batches']} \"\n            f\"{bs['prefill_pct']:.2f} {bs['decode_pct']:.2f} \"\n            f\"{bs['sz_avg']:.2f} {bs['sz_p50']:.2f} \"\n            f\"{bs['sz_p90']:.2f} {bs['sz_max']:.0f}\"\n        )\n    else:\n        batch_cols = \"NA NA NA NA NA NA NA\"\n\n    csv_header = (\n        \"request_rate \"\n        \"ttft_p50 ttft_p90 ttft_p95 ttft_p99 \"\n        \"tpot_p50 tpot_p90 tpot_p95 tpot_p99 \"\n        \"itl_p50 itl_p90 itl_p95 itl_p99 \"\n        \"e2el_p50 e2el_p90 e2el_p95 e2el_p99 \"\n        \"prefill_att(%) decode_200_att(%) decode_250_att(%) \"\n        \"request_200_att(%) request_250_att(%) \"\n        \"n_batches prefill_batch(%) decode_batch(%) \"\n        \"batch_sz_avg batch_sz_p50 batch_sz_p90 batch_sz_max\"\n    )\n    write_header = not os.path.exists(csv_path)\n    with open(csv_path, \"a\") as cf:\n        if write_header:\n            cf.write(csv_header + \"\\n\")\n        cf.write(\n            f\"{request_rate} \"\n            f\"{ttft_p50:.2f} {ttft_p90:.2f} {ttft_p95:.2f} {ttft_p99:.2f} \"\n            f\"{tpot_p50:.2f} {tpot_p90:.2f} {tpot_p95:.2f} {tpot_p99:.2f} \"\n            f\"{itl_p50:.2f} {itl_p90:.2f} {itl_p95:.2f} {itl_p99:.2f} \"\n            f\"{e2el_p50:.2f} {e2el_p90:.2f} {e2el_p95:.2f} {e2el_p99:.2f} \"\n            f\"{prefill_att:.2f} {decode_200_att:.2f} {decode_250_att:.2f} \"\n            f\"{request_200_att:.2f} {request_250_att:.2f} \"\n            f\"{batch_cols}\\n\"\n        )\n    print(f\"Summary CSV row appended to {csv_path}\")\n\n    print(f\"Client benchmark results saved to {log_path}\")\n\n\nasync def benchmark(\n    task_type: TaskType,\n    endpoint_type: str,\n    api_url: str,\n    base_url: str,\n    model_id: str,\n    model_name: str,\n    tokenizer: TokenizerLike,\n    input_requests: list[SampleRequest],\n    logprobs: int | None,\n    request_rate: float,\n            request_func_input=profile_input, session=session\n        )\n        if profile_output.success:\n            print(\"Profiler started\")\n\n    # Start server-side logging\n    log_dir = \"\"\n    print(\"Starting server-side logging...\")\n    async with session.post(base_url + \"/start_logging\") as resp:\n        if resp.status == 200:\n            logging_resp = await resp.json()\n            log_dir = logging_resp.get('log_dir', '')\n            print(f\"Server-side logging started (engine_id={logging_resp.get('engine_id', '')})\")\n            if log_dir:\n                print(f\"Client logs will be saved to {log_dir}\")\n\n    distribution = \"Poisson process\" if burstiness == 1.0 else \"Gamma distribution\"\n\n    if ramp_up_strategy is not None:\n        print(f\"Traffic ramp-up strategy: {ramp_up_strategy}.\")\n        print(\n            f\"Will increase RPS from {ramp_up_start_rps} to \"\n            f\"{ramp_up_end_rps} RPS over the duration of the benchmark.\"\n        )\n    else:\n        print(f\"Traffic request rate: {request_rate}\")\n\n    print(f\"Burstiness factor: {burstiness} ({distribution})\")\n    print(f\"Maximum request concurrency: {max_concurrency}\")\n\n    pbar = None if disable_tqdm else tqdm(total=len(input_requests))\n\n    semaphore = (\n        asyncio.Semaphore(max_concurrency)\n        if max_concurrency\n        else contextlib.nullcontext()\n    )\n\n    # SLO attainment(누적) 설정: summary.csv 의 request_{200,250}_att 와 동일 정의.\n    # 한 요청이 \"attained\" 되려면 (TTFT <= prefill SLO) 이고 (mean TPOT <= decode SLO)\n    # 여야 한다. decode SLO 두 기준(200/250ms)을 동시에 추적한다.\n    # prefill SLO 는 TS_PREFILL_SLO_MS(기본 2000), decode SLO 는\n    # TS_GOODPUT_SLO_MS(콤마 구분, 기본 200,250) 로 바꿀 수 있다.\n    ttft_slo_ms = float(os.environ.get(\"TS_PREFILL_SLO_MS\", \"2000\"))\n    slo_ms_list = [\n        float(x) for x in os.environ.get(\"TS_GOODPUT_SLO_MS\", \"200,250\").split(\",\")\n    ]\n    # slo_stats[\"total\"] = 완료(성공+실패) 요청 수, slo_stats[slo] = attained 수\n    slo_stats = {\"total\": 0}\n    for _slo in slo_ms_list:\n        slo_stats[_slo] = 0\n\n    async def limited_request_func(request_func_input, session, pbar):\n        async with semaphore:\n            output = await request_func(\n                request_func_input=request_func_input, session=session, pbar=pbar\n            )\n            # 요청이 끝날 때마다 그 요청의 ttft/tpot 와 지금까지의 SLO attainment 출력.\n            # 분모는 완료된 모든 요청(실패 포함) — summary 의 전체 평균 정의와 일치.\n            slo_stats[\"total\"] += 1\n            if output.success:\n                out_len = output.output_tokens or request_func_input.output_len or 0\n                # mean TPOT (out_len<=1 이면 0 으로 본다; goodput 관례와 동일)\n                tpot = (\n                    (output.latency - output.ttft) / (out_len - 1)\n                    if out_len > 1\n                    else 0.0\n                )\n                ttft_ms = output.ttft * 1000.0\n                tpot_ms = tpot * 1000.0\n                prefill_ok = ttft_ms <= ttft_slo_ms\n                for slo in slo_ms_list:\n                    if prefill_ok and tpot_ms <= slo:\n                        slo_stats[slo] += 1\n\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line = (\n                    f\"[req {request_func_input.request_id}] \"\n                    f\"ttft={ttft_ms:.1f}ms \"\n                    f\"tpot={tpot_ms:.1f}ms \"\n                    f\"| {attain}\"\n                )\n            else:\n                n = slo_stats[\"total\"]\n                attain = \" | \".join(\n                    f\"slo{slo:g} att={100 * slo_stats[slo] / n:.1f}%\"\n                    for slo in slo_ms_list\n                )\n                line 