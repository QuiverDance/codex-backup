')\nTS_CONFIG=\"${2:-manual}\"\nTS_NAME=\"$(basename \"$TS_CONFIG\")\"; TS_NAME=\"${TS_NAME%.yaml}\"; TS_NAME=\"${TS_NAME%.yml}\"\nMODEL_ID=\"$(echo \"${MODEL##*/}\" | tr '[:upper:]' '[:lower:]' | tr '.-' '__')\"\nRESULT_DIR=\"${RESULT_DIR:-logs/serving/$MODEL_ID/$TS_NAME/client}\"\nmkdir -p \"$RESULT_DIR\"\necho \"Saving results to: $RESULT_DIR\"\n\n# ── request rate 결정 ────────────────────────────────────────────────\n# 3번째 이후 인자로 rate를 1개 이상 주면 스윕 대신 그 값들만 측정.\nREQUEST_RATE_ARGS=(\"${@:3}\")\nif [ \"${#REQUEST_RATE_ARGS[@]}\" -gt 0 ]; then\n  REQUEST_RATES=\"${REQUEST_RATE_ARGS[*]}\"\nelse\n  case \"$MODEL_ALIAS\" in\n    qwen72b)\n      REQUEST_RATES=$(seq 0.5 0.1 1.2)\n      ;;\n    llama70b)\n      REQUEST_RATES=$(seq 1.6 -0.2 0.6)\n      ;;\n    llama70b-fp8)\n      REQUEST_RATES=$(seq 1.6 0.2 3.0)\n      ;;\n    *)\n      REQUEST_RATES=$(seq 0.4 0.2 2.0)\n      ;;\n  esac\nfi\n\necho \"Running benchmark with MODEL: $MODEL\"\necho \"Request rates to be tested: $REQUEST_RATES\"\n\nfor rate in $REQUEST_RATES\ndo\n  echo \"-----------------------------------------\"\n  echo \"Benchmarking with request-rate: $rate\"\n  echo \"-----------------------------------------\"\n  python -m vllm.entrypoints.cli.main bench serve \\\n    --model \"$MODEL\" \\\n    --dataset-name azure_conv \\\n    --ignore-eos \\\n    --num-prompts 1200 \\\n    --skip-first-n-requests 100 \\\n    --skip-last-n-requests 100 \\\n    --metric-percentiles='90' \\\n    --request-rate \"$rate\" \\\n    --save-result \\\n    --save-detailed \\\n    --result-dir \"$RESULT_DIR\" \\\n    --result-filename \"rate_${rate}.json\" \\\n    --metadata ts_config=\"$TS_NAME\" model=\"$MODEL_ID\"\ndone\n\necho \"Benchmark finished.\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d7a-23b1-7b53-b7be-0399873d0bde","create_time":1787737870.960542}}}
