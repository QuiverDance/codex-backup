s ZipServ;\n#   # small prefill chunks decode the p4flat alt that shares HBM sign|mantissa)\n#   numactl -m 0 ./.venv/bin/python serve_offload_kvweight.py \\\n#       --model meta-llama/Llama-3.1-70B-Instruct \\\n#       --no-enable-prefix-caching --chunked-prefill \\\n#       --weight-comp zipserv --prefill-alt-comp p4flat --kv-comp \\\n#       --ts-configs even-odd\n#\n#   # Client (separate terminal)\n#   ./.venv/bin/python vllm/benchmarks/benchmark_serving.py \\\n#       --model hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4 \\\n#       --dataset-path ShareGPT_V3_unfiltered_cleaned_split.json \\\n#       --num-prompts 10\n\n\nimport argparse\nimport asyncio\nimport logging\nimport os\nimport random\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\n\n# Let checkpoint loading and torch.compile use the CPUs available to this\n# process.  Once KV buffers/workers are ready, DualMemoryLoader.init_workers()\n# shrinks the main ATen team to TIERED_SERVE_MAIN_OMP_THREADS (default 1),\n# before any serving KV encode can run.  The P4Flat encoder then uses its\n# independent TIERED_SERVE_KV_COMPRESS_OMP_THREADS team.  Keep both controls\n# dedicated so a stale generic OMP_NUM_THREADS cannot change either phase.\n_startup_omp_default = len(os.sched_getaffinity(0))\n_startup_omp_threads = max(1, int(os.getenv(\n    \"TIERED_SERVE_STARTUP_OMP_THREADS\", str(_startup_omp_default))))\nos.environ[\"OMP_NUM_THREADS\"] = str(_startup_omp_threads)\nos.environ[\"TIERED_SERVE_OMP_PHASE_SWITCH\"] = \"1\"\n\n# TODO: NEED TO FIX ORDER\nos.environ[\"TIERED_SERVE_NUM_HUGE_PAGE\"] = \"0\"\n_HUGEPAGE_NR_PATH = \"/sys/kernel/mm/hugepages/hugepages-16777216kB/nr_hugepages\"\ntry:\n    with open(_HUGEPAGE_NR_PATH, \"r\") as f:\n        os.environ[\"TIERED_SERVE_NUM_HUGE_PAGE\"] = str(int(f.read().strip()))\nexcept FileNotFoundError:\n    raise RuntimeError(\n        f\"16 GiB hugepages not configured. Expected file: {_HUGEPAGE_NR_PATH}\\n\"\n        f\"Reserve hugepages first, e.g.:\\n\"\n        f\"  echo 16 | sudo tee {_HUGEPAGE_NR_PATH}\\n\"\n        f\"  mkdir -p /mnt/hugepages\\n\"\n        f\"  sudo mount -t hugetlbfs -o pagesize=16G none /mnt/hugepages\")\n\n# TODO: Just for weight-first \n# os.environ[\"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE\"] = \"1\"\nfrom tiered_serve.immigrant_model_loader import ImmigrantModelLoader  # noqa: F401\n\nimport numpy as np\n\nimport torch\nimport torch.multiprocessing as mp\n\nfrom vllm import AsyncEngineArgs\nfrom vllm.utils.argparse_utils import FlexibleArgumentParser\nfrom vllm.entrypoints.openai.cli_args import make_arg_parser\nfrom vllm.entrypoints.openai.api_server import run_server\n\nfrom tiered_serve.module_block import resolve_ts_config\n\nif __name__ == \"__main__\":\n    mp.set_start_method(\"spawn\", force=True)\n\n    seed = 2025010215\n\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n\n    parser = FlexibleArgumentParser(\n        description=\"vLLM OpenAI-Compatible RESTful API server.\")\n    parser = make_arg_parser(parser)\n    parser.add_argument(\n        \"--max-context-len\",\n        type=int,\n        default=8192,\n        help=\n        \"Max context(input + ouput)'s length which Inference Engine can handle\",\n    )\n    parser.add_argument(\"-d\",\n                        \"--debug\",\n                        action=\"store_true\",\n                        help=\"Active Debug Log Level(+ nvtx)\")\n    _COMP_CHOICES = [\"zipserv\", \"dietgpu\",\n                     \"zipserv_bf16\", \"dietgpu_bf16\",\n                     \"zipserv_fp8\", \"dietgpu_fp8\",\n                     \"p4flat\", \"p4d16\", \"p3flat_fp8\",\n                     \"ublb_flat\"]\n    parser.add_argument(\"--weight-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Enable Weight Compression. Optional value \"\n                             \"selects backend (default: zipserv = auto \"\n                             \"BF16/FP8 based on weight dtype). Use the \"\n                             \"_bf16/_fp8 suffix to pin a specific variant.\")\n    parser.add_argument(\"--split-compressor\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Override compressor backend for the \"\n                             \"frozen_split residency mode only. Falls back \"\n                             \"to --weight-comp if not set.\")\n    parser.add_argument(\"--offload-compressor\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Override compressor backend for the \"\n                             \"offload_compressed and frozen_compressed \"\n                             \"residency modes. Falls back to --weight-comp \"\n                             \"if not set. Use together with --split-compressor \"\n                             \"to mix backends across modes.\")\n    parser.add_argument(\"--prefill-alt-comp\",\n                        nargs=\"?\",\n                        const=\"p4flat\",\n                        default=None,\n                        choices=_COMP_CHOICES,\n                        help=\"Phase-adaptive prefill codec. For prefill chunks \"\n                             \"below the per-codec threshold \"\n                             \"(TIERED_SERVE_PREFILL_ALT_MAX_CHUNK) this codec is \"\n                             \"decoded from LPDDR instead of H2D'ing raw_bf16, \"\n                             \"while DECODE keeps the --split-compressor codec. \"\n                             \"'p4flat' (the no-value default) is the supported \"\n                             \"DISTINCT fast-decode alt: it shares the HBM \"\n                             \"sign|mantissa with a zipserv primary \"\n                             \"(canonical-sm), so e.g. `--weight-comp zipserv \"\n                             \"--prefill-alt-comp` = zipserv decode + p4flat \"\n                             \"prefill. Naming the SAME codec as the primary \"\n                             \"gives the unified path (reuse primary buffers, no \"\n                             \"extra copy). Sets TIERED_SERVE_PREFILL_ALT_BACKEND.\")\n    parser.add_argument(\"--prefill-alt-max-chunk\",\n                        default=None,\n                        metavar=\"N|MAP\",\n                        help=\"Override the prefill-alt chunk threshold: a single \"\n                             \"int (one threshold for every codec) or a per-codec \"\n                             \"map 'p4flat=1330,zipserv=830,...'. Unset uses the \"\n                             \"calibrated built-in per-codec defaults \"\n                             \"(see runs/bench_prefill_alt_crossover.py). Sets \"\n                             \"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK.\")\n    parser.add_argument(\"--offload-prefill-max-chunk\",\n                        default=None,\n                        metavar=\"N|MAP\",\n                        help=\"Phase-adaptive prefill for OFFLOAD_COMPRESSED \"\n                             \"weights (distinct from --prefill-alt-*, which is \"\n                             \"frozen_split). Prefill chunks below this threshold \"\n                             \"decode the compressed LPDDR copy (less H2D) \"\n                             \"instead of H2D'ing the uncompressed one; larger \"\n                             \"chunks keep uncompressed. Single int or per-codec \"\n                             \"map 'zipserv=600,...'. Lossless codecs only; OFF by \"\n                             \"default. Sets TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK.\")\n    parser.add_argument(\"--fused-mm\",\n                        action=\"store_true\",\n                        help=\"Request the weight compressor's \"\n                             \"decompress+GEMM execution path. An override is \"\n                             \"installed only for compressor/residency pairs \"\n                             \"that support it; other cells keep dense \"\n                             \"decompress+matmul. P4Flat frozen_compressed and \"\n                             \"frozen_split install overrides, while P4Flat \"\n                             \"offload_compressed keeps the dense path. This \"\n                             \"flag does not enable weight compression.\")\n    parser.add_argument(\"--ats-decomp-frozen\",\n                        action=\"store_true\",\n                        help=\"frozen_split decode reads compressed bytes \"\n                             \"directly from LPDDR via host-mapped UVA, \"\n                             \"skipping the H2D copy into GPU staging. \"\n                             \"Recommended on GH200.\")\n    parser.add_argument(\"--ats-decomp-offload\",\n                        action=\"store_true\",\n                        help=\"offload_compressed load+decompress reads \"\n                             \"compressed bytes directly from LPDDR via \"\n                             \"host-mapped UVA, skipping the H2D copy \"\n                             \"into GPU staging. Recommended on GH200.\")\n    parser.add_argument(\"--kv-comp\",\n                        nargs=\"?\",\n                        const=\"zipserv\",\n                        default=None,\n                        choices=[\"zipserv\", \"dietgpu\", \"mantexp\", \"p4flat\",\n                                 \"p4flatcpu\", \"ublb_flat\", \"ublb_tbe\"],\n                        help=\"Enable KV Compression. Optional value selects \"\n                             \"backend (default: zipserv when flag is given \"\n                             \"without value). 'zipserv' uses the accelerated \"\n                             \"C++ CPU worker pool after raw KV is swapped to \"\n                             \"host memory. 'mantexp' selects the \"\n                             \"sign+mantissa / compressed-exponent split \"\n                             \"backend (equivalent to --mantexp-split-kv). \"\n                             \"'p4flat' selects the BF16 P4-flat per-tile \"\n                             \"exponent-palette codec (GPU encode by default). \"\n                             \"'p4flatcpu' is the same codec with the C++ \"\n                             \"OpenMP CPU host encoder (cpu_after_raw_swap). \"\n                             \"'ublb_flat'/'ublb_tbe' are the UB/LB-split codecs \"\n                             \"(P4Flat-based, CPU encode + GPU batched decode): \"\n                             \"ublb_flat = fastest enc+dec (ratio 1.33), \"\n                             \"ublb_tbe = best ratio ~1.38.\")\n    parser.add_argument(\"--collect-time\",\n                        action=\"store_true\",\n                        help=\"Collect Time data\")\n    parser.add_argument(\"--chunked-prefill\",\n                        default=True,\n                        action=argparse.BooleanOptionalAction,\n                        help=\"Compatibility flag; this serving driver always \"\n                             \"enables chunked prefill\")\n    parser.add_argument(\n        \"--reduce-kv-footprint\",\n        action=\"store_true\",\n        help=\"Disable KV offloading; allocate all KV blocks as dedicated GPU \"\n             \"blocks (sets TIERED_SERVE_REDUCE_KV_FOOTPRINT=1).\")\n    parser.add_argument(\n        \"--no-offload-kv\",\n        action=\"store_true\",\n        help=\"Keep the entire KV cache resident in GPU HBM: no LPDDR \"\n             \"offload and no KV compression (weights are still offloaded). \"\n             \"Unlike --reduce-kv-footprint there is no per-step \"\n             \"secondary<->primary self-copy. Sets \"\n             \"TIERED_SERVE_NO_OFFLOAD_KV=1.\")\n    parser.add_argument(\n        \"--mantexp-split\",\n        action=\"store_true\",\n        help=\"Shortcut: enable mantissa/exponent split storage for BOTH \"\n             \"weights and KV. Equivalent to passing both \"\n             \"--mantexp-split-weight and --mantexp-split-kv.\")\n    parser.add_argument(\n        \"--mantexp-split-weight\",\n        action=\"store_true\",\n        help=\"Enable sign+mantissa (HBM) / compressed-exponent (LPDDR) \"\n             \"split storage for WEIGHTS only. Forces \"\n             \"--weight-comp=dietgpu_bf16.\")\n    parser.add_argument(\n        \"--mantexp-split-kv\",\n        action=\"store_true\",\n        help=\"Enable sign+mantissa (HBM) / compressed-exponent (LPDDR) \"\n             \"split storage for KV only. Forces --kv-comp=mantexp.\")\n    parser.add_argument(\n        \"--mantexp-kv-codec\",\n        default=None,\n        choices=[\"raw\", \"dietgpu\", \"nvcomp_ans\", \"nvcomp_bitcomp\",\n                 \"zipserv\"],\n        help=\"Exponent-stream codec for split-KV path. Default: dietgpu. \"\n             \"'zipserv' is rejected at runtime (ZipServ is itself a BF16 \"\n             \"split codec; pair with --kv-comp zipserv WITHOUT \"\n             \"--mantexp-split-kv instead). Sets TIERED_SERVE_KV_MANT_CODEC.\")\n    parser.add_argument(\n        \"--hbm-limit\",\n        type=float,\n        default=None,\n        metavar=\"GiB\",\n        help=\"Simulate reduced HBM by capping usable GPU memory to this \"\n             \"many GiB (e.g. 48 to mimic an H100-class GPU).\")\n    parser.add_argument(\n        \"--ts-configs\",\n        type=str,\n        nargs=\"+\",\n        required=True,\n        metavar=\"YAML\",\n        help=\"One or more module_block_config YAML paths. \"\n             \"The first is used as the primary config.\",\n    )\n\n    args = parser.parse_args()\n    # Keep the serving scheduler/KV topology deterministic.  Normalize both\n    # policies even when a caller passes their opposite CLI flags.\n    args.enable_prefix_caching = False\n    args.chunked_prefill = True\n\n    args.ts_configs = [resolve_ts_config(c, args.model) for c in args.ts_configs]\n\n    context_len = args.max_context_len\n    model_id = args.model.split('/')[-1].lower().replace('-', '_').replace('.', '_')\n    ts_config_name = Path(args.ts_configs[0]).stem\n    log_level = logging.DEBUG if args.debug else logging.INFO\n\n    os.environ[\"TIERED_SERVE_PRIMARY_DEVICE\"] = \"cuda:0\"\n    os.environ[\"TIERED_SERVE_SECONDARY_DEVICE\"] = \"cpu\"\n\n    os.environ[\"TIERED_SERVE_OFFLOAD_TYPE\"] = \"KVWeight\"\n\n    os.environ[\"TIERED_SERVE_MODEL_ID\"] = model_id\n    os.environ[\"TIERED_SERVE_MODEL_HF_ID\"] = args.model\n    os.environ[\"TIERED_SERVE_MODULE_BLOCK_CONFIG_PATH\"] = args.ts_configs[0]\n\n    os.environ[\n        \"TIERED_SERVE_REDUCE_KV_FOOTPRINT\"] = \"1\" if args.reduce_kv_footprint else \"0\"\n    os.environ[\n        \"TIERED_SERVE_NO_OFFLOAD_KV\"] = \"1\" if args.no_offload_kv else \"0\"\n\n    os.environ[\"TIERED_SERVE_N_KV_BUFFERS\"] = \"2\"\n    # Streamed-weight buffer slots; overridable.  Default 2 is sufficient\n    # now that streamed slots are assigned by POSITION among not-frozen\n    # layers (DualMemoryLoader), so consecutive streamed layers always\n    # alternate slots regardless of frozen layout (even-odd included).\n    os.environ.setdefault(\"TIERED_SERVE_N_WEIGHT_BUFFERS\", \"2\")\n    # os.environ[\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"] = str(3)\n\n    # --- Mantissa/Exponent split path ---------------------------------\n    # Weight and KV split are independent; --mantexp-split is a shortcut\n    # for both. Selecting --kv-comp=mantexp implicitly turns on KV split.\n    split_weight = args.mantexp_split or args.mantexp_split_weight\n    split_kv = (args.mantexp_split or args.mantexp_split_kv\n                or args.kv_comp == \"mantexp\")\n    os.environ[\"TIERED_SERVE_MANTEXP_SPLIT\"] = (\n        \"1\" if (split_weight or split_kv) else \"0\")\n    os.environ[\"TIERED_SERVE_MANTEXP_SPLIT_WEIGHT\"] = (\n        \"1\" if split_weight else \"0\")\n    os.environ[\"TIERED_SERVE_MANTEXP_SPLIT_KV\"] = (\n        \"1\" if split_kv else \"0\")\n    if split_weight:\n        if args.weight_comp and args.weight_comp not in (\n                \"dietgpu\", \"dietgpu_bf16\"):\n            print(\"[mantexp-split] overriding --weight-comp=\"\n                  f\"{args.weight_comp} -> dietgpu_bf16\", file=sys.stderr)\n        args.weight_comp = \"dietgpu_bf16\"\n    if split_kv:\n        if args.kv_comp and args.kv_comp != \"mantexp\":\n            print(\"[mantexp-split] overriding --kv-comp=\"\n                  f\"{args.kv_comp} -> mantexp\", file=sys.stderr)\n        args.kv_comp = \"mantexp\"\n    if args.no_offload_kv and args.kv_comp is not None:\n        parser.error(\n            \"KV compression requires KV offloading; \"\n            \"--no-offload-kv cannot be combined with --kv-comp or a \"\n            \"MantExp KV split option\")\n    if args.mantexp_kv_codec is not None:\n        os.environ[\"TIERED_SERVE_KV_MANT_CODEC\"] = args.mantexp_kv_codec\n    weight_comp_requested = bool(\n        args.weight_comp or args.split_compressor or args.offload_compressor)\n    os.environ[\n        \"TIERED_SERVE_USE_WEIGHT_COMP\"] = \"1\" if weight_comp_requested else \"0\"\n    if args.weight_comp:\n        os.environ[\"TIERED_SERVE_WEIGHT_COMP_BACKEND\"] = args.weight_comp\n    if args.split_compressor:\n        os.environ[\"TIERED_SERVE_SPLIT_COMP_BACKEND\"] = args.split_compressor\n    if args.offload_compressor:\n        os.environ[\"TIERED_SERVE_OFFLOAD_COMP_BACKEND\"] = args.offload_compressor\n    if args.prefill_alt_comp is not None:\n        os.environ[\"TIERED_SERVE_PREFILL_ALT_BACKEND\"] = args.prefill_alt_comp\n    if args.prefill_alt_max_chunk is not None:\n        os.environ[\"TIERED_SERVE_PREFILL_ALT_MAX_CHUNK\"] = args.prefill_alt_max_chunk\n    if args.offload_prefill_max_chunk is not None:\n        os.environ[\"TIERED_SERVE_OFFLOAD_PREFILL_MAX_CHUNK\"] = args.offload_prefill_max_chunk\n    os.environ[\"TIERED_SERVE_USE_FUSED_MM\"] = (\n        \"1\" if args.fused_mm else \"0\")\n    # NEVER reuse a compiled/cudagraph cache.  The tiered-serve runtime flags\n    # (--fused-mm, --kv-comp, residency config) change the traced graph but are\n    # NOT part of vLLM's torch.compile cache key, so a stale cached graph from a\n    # prior run with different flags would be silently reused → wrong weights /\n    # IMA.  Force a fresh compile every run (skips both cache load and save).\n    os.environ[\"VLLM_DISABLE_COMPILE_CACHE\"] = \"1\"\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_FROZEN\"] = (\n        \"1\" if args.ats_decomp_frozen else \"0\")\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_OFFLOAD\"] = (\n        \"1\" if args.ats_decomp_offload else \"0\")\n    os.environ[\"TIERED_SERVE_USE_KV_COMP\"] = \"1\" if args.kv_comp else \"0\"\n    if args.kv_comp:\n        os.environ[\"TIERED_SERVE_KV_COMP_BACKEND\"] = args.kv_comp\n        # Keep an offloadable block's partial tail in a request-private HBM\n        # slot and publish/compress it only after all 16 tokens are written.\n        # Cache the choice before model/KV allocation; the serving hot path\n        # never reads this environment variable.  Set it to 0 for a legacy\n        # same-code A/B run.\n        if args.kv_comp in (\"p4flat\", \"p4flatcpu\"):\n            os.environ.setdefault(\n                \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"1\")\n        if args.kv_comp == \"zipserv\":\n            # ``--kv-comp zipserv`` is an explicit request for the accelerated\n            # host encoder.  Overwrite a stale inherited producer setting so\n            # serving always runs raw D2H -> C++ CPU worker compression.\n            os.environ[\"TIERED_SERVE_KV_COMP_PRODUCER\"] = \\\n                \"cpu_after_raw_swap\"\n        # P4Flat/UBLB own the tight 25,600-byte default and their encoders\n        # publish is_raw=2 for an over-stride block.  An explicit\n        # TIERED_SERVE_KV_BLOB_STRIDE (0 selects raw-safe) still overrides it.\n\n    os.environ[\"TIERED_SERVE_COLLECT_TIME\"] = \"1\" if args.collect_time else \"0\"\n\n    os.environ[\"TIERED_SERVE_GPU_RESERVE_GIB\"] = os.environ.get(\n        \"TIERED_SERVE_GPU_RESERVE_GIB\", \"6\")\n\n    engine_type = \"ts\"\n    if weight_comp_requested:\n        engine_type += \"_wc\"\n    if args.kv_comp:\n        engine_type += \"_kvc\"\n    if args.collect_time:\n        engine_type += \"_time\"\n\n    os.environ[\n        \"TIERED_SERVE_ENGINE_ID\"] = f\"{engine_type}_{model_id}\"\n\n    logger = logging.getLogger(\"vllm\")\n    logger.setLevel(log_level)\n\n    def handle_unhandled_exception(exc_type, exc_value, exc_traceback):\n        logger.critical(\"Unhandled exception\",\n                        exc_info=(exc_type, exc_value, exc_traceback))\n\n    sys.excepthook = handle_unhandled_exception\n\n    run_datetime = datetime.now().strftime('%Y%m%d_%H%M%S')\n    folder_path = (\n        f\"./logs/serving/{model_id}/{ts_config_name}/\"\n        f\"{run_datetime}\"\n    )\n    os.makedirs(folder_path, exist_ok=True)\n    os.environ[\"TIERED_SERVE_LOG_DIR\"] = os.path.abspath(folder_path)\n    log_file_name = f\"{folder_path}/{context_len}.log\"\n    file_handler = logging.FileHandler(log_file_name)\n    logger.addHandler(file_handler)\n\n    logger.info(\n        \"##########################################################################\"\n    )\n    logger.info(\n        f\"##### Serving LLM with offloading {os.environ['TIERED_SERVE_OFFLOAD_TYPE']}\"\n    )\n    logger.info(f\"##### {model_id} {args.model}\")\n    logger.info(\n        \"##### Required scheduler policy: prefix_caching=False \"\n        \"chunked_prefill=True max_num_batched_tokens=1024\"\n    )\n    if args.weight_comp:\n        logger.info(f\"##### Using Weight Compression\")\n    if args.fused_mm:\n        logger.info(\"##### Using Fused MM\")\n    if args.prefill_alt_comp is not None:\n        logger.info(\n            \"##### Phase-adaptive prefill-alt codec = %s (decode keeps %s)%s\",\n            args.prefill_alt_comp,\n            args.split_compressor or args.weight_comp or \"zipserv\",\n            f\"; max-chunk={args.prefill_alt_max_chunk}\"\n            if args.prefill_alt_max_chunk else \"\")\n    if args.kv_comp:\n        logger.info(\n            \"##### Using KV Compression (backend=%s, producer=%s)\",\n            args.kv_comp,\n            os.environ.get(\"TIERED_SERVE_KV_COMP_PRODUCER\",\n                           \"backend-default\"))\n        if os.environ.get(\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"0\") == \"1\":\n            logger.info(\n                \"##### KV full-block-only enabled \"\n                \"(partial tails stay in HBM)\")\n    if split_weight or split_kv:\n        logger.info(\n            \"##### Mantissa/Exponent SPLIT enabled (weight_split=%s, \"\n            \"kv_split=%s, weight=%s, kv=%s, kv_codec=%s)\",\n            split_weight, split_kv, args.weight_comp, args.kv_comp,\n            os.environ.get(\"TIERED_SERVE_KV_MANT_CODEC\", \"dietgpu\"))\n    logger.info(\n        \"##########################################################################\"\n    )\n\n    engine_args = AsyncEngineArgs.from_cli_args(args)\n    for name, attr in args.__dict__.items():\n        engine_args.__setattr__(name, attr)\n    engine_args.disable_log_requests = True\n    engine_args.enforce_eager = False\n    engine_args.max_num_seqs = min(args.max_num_seqs, 512) if args.max_num_seqs is not None else 512\n    engine_args.enable_prefix_caching = False\n    engine_args.enable_chunked_prefill = True\n    engine_args.max_num_batched_tokens = 1024\n    engine_args.max_model_len = args.max_context_len\n    engine_args.swap_space = 0\n    engine_args.block_size = 16\n\n    # Cap CUDA-graph capture at the expected decode batch size (in requests)\n    # so that any batch whose token count exceeds it — i.e. one carrying a\n    # non-trivial prefill chunk — runs EAGER (CUDAGraphMode.NONE) and takes\n    # the dedicated eager prefill weight path, instead of a PIECEWISE graph.\n    # Pure decode (num_tokens == num_reqs) up to this many requests stays\n    # fully graph-captured.  Tune _DECODE_CAPTURE_REQS to the real decode\n    # concurrency: too low and large decode bursts fall to eager; too high\n    # and more prefill-mixed batches sneak into piecewise graphs (still\n    # correct via DualMemoryLoader.batch_has_prefill, just not eager).\n    # Scaled by the per-decode-step query length so speculative decoding\n    # (decode num_tokens = num_reqs * (1 + num_spec)) is not pushed eager.\n    from vllm.config import CompilationConfig\n    # !!IMPOPRTANT: Batch SOULD NO MORE THAN THIS VALUE\n    # THIS VALUE IS FOR REDUCE CUDA GRAPH MEMRORY CONSUMPTION\n    # IF BATCH SIZE IS LARGER THAN _DECODE_CAPTURE_REQS OFFLOAD WILL NOT WORK\n    _DECODE_CAPTURE_REQS = 512\n\n    _decode_query_len = 1\n    _spec = getattr(engine_args, \"speculative_config\", None)\n    if isinstance(_spec, dict):\n        _ns = _spec.get(\"num_speculative_tokens\")\n        if _ns:\n            _decode_query_len += int(_ns)\n    _cc = engine_args.compilation_config\n    if not isinstance(_cc, CompilationConfig):\n        # the args-copy loop above may have replaced it with a raw CLI value\n        # (None / int level / dict); normalize back to a CompilationConfig.\n        if isinstance(_cc, int):\n            _cc = CompilationConfig(level=_cc)\n        elif isinstance(_cc, dict):\n            _cc = CompilationConfig(**_cc)\n        else:\n            _cc = CompilationConfig()\n        engine_args.compilation_config = _cc\n    _cc.max_cudagraph_capture_size = _DECODE_CAPTURE_REQS * _decode_query_len\n    # Tell the loader/op where the capture/eager boundary is: prefill chunk <=\n    # this reads the compressed staging in the captured graph (UNIFY with decode);\n    # > this runs eager on a dense