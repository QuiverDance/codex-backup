command -v nvidia-smi >/dev/null || die \"nvidia-smi is required\"\n  command -v findmnt >/dev/null || die \"findmnt is required\"\n\n  local method\n  for method in \"${METHODS[@]}\"; do\n    build_method \"$method\"\n    [[ -f \"$CONFIG_PATH\" ]] || die \"config not found: ${CONFIG_PATH}\"\n    if [[ -n \"$EXPECTED_CODEC\" ]] &&\n       ! grep -q \"compressor: ${EXPECTED_CODEC}\" \"$CONFIG_PATH\"; then\n      die \"${method}: ${CONFIG_PATH} does not declare ${EXPECTED_CODEC}\"\n    fi\n  done\n}\n\n# Clear every inherited tiered-serve knob. Each child receives only the common\n# values below and the flags selected by build_method().\nENV_PREFIX=(env)\nwhile IFS='=' read -r env_name _; do\n  if [[ \"$env_name\" == TIERED_SERVE_* ]]; then\n    ENV_PREFIX+=(-u \"$env_name\")\n  fi\ndone < <(env)\nENV_PREFIX+=(\n  \"PYTHONHASHSEED=0\"\n  \"CUDA_VISIBLE_DEVICES=${GPU_INDEX}\"\n  \"LD_PRELOAD=${STACK_POOL}\"\n  \"VLLM_DISABLE_COMPILE_CACHE=1\"\n  \"TIERED_SERVE_NUM_WEIGHT_HUGE_PAGE=${WEIGHT_HUGE_PAGES}\"\n  \"TIERED_SERVE_N_WEIGHT_BUFFERS=2\"\n)\n\nbuild_command() {\n  local method=\"$1\"\n  build_method \"$method\"\n  CMD=(\n    \"${ENV_PREFIX[@]}\"\n    numactl -m \"$NUMA_NODE\"\n    \"$PYTHON\" \"$DRIVER\"\n    --model \"$MODEL\"\n    --dtype bfloat16\n    --tensor-parallel-size 1\n    --block-size 16\n    --no-enable-prefix-caching\n    --batch \"${BATCHES[@]}\"\n    --inputseqlen \"$INPUT_SEQ_LEN\"\n    --gen \"$GEN_TOKENS\"\n    --fixed-generation-length\n    --prefill-chunk \"$PREFILL_CHUNK\"\n    --warmup \"$WARMUP\"\n    --ts-configs \"$CONFIG_PATH\"\n  )\n  if ((TIME_BREAKDOWN)); then\n    CMD+=(--time-breakdown)\n  fi\n  CMD+=(\"${FEATURE_ARGS[@]}\")\n}\n\nactive_tiered_processes() {\n  local pid stat args\n  while read -r pid stat args; do\n    [[ \"$stat\" == Z* ]] && continue\n    case \"$args\" in\n      *offline_offload_kvweight.py*|*serve_offload_kvweight.py*|*VLLM::EngineCore*)\n        printf '%s %s %s\\n' \"$pid\" \"$stat\" \"$args\"\n        ;;\n    esac\n  done < <(ps -eo pid=,stat=,args=)\n}\n\nLAST_STATE_DETAIL=\"\"\ncapture_clean_state() {\n  local offenders gpu_apps gpu_line hbm_used gpu_util\n  local hp_total hp_free hp_reserved mount_type\n  local -a problems=()\n\n  offenders=\"$(active_tiered_processes)\"\n  [[ -z \"$offenders\" ]] || problems+=(\"tiered-processes=${offenders//$'\\n'/ | }\")\n\n  if ! gpu_line=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-gpu=memory.used,utilization.gpu \\\n      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')\"; then\n    problems+=(\"nvidia-smi-query-failed\")\n    gpu_line=\",\" \n  fi\n  IFS=',' read -r hbm_used gpu_util <<<\"$gpu_line\"\n  if [[ ! \"$hbm_used\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-hbm=${hbm_used:-empty}\")\n  elif ((hbm_used > MAX_IDLE_HBM_MIB)); then\n    problems+=(\"hbm=${hbm_used}MiB>${MAX_IDLE_HBM_MIB}MiB\")\n  fi\n  if [[ ! \"$gpu_util\" =~ ^[0-9]+$ ]]; then\n    problems+=(\"invalid-gpu-util=${gpu_util:-empty}\")\n  elif ((gpu_util != 0)); then\n    problems+=(\"gpu-util=${gpu_util}%\")\n  fi\n\n  gpu_apps=\"$(nvidia-smi -i \"$GPU_INDEX\" \\\n      --query-compute-apps=pid,process_name,used_memory \\\n      --format=csv,noheader,nounits 2>/dev/null | sed '/^[[:space:]]*$/d' || true)\"\n  [[ -z \"$gpu_apps\" ]] || problems+=(\"gpu-processes=${gpu_apps//$'\\n'/ | }\")\n\n  if [[ -r \"${HUGEPAGE_SYSFS}/nr_hugepages\" ]]; then\n    hp_total=\"$(<\"${HUGEPAGE_SYSFS}/nr_hugepages\")\"\n    hp_free=\"$(<\"${HUGEPAGE_SYSFS}/free_hugepages\")\"\n    hp_reserved=\"$(<\"${HUGEPAGE_SYSFS}/resv_hugepages\")\"\n    if [[ \"$hp_total\" =~ ^[0-9]+$ ]] && ((hp_total < WEIGHT_HUGE_PAGES)); then\n      problems+=(\"hugepages-total=${hp_total}<weight-pages=${WEIGHT_HUGE_PAGES}\")\n    fi\n    [[ \"$hp_total\" == \"$hp_free\" ]] || problems+=(\"hugepages-free=${hp_free}/${hp_total}\")\n    [[ \"$hp_reserved\" == \"0\" ]] || problems+=(\"hugepages-reserved=${hp_reserved}\")\n  else\n    hp_total=\"?\"\n    hp_free=\"?\"\n    hp_reserved=\"?\"\n    problems+=(\"16GiB-hugepage-sysfs-missing\")\n  fi\n\n  mount_type=\"$(findmnt -n -o FSTYPE /mnt/hugepages 2>/dev/null || true)\"\n  [[ \"$mount_type\" == \"hugetlbfs\" ]] || problems+=(\"/mnt/hugepages=${mount_type:-not-mounted}\")\n\n  if ((${#problems[@]})); then\n  if ((${#problems[@]})); then\n    LAST_STATE_DETAIL=\"$(IFS='; '; echo \"${problems[*]}\")\"\n    return 1\n  fi\n  LAST_STATE_DETAIL=\"gpu=${GPU_INDEX} hbm=${hbm_used}MiB util=${gpu_util}% hugepages=${hp_free}/${hp_total}\"\n  return 0\n}\n\nwait_for_clean_state() {\n  local context=\"$1\"\n  local deadline=$((SECONDS + CLEANUP_TIMEOUT))\n  local next_report=$SECONDS\n  while ! capture_clean_state; do\n    if ((SECONDS >= deadline)); then\n      echo \"[suite] ERROR: ${context}: state did not become clean within ${CLEANUP_TIMEOUT}s\" >&2\n      echo \"[suite]        ${LAST_STATE_DETAIL}\" >&2\n      return 1\n    fi\n    if ((SECONDS >= next_report)); then\n      echo \"[suite] waiting for clean state (${context}): ${LAST_STATE_DETAIL}\"\n      next_report=$((SECONDS + 15))\n    fi\n    sleep 2\n  done\n  echo \"[suite] clean state (${context}): ${LAST_STATE_DETAIL}\"\n}\n\nCURRENT_PGID=\"\"\nterminate_current_group() {\n  [[ -n \"$CURRENT_PGID\" ]] || return 0\n  if kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null; then\n    echo \"[suite] stopping only the active run process group ${CURRENT_PGID}\" >&2\n    kill -TERM -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    local deadline=$((SECONDS + 10))\n    while kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null && ((SECONDS < deadline)); do\n      sleep 1\n    done\n    if kill -0 -- \"-${CURRENT_PGID}\" 2>/dev/null; then\n      kill -KILL -- \"-${CURRENT_PGID}\" 2>/dev/null || true\n    fi\n  fi\n}\n\nhandle_signal() {\n  local signal=\"$1\"\n  terminate_current_group\n  [[ \"$signal\" == INT ]] && exit 130\n  exit 143\n}\n\ntrap 'handle_signal INT' INT\ntrap 'handle_signal TERM' TERM\ntrap 'terminate_current_group' EXIT\n\npreflight_files\n\nif ((CHECK_ONLY)); then\n  wait_for_clean_state \"suite preflight\" || exit 1\n  echo \"[suite] PASS: configs, dependencies, and resources are ready\"\n  exit 0\nfi\n\nif ((DRY_RUN)); then\n  echo \"[suite] dry-run: ${#METHODS[@]} methods x ${REPEATS} repeat(s)\"\n  for ((round = 1; round <= REPEATS; round++)); do\n    if ((round % 2 == 1)); then\n      order=(\"${METHODS[@]}\")\n    else\n      order=()\n      for ((idx = ${#METHODS[@]} - 1; idx >= 0; idx--)); do\n        order+=(\"${METHODS[idx]}\")\n      done\n    fi\n    for method in \"${order[@]}\"; do\n      build_command \"$method\"\n      printf '[round %d] %-31s config=%s\\n  ' \"$round\" \"$METHOD_LABEL\" \"$CONFIG_STEM\"\n      printf '%q ' \"${CMD[@]}\"\n      printf '\\n'\n    done\n  done\n  exit 0\nfi\n\nwait_for_clean_state \"suite preflight\" || exit 1\n\nSUITE_ID=\"$(date +%Y%m%d_%H%M%S)\"\nSUITE_DIR=\"${OUTPUT_ROOT}/${SUITE_ID}\"\nmkdir -p \"$SUITE_DIR\"\nSUMMARY=\"${SUITE_DIR}/summary.tsv\"\nMANIFEST=\"${SUITE_DIR}/manifest.txt\"\nprintf 'round\\tmethod_id\\tmethod\\tconfig\\texit_code\\telapsed_sec\\tstate\\tcsv\\trunner_log\\n' >\"$SUMMARY\"\n\n{\n  echo \"suite_id=${SUITE_ID}\"\n  echo \"repo_root=${REPO_ROOT}\"\n  echo \"git_commit=$(git -C \"$REPO_ROOT\" rev-parse HEAD 2>/dev/null || echo unknown)\"\n  echo \"model=${MODEL}\"\n  echo \"batches=${BATCHES[*]}\"\n  echo \"input_seq_len=${INPUT_SEQ_LEN}\"\n  echo \"gen=${GEN_TOKENS}\"\n  echo \"warmup=${WARMUP}\"\n  echo \"prefill_chunk=${PREFILL_CHUNK}\"\n  echo \"repeats=${REPEATS}\"\n  echo \"kv_backend=${KV_BACKEND}\"\n  echo \"gpu_index=${GPU_INDEX}\"\n  echo \"numa_node=${NUMA_NODE}\"\n  echo \"weight_huge_pages=${WEIGHT_HUGE_PAGES}\"\n  echo \"max_idle_hbm_mib=${MAX_IDLE_HBM_MIB}\"\n  echo \"order=odd rounds forward; even rounds reverse\"\n  if ((TIME_BREAKDOWN)); then\n    echo \"timing=--time-breakdown enabled\"\n  else\n    echo \"timing=--time-breakdown disabled\"\n  fi\n  echo \"generation=--fixed-generation-length\"\n  echo \"environment=all inherited TIERED_SERVE_* variables cleared per child\"\n  echo\n  echo \"method_mapping:\"\n  for method in \"${METHODS[@]}\"; do\n    build_method \"$method\"\n    printf '  %s\\t%s\\t%s\\t' \"$method\" \"$METHOD_LABEL\" \"$CONFIG_PATH\"\n    printf '%q ' \"${FEATURE_ARGS[@]}\"\n    printf '\\n'\n  done\n  echo\n  echo \"nvidia_smi:\"\n  nvidia-smi\n  echo\n  echo \"git_status:\"\n  git -C \"$REPO_ROOT\" status --short 2>/dev/null || true\n} >\"$MANIFEST\"\n\necho \"[suite] results: ${SUITE_DIR}\"\necho \"[suite] ${#METHODS[@]} methods x ${REPEATS} repeat(s); fail-fast enabled\"\n\nfor ((round = 1; round <= REPEATS; round++)); do\n  if ((round % 2 == 1)); then\n    order=(\"${METHODS[@]}\")\n  else\n    order=()\n    for ((idx = ${#METHODS[@]} - 1; idx >= 0; idx--)); do\n      order+=(\"${METHODS[idx]}\")\n    done\n  fi\n\n  for method in \"${order[@]}\"; do\n    wait_for_clean_state \"before round ${round} ${method}\" || exit 1\n    build_command \"$method\"\n\n    printf -v round_tag '%02d' \"$round\"\n    RUN_LOG=\"${SUITE_DIR}/round-${round_tag}_${method}.log\"\n    {\n      echo \"method_id=${method}\"\n      echo \"method=${METHOD_LABEL}\"\n      echo \"config=${CONFIG_PATH}\"\n      printf 'command='\n      printf '%q ' \"${CMD[@]}\"\n      printf '\\n'\n    } >\"$RUN_LOG\"\n\n    echo\n    echo \"[suite] round ${round}/${REPEATS}: ${METHOD_LABEL}\"\n    echo \"[suite] config=${CONFIG_STEM} log=${RUN_LOG}\"\n    start_epoch=\"$(date +%s)\"\n\n    set +e\n    setsid \"${CMD[@]}\" > >(tee -a \"$RUN_LOG\") 2>&1 &\n    CURRENT_PGID=$!\n    wait \"$CURRENT_PGID\"\n    run_status=$?\n    wait\n    set -e\n    elapsed=$(( $(date +%s) - start_epoch ))\n\n    if ((run_status != 0)); then\n      terminate_current_group\n    fi\n    CURRENT_PGID=\"\"\n\n    state=\"clean\"\n    if ! wait_for_clean_state \"after round ${round} ${method}\"; then\n      state=\"dirty\"\n    fi\n\n    csv_path=\"$(sed -n 's/.*CSV saved: //p' \"$RUN_LOG\" | tail -n1)\"\n    if ((run_status == 0)) && [[ -z \"$csv_path\" ]]; then\n      echo \"[suite] ERROR: run exited successfully but no CSV was reported\" >&2\n      run_status=65\n    fi\n\n    printf '%d\\t%s\\t%s\\t%s\\t%d\\t%d\\t%s\\t%s\\t%s\\n' \\\n      \"$round\" \"$method\" \"$METHOD_LABEL\" \"$CONFIG_STEM\" \"$run_status\" \\\n      \"$elapsed\" \"$state\" \"$csv_path\" \"$RUN_LOG\" >>\"$SUMMARY\"\n\n    if ((run_status != 0)) || [[ \"$state\" != clean ]]; then\n      echo \"[suite] FAIL: ${METHOD_LABEL} (exit=${run_status}, state=${state})\" >&2\n      echo \"[suite] summary: ${SUMMARY}\" >&2\n      exit 1\n    fi\n  done\ndone\n\necho\necho \"[suite] PASS: all runs completed with a clean boundary between runs\"\necho \"[suite] summary: ${SUMMARY}\"\n#!/bin/bash\n# Usage:\n#   bash scripts/serving/run_experiment.sh llama70b                     # 파일 내 CONFIGS 전부 실행\n#   bash scripts/serving/run_experiment.sh llama70b 75-qkvo-first       # 단일 config override\n#   bash scripts/serving/run_experiment.sh qwen72b cfg1 cfg2 cfg3       # 복수 config override\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/model_map.sh\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS [CONFIG ...]}\"\nshift\nresolve_model \"$MODEL_ALIAS\"\n\n# config: 인자가 있으면 override, 없으면 기본값\nif [[ $# -gt 0 ]]; then\n    CONFIGS=(\"$@\")\nelse\n    CONFIGS=(\"75-qkvo-first\" \"75-comp-qkvo-first\" \"75-comp-qkvo-ffn-first\" \"75-comp-ffn-first\")\nfi\n\nPORT=${PORT:-8000}\nTIMEOUT=${TIMEOUT:-600}\n\nfor cfg in \"${CONFIGS[@]}\"; do\n    echo \"\"\n    echo \"==========================================\"\n    echo \"  Config: $cfg\"\n    echo \"  Model:  $MODEL\"\n    echo \"==========================================\"\n\n    # 서버 백그라운드 실행 (로그는 stderr/stdout 그대로 흘림)\n    # LD_PRELOAD: CPython 3.12 data stack chunk (16KiB) mmap/munmap churn 방지\n    STACK_POOL_SO=\"${SCRIPT_DIR}/../../etc/stack_pool.so\"\n    LD_PRELOAD=\"$STACK_POOL_SO\" numactl -m 0 ./.venv/bin/python serve_offload_kvweight.py \\\n      --model \"$MODEL\" --no-enable-prefix-caching \\\n      --chunked-prefill --weight-comp --ts-configs \"$cfg\" &\n    SERVER_PID=$!\n\n    # 스크립트 중단 시 서버 정리\n    trap 'kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null' EXIT\n\n    # health check 대기\n    echo \"[*] Waiting for server (PID=$SERVER_PID)...\"\n    elapsed=0\n    while ! curl -sf \"http://localhost:${PORT}/health\" > /dev/null 2>&1; do\n        if ! kill -0 \"$SERVER_PID\" 2>/dev/null; then\n            echo \"[!] Server died unexpectedly.\"\n            exit 1\n        fi\n        if [ \"$elapsed\" -ge \"$TIMEOUT\" ]; then\n            echo \"[!] Timeout (${TIMEOUT}s) waiting for server.\"\n            kill \"$SERVER_PID\" 2>/dev/null\n            exit 1\n        fi\n        sleep 5\n        elapsed=$((elapsed + 5))\n    done\n    echo \"[*] Server ready after ${elapsed}s.\"\n\n    # 클라이언트 실행 (포그라운드, 끝날 때까지 대기) — 현재 config 전달\n    echo \"[*] Running client...\"\n    bash scripts/serving/client/azure_conv.sh \"$MODEL_ALIAS\" \"$cfg\"\n    echo \"[*] Client finished.\"\n\n    # 서버 종료\n    echo \"[*] Shutting down server...\"\n    kill \"$SERVER_PID\" 2>/dev/null\n    wait \"$SERVER_PID\" 2>/dev/null || true\n    trap - EXIT\n    sleep 5\ndone\n\necho \"\"\necho \"[*] All experiments finished.\"\n#!/bin/bash\n# 호스트에서 실행 (tmux 세션의 pane으로 명령 전송)\n# pane 0: 서버 (컨테이너), pane 1: 클라이언트 (컨테이너), pane 2: 이 스크립트 (호스트)\n#\n# Usage:\n#   bash run_experiment_tmux.sh llama70b azure_conv                          # 기본 CONFIGS\n#   bash run_experiment_tmux.sh llama70b azure_conv baseline-gateup          # 단일 config\n#   bash run_experiment_tmux.sh llama70b azure_conv cfg1 cfg2 cfg3           # 복수 config\n# (둘째 인자는 scripts/serving/client/ 아래의 클라이언트 스크립트 이름, .sh 생략 가능)\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/model_map.sh\"\n\nCONTAINER=\"${CONTAINER:-tiered-serve}\"\nPORT=${PORT:-8000}\nTIMEOUT=${TIMEOUT:-600}\n\n# ── tmux pane 자동 탐지 ──────────────────────────────────────────\n# 이 스크립트를 실행 중인 pane을 찾고, 나머지 pane을 서버/클라이언트에 배정\n# pane_id (%N) 는 절대적이라 pane-base-index 영향 없음\nif [[ -n \"${TMUX:-}\" ]]; then\n    SESSION=\"$(tmux display-message -p '#S')\"\n    MY_PANE=\"$(tmux display-message -p '#{pane_id}')\"\n    # 같은 윈도우의 모든 pane ID를 index 순으로\n    mapfile -t ALL_PANES < <(tmux list-panes -F '#{pane_id}')\n    OTHER_PANES=()\n    for p in \"${ALL_PANES[@]}\"; do\n        [[ \"$p\" != \"$MY_PANE\" ]] && OTHER_PANES+=(\"$p\")\n    done\n    if [[ ${#OTHER_PANES[@]} -lt 2 ]]; then\n        echo \"[!] Error: need at least 3 panes (server, client, this script). Found ${#ALL_PANES[@]}.\"\n        exit 1\n    fi\n    SERVER_PANE=\"${SERVER_PANE:-${OTHER_PANES[0]}}\"\n    CLIENT_PANE=\"${CLIENT_PANE:-${OTHER_PANES[1]}}\"\nelse\n    # tmux 외부에서 실행 시 (예: docker exec) — 환경변수 필수\n    SERVER_PANE=\"${SERVER_PANE:?Not in tmux. Set SERVER_PANE env var (e.g. %0)}\"\n    CLIENT_PANE=\"${CLIENT_PANE:?Not in tmux. Set CLIENT_PANE env var (e.g. %1)}\"\nfi\necho \"[*] Server pane: $SERVER_PANE, Client pane: $CLIENT_PANE, My pane: ${MY_PANE:-N/A}\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS CLIENT_SCRIPT [CONFIG ...]}\"\nshift\nCLIENT_SCRIPT=\"${1:?Usage: $0 MODEL_ALIAS CLIENT_SCRIPT [CONFIG ...]}\"\nshift\nCLIENT_SCRIPT=\"${CLIENT_SCRIPT%.sh}\"   # .sh 붙여 줘도 동작\nresolve_model \"$MODEL_ALIAS\"\n\nif [[ $# -gt 0 ]]; then\n    CONFIGS=(\"$@\")\nelse\n    CONFIGS=(\"flexgen\" \"flexgen-comp\" \"cao-zs\" \"cao-zs-fused\" \\\n             \"cao-p4\" \"cao-p4-fused\" \"cao-p4-kvcomp\" \"cao-zs-kvcomp\")\nfi\n\n# config별 서버 플래그 (weight-comp 백엔드 / --fused-mm / --kv-comp 조합).\n# --weight-comp 백엔드는 config YAML 안에 박힌 per-layer compressor 와 일치해야 한다\n#   cao-zs* → zipserv, cao-p4* → p4flat (cao-*-kvcomp 도 동일 규칙).\ndeclare -A CFG_FLAGS=(\n    [flexgen]=\"--weight-comp zipserv\"\n    [flexgen-comp]=\"--weight-comp zipserv\"\n    [cao-zs]=\"--weight-comp zipserv\"\n    [cao-zs-fused]=\"--weight-comp zipserv --fused-mm\"\n    [cao-zs-kvcomp]=\"--weight-comp zipserv --fused-mm --kv-comp ublb_flat\"\n    [cao-p4]=\"--weight-comp p4flat\"\n    [cao-p4-fused]=\"--weight-comp p4flat --fused-mm\"\n    [cao-p4-kvcomp]=\"--weight-comp p4flat --fused-mm --kv-comp ublb_flat\"\n)\n\nfor cfg in \"${CONFIGS[@]}\"; do\n    # 클라이언트에 현재 config 전달 → 결과가 config별 디렉토리로 저장됨\n    CLIENT_CMD=\"bash scripts/serving/client/${CLIENT_SCRIPT}.sh $MODEL_ALIAS $cfg\"\n\n    # config별 서버 플래그 결정 (미등록 config 는 zipserv weight-comp 기본)\n    EXTRA_FLAGS=\"${CFG_FLAGS[$cfg]:-}\"\n    if [[ -z \"$EXTRA_FLAGS\" ]]; then\n        echo \"[!] '$cfg' 에 대한 플래그 매핑 없음 → 기본 '--weight-comp zipserv' 사용\"\n        EXTRA_FLAGS=\"--weight-comp zipserv\"\n    fi\n\n    echo \"\"\n    echo \"==========================================\"\n    echo \"  Config: $cfg\"\n    echo \"  Model:  $MODEL\"\n    echo \"  Flags:  $EXTRA_FLAGS\"\n    echo \"==========================================\"\n\n    # pane 0: 서버 시작\n    tmux send-keys -t \"$SERVER_PANE\" \\\n      \"PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True numactl -m 0 ./.venv/bin/python serve_offload_kvweight.py --model $MODEL --no-enable-prefix-caching --chunked-prefill $EXTRA_FLAGS --ts-configs $cfg\" Enter\n\n    # health check 대기 (docker exec로 컨테이너 안에서 curl)\n    echo \"[*] Waiting for server...\"\n    elapsed=0\n    while ! docker exec \"$CONTAINER\" curl -sf \"http://localhost:${PORT}/health\" > /dev/null 2>&1; do\n        if [ \"$elapsed\" -ge \"$TIMEOUT\" ]; then\n            echo \"[!] Timeout (${TIMEOUT}s) waiting for server.\"\n            exit 1\n        fi\n        sleep 5\n        elapsed=$((elapsed + 5))\n        printf \"\\r[*] %ds elapsed...\" \"$elapsed\"\n    done\n    echo -e \"\\n[*] Server ready after ${elapsed}s.\"\n\n    # pane 1: 클라이언트 실행 (완료 시 sentinel 파일 생성)\n    SENTINEL=\"/tmp/.client_done_$$\"\n    docker exec \"$CONTAINER\" rm -f \"$SENTINEL\" 2>/dev/null || true\n    tmux send-keys -t \"$CLIENT_PANE\" \"$CLIENT_CMD; touch $SENTINEL\" Enter\n\n    # 클라이언트 완료 대기: sentinel 파일이 생길 때까지\n    echo \"[*] Waiting for client to finish...\"\n    while ! docker exec \"$CONTAINER\" test -f \"$SENTINEL\" 2>/dev/null; do\n        sleep 10\n    done\n    docker exec \"$CONTAINER\" rm -f \"$SENTINEL\" 2>/dev/null || true\n    sleep 3\n    echo \"[*] Client finished.\"\n\n    # 서버 종료: pkill 기반 (fuser 없음)\n    echo \"[*] Server shutting down...\"\n    docker exec \"$CONTAINER\" bash -c \"ps aux | grep -E 'serve_offload_kvweight' | grep -v grep\" || true\n\n    # 1) SIGINT\n    echo \"[*] Sending SIGINT...\"\n    docker exec \"$CONTAINER\" pkill -INT -f 'serve_offload_kvweight' 2>/dev/null || true\n    sleep 5\n\n    # 2) 프로세스 종료 대기\n    elapsed=0\n    while docker exec \"$CONTAINER\" pgrep -f 'serve_offload_kvweight' > /dev/null 2>&1; do\n        if [ \"$elapsed\" -ge 30 ]; then\n            echo -e \"\\n[!] Server did not exit after 30s, sending SIGKILL...\"\n            docker exec \"$CONTAINER\" pkill -9 -f 'serve_offload_kvweight' 2>/dev/null || true\n            sleep 5\n            break\n        fi\n        sleep 3\n        elapsed=$((elapsed + 3))\n        printf \"\\r[*] Waiting for server to exit... %ds\" \"$elapsed\"\n    done\n\n    # 3) 최종 확인\n    if docker exec \"$CONTAINER\" pgrep -f 'serve_offload_kvweight' > /dev/null 2>&1; then\n        echo \"[!] WARNING: Still alive, killing all python...\"\n        docker exec \"$CONTAINER\" killall -9 python python3 2>/dev/null || true\n        sleep 5\n    fi\n    echo \"[*] Server stopped.\"\n    sleep 2\ndone\n\necho \"\"\necho \"[*] All experiments finished.\"\n#!/bin/bash\n# Usage: bash scripts/serving/client/azure_conv.sh MODEL_ALIAS [TS_CONFIG] [REQUEST_RATE...]\n#   MODEL_ALIAS  : llama70b, llama70b-fp8, qwen72b\n#   TS_CONFIG    : (선택) 실행 중인 ts-config 이름 또는 경로. 결과 저장 디렉토리 키로 사용.\n#                  생략 시 \"manual\". 오케스트레이터가 $cfg를 그대로 넘김.\n#   REQUEST_RATE : (선택) 측정할 request rate. 1개 이상 지정 시 모델별 스윕 대신 그 값들만 측정.\n#                  예: ... llama70b manual 0.8 1.0 1.2\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/../model_map.sh\"\n\nMODEL_ALIAS=\"${1:?Usage: $0 MODEL_ALIAS [TS_CONFIG] (e.g. llama70b, llama70b-fp8, qwen72b)}\"\nresolve_model \"$MODEL_ALIAS\"\n\n# ── 결과 저장 키 유도 (서버 로그 명명 규칙과 일치) ────────────────────\n# 서버: ts_config_name = Path(ts_configs[0]).stem,\n#       model_id = model.split('/')[-1].lower().replace('-','_').replace('.','_')\nTS_CONFIG=\"${2:-manual}\"\nTS_NAME=\"$(basename \"$TS_CONFIG\")\"; TS_NAME=\"${TS_NAME%.yaml}\"; TS_NAME=\"${TS_NAME%.yml}\"\nMODEL_ID=\"$(echo \"${MODEL##*/}\" | tr '[:upper:]' '[:lower:]' | tr '.-' '__')\"\nRESULT_DIR=\"${RESULT_DIR:-logs/serving/$MODEL_ID/$TS_NAME/client}\"\nmkdir -p \"$RESULT_DIR\"\necho \"Saving results to: $RESULT_DIR\"\n\n# ── request rate 결정 ────────────────────────────────────────────────\n# 3번째 이후 인자로 rate를 1개 이상 주면 스윕 대신 그 값들만 측정.\nREQUEST_RATE_ARGS=(\"${@:3}\")\nif [ \"${#REQUEST_RATE_ARGS[@]}\" -gt 0 ]; then\n  REQUEST_RATES=\"${REQUEST_RATE_ARGS[*]}\"\nelse\n  case \"$MODEL_ALIAS\" in\n    qwen72b)\n      REQUEST_RATES=$(seq 0.5 0.1 1.2)\n      ;;\n    llama70b)\n      REQUEST_RATES=$(seq 1.6 -0.2 0.6)\n      ;;\n    llama70b-fp8)\n      REQUEST_RATES=$(seq 1.6 0.2 3.0)\n      ;;\n    *)\n      REQUEST_RATES=$(seq 0.4 0.2 2.0)\n      ;;\n  esac\nfi\n\necho \"Running benchmark with MODEL: $MODEL\"\necho \"Request rates to be tested: $REQUEST_RATES\"\n\nfor rate in $REQUEST_RATES\ndo\n  echo \"-----------------------------------------\"\n  echo \"Benchmarking with request-rate: $rate\"\n  echo \"-----------------------------------------\"\n  python -m vllm.entrypoints.cli.main bench serve \\\n    --model \"$MODEL\" \\\n    --dataset-name azure_conv \\\n    --ignore-eos \\\n    --num-prompts 1200 \\\n    --skip-first-n-requests 100 \\\n    --skip-last-n-requests 100 \\\n    --metric-percentiles='90' \\\n    --request-rate \"$rate\" \\\n    --save-result \\\n    --save-detailed \\\n    --result-dir \"$RESULT_DIR\" \\\n    --result-filename \"rate_${rate}.json\" \\\n    --metadata ts_config=\"$TS_NAME\" model=\"$MODEL_ID\"\ndone\n\necho \"Benchmark finished.\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d90-6eef-7460-be37-d0055a7c7c31","create_time":1787739278.2448626}}}
