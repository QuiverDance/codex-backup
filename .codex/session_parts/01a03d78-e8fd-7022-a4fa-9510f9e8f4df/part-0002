                 \"support speculative decoding\")\n            if self.vllm_config.parallel_config.tensor_parallel_size != 1:\n                raise RuntimeError(\n                    \"Tiered-serve full-block KV compression currently \"\n                    \"supports TP=1 only\")\n            if num_tail_slots != self.model_runner.max_num_reqs:\n                raise RuntimeError(\n                    \"resident-tail slot count must equal max_num_reqs: \"\n                    f\"slots={num_tail_slots}, \"\n                    f\"max_num_reqs={self.model_runner.max_num_reqs}\")\n            for layer_id, gpu_kv in enumerate(self.model_runner.kv_caches):\n                if gpu_kv.shape[1] < physical_buffer_offset:\n                    raise RuntimeError(\n                        \"resident-tail HBM rows are missing for layer \"\n                        f\"{layer_id}: rows={gpu_kv.shape[1]}, required=\"\n                        f\"{physical_buffer_offset}\")\n\n        logger.info(\n            \"Tiered-serve: num_dedicated_blocks=%d tail_slots=%d \"\n            \"physical_buffer_offset=%d num_offloadable_blocks=%d total=%d\",\n            num_dedicated_blocks, num_tail_slots, physical_buffer_offset,\n            num_offloadable, num_blocks)\n\n        # --- Populate primary_kv / secondary_kv on each vLLMKVCache ---\n        # Check if primary KV is already on LPDDR5 hugepages.\n        kv_on_hugepage = (\n            \"kv\" in offload_type.lower()\n            and not reduce_kv\n        )\n\n        # For the hugepage path, kv_caches[idx] already has D blocks on\n        # HBM (allocated in _allocate_kv_cache_tensors).  We need:\n        #   - One shared HBM buffer for offloadable blocks (O blocks)\n        #   - Per-layer LPDDR5 (hugepage) secondary for O blocks\n        # In reduce-kv mode, KV stays on HBM (SharedBlockAllocator\n        # keeps the physical footprint small); kv_on_hugepage is False.\n        # HBM decode buffer(s) for the offloadable region.  D