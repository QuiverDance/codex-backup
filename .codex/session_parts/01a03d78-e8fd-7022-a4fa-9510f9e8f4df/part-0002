          _profiled = (available_gpu_memory[0]\n                             if available_gpu_memory else 0)\n                hbm_budget = max(0, _gpu_free - gpu_reserve)\n                available_gpu_memory = [hbm_budget] * len(\n                    available_gpu_memory)\n                logger.info(\n                    \"Tiered-serve reduce-kv: using actual free GPU \"\n                    \"memory %.2f GiB (free=%.2f, reserve=%.2f) \"\n                    \"as KV budget (profiled=%.2f)\",\n                    hbm_budget / 1024**3,\n                    _gpu_free / 1024**3,\n                    gpu_reserve / 1024**3,\n                    _profiled / 1024**3)\n\n        kv_cache_configs = get_kv_cache_configs(\n            vllm_config, kv_cache_specs, available_gpu_memory\n        )\n\n        # Initialize kv cache and warmup the execution\n        self.model_executor.initialize_from_config(kv_cache_configs)\n\n        # tiered-serve may shrink KVCacheConfig.num_blocks while allocating\n        # the physical dedicated/offloadable split (for example when the\n        # requested dedicated boundary leaves a small fragment that cannot be\n        # backed by LPDDR hugepages).  Build the scheduler configuration only\n        # after that adjustment.  Otherwise BlockPool retains the profiled\n        # count and can hand out block ids beyond the compressor's persistent\n        # tables and the physical KV tensors.\n        scheduler_kv_cache_config = generate_scheduler_kv_cache_config(\n            kv_cache_configs)\n        profiled_num_gpu_blocks = scheduler_kv_cache_config.num_blocks\n        if offload_type and \"kv\" in offload_type.lower():\n            worker_block_counts = self.model_executor.collective_rpc(\n                \"get_kv_cache_num_blocks\")\n            if not worker_block_counts:\n                raise RuntimeError(\n                    \"workers did not report physical KV capacity\")\n            physical_num_gpu_blocks = min(\n                int(value) for value in worker_block_counts)\n            if physical_num_gpu_blocks <= 0:\n                raise RuntimeError(\n                    \"workers reported a non-positive physical KV capacity: \"\n                    f\"{worker_block_counts}\")\n            if physical_num_gpu_blocks > profiled_num_gpu_blocks:\n                raise RuntimeError(\n                    \"worker physical KV capacity exceeds the scheduler \"\n                    f\"profile: workers={worker_block_counts}, \"\n                    f\"profiled={profiled_num_gpu_blocks}\")\n            if physical_num_gpu_blocks < profiled_num_gpu_blocks:\n                for tensor in scheduler_kv_cache_config.kv_cache_tensors:\n                    if tensor.size % profiled_num_gpu_blocks != 0:\n                        raise RuntimeError(\n                            \"cannot shrink scheduler KV tensor \"\n                            f\"proportionally: size={tensor.size}, \"\n                            f\"blocks={profiled_num_gpu_blocks}\")\n                    per_block_size = tensor.size // profiled_num_gpu_blocks\n                    tensor.size = per_block_size * physical_num_gpu_blocks\n                scheduler_kv_cache_config.num_blocks = physical_num_gpu_blocks\n                logger.info(\n                    \"Tiered-serve: propagated physical KV block shrink to \"\n                    \"scheduler: %d -> %d (workers=%s)\",\n                    profiled_num_gpu_blocks, physical_num_gpu_blocks,\n                    worker_block_counts)\n        num_gpu_blocks = scheduler_kv_cache_config.num_blocks\n        num_cpu_blocks = 0\n\n        elapsed = time.time() - start\n        logger.info_once(\n            \"init engine (profile, create kv cache, warmup model) took %.2f seconds\",\n            elapsed,\n            scope=\"local\",\n        )\n        return num_gpu_blocks, num_cpu_blocks, scheduler_kv_cache_config\n\n    def _register_tiered_serve_block_callbacks(self) -> None:\n        \"\"\"Register BlockPool callbacks so that vLLMKVCache.free_block_ids\n        and used_block_ids stay in sync with the V1 scheduler's block\n        allocator.  Also wires in the unload_targets / free_slot helpers\n        from tiered_serve.vllm_block_decorator.\"\"\"\n        block_pool = getattr(\n            getattr(\n                getattr(self.scheduler, \"kv_cache_manager\", None),\n                \"coordinator\", None),\n            \"block_pool\", None)\n        if block_pool is None:\n            logger.warning(\n                \"tiered-serve: could not find BlockPool on scheduler; \"\n                \"free_block_ids will not be updated.\")\n                # When KV compression is enabled, LPDDR holds BOTH raw\n                # secondary AND persistent compressed pools.  Size LPDDR\n                # constraints against pb_lpddr = pb_raw + pb_compressed\n                # (HBM constraint still uses pb_raw — GPU stores raw only).\n                per_block_bytes_lpddr = per_block_bytes_raw\n                use_kv_comp_env = (\n                    os.getenv(\"TIERED_SERVE_USE_KV_COMP\", \"0\") == \"1\")\n                if use_kv_comp_env:\n                    kv_backend = os.getenv(\n                        \"TIERED_SERVE_KV_COMP_BACKEND\",\n                        \"zipserv\").lower()\n                    # Resolve the backend's per-side compressed-pool estimator\n                    # so the LPDDR budget accounts for BOTH raw secondary and\n                    # the persistent compressed pool.  Backends not listed\n                    # (dietgpu / mantexp) have a dynamic footprint and fall\n                    # through to the conservative raw-pb-only path.  p4flatcpu\n                    # and ublb_flat/ublb_tbe share p4flat's blob-pool storage\n                    # layout (same inherited static) — all MUST be modelled or\n                    # the unbudgeted compressed pool over-offloads -> host OOM.\n                    try:\n                        _per_side_fn = None\n                        if kv_backend == \"zipserv\":\n                            from tiered_serve.tensor_compressor import (\n                                ZipServCompressor,\n                            )\n                            _per_side_fn = (\n                                ZipServCompressor\n                                .compute_per_block_compressed_bytes)\n                        elif kv_backend in (\"p4flat\", \"p4flatcpu\",\n                                            \"ublb_flat\", \"ublb_tbe\"):\n                            from tiered_serve.p4flat_kv_compressor import (\n                                P4FlatKVCompressor,\n                            )\n                            _per_side_fn = (\n                                P4FlatKVCompressor\n                                .compute_per_block_compressed_bytes)\n                        _spec = None\n                        if kv_cache_config.kv_cache_groups:\n                            _spec = (kv_cache_config.kv_cache_groups[0]\n                                     .kv_cache_spec)\n                        if _per_side_fn is not None and _spec is not None:\n                            _bs = _spec.block_size\n                            _nkv = getattr(_spec, \"num_kv_heads\", 0)\n                            _hd = getattr(_spec, \"head_size\", 0)\n                            _block_elements = _bs * _nkv * _hd\n                            if _block_elements > 0:\n                                _per_side = _per_side_fn(_block_elements)\n                                per_block_bytes_lpddr = (\n                                    per_block_bytes_raw + 2 * _per_side)\n                        elif _per_side_fn is None:\n                            logger.info(\n                                \"Tiered-serve hugepage alloc: backend=%s \"\n                                \"compressed pool not modeled; using raw \"\n                                \"pb only\", kv_backend)\n                    except Exception as _e:\n                        logger.warning(\n                            \"Tiered-serve hugepage alloc: failed to \"\n                            \"size compressed pool (%s); using raw \"\n                            \"pb only\", _e)\n\n                # Max offloadable blocks from LPDDR5:\n                # O × n_kv_layers × pb_lpddr ≤ lpddr5\n                o_max_lpddr = lpddr5_bytes // (\n                    n_kv_layers * per_block_bytes_lpddr)\n                # Max offloadable blocks from hugepage packing:\n                # each page must fit ceil(n_kv_layers/n_kv_pages)\n                # layer-secondaries (raw + compressed)\n                n_kv_hp = hp_allocator.n_kv_pages\n                lpp = _math.ceil(n_kv_layers / n_kv_hp) if n_kv_hp else 1\n                o_max_frag = (hp_allocator.hp_size\n                              // (lp…325 tokens truncated…nts run with a different D.\n                _env_blocks = os.getenv(\n                    \"TIERED_SERVE_DEDICATED_KV_BLOCKS\")\n                _env_size_gb = os.getenv(\n                    \"TIERED_SERVE_DEDICATED_KV_SIZE_GB\")\n                if (_env_blocks is not None and _env_blocks.strip()\n                        and _env_size_gb is not None\n                        and _env_size_gb.strip()):\n                    raise RuntimeError(\n                        \"Set only one of TIERED_SERVE_DEDICATED_KV_BLOCKS \"\n                        \"and TIERED_SERVE_DEDICATED_KV_SIZE_GB\")\n\n                _requested_logical_d = None\n                if _env_blocks is not None and _env_blocks.strip():\n                    _requested_logical_d = int(_env_blocks)\n                elif _env_size_gb is not None and _env_size_gb.strip():\n                    _gb = float(_env_size_gb)\n                    if _gb <= 0:\n                        raise RuntimeError(\n                            \"TIERED_SERVE_DEDICATED_KV_SIZE_GB must be > 0, \"\n                            f\"got {_env_size_gb!r}\")\n                    _requested_logical_d = int(\n                        _gb * 1024**3\n                        // (n_kv_layers * per_block_bytes_raw))\n\n                if _requested_logical_d is not None:\n                    if _requested_logical_d < MIN_DED:\n                        raise RuntimeError(\n                            \"TIERED_SERVE_DEDICATED_KV_BLOCKS requests \"\n                            f\"logical D={_requested_logical_d}, but the \"\n                            f\"minimum is {MIN_DED}\")\n                    _max_hbm_rows = min(d_max_hbm,\n                                         num_blocks_total - 1)\n                    _max_logical_d = max(0,\n                                         _max_hbm_rows - tail_slots)\n                    _requested_hbm_rows = (\n                        _requested_logical_d + tail_slots)\n                    if _requested_hbm_rows > _max_hbm_rows:\n                        raise RuntimeError(\n                            \"Requested logical dedicated KV blocks do not fit \"\n                            \"in the available HBM budget: \"\n                            f\"requested={_requested_logical_d}, \"\n                            f\"max={_max_logical_d}, tail_rows={tail_slots}, \"\n                            f\"gpu_avail={gpu_avail / 1024**3:.2f} GiB\")\n                    num_dedicated_hbm = _requested_hbm_rows\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n                    logger.info(\n                        \"Tiered-serve dedicated KV: explicit logical D=%d \"\n                        \"+ tail=%d -> %d physical HBM rows \"\n                        \"(max logical D=%d)\",\n                        _requested_logical_d, tail_slots,\n                        num_dedicated_hbm, _max_logical_d)\n                else:\n                    num_dedicated_hbm = max(\n                        MIN_DED,\n                        min(d_max_hbm,\n                            num_blocks_total - o_max,\n                            num_blocks_total - 1))\n                    # Determinism: vLLM's profiling measures gpu_avail with a few\n                    # MB of run-to-run jitter -> num_dedicated_hbm flips by +-1\n                    # block run-to-run, which SHIFTS the dedicated/offloadable\n                    # boundary (block_id >= num_dedicated => offloadable).  With\n                    # the KV-offload pipeline that changes WHICH blocks are\n                    # offloaded+recompressed and makes the decode nondeterministic\n                    # (a boundary request's tokens diverge run-to-run).  Round the\n                    # boundary DOWN to a stable granularity so the jitter is\n                    # absorbed; the few reclaimed blocks just become offloadable.\n                    _g = int(os.getenv(\n                        \"TIERED_SERVE_KV_DEDICATED_GRANULARITY\", \"16\"))\n                    if _g > 1:\n                        num_dedicated_hbm = max(\n                            MIN_DED, (num_dedicated_hbm // _g) * _g)\n                    # Cap offloadable at o_max (physical hugepage/LPDDR\n                    # capacity).  The granularity round-down above lowers\n                    # num_dedicated_hbm, which would otherwise push\n                    # (num_blocks_total - num_dedicated_hbm) ABOVE o_max -- and\n                    # since num_dedicated was already pinned by the\n                    # (num_blocks_total - o_max) term, offloadable was sitting\n                    # exactly at o_max before rounding.  Without the cap each\n                    # per-layer secondary_kv requests > o_max_frag blocks and\n                    # overflows its hugepage block -> MemoryError.  The few\n                    # blocks reclaimed by the round-down just stay UNALLOCATED\n                    # (handled by the usable-shrink below), they cannot become\n                    # offloadable when offloadable is already at its physical\n                    # maximum.\n                    num_offloadable_lpddr = min(\n                        num_blocks_total - num_dedicated_hbm, o_max)\n                    logger.info(\n                        \"Tiered-serve dedicated KV: auto logical D=%d \"\n                        \"+ tail=%d -> %d physical HBM rows\",\n                        num_dedicated_hbm - tail_slots, tail_slots,\n                        num_dedicated_hbm)\n\n            logger.info(\n                \"Tiered-serve hugepage alloc: total=%d, dedicated=%d \"\n                \"(HBM), offloadable=%d (buffer+LPDDR5), \"\n                \"per_block_raw=%d, per_block_lpddr=%d bytes, \"\n                \"gpu_avail=%.2f GiB, lpddr5=%.2f GiB, \"\n                \"o_max_lpddr=%d, o_max_frag=%d\",\n                num_blocks_total, num_dedicated_hbm, num_offloadable_lpddr,\n                per_block_bytes_raw, per_block_bytes_lpddr,\n                gpu_avail / 1024**3,\n                lpddr5_bytes / 1024**3,\n                o_max_lpddr if per_block_bytes_raw > 0 else 0,\n                o_max_frag if per_block_bytes_raw > 0 else 0)\n\n            if tail_slots:\n                min_general_dedicated = 16\n                if num_dedicated_hbm < tail_slots + min_general_dedicated:\n                    raise RuntimeError(\n                        \"Tiered-serve full-block KV compression needs one \"\n                        \"resident-tail HBM row per max_num_reqs plus at least \"\n                        f\"{min_general_dedicated} normal dedicated rows, but \"\n                        f\"the HBM planner produced {num_dedicated_hbm} rows \"\n                        f\"for max_num_reqs={tail_slots}. Lower --max-num-seqs \"\n                        \"or increase the KV HBM budget.\"\n                    )\n\n            # Store the split for gpu_worker. The raw tensors below retain all\n            # physical HBM rows; only the canonical scheduler boundary excludes\n            # the reserved tail rows.\n            self._ts_num_hbm_kv_rows = num_dedicated_hbm\n            self._ts_num_tail_slots = tail_slots\n            self._ts_num_dedicated_blocks = num_dedicated_hbm - tail_slots\n            self._ts_num_offloadable_blocks = num_offloadable_lpddr\n\n        for kv_cache_tensor in kv_cache_config.kv_cache_tensors:\n            if kv_offload:\n                # Hugepage: allocate only dedicated blocks on HBM.\n                # The offloadable region (buffer + LPDDR5 secondary) is\n                # set up later in gpu_worker._maybe_init_tiered_serve.\n                num_blocks_total = kv_cache_config.num_blocks\n                per_block = (kv_cache_tensor.size // num_blocks_total\n                             if num_blocks_total > 0 else 0)\n                ded_size = num_dedicated_hbm * per_block\n                tensor = torch.zeros(\n                    ded_size, dtype=torch.int8, device=self.device)\n            else:\n                tensor = torch.zeros(\n                    kv_cache_tensor.size, dtype=torch.int8, device=self.device\n                )\n            for layer_name in kv_cache_tensor.shared_by:\n                kv_cache_raw_tensors[layer_name] = tensor\n\n        layer_names = set()\n        for group in kv_cache_config.kv_cache_groups:\n            for layer_name in group.layer_names:\n                if layer_name in self.runner_only_attn_layers:\n                    continue\n                layer_names.add(layer_name)\n        assert layer_names == set(kv_cache_raw_tensors.keys()), (\n            \"Some layers are not correctly initialized\"\n        )\n        # If an explicit (lower) dedicated request shrank the usable split\n        # below the profiled budget, reduce num_blocks so the scheduler /\n        # gpu_worker use only dedicated+offloadable; the leftover blocks stay\n        # unallocated (empty HBM/LPDDR).  Done AFTER the tensor loop so the\n        # per-block sizing above used the original (profiled) num_blocks.\n        if kv_offload:\n            _usable = (\n                num_dedicated_hbm - tail_slots + num_offloadable_lpddr\n            )\n            if 0 < _usable < kv_cache_config.num_blocks:\n                logger.info(\n                    \"Tiered-serve: dedicated request shrank usable blocks \"\n                    \"%d -> %d (D=%d + tail=%d + O=%d physical; \"\n                    \"tail rows are not scheduler blocks); %d blocks left \"\n                    \"unallocated\",\n                    kv_cache_config.num_blocks, _usable,\n                    num_dedicated_hbm - tail_slots, tail_slots,\n                    num_offloadable_lpddr,\n\n        if self.vllm_config.model_config.enable_sleep_mode:\n            from vllm.device_allocator.cumem import CuMemAllocator\n\n            allocator = CuMemAllocator.get_instance()\n            with allocator.use_memory_pool(tag=\"kv_cache\"):\n                self.model_runner.initialize_kv_cache(kv_cache_config)\n        else:\n            self.model_runner.initialize_kv_cache(kv_cache_config)\n\n        # Tiered-serve: let external cache loader configure buffer KV caches\n        self._maybe_init_tiered_serve()\n\n    def get_kv_cache_num_blocks(self) -> int:\n        \"\"\"Return the worker's post-allocation physical KV block capacity.\n\n        Tiered-serve can shrink the worker-local KVCacheConfig while laying\n        out dedicated HBM and offloadable LPDDR pools.  EngineCore queries\n        this after initialization so its scheduler cannot allocate block ids\n        that have no physical backing.\n        \"\"\"\n        return int(self.model_runner.kv_cache_config.num_blocks)\n\n    def _maybe_init_tiered_serve(self) -> None:\n        \"\"\"If tiered-serve is active, let the external cache loader\n        configure buffer KV caches on attention layers.\"\"\"\n        if not os.getenv(\"TIERED_SERVE_OFFLOAD_TYPE\"):\n            return\n        cache_loader = getattr(self.model_runner.model, \"cache_loader\", None)\n        if cache_loader is None:\n            return\n        # Provide model runner's kv_caches and attention modules\n        cache_loader.vllm_kv_caches = self.model_runner.kv_caches\n        cache_loader.vllm_attn_modules = (\n            self.vllm_config.compilation_config.static_forward_context\n        )\n        cache_loader.cache_config = self.cache_config\n\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n        from tiered_serve.huge_page_allocator import allocator as hp_allocator\n        from tiered_serve.kv_cache import vLLMKVCache\n\n        num_blocks = self.model_runner.kv_cache_config.num_blocks\n        num_layers = len(self.model_runner.kv_caches)\n        reduce_kv = (\n            os.getenv(\"TIERED_SERVE_REDUCE_KV_FOOTPRINT\", \"0\") == \"1\"\n            or os.getenv(\"TIERED_SERVE_NO_OFFLOAD_KV\", \"0\") == \"1\")\n        offload_type = os.getenv(\"TIERED_SERVE_OFFLOAD_TYPE\", \"\")\n\n        # --- Compute num_dedicated_blocks ---\n        # The hugepage planner is authoritative: it has already selected the\n        # automatic value or validated an explicit logical-D request and has\n        # removed the internal resident-tail rows. Reading the env again here\n        # would confuse logical blocks with physical HBM rows.\n        hp_num_ded = getattr(self.model_runner,\n                             '_ts_num_dedicated_blocks', 0)\n        num_dedicated_blocks = int(hp_num_ded)\n        if (num_dedicated_blocks == 0\n                and os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\")):\n            num_dedicated_blocks = int(\n                os.getenv(\"TIERED_SERVE_DEDICATED_KV_BLOCKS\"))\n        elif (num_dedicated_blocks == 0\n              and os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\")):\n            dedicated_gb = float(\n                os.getenv(\"TIERED_SERVE_DEDICATED_KV_SIZE_GB\"))\n            if dedicated_gb > 0 and num_lay