size\", 0)\n                        _block_elements = _bs * _nkv * _hd\n                        if _per_side_fn is not None and _block_elements > 0:\n                            try:\n                                _per_side = _per_side_fn(_block_elements)\n                                # K + V compressed pool bytes per block\n                                pb_compressed = 2 * _per_side\n                                pb_lpddr = pb + pb_compressed\n                                logger.info(\n                                    \"Tiered-serve KV comp budget: \"\n                                    \"backend=%s pb_raw=%d, pb_comp=%d \"\n                                    \"(%.2fx), pb_lpddr_total=%d\",\n                                    kv_backend, pb, pb_compressed,\n                                    pb_compressed / pb if pb else 0,\n                                    pb_lpddr)\n                            except Exception as _e:\n                                logger.warning(\n                                    \"Tiered-serve: failed to size \"\n                                    \"compressed pool for %s (%s); using \"\n                                    \"raw pb only\", kv_backend, _e)\n                        else:\n                            logger.info(\n                                \"Tiered-serve KV comp budget: backend=%s \"\n                                \"compressed pool not modeled; using \"\n                                \"raw pb only\",\n                                kv_backend)\n\n                    o_lpddr = (lpddr5_bytes // (n_layers * pb_lpddr)\n                               if n_layers > 0 and pb_lpddr > 0 else 0)\n                    lpp = -(-n_layers // n_kv_pages)  # ceil div\n                    o_frag = (hp_size // (lpp * pb_lpddr)\n                              if lpp > 0 and pb_lpddr > 0 else 0)\n                    o_max = min(o_lpddr, o_frag)\n\n                    MIN_DED = 16  # dedicated HBM blocks (never offl