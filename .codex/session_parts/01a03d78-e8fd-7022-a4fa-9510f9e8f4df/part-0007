e:\n        \"\"\"Hugepage 할당을 해제하고 인접한 free 블록들을 병합합니다.\"\"\"\n        ptr = tensor.data_ptr()\n        alloc_info = self.allocations.pop(ptr, None)\n        if alloc_info is None:\n            return\n\n        if alloc_info.get(\"kind\") == \"pinned\":\n            pinned = self._pinned_allocs.pop(ptr, None)\n            if pinned is not None:\n                try:\n                    cupy.cuda.runtime.freeHost(pinned[\"host_ptr\"])\n                except cupy.cuda.runtime.CUDARuntimeError as e:\n                    logger.warning(\n                        \"cudaFreeHost failed for pinned fallback \"\n                        \"(host_ptr=0x%x, size=%d): %s\",\n                        pinned[\"host_ptr\"], pinned[\"size\"], e)\n                self._pinned_total_bytes -= pinned[\"size\"]\n            return\n\n        page_type = alloc_info[\"type\"]\n        target_offset = alloc_info[\"offset\"]\n\n        for page in self.pages[page_type]:\n            if page[\"path\"] != alloc_info[\"path\"]:\n                continue\n\n            for i, block in enumerate(page[\"blocks\"]):\n                if block[\"offset\"] == target_offset and not block[\"free\"]:\n                    block[\"free\"] = True\n\n                    # 다음 블록과 병합\n                    if (i + 1 < len(page[\"blocks\"])\n                            and page[\"blocks\"][i + 1][\"free\"]):\n                        block[\"size\"] += page[\"blocks\"][i + 1][\"size\"]\n                        page[\"blocks\"].pop(i + 1)\n\n                    # 이전 블록과 병합\n                    if i > 0 and page[\"blocks\"][i - 1][\"free\"]:\n                        page[\"blocks\"][i - 1][\"size\"] += block[\"size\"]\n                        page[\"blocks\"].pop(i)\n\n                    return\n            break\n\n    def get_remaining_capacity_by_type(self, page_type: str) -> int:\n        \"\"\"지정된 페이지 타입의 총 남은 용량(bytes)을 반환합니다.\"\"\"\n        page_list = self.pages.get(page_type, [])\n        # 모든 페이지를 순회하며, 각 페이지의 모든 'free' 블록의 크기를 합산합니다.\n        return sum(block[\"size\"] for page in page_list\n                   for block in page[\"blocks\"] if block[\"free\"])\n\n    def get_usage_summary(self) -> dict:\n        summary = {}\n        for page_type, page_list in self.pages.items():\n            summary[page_type] = []\n            for i, page in enumerate(page_list):\n                used_bytes = sum(b[\"size\"] for b in page[\"blocks\"]\n                                 if not b[\"free\"])\n                num_used_blocks = sum(1 for b in page[\"blocks\"]\n                                      if not b[\"free\"])\n                num_free_blocks = len(page[\"blocks\"]) - num_used_blocks\n\n                usage_percent = used_bytes / self.hp_size if self.hp_size > 0 else 0\n\n                largest_free_block = max(\n                    (b[\"size\"] for b in page[\"blocks\"] if b[\"free\"]),\n                    default=0)\n\n                page_summary = (\n                    f\"Page {i} ({os.path.basename(page['path'])}): \"\n                    f\"{usage_percent:.2%} used ({used_bytes/1024**2:.2f} MiB). \"\n                    f\"Blocks: {num_used_blocks} used, {num_free_blocks} free. \"\n                    f\"Largest free block: {largest_free_block/1024**2:.2f} MiB\"\n                )\n                summary[page_type].append(page_summary)\n        return summary\n\n    def cleanup(self):\n        if not hasattr(self, \"pages\") or not self.pages:\n            return\n\n        logger.info(\n            \"Cleaning up huge pages (Primary Process: %s)...\",\n            self.is_primary_process)\n\n        # Free pinned fallback allocations first.\n        if getattr(self, \"_pinned_allocs\", None):\n            for tensor_ptr, pinned in list(self._pinned_allocs.items()):\n                try:\n                    cupy.cuda.runtime.freeHost(pinned[\"host_ptr\"])\n                except cupy.cuda.runtime.CUDARuntimeError as e:\n                    logger.warning(\n                        \"cudaFreeHost failed during cleanup \"\n                        \"(host_ptr=0x%x, size=%d): %s\",\n                        pinned[\"host_ptr\"], pinned[\"size\"], e)\n                self.allocations.pop(tensor_ptr, None)\n            self._pinned_allocs.clear()\n            self._pinned_total_bytes = 0\n\n        for page_list in self.pages.values():\n            for page in page_list:\n                cupy.cuda.runtime.hostUnregister(page[\"base_ptr\"])\n                page[\"mmap\"].close()\n                if self.is_primary_process and os.path.exists(page[\"path\"]):\n                    os.unlink(page[\"path\"])\n\n        if (self.is_primary_process and os.path.exists(self.dir)\n                and not os.listdir(self.dir)):\n            try:\n                os.rmdir(self.dir)\n                logger.info(\"Removed huge page directory: %s\", self.dir)\n            except OSError as e:\n                logger.error(\"Error removing directory %s: %s\", self.dir, e)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d90-6eef-7460-be37-d0055a7c7c31","create_time":1787739542.1160645}}}
