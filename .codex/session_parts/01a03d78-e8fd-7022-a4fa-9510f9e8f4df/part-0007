lace('-', '_').replace('.', '_')\n    ts_config_name = Path(args.ts_configs[0]).stem\n    log_level = logging.DEBUG if args.debug else logging.INFO\n\n    os.environ[\"TIERED_SERVE_PRIMARY_DEVICE\"] = \"cuda:0\"\n    os.environ[\"TIERED_SERVE_SECONDARY_DEVICE\"] = \"cpu\"\n\n    os.environ[\"TIERED_SERVE_OFFLOAD_TYPE\"] = \"KVWeight\"\n\n    os.environ[\"TIERED_SERVE_MODEL_ID\"] = model_id\n    os.environ[\"TIERED_SERVE_MODEL_HF_ID\"] = args.model\n    os.environ[\"TIERED_SERVE_MODULE_BLOCK_CONFIG_PATH\"] = args.ts_configs[0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03d90-6eef-7460-be37-d0055a7c7c31","create_time":1787739636.1856818}}}
