n    if window_hi <= window_lo:\n        # Degenerate window (would skip everything) — disable trimming.\n        window_lo, window_hi = 0, n\n\n    actual_output_lens: list[int] = []\n    total_input = 0\n    total_output = 0\n    completed = 0\n    good_completed = 0\n    itls: list[float] = []\n    tpots: list[float] = []\n    all_tpots: list[float] = []\n    ttfts: list[float] = []\n    e2els: list[float] = []\n    for i in range(len(outputs)):\n        in_window = window_lo <= i < window_hi\n        if outputs[i].success:\n            output_len = outputs[i].output_tokens\n\n            if not output_len:\n                # We use the tokenizer to count the number of output tokens\n                # for some serving backends instead of looking at\n                # len(outputs[i].itl) since multiple output tokens may be\n                # bundled together\n                # Note : this may inflate the output token count slightly\n                output_len = len(\n                    tokenizer(\n                        outputs[i].generated_text, add_special_tokens=False\n                    ).input_ids\n                )\n            actual_output_lens.append(output_len)\n            tpot = 0\n            if output_len > 1:\n                latency_minus_ttft = outputs[i].latency - outputs[i].ttft\n                tpot = latency_minus_ttft / (output_len - 1)\n            outputs[i].tpot = tpot\n            if in_window:\n                total_input += input_requests[i].prompt_len\n                total_output += output_len\n                if output_len > 1:\n                    tpots.append(tpot)\n                # Note: if output_len <= 1, we regard tpot as 0 for goodput\n                all_tpots.append(tpot)\n                itls += outputs[i].itl\n                ttfts.append(outputs[i].ttft)\n                e2els.append(outputs[i].latency)\n                completed += 1\n        else:\n            actual_output_lens.append(0)\n\n    if goodput_config_dict:\n        valid_metrics = []\n        slo_values = []\n\n        if \"ttft\" in goodput_config_dict:\n            valid_metrics.append(ttfts)\n            slo_values.append(\n                goodput_config_dict[\"ttft\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n        if \"tpot\" in goodput_config_dict:\n            valid_metrics.append(all_tpots)\n            slo_values.append(\n                goodput_config_dict[\"tpot\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n        if \"e2el\" in goodput_config_dict:\n            valid_metrics.append(e2els)\n            slo_values.append(\n                goodput_config_dict[\"e2el\"] / MILLISECONDS_TO_SECONDS_CONVERSION\n            )\n\n        for req_metric in zip(*valid_metrics):\n            is_good_req = all([s >= r for s, r in zip(slo_values, req_metric)])\n            if is_good_req:\n                good_completed += 1\n\n    if completed == 0:\n        warnings.warn(\n            \"All requests failed. This is likely due to a misconfiguration \"\n            \"on the benchmark arguments.\",\n            stacklevel=2,\n        )\n\n    # Calculate max output tokens per second metric\n    max_output_tokens_per_s = 0.0\n    max_concurrent_requests = 0\n\n    # Find the time range across the windowed successful requests. Warmup /\n    # cooldown requests outside [window_lo, window_hi) are excluded so the\n    # throughput and peak-rate metrics reflect steady state only.\n    successful_outputs = [\n        outputs[i]\n        for i in range(n)\n        if outputs[i].success and window_lo <= i < window_hi\n    ]\n    failed_outputs = [\n        outputs[i]\n        for i in range(n)\n        if (not outputs[i].success) and window_lo <= i < window_hi\n    ]\n    # When trimming is active, measure throughput over the wall-clock span of\n    # the windowed requests rather than the full benchmark duration.\n    throughput_dur_s = dur_s\n    if (window_lo, window_hi) != (0, n) and successful_outputs:\n        win_start = min(output.start_time for output in successful_outputs)\n        win_end = max(\n            output.start_time + output.latency for output in successful_outputs\n        )\n        throughput_dur_s = max(win_end - win_start, 1e-9)\n    if successful_outputs:\n        min_start_time = min(output.start_time for output in successful_outputs)\n        max_end_time = max(\n            output.start_time + output.latency for output in successful_outputs\n        )\n\n        # Create second buckets (ceiling to ensure we capture all time)\n        duration_seconds = int(np.ceil(max_end_time - min_start_time)) + 1\n        tokens_per_second = np.zeros(duration_seconds)\n        concurrent_requests_per_second = np.zeros(duration_seconds)\n\n        for i, output in enumerate(successful_outputs):\n            # Calculate token generation timestamp using\n            # start_time, ttft, and itl\n            token_times = [output.start_time + output.ttft]\n            current_time = token_times[0]\n            for itl_value in output.itl:\n                current_time += itl_value\n                token_times.append(current_time)\n\n            # Add tokens to second buckets\n            for token_time in token_times:\n                second_bucket = int(token_time - min_start_time)\n                if 0 <= second_bucket < duration_seconds:\n                    tokens_per_second[second_bucket] += 1\n\n            # Track concurrent requests for each second this request was active\n            request_start_second = int(output.start_time - min_start_time)\n            request_end_second = int(\n                (output.start_time + output.latency) - min_start_time\n            )\n\n            for second in range(request_start_second, request_end_second + 1):\n                concurrent_requests_per_second[second] += 1\n\n        # Find the maximum tokens per second and corresponding\n        # concurrent requests\n        if len(tokens_per_second) > 0:\n 