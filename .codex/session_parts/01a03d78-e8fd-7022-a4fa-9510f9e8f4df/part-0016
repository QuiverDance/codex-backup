--collect-time\",\n                        action=\"store_true\",\n                        help=\"Collect Time data\")\n    parser.add_argument(\"--chunked-prefill\",\n                        default=True,\n                        action=argparse.BooleanOptionalAction,\n                        help=\"Compatibility flag; this serving driver always \"\n                             \"enables chunked prefill\")\n    parser.add_argument(\n        \"--reduce-kv-footprint\",\n        action=\"store_true\",\n        help=\"Disable KV offloading; allocate all KV blocks as dedicated GPU \"\n             \"blocks (sets TIERED_SERVE_REDUCE_KV_FOOTPRINT=1).\")\n    parser.add_argument(\n        \"--no-offload-kv\",\n        action=\"store_true\",\n        help=\"Keep the entire KV cache resident in GPU HBM: no LPDDR \"\n             \"offload and no KV compression (weights are still offloaded). \"\n    # NOT part of vLLM's torch.compile cache key, so a stale cached graph from a\n    # prior run with different flags would be silently reused → wrong weights /\n    # IMA.  Force a fresh compile every run (skips both cache load and save).\n    os.environ[\"VLLM_DISABLE_COMPILE_CACHE\"] = \"1\"\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_FROZEN\"] = (\n        \"1\" if args.ats_decomp_frozen else \"0\")\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_OFFLOAD\"] = (\n        \"1\" if args.ats_decomp_offload else \"0\")\n    os.environ[\"TIERED_SERVE_USE_KV_COMP\"] = \"1\" if args.kv_comp else \"0\"\n    if args.kv_comp:\n        os.environ[\"TIERED_SERVE_KV_COMP_BACKEND\"] = args.kv_comp\n        # Keep an offloadable block's partial tail in a request-private HBM\n        # slot and publish/compress it only after all 16 tokens are written.\n        # Cache the choice before model/KV allocation; the serving hot path\n        # never reads this environment variable.  Set it to 0 for a legacy\n        # same-code A/B run.\n        if args.kv_comp in (\"p4flat\", \"p4flatcpu\"):\n            os.environ.setdefault(\n                \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"1\")\n        if args.kv_comp == \"zipserv\":\n            # ``--kv-comp zipserv`` is an explicit request for the accelerated\n            # host encoder.  Overwrite a stale inherited producer setting so\n            # serving always runs raw D2H -> C++ CPU worker compression.\n            os.environ[\"TIERED_SERVE_KV_COMP_PRODUCER\"] = \\\n                \"cpu_after_raw_swap\"\n        # P4Flat/UBLB own the tight 25,600-byte default and their encoders\n        # publish is_raw=2 for an over-stride block.  An explicit\n        # TIERED_SERVE_KV_BLOB_STRIDE (0 selects raw-safe) still overrides it.\n\n    os.environ[\"TIERED_SERVE_COLLECT_TIME\"] = \"1\" if args.collect_time else \"0\"\n\n    os.environ[\"TIERED_SERVE_GPU_RESERVE_GIB\"] = os.environ.get(\n        \"TIERED_SERVE_GPU_RESERVE_GIB\", \"6\")\n\n    engine_type = \"ts\"\n    if weight_comp_requested:\n        engine_type += \"_wc\"\n    if args.kv_comp:\n        engine_type += \"_kvc\"\n    if args.collect_time:\n        engine_type += \"_time\"\n\n    os.environ[\n        \"TIERED_SERVE_ENGINE_ID\"] = f\"{engine_type}_{model_id}\"\n\n    logger = logging.getLogger(\"vllm\")\n    logger.setLevel(log_level)\n\n    def handle_unhandled_exception(exc_type, exc_value, exc_traceback):\n        logger.critical(\"Unhandled exception\",\n                        exc_info=(exc_type, exc_value, exc_traceback))\n\n    sys.excepthook = handle_unhandled_exception\n\n    run_datetime = datetime.now().strftime('%Y%m%d_%H%M%S')\n    folder_path = (\n        # engine services the prefetched weight first and the KV bracket absorbs\n        # it (WLoad+KVLoad>GPUFwd, the cao-p4 artifact).\n        #\n        # OFF BY DEFAULT — it cleans the bracket but REGRESSES TPOT +25–31%\n        # (A/B cao-p4 b1..128: 169→210, 177→233, 204→269, 261→342).  Aliasing\n        # serialises the KV onto the weight stream, where the KV's WAR gate\n        # ``load_kv_str