g_file.write(msg + \"\\n\")\n            self._time_log_file.flush()\n        torch.cuda.nvtx.mark(msg)\n\n        # ── Per-stream breakdown: LLM / WDecomp / KVDecomp / WLoad /\n        #    KVLoad / Stall ──\n        # Each metric is the wall-clock union of the recorded CUDA\n        # events on that stream (events overlap across streams, so we\n        # de-dupe via _calc_exec_times rather than summing).\n        #\n        # Notes on what this CAN'T see:\n        # 1) frozen_compressed layers don't H2D during decode (the\n        #    compressed bytes already live in HBM).  frozen_split\n        #    layers DO H2D the compressed-exp/aux LPDDR buffers every\n        #    decode step on load_weight_stream; those are captured via\n        #    _frozen_split_h2d_(begin|end_timing)_events_cache below.\n        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\n        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\n        #    into the decomp kernel (LPDDR is read directly via\n        #    host-mapped UVA), so those H2D bytes don't surface as a\n        #    separate event — they are folded into the WDecomp time\n        #    instead.\n        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\n        #    → end_forward).  Python-loop TPOT additionally includes\n        #    scheduler / sampling / output assembly on CPU.  See the\n        #    [Step] StepLatency log emitted by\n        #    offline_offload_kvweight.py for the perf_counter step time.\n        if self.time_breakdown:\n            # ── Subtract in-graph cur_stream waits from LLM intervals ──\n            # Two distinct barriers block cur_stream INSIDE the\n            # [begin_exec, end_exec] window — during either, cur_stream is\n            # stalled, NOT running GEMM/attention:\n            #   1. KV-barrier wait: the wrapper's `_after_replay` does\n            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\n            #      (see v1_cuda_graph_wrapper.py) before eager attention.\n            #      Timed by `_v1_kv_wait_*`.\n            #   2. In-graph weight-ready wait: the FX-injected\n            #      `wait_frozen_weight` op blocks each projection GEMM until\n            #      its weight H2D/decomp lands (see graph_wait_ops.py).\n            #      Timed per (layer, component) by `_v1_wwait_*`.\n            # Counting either as LLM busy inflates ComputeUnion and hides\n            # stall.  The legacy \"Exec\" line subtracts BOTH (via\n            # attn_barrier_wait + weight_stall), so LLM here must subtract\n            # both too — otherwise the breakdown LLM reads high by the\n            # weight-wait time.  Subtract the union of all wait sub-intervals\n            # so LLM reflects actual compute on cur_stream and the stall calc\n            # treats wait time as compute-idle.\n            wait_intervals: List[Tuple[float, float]] = []\n            for wbe, wee in (\n                    try:\n                        b_t = init_event.elapsed_time(begin_ev)\n                        e_t = init_event.elapsed_time(end_ev)\n                    except RuntimeError:\n                        continue\n                    if (b_t < -0.01 or e_t < -0.01\n                            or e_t - b_t < 0.001):\n                        continue\n                    frozen_split_h2d_intervals.append((b_t, e_t))\n                frozen_split_h2d_intervals.sort(key=lambda x: x[0])\n\n            all_weight_load_intervals = (\n                weight_memcpy_times + frozen_split_h2d_intervals)\n            wload_union: List[Tuple[float, float]] = []\n            wload_brk = 0.0\n            if all_weight_load_intervals:\n                wload_union = self._calc_exec_times(\n                    all_weight_load_intervals, [])\n                wload_brk = sum(e - b for b, e in wload_union)\n\n            # Diagnostic: count how many intervals reached each bucket so\n            # we can tell whether wload_brk is low because intervals were\n            # filtered (stale events) or because the union truly is small.\n            if not self.batch_has_prefill and os.getenv(\n                    \"TIERED_SERVE_BREAKDOWN_VERBOSE\", \"0\") == \"1\":\n                wmt_sum = sum(e - b for b, e in weight_memcpy_times)\n                fsi_sum = sum(e - b for b, e in frozen_split_h2d_intervals)\n                logger.info(\n                    \"[WLoadDbg] weight_memcpy: n=%d sum=%.2fms | \"\n                    \"frozen_split_h2d: n=%d sum=%.2fms | \"\n                    \"union=%.2fms (cache_size begin=%d end=%d)\",\n                    len(weight_memcpy_times), wmt_sum,\n                    len(frozen_split_h2d_intervals), fsi_sum,\n                    wload_brk,\n                    len(begin_cache or {}),\n                    len(end_cache or {}))\n\n            kvload_union: List[Tuple[float, float]] = []\n            kvload_brk = 0.0\n            # KVLoad = the wall-clock the KV stream actually spends moving KV\n            # H2D, measured DIRECTLY by the CUDA events that bracket each\n            # layer's transfer: the raw load_kv_stream memcpys (begin/\n            # end_memcpy_kv) plus the compressed-blob H2D on batch_decomp_stream\n            # (_kv_h2d_begin .. _kv_dec_h2d).  Union-merge so back-to-back\n            # intervals on the one stream aren't double-counted, then sum.\n            # NO weight-overlap subtraction: KV H2D and weight H2D serialise on\n            # the single GH200 copy engine, so they never overlap in wall-clock\n            # and there is nothing to attribute away.\n            # Compressed-KV path: the H2D is the dedicated load_kv_stream blob\n            # transfer, bracketed TIGHTLY by _kv_h2d_begin .. _kv_dec_h2d.  Use\n            # that alone — the loader's begin/end_memcpy_kv span ALSO covers the\n            # double-buffer consumed-wait that precedes the H2D, which would\n            # inflate KVLoad with the previous layer's decode time.  Raw KV has\n  