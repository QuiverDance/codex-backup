d_record_stream,\\n)\\n\\nlogger = logging.getLogger(\\\"vllm\\\")\\n\\n\\nclass CompressedZipServTensor:\\n    \\\"\\\"\\\"ZipServ (Triple Bitmap Encoding) 압축 텐서 데이터.\\n\\n    TensorCompressor의 CompressedTensor 인터페이스와 호환되도록 설계.\\n    - .to(device) : 압축 버퍼를 GPU temp 버퍼로 복사 (CPU→GPU)\\n    - .register_temp_d_tensor(temp_d) : decompress 결과 출력 버퍼 등록\\n    - .compressed_data : 총 압축 크기 계산용 (nbytes 속성)\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, buffers: Dict[str, Any]):\\n        # GPU tensors\\n        self.sign_mantissa: torch.Tensor = buffers[\\\"sign_mantissa\\\"]\\n        self.compressed_full: torch.Tensor = buffers[\\\"compressed_full\\\"]\\n        self.bitmap1: torch.Tensor = buffers[\\\"bitmap1\\\"]\\n        self.bitmap2: torch.Tensor = buffers[\\\"bitmap2\\\"]\\n        self.bitmap3: torch.Tensor = buffers[\\\"bitmap3\\\"]\\n        self.tile_offsets_median: torch.Tensor = buffers[\\\"tile_offsets_median\\\"]\\n        self.tile_offsets_global: torch.Tensor = buffers[\\\"tile_offsets_global\\\"]\\n        # Scalar metadata\\n        self.max_high_freq_count: int = buffers[\\\"max_high_freq_count\\\"]\\n        self.max_full_count: int = buffers[\\\"max_full_count\\\"]\\n        self.start_exp: int = buffers[\\\"start_exp\\\"]\\n        self.num_global_tiles: int = buffers[\\\"num_global_tiles\\\"]\\n        self.num_tiles: int = buffers[\\\"num_tiles\\\"]\\n        self.M: int = buffers[\\\"M\\\"]\\n        self.K: int = buffers[\\\"K\\\"]\\n        # Output tensor for decompress (set by register_temp_d_tensor)\\n        self.output_tensor: Optional[torch.Tensor] = None\\n        # GPU-side temp buffers for .to() transfer\\n        self._d_sign_mantissa: Optional[torch.Tensor] = None\\n        self._d_compressed_full: Optional[torch.Tensor] = None\\n        self._d_bitmap1: Optional[torch.Tensor] = None\\n        self._d_bitmap2: Optional[torch.Tensor] = None\\n\\\"\\\"\\\"UB/LB-split BF16 compressor with triple-bitmap (palette) coding of the\\nupper byte.\\n\\nThis is a \\\"ZipServ-on-the-upper-byte\\\" variant of :mod:`ublb`:\\n\\n  * Split each BF16 word into upper byte (UB = sign + exponent-high 7 bits,\\n    i.e. bits 15..8) and lower byte (LB = exponent-low bit + mantissa,\\n    bits 7..0).\\n  * Compress UB with ZipServ's triple-bitmap encoding (TBE): a 3-bit code\\n    per element packed into three uint64 bitmaps per 64-element tile.\\n  * Store LB **raw** (uncompressed).\\n\\nUnlike ZipServ-TBE on the pure 8-bit exponent — where the frequent values\\nare *consecutive* so the code maps as ``exp = start_exp + code`` — the\\nupper byte's MSB is the sign, so its frequent values split into two\\nclusters (``+`` and ``-``) that are 0x80 apart and are **not** consecutive.\\nWe therefore keep the sign attached (no sign/exp separation) and map the\\n3-bit code through a small per-tensor **palette** of the 7 most frequent\\nupper-byte values instead of a consecutive window:\\n\\n    code 0       -> out-of-palette  (raw upper byte 