ressed CD3 struct.\\\"\\\"\\\"\\n\\n    _BUFFER_ATTRS = (\\n        \\\"codes\\\",\\n        \\\"sign_mantissa\\\",\\n        \\\"thread_bases\\\",\\n        \\\"tile_exception_offsets\\\",\\n        \\\"entries20x3\\\",\\n    )\\n    _BUFFER_ATTR_D_PAIRS = tuple(\\n        (attr, f\\\"_d_{attr}\\\") for attr in _BUFFER_ATTRS)\\n\\n    def __init__(self, c_struct):\\n        self._c = c_struct\\n        self.output_tensor: Optional[torch.Tensor] = None\\n        self._h2d_views: Optional[tuple[torch.Tensor, ...]] = None\\n        self._h2d_sources: Optional[tuple[torch.Tensor, ...]] = None\\n        self._host_slab: Optional[torch.Tensor] = None\\n        self._device_slab: Optional[torch.Tensor] = None\\n        self._slab_layout: Optional[tuple[tuple, ...]] = None\\n        self._copy_slab = False\\n        for attr, device_attr in self._BUFFER_ATTR_D_PAIRS:\\n            setattr(self, attr, getattr(c_struct, attr))\\n            setattr(self, device_attr, None)\\n\\n    @property\\nrg: tests/conftest.py: IO error for operation on tests/conftest.py: No such file or directory (os error 2)\\n/lambda/nfs/whchoi/run_experiment_tmux.sh:89:\\t    \\\"LD_PRELOAD=/root/projects/tiered-serve/etc/stack_pool.so numactl -m 0 python serve_offload_kvweight.py --model $MODEL $EXTRA_FLAGS --ts-configs $cfg\\\" Enter\\n/lambda/nfs/whchoi/startup-patches/archive/tiered-serve-pre-0f12fea/serving_performance_suite.patch:19:+STACK_POOL_SO=\\\"${REPO_ROOT}/etc/stack_pool.so\\\"\\n/lambda/nfs/whchoi/startup-patches/archive/tiered-serve-pre-0f12fea/serving_performance_suite.patch:270:+CLEAN_ENV=(env -u LD_PRELOAD -u RESULT_DIR -u CUDA_VISIBLE_DEVICES \\\\\\n/lambda/nfs/whchoi/startup-patches/archive/tiered-serve-pre-0f12fea/serving_performance_suite.patch:413:+    \\\"LD_PRELOAD=${STACK_POOL_SO}\\\"\\n/lambda/nfs/whchoi/startup-patches/archive/tiered-serve-pre-0f12fea/cd3_current.patch:1567:+STACK_POOL=\\\"${REPO_ROOT}/etc/stack_pool.so\\\"\\n/lambda/nfs/whchoi/startup-patches/archive/ti