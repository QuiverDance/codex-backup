resources.append((store, pool))\\n        return store, pool, host, arenas\\n\\n    yield create\\n    for store, pool in reversed(resources):\\n        store.clear()\\n        pool.close()\\n\\n\\ndef stage(store, ids, slots, generations, k_counts, v_counts, scratch_words=8):\\n    rows = len(ids)\\n    scratch = [torch.arange(rows * scratch_words, dtype=torch.int64).reshape(\\n        rows, scratch_words) + side * 1000 for side in range(2)]\\n    counts = [torch.tensor(values, dtype=torch.int32) for values in (k_counts, v_counts)]\\n    batch = store.stage(\\n        np.asarray(ids, dtype=np.int64), np.asarray(slots, dtype=np.int64),\\n        np.asarray(generations, dtype=np.int64), [\\\"request\\\"] * rows,\\n        *scratch, *counts)\\n    return batch, scratch, counts\\n\\n\\ndef copied_words(arenas, spans):\\n    \\\"\\\"\\\"Read the real pinned entry ranges selected by native descriptors.\\\"\\\"\\\"\\n    result = torch.empty(sum(span[2] for span in spans) // 8, dtype=torch.int64)\\n    for source, destination, size in spans:\\n        arena = next(arena for arena in arenas\\n                     if arena.data_ptr() <= source < arena.data_ptr() + arena.numel())\\n        start = source - arena.data_ptr()\\n        result[destination // 8:(destination + size) // 8] = arena[\\n            start:start + size].view(torch.int64)\\n    return result\\n\\n\\ndef test_hybrid_routes_nonidentity_body_slots_and_sparse_entries(make_store):\\n    store, pool, host, arenas = make_store()\\n    ids, slots = [6, 2, 5, 1], [1, 5, 3, 2]\\n    counts = ([6, 3, 9, 6], [3, 6, 3, 9])\\n    batch, scratch, _ = stage(store, ids, slots, [1] * 4, *counts)\\n    store.publish(batch, np.ones(4, dtype=np.uint8))\\n    plan = store.prepare(np.asarray([2, 6, 1], dtype=np.int64))\\n    try:\\n        snapshot = plan.debug_snapshot()\\n        assert snapshot[\\\"block_ids\\\"] == [6, 1, 2]\\n        assert snapshot[\\\"storage_slots\\\"] == [1, 2, 5]\\n        for side_index, side in enumerate((\\\"k\\\", \\\"v\\\")):\\n            stride = host[side_index].shape[1]\\n            assert [list(span) for span in snapshot[f\\\"{side}_body_spans\\\"]] == [\\n                [host[side_index].data_ptr() + stride, 0, 2 * stride],\\n                [host[side_index].data_ptr() + 5 * stride, 2 * stride, stride],\\n            ]\\n            words = copied_words(arenas, snapshot[f\\\"{side}_entry_spans\\\"])\\n            selected_rows = [ids.index(block_id) for block_id in snapshot[\\\"block_ids\\\"]]\\n            selected_words = [(counts[side_index][row] + 2) // 3 for row in selected_rows]\\n            # The inactive record's entries must not cross H2D as a gap.\\n            assert len(words) == sum(selected_words)\\n            for row, offset, count in zip(\\n                    selected_rows, snapshot[f\\\"{side}_offsets\\\"], selected_words):\\n                assert torch.equal(words[offset:offset + count], scratch[side_index][row, :count])\\n    finally:\\n        plan.release_sources()\\n    assert pool.stats()[\\\"reader_leases\\\"] == 0\\n\\n\\ndef test_hybrid_large_unsorted_entries_preserve_sparse_routes(make_store):\\n    count = 513\\n    store, pool, _, arenas = make_store(entry_segments=2 * count, capacity=count)\\n    ids = list(range(count))\\n    slots = list(reversed(ids))\\n    counts = ([3 * (1 + block_id % 8) for block_id in ids],\\n              [3 * (1 + (block_id * 3) % 8) for block_id in ids])\\n    batch, scratch, _ = stage(store, ids, slots, [1] * count, *counts)\\n    store.publish(batch, np.ones(count, dtype=np.uint8))\\n    active = np.asarray([block_id for block_id in ids if block_id % 4 != 1], dtype=np.int64)\\n    # More than 256 selected entries, with reverse body slots and entries\\n    # spanning multiple key bytes, exercise radix sorting on both sides.\\n    plan = store.prepare(active)\\n    try:\\n        snapshot = plan.debug_snapshot()\\n        assert snapshot[\\\"block_ids\\\"] == active[::-1].tolist()\\n        assert snapshot[\\\"storage_slots\\\"] == sorted(slots[block_id] for block_id in active)\\n        for side_index, side in enumerate((\\\"k\\\", \\\"v\\\")):\\n            spans = snapshot[f\\\"{side}_entry_spans\\\"]\\n            addresses = [span[0] for span in spans]\\n            assert addresses == sorted(addresses)\\n            words = copied_words(arenas, spans)\\n            assert len(words) == sum(counts[side_index][block_id] // 3 for block_id in active)\\n            for block_id, offset in zip(snapshot[\\\"block_ids\\\"], snapshot[f\\\"{side}_offsets\\\"]):\\n                word_count = counts[side_index][block_id] // 3\\n                assert torch.equal(words[offset:offset + word_count],\\n                                   scratch[side_index][block_id, :word_count])\\n    finally:\\n        plan.release_sources()\\n    assert pool.stats()[\\\"reader_leases\\\"] == 0\\n\\n\\ndef test_hybrid_empty_entries_and_overflow_on_either_side(make_store):\\n    store, pool, _, _ = make_store()\\n    batch, _, counts = stage(\\n        store, [0, 1, 2], [4, 1, 3], [1] * 3,\\n        [0, 13, 3], [0, 3, 13], scratch_words=4)\\n    assert batch.has_overflow\\n    assert batch.k_counts.dtype == batch.v_counts.dtype == torch.int32\\n    counts[0].fill_(99)\\n    assert batch.k_counts.tolist() == [0, 13, 3]\\n    assert batch.v_counts.tolist() == [0, 3, 13]\\n    store.publish(batch, np.ones(3, dtype=np.uint8))\\n    assert pool.stats()[\\\"live_entry_bytes\\\"] == 0\\n    plan = store.prepare(np.asarray([0], dtype=np.int64))\\n    try:\\n        snapshot = plan.debug_snapshot()\\n        for side in (\\\"k\\\", \\\"v\\\"):\\n            assert snapshot[f\\\"{side}_entry_spans\\\"] == []\\n            assert snapshot[f\\\"{side}_offsets\\\"] == [0]\\n    finally:\\n        plan.release_sources()\\n    for block_id in (1, 2):\\n        with pytest.raises(RuntimeError):\\n            store.prepare(np.asarray([block_id], dtype=np.int64))\\n\\n\\ndef test_hybrid_retired_readers_hold_budget_and_stale_pending_cannot_republish(make_store):\\n    store, pool, _, arenas = make_store(entry_segments=2)\\n    ids = np.asarray([0], dtype=np.int64)\\n    original, _, _ = stage(store, [0], [3], [1], [24], [24])\\n    cancelled, _, _ = stage(store, [0], [3], [1], [0], [0])\\n    stale, _, _ = stage(store, [0], [3], [1], [0], [0])\\n    store.publish(original, np.ones(1, dtype=np.uint8))\\n    plan = store.prepare(ids)\\n    source_bytes = arenas[0].clone()\\n    try:\\n        store.retire(ids)\\n        # The compressor's frozen ownership check rejects completion of work\\n        # whose logical block was freed while the worker was still running.\\n        store.publish(cancelled, np.zeros(1, dtype=np.uint8))\\n        with pytest.raises(RuntimeError):\\n            store.prepare(ids)\\n        stats = pool.stats()\\n        assert stats[\\\"capacity_bytes\\\"] == 128\\n        assert stats[\\\"reader_leases\\\"] > 0\\n        with pytest.raises(RuntimeError):\\n            stage(store, [0], [5], [2], [24], [24])\\n        assert torch.equal(arenas[0], source_bytes)\\n        assert pool.stats()[\\\"capacity_bytes\\\"] == 128\\n    finally:\\n        plan.release_sources()\\n\\n    assert pool.stats()[\\\"reader_leases\\\"] == 0\\n    replacement, _, _ = stage(store, [0], [5], [2], [24], [24])\\n    store.publish(replacement, np.ones(1, dtype=np.uint8))\\n    with pytest.raises(RuntimeError):\\n        store.publish(stale, np.ones(1, dtype=np.uint8))\\n    current = store.prepare(ids)\\n    try:\\n        assert current.debug_snapshot()[\\\"storage_slots\\\"] == [5]\\n        assert pool.stats()[\\\"capacity_bytes\\\"] == 128\\n    finally:\\n        current.release_sources()\\n\\n\\ndef test_hybrid_count_views_retain_pending_metadata_budget(make_store):\\n    store, _, _, _ = make_store()\\n    ids = list(range(8))\\n    batch, _, _ = stage(store, ids, ids, [1] * 8, [0] * 8, [0] * 8)\\n    store.publish(batch, np.ones(8, dtype=np.uint8))\\n    counts = batch.k_counts.numpy()\\n    del batch\\n    with pytest.raises(RuntimeError, match=\\\"pending record budget\\\"):\\n        stage(store, [0], [0], [2], [0], [0])\\n    assert counts.tolist() == [0] * 8\\n    del counts\\n    replacement, _, _ = stage(store, [0], [0], [2], [0], [0])\\n    store.publish(replacement, np.ones(1, dtype=np.uint8))\\n\\\"\\\"\\\"Hybrid body slots and exception scratch must use independent row routing.\\\"\\\"\\\"\\n\\nimport pytest\\nimport torch\\n\\n\\ndef body_fields(slots, rows, columns, delta_bits, base_rows):\\n    tiles = rows * columns // 4096\\n    widths = (rows * columns * delta_bits // 8, rows * columns,\\n              tiles * (256 // base_rows), (tiles + 1) * 4)\\n    stride = (sum(widths) + 127) // 128 * 128\\n    storage = torch.full((slots, stride), 0xA5, dtype=torch.uint8)\\n    fields = []\\n    offset = 0\\n    for index, width in enumerate(widths):\\n        field = storage[:, offset:offset + width]\\n        fields.append(field.view(torch.int32) if index == 3 else field)\\n        offset += width\\n    return storage, fields\\n\\n\\ndef scratch(rows, capacity):\\n    # Strides also differ from persistent body strides.\\n    entries = torch.full((rows, capacity + 2), -1, dtype=torch.int64)[:, :capacity]\\n    counts = torch.full((rows * 2,), -1, dtype=torch.int32)[::2]\\n    return entries, counts\\n\\n\\n@pytest.mark.parametrize(\\\"capacity\\\", [1, (128 * 128 + 2) // 3])\\ndef test_hybrid_matches_existing_encoder_with_independent_scratch_rows(capacity):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext as ext\\n\\n    rows = columns = 128\\n    generator = torch.Generator().manual_seed(731)\\n    sources = [torch.randint(-32768, 32768, (4, rows, columns),\\n                             dtype=torch.int16, generator=generator)\\n               for _ in range(2)]\\n    sources[0][0].zero_()  # Include a record with no exception entries.\\n    ids = torch.tensor([3, 0, 2], dtype=torch.int64)\\n    slots = torch.tensor([5, 1, 4], dtype=torch.int64)\\n    existing = [body_fields(7, rows, columns, ext.kv_delta_bits,\\n                            ext.compiled_base_rows()) for _ in range(2)]\\n    hybrid = [body_fields(7, rows, columns, ext.kv_delta_bits,\\n                          ext.compiled_base_rows()) for _ in range(2)]\\n    old_scratch = [scratch(7, capacity) for _ in range(2)]\\n    chunk_scratch = [scratch(4, capacity) for _ in range(2)]\\n    ext.host_encode_chunk_delta3_kv_blocks(\\n        *sources, ids, slots,\\n        [*existing[0][1], *old_scratch[0]],\\n        [*existing[1][1], *old_scratch[1]], rows, columns)\\n    ext.host_encode_chunk_delta3_kv_hybrid_blocks(\\n        *sources, ids, slots, hybrid[0][1], hybrid[1][1],\\n        chunk_scratch[0][0], chunk_scratch[1][0],\\n        chunk_scratch[0][1], chunk_scratch[1][1], rows, columns)\\n\\n    for (expected_body, _), (actual_body, _), old, new in zip(\\n            existing, hybrid, old_scratch, chunk_scratch):\\n        assert torch.equal(actual_body, expected_body)\\n        assert torch.equal(new[0][:len(ids)], old[0][slots])\\n        assert torch.equal(new[1][:len(ids)], old[1][slots])\\n        assert (new[0][len(ids):] == -1).all()\\n        assert (new[1][len(ids):] == -1).all()\\n        if capacity == 1:\\n            # Report the true count so the caller can select raw fallback.\\n            assert int(new[1][0]) > capacity * 3\\n        else:\\n            assert (new[1][:len(ids)] <= capacity * 3).all()\\n\\n\\n@pytest.mark.parametrize(\\\"invalid\\\", [\\\"scratch_rows\\\", \\\"body_slot\\\", \\\"duplicate_slot\\\"])\\ndef test_hybrid_rejects_invalid_routing_before_either_side_writes(invalid):\\n    from tiered_serve.cpp_exts import chunk_delta3_ext as ext\\n\\n    rows = columns = 64\\n    sources = [torch.zeros((3, rows, columns), dtype=torch.int16) for _ in range(2)]\\n    ids = torch.tensor([2, 0, 1], dtype=torch.int64)\\n    slots = torch.tensor([4, 1, 3], dtype=torch.int64)\\n    bodies = [body_fields(5, rows, columns, ext.kv_delta_bits,\\n                          ext.compiled_base_rows()) for _ in range(2)]\\n    chunks = [scratch(3, 1), scratch(2 if invalid == \\\"scratch_rows\\\" else 3, 1)]\\n    if invalid == \\\"body_slot\\\":\\n        slots[-1] = 5\\n    elif invalid == \\\"duplicate_slot\\\":\\n        slots[-1] = slots[0]\\n    with pytest.raises(RuntimeError, match=\\\"entries20x3|slot\\\"):\\n        ext.host_encode_chunk_delta3_kv_hybrid_blocks(\\n            *sources, ids, slots, bodies[0][1], bodies[1][1],\\n            chunks[0][0], chunks[1][0], chunks[0][1], chunks[1][1], rows, columns)\\n    assert all((storage == 0xA5).all() for storage, _ in bodies)\\n    assert all((buffer == -1).all() for side in chunks for buffer in side)\\n\\\"\\\"\\\"Lightweight KV codec capabilities used before compressors are constructed.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nfrom dataclasses import dataclass\\nfrom typing import Optional\\n\\n\\n_P4_LAYOUTS = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"ublb_flat\\\", \\\"ublb_tbe\\\"})\\n_FULL_BLOCK_ONLY = frozenset({\\\"p4flat\\\", \\\"p4flatcpu\\\", \\\"chunk_delta3\\\"})\\ndef chunk_delta3_base_rows() -> int:\\n    value = int(os.getenv(\\\"TIERED_SERVE_CD3_BASE_ROWS\\\", \\\"16\\\"))\\n    if value not in (1, 16, 32, 64):\\n        raise ValueError(\\n            \\\"TIERED_SERVE_CD3_BASE_ROWS must be 1, 16, 32, or 64\\\")\\n    return value\\n\\n\\ndef chunk_delta3_kv_delta_bits() -> int:\\n    \\\"\\\"\\\"Fixed exponent delta width for the KV codec.\\\"\\\"\\\"\\n    return 3\\n\\n\\ndef supports_full_block_only(backend: str) -> bool:\\n    return backend.lower() in _FULL_BLOCK_ONLY\\n\\n\\ndef _align_up(value: int, alignment: int) -> int:\\n    return (value + alignment - 1) // alignment * alignment\\n\\n\\ndef chunk_delta3_body_bytes(elements: int) -> int:\\n    \\\"\\\"\\\"Return codec payload through the last tile exception offset.\\\"\\\"\\\"\\n    if elements <= 0 or elements % 4096:\\n        raise ValueError(\\n            \\\"ChunkDelta3 KV block size must be a positive multiple of 4096\\\")\\n    tiles = elements // 4096\\n    body_end = (elements * chunk_delta3_kv_delta_bits() // 8 + elements\\n                + tiles * (256 // chunk_delta3_base_rows()))\\n    return _align_up(body_end, 4) + (tiles + 1) * 4\\n\\n\\ndef chunk_delta3_body_stride(elements: int) -> int:\\n    \\\"\\\"\\\"Return the 128-byte-aligned fixed CSR body row size.\\\"\\\"\\\"\\n    return _align_up(chunk_delta3_body_bytes(elements), 128)\\n\\n\\ndef chunk_delta3_exception_capacity(elements: int) -> int:\\n    \\\"\\\"\\\"Return CPU encode scratch capacity in logical Packed20 entries.\\n\\n    Serving transfers a compact CSR arena containing only the words actually\\n    used, so scratch capacity no longer determines H2D size.  By default the\\n    scratch holds every exception count for which the exact CSR representation\\n    remains smaller than raw BF16.  Larger records are restored from the\\n    authoritative raw secondary KV.\\n\\n    \\\"\\\"\\\"\\n    body_stride = chunk_delta3_body_stride(elements)\\n    # One int64 CSR word offset is transferred per block. Require the\\n    # compressed representation to be strictly smaller than raw BF16.\\n    available = elements * 2 - body_stride - 8\\n    return max(3, ((max(1, available) - 1) // 8) * 3)\\n\\n\\n@dataclass(frozen=True)\\nclass ChunkDelta3HybridMemoryBudget:\\n    total_bytes: int\\n    body_bytes: int\\n    entry_budget_bytes: int\\n    scratch_bytes: int\\n    count_bytes: int\\n    planner_bytes: int\\n    scratch_workers: int\\n    scratch_rows_per_worker: int\\n\\n\\ndef chunk_delta3_hybrid_memory_budget(\\n        elements: int, max_blocks: int, n_layers: int, n_workers: int,\\n        chunk_blocks: int, planner_bytes: int = 0\\n        ) -> ChunkDelta3HybridMemoryBudget:\\n    \\\"\\\"\\\"Partition the original compressed-host allowance; entries have one owner.\\\"\\\"\\\"\\n    if min(max_blocks, n_layers, n_workers, chunk_blocks) <= 0 or planner_bytes < 0:\\n        raise ValueError(\\\"hybrid memory planning requires positive capacities\\\")\\n    rows = max_blocks + 1\\n    per_side = compressed_block_bytes(\\\"chunk_delta3\\\", elements)\\n    total = per_side * rows * n_layers * 2\\n    body = chunk_delta3_body_stride(elements) * rows * n_layers * 2\\n    counts = rows * n_layers * 2 * 4\\n    workers = min(n_workers, n_layers)\\n    scratch_rows = min(chunk_blocks, max(1, rows * n_layers // (4 * workers)))\\n    scratch = ((chunk_delta3_exception_capacity(elements) // 3 * 8 + 4)\\n               * scratch_rows * workers * 2)\\n    entries = total - body - counts - scratch - planner_bytes\\n    if entries <= 0:\\n        raise ValueError(\\n            f\\\"CD3 hybrid host budget exhausted: total={total}, body={body}, \\\"\\n            f\\\"scratch={scratch}, counts={counts}, planner={planner_bytes}\\\")\\n    return ChunkDelta3HybridMemoryBudget(\\n        total, body, entries, scratch, counts, planner_bytes, workers, scratch_rows)\\n\\n\\ndef _zipserv_dims(elements: int) -> tuple[int, int]:\\n    for columns in (128, 64, 256, 192, 320):\\n        if elements % columns == 0 and (elements // columns) % 64 == 0:\\n            return elements // columns, columns\\n    raise ValueError(\\n        f\\\"Cannot find 64-aligned ZipServ dimensions for {elements} elements\\\")\\n\\n\\ndef compressed_block_bytes(backend: str, elements: int) -> Optional[int]:\\n    \\\"\\\"\\\"Return the persistent host-pool bytes for one K or V block.\\n\\n    ``None`` means that the backend has no fixed-size persistent pool model.\\n    This module deliberately avoids importing CUDA extensions so vLLM can use\\n    it during memory planning.\\n    \\\"\\\"\\\"\\n    backend = backend.lower()\\n    if backend == \\\"zipserv\\\":\\n        rows, columns = _zipserv_dims(elements)\\n        sign_mantissa = rows * columns\\n      