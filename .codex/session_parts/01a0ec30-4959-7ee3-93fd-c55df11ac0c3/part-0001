ected in zip(output, source if expected_source is None else expected_source):\\n            assert torch.equal(actual[blocks].cpu().view(torch.int16), expected[blocks].view(torch.int16))\\n        snapshot = metrics.snapshot()\\n        assert snapshot[\\\"bytes_complete\\\"] == snapshot[\\\"timing_complete\\\"] == 1\\n        assert snapshot[\\\"cd3_k_h2d_bytes\\\"] + snapshot[\\\"cd3_v_h2d_bytes\\\"] == snapshot[\\\"kv_h2d_bytes\\\"]\\n        assert snapshot[\\\"cd3_copy_descriptors\\\"] > 0\\n        if storage == \\\"hybrid\\\":\\n            assert snapshot[\\\"kv_h2d_bytes\\\"] == (snapshot[\\\"kv_payload_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_metadata_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_alignment_bytes\\\"])\\n            assert snapshot[\\\"cd3_gap_bytes\\\"] == 0\\n        else:\\n            assert snapshot[\\\"cd3_csr_garbage_bytes\\\"] <= snapshot[\\\"cd3_gap_bytes\\\"]\\n        assert snapshot[\\\"cd3_storage\\\"] == storage\\n        assert snapshot[\\\"cd3_execution\\\"] == (\\\"serial\\\" if storage == \\\"csr\\\" else \\\"pipeline\\\")\\n        return snapshot\\n\\n    try:\\n        submit(ids, 1)\\n        # Exercise the serving CPU profiler through a real decode and its JSON\\n        # output. The remaining submissions run with the usual profiling state.\\n        with monkeypatch.context() as profiling:\\n            profiling.setattr(cd3_cpu_profile, \\\"enabled\\\", True)\\n            profiling.setattr(cd3_cpu_profile, \\\"_totals\\\", {})\\n            profiling.setenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\", str(tmp_path))\\n            decode(ids[:2])\\n            cd3_cpu_profile.flush()\\n            report = next(tmp_path.glob(\\\"cd3_cpu_profile.*.json\\\"))\\n            categories = json.loads(report.read_text())[\\\"categories\\\"]\\n            for field in (\\\"plan_cpu_ms\\\", \\\"stage_cpu_ms\\\"):\\n                assert categories[f\\\"load.{field}\\\"][\\\"calls\\\"] == 1\\n                assert categories[f\\\"load.{field}\\\"][\\\"total_ms\\\"] > 0\\n            if storage == \\\"hybrid\\\":\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"calls\\\"] == 1\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"total_ms\\\"] > 0\\n        cached_plan = compressor._decode_plans[0]\\n        if storage == \\\"csr\\\":\\n            native = cached_plan.serial_native\\n            assert native is not None\\n            assert native.copy_count == (2 * native.span_count + 3\\n                                         + sum(words > 0 for words in cached_plan.entry_words))\\n            assert native.wire_bytes == (sum(cached_plan.side_payload)\\n                                         + sum(cached_plan.side_alignment)\\n                                         + sum(cached_plan.side_gap)\\n                                         + cached_plan.storage_rows * 24)\\n        submit(ids[:2], 1, layer_id=1, values=other_source)\\n        # Interleaved layers bring the cached plan back to its original\\n        # ring. Different layer data makes stale ring contents observable.\\n        decode(ids[:2], layer_id=1, expected_source=other_source)\\n        decode(ids[:2])\\n        assert compressor._decode_plans[0] is cached_plan\\n        if storage == \\\"hybrid\\\":\\n            assert cached_plan.native_plan is not None\\n            assert not hasattr(cached_plan, \\\"native_plans\\\")  # One plan for both rings.\\n            # A subsequent submission uses the other ring with the same plan.\\n            decode(ids[:2])\\n            assert compressor._decode_plans[0] is cached_plan\\n        decode(ids)  # Multiple staging chunks, including both ring slots.\\n        plans = [compressor._decode_plans[0],\\n                 *compressor._decode_extra_plans[0].values()]\\n        snapshot = decode(ids)\\n        assert snapshot[\\\"cd3_plan_builds\\\"] == 0\\n        assert snapshot[\\\"cd3_plan_hits\\\"] == len(plans)\\n        assert [compressor._decode_plans[0],\\n                *compressor._decode_extra_plans[0].values()] == plans\\n        # Replacing an equally sized active set must rebuild the routes.\\n        decode(ids[:2])\\n        previous = compressor._decode_plans[0]\\n        decode(ids[-2:])\\n        assert compressor._decode_plans[0] is not previous\\n        decode(ids[::2])  # Sparse records must not copy inactive prefixes.\\n        # Re-encoding a live slot must use its fresh exception payload,\\n        # even when an old packed record could otherwise be retained.\\n        for values in source:\\n            bits = values.view(torch.int16)\\n            bits[bits == 1] = 32640\\n        submit(ids, 2)\\n        decode(ids)\\n        compressor.free_persistent_blocks([3, 8])\\n        for values in source:\\n            values[3].fill_(2)\\n            values[8].fill_(4)\\n            values[3].view(-1)[::137] = 0\\n            values[8].view(-1)[::149] = 0\\n        submit([3, 8], 2)\\n        decode(ids)\\n        assert torch.all(output[0][0] == -5)\\n        old_values = [values[3].clone() for values in source]\\n        delayed_stream = compressor.load_kv_stream\\n        with torch.cuda.stream(delayed_stream):\\n            torch.cuda._sleep(10_000_000)\\n        compressor.prepare_active_set(ids, np.asarray(ids, dtype=np.int64))\\n        compressor.decompress_batch(0, ids, output)\\n        with torch.cuda.stream(compressor.batch_decomp_stream):\\n            old_output = [values[3].clone() for values in output]\\n        # Reuse the physical slot while its preceding H2D is still queued.\\n        # The encoder must wait before overwriting that body's source row.\\n        compressor.free_persistent_blocks([3])\\n        for values in source:\\n            values[3].fill_(8)\\n            values[3].view(-1)[::171] = 0\\n        submit([3], 3)\\n        decode(ids)\\n        for actual, expected in zip(old_output, old_values):\\n            assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n\\n        # A reader of the dense output runs independently of compressed H2D.\\n        # Mirror the loader's reader event gate on the decode stream only.\\n        submit([12], 1, layer_id=1, values=other_source)\\n        decode([12], layer_id=1, expected_source=other_source)\\n        decode(ids)\\n        expected_reads = [values[ids].clone() for values in source]\\n        reader = torch.cuda.Stream()\\n        reader.wait_stream(compressor.batch_decomp_stream)\\n        with torch.cuda.stream(reader):\\n            torch.cuda._sleep(10_000_000)\\n            read_output = [value[ids].clone() for value in output]\\n            reader_done = torch.cuda.Event()\\n            reader_done.record(reader)\\n        compressor.batch_decomp_stream.wait_event(reader_done)\\n        compressor.decompress_batch(0, ids, output)\\n\\n        # Keep the live set fixed while retirement, slot reuse and same-size\\n        # overwrites overlap queued transfers. Only the final drain below\\n        # waits for decode; each saved output remains a real GPU consumer.\\n        stable_layer_plan = compressor._decode_plans[1]\\n        saved = []\\n        initial_capacity = pool.stats()[\\\"capacity_bytes\\\"] if pool is not None else 0\\n        for generation in range(4, 24):\\n            compressor.free_persistent_blocks([3])\\n            for values in source:\\n                values[3].fill_(generation)\\n                values[3].view(-1)[::171] = 0\\n            submit([3], generation)\\n            compressor.prepare_active_set(ids, np.asarray(ids, dtype=np.int64))\\n            compressor.decompress_batch(0, ids, output)\\n            with torch.cuda.stream(compressor.batch_decomp_stream):\\n                saved.append(([value[3].clone() for value in output], generation))\\n            assert compressor._decode_plans[1] is stable_layer_plan\\n            if pool is not None:\\n                assert pool.stats()[\\\"capacity_bytes\\\"] == initial_capacity\\n            else:\\n                assert all(state.entries.numel() <= state.max_words\\n                           for state in compressor._persistent_csr[0].values())\\n        compressor.batch_decomp_stream.synchronize()\\n        for values, generation in saved:\\n            expected = torch.full((64, 64), generation, dtype=torch.bfloat16)\\n            expected.view(-1)[::171] = 0\\n            for actual in values:\\n                assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n        for actual, expected in zip(read_output, expected_reads):\\n            assert torch.equal(actual.cpu().view(torch.int16), expected.view(torch.int16))\\n        compressor._reclaim_csr_plans()\\n        assert not compressor._retired_csr_plans\\n        if storage == \\\"csr\\\":\\n            # A prepared native decoder must follow replacement dense outputs,\\n            # and the uninstrumented path must submit the same GPU work.\\n            old_plan = compressor._decode_plans[0]\\n            output = [torch.full_like(value, -7) for value in output]\\n            compressor._tb = False\\n            decode(ids)\\n            assert compressor._decode_plans[0] is not old_plan\\n        compressor.free_persistent_blocks(ids)\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n        compressor.stop_kv_compress_workers()  # Explicit cleanup is idempotent.\\n        assert not compressor._retired_csr_plans\\n        assert not compressor._pending_compress\\n        if storage == \\\"hybrid\\\":\\n            assert pool.stats()[\\\"reader_leases\\\"] == 0\\n        metrics.close()\\n#!/bin/bash\\n# Usage: bash scripts/serving/client/azure_conv.sh MODEL_ALIAS [TS_CONFIG] [REQUEST_RATE...] [--dataset-path PATH]\\n#   MODEL_ALIAS  : llama70b, llama70b-fp8, qwen72b\\n#   TS_CONFIG    : (선택) 실행 중인 ts-config 이름 또는 경로. 결과 저장 디렉토리 키로 사용.\\n#                  생략 시 \\\"manual\\\". 오케스트레이터가 $cfg를 그대로 넘김.\\n#   REQUEST_RATE : (선택) 측정할 request rate. 1개 이상 지정 시 모델별 스윕 대신 그 값들만 측정.\\n#                  예: ... llama70b manual 0.8 1.0 1.2\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\nsource \\\"${SCRIPT_DIR}/../model_map.sh\\\"\\n\\nDATASET_PATH=\\\"${AZURE_CONV_DATASET_PATH:-}\\\"\\nPOSITIONAL_ARGS=()\\nwhile (($#)); do\\n  case \\\"$1\\\" in\\n    --dataset-path)\\n      if (($# < 2)); then\\n        echo \\\"--dataset-path requires a value\\\" >&2\\n        exit 2\\n      fi\\n      DATASET_PATH=\\\"$2\\\"\\n      shift 2\\n      ;;\\n    *)\\n      POSITIONAL_ARGS+=(\\\"$1\\\")\\n      shift\\n      ;;\\n  esac\\ndone\\nset -- \\\"${POSITIONAL_ARGS[@]}\\\"\\nDATASET_ARGS=()\\nif [[ -n \\\"$DATASET_PATH\\\" ]]; then\\n  if [[ ! -f \\\"$DATASET_PATH\\\" ]]; then\\n    echo \\\"dataset not found: ${DATASET_PATH}\\\" >&2\\n    exit 2\\n  fi\\n  DATASET_ARGS=(--dataset-path \\\"$DATASET_PATH\\\")\\nfi\\n\\nMODEL_ALIAS=\\\"${1:?Usage: $0 MODEL_ALIAS [TS_CONFIG] (e.g. llama70b, llama70b-fp8, qwen72b)}\\\"\\nresolve_model \\\"$MODEL_ALIAS\\\"\\n\\nNUM_PROMPTS=\\\"${AZURE_CONV_NUM_PROMPTS:-1200}\\\"\\nSKIP_FIRST_N_REQUESTS=\\\"${AZURE_CONV_SKIP_FIRST_N_REQUESTS:-100}\\\"\\nSKIP_LAST_N_REQUESTS