evice, raw=True))\\n            v_cache.index_copy_(\\n                0, device_ids,\\n                kv_load_metrics.h2d(secondary[1][host_ids], v_cache.device, raw=True))\\n\\n        if profile is not None:\\n            raw_bytes = len(block_ids) * self._block_numel * 4\\n            profile.update(raw_bytes=raw_bytes, wire_bytes=raw_bytes + len(block_ids) * 8,\\n                           body_bytes=raw_bytes, entry_bytes=0, active_entry_bytes=0,\\n                           extra_entry_bytes=0, stage_cpu_ms=(_time.perf_counter_ns() - started) / 1e6)\\n\\n    def _pack_csr_entries(\\n            self, pool: Dict[str, torch.Tensor],\\n            storage_slots: np.ndarray\\n            ) -> Tuple[torch.Tensor, torch.Tensor, list[torch.Tensor]]:\\n        \\\"\\\"\\\"Compact exact per-slot Packed20 words into one pinned CSR arena.\\\"\\\"\\\"\\n        storage_slots = np.ascontiguousarray(storage_slots, dtype=np.int64)\\n        counts = pool[\\\"num_exceptions\\\"].numpy()[storage_slots]\\n        # Rows restored from raw secondary may still be present in a full-HWM\\n        # staging range.  They are never decoded, so safely clamp their\\n        # truncated scratch row while retaining offsets for every body row.\\n        stored_counts = np.minimum(counts, self._entry_capacity)\\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\\n        total_words = int(word_counts.sum())\\n        packed, packed_owner = self._acquire_csr_host_arena(total_words)\\n        offsets, offsets_owner = self._acquire_csr_host_arena(\\n            storage_slots.size)\\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\\n            pool[\\\"entries20x3\\\"], pool[\\\"num_exceptions\\\"],\\n            torch.from_numpy(storage_slots), packed, offsets)\\n        return packed, offsets, [packed_owner, offsets_owner]\\n\\n    def _build_decode_plan(\\n            self, layer_id: int,\\n            block_ids: np.ndarray, k_cache, v_cache) -> _DecodePlan:\\n        self._reclaim_csr_plans()\\n        if self.storage_backend == \\\"hybrid\\\":\\n            from tiered_serve.chunk_delta3_kv_plan import prepare_hybrid_plan\\n            return prepare_hybrid_plan(self, layer_id, block_ids)\\n        n = len(block_ids)\\n        hwm = self._kv_slot_allocator[layer_id].high_water\\n        states = self._persistent_csr[layer_id]\\n            plan.h2d_done.record(h2d_stream)\\n            plan.completion_valid = True\\n            raise\\n\\n    def _decompress_blocks(self, layer_id: int, block_ids,\\n                           k_cache: torch.Tensor,\\n                           v_cache: torch.Tensor, *, chunk_index=0) -> None:\\n        n = len(block_ids)\\n        if n == 0:\\n            return\\n        if n > self._max_gpu_decomp_blocks:\\n            raise RuntimeError(\\n                f\\\"ChunkDelta3 KV decode batch {n} exceeds \\\"\\n                f\\\"capacity {self._max_gpu_decomp_blocks}\\\")\\n        if self._kv_slot_allocator[layer_id].high_water <= 0:\\n            return\\n        if not isinstance(block_ids, np.ndarray):\\n            block_ids = np.ascontiguousarray(block_ids, dtype=np.int64)\\n        profile = kv_cpu_profile.new_load(layer_id, \\\"cd3\\\", n, self._n_layers)\\n        if profile is None and cd3_cpu_profile.enabled:\\n            profile = {\\\"gpu_sampled\\\": 0}\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        plans = (self._decode_plans if chunk_index == 0 else\\n                 self._decode_extra_plans.setdefault(layer_id, {}))\\n        plan_key = layer_id if chunk_index == 0 else chunk_index\\n        plan = plans.get(plan_key)\\n        generation = self._decode_generation.get(layer_id, 0)\\n        plan_hit = (plan is not None and plan.block_ids is block_ids\\n                    and plan.generation == generation)\\n        if plan_hit and getattr(plan, \\\"serial_native\\\", None) is not None:\\n            plan_hit = (plan.output_buffers[0] is k_cache\\n                        and plan.output_buffers[1] is v_cache)\\n        if not plan_hit:\\n            # Plan construction only touches CPU metadata and tensor views.\\n            # Retire first so completed arenas/events can serve this plan.\\n            self._retire_decode_plan(plans.pop(plan_key, None))\\n            plan = self._build_decode_plan(layer_id, block_ids, k_cache, v_cache)\\n            plans[plan_key] = plan\\n        metrics = kv_load_metrics.current()\\n        if metrics is not None:\\n            metrics.record_cd3(modes={}, counters={\\n                \\\"cd3_plan_builds\\\": int(not plan_hit),\\n                \\\"cd3_plan_hits\\\": int(plan_hit),\\n            })\\n\\n        if self.storage_backend == \\\"hybrid\\\":\\n            if profile is not None:\\n                profile.update(plan_hit=int(plan_hit), plan_cpu_ms=(\\n                    _time.perf_counter_ns() - started) / 1e6)\\n                native = plan.native_plan\\n                profile.update(\\n                    native_prepare_cpu_ms=0.0 if plan_hit else native.prepare_cpu_ms,\\n                    planner_visited_records=0 if plan_hit else native.visited_records,\\n                    planner_selected_segments=0 if plan_hit else native.selected_segments,\\n                    planner_new_allocations=0 if plan_hit else native.new_allocations)\\n            self._submit_hybrid_plan(layer_id, plan, k_cache, v_cache, profile)\\n            return\\n\\n        if profile is not None:\\n            profile[\\\"plan_cpu_ms\\\"] = (_time.perf_counter_ns() - started) / 1e6\\n            entries = sum(plan.entry_wire_bytes)\\n            profile.update(plan_hit=int(plan_hit), raw_bytes=n * self._block_numel * 4,\\n                           body_bytes=n * self._body_stride * 2, entry_bytes=entries,\\n                           active_entry_bytes=plan.profile_active_entry_bytes,\\n                           extra_entry_bytes=max(0, entries - plan.profile_active_entry_bytes))\\n            if profile[\\\"gpu_sampled\\\"] and self._kv_load_probe_events:\\n                events = self._kv_load_probe_events[layer_id]\\n                profile[\\\"_handles\\\"] = tuple(event.cuda_event for event in events[:4])\\n                profile[\\\"_events\\\"] = [(\\\"h2d_window_ms\\\", events[0], events[1]),\\n                                      (\\\"decode_window_ms\\\", events[2], events[3])]\\n            else:\\n                profile[\\\"gpu_sampled\\\"] = 0\\n\\n        self._submit_csr_plan(\\n            layer_id, plan, first_chunk=True, profile=profile)\\n\\n    def _submit_hybrid_plan(self, layer_id, plan, k_cache, v_cache, profile):\\n        ring = self._decode_ring_idx & 1\\n        self._decode_ring_idx += 1\\n        stream = self.load_kv_stream\\n        native = plan.native_plan\\n        if not plan.h2d_done.cuda_event:\\n            plan.h2d_done.record(self.batch_decomp_stream)\\n        metrics = kv_load_metrics.current()\\n        transfers = []\\n        if metrics is not None:\\n            for index, wire in enumerate((native.k_wire_bytes, native.v_wire_bytes)):\\n                item = metrics.transfer(plan.storage_rows * self._block_numel * 2,\\n                                        plan.side_payload[index])\\n                item.stats[2] = wire\\n                transfers.append(item)\\n            metrics.record_cd3(modes={\\n                \\\"cd3_storage\\\": self.storage_backend,\\n                \\\"cd3_execution\\\": self.execution,\\n            }, counters={\\n                \\\"cd3_k_h2d_bytes\\\": native.k_wire_bytes,\\n                \\\"cd3_v_h2d_bytes\\\": native.v_wire_bytes,\\n                \\\"cd3_metadata_bytes\\\": plan.storage_rows * 24,\\n                \\\"cd3_alignment_bytes\\\": sum(plan.side_alignment),\\n                \\\"cd3_gap_bytes\\\": sum(plan.side_gap),\\n                \\\"cd3_csr_garbage_bytes\\\": getattr(plan, \\\"csr_garbage_bytes\\\", 0),\\n                \\\"cd3_copy_descriptors\\\": native.k_copy_count + native.v_copy_count,\\n                \\\"cd3_batch_calls\\\": native.batch_api_calls,\\n            })\\n        events = ()\\n        handles = []\\n        if self._tb:\\n            index = len(self._kv_side_intervals)\\n            if index == len(self._pipeline_timing_pool):\\n                group = tuple(torch.cuda.Event(enable_timing=True) for _ in range(8))\\n                for event in group:\\n                    event.record(self.batch_decomp_stream)\\n                self._pipeline_timing_pool.append(group)\\n            events = self._pipeline_timing_pool[index]\\n            # Transfer windows feed the existing loader's H2D accounting.\\n            if transfers and metrics.timing:\\n                events = (*transfers[0].events, *transfers[1].events, *events[4:])\\n            handles = [event.cuda_event for event in events]\\n            self._kv_side_intervals.append((layer_id, events))\\n            self._kv_decode_intervals.extend((\\n                (layer_id, \\\"k\\\", events[4], events[5]),\\n                (layer_id, \\\"v\\\", events[6], events[7])))\\n            if profile is not None:\\n                profile.update(gpu_sampled=1, _pipeline_events=events, _events=[\\n                    (\\\"k_h2d_ms\\\", events[0], events[1]), (\\\"v_h2d_ms\\\", events[2], events[3]),\\n                    (\\\"k_decomp_ms\\\", events[4], events[5]), (\\\"v_decomp_ms\\\", events[6], events[7]),\\n                    (\\\"chunk_ready_ms\\\", events[0], events[7])])\\n        started = _time.perf_counter_ns() if profile is not None else 0\\n        # Mark sources submitted before entering native code. If CUDA reports\\n        # an error after enqueueing some copies, retain all leases until an\\n        # explicit drain confirms no source readers remain.\\n        plan.h2d_submitted = True\\n        plan.completion_valid = False\\n        try:\\n            native.submit(\\n                ring,\\n                k_cache.view(k_cache.shape[0], self._M_b, self._K_b),\\n                v_cache.view(v_cache.shape[0], self._M_b, self._K_b),\\n                stream.cuda_stream, self.batch_decomp_stream.cuda_stream,\\n                self._pipeline_k_done[ring].cuda_event, self._pipeline_v_done[ring].cuda_event,\\n                self._kv_dec_h2d[layer_id].cuda_event, plan.h2d_done.cuda_event,\\n                self._decode_consumed[ring].cuda_event, handles)\\n            plan.completion_valid = True\\n        except BaseException as error:\\n            error.add_note(f\\\"CD3 layer={layer_id} blocks={plan.storage_rows} ring={ring} \\\"\\n                           f\\\"generation={plan.generation} mode=hybrid/pipeline\\\")\\n            # Error cleanup only, never a normal free/submit synchronization.\\n            stream.synchronize()\\n            self.batch_decomp_stream.synchronize()\\n            plan.h2d_done.record(stream)\\n            plan.completion_valid = True\\n            raise\\n        if profile is not None:\\n            profile.update(stage_cpu_ms=(_time.perf_counter_ns() - started) / 1e6,\\n                           raw_bytes=plan.storage_rows * self._block_numel * 4,\\n                           wire_bytes=native.k_wire_bytes + native.v_wire_bytes,\\n                           copy_count=native.k_copy_count + native.v_copy_count,\\n                           batch_api_calls=native.batch_api_calls, effective_execution=\\\"pipeline\\\")\\n            cd3_cpu_profile.record_load(profile)\\n            if self._entry_pool is not None and layer_id == self._n_layers - 1:\\n                memory = self._entry_pool.stats()\\n                live_rows = sum(store.stats()[\\\"live_records\\\"]\\n                                for store in self._hybrid_stores.values())\\n                profile.update(live_payload_bytes=(memory[\\\"live_entry_bytes\\\"]\\n                                                   + live_rows * self._record_body_bytes * 2),\\n                               segment_capacity_bytes=memory[\\\"capacity_bytes\\\"],\\n                               dead_bytes=memory[\\\"dead_bytes\\\"], unused_bytes=memory[\\\"unused_bytes\\\"],\\n                               scratch_bytes=self._hybrid_scratch_bytes,\\n                               planner_reserved_bytes=self._hybrid_planner_bytes,\\n                               gpu_staging_bytes=sum(t.nbytes for pool in self._gpu_decomp_pool_ring\\n                                                     for side in pool.values() for t in side.values()))\\n\\n\\n_cudart_lib = None\\n_cudart_lock = threading.Lock()\\n\\n\\ndef _get_cudart():\\n    global _cudart_lib\\n    if _cudart_lib is not None:\\n        return _cudart_lib\\n    with _cudart_lock:\\n        if _cudart_lib is None:\\n            lib = None\\n            candidates = sorted(glob.glob(os.path.join(\\n                os.path.dirname(torch.__file__), \\\"lib\\\", \\\"libcudart*.so*\\\")))\\n        if not deferred:\\n            return\\n        slots = np.asarray(sorted(deferred), dtype=np.int64)\\n        self._release_physical_slots(layer_id, slots)\\n        self._deferred_slot_frees.pop(layer_id, None)\\n\\n    def compress_batch_async_from_host(\\n        self,\\n        layer_id: int,\\n        block_ids: list,\\n        host_k: torch.Tensor,\\n        host_v: torch.Tensor,\\n        wait_event_handle: int = 0,\\n        *, ownership=(),\\n    ) -> None:\\n        if not self._kv_pools_ready:\\n            raise RuntimeError(\\n                \\\"compress_batch_async_from_host requires warmup_kv_buffers\\\")\\n        if not self._workers:\\n            raise RuntimeError(\\\"CD3 encode submitted after worker shutdown\\\")\\n        if layer_id in self._pending_compress:\\n            self.wait_compress_async(\\n                layer_id, tuple(host_k.shape[1:]), _join_site=\\\"resubmit\\\")\\n        num_source_blocks = host_k.shape[0]\\n        block_array = np.asarray(block_ids, dtype=np.int64)\\n        if block_array.size:\\n            block_array = block_array[\\n                (block_array >= 0) & (block_array < num_source_blocks)]\\n        if block_array.size == 0:\\n            return\\n        ownership = tuple(ownership or ())\\n        routing = {record.block_id: record for record in ownership}\\n        if self.storage_backend == \\\"hybrid\\\":\\n            if len(routing) != len(ownership) or any(\\n                    int(block_id) not in routing for block_id in block_array):\\n                raise RuntimeError(\\\"CD3 hybrid encode requires exact immutable block ownership\\\")\\n            ownership = tuple(routing[int(block_id)] for block_id in block_array)\\n            if any(not record.request_id or record.generation <= 0\\n                   or record.block_index < 0 for record in ownership):\\n                raise ValueError(\\\"CD3 hybrid encode received invalid block ownership\\\")\\n        decode_event_handle = int(\\n            self._kv_dec_h2d[layer_id].cuda_event)\\n        with self._slot_state_lock:\\n            self._reclaim_csr_plans()\\n            slots = self._assign_kv_slots(layer_id, block_array)\\n            valid = self._persistent_valid[layer_id]\\n            np.frombuffer(valid, dtype=np.uint8)[block_array] = 0\\n            self._invalidate_decode_plan(layer_id)\\n            state = self._worker_state_for_layer(layer_id)\\n            state[\\\"error\\\"] = None\\n            state[\\\"done\\\"].clear()\\n            self._record_generations[layer_id][block_array] += 1\\n            generations = np.ascontiguousarray(\\n                self._record_generations[layer_id][block_array], dtype=np.int64)\\n            if self.storage_backend == \\\"hybrid\\\":\\n                self._hybrid_ownership[layer_id].update(routing)\\n            hybrid_results = []\\n            profile = kv_cpu_profile.new_job(layer_id, int(block_array.size))\\n            pending = {\\n                \\\"profile\\\": profile,\\n                \\\"state\\\": state,\\n                \\\"buffer_ids\\\": block_array,\\n                \\\"physical_slots\\\": slots,\\n                \\\"generations\\\": generations,\\n                \\\"hybrid_results\\\": hybrid_results,\\n                \\\"ownership\\\": ownership,\\n            }\\n            self._pending_compress[layer_id] = pending\\n            try:\\n                self._work_queue.put((\\n                    state,\\n                    (layer_id, host_k, host_v, block_array, slots,\\n                     int(wait_event_handle), decode_event_handle,\\n                     ownership, generations, hybrid_results, profile),\\n                ))\\n            except BaseException:\\n                if self._pending_compress.get(layer_id) is pending:\\n                    self._pending_compress.pop(layer_id, None)\\n                state[\\\"done\\\"].set()\\n                raise\\n\\n    @cd3_cpu_profile.timed(\\\"worker.encode_job\\\")\\n    def _encode_chunk(\\n        self,\\n        layer_id: int,\\n        host_k: torch.Tensor,\\n        host_v: torch.Tensor,\\n        block_ids: np.ndarray,\\n        slots: np.ndarray,\\n        raw_event_handle: int,\\n        decode_event_handle: int,\\n        ownership=(),\\n        generations=None,\\n        hybrid_results=None,\\n        profile=None,\\n    ) -> None:\\n        self._pin_worker_thread()\\n        if profile is not None:\\n            started_ns = _time.perf_counter_ns()\\n        _sync_cuda_event(raw_event_handle)\\n        if profile is not None:\\n            now_ns = _time.perf_counter_ns()\\n            profile[\\\"raw_d2h_wait_ms\\\"] = (now_ns - started_ns) / 1e6\\n            started_ns = now_ns\\n        # Both paths write fixed body slots. Invalidate before queuing this\\n        # writer and wait for earlier H2D readers before any slot is reused.\\n        _sync_cuda_event(decode_event_handle)\\n        if profile is not None:\\n            pr