DAGuard guard(layout->device);\\n            auto result = cudaEventQuery(storage->h2d_complete);\\n            TORCH_CHECK(result != cudaErrorNotReady, \\\"hybrid sources still have in-flight H2D readers\\\");\\n            check_cuda_error(result, \\\"cudaEventQuery(hybrid H2D)\\\");\\n        }\\n        release_completed_sources();\\n    }\\n\\n    void check_output(const torch::Tensor& output) const\\n    {\\n        TORCH_CHECK(output.device() == layout->device && output.is_contiguous()\\n                        && output.scalar_type() == at::kBFloat16 && output.dim() == 3\\n                        && output.size(0) > max_output_id && output.size(1) == layout->rows\\n                        && output.size(2) == layout->columns\\n                        && reinterpret_cast<uintptr_t>(output.data_ptr()) % 16 == 0,\\n                    \\\"invalid hybrid dense output shape, device, alignment or routing capacity\\\");\\n    }\\n\\n    void decode(const HybridRing& ring, int side, const torch::Tensor& output, cudaStream_t stream)\\n    {\\n        check_cuda_error(CD3_DecompressBatchedCSR(stream, ring.bodies[side].data_ptr<uint8_t>(),\\n            layout->body_stride, layout->sm_offset, layout->base_offset, layout->offsets_offset,\\n            reinterpret_cast<const uint64_t*>(ring.entries[side].data_ptr<int64_t>()),\\n            ring.offsets[side].data_ptr<int64_t>(), nullptr, ring.output_ids.data_ptr<int64_t>(),\\n            reinterpret_cast<uint16_t*>(output.data_ptr()), storage_rows, layout->tiles,\\n            layout->elements, layout->columns), \\\"CD3_DecompressBatchedCSR(hybrid)\\\");\\n    }\\n\\n    void submit(int64_t ring_index, torch::Tensor k_output, torch::Tensor v_output,\\n                int64_t h2d_handle, int64_t decode_handle, int64_t k_done, int64_t v_done,\\n                int64_t h2d_done, int64_t plan_h2d_done, int64_t consumed,\\n                std::vector<int64_t> events)\\n    {\\n        check_output(k_output);\\n        check_output(v_output);\\n        TORCH_CHECK(ring_index >= 0 && static_cast<size_t>(ring_index) < layout->rings.size(),\\n                    \\\"invalid hybrid staging ring\\\");\\n        const auto& ring = layout->rings[ring_index];\\n        const auto k_address = reinterpret_cast<uintptr_t>(k_output.data_ptr());\\n        const auto v_address = reinterpret_cast<uintptr_t>(v_output.data_ptr());\\n        TORCH_CHECK(k_address + k_output.nbytes() <= v_address\\n                        || v_address + v_output.nbytes() <= k_address,\\n                    \\\"hybrid K/V outputs must not overlap\\\");\\n        TORCH_CHECK(h2d_handle && decode_handle && k_done && v_done && consumed,\\n                    \\\"hybrid submission requires streams and completion events\\\");\\n        TORCH_CHECK(events.empty() || events.size() == 8, \\\"hybrid probe events require eight handles\\\");\\n        if (events.empty()) {\\n            events.resize(8, 0);\\n        }\\n        const c10::cuda::CUDAGuard guard(layout->device);\\n        auto h2d_stream = reinterpret_cast<cudaStream_t>(h2d_handle);\\n        auto decode_stream = reinterpret_cast<cudaStream_t>(decode_handle);\\n        py::gil_scoped_release no_gil;\\n        std::lock_guard<std::mutex> lock(mutex);\\n        TORCH_CHECK(storage && !storage->poisoned, \\\"hybrid source snapshot is no longer usable\\\");\\n        if (!storage->h2d_complete) {\\n            check_cuda_error(cudaEventCreateWithFlags(&storage->h2d_complete, cudaEventDisableTiming),\\n                             \\\"cudaEventCreate(hybrid H2D)\\\");\\n        }\\n        // The plan retains one fixed layout. Its binding starts afresh even\\n        // when the underlying descriptor storage came from the metadata pool.\\n        if (bound_ring != ring_index) {\\n            for (int side = 0; side < 2; ++side) {\\n                auto& batch = storage->copies[side];\\n                for (int64_t i = 0; i < body_spans[side] + entry_spans[side]; ++i) {\\n                    auto* base = i < body_spans[side] ? ring.bodies[side].data_ptr<uint8_t>()\\n                        : reinterpret_cast<uint8_t*>(ring.entries[side].data_ptr<int64_t>());\\n                    batch.destination_addresses[i] = base + storage->destination_offsets[side][i];\\n                }\\n                batch.destination_addresses[body_spans[side] + entry_spans[side]] = ring.offsets[side].data_ptr();\\n            }\\n            storage->copies[0].destination_addresses.back() = ring.output_ids.data_ptr();\\n            bound_ring = ring_index;\\n        }\\n        auto wait = [](cudaStream_t stream, int64_t event) {\\n            check_cuda_error(cudaStreamWaitEvent(stream, reinterpret_cast<cudaEvent_t>(event), 0),\\n                             \\\"cudaStreamWaitEvent(hybrid)\\\");\\n        };\\n        TORCH_CHECK(h2d_stream != decode_stream,\\n                    \\\"hybrid requires separate H2D and decode streams\\\");\\n        wait(h2d_stream, consumed);\\n        try {\\n            record_kv_probe_event(events[0], h2d_stream);\\n            storage->copies[0].submit(h2d_stream);\\n            record_kv_probe_event(events[1], h2d_stream);\\n            record_kv_probe_event(k_done, h2d_stream);\\n            record_kv_probe_event(events[2], h2d_stream);\\n            storage->copies[1].submit(h2d_stream);\\n            record_kv_probe_event(events[3], h2d_stream);\\n            record_kv_probe_event(v_done, h2d_stream);\\n            record_kv_probe_event(h2d_done, h2d_stream);\\n            check_cuda_error(cudaEventRecord(storage->h2d_complete, h2d_stream),\\n                             \\\"cudaEventRecord(hybrid H2D)\\\");\\n            storage->submitted = true;\\n            record_kv_probe_event(plan_h2d_done, h2d_stream);\\n        } catch (...) {\\n            if (cudaEventRecord(storage->h2d_complete, h2d_stream) == cudaSuccess) {\\n                storage->submitted = true;\\n            } else {\\n                storage->poisoned = cudaStreamSynchronize(h2d_stream) != cudaSuccess;\\n                storage->submitted = false;\\n            }\\n            throw;\\n        }\\n        wait(decode_stream, k_done);\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"5ba576\",\"wall_time_seconds\":0.000011744,\"exit_code\":0,\"original_token_count\":1655,\"output\":\"[Thread debugging using libthread_db enabled]\\nUsing host libthread_db library \\\"/lib/aarch64-linux-gnu/libthread_db.so.1\\\".\\nCore was generated by `VLLM::EngineCore                                                              '.\\nProgram terminated with signal SIGSEGV, Segmentation fault.\\n#0  0x0000ee07e8b11bbc in ?? () from /usr/local/cuda-13.2/compat/libcuda.so.1\\n[Current thread is 1 (Thread 0xee087c8a8ba0 (LWP 13469))]\\n$1 = {si_signo = 11, si_errno = 0, si_code = 2, _sifields = {_pad = {12592220, 2, 0 <repeats 26 times>}, _kill = {si_pid = 12592220, si_uid = 2}, _timer = {si_tid = 12592220, si_overrun = 2, si_sigval = {sival_int = 0, sival_ptr = 0x0}}, _rt = {si_pid = 12592220, si_uid = 2, si_sigval = {sival_int = 0, sival_ptr = 0x0}}, _sigchld = {si_pid = 12592220, si_uid = 2, si_status = 0, si_utime = 0, si_stime = 0}, _sigfault = {si_addr = 0x200c0245c}, _sigpoll = {si_band = 8602526812, si_fd = 0}, _sigsys = {_call_addr = 0x200c0245c, _syscall = 0, _arch = 0}}}\\nx0             0x14e1              5345\\nx1             0xedbbfb66b800      261391632480256\\nx2             0x5388              21384\\nx3             0x74e2206d          1960976493\\nx4             0x1                 1\\nx5             0x2                 2\\nx6             0x200bfd0d8         8602505432\\nx7             0x20022062          537010274\\nx19            0x5388              21384\\nx20            0x5388              21384\\nx21            0x5388              21384\\nx22            0x2                 2\\nx23            0x6000206d          1610621037\\nx24            0xedbbfb670b88      261391632501640\\nx25            0x7ffc  