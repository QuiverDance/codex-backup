 const int64_t num_output_blocks = slots.numel();\n    const int64_t rows = k_output.size(1);\n    const int64_t columns = k_output.size(2);\n    TORCH_CHECK(num_output_blocks > 0 && rows > 0 && columns > 0\n                    && rows % kTileDim == 0 && columns % kTileDim == 0,\n                \"CSR ChunkDelta3 dimensions must be positive multiples of 64\");\n    const int64_t tiles_per_block =\n        (rows / kTileDim) * (columns / kTileDim);\n    const int64_t block_elements = rows * columns;\n    const int64_t code_bytes = tiles_per_block * kTileElements * kKVDeltaBits / 8;\n    const int64_t base_bytes = tiles_per_block * kBasesPerTile;\n\n    TORCH_CHECK(k_body.is_cuda() && k_body.is_contiguous()\n                    && k_body.scalar_type() == at::kByte\n                    && k_body.dim() == 2 && k_body.size(0) > 0,\n                \"invalid ChunkDelta3 K CSR body\");\n    TORCH_CHECK(v_body.is_cuda() && v_body.is_contiguous()\n                    && v_body.scalar_type() == at::kByte\n                    && v_body.sizes() == k_body.sizes(),\n                \"invalid ChunkDelta3 V CSR body\");\n    const int64_t body_stride = k_body.size(1);\n    TORCH_CHECK(body_stride % 8 == 0,\n                \"ChunkDelta3 CSR body stride must be 8-byte aligned\");\n\n    auto check_entries = [](const torch::Tensor& entries, const char* name) {\n        TORCH_CHECK(entries.is_cuda() && entries.is_contiguous()\n                        && entries.scalar_type() == at::kLong\n                        && entries.dim() == 1,\n                    \"invalid ChunkDelta3 \", name, \" CSR entries\");\n    };\n    check_entries(k_entries20x3, \"K\");\n    check_entries(v_entries20x3, \"V\");\n    auto check_entry_offsets = [body_rows = k_body.size(0)](\n            const torch::Tensor& offsets, const char* name) {\n        TORCH_CHECK(offsets.is_cuda() && offsets.is_contiguous()\n                        && offsets.scalar_type() == at::kLong\n                        && offsets.dim()