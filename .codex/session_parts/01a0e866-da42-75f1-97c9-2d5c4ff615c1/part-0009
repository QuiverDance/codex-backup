<size_t>(index)].block_id;\n        }\n    }\n\n    struct RowPool {\n        char* gpu;\n        char* host;\n        size_t bytes_per_row;\n        int64_t host_rows;\n    };\n    std::vector<torch::Tensor> gpu_rows = {gpu_k_body, gpu_v_body};\n    std::vector<torch::Tensor> host_rows = {host_k_body, host_v_body};\n    if (!offsets_are_compact) {\n        gpu_rows.push_back(gpu_k_offsets);\n        gpu_rows.push_back(gpu_v_offsets);\n        host_rows.push_back(host_k_offsets);\n        host_rows.push_back(host_v_offsets);\n    }\n    std::vector<RowPool> row_pools;\n    row_pools.reserve(gpu_rows.size());\n    for (size_t index = 0; index < gpu_rows.size(); ++index) {\n        const auto& gpu = gpu_rows[index];\n        const auto& host = host_rows[index];\n        TORCH_CHECK(\n            gpu.is_cuda() && host.device().is_cpu() && host.is_pinned(),\n            \"CD3 row copies must be pinned CPU to CUDA\");\n        TORCH_CHECK(\n            gpu.dim() >= 1 && host.dim() >= 1\n                && gpu.scalar_type() == host.scalar_type(),\n            \"incompatible CD3 row tensors\");\n        const size_t gpu_row_bytes =\n            static_cast<size_t>(gpu.stride(0)) * gpu.element_size();\n        const size_t host_row_bytes =\n            static_cast<size_t>(host.stride(0)) * host.element_size();\n        TORCH_CHECK(\n            gpu_row_bytes == host_row_bytes,\n            \"CD3 row strides differ\");\n        TORCH_CHECK(gpu.size(0) >= n, \"GPU CD3 row staging is too small\");\n        row_pools.push_back({\n            static_cast<char*>(gpu.data_ptr()),\n            static_cast<char*>(host.data_ptr()),\n            host_row_bytes,\n            host.size(0)});\n    }\n\n    struct Span {\n        int64_t dst_row;\n        int32_t src_slot;\n        int64_t count;\n    };\n    std::vector<Span> spans;\n    spans.reserve(static_cast<size_t>(n));\n    int64_t dst_row = 0;\n    int32_t src_slot = routes.front().slot;\n    int64_t count = 1;\n    for (int64_t 