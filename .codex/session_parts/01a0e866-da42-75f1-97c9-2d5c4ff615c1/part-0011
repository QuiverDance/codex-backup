on asynchronous KV compressor.\\\"\\\"\\\"\\nimport json\\n\\nimport numpy as np\\nimport pytest\\nimport torch\\n\\n\\n@pytest.mark.parametrize(\\\"storage\\\", [\\\"csr\\\", \\\"hybrid\\\"])\\ndef test_cd3_async_storage_and_pipeline(monkeypatch, tmp_path, storage):\\n    if not torch.cuda.is_available():\\n        pytest.skip(\\\"CUDA required\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_FULL_BLOCK_ONLY\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_CD3_STORAGE\\\", storage)\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_WORKERS\\\", \\\"1\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_PIN\\\", \\\"0\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_COMPRESS_OMP_THREADS\\\", \\\"2\\\")\\n    monkeypatch.setenv(\\\"TIERED_SERVE_KV_METRICS\\\", \\\"1\\\")\\n    from tiered_serve import cd3_cpu_profile, kv_load_metrics\\n    from tiered_serve.chunk_delta3_kv_compressor import ChunkDelta3KVCompressor\\n    from tiered_serve.kv_tail_residency import KVBlockOwnership\\n\\n    compressor = ChunkDelta3KVCompressor(torch.cuda.Stream())\\n    compressor.load_kv_stream = torch.cuda.Stream()\\n    compressor._tb = True\\n    compressor.warmup_kv_buffers(\\n        (64, 64), 16, n_layers=2,\\n        max_gpu_decomp_blocks=2)\\n    if storage == \\\"hybrid\\\":\\n        def unexpected_backing_allocation(*args, **kwargs):\\n            raise AssertionError(\\\"hybrid append must reuse its reserved backing arenas\\\")\\n        monkeypatch.setattr(compressor, \\\"_alloc_host_tensor\\\", unexpected_backing_allocation)\\n    metrics = kv_load_metrics.configure(timing=True)\\n    ids = [1, 3, 4, 8, 12]\\n    source = [torch.ones((17, 64, 64), dtype=torch.bfloat16).pin_memory() for _ in range(2)]\\n    for side, values in enumerate(source):\\n        bits = values.view(torch.int16).view(17, -1)\\n        for index, block in enumerate(ids):\\n            if block == ids[-1]:\\n                continue  # Both K/V have an empty entries payload.\\n            # Vary exact exception counts and include signed zero, infinity,\\n            # subnormal and NaN payloads without overflowing encode scratch.\\n            patterns = torch.tensor([0, -32768, 1, 32640, 32705], dtype=torch.int16)\\n            positions = torch.arange(0, 4096, 71 + index * 13 + side)\\n            bits[block, positions] = patterns[torch.arange(len(positions)) % len(patterns)]\\n    output = [torch.full_like(source[0], -5, device=\\\"cuda\\\") for _ in range(2)]\\n    pool = compressor._entry_pool\\n    other_source = [torch.full_like(values, 7).pin_memory() for values in source]\\n\\n    def submit(blocks, generation, layer_id=0, values=None):\\n        routing = tuple(KVBlockOwnership(\\n            block_id=bid, canonical_block_id=bid + 100, request_id=f\\\"req-{bid // 5}\\\",\\n            block_index=bid, generation=generation) for bid in blocks)\\n        compressor.compress_batch_async_from_host(\\n            layer_id, blocks, *(source if values is None else values), ownership=routing)\\n        compressor.wait_compress_async(layer_id, (64, 64))\\n\\n    def decode(blocks, layer_id=0, expected_source=None):\\n        metrics.begin_forward(False, len(blocks))\\n        metrics.layer = layer_id\\n        compressor.prepare_active_set(blocks, np.array(blocks, dtype=np.int64))\\n        compressor.decompress_batch(layer_id, blocks, output)\\n        compressor.batch_decomp_stream.synchronize()\\n        for actual, expected in zip(output, source if expected_source is None else expected_source):\\n            assert torch.equal(actual[blocks].cpu().view(torch.int16), expected[blocks].view(torch.int16))\\n        snapshot = metrics.snapshot()\\n        assert snapshot[\\\"bytes_complete\\\"] == snapshot[\\\"timing_complete\\\"] == 1\\n        assert snapshot[\\\"cd3_k_h2d_bytes\\\"] + snapshot[\\\"cd3_v_h2d_bytes\\\"] == snapshot[\\\"kv_h2d_bytes\\\"]\\n        assert snapshot[\\\"cd3_copy_descriptors\\\"] > 0\\n        if storage == \\\"hybrid\\\":\\n            assert snapshot[\\\"kv_h2d_bytes\\\"] == (snapshot[\\\"kv_payload_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_metadata_bytes\\\"]\\n                                                 + snapshot[\\\"cd3_alignment_bytes\\\"])\\n            assert snapshot[\\\"cd3_gap_bytes\\\"] == 0\\n        else:\\n            assert snapshot[\\\"cd3_csr_garbage_bytes\\\"] <= snapshot[\\\"cd3_gap_bytes\\\"]\\n        assert snapshot[\\\"cd3_storage\\\"] == storage\\n        assert snapshot[\\\"cd3_execution\\\"] == (\\\"serial\\\" if storage == \\\"csr\\\" else \\\"pipeline\\\")\\n        return snapshot\\n\\n    try:\\n        submit(ids, 1)\\n        # Exercise the serving CPU profiler through a real decode and its JSON\\n        # output. The remaining submissions run with the usual profiling state.\\n        with monkeypatch.context() as profiling:\\n            profiling.setattr(cd3_cpu_profile, \\\"enabled\\\", True)\\n            profiling.setattr(cd3_cpu_profile, \\\"_totals\\\", {})\\n            profiling.setenv(\\\"TIERED_SERVE_KV_METRICS_DIR\\\", str(tmp_path))\\n            decode(ids[:2])\\n            cd3_cpu_profile.flush()\\n            report = next(tmp_path.glob(\\\"cd3_cpu_profile.*.json\\\"))\\n            categories = json.loads(report.read_text())[\\\"categories\\\"]\\n            for field in (\\\"plan_cpu_ms\\\", \\\"stage_cpu_ms\\\"):\\n                assert categories[f\\\"load.{field}\\\"][\\\"calls\\\"] == 1\\n                assert categories[f\\\"load.{field}\\\"][\\\"total_ms\\\"] > 0\\n            if storage == \\\"hybrid\\\":\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"calls\\\"] == 1\\n                assert categories[\\\"load.native_prepare_cpu_ms\\\"][\\\"total_ms\\\"] > 0\\n        cached_plan = compressor._decode_plans[0]\\n        if storage == \\\"csr\\\":\\n            native = cached_plan.serial_native\\n            assert native is not None\\n