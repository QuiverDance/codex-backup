ve slot must use its fresh exception payload,\\n        # even when an old packed record could otherwise be retained.\\n        for values in source:\\n            bits = values.view(torch.int16)\\n            bits[bits == 1] = 32640\\n        submit(ids, 2)\\n        decode(ids)\\n        compressor.free_persistent_blocks([3, 8])\\n        for values in source:\\n            values[3].fill_(2)\\n            values[8].fill_(4)\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"72d09c\",\"wall_time_seconds\":0.000013889,\"exit_code\":0,\"original_token_count\":260,\"output\":\"        .def(\\\"prepare\\\", &HybridKVStore::prepare, py::arg(\\\"active_ids\\\").noconvert())\\n        .def(\\\"stats\\\", &HybridKVStore::stats);\\n    py::class_<HybridKVPlan, std::shared_ptr<HybridKVPlan>>(module, \\\"HybridKVPlan\\\")\\n        .def(\\\"submit\\\", &HybridKVPlan::submit,\\n             py::arg(\\\"ring\\\"), py::arg(\\\"k_output\\\"), py::arg(\\\"v_output\\\"),\\n             py::arg(\\\"h2d_stream\\\"), py::arg(\\\"decomp_stream\\\"), py::arg(\\\"k_done\\\"), py::arg(\\\"v_done\\\"),\\n             py::arg(\\\"h2d_done\\\"), py::arg(\\\"plan_h2d_done\\\"), py::arg(\\\"consumed\\\"),\\n             py::arg(\\\"events\\\") = std::vector<int64_t>{})\\n        .def(\\\"release_sources\\\", &HybridKVPlan::release_sources)\\n        .def(\\\"debug_snapshot\\\", &HybridKVPlan::debug_snapshot)\\n        .def_readonly(\\\"side_payload\\\", &HybridKVPlan::side_payload)\\n        .def_readonly(\\\"side_alignment\\\", &HybridKVPlan::side_alignment)\\n        .def_readonly(\\\"entry_words\\\", &HybridKVPlan::entry_words)\\n        .def_readonly(\\\"storage_rows\\\", &HybridKVPlan::storage_rows)\\n        .def_readonly(\\\"new_allocations\\\", &HybridKVPlan::new_allocations)\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"56b12f\",\"wall_time_seconds\":0.000011712,\"exit_code\":0,\"original_token_count\"