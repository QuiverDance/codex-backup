 < self.n_weight_pages:\n                raise ValueError(\n                    f\"total_num_pages must be >= {self.n_weight_pages}.\")\n\n            self.dir = hugepage_dir\n            self.prefix = filename_prefix\n            self.hp_size = hugepage_size\n            self.pages = {}\n            self.allocations = {}\n            self.shared_kv_info = {}\n\n            self.is_primary_process = False\n\n            self._next_idx = {}\n\n            # Pinned-memory fallback: when a hugepage allocation fails for a\n            # weight tensor, fall back to cudaHostAlloc so we can use the\n            # rest of system RAM beyond the 16 GiB hugepage quota.\n            self._pinned_fallback_enabled = (\n                os.getenv(\"TIERED_SERVE_PINNED_FALLBACK\", \"1\") == \"1\")\n            self._pinned_fallback_types = frozenset({\"weight\"})\n            self._pinned_allocs = {}  # tensor_ptr -> {\"host_ptr\", \"size\", \"type\"}\n            self._pinned_total_bytes = 0\n\n            if not os.path.exists(self.dir):\n                # 경쟁 상태(race condition)를 대비해 exist_ok=True 사용\n                os.makedirs(self.dir, exist_ok=True)\n\n            self.n_kv_pages = max(0, total_num_pages - self.n_weight_pages)\n\n            # Ensure the hugepage pool is large enough.\n            self._ensure_hugepage_pool(total_num_pages)\n\n            num_pages_config = {\n                \"weight\": self.n_weight_pages,\n                \"kv\": self.n_kv_pages\n            }\n\n            for page_type, num in num_pages_config.items():\n                self.pages[page_type] = []\n                for i in range(num):\n                    page_path = os.path.join(self.dir,\n                                             f\"{self.prefix}_{page_type}_{i}\")\n\n                    page, was_created = self._create_page(page_path)\n                    if was_created:\n                        self.is_primary_process = True\n\n                    page[\"blocks\"] = [{\n                        \"offset\": 0,\n                        \"size\": self.hp_size,\n                        \"free\": True\n                    }]\n                    self.pages[page_type].append(page)\n\n                    if page_type == \"kv\":\n                        self.shared_kv_info[i] = {\n                            \"path\": page[\"path\"],\n                            \"base_ptr\": page[\"base_ptr\"],\n                            \"device_ptr\": page[\"device_ptr\"],\n                            \"size\": self.hp_size,\n                        }\n                logger.info(\n                    \"Initialized %d pages for type '%s'. Primary process: %s\",\n                    num, page_type, self.is_primary_process)\n\n            self._initialized = True\n\n    def _ensure_hugepage_pool(self, needed: int):\n        \"\"\"Grow the hugepage pool on NUMA node 0 if it is smaller than needed.\n\n        On GH200 (ARM), 16 GiB hugepages rely on contiguous physical memory\n        and cannot be reallocated once fragmented.  We drop the page cache\n        and try compaction as a best-effort measure.\n        \"\"\"\n        hp_size_kb = self.hp_size // 1024\n        pool_path = (f\"/sys/devices/system/node/node0/hugepages/\"\n                     f\"hugepages-{hp_size_kb}kB/nr_hugepages\")\n        try:\n            current = int(open(pool_path).read().strip())\n            if current >= needed:\n                return\n            # Best-effort: drop caches + compact memory to defragment\n            os.system(\"sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null; \"\n                      \"echo 1 > /proc/sys/vm/compact_memory 2>/dev/null\")\n            with open(pool_path, \"w\") as f:\n                f.write(str(needed))\n            actual = int(open(pool_path).read().strip())\n            if actual < needed:\n                logger.warning(\n                    \"hugepage pool grew %d -> %d but wanted %d. \"\n                    \"16 GiB hugepages may not be recoverable after \"\n                    \"fragmentation. Consider rebooting or setting \"\n                    \"hugepages at boot time.\",\n                    current, actual, needed)\n            else:\n                logger.info(\"Grew hugepage pool: %d -> %d (requested %d)\",\n                            current, actual, needed)\n        except Exception as e:\n            logger.warning(\"could not grow hugepage pool: %s\", e)\n\n    def _create_page(self, path: str):\n        # 파일이 존재하는지 확인하여 이 프로세스가 생성자인지 결정\n        is_creator = not os.path.exists(path)\n\n        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)\n        try:\n            # 파일 생성자만 파일 크기를 설정 (ftruncate)\n            if is_creator:\n                os.ftruncate(fd, self.hp_size)\n\n            buf = mmap.mmap(fd, self.hp_size, mmap.MAP_SHARED,\n                            mmap.PROT_READ | mmap.PROT_WRITE)\n        finally:\n            os.close(fd)\n\n        base_ptr = ctypes.addressof(ctypes.c_char.from_buffer(buf))\n        self._register_cuda_host(base_ptr, path, buf)\n        device_ptr = self._get_cuda_device_pointer(base_ptr)\n\n        page_data = {\n            \"mmap\": buf,\n            \"base_ptr\": base_ptr,\n            \"device_ptr\": device_ptr,\n            \"path\": path,\n        }\n        return page_data, is_creator\n\n    def get_shared_kv_info(self) -> dict:\n        \"\"\"\n        다른 프로세스에서 접근할 수 있도록 공유 설정된 'kv' 페이지들의\n        정보(경로, 포인터 등)가 담긴 딕셔너리를 반환합니다.\n        \"\"\"\n        return self.shared_kv_info\n\n    def calc_num_cache_block(self, n_layers: int,\n                             total_cache_block_size: int) -> int:\n        if n_layers < self.n_kv_pages:\n            raise ValueError(\n                f\"# of layers: {n_layers}, but # of HugePage for KV: \"\n                f\"{self.n_kv_pages}. Please increase # of HugePage for KV\")\n\n        size_per_hp = self.hp_size // (math.ceil(n_layers / self.n_kv_pages))\n        num_blk_per_hp = size_per_hp // (total_cache_block_size // n_layers)\n\n        return num_blk_per_hp\n\n    def _register_cuda_host(self, base_ptr, path, buf):\n        try:\n            cupy.cuda.runtime.hostRegister(base_ptr, self.hp_size,\n                                           0x02)\n        except cupy.cuda.runtime.CUDARuntimeError as e:\n            buf.close()\n            # 파일 생성에 실패하면 즉시 삭제\n            if os.path.exists(path):\n                os.unlink(path)\n            raise RuntimeError(f\"cudaHostRegister failed: {e}\")\n\n    def _get_cuda_device_pointer(self, base_ptr):\n        libcudart = ctypes.CDLL(\"libcudart.so\")\n        func = libcudart.cudaHostGetDevicePointer\n        func.restype = ctypes.c_int\n        func.argtypes = [\n            ctypes.POINTER(ctypes.c_void_p),\n            ctypes.c_void_p,\n            ctypes.c_uint,\n        ]\n        device_ptr_p = ctypes.c_void_p()\n        ret = func(ctypes.byref(device_ptr_p),\n                   ctypes.c_void_p(base_ptr),\n                   ctypes.c_uint(0))\n        if ret != 0:\n            cupy.cuda.runtime.hostUnregister(base_ptr)\n            raise RuntimeError(\n                f\"cudaHostGetDevicePointer failed with error code {ret}\")\n        return device_ptr_p.value\n\n    # Round per-allocation reservations up to this many bytes so that the\n    # data_ptr of every tensor handed out by the pool is naturally aligned.\n    # Matches PyTorch's CUDA caching allocator (256-byte) and is enough to\n    # satisfy `cp.async.cg.shared.global` 16B / vectorized loads when a\n    # buffer is read directly from LPDDR via ATS (--ats-decomp).\n    _ALLOC_ALIGN = 256\n\n    def _find_and_alloc(self, req_bytes, shape, stride, dtype, page_type):\n        \"\"\"내부 유틸리티: 빈 블록을 찾아 할당을 시도하고, 상세 정보를 내부적으로 저장\"\"\"\n        align = self._ALLOC_ALIGN\n        reserved_bytes = (req_bytes + align - 1) & ~(align - 1)\n        for page in self.pages[page_type]:\n            for i, block in enumerate(page[\"blocks\"]):\n                if block[\"free\"] and block[\"size\"] >= reserved_bytes:\n                    tensor_ptr = page[\"base_ptr\"] + block[\"offset\"]\n                    tensor = huge_page_allocator_ext.allocate(\n                        tensor_ptr, req_bytes, list(shape), list(stride),\n                        dtype)\n\n                    alloc_info = {\n                        \"path\": page[\"path\"],\n                        \"offset\": block[\"offset\"],\n                        \"page_size\": self.hp_size,\n                        \"type\": page_type,\n                    }\n                    self.allocations[tensor.data_ptr()] = alloc_info\n\n                    original_size = block[\"size\"]\n                    block[\"size\"] = reserved_bytes\n                    block[\"free\"] = False\n                    if original_size > reserved_bytes:\n                        new_block = {\n                            \"offset\": block[\"offset\"] + reserved_bytes,\n                            \"size\": original_size - reserved_bytes,\n                            \"free\": True,\n                        }\n                        page[\"blocks\"].insert(i + 1, new_block)\n\n                    return tensor\n        return None\n\n    def allocate(self,\n                 shape,\n                 stride,\n                 dtype=torch.float32,\n                 page_type: str = \"weight\"):\n        req_bytes = math.prod(shape) * torch.empty([],\n                                                   dtype=dtype).element_size()\n        if req_bytes == 0 or len(shape) == 0:\n            return torch.empty(shape, dtype=dtype)\n        if req_bytes > self.hp_size:\n            raise ValueError(\"Requested size exceeds page size.\")\n        if page_type not in self.pages:\n            raise MemoryError(f\"No pages for type '{page_type}'.\")\n\n        tensor = self._find_and_alloc(req_bytes, shape, stride, dtype,\n                                      page_type)\n        if tensor