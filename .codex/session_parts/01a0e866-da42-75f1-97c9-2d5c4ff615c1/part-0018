 0:\\n                logger.warning(\\n                    f\\\"[PERF] load_kv L{layer_id} \\\"\\n                    \\\"NO persistent compressed data — skipping\\\")\\n            self._stage_tail_rollovers(\\n                layer_id, self.kv_compressor.batch_decomp_stream)\\n            return False\\n\\n        if _ENV_KV_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_push(\\n                f\\\"decompress_persistent L{layer_id} \\\"\\n                f\\\"n={len(self.active_kv_buffer_ids)}\\\")\\n        if self.time_breakdown:\\n            self.begin_memcpy_kv_events[layer_id].record(self.load_kv_stream)\\n            self.begin_kv_decomp_events[layer_id].record(\\n                self.kv_compressor.batch_decomp_stream)\\n\\n        # decode(L) WRITES primary[L%P]; the same-parity prior offload (L-P)\\n        # READ that buffer.  With parity>=2 (kv_decode_n_parity=P) this is the\\n        # single in-flight reader of L's buffer, so one event closes the WAR.\\n        _np = DualMemoryLoader.kv_decode_n_parity or 1\\n        # JIT decode (parity=1): decode(idx) writes the single buffer that\\n        # offload(idx-1) is reading in the same before_replay → wait it (offset 1).\\n        # parity>=2: wait the same-parity prior offload (offset _np).\\n        # offset = same-parity reuse distance: parity P -> prior reader of\\n        # decode(idx)'s buffer is offload(idx-P).  JIT single buffer (P=1) -> 1.\\n        _off = max(1, _np)\\n        self.kv_compressor.batch_decomp_stream.wait_event(\\n            self.kv_unload_done[(layer_id - _off) % self.n_layers])\\n        self._check_kv_load_metrics_support()\\n        ok = self.kv_compressor.start_kv_h2d_persistent(\\n            layer_id,\\n            self.active_kv_buffer_ids,\\n            DualMemoryLoader.primary_k_caches[layer_id],\\n            DualMemoryLoader.primary_v_caches[layer_id])\\n        if not ok:\\n            if _ENV_KV_DETAILED_NVTX:\\n                torch.cuda.nvtx.range_pop()\\n            self._stage_tail_rollovers(\\n                layer_id, self.kv_compressor.batch_decomp_stream)\\n            return False\\n        if self.batch_has_prefill:\\n            self.prefill_kv_comp_load_layers += 1\\n        return True\\n\\n    @_nsys_trace.call(\\\"KVRestore.finish\\\", \\\"decomp\\\", key=\\\"layer_id\\\")\\n    def finish_kv_decompress(self, layer_id: int):\\n        \\\"\\\"\\\"Phase 2 of split KV decompress: launch decompress kernels.\\\"\\\"\\\"\\n        if self.kv_load_metrics is not None:\\n            self.kv_load_metrics.layer = layer_id\\n        self.kv_compressor.finish_kv_decompress_persistent(\\n            layer_id,\\n            DualMemoryLoader.primary_k_caches[layer_id],\\n            DualMemoryLoader.primary_v_caches[layer_id])\\n        self._stage_tail_rollovers(\\n            layer_id, self.kv_compressor.batch_decomp_stream)\\n\\n        if self.time_breakdown:\\n            self.end_memcpy_kv_events[layer_id].record(self.load_kv_stream)\\n            self.end_kv_decomp_events[layer_id].record(\\n                self.kv_compressor.batch_decomp_stream)\\n        if _ENV_KV_DETAILED_NVTX:\\n            torch.cuda.nvtx.range_pop()  # decompress_persistent\\n\\n    def unload_kv(self, layer_id: int, non_blocking=True):\\n        if DualMemoryLoader.no_offload_kv:\\n            return\\n        target_cache = DualMemoryLoader.kv_caches[layer_id]\\n        if target_cache.primary_kv is None or target_cache.secondary_kv is None:\\n            return\\n\\n        targets = self._unload_ranges\\n        if not targets:\\n            return\\n\\n        from tiered_serve.kv_cache import _get_zipserv\\n        ranges_flat = [v for pair in targets for v in pair]\\n        stream = self.unload_kv_stream\\n        _get_zipserv().batch_kv_memcpy(\\n            target_cache.secondary_kv[0], target_cache.secondary_kv[1],\\n            target_cache.primary_kv[0], target_cache.primary_kv[1],\\n            ranges_flat, self.num_dedicated