mped_kv(self, layer_id: int):\\n        if len(self.kv_buffer_ids) == 0:\\n            return\\n\\n        # ── KV-offload run-to-run determinism (single-decode-buffer race) ──────\\n        # ROOT: kvcomp historically forced n_kv_parity=1, so ALL layers + prefill\\n        # share ONE decode buffer (gpu_worker decode_kv_buffers).  The offload(L)\\n        # D2H reads that buffer; under the deep fused-mm look-ahead a *different*\\n        # layer's decode / the prefill write hits the same buffer concurrently:\\n        #   (1) prefill read-before-write: the first compress (c=0) reads the\\n        #       buffer before the producer fills it -> ZEROS in ~half the runs\\n        #       (measured: per-layer c=0 input alternates 0 / real run-to-run),\\n        #       which then propagates through the compress->decode feedback loop;\\n        #   (2) decode-phase WAR: decode(L) overwrites the buffer while offload\\n        #       still reads it.\\n        # FIX (gpu_worker always allocates parity=2 for even-layer KV-comp):\\n        #   * parity=2 splits even/odd layers onto 2 buffers AND sets\\n        #     kv_decode_n_parity=2, which makes the decode gate in\\n        #     start_kv_decompress (decode(L) waits offload(L-2)=same-parity prior,\\n        #     the single in-flight reader of L's buffer) correct -> closes (2);\\n        #   * the wrapper's prefill load gate waits kv_unload_done before raw\\n        #     load_kv overwrites the parity buffer, closing (1).\\n        # No per-layer device sync is needed.  Legacy drains remain opt-in via\\n        # TIERED_SERVE_KV_DRAIN_OFFLOAD (1=full every offload, 2=targeted, 3=full\\n        # on prefill only).\\n        if (_ENV_KV_DRAIN_OFFLOAD != \\\"0\\\"\\n                and not torch.cuda.is_current_stream_capturing()):\\n            if _ENV_KV_DRAIN_OFFLOAD == \\\"3\\\" and self.batch_has_prefill:\\n                torch.cuda.synchronize()\\n            elif _ENV_KV_DRAIN_OFFLOAD == \\\"2\\\":\\n               