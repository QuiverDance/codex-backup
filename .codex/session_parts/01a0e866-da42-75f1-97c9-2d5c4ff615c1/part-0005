egment_bytes == 0\\n                            && reinterpret_cast<uintptr_t>(arena.data_ptr()) % 8 == 0,\\n                        \\\"hybrid arenas must be aligned pinned byte vectors of whole segments\\\");\\n            const auto address = reinterpret_cast<uintptr_t>(arena.data_ptr());\\n            TORCH_CHECK(arena.nbytes() <= std::numeric_limits<uintptr_t>::max() - address,\\n                        \\\"hybrid entry arena address overflow\\\");\\n            if (arena.numel()) {\\n                ranges.emplace_back(address, address + arena.nbytes());\\n            }\\n            TORCH_CHECK(arena.numel() <= std::numeric_limits<int64_t>::max() - capacity_bytes,\\n                        \\\"hybrid entry pool size overflow\\\");\\n            capacity_bytes += arena.numel();\\n            count += arena.numel() / segment_bytes;\\n        }\\n        std::sort(ranges.begin(), ranges.end());\\n        for (size_t i = 1; i < ranges.size(); ++i) {\\n            TORCH_CHECK(ranges[i - 1].second <= ranges[i].first,\\n                        \\\"hybrid entry arenas must not overlap\\\");\\n        }\\n        segments.reserve(count);\\n        free_segments.reserve(count);\\n        for (const auto& arena : arenas) {\\n            for (int64_t offset = 0; offset < arena.numel(); offset += segment_bytes) {\\n                HybridEntrySegment segment;\\n                segment.data = arena.data_ptr<uint8_t>() + offset;\\n                segments.push_back(segment);\\n            }\\n        }\\n        for (int64_t i = count; i > 0; --i) {\\n            free_segments.push_back(i - 1);\\n        }\\n    }\\n\\n    bool valid(const HybridSegmentRef& ref) const\\n    {\\n        return ref.index >= 0 && static_cast<size_t>(ref.index) < segments.size()\\n            && segments[ref.index].allocated && segments[ref.index].generation == ref.generation;\\n    }\\n\\n    HybridEntryLocation append(HybridSegmentRef& tail, int64_t words, const int64_t* source)\\n    {\\n        if (words == 0) {\\n            return {};\\n        }\\n        TORCH_CHECK(words > 0 && words <= segment_bytes / 8,\\n                    \\\"hybrid entry record exceeds its fixed segment capacity\\\");\\n        HybridEntryLocation location;\\n        uint8_t* destination;\\n        {\\n            std::lock_guard<std::mutex> lock(mutex);\\n            TORCH_CHECK(!closed, \\\"hybrid entry pool is closed\\\");\\n            const int64_t bytes = words * 8;\\n            if (!valid(tail) || segments[tail.index].used > segment_bytes - bytes) {\\n                TORCH_CHECK(!free_segments.empty(), \\\"hybrid entry segment budget exhausted\\\");\\n                const auto index = free_segments.back();\\n                free_segments.pop_back();\\n                auto& segment = segments[index];\\n                TORCH_CHECK(segment.generation < std::numeric_limits<uint64_t>::max(),\\n                            \\\"hybrid entry segment generation exhausted\\\");\\n                ++segment.generation;\\n                segment.allocated = true;\\n                tail = {index, segment.generation};\\n            }\\n            auto& segment = segments[tail.index];\\n            location = {tail, segment.used, words};\\n            destination = segment.data + segment.used;\\n            segment.used += bytes;\\n            ++segment.references;\\n            live_entry_bytes += bytes;\\n        }\\n        // The pending record reference protects this allocation while copying;\\n        // the shared pool lock never spans payload copies or allocator callbacks.\\n        std::memcpy(destination, source, words * sizeof(int64_t));\\n        return location;\\n    }\\n\\n    void recycle_if_unused(HybridEntrySegment& segment, int64_t index)\\n    {\\n        if (segment.references == 0 && segment.readers == 0) {\\n            segment.allocated = false;\\n            segment.used = 0;\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"16500d\",\"wall_time_seconds\":0.000014401,\"exit_code\":0,\"original_token_count\":68,\"output\":\"fault mapping ('0x200800000', '0x200c00000', '0x6', '0x400000', '0xa57e0000')\\nfault mapping ('0x200c00000', '0x201200000', '0x0', '0x0', '0xa5be0000')\\nside 0 unreadable_source_ranges [] destination_overlaps []\\nside 1 unreadable_source_ranges [] destination_overlaps []\\n\"}"},{"type":"input_text","text":"CUDA Driver API :: CUDA Toolkit Documentation (https://docs.nvidia.com/cuda/archive/13.2.1/cuda-driver-api/group__CUDA__MEM.html)\nciteturn5view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://docs.nvidia.com/cuda/archive/13.2.1/cuda-driver-api/group__CUDA__MEM.html\",\"lineno\":null}); Total lines: 3440\n--------------------------------------------------------------------------------\nCUDA Driver API :: CUDA Toolkit Documentation (https://docs.nvidia.com/cuda/archive/13.2.1/cuda-driver-api/group__CUDA__MEM.html)\nciteturn5view1 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"https://docs.nvidia.com/cuda/archive/13.2.1/cuda-driver-api/group__CUDA__MEM.html\",\"pattern\":\"there is no guarantee\"}); Total lines: 3440\nL1197: ###### Parameters\nL1198: \nL1199: `dptr`\nL1200:     - Returned device pointer\nL1201: `bytesize`\nL1202:     - Requested allocation size in bytes\nL1203: `flags`\nL1204:     - Must be one of cite377†CU_MEM_ATTACH_GLOBAL or cite378†CU_MEM_ATTACH_HOST L1205: \nL1206: ###### Returns\nL1207: \nL1208: cite237†CUDA_SUCCESS , cite238†CUDA_ERROR_DEINITIALIZED , cite239†CUDA_ERROR_NOT_INITIALIZED , cite240†CUDA_ERROR_INVALID_CONTEXT , cite350†CUDA_ERROR_NOT_SUPPORTED , cite241†CUDA_ERROR_INVALID_VALUE , cite242†CUDA_ERROR_OUT_OF_MEMORY L1209: ###### Description\nL1210: Allocates `bytesize` bytes of managed memory on the device and returns in `*dptr` a pointer to the allocated memory. If the device doesn't support allocating managed memory, cite350†CUDA_ERROR_NOT_SUPPORTED is returned. Support for managed memory can be queried using the device attribute cite379†CU_DEVICE_ATTRIBUTE_MANAGED_MEMORY . The allocated memory is suitably aligned for any kind of variable. The memory is not cleared. If `bytesize` is 0, cite175†cuMemAllocManaged returns cite241†CUDA_ERROR_INVALID_VALUE .\nL1211: The pointer is valid on the CPU and on all GPUs in the system that support managed memory. All accesses to this pointer must obey the Unified Memory programming model.\nL1212: `flags` specifies the default stream association for this allocation. `flags` must be one of cite377†CU_MEM_ATTACH_GLOBAL or cite378†CU_MEM_ATTACH_HOST . If cite377†CU_MEM_ATTACH_GLOBAL is specified, then this memory is accessible from any stream on any device.\nL1213: If cite378†CU_MEM_ATTACH_HOST is specified, then the allocation should not be accessed from devices that have a zero value for the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS ; an explicit call to cite381†cuStreamAttachMemAsync will be required to enable access on such devices.\nL1214: If the association is later changed via cite381†cuStreamAttachMemAsync to a single stream, the default association as specified during cite175†cuMemAllocManaged is restored when that stream is destroyed. For __managed__ variables, the default association is always cite377†CU_MEM_ATTACH_GLOBAL . Note that destroying a stream is an asynchronous operation, and as a result, the change to default association won't happen until all work in the stream has completed.\nL1215: Memory allocated with cite175†cuMemAllocManaged should be released with cite179†cuMemFree .\nL1216: \nL1217: Device memory oversubscription is possible for GPUs that have a non-zero value for the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS . Managed memory on such GPUs may be evicted from device memory to host memory at any time by the Unified Memory driver in order to make room for other allocations.\nL1218: In a system where all GPUs have a non-zero value for the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS , managed memory may not be populated when this API returns and instead may be populated on access. In such systems, managed memory can migrate to any processor's memory at any time. The Unified Memory driver will employ heuristics to maintain data locality and prevent excessive page faults to the extent possible.\nL1219: The application can also guide the driver about memory usage patterns via cite382†cuMemAdvise . The application can also explicitly migrate memory to a desired processor's memory via cite383†cuMemPrefetchAsync .\nL1220: In a multi-GPU system where all of the GPUs have a zero value for the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS and all the GPUs have peer-to-peer support with each other, the physical storage for managed memory is created on the GPU which is active at the time cite175†cuMemAllocManaged is called. All other GPUs will reference the data at reduced bandwidth via peer mappings over the PCIe bus. The Unified Memory driver does not migrate memory among such GPUs.\nL1221: In a multi-GPU system where not all GPUs have peer-to-peer support with each other and where the value of the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS is zero for at least one of those GPUs, the location chosen for physical storage of managed memory is system-dependent.\nL1222:   * On Linux, the location chosen will be device memory as long as the current set of active contexts are on devices that either have peer-to-peer support with each other or have a non-zero value for the device attribute cite380†CU_DEVICE_ATTRIBUTE_CONCURRENT_MANAGED_ACCESS .\nL1223: If there is an active context on a GPU that does not have a non-zero value for that device attribute and it does not have peer-to-peer support with the other devices that have active contexts on them, then the location for physical storage will be 'zero-copy' or host memory.\nL1224: Note that this means that managed memory that is located in device memory is migrated to host memory if a new context is created on a GPU that doesn't have a non-zero value for the device attribute and does not support peer-to-peer with at least one of the other devices that has an active context. This in turn implies that context creation may fail if there is insufficient host memory to migrate all managed allocations.\nL1225:   * On Windows, the physical storage is always created in 'zero-copy' or host memory. All GPUs will reference the data at reduced bandwidth over the PCIe bus. In these circumstances, use of the environment variable CUDA_VISIBLE_DEVICES is recommended to restrict CUDA to only use those GPUs that have peer-to-peer support. Alternatively, users can also set CUDA_MANAGED_FORCE_DEVICE_ALLOC to a non-zero value to force the driver to always use device memory for physical storage.\nL1226: When this environment variable is set to a non-zero value, all contexts created in that process on devices that support managed memory have to be peer-to-peer compatible with each other. Context creation will fail if a context is created on a device that supports managed memory and is not peer-to-peer compatible with any of the other managed memory supporting devices on which contexts were previously created, even if those contexts have been destroyed.\nL1227: These environment variables are described in the CUDA programming guide under the \"CUDA environment variables\" section.\nL1228:   * On ARM, managed memory is not available on discrete gpu with Drive PX-2.\nL1229: \nL1230: Note:\nL1231: \nL1232: Note that this function may also return error codes from previous, asynchronous launches.\nL1233: \nL1234: See also:\nL1235: cite150†cuArray3DCreate , cite152†cuArray3DGetDescriptor , cite153†cuArrayCreate , cite154†cuArrayDestroy , cite155†cuArrayGetDescriptor , cite174†cuMemAllocHost , cite176†cuMemAllocPitch , cite191†cuMemcpy2D , cite192†cuMemcpy2DAsync , cite193†cuMemcpy2DUnaligned , cite194†cuMemcpy3D , cite195†cuMemcpy3DAsync , cite201†cuMemcpyAtoA , cite202†cuMemcpyAtoD , cite203†cuMemcpyAtoH , cite204†cuMemcpyAtoHAsync , cite206†cuMemcpyDtoA , cite207†cuMemcpyDtoD , cite208†cuMemcpyDtoDAsync , cite209†cuMemcpyDtoH , cite210†cuMemcpyDtoHAsync , cite211†cuMemcpyHtoA , cite212†cuMemcpyHtoAAsync , cite213†cuMemcpyHtoD , cite214†cuMemcpyHtoDAsync , cite179†cuMemFree , cite180†cuMemFreeHost , cite181†cuMemGetAddressRange , cite184†cuMemGetInfo , cite185†cuMemHostAlloc , cite186†cuMemHostGetDevicePointer , cite225†cuMemsetD2D8 , cite221†cuMemsetD2D16 , cite223†cuMemsetD2D32 , cite229†cuMemsetD8 , cite219†cuMemsetD16 , cite227†cuMemsetD32 , cite347†cuDeviceGetAttribute , cite381†cuStreamAttachMemAsync , cite384†cudaMallocManaged L1236: cite149†CUresult cuMemAllocPitch ( cite167†CUdeviceptr * dptr, size_t* pPitch, size_t WidthInBytes, size_t Height, unsigned int  ElementSizeBytes )\nL1237: \nL1238: \nL1239: Allocates pitched device memory.\nL1240: ###### Parameters\nL1241: \nL1242: `dptr`\nL1243:     - Returned device pointer\nL1244: `pPitch`\nL1245:     - Returned pitch of allocation in bytes\nL1246: `WidthInBytes`\nL1247:     - Requested allocation width in bytes\nL1248: `Height`\nL1249:     - Requested allocation height in rows\nL1250: `ElementSizeBytes`\nL1251:     - Size of largest reads/writes for range\nL1252: \nL1253: ###### Returns\nL1254: \nL1255: cite237†CUDA_SUCCESS , cite238†CUDA_ERROR_DEINITIALIZED , cite239†CUDA_ERROR_NOT_INITIALIZED , cite240†CUDA_ERROR_INVALID_CONTEXT , cite241†CUDA_ERROR_INVALID_VALUE , cite242†CUDA_ERROR_OUT_OF_MEMORY L1256: ###### Description\nL1257: Allocates at least `WidthInBytes` * `Height` bytes of linear memory on the device and returns in `*dptr` a pointer to the allocated memory. The function may pad the allocation to ensure that corresponding pointers in any given row will continue to meet the alignment requirements for coalescing as the address is updated from row to row. `ElementSizeBytes` specifies the size of the largest reads and writes that will be performed on the memory range.\nL1258: `ElementSizeBytes` may be 4, 8 or 16 (since coalesced memory transactions are not possible on other data sizes). If `ElementSizeBytes` is smaller than the actual read/write size of a kernel, the kernel will run correctly, but possibly at reduced speed. The pitch returned in `*pPitch` by cite176†cuMemAllocPitch() is the width in bytes of the allocation. The intended usage of pitch is as a separate parameter of the allocation, used to compute addresses within the 2D array.\nL1259: Given the row and column of an array element of type T, the address is computed as:\nL1260: \nL1261:     ‎   T* pElement = (T*)((char*)BaseAddress + Row * Pitch) + Column;\nL1262: The pitch returned by cite176†cuMemAllocPitch() is guaranteed to work with cite191†cuMemcpy2D() under all circumstances. For allocations of 2D arrays, it is recommended that programmers consider performing pitch allocations using cite176†cuMemAllocPitch() . Due to alignment restrictions in the hardware, this is especially true if the application will be performing 2D memory copies between different regions of device memory (whether linear memory or CUDA arrays).\nL1263: The byte alignment of the pitch returned by cite176†cuMemAllocPitch() is guaranteed to match or exceed the alignment requirement for texture binding with cite385†cuTexRefSetAddress2D() .\nL1264: \nL1265: Note:\nL1266: \nL1267: Note that this function may also return error codes from previous, asynchronous launches.\nL1268: \nL1269: See also:\nL1270: cite150†cuArray3DCreate , cite152†cuArray3DGetDescriptor , cite153†cuArrayCreate , cite154†cuArrayDestroy , 