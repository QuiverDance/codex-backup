, \"free_slot_profiled\")\n    canonical_trace = []\n    profiled_trace = []\n    options = {\n        \"offload_system\": offload_system,\n        \"compressor\": compressor,\n        \"metadata_only\": metadata_only,\n        \"use_kv_comp\": use_kv_comp,\n    }\n    _configure_policy(canonical, canonical_trace, **options)\n    _configure_policy(profiled, profiled_trace, **options)\n\n    canonical.free_slot(13)\n    profiled.free_slot_profiled(13)\n\n    assert profiled_trace == canonical_trace\n\n\ndef test_step_aggregation_handles_multiple_and_zero_callbacks():\n    namespace = _offline_metrics_namespace()\n    build = namespace[\"build_kv_free_step_metrics\"]\n    format_row = namespace[\"format_kv_free_breakdown_row\"]\n    columns = namespace[\"KV_FREE_BREAKDOWN_COLUMNS\"]\n    step = {\n        \"phase\": 9,\n        \"decode_step\": 4,\n        \"active_before\": 3,\n        \"active_after\": 1,\n        \"finished_reqs\": 2,\n        \"step_latency_ms\": 10.0,\n    }\n    records = (\n        {\n            \"elapsed_ns\": 1_000_000,\n            \"input_blocks\": 10,\n            \"offload_blocks\": 8,\n            \"final_ref_offload_blocks\": 8,\n            \"slot_manager_ns\": 200_000,\n            \"stream_sync_ns\": 100_000,\n            \"compressor_ns\": 300_000,\n        },\n        {\n            \"elapsed_ns\": 2_000_000,\n            \"input_blocks\": 20,\n            \"offload_blocks\": 18,\n            \"final_ref_offload_blocks\": 17,\n            \"slot_manager_ns\": 400_000,\n            \"stream_sync_ns\": 0,\n            \"compressor_ns\": 800_000,\n        },\n    )\n\n    metrics = build(step, records)\n    assert metrics[\"callbacks\"] == 2\n    assert metrics[\"input_blocks\"] == 30\n    assert metrics[\"offload_blocks\"] == 26\n    assert metrics[\"final_ref_offload_blocks\"] == 25\n    assert metrics[\"cleanup_ms\"] == 3.0\n    assert metrics[\"slot_manager_ms\"] == 0.6\n    assert metrics[\"stream_sync_ms\"] == 0.1\n    assert metrics[\"compressor_ms\"] == 1.1\n    assert metrics[\"outer_ms\"] == 1.2\n    assert metrics[\"cleanup_fraction\"] == 0.3\n\n    row = format_row(128, metrics).split()\n    assert len(row) == len(columns)\n    assert dict(zip(columns, row)) == {\n        \"batch\": \"128\",\n        \"phase\": \"9\",\n        \"decode_step\": \"4\",\n        \"active_before\": \"3\",\n        \"active_after\": \"1\",\n        \"finished_reqs\": \"2\",\n        \"step_latency_ms\": \"10.000000\",\n        \"kv_cleanup_callbacks\": \"2\",\n        \"free_input_blocks\": \"30\",\n        \"free_offload_blocks\": \"26\",\n        \"free_final_ref_offload_blocks\": \"25\",\n        \"kv_cleanup_ms\": \"3.000000\",\n        \"free_slot_manager_ms\": \"0.600000\",\n        \"free_stream_sync_ms\": \"0.100000\",\n        \"free_compressor_ms\": \"1.100000\",\n        \"kv_cleanup_outer_ms\": \"1.200000\",\n        \"kv_cleanup_fraction\": \"0.300000\",\n    }\n\n    zero = build({**step, \"step_latency_ms\": 0.0}, ())\n    assert zero[\"callbacks\"] == 0\n    assert zero[\"cleanup_ms\"] == 0.0\n    assert zero[\"outer_ms\"] == 0.0\n    assert zero[\"cleanup_fraction\"] == 0.0\n\n\ndef test_adjacent_step_checkpoint_slices_do_not_mix_callbacks():\n    build = _offline_metrics_namespace()[\"build_kv_free_step_metrics\"]\n    step = {\n        \"phase\": 1,\n        \"decode_step\": 0,\n        \"active_before\": 2,\n        \"active_after\": 1,\n        \"finished_reqs\": 1,\n        \"step_latency_ms\": 5.0,\n    }\n    records = (\n        {\n            \"elapsed_ns\": 1_000_000,\n            \"input_blocks\": 1,\n            \"offload_blocks\": 1,\n            \"final_ref_offload_blocks\": 1,\n            \"slot_manager_ns\": 0,\n            \"stream_sync_ns\": 0,\n            \"compressor_ns\": 1_000_000,\n        },\n        {\n            \"elapsed_ns\": 2_000_000,\n            \"input_blocks\": 2,\n            \"offload_blocks\": 2,\n            \"final_ref_offload_blocks\": 2,\n     