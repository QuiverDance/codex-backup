   \"ChunkDelta3 KV buffers: block_shape=%s matrix=%dx%d \"\n            \"entry_capacity=%d body=%d host_slot=%d bytes \"\n            \"(%.3fx raw worst-case allocation) \"\n            \"max_blocks=%d layers=%d\",\n            block_shape, M_b, K_b, entry_capacity, self._body_stride,\n            slot_bytes,\n            (block_numel * 2) / slot_bytes, max_n_blocks, n_layers)\n\n    def _new_persistent_csr(self, layer_id: int, kv: str):\n        \"\"\"Lazily allocate stable pinned CSR storage for one layer/side.\"\"\"\n        host_rows = self._max_n_blocks + 1\n        max_words = host_rows * self._packed_capacity\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\n                     * self._packed_capacity)\n        initial_words = min(\n            max_words,\n            max(1024, host_rows * self._csr_initial_words_per_slot),\n        )\n        state = _PersistentCSRState(\n            entries=torch.empty(\n                initial_words, dtype=torch.int64).pin_memory(),\n            offsets=torch.zeros(\n                host_rows, dtype=torch.int64).pin_memory(),\n            word_counts=np.zeros(host_rows, dtype=np.int64),\n            used_words=0,\n            garbage_words=0,\n            max_words=max_words,\n            gpu_words=gpu_words,\n        )\n        self._persistent_csr[layer_id][kv] = state\n        return state\n\n    def _rebuild_persistent_csr(self, layer_id: int, kv: str):\n        \"\"\"Compact append garbage off the request path in the CPU worker.\"\"\"\n        pool = self._host_pools[layer_id][kv]\n        rows = self._kv_active_count[layer_id]\n        slots = np.arange(rows, dtype=np.int64)\n        counts = pool[\"num_exceptions\"].numpy()[:rows]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        total_words = int(word_counts.sum())\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\n                     * self._packed_capacity)\n        if total_words > max_words:\n            raise RuntimeError(\n                \"ChunkDelta3 persistent CSR exceeds host slot capacity: \"\n                f\"layer={layer_id} side={kv} words={total_words} \"\n                f\"capacity={max_words}\")\n        previous = self._persistent_csr[layer_id][kv]\n        previous_capacity = (\n            previous.entries.numel() if previous is not None else 0)\n        capacity = max(\n            1024, total_words,\n            min(max_words, previous_capacity),\n        )\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\n        offsets = torch.zeros(\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\n        if rows:\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                torch.from_numpy(slots), entries[:total_words],\n                offsets[:rows])\n        state = _PersistentCSRState(\n            entries=entries,\n            offsets=offsets,\n            word_counts=np.zeros(\n                self._max_n_blocks + 1, dtype=np.int64),\n            used_words=total_words,\n            garbage_words=0,\n            max_words=max_words,\n            gpu_words=gpu_words,\n        )\n        state.word_counts[:rows] = word_counts\n        self._persistent_csr[layer_id][kv] = state\n        return state\n\n    def _append_persistent_csr(\n            self, layer_id: int, kv: str, slots: np.ndarray) -> None:\n        \"\"\"Publish freshly encoded slots into the persistent CSR arena.\"\"\"\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\n        if slots.size == 0:\n            return\n        pool = self._host_pools[layer_id][kv]\n        counts = pool[\"num_exceptions\"].numpy()[slots]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        new_word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        append_words = int(new_word_counts.sum())\n        state = self._persistent_csr[layer_id][kv]\n        if state is None:\n            state = self._new_persistent_csr(layer_id, kv)\n\n        old_words = int(state.word_counts[slots].sum())\n        required = int(state.used_words) + append_words\n        # Reuse/re-encode churn can leave unreachable append records.  Only\n        # compact in the worker when it avoids growth or is required to stay\n        # within the fixed GPU CSR staging capacity.\n        should_compact = required > state.max_words\n        should_compact |= (\n            required > state.gpu_words\n            and self._kv_active_count[layer_id]\n            <= self._max_gpu_decomp_blocks + 1)\n        should_compact |= (\n                and cached[0] == generation\n                and cached[3] == version):\n            filtered = cached[2]\n        else:\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\n            filtered = np.ascontiguousarray(\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\n            self._decode_filtered[layer_id] = (\n                generation, candidates, filtered, version)\n        if filtered.size == 0:\n            return\n\n        filtered = self._restore_secondary_fallbacks(\n            layer_id, filtered, k_cache, v_cache)\n        if filtered.size == 0:\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _restore_secondary_fallbacks(\n            self, layer_id: int, candidates: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\n        \"\"\"Res