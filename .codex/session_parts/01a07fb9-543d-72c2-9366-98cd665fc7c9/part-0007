l_output","id":"ctco_01a07fc7-5a79-7172-8b45-daf8480328db","call_id":"call_NskToOUYmbLqoNnnnwtFXruV","output":[{"type":"input_text","text":"Script completed\nWall time 1.8 seconds\nOutput:\n"},{"type":"input_text","text":"import torch\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\nimport time as _time\n\n\n_ENV_KV_DRAIN_OFFLOAD = os.getenv(\"TIERED_SERVE_KV_DRAIN_OFFLOAD\", \"0\")\n_ENV_KV_CPU_PROFILE = os.getenv(\"TIERED_SERVE_KV_CPU_PROFILE\", \"0\") == \"1\"\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\nclass KVMixin:\n\n    @classmethod\n    def record_tail_write(cls, write) -> None:\n        \"\"\"Record one canonical scheduler block occupancy transition.\n\n        EngineCore calls this before the worker prepares its input table.  The\n        feature-disabled path is an intentional no-op so the legacy unload\n        callback can share the same metadata contract.\n        \"\"\"\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is None:\n            raise RuntimeError(\n                \"full-block KV write arrived before tail residency setup\")\n        manager.record_write(\n            request_id=write.request_id,\n            block_id=write.block_id,\n            block_index=write.block_index,\n            pre_valid=write.pre_valid,\n            post_valid=write.post_valid,\n            block_size=write.block_size,\n        )\n\n    @classmethod\n    def free_tail_block(cls, block_id: int) -> None:\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is not None:\n            manager.free_block(block_id)\n\n    def configure_tail_residency(\n        self,\n        canonical_dedicated: int,\n        tail_slots: int,\n        physical_buffer_offset: int,\n    ) -> None:\n        \"\"\"Install the fixed request-tail pool after KV tensors are allocated.\"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        if tail_slots != self.batch_size:\n            raise RuntimeError(\n                \"tail_slots must equal max_num_reqs: \"\n                f\"slots={tail_slots}, max_num_reqs={self.batch_size}\")\n        if physical_buffer_offset != canonical_dedicated + tail_slots:\n            raise RuntimeError(\n                \"invalid tail physical namespace: \"\n                f\"offset={physical_buffer_offset}, D={canonical_dedicated}, \"\n                f\"S={tail_slots}\")\n        from tiered_serve.kv_tail_residency import KVTailResidencyManager\n\n        manager = KVTailResidencyManager(\n            max_num_reqs=tail_slots, block_size=16)\n        DualMemoryLoader.tail_manager = manager\n        self.tail_manager = manager\n        self.num_tail_slots = int(tail_slots)\n        self.kv_physical_block_offset = int(physical_buffer_offset)\n        self.tail_step_plan = None\n        self.tail_rollover_local_ids = []\n        self.tail_rollover_slots = []\n        self.tail_resident_local_ids = []\n        self.tail_completed_local_ids = []\n        self.tail_lp_skip_local_ids = []\n        self._tail_steps = 0\n        self._tail_resident_block_steps = 0\n        self._tail_completed_full_blocks = 0\n        self._tail_rollover_blocks = 0\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\nfrom tiered_serve.dual_memory_loader.init import InitMixin\nfrom tiered_serve.dual_memory_loader.frozen_split import FrozenSplitMixin\nfrom tiered_serve.dual_memory_loader.compressor import CompressorMixin\nfrom tiered_serve.dual_memory_loader.fused_mm import FusedMMMixin\nfrom tiered_serve.dual_memory_loader.weights import WeightLoadMixin\nfrom tiered_serve.dual_memory_loader.kv import KVMixin\nfrom tiered_serve.dual_memory_loader.timing import TimingMixin\n\n\nvmm_allocator_ext = load(\n    name=\"vmm_allocator\",\n    sources=[\n        \"etc/vmm_allocator/vmm_allocator.cpp\",\n    ],\n    with_cuda=True,\n    extra_cflags=[\n        \"-D_GLIBCXX_USE_CXX11_ABI=1\",\n        \"-O3\",\n        \"-std=gnu++17\",\n    ],\n    extra_ldflags=[\n        f\"-L{sysconfig.get_config_var('LIBDIR')}\",\n        \"-L/usr/lib/aarch64-linux-gnu\",\n        \"-lcuda\",\n    ],\n)\n\n\nclass DualMemoryLoader(\n    InitMixin,\n    FrozenSplitMixin,\n    CompressorMixin,\n    FusedMMMixin,\n    WeightLoadMixin,\n    KVMixin,\n    TimingMixin,\n):\n    # batch_has_prefill: True whenever the current batch contains ANY prefill\n    # chunk (attn_metadata.max_query_len > 1), independent of cudagraph mode.\n    # Single source of truth for every prefill-vs-decode decision (weight\n    # path, KV path, breakdown labels).  True even for a prefill chunk that\n    # runs under a PIECEWISE graph (which a cudagraph-mode check would miss).\n    batch_has_prefill = False\n    # Current batch's total token count (1 for a single-token decode step).\n    # Set per-forward in torch_hooks.before_model_forward alongside\n    # batch_has_prefill; used to pick the prefill weight codec (large batches\n    # amortise raw_bf16's H2D, small batches prefer a compressed fast-decode\n    # codec).\n    cur_num_tokens = 1\n    # ran_eager: did the last forward run eager (no CUDA graph)?  Used only\n    # for timing-event stream selection in torch_hooks; NOT a prefill signal.\n    ran_eager = False\n    is_profiling = False\n\n    is_graph_capturing = False\n    is_graph_warming_up = False\n\n    kv_caches = []\n    unload_targets: set = set()\n    num_dedicated_blocks = None\n    # P4Flat full-block-only mode: each active request owns one physical HBM\n    # tail row until its 16-token block completes.\n    kv_full_block_only = False\n    num_tail_slots = 0\n    kv_physical_block_offset = None\n    tail_manager = None\n    tail_k_caches = None\n    tail_v_caches = None\n    no_offload_kv = False\n    # Opt-in mixed/prefill route: reconstruct historical offloaded blocks from\n    # the persistent compressed store. Fresh prompt blocks have no persistent\n    # slot and are filtered by the compressor before attention writes them.\n    # Resolved once during loader setup; never read from os.environ per layer.\n    kv_comp_prefill_load = False\n    # Number of parity slots in the HBM decode buffer (set by gpu_worker):\n    # 1 = single shared buffer (legacy), 2 = double-buffer ping-pong by layer\n    # parity.  ==2 enables the raw post-D2H unload event below.\n    kv_decode_n_parity = 1\n\n    slot_managers = None\n\n    # Per-step [Breakdown] dicts accumulated during time_breakdown, split by\n    # phase.  calc_times appends one entry per step here INSTEAD of logging to\n    # the console every step (which spammed one line per prefill/decode step);\n    # the offline benchmark driver (offline_offload_kvweight.py) clears both at\n    # each batch start and drains them once the batch finishes to emit a\n    # single averaged P-phase and D-phase breakdown line.  Shared class-level\n    # state because driver and worker run in the same process\n    # (VLLM_ENABLE_V1_MULTIPROCESSING=0).\n    prefill_breakdowns: list = []\n    decode_breakdowns: list = []\n\n    def __init__(\n        self,\n        torch_model: TorchModel,\n        batch_size: int,\n        max_num_batched_tokens: int = 2048,\n    ):\n        self.torch_model = torch_model\n        self.model = torch_model.model_root\n\n        # Make no-arg torch.cuda.current_stream() shallow process-wide — removes\n        # the deep per-step device-resolution churn from ~108 Event.record()\n        # sites + stream contexts on the decode path.\n        if os.getenv(\"TIERED_SERVE_PATCH_CURRENT_STREAM\", \"1\") == \"1\":\n            _patch_torch_current_stream()\n\n        self.phase = 0\n        self.batch_size = batch_size\n        self.max_num_batched_tokens = max_num_batched_tokens\n        self._use_fused_mm = os.getenv(\n            \"TIERED_SERVE_USE_FUSED_MM\", \"0\").lower() in (\"1\", \"true\", \"on\")\n\n        DualMemoryLoader.huge_page_allocator = allocator\n\n        # V1 piecewise CUDA graph wrapper needs a class-level reference\n        # to find us (it can't walk from PiecewiseBackend to model).\n        DualMemoryLoader._v1_dm_ref = self\n\n        self.torch_model.cache_loader = self\n        self.torch_model.model_root.cache_loader = self\n        for blk in self.torch_model.decoder_blocks:\n            blk.module.cache_loader = self\n            blk.module.self_attn.cache_loader = self\nimport os\n\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\n\n\ndef _should_zero_kv_on_alloc() -> bool:\n    value = os.getenv(\"TIERED_SERVE_ZERO_KV_ON_ALLOC\")\n    if value is not None:\n        return value == \"1\"\n    return getattr(DualMemoryLoader, \"use_kv_comp\", False)\n\n\ndef _contiguous_ranges(block_ids):\n    if not block_ids:\n        return []\n\n    sorted_block_ids = sorted(set(block_ids))\n    ranges = []\n    start = sorted_block_ids[0]\n    end = start + 1\n    for block_id in sorted_block_ids[1:]:\n        if block_id == end:\n            end += 1\n        else:\n            ranges.append((start, end))\n            start = block_id\n            end = block_id + 1\n    ranges.append((start, end))\n    return ranges\n\n\ndef _zero_allocated_offloadable_blocks(blocks):\n    if not _should_zero_kv_on_alloc():\n        return\n    if DualMemoryLoader.num_dedicated_blocks is None:\n        return\n\n    local_block_ids = []\n    for block in blocks:\n        if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n            local_block_ids.append(block.block_id -\n                                   DualMemoryLoader.num_dedicated_blocks)\n    if not local_block_ids:\n        return\n\n    seen_primary_ptrs = set()\n    for kv_cache in DualMemoryLoader.kv_caches:\n        primary_kv = kv_cache.primary_kv\n        if primary_kv is None:\n            continue\n        primary_ptr = primary_kv.data_ptr()\n        if primary_ptr in seen_primary_ptrs:\n            continue\n        seen_primary_ptrs.add(primary_ptr)\n        num_primary_blocks = primary_kv.shape[1]\n        valid_block_ids = [\n            block_id for block_id in local_block_ids\n            if block_id < num_primary_blocks\n        ]\n        for start, end in _contiguous_ranges(valid_block_ids):\n            primary_kv[:, start:end].zero_()\n\n\ndef on_blocks_allocated_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_allocated.\n    Note: unload_target tracking is handled by on_tail_block in core.py,\n    which covers both fresh blocks and existing tail blocks.\"\"\"\n    _zero_allocated_offloadable_blocks(blocks)\n\n\ndef on_blocks_freed_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_freed.\n    Handles KV compression cleanup for freed blocks.\"\"\"\n    if not DualMemoryLoader.use_kv_comp:\n        return\n    for block in blocks:\n        if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n            DualMemoryLoader.free_slot(\n                block.block_id - DualMemoryLoader.num_dedicated_blocks\n            )\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07fc5-c30a-7611-af7a-ae6f55b3e535","create_time":1788850166.3935945}},{"type":"message","id":"msg_01a07fc7-5a7c-7810-aca4-7ef598e9eb47","role":"user","content":[{"type":"input_text","text":"참고로 실험을 내가 돌릴거니까 너가 직접 실험 안 돌려봐도 돼. smoke도\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07fc5-c30a-7611-af7a-ae6f55b3e535","create_time":1788850166.3960562,"content_item_kinds":["user.text"]}},{"type":"reasoning","id":"rs_0e01288b77b6c77e016a9faffd2c7487d193d683be77364d19","summary":[],"content":null,"encrypted_content":"gAAAAABqn6_9wLSjoPA3Pa1YoThSiYc3Wt-9qa5WTYBE3EdRBpKEpALtyx_OqQit0UwRJgvh5cQ8E1BlSavma-W6a8B7fFxGgdC_y6A5BD9Pn2rxNUANYuJyd793AzyK6hFlnoDM-dZ36SbK7UCDDUUuKLnU-OgQIYGjcXMUDPZgbLm9oOr09P-7DsJn_3jOJkPM7FnUiI