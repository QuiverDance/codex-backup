def _rebuild_persistent_csr(self, layer_id: int, kv: str):\n        \"\"\"Compact append garbage off the request path in the CPU worker.\"\"\"\n        pool = self._host_pools[layer_id][kv]\n        rows = self._kv_active_count[layer_id]\n        slots = np.arange(rows, dtype=np.int64)\n        counts = pool[\"num_exceptions\"].numpy()[:rows]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        total_words = int(word_counts.sum())\n        max_words = ((self._max_n_blocks + 1) * self._packed_capacity)\n        gpu_words = ((self._max_gpu_decomp_blocks + 1)\n                     * self._packed_capacity)\n        if total_words > max_words:\n            raise RuntimeError(\n                \"ChunkDelta3 persistent CSR exceeds host slot capacity: \"\n                f\"layer={layer_id} side={kv} words={total_words} \"\n                f\"capacity={max_words}\")\n        previous = self._persistent_csr[layer_id][kv]\n        previous_capacity = (\n            previous.entries.numel() if previous is not None else 0)\n        capacity = max(\n            1024, total_words,\n            min(max_words, previous_capacity),\n        )\n        entries = torch.empty(capacity, dtype=torch.int64).pin_memory()\n        offsets = torch.zeros(\n            self._max_n_blocks + 1, dtype=torch.int64).pin_memory()\n        if rows:\n            _cd3_ext.pack_host_chunk_delta3_entries_csr(\n                pool[\"entries20x3\"], pool[\"num_exceptions\"],\n                torch.from_numpy(slots), entries[:total_words],\n                offsets[:rows])\n        state = _PersistentCSRState(\n            entries=entries,\n            offsets=offsets,\n            word_counts=np.zeros(\n                self._max_n_blocks + 1, dtype=np.int64),\n            used_words=total_words,\n            garbage_words=0,\n            max_words=max_words,\n            gpu_words=gpu_words,\n        )\n        state.word_counts[:rows] = word_counts\n        self._persistent_csr[layer_id][kv] = state\n        return state\n\n    def _append_persistent_csr(\n            self, layer_id: int, kv: str, slots: np.ndarray) -> None:\n        \"\"\"Publish freshly encoded slots into the persistent CSR arena.\"\"\"\n        slots = np.ascontiguousarray(slots, dtype=np.int64)\n        if slots.size == 0:\n            return\n        pool = self._host_pools[layer_id][kv]\n        counts = pool[\"num_exceptions\"].numpy()[slots]\n        stored_counts = np.minimum(counts, self._packed_capacity * 3)\n        new_word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        append_words = int(new_word_counts.sum())\n        state = self._persistent_csr[layer_id][kv]\n        if state is None:\n            state = self._new_persistent_csr(layer_id, kv)\n\n        old_words = int(state.word_counts[slots].sum())\n        required = int(state.used_words) + append_words\n        # Reuse/re-encode churn can leave unreachable append records.  Only\n        # compact in the worker when it avoids growth or is required to stay\n        # within the fixed GPU CSR staging capacity.\n        should_compact = required > state.max_words\n        should_compact |= (\n            required > state.gpu_words\n            and self._kv_active_count[layer_id]\n            <= self._max_gpu_decomp_blocks + 1)\n        should_compact |= (\n            required > state.entries.numel()\n            and state.garbage_words + old_words >= append_words)\n        if should_compact:\n            # Scratch rows already contain the just-encoded values, so one\n            # rebuild publishes both the old live set and this update.\n            self._rebuild_persistent_csr(layer_id, kv)\n            return\n\n        if required > state.entries.numel():\n            capacity = min(\n                state.max_words,\n                max(required, state.entries.numel() * 2),\n            )\n            entries = torch.empty(\n                capacity, dtype=torch.int64).pin_memory()\n            entries[:state.used_words].copy_(\n                state.entries[:state.used_words])\n            offsets = state.offsets.clone().pin_memory()\n            state.entries = entries\n            state.offsets = offsets\n\n        base = int(state.used_words)\n        relative_offsets = torch.empty(slots.size, dtype=torch.int64)\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\n            pool[\"entries20x3\"], pool[\"num_exceptions\"],\n            torch.from_numpy(slots),\n            state.entries[base:base + append_words],\n            relative_offsets)\n        state.offsets.numpy()[slots] = (\n            relative_offsets.numpy() + base)\n        state.word_counts[slots] = new_word_counts\n        state.used_words = required\n        state.garbage_words += old_words\n\n    def _discard_persistent_csr_slot(\n            self, layer_id: int, slot: int) -> None:\n        \"\"\"Make a freed scratch row compactable without touching H2D data.\"\"\"\n        for kv in (\"k\", \"v\"):\n            pool = self._host_pools[layer_id][kv]\n            pool[\"num_exceptions\"][slot] = 0\n            state = self._persistent_csr.get(layer_id, {}).get(kv)\n            if state is not None:\n                words = int(state.word_counts[slot])\n                state.garbage_words += words\n                state.word_counts[slot] = 0\n\n    def _acquire_csr_host_arena(\n            self, length: int) -> Tuple[torch.Tensor, torch.Tensor | None]:\n        \"\"\"Return an exact view backed by a retained pinned int64 arena.\"\"\"\n        if length == 0:\n            return torch.empty(0, dtype=torch.int64).pin_memory(), None\n        best_index = -1\n        best_size = None\n        for index, arena in enumerate(self._free_csr_host_arenas):\n            if arena.numel() >= length and (\n                    best_size is None or arena.numel() < best_size):\n                best_index = index\n                best_size = arena.numel()\n        if best_index >= 0:\n            arena = self._free_csr_host_arenas.pop(best_index)\n        else:\n            capacity = 1 << (length - 1).bit_length()\n            arena = torch.empty(\n                capacity, dtype=torch.int64).pin_memory()\n        return arena[:length], arena\n\n    def _release_csr_plan(self, plan: _DecodePlan | None) -> None:\n        if plan is None:\n            return\n        self._free_csr_host_arenas.extend(plan.host_owners)\n        plan.host_owners.clear()\n        # Drop aliases before an arena is filled for a new generation.\n        plan.host_offsets = ()\n        plan.host_entries = ()\n        plan.block_ids_cpu = None\n\n    def _reclaim_csr_plans(self) -> None:\n        pending = []\n        for plan in self._retired_csr_plans:\n            if plan.h2d_submitted and not plan.h2d_done.query():\n                pending.append(plan)\n            else:\n                self._release_csr_plan(plan)\n        self._retired_csr_plans = pending\n\n    def _retire_decode_plan(self, plan: _DecodePlan | None) -> None:\n        if plan is None:\n            return\n        if plan.h2d_submitted and not plan.h2d_done.query():\n            self._retired_csr_plans.append(plan)\n        else:\n            self._release_csr_plan(plan)\n\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\n        self._decode_generation[layer_id] = (\n            self._decode_generation.get(layer_id, 0) + 1)\n        self._decode_filtered.pop(layer_id, None)\n        self._retire_decode_plan(self._decode_plans.pop(layer_id, None))\n\n    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\n        \"\"\"Publish the canonical active set once for the upcoming forward.\n\n        ``torch_hooks.before_model_forward`` already materializes a sorted\n        int64 NumPy array and its corresponding Python list once per step.\n        Holding both references lets every layer replace an O(N) content\n        comparison with an identity + integer-version check.  Direct users\n        that do not call this method continue through the original defensive\n        filter/content-compare path.\n        \"\"\"\n        if active_array is None:\n            active_array = active_block_ids\n        candidates = np.asarray(active_array, dtype=np.int64)\n        if not candidates.flags.c_contiguous:\n            candidates = np.ascontiguousarray(candidates)\n        if (candidates.size > 1\n                and bool((candidates[1:] < candidates[:-1]).any())):\n            candidates = np.sort(candidates)\n\n        previous = self._prepared_active_candidates\n        if previous is None or not np.array_equal(previous, candidates):\n            self._prepared_active_version += 1\n        # Keep the current step's objects alive.  The loader replaces rather\n        # than mutates them on the next step, so no per-step copy is needed.\n        self._prepared_active_list = active_block_ids\n        self._prepared_active_candidates = candidates\n\n    def _get_kv_slot(self, layer_id: int, bid: int) -> int:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= bid < table.size:\n            return -1\n        return int(table[bid])\n\n    def _free_kv_slot(self, layer_id: int, block_id: int) -> None:\n        table = self._kv_slot_np.get(layer_id)\n        if table is None or not 0 <= block_id < table.size:\n            return\n        slot = int(table[block_id])\n        if slot < 0:\n            return\n        self._invalidate_decode_plan(layer_id)\n        table[block_id] = -1\n        self._kv_slot_block[layer_id][slot] = -1\n        self._release_physical_slot(layer_id, slot)\n\n    def _release_physical_slot(self, layer_id: int, slot: int) -> None:\n        self._discard_persistent_csr_slot(layer_id, slot)\n        free_set = self._kv_free_slots[layer_id]\n        hwm = self._kv_active_count[layer_id]\n        if slot == hwm - 1:\n            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode the active set published once at the forward boundary.\"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(active_block_ids) == 0:\n            return\n        if (active_block_ids is not self._prepared_active_list\n                or self._prepared_active_candidates is None):\n            raise RuntimeError(\n                \"ChunkDelta3 KV active set was not prepared before decode\")\n        candidates = self._prepared_active_candidates\n        limit = min(int(k_cache.shape[0]), len(valid))\n        if (candidates.size\n                and (int(candidates[0]) < 0\n                     or int(candidates[-1]) >= limit)):\n            raise RuntimeError(\"ChunkDelta3 KV active block is out of range\")\n        generation = self._decode_generation.get(layer_id, 0)\n        version = self._prepared_active_version\n        cached = self._decode_filtered.get(layer_id)\n        if (cached is not None\n                and cached[0] == generation\n                candidate = heapq.heappop(heap)\n                if candidate in free_set:\n                    free_set.discard(candidate)\n                    slot = candidate\n                    break\n            if slot < 0:\n                if high_water >= capacity:\n                    raise RuntimeError(\n                        \"ChunkDelta3 KV persistent slot pool full for \"\n                        f\"layer={layer_id}\")\n                slot = high_water\n                high_water += 1\n            new_slots.append(slot)\n\n        new_slots_array = np.asarray(new_slots, dtype=np.int64)\n        slot_table[bid_arr[new_mask]] = new_slots_array\n        result = previous.copy()\n        result[new_mask] = new_slots_array\n        for block_id, slot in zip(new_block_ids, new_slots):\n            slot_blocks[slot] = block_id\n        self._kv_active_count[layer_id] = high_water\n        self._invalidate_decode_plan(layer_id)\n        return np.ascontiguousarray(result, dtype=np.int64)\n\n    def _release_quarantined_slot(self, layer_id: int, slot: int) -> None:\n        self._invalidate_decode_plan(layer_id)\n        self._release_physical_slot(layer_id, slot)\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        with self._slot_state_lock:\n            valid = self._persistent_valid.get(layer_id)\n            if valid is not None and 0 <= block_id < len(valid):\n                valid[block_id] = 0\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get(\"buffer_ids\", ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64))\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_table = self._kv_slot_np.get(layer_id)\n                if slot_table is None or not 0 <= block_id < slot_table.size:\n                    return\n                slot = int(slot_table[block_id])\n                if slot < 0:\n                    return\n                self._invalidate_decode_plan(layer_id)\n                slot_table[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n            self._free_kv_slot(layer_id, block_id)\n\n    def compress_batch_async_from_host(\n        self,\n        layer_id: int,\n        block_ids: list,\n        host_k: torch.Tens