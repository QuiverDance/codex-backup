{"timestamp":"2026-09-08T07:38:40.131Z","ordinal":1226,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07ff4-6c83-75b3-9902-0be25a0b839a","call_id":"call_dlklCYcMwzd7aDBA3X2eGU80","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import os\nfrom time import perf_counter_ns\n\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\n\n\n_kv_free_profile_enabled = False\n_kv_free_profile_records = []\n\n\ndef reset_kv_free_profile(*, enabled: bool) -> None:\n    \"\"\"Reset request-free timing and enable it for one benchmark batch.\n\n    The offline benchmark runs EngineCore in-process, so the scheduler callback\n    and benchmark driver share this module state.  Keeping the profiler here\n    avoids adding diagnostic state to the serving/runtime data model.\n    \"\"\"\n    global _kv_free_profile_enabled\n    _kv_free_profile_enabled = bool(enabled)\n    _kv_free_profile_records.clear()\n\n\ndef kv_free_profile_checkpoint() -> int:\n    \"\"\"Return a cursor that can be used to read records from one engine step.\"\"\"\n    return len(_kv_free_profile_records)\n\n\ndef kv_free_profile_records_since(checkpoint: int):\n    \"\"\"Return immutable request-free records appended after *checkpoint*.\"\"\"\n    if checkpoint < 0 or checkpoint > len(_kv_free_profile_records):\n        raise ValueError(f\"invalid KV-free profile checkpoint: {checkpoint}\")\n    return tuple(_kv_free_profile_records[checkpoint:])\n\n\ndef _should_zero_kv_on_alloc() -> bool:\n    value = os.getenv(\"TIERED_SERVE_ZERO_KV_ON_ALLOC\")\n    if value is not None:\n        return value == \"1\"\n    return getattr(DualMemoryLoader, \"use_kv_comp\", False)\n\n\ndef _contiguous_ranges(block_ids):\n    if not block_ids:\n        return []\n\n    sorted_block_ids = sorted(set(block_ids))\n    ranges = []\n    start = sorted_block_ids[0]\n    end = start + 1\n    for block_id in sorted_block_ids[1:]:\n        if block_id == end:\n            end += 1\n        else:\n            ranges.append((start, end))\n            start = block_id\n            end = block_id + 1\n    ranges.append((start, end))\n    return ranges\n\n\ndef _zero_allocated_offloadable_blocks(blocks):\n    if not _should_zero_kv_on_alloc():\n        return\n    if DualMemoryLoader.num_dedicated_blocks is None:\n        return\n\n    local_block_ids = []\n    for block in blocks:\n        if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n            local_block_ids.append(block.block_id -\n                                   DualMemoryLoader.num_dedicated_blocks)\n    if not local_block_ids:\n        return\n\n    seen_primary_ptrs = set()\n    for kv_cache in DualMemoryLoader.kv_caches:\n        primary_kv = kv_cache.primary_kv\n        if primary_kv is None:\n            continue\n        primary_ptr = primary_kv.data_ptr()\n        if primary_ptr in seen_primary_ptrs:\n            continue\n        seen_primary_ptrs.add(primary_ptr)\n        num_primary_blocks = primary_kv.shape[1]\n        valid_block_ids = [\n            block_id for block_id in local_block_ids\n            if block_id < num_primary_blocks\n        ]\n        for start, end in _contiguous_ranges(valid_block_ids):\n            primary_kv[:, start:end].zero_()\n\n\ndef on_blocks_allocated_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_allocated.\n    Note: unload_target tracking is handled by on_tail_block in core.py,\n    which covers both fresh blocks and existing tail blocks.\"\"\"\n    _zero_allocated_offloadable_blocks(blocks)\n\n\ndef on_blocks_freed_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_freed.\n    Handles KV compression cleanup for freed blocks.\"\"\"\n    use_kv_comp = DualMemoryLoader.use_kv_comp\n\n    # Preserve the canonical path exactly when diagnostics are disabled: no\n    # clock reads, counters, allocations, or additional per-block branches.\n    if not _kv_free_profile_enabled:\n        if not use_kv_comp:\n            return\n        for block in blocks:\n            if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n                DualMemoryLoader.free_slot(\n                    block.block_id - DualMemoryLoader.num_dedicated_blocks\n                )\n        return\n\n    started_ns = perf_counter_ns()\n    offload_blocks = 0\n    final_ref_offload_blocks = 0\n    slot_manager_ns = 0\n    stream_sync_ns = 0\n    compressor_ns = 0\n\n    if use_kv_comp:\n        for block in blocks:\n            if block.block_id < DualMemoryLoader.num_dedicated_blocks:\n                continue\n            offload_blocks += 1\n            # BlockPool invokes this callback before decrementing ref_cnt.  Do\n            # not change the existing cleanup semantics during diagnosis; the\n            # count verifies the prefix-caching-off experiment assumption.\n            if block.ref_cnt <= 1:\n                final_ref_offload_blocks += 1\n            phase_ns = DualMemoryLoader.free_slot_profiled(\n                block.block_id - DualMemoryLoader.num_dedicated_blocks\n            )\n            slot_manager_ns += phase_ns[0]\n            stream_sync_ns += phase_ns[1]\n            compressor_ns += phase_ns[2]\n\n    elapsed_ns = perf_counter_ns() - started_ns\n    _kv_free_profile_records.append({\n        \"started_ns\": started_ns,\n        \"elapsed_ns\": elapsed_ns,\n        \"input_blocks\": len(blocks),\n        \"offload_blocks\": offload_blocks,\n        \"final_ref_offload_blocks\": final_ref_offload_blocks,\n        \"slot_manager_ns\": slot_manager_ns,\n        \"stream_sync_ns\": stream_sync_ns,\n        \"compressor_ns\": compressor_ns,\n        \"kv_comp_enabled\": bool(use_kv_comp),\n    })\n        attention writes them.\n        \"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and layer_id in self.kv_comp_targets\n            and self.kv_decode_load_backend == \"compressed\"\n            and (\n                not self.batch_has_prefill\n                or self.kv_comp_prefill_load\n            )\n        )\n\n    def _prefill_uses_dedicated_raw_kv_stream(self) -> bool:\n        \"\"\"Whether this prefill step has any raw-secondary KV layer.\"\"\"\n        return bool(\n            DualMemoryLoader.use_kv_comp\n            and self.batch_has_prefill\n            and (\n                not self.kv_comp_prefill_load\n                or self.kv_decode_load_backend != \"compressed\"\n                or len(self.kv_comp_targets) != self.n_layers\n            )\n        )\n\n    def _kv_load_stream_for(self, layer_id: int):\n        \"\"\"Return the stream that actually materializes this layer's KV.\n\n        KVCOMP decode may intentionally put compressed-blob H2D on the weight\n        stream. A prefill-bearing batch uses raw secondary KV by default and\n        carries a same-parity unload dependency; keep that dependency on the\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int):\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        # Clean up persistent compressed KV metadata\n        if (cls.use_kv_comp\n                and hasattr(cls, '_kv_compressor_ref')\n                and cls._kv_compressor_ref is not None):\n            kc = cls._kv_compressor_ref\n            # P4Flat and CD3 use free lists and never move or overwrite their\n            # host payload rows on free. Synchronizing all three streams for\n            # every released block only drains the serving pipeline. Legacy\n            # compacting codecs retain the safety barrier.\n            if not getattr(kc, '_kv_free_metadata_only', False):\n                for _s in (getattr(kc, 'batch_decomp_stream', None),\n                           getattr(kc, 'load_kv_stream', None),\n                           getattr(kc, 'comp_stream', None)):\n                    if _s is not None:\n                        _s.synchronize()\n            for layer_id in range(n_layers):\n                kc.free_persistent_block(layer_id, block_id)\n\n    @classmethod\n    def free_slot_profiled(cls, block_id: int):\n        \"\"\"Free one slot and return diagnostic CPU phase times in ns.\n\n        This intentionally duplicates ``free_slot`` so the canonical serving\n        path does not gain a per-block profiler branch or clock read.  Keep\n        every cleanup side effect in semantic lockstep with ``free_slot``;\n        CPU-only parity tests cover the supported state combinations.\n        \"\"\"\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return 0, 0, 0\n\n        slot_manager_started_ns = _time.perf_counter_ns()\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        slot_manager_ns = _time.perf_counter_ns() - slot_manager_started_ns\n\n        stream_sync_ns = 0\n        compressor_ns = 0\n        # Clean up persistent compressed KV metadata\n        if (cls.use_kv_comp\n                and hasattr(cls, '_kv_compressor_ref')\n                and cls._kv_compressor_ref is not None):\n            kc = cls._kv_compressor_ref\n            # P4Flat and CD3 use free lists and never move or overwrite their\n            # host payload rows on free. Synchronizing all three streams for\n            # every released block only drains the serving pipeline. Legacy\n            # compacting codecs retain the safety barrier.\n            if not getattr(kc, '_kv_free_metadata_only', False):\n                stream_sync_started_ns = _time.perf_counter_ns()\n                for _s in (getattr(kc, 'batch_decomp_stream', None),\n                           getattr(kc, 'load_kv_stream', None),\n                           getattr(kc, 'comp_stream', None)):\n                    if _s is not None:\n                        _s.synchronize()\n                stream_sync_ns = (\n                    _time.perf_counter_ns() - stream_sync_started_ns)\n            compressor_started_ns = _time.perf_counter_ns()\n            for layer_id in range(n_layers):\n                kc.free_persistent_block(layer_id, block_id)\n            compressor_ns = _time.perf_counter_ns() - compressor_started_ns\n\n        return slot_manager_ns, stream_sync_ns, compressor_ns\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07fec-b0fb-74c2-8cbb-d4de9eafe2eb","create_time":1788853120.1311905}}}
