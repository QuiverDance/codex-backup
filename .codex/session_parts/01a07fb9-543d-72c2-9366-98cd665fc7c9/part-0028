m tiered_serve.dual_memory_loader import DualMemoryLoader\n\n        if (\n            DualMemoryLoader.kv_full_block_only\n            and self.scheduler.kv_cache_manager.enable_caching\n        ):\n            raise RuntimeError(\n                \"Tiered-serve full-block KV compression requires prefix \"\n                \"caching to be disabled (--no-enable-prefix-caching)\")\n\n        num_ded = DualMemoryLoader.num_dedicated_blocks\n        if num_ded is None:\n            raise RuntimeError(\n                \"tiered-serve dedicated/offloadable KV boundary was not \"\n                \"published by the worker before scheduler initialization\")\n        if (DualMemoryLoader.kv_full_block_only\n                and DualMemoryLoader.tail_manager is None):\n            raise RuntimeError(\n                \"tiered-serve full-block KV mode was enabled but the fixed \"\n                \"resident-tail pool was not initialized\")\n\n        def _on_allocated(blocks):\n            on_blocks_allocated_v1(blocks)\n            for blk in blocks:\n                bid = blk.block_id\n                if bid < len(vLLMKVCache.free_block_ids):\n                    vLLMKVCache.free_block_ids[bid] = False\n                    vLLMKVCache.used_block_ids[bid] = True\n\n        def _on_freed(blocks):\n            final_blocks = final_reference_blocks(blocks)\n            for blk in final_blocks:\n                bid = blk.block_id\n                # The callback fires before ref_cnt is decremented. Cancel any\n                # tail state only when this is the final reference.\n                if bid >= num_ded:\n                    DualMemoryLoader.free_tail_block(bid)\n            on_blocks_freed_v1(blocks, final_blocks=final_blocks)\n            for blk in final_blocks:\n                bid = blk.block_id\n                # The callback fires before ref_cnt is decremented.\n                # Only mark free when ref_cnt will drop to 0.\n                if bid < len(vLLMKVCache.free_block_ids):\n                    vLLMKVCache.free_block_ids[bid] = True\n                    vLLMKVCache.used_block_ids[bid] = False\n\n        block_pool.on_blocks_allocated = _on_allocated\n        block_pool.on_blocks_freed = _on_freed\n\n        # tiered-serve: track tail blocks (dirty) for unload\n        kv_cache_manager = self.scheduler.kv_cache_manager\n\n        def _on_blocks_written(writes: list[KVBlockWrite]) -> None:\n            for write in writes:\n                bid = write.block_id\n                if bid >= num_ded:\n                    DualMemoryLoader.record_tail_write(write)\n                    if (\n                        not DualMemoryLoader.kv_full_block_only\n                        or write.post_valid == write.block_size\n                    ):\n                        DualMemoryLoader.append_unload_target(bid)\n\n        kv_cache_manager.on_blocks_written = _on_blocks_written\n\n        # Tell the free-block queue about the dedicated/offloadable boundary\n        # so that freed dedicated blocks are re-inserted at the front.\n        if vLLMKVCache.num_dedicated_blocks is not None:\n            block_pool.free_block_queue.num_dedicated_blocks = (\n                vLLMKVCache.num_dedicated_blocks)\n            logger.info(\n                \"tiered-serve: dedicated-first block allocation enabled \"\n                \"(D=%d)\", vLLMKVCache.num_dedicated_blocks)\n            # Build the offline random-allocation permutation now, outside the\n            # first request/TTFT path. This is a no-op unless explicitly\n            # enabled by vllm_offload_kvweight.py.\n            block_pool.initialize_random_alloc_order()\n\n        logger.info(\"tiered-serve: registered BlockPool callbacks \"\n                     \"for free_block_ids / used_block_ids tracking\")\n\n    def get_supported_tasks(self) -> tuple[SupportedTask, ...]:\n        return self.model_executor.supported_tasks\n\n    def add_request(self, request: Request, request_wave: int = 0):\n        \"\"\"Add request to the scheduler.\n\n        `request_wave`: indicate which wave of requests this is expected to\n        belong to in DP case\n        \"\"\"\n        # Validate the request_id type.\n        if not isinstance(request.request_id, str):\n            raise TypeError(\n                f\"request_id must be a string, got {type(request.request_id)}\"\n            )\n\n        if pooling_params := request.pooling_params:\n            supported_pooling_tasks = [\n                task for task in self.get_supported_tasks() if task in POOLING_TASKS\n            ]\n\n            if pooling_params.task not in supported_pooling_tasks:\n                raise ValueError(\nbash: line 1: rg: command not found\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a08005-5cb8-7452-9685-85aadc3750fb","create_time":1788855570.4842885}}}
