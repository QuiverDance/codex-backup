{"timestamp":"2026-09-08T08:21:00.943Z","ordinal":1990,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0801b-318f-7413-a140-2c149d258895","call_id":"call_iI4ORt2rH6Tcl3xNqu4yP2t4","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"CPU-only lifecycle tests for CD3 persistent-KV batch retirement.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport heapq\nfrom pathlib import Path\nfrom types import MethodType, SimpleNamespace\nimport threading\n\nimport numpy as np\nimport pytest\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nCD3_SOURCE = REPO_ROOT / \"tiered_serve\" / \"chunk_delta3_kv_compressor.py\"\n\n\nclass ArrayTensor:\n    def __init__(self, values):\n        self.values = np.asarray(values, dtype=np.int32)\n\n    def numpy(self):\n        return self.values\n\n\ndef _policy_class():\n    tree = ast.parse(CD3_SOURCE.read_text())\n    storage = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef)\n        and node.name == \"_ChunkDelta3KVStorage\"\n    )\n    compressor = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef)\n        and node.name == \"ChunkDelta3KVCompressor\"\n    )\n    method_names = {\n        \"_discard_persistent_csr_slots\",\n        \"_release_physical_slots\",\n        \"_prepare_layer_retirement\",\n        \"_apply_layer_retirement\",\n        \"_retire_decode_plan\",\n        \"_retire_layer_blocks\",\n        \"free_persistent_blocks\",\n        \"free_persistent_block\",\n        \"_release_deferred_slots\",\n        \"wait_compress_async\",\n    }\n    methods = [\n        node\n        for owner in (storage, compressor)\n        for node in owner.body\n        if isinstance(node, ast.FunctionDef) and node.name in method_names\n    ]\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=methods,\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {\"heapq\": heapq, \"np\": np}\n    exec(compile(module, str(CD3_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"]\n\n\ndef _state():\n    policy = _policy_class()()\n    policy._n_layers = 2\n    policy._slot_state_lock = threading.RLock()\n    policy._deferred_slot_frees = {}\n    policy._pending_compress = {}\n    policy._persistent_valid = {\n        0: bytearray([1, 1, 1, 1, 1, 0]),\n        1: bytearray([1, 1, 1, 0, 1, 0]),\n    }\n    policy._kv_slot_np = {\n        0: np.asarray([0, 1, 2, 3, 4, -1], dtype=np.int32),\n        1: np.asarray([0, 2, 4, -1, 5, -1], dtype=np.int32),\n    }\n    policy._kv_slot_block = {\n        0: [0, 1, 2, 3, 4, -1],\n        1: [0, -1, 1, -1, 2, 4],\n    }\n    policy._kv_active_count = {0: 5, 1: 6}\n    policy._kv_free_slots = {0: set(), 1: {1, 3}}\n    policy._kv_free_heap = {0: [], 1: [1, 3]}\n    policy._host_pools = {}\n    policy._persistent_csr = {}\n    for layer in range(2):\n        policy._host_pools[layer] = {}\n        policy._persistent_csr[layer] = {}\n        for side, bias in ((\"k\", 0), (\"v\", 10)):\n            policy._host_pools[layer][side] = {\n                \"num_exceptions\": ArrayTensor(\n                    np.arange(6, dtype=np.int32) + bias + 1)\n            }\n            policy._persistent_csr[layer][side] = SimpleNamespace(\n                word_counts=np.arange(6, dtype=np.int64) + bias + 1,\n                garbage_words=100 + bias,\n                used_words=999 + bias,\n                entries=object(),\n                offsets=object(),\n            )\n    policy.invalidated_layers = []\n\n    def invalidate(self, layer_id):\n        self.invalidated_layers.append(layer_id)\n\n    policy._invalidate_decode_plan = MethodType(invalidate, policy)\n    return policy\n\n\ndef test_batch_retirement_updates_each_layer_once_and_preserves_csr_payload():\n    policy = _state()\n    csr_payloads = {\n        (layer, side): (\n            policy._persistent_csr[layer][side].entries,\n            policy._persistent_csr[layer][side].offsets,\n            policy._persistent_csr[layer][side].used_words,\n        )\n        for layer in range(2)\n        for side in (\"k\", \"v\")\n    }\n\n    policy.free_persistent_blocks([1, 3, 4, 3])\n\n    assert policy.invalidated_layers == [0, 1]\n    assert list(policy._persistent_valid[0]) == [1, 0, 1, 0, 0, 0]\n    assert list(policy._persistent_valid[1]) == [1, 0, 1, 0, 0, 0]\n    assert policy._kv_slot_np[0].tolist() == [0, -1, 2, -1, -1, -1]\n    assert policy._kv_slot_np[1].tolist() == [0, -1, 4, -1, -1, -1]\n    assert policy._kv_slot_block[0] == [0, -1, 2, -1, -1, -1]\n    assert policy._kv_slot_block[1] == [0, -1, -1, -1, 2, -1]\n    assert policy._kv_active_count == {0: 3, 1: 5}\n    assert policy._kv_free_slots == {0: {1}, 1: {1, 2, 3}}\n    assert set(policy._kv_free_heap[0]) == {1}\n    assert set(policy._kv_free_heap[1]) == {1, 2, 3}\n\n    # Layer 0 retires slots 1, 3, 4. Layer 1 retires slots 2 and 5;\n    # logical block 3 had no physical slot there.\n    for side, bias in ((\"k\", 0), (\"v\", 10)):\n        state0 = policy._persistent_csr[0][side]\n        state1 = policy._persistent_csr[1][side]\n        assert state0.garbage_words == 100 + bias + sum(\n            bias + slot + 1 for slot in (1, 3, 4))\n        assert state1.garbage_words == 100 + bias + sum(\n            bias + slot + 1 for slot in (2, 5))\n        assert state0.word_counts[[1, 3, 4]].tolist() == [0, 0, 0]\n        assert state1.word_counts[[2, 5]].tolist() == [0, 0]\n        assert policy._host_pools[0][side][\n            \"num_exceptions\"].numpy()[[1, 3, 4]].tolist() == [0, 0, 0]\n        assert policy._host_pools[1][side][\n            \"num_exceptions\"].numpy()[[2, 5]].tolist() == [0, 0]\n        assert (\n            state0.entries,\n            state0.offsets,\n            state0.used_words,\n        ) == csr_payloads[(0, side)]\n        assert (\n            state1.entries,\n            state1.offsets,\n            state1.used_words,\n        ) == csr_payloads[(1, side)]\n\n\ndef test_empty_batch_is_an_idempotent_noop():\n    policy = _state()\n\n    policy.free_persistent_blocks([])\n\n    assert policy.invalidated_layers == []\n    assert policy._kv_slot_np[0].tolist() == [0, 1, 2, 3, 4, -1]\n\n\ndef test_batch_validation_finishes_before_any_layer_is_retired():\n    policy = _state()\n    policy._kv_slot_block[1][2] = 99\n\n    with pytest.raises(RuntimeError, match=\"forward/reverse slot mapping\"):\n        policy.free_persistent_blocks([1])\n\n    assert policy._persistent_valid[0][1]\n    assert policy._kv_slot_np[0][1] == 1\n    assert policy._kv_slot_block[0][1] == 1\n    assert policy._kv_free_slots[0] == set()\n\n\ndef test_layer_writer_defers_unrelated_physical_reclaim_until_success():\n    policy = _state()\n    pending = {\n        \"state\": {\"done\": SimpleNamespace(is_set=lambda: True)},\n        \"buffer_ids\": np.asarray([4], dtype=np.int64),\n        \"physical_slots\": np.asarray([4], dtype=np.int64),\n    }\n    policy._pending_compress[0] = pending\n    policy._entry_capacity = 1_000\n    policy._secondary_fallback_possible = {0: False, 1: False}\n    policy._compressed_kv = {}\n    policy._wait_worker_state = MethodType(\n        lambda self, state, timeout: None, policy)\n    before = {\n        side: (\n            int(policy._host_pools[0][side][\"num_exceptions\"].numpy()[1]),\n            int(policy._persistent_csr[0][side].word_counts[1]),\n            policy._persistent_csr[0][side].garbage_words,\n        )\n        for side in (\"k\", \"v\")\n    }\n\n    policy.free_persistent_blocks([1])\n\n    assert policy._kv_slot_np[0][1] == -1\n    assert not policy._persistent_valid[0][1]\n    assert policy._deferred_slot_frees == {0: {1}}\n    assert policy._kv_active_count[0] == 5\n    assert policy._kv_free_slots[0] == set()\n    for side in (\"k\", \"v\"):\n        assert (\n            int(policy._host_pools[0][side][\"num_exceptions\"].numpy()[1]),\n            int(policy._persistent_csr[0][side].word_counts[1]),\n            policy._persistent_csr[0][side].garbage_words,\n        ) == before[side]\n\n    policy.wait_compress_async(0, (16, 8, 128))\n\n    assert policy._persistent_valid[0][4]\n    assert not policy._persistent_valid[0][1]\n    assert 0 not in policy._pending_compress\n    assert 0 not in policy._deferred_slot_frees\n    assert policy._kv_free_slots[0] == {1}\n    assert policy._kv_active_count[0] == 5\n    assert policy.invalidated_layers == [0, 1, 0]\n    for side in (\"k\", \"v\"):\n        assert policy._host_pools[0][side][\n            \"num_exceptions\"].numpy()[1] == 0\n        assert policy._persistent_csr[0][side].word_counts[1] == 0\n        assert policy._persistent_csr[0][side].garbage_words == (\n            before[side][2] + before[side][1])\n\n\ndef _pending_writer_state(*, done):\n    policy = _state()\n    policy._persistent_valid[0][4] = 0\n    policy._pending_compress[0] = {\n        \"state\": {\"done\": SimpleNamespace(is_set=lambda: done)},\n        \"buffer_ids\": np.asarray([4], dtype=np.int64),\n        \"physical_slots\": np.asarray([4], dtype=np.int64),\n    }\n    policy._entry_capacity = 1_000\n    policy._secondary_fallback_possible = {0: False, 1: False}\n    policy._compressed_kv = {}\n    policy.free_persistent_blocks([1])\n    return policy\n\n\ndef test_terminal_worker_error_bulk_reclaims_deferred_slots_and_reraises():\n    policy = _pending_writer_state(done=True)\n\n    def fail(self, state, timeout):\n        raise RuntimeError(\"encode failed\")\n\n    policy._wait_worker_state = MethodType(fail, policy)\n    with pytest.raises(RuntimeError, match=\"encode failed\"):\n        policy.wait_compress_async(0, (16, 8, 128))\n\n    assert 0 not in policy._pending_compress\n    assert 0 not in policy._deferred_slot_frees\n    assert policy._kv_free_slots[0] == {1}\n    assert not policy._persistent_valid[0][4]\n\n\ndef test_worker_timeout_keeps_deferred_slots_quarantined():\n    policy = _pending_writer_state(done=False)\n    before = {\n        side: (\n            policy._persistent_csr[0][side].garbage_words,\n            int(policy._persistent_csr[0][side].word_counts[1]),\n        )\n        for side in (\"k\", \"v\")\n    }\n\n    def timeout(self, state, timeout_sec):\n        raise TimeoutError(\"still running\")\n\n    policy._wait_worker_state = MethodType(timeout, policy)\n    with pytest.raises(TimeoutError, match=\"still running\"):\n        policy.wait_compress_async(0, (16, 8, 128), timeout_sec=0.0)\n\n    assert 0 in policy._pending_compress\n    assert policy._deferred_slot_frees == {0: {1}}\n    assert policy._kv_free_slots[0] == set()\n    for side in (\"k\", \"v\"):\n        assert (\n            policy._persistent_csr[0][side].garbage_words,\n            int(policy._persistent_csr[0][side].word_counts[1]),\n        ) == before[side]\n\n\ndef test_decode_plan_is_retained_when_event_readiness_query_fails():\n    policy = _state()\n    policy._retired_csr_plans = []\n\n    def query():\n        raise RuntimeError(\"event query failed\")\n\n    plan = SimpleNamespace(\n        h2d_submitted=True,\n        h2d_done=SimpleNamespace(query=query),\n    )\n\n    with pytest.raises(RuntimeError, match=\"event query failed\"):\n        policy._retire_decode_plan(plan)\n\n    assert policy._retired_csr_plans == [plan]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a08005-5cb8-7452-9685-85aadc3750fb","create_time":1788855660.9431622}}}
