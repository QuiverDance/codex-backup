    decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {\"heapq\": heapq, \"np\": np}\n    exec(compile(module, str(CD3_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"]\n\n\ndef _state():\n    policy = _policy_class()()\n    policy._n_layers = 2\n    policy._slot_state_lock = threading.RLock()\n    policy._deferred_slot_frees = {}\n    policy._pending_compress = {}\n    policy._persistent_valid = {\n        0: bytearray([1, 1, 1, 1, 1, 0]),\n        1: bytearray([1, 1, 1, 0, 1, 0]),\n    }\n    policy._kv_slot_np = {\n        0: np.asarray([0, 1, 2, 3, 4, -1], dtype=np.int32),\n        1: np.asarray([0, 2, 4, -1, 5, -1], dtype=np.int32),\n    }\n    policy._kv_slot_block = {\n        0: [0, 1, 2, 3, 4, -1],\n        1: [0, -1, 1, -1, 2, 4],\n    }\n    policy._kv_active_count = {0: 5, 1: 6}\n    policy._kv_free_slots = {0: set(), 1: {1, 3}}\n    policy._kv_free_heap = {0: [], 1: [1, 3]}\n    policy._host_pools = {}\n    policy._persistent_csr = {}\n    for layer in range(2):\n        policy._host_pools[layer] = {}\n        policy._persistent_csr[layer] = {}\n        for side, bias in ((\"k\", 0), (\"v\", 10)):\n            policy._host_pools[layer][side] = {\n                \"num_exceptions\": ArrayTensor(\n                    np.arange(6, dtype=np.int32) + bias + 1)\n            }\n            policy._persistent_csr[layer][side] = SimpleNamespace(\n                word_counts=np.arange(6, dtype=np.int64) + bias + 1,\n                garbage_words=100 + bias,\n                used_words=999 + bias,\n                entries=object(),\n                offsets=object(),\n            )\n    policy.invalidated_layers = []\n\n    def invalidate(self, layer_id):\n        self.invalidated_layers.append(layer_id)\n\n    policy._invalidate_decode_plan = MethodType(invalidate, policy)\n    return policy\n\n\ndef test_batch_retirement_updates_each_layer_once_and_preserves_csr_payload():\n    policy = _state()\n    csr_payloads = {\n        (layer, side): (\n            policy._persistent_csr[layer][side].entries,\n            policy._persistent_csr[layer][side].offsets,\n            policy._persistent_csr[layer][side].used_words,\n        )\n        for layer in range(2)\n        for side in (\"k\", \"v\")\n    }\n\n    policy.free_persistent_blocks([1, 3, 4, 3])\n\n    assert policy.invalidated_layers == [0, 1]\n    assert list(policy._persistent_valid[0]) == [1, 0, 1, 0, 0, 0]\n    assert list(policy._persistent_valid[1]) == [1, 0, 1, 0, 0, 0]\n    assert policy._kv_slot_np[0].tolist() == [0, -1, 2, -1, -1, -1]\n    assert policy._kv_slot_np[1].tolist() == [0, -1, 4, -1, -1, -1]\n    assert policy._kv_slot_block[0] == [0, -1, 2, -1, -1, -1]\n    assert policy._kv_slot_block[1] == [0, -1, -1, -1, 2, -1]\n    assert policy._kv_active_count == {0: 3, 1: 5}\n    assert policy._kv_free_slots == {0: {1}, 1: {1, 2, 3}}\n    assert set(policy._kv_free_heap[0]) == {1}\n    assert set(policy._kv_free_heap[1]) == {1, 2, 3}\n\n    # Layer 0 retires slots 1, 3, 4. Layer 1 retires slots 2 and 5;\n    # logical block 3 had no physical slot there.\n    for side, bias in ((\"k\", 0), (\"v\", 10)):\n        state0 = policy._persistent_csr[0][side]\n        state1 = policy._persistent_csr[1][side]\n        assert state0.garbage_words == 100 + bias + sum(\n            bias + slot + 1 for slot in (1, 3, 4))\n        assert state1.garbage_words == 100 + bias + sum(\n            bias + slot + 1 for slot in (2, 5))\n        assert state0.word_counts[[1, 3, 4]].tolist() == [0, 0, 0]\n        assert state1.word_counts[[2, 5]].tolist() == [0, 0]\n        assert policy._host_pools[0][side][\n            \"num_exceptions\"].numpy()[[1, 3, 4]].tolist() == [0, 0, 0]\n        assert policy._host_pools[1][side][\n            \"num_exceptions\"].numpy()[[2, 5]].tolist() == [0, 0]\n        assert (\n            state0.entries,\n            state0.offsets,\n            state0.used_words,\n        ) == csr_payloads[(0, side)]\n        assert (\n            state1.entries,\n            state1.offsets,\n            state1.used_words,\n        ) == csr_payloads[(1, side)]\n\n\ndef test_empty_batch_is_an_idempotent_noop():\n    policy = _state()\n\n    policy.free_persistent_blocks([])\n\n    assert policy.invalidated_layers == []\n    assert policy._kv_slot_np[0].tolist() == [0, 1, 2, 3, 4, -1]\n\n\ndef test_batch_validation_finishes_before_any_layer_is_retired():\n    policy = _state()\n    policy._kv_slot_block[1][2] = 99\n\n    with pytest.raises(RuntimeError, match=\"forward/reverse slot mapping\"):\n        policy.free_persistent_blocks([1])\n\n    assert policy._persistent_valid[0][1]\n    assert policy._kv_slot_np[0][1] == 1\n    assert policy._kv_slot_block[0][1] == 1\n    assert policy._kv_free_slots[0] == set()\n\n\ndef test_layer_writer_defers_unrelated_physical_reclaim_until_success():\n    policy = _state()\n    pending = {\n        \"state\": {\"done\": SimpleNamespace(is_set=lambda: True)},\n        \"buffer_ids\": np.asarray([4], dtype=np.int64),\n        \"physical_slots\": np.asarray([4], dtype=np.int64),\n    }\n    policy._pending_compress[0] = pending\n    policy._entry_capacity = 1_000\n    policy._secondary_fallback_possible = {0: False, 1: False}\n    policy._compressed_kv = {}\n    policy._wait_worker_state = MethodType(\n        lambda self, state, timeout: None, policy)\n    before = {\n        side: (\n            int(policy._host_pools[0][side][\"num_exceptions\"].numpy()[1]),\n            int(policy._persistent_csr[0][side].word_counts[1]),\n            policy._persistent_csr[0][side].garbage_words,\n        )\n        for side in (\"k\", \"v\")\n    }\n\n    policy.free_persistent_blocks([1])\n\n    assert policy._kv_slot_np[0][1] == -1\n    assert not policy._persistent_valid[0][1]\n    assert policy._deferred_slot_frees == {0: {1}}\n    assert policy._kv_active_count[0] == 5\n    assert policy._kv_free_slots[0] =