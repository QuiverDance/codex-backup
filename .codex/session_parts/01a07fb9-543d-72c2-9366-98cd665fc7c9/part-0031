put tokens per request (default: 1020)\n  --gen N                 Tokens generated per request (default: 129)\n  --warmup N              Initial per-request token intervals excluded (default: 16)\n  --prefill-chunk N       Chunked-prefill token budget (default: 8192)\n  --kv-backend NAME       KV codec for configurable kvcomp cells (default: p4flat)\n  --breakdown             Enable diagnostic per-forward timing and aggregated\n                          GPU breakdown CSVs plus per-engine-step KV-free\n                          timing CSVs (instrumented; not canonical perf)\n  --gpu-index N           Physical GPU used and checked (default: 0)\n  --numa-node N           NUMA memory node (default: 0)\n  --weight-huge-pages N   16 GiB pages assigned to weights (default: 14)\n  --max-idle-hbm-mib N    Maximum clean-state HBM use (default: 1024)\n  --cleanup-timeout SEC   Wait for clean state between runs (default: 120)\n  --output-root DIR       Suite logs/manifests directory\n  --start-from METHOD     Start at METHOD and run the remaining methods\n  --check-only            Run resource/config preflight and exit\n  --dry-run               Validate mappings and print commands only\n  -h, --help              Show this help\n\nExamples:\n  bash scripts/offline/run_performance_suite.sh\n  bash scripts/offline/run_performance_suite.sh --methods cao-cd3-fused,cao-p4flat-fused\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --batches 16,64,128\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --start-from flexgen-zipserv\n  bash scripts/offline/run_performance_suite.sh --repeats 1 --dry-run\nEOF\n}\n\ndie() {\n  echo \"[suite] ERROR: $*\" >&2\n  exit 1\n}\n\nrequire_uint() {\n  local option=\"$1\"\n  local value=\"$2\"\n  [[ \"$value\" =~ ^[0-9]+$ ]] || die \"${option} requires a non-negative integer: ${value}\"\n}\n\nwhile (($#)); do\n  case \"$1\" in\n    --methods)\n      (($# >= 2)) || die \"--methods requires a value\"\n      method_spec=\"${2//,/ }