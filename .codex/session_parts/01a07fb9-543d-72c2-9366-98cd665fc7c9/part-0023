      self.invalidated_layers.append(layer_id)\\n+\\n+    policy._invalidate_decode_plan = MethodType(invalidate, policy)\\n+    return policy\\n+\\n+\\n+def test_batch_retirement_updates_each_layer_once_and_preserves_csr_payload():\\n+    policy = _state()\\n+    csr_payloads = {\\n+        (layer, side): (\\n+            policy._persistent_csr[layer][side].entries,\\n+            policy._persistent_csr[layer][side].offsets,\\n+            policy._persistent_csr[layer][side].used_words,\\n+        )\\n+        for layer in range(2)\\n+        for side in (\\\"k\\\", \\\"v\\\")\\n+    }\\n+\\n+    policy.free_persistent_blocks([1, 3, 4, 3])\\n+\\n+    assert policy.invalidated_layers == [0, 1]\\n+    assert list(policy._persistent_valid[0]) == [1, 0, 1, 0, 0, 0]\\n+    assert list(policy._persistent_valid[1]) == [1, 0, 1, 0, 0, 0]\\n+    assert policy._kv_slot_np[0].tolist() == [0, -1, 2, -1, -1, -1]\\n+    assert policy._kv_slot_np[1].tolist() == [0, -1, 4, -1, -1, -1]\\n+    assert policy._kv_slot_block[0] == [0, -1, 2, -1, -1, -1]\\n+    assert policy._kv_slot_block[1] == [0, -1, -1, -1, 2, -1]\\n+    assert policy._kv_active_count == {0: 3, 1: 5}\\n+    assert policy._kv_free_slots == {0: {1}, 1: {1, 2, 3}}\\n+    assert set(policy._kv_free_heap[0]) == {1}\\n+    assert set(policy._kv_free_heap[1]) == {1, 2, 3}\\n+\\n+    # Layer 0 retires slots 1, 3, 4. Layer 1 retires slots 2 and 5;\\n+    # logical block 3 had no physical slot there.\\n+    for side, bias in ((\\\"k\\\", 0), (\\\"v\\\", 10)):\\n+        state0 = policy._persistent_csr[0][side]\\n+        state1 = policy._persistent_csr[1][side]\\n+        assert state0.garbage_words == 100 + bias + sum(\\n+            bias + slot + 1 for slot in (1, 3, 4))\\n+        assert state1.garbage_words == 100 + bias + sum(\\n+            bias + slot + 1 for slot in (2, 5))\\n+        assert state0.word_counts[[1, 3, 4]].tolist() == [0, 0, 0]\\n+        assert state1.word_counts[[2, 5]].tolist() == [0, 0]\\n+        a