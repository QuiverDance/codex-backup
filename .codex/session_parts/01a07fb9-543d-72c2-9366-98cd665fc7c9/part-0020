{"timestamp":"2026-09-08T07:50:11.207Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07ffe-f807-7c43-9897-49bfc62ec746","call_id":"call_1EUmtiJLnSWEJCs5652IshHM","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"            hwm -= 1\n            while hwm - 1 in free_set:\n                free_set.discard(hwm - 1)\n                hwm -= 1\n            self._kv_active_count[layer_id] = hwm\n        else:\n            free_set.add(slot)\n            heapq.heappush(self._kv_free_heap[layer_id], slot)\n\n    def decompress_batch(self, layer_id: int, active_block_ids: list,\n                         output_buffers) -> None:\n        \"\"\"Decode the active set published once at the forward boundary.\"\"\"\n        k_cache, v_cache = output_buffers\n        valid = self._persistent_valid.get(layer_id)\n        if valid is None or len(active_block_ids) == 0:\n            return\n        if (active_block_ids is not self._prepared_active_list\n                or self._prepared_active_candidates is None):\n            raise RuntimeError(\n                \"ChunkDelta3 KV active set was not prepared before decode\")\n        candidates = self._prepared_active_candidates\n        limit = min(int(k_cache.shape[0]), len(valid))\n        if (candidates.size\n                and (int(candidates[0]) < 0\n                     or int(candidates[-1]) >= limit)):\n            raise RuntimeError(\"ChunkDelta3 KV active block is out of range\")\n        generation = self._decode_generation.get(layer_id, 0)\n        version = self._prepared_active_version\n        cached = self._decode_filtered.get(layer_id)\n        if (cached is not None\n                and cached[0] == generation\n                and cached[3] == version):\n            filtered = cached[2]\n        else:\n            valid_array = np.frombuffer(valid, dtype=np.uint8)\n            filtered = np.ascontiguousarray(\n                candidates[valid_array[candidates] != 0], dtype=np.int64)\n            self._decode_filtered[layer_id] = (\n                generation, candidates, filtered, version)\n        if filtered.size == 0:\n            return\n\n        filtered = self._restore_secondary_fallbacks(\n            layer_id, filtered, k_cache, v_cache)\n        if filtered.size == 0:\n            return\n\n        capacity = self._max_gpu_decomp_blocks\n        if filtered.size <= capacity:\n            self._decompress_blocks(layer_id, filtered, k_cache, v_cache)\n            return\n        for start in range(0, filtered.size, capacity):\n            self._decompress_blocks(\n                layer_id, filtered[start:start + capacity],\n                k_cache, v_cache)\n\n    def _restore_secondary_fallbacks(\n            self, layer_id: int, candidates: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> np.ndarray:\n        \"\"\"Restore exception-overflow rows from authoritative raw KV.\n\n        The host encoder retains the true exception count while safely\n        truncating Packed20 writes at the fixed row capacity.  If either side\n        of a K/V pair overflowed, restore both sides from ``secondary_kv`` and\n        remove that block from the CD3 launch.  Normal rows pay no per-step\n        metadata scan until a layer has observed an overflow.\n        \"\"\"\n        if (not self._secondary_fallback_possible.get(layer_id, False)\n                or candidates.size == 0):\n            return candidates\n\n        slots = self._kv_slot_np[layer_id][candidates]\n        slot_ok = slots >= 0\n        if not bool(slot_ok.any()):\n            return candidates\n        probe_positions = np.flatnonzero(slot_ok)\n        probe_slots = slots[slot_ok]\n        pools = self._host_pools[layer_id]\n        overflow = (\n            pools[\"k\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        overflow |= (\n            pools[\"v\"][\"num_exceptions\"].numpy()[probe_slots]\n            > self._entry_capacity)\n        if not bool(overflow.any()):\n            return candidates\n\n        fallback_positions = probe_positions[overflow]\n        fallback_ids = np.ascontiguousarray(\n            candidates[fallback_positions], dtype=np.int64)\n        self._decode_raw_from_secondary(\n            layer_id, fallback_ids, k_cache, v_cache)\n        keep = np.ones(candidates.size, dtype=np.bool_)\n        keep[fallback_positions] = False\n        return np.ascontiguousarray(candidates[keep])\n\n    def _decode_raw_from_secondary(\n            self, layer_id: int, block_ids: np.ndarray,\n            k_cache: torch.Tensor, v_cache: torch.Tensor) -> None:\n        from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n        if layer_id >= len(DualMemoryLoader.kv_caches):\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no DualMemoryLoader cache\")\n        secondary = getattr(\n            DualMemoryLoader.kv_caches[layer_id], \"secondary_kv\", None)\n        if secondary is None:\n            raise RuntimeError(\n                \"ChunkDelta3 KV overflow fallback requires raw secondary KV, \"\n                f\"but layer {layer_id} has no secondary_kv\")\n\n        host_ids = torch.from_numpy(block_ids)\n        with torch.cuda.stream(self.batch_decomp_stream):\n            device_ids = host_ids.to(k_cache.device, non_blocking=True)\n            k_cache.index_copy_(\n                0, device_ids,\n                secondary[0][host_ids].to(\n                    k_cache.device, non_blocking=True))\n            v_cache.index_copy_(\n                0, device_ids,\n                secondary[1][host_ids].to(\n                    v_cache.device, non_blocking=True))\n\n    def _pack_csr_entries(\n            self, pool: Dict[str, torch.Tensor],\n            storage_slots: np.ndarray\n            ) -> Tuple[torch.Tensor, torch.Tensor, list[torch.Tensor]]:\n        \"\"\"Compact exact per-slot Packed20 words into one pinned CSR arena.\"\"\"\n        storage_slots = np.ascontiguousarray(storage_slots, dtype=np.int64)\n        counts = pool[\"num_exceptions\"].numpy()[storage_slots]\n        # Rows restored from raw secondary may still be present in a full-HWM\n        # staging range.  They are never decoded, so safely clamp their\n        # truncated scratch row while retaining offsets for every body row.\n        stored_counts = np.minimum(counts, self._entry_capacity)\n        word_counts = (stored_counts.astype(np.int64) + 2) // 3\n        total_words = int(word_counts.sum())\n        packed, packed_owner = self._acquire_csr_host_arena(total_words)\n        offsets, offsets_owner = self._acquire_csr_host_arena(\n            storage_slots.size)\n        _cd3_ext.pack_host_chunk_delta3_entries_csr(\n            pool[\"entries20x3\"], pool[\"num_exceptions\"],\n            torch.from_numpy(storage_slots), packed, offsets)\n        return packed, offsets, [packed_owner, offsets_owner]\n\n    def _build_decode_plan(\n            self, layer_id: int,\n            block_ids: np.ndarray) -> _DecodePlan:\n        self._reclaim_csr_plans()\n        n = len(block_ids)\n        hwm = self._kv_active_count[layer_id]\n        states = self._persistent_csr[layer_id]\n        if states[\"k\"] is None or states[\"v\"] is None:\n            raise RuntimeError(\n                f\"ChunkDelta3 persistent CSR is missing for layer={layer_id}\")\n\n        slots = np.ascontiguousarray(\n            self._kv_slot_np[layer_id][block_ids], dtype=np.int32)\n        if bool((slots < 0).any()):\n            missing = int(block_ids[np.flatnonzero(slots < 0)[0]])\n            raise RuntimeError(\n                f\"ChunkDelta3 KV has no slot for layer={layer_id} \"\n                f\"block={missing}\")\n\n        block_ids_tensor = torch.from_numpy(\n          