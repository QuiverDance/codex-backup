             valid[block_id] = 0\n\n            pending = self._pending_compress.get(layer_id)\n            pending_ids = (\n                np.asarray(pending.get('buffer_ids', ()), dtype=np.int64)\n                if pending is not None else np.empty(0, dtype=np.int64)\n            )\n            if pending_ids.size and bool((pending_ids == block_id).any()):\n                slot_np = self._kv_slot_np.get(layer_id)\n                if slot_np is None or not 0 <= block_id < slot_np.size:\n                    return\n                slot = int(slot_np[block_id])\n                if slot < 0:\n                    return\n                slot_np[block_id] = -1\n                self._kv_slot_block[layer_id][slot] = -1\n                self._deferred_slot_frees.setdefault(\n                    layer_id, set()).add(slot)\n                return\n\n            self._free_kv_slot(layer_id, block_id)\n\n    def stop_kv_compress_workers(self) -> None:\n        workers = list(getattr(self, \"_workers\", ()))\n        for _ in workers:\n            self._work_q.put(None)\n        for t in workers:\n    def _copy_zip_meta_to_physical(self, layer_id: int, block_id: int) -> None:\n        dst_off = self._assign_zip_meta_slot(layer_id, block_id)\n        src_off = int(block_id) * int(self._meta_total_bytes)\n        nbytes = int(self._meta_total_bytes)\n        if nbytes <= 0:\n            return\n        for kv_idx in (0, 1):\n            host_pool = self._kv_host_pools[layer_id][kv_idx]\n            src = host_pool[\"__meta_backing\"]\n            dst = host_pool[\"__meta_phys_backing\"]\n            dst.narrow(0, dst_off, nbytes).copy_(\n                src.narrow(0, src_off, nbytes))\n\n    def _free_zip_meta_slot(self, layer_id: int, block_id: int) -> None:\n        pos = self._zip_meta_active_pos.get(layer_id)\n        active = self._zip_meta_active_blocks.get(layer_id)\n        if pos is None or active is None:\n            return\n        idx = pos.pop(block_id, None)\n        if idx is None:\n            return\n        tail_bid = active[-1]\n        tail_idx = len(active) - 1\n        meta_bytes = int(self._meta_total_bytes)\n        if idx != tail_idx:\n            dst_off = idx * meta_bytes\n            src_off = tail_idx * meta_bytes\n            for kv_idx in (0, 1):\n                host_pool = self._kv_host_pools[layer_id][kv_idx]\n                self._copy_zipserv_range(\n                    host_pool[\"__meta_phys_backing\"], dst_off, src_off,\n                    meta_bytes)\n            active[idx] = tail_bid\n            pos[tail_bid] = idx\n            self._block_meta_offsets[layer_id][tail_bid] = dst_off\n        active.pop()\n        self._block_meta_offsets[layer_id][block_id] = -1\n\n    def free_persistent_block(self, layer_id: int, block_id: int) -> None:\n        \"\"\"Remove persistent compressed metadata for a freed block.\n        Also returns the block's sm/cf/raw reservations to the append\n        pool so the cursor can recycle them, preventing pool exhaustion\n        and keeping coalescing tight.\"\"\"\n        valid = self._persistent_valid.get(layer_id)\n        if (valid is None\n                or not 0 <= block_id < int(self._kv_max_n_blocks)):\n            raise IndexError(\n                f\"ZipServ block id out of range: layer={layer_id}, \"\n                f\"block={block_id}, capacity={self._kv_max_n_blocks}\")\n        valid[block_id] = 0\n\n        # Workers may be writing this block or may leave temporary slub holes.\n        # Hide it from new readers now, but defer compaction/recycling until the\n        # normal per-layer publication barrier instead of stalling every free.\n        if layer_id in self._pending_compress:\n            self._pending_kv_evictions.setdefault(layer_id, set()).add(\n                int(block_id))\n            return\n        if (self._append_pool is not None\n                and layer_id in self._block_sm_offsets):\n            mgr = self._kv_compress_mgr\n  