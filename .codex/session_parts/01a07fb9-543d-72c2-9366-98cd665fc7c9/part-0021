= torch.arange(65536, dtype=torch.int32).to(torch.int16)\n    # Transpose so each 16-value CD3 chunk spans many exponents.  A plain\n    # reshape groups equal exponents and never exercises the exception stream.\n    return (bits.view(torch.bfloat16).reshape(256, 256).t().contiguous()\n            .cuda())\n\n\ndef _assert_bit_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:\n    assert actual.shape == expected.shape\n    assert torch.equal(actual.view(torch.uint16), expected.view(torch.uint16))\n\n\ndef test_serving_fused_threshold_override(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n\n\ndef test_projection_fused_threshold_override_takes_precedence(monkeypatch) -> None:\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N\", \"128\")\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_FUSED_MAX_N_QKV\", \"64\")\n    codec = _codec()\n    assert codec._fused_max_n_for(10240, 8192) == 64\n    assert codec._fused_max_n_for(8192, 8192) == 128\n    assert codec._fused_max_n_for(57344, 8192) == 128\n    assert codec._fused_max_n_for(8192, 28672) == 128\n\n\ndef test_split_shell_narrows_shared_staging_capacity() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(29)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    lpddr = {\n        attr: getattr(compressed, attr)\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS\n    }\n    info = SplitStorageInfo(\n        compressed.sign_mantissa,\n        lpddr,\n        {\n            \"M\": compressed.M,\n            \"K\": compressed.K,\n            \"num_exceptions\": compressed.num_exceptions,\n        },\n        backend=\"chunk_delta3\",\n        hbm_buffers={\n            \"tile_exception_offsets\": compressed.tile_exception_offsets,\n        },\n    )\n    staging = {}\n    for attr, source in lpddr.items():\n        capacity = source.numel() + 17\n        staging[attr] = torch.empty(\n            capacity, dtype=source.dtype, device=source.device)\n        staging[attr][:source.numel()].copy_(source.reshape(-1))\n\n    shell = codec.build_split_shell(info, staging)\n    for attr, source in lpddr.items():\n        assert getattr(shell._c, attr).numel() == source.numel()\n    restored = codec.decompress(shell)\n    torch.cuda.synchronize()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_all_bf16_patterns_roundtrip_bit_exact() -> None:\n    codec = _codec()\n    weight = _all_bf16_patterns()\n    compressed = codec.compress(weight)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert compressed.total_compressed_size == compressed.nbytes\n    assert compressed.original_size == weight.nbytes\n    assert compressed.num_exceptions > 0\n    assert all(getattr(compressed, attr).device.type == \"cuda\"\n               for attr in compressed._BUFFER_ATTRS)\n    _assert_bit_exact(restored, weight)\n\n\ndef test_gpu_weight_encode_matches_cpu_fallback(monkeypatch) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(31415)\n    weight = torch.randn(\n        128, 256, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n\n    gpu_compressed = codec.compress(weight)\n    monkeypatch.setenv(\"TIERED_SERVE_CD3_WEIGHT_ENCODE\", \"cpu\")\n    cpu_compressed = codec.compress(weight)\n    gpu_restored = codec.decompress(gpu_compressed)\n    cpu_restored = codec.decompress(cpu_compressed)\n    torch.cuda.synchronize()\n\n    assert gpu_compressed.num_exceptions == cpu_compressed.num_exceptions\n    assert gpu_compressed.nbytes == cpu_compressed.nbytes\n    _assert_bit_exact(gpu_restored, weight)\n    _assert_bit_exact(cpu_restored, weight)\n\n\ndef test_frozen_split_keeps_offsets_with_sign_mantissa_in_hbm() -> None:\n    from tiered_serve.compression.core.base import SplitStorageInfo\n\n    codec = _codec()\n    weight = torch.randn(\n        128, 128, dtype=torch.bfloat16, device=\"cuda\")\n    compressed = codec.compress(weight)\n    assert compressed.entries20x3.dtype == torch.int64\n    assert not hasattr(compressed, \"warp_prefixes\")\n    assert not hasattr(compressed, \"entries17\")\n    assert SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS == (\n        \"codes\", \"thread_bases\", \"entries20x3\")\n    assert SplitStorageInfo._BACKEND_TO_HBM_ATTRS.get(\n        \"chunk_delta3\", ()) == (\"tile_exception_offsets\",)\n    assert compressed.frozen_hbm_bytes == (\n        compressed.sign_mantissa.nbytes\n        + compressed.tile_exception_offsets.nbytes)\n    assert compressed.frozen_transfer_bytes == sum(\n        getattr(compressed, attr).nbytes\n        for attr in SplitStorageInfo._CHUNK_DELTA3_LPDDR_ATTRS)\n\n\n@pytest.mark.parametrize(\"use_gpu_pool\", [False, True])\ndef test_host_staging_roundtrip_bit_exact(use_gpu_pool: bool) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(17)\n    weight = torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    compressed_bytes = compressed.nbytes\n    compressed.to_host()\n    assert compressed.nbytes == compressed_bytes\n    assert all(getattr(compressed, attr).device.type == \"cpu\"\n               for attr in compressed._BUFFER_ATTRS)\n\n    output = torch.empty_like(weight)\n    gpu_pool = None\n    if use_gpu_pool:\n        gpu_pool = {\n            attr: torch.empty_like(getattr(compressed, attr), device=\"cuda\")\n            for attr in compressed._BUFFER_ATTRS\n        }\n    compressed.register_temp_d_tensor(output, gpu_pool)\n    compressed.to(\"cuda\", non_blocking=True)\n    restored = codec.decompress(compressed)\n    torch.cuda.synchronize()\n    assert restored.data_ptr() == output.data_ptr()\n    _assert_bit_exact(restored, weight)\n\n\ndef test_cpu_weight_encode_stages_and_roundtrips_bit_exact() -> None:\n    codec = _codec()\n    generator = torch.Generator().manual_seed(911)\n    source = torch.randn(\n        256, 256, generator=generator, dtype=torch.float32\n    ).to(torch.bfloat16).contiguous()\n\n    compressed = codec.compress(source)\n    assert compressed.sign_mantissa.device.type == \"cpu\"\n    output = torch.empty(source.shape, dtype=source.dtype, device=\"cuda\")\n    compressed.register_temp_d_tensor(output)\n    compressed.to(non_blocking=False)\n    restored = codec.decompress(compressed, output)\n    torch.cuda.synchronize()\n\n    _assert_bit_exact(restored.cpu(), source)\n\n\ndef test_rejects_non_tile_aligned_shape() -> None:\n    codec = _codec()\n    weight = torch.zeros((64, 65), dtype=torch.bfloat16, device=\"cuda\")\n    with pytest.raises(ValueError, match=\"divisible by 64\"):\n        codec.compress(weight)\n\n\n@pytest.mark.parametrize(\"split_h2d\", [False, True])\ndef test_cpu_kv_backend_async_roundtrip_and_pending_free(\n        split_h2d: bool) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        if split_h2d:\n            compressor.load_kv_stream = torch.cuda.Stream()\n            compressor._kv_split_min_bytes = 0\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        # Freeing an ID after enqueue must quarantine its captured slot; the\n        # retiring worker may finish writing it but must not republish it.\n        compressor.free_persistent_block(0, 1)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        prepared = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared, torch.tensor(prepared).numpy())\n        initial_active_version = compressor._prepared_active_version\n        compressor.decompress_batch(\n            0, prepared, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        plan = compressor._decode_plans[0]\n        assert plan.storage_rows == 2\n        assert not plan.offsets_are_compact\n        # One retained pinned owner stages the output block ids. Exception\n        # entries themselves still reference persistent CSR directly.\n        assert len(plan.host_owners) == 1\n        assert plan.host_owners[0].tolist() == [3, 6]\n        source_ptrs = {source.data_ptr() for source in plan.host_entries}\n        assert compressor._persistent_csr[0][\"k\"].entries.data_ptr() \\\n            in source_ptrs\n        assert compressor._persistent_csr[0][\"v\"].entries.data_ptr() \\\n            in source_ptrs\n        assert plan.staged_bytes < 3 * compressor._body_stride * 2\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # A newly materialized list with identical content keeps the version;\n        # the held identity still proves that per-layer fast-path calls belong\n        # to the currently prepared step.\n        prepared_same = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared_same, torch.tensor(prepared_same).numpy())\n        assert compressor._prepared_active_version == initial_active_version\n        assert compressor._prepared_active_list is prepared_same\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        active = [2, 3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        assert compressor._prepared_active_version == initial_active_version + 2\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        compressor.free_persistent_block(0, 6)\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        _assert_bit_exact(k_cache[2].cpu(), host_k[2])\n        _assert_bit_exact(v_cache[2].cpu(), host_v[2])\n        assert torch.count_nonzero(k_cache[6]).item() == 0\n        assert torch.count_nonzero(v_cache[6]).item() == 0\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\ndef test_cpu_kv_compact_row_matches_planner(monkeypatch) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n    from tiered_serve.kv_codec_spec import compressed_block_bytes\n    from tiered_serve.kv_codec_spec import (\n        chunk_delta3_body_stride,\n        chunk_delta3_exception_capacity,\n    )\n\n    monkeypatch.delenv(\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", raising=False)\n    monkeypatch.delenv(\n        \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\", raising=False)\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        block_shape = (16, 8, 128)\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=1, n_layers=1,\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\n        expected_capacity = chunk_delta3_exception_capacity(16384)\n        expected_body_stride = chunk_delta3_body_stride(16384)\n        assert compressor._entry_capacity == expected_capacity\n        assert compressor._body_stride == expected_body_stride\n        assert \"body\" in compressor._host_pools[0][\"k\"]\n        assert \"blob\" not in compressor._host_pools[0][\"k\"]\n        assert set(compressor._gpu_decomp_pool[\"k\"]) == {\n            \"body\", \"entries20x3\", \"entry_word_offsets\"}\n        assert compressor._kv_split_min_bytes == expected_body_stride * 512\n        assert compressed_block_bytes(\"chunk_delta3\", 16384) == (\n            expected_body_stride + (expected_capacity // 3) * 8 + 4)\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\ndef test_cpu_kv_exception_overflow_restores_raw_secondary(\n        monkeypatch) -> None:\n    from tiered_serve.chunk_delta3_kv_compressor import (\n        ChunkDelta3KVCompressor,\n    )\n    from tiered_serve.dual_memory_loader import DualMemoryLoader\n\n    monkeypatch.setenv(\"TIERED_SERVE_KV_CD3_EXCEPTION_CAPACITY\", \"3\")\n    block_shape = (16, 8, 128)\n    # Transposition makes each 16-value encoder chunk span many exponents,\n    # deterministically overflowing a three-entry test row.\n    bits = torch.arange(16384, dtype=torch.int32).to(torch.int16)\n    host_k = (bits.view(torch.bfloat16).reshape(128, 128).t()\n              .contiguous().reshape(1, *block_shape).pin_memory())\n    host_v = torch.randn(\n        1, *block_shape, generator=torch.Generator().manual_seed(73),\n        dtype=torch.float32).to(torch.bfloat16).contiguous().pin_memory()\n    monkeypatch.setattr(\n        DualMemoryLoader, \"kv_caches\",\n        [SimpleNamespace(secondary_kv=(host_k, host_v))])\n\n    compressor = ChunkDelta3KVCompressor(torch.cuda.current_stream())\n    try:\n        compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=1, n_layers=1,\n            max_gpu_blocks=1, max_gpu_decomp_blocks=1)\n        compressor.compress_batch_async_from_host(\n            0, [0], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._secondary_fallback_possible[0]\n        assert int(compressor._host_pools[0][\"k\"][\n            \"num_exceptions\"][0]) > compressor._entry_capacity\n\n        output_k = torch.zeros(\n            1, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        output_v = torch.zeros_like(output_k)\n        active = [0]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(output_k, output_v))\n        torch.cuda.synchronize()\n        _assert_bit_exact(output_k.cpu(), host_k)\n        _assert_bit_exact(output_v.cpu(), host_v)\n    finally:\n        compressor.stop_kv_compress_workers()\n\n\n@pytest.mark.parametrize(\"n_tokens\", [1, 16, 32, 40, 48, 64, 128])\ndef test_fused_linear_matches_dense(n_tokens: int) -> None:\n    codec = _codec()\n    generator = torch.Generator(device=\"cuda\").manual_seed(41 + n_tokens)\n    weight = (torch.randn(\n        128, 128, generator=generator, dtype=torch.float32, device=\"cuda\"\n    ) * 0.02).to(torch.bfloat16)\n    compressed = codec.compress(weight)\n    assert compressed.num_exceptions > 0\n\n    codec._fused_max_n_override = 10 ** 9\n    activation = torch.randn(\n        n_tokens, 128, generator=generator,\n        dtype=torch.bfloat16, device=\"cuda\")\n    scratch = codec.alloc_fused_scratch(\n        128, 128, n_tokens, activation.dtype, activation.device)\n    actual = codec.linear_apply_into(compressed, activation, scratch)\n    expected = F.linear(activation, weight)\n    torch.cuda.synchronize()\n\n    amax = float(expected.abs().max())\n    assert torch.allclose(\n        actual.float(), expected.float(),\n        atol=max(1e-2, 0.02 * amax), rtol=0.02)\n\"\"\"CPU-only checks for the opt-in request-free KV timing path.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nimport pytest\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nDECORATOR_SOURCE = REPO_ROOT / \"tiered_serve\" / \"vllm_block_decorator.py\"\nKV_SOURCE = REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"kv.py\"\n\n\nclass SequenceClock:\n    def __init__(self, *values):\n        self._values = iter(values)\n\n    def __call__(self):\n        return next(self._values)\n\n\ndef _fail_clock():\n    raise AssertionError(\"canonical KV-free path must not read the clock\")\n\n\ndef _decorator_namespace(loader, clock):\n    tree = ast.parse(DECORATOR_SOURCE.read_text())\n    function_names = {\n        \"reset_kv_free_profile\",\n        \"kv_free_profile_checkpoint\",\n        \"kv_free_profile_records_since\",\n        \"on_blocks_freed_v1\",\n    }\n    body = []\n    for node in tree.body:\n        if isinstance(node, ast.Assign) and any(\n            isinstance(target, ast.Name)\n            and target.id in {\n                \"_kv_free_profile_enabled\",\n                \"_kv_free_profile_records\",\n            }\n            for target in node.targets\n        ):\n            body.append(node)\n        elif isinstance(node, ast.FunctionDef) and node.name in function_names:\n            body.append(node)\n    module = ast.fix_missing_locations(ast.Module(body=body, type_ignores=[]))\n    namespace = {\n        \"DualMemoryLoader\": loader,\n        \"perf_counter_ns\": clock,\n    }\n    exec(compile(module, str(DECORATOR_SOURCE), \"exec\"), namespace)\n    return namespace\n\n\ndef _offline_metrics_namespace():\n    source = REPO_ROOT / \"offline_offload_kvweight.py\"\n    tree = ast.parse(source.read_text())\n    names = {\n        \"aggregate_kv_free_records\",\n        \"build_kv_free_step_metrics\",\n        \"format_kv_free_breakdown_row\",\n    }\n    body = [\n        node for node in tree.body\n        if (\n            isinstance(node, ast.Assign)\n            and any(isinstance(target, ast.Name)\n                    and target.id == \"KV_FREE_BREAKDOWN_COLUMNS\"\n                    for target in node.targets)\n        ) or (\n            isinstance(node, ast.FunctionDef) and node.name in names\n        )\n    ]\n    module = ast.fix_missing_locations(ast.Module(body=body, type_ignores=[]))\n    namespace = {}\n    exec(compile(module, str(source), \"exec\"), namespace)\n    return namespace\n\n\ndef _loader_class():\n    class Loader:\n        use_kv_comp = True\n        num_dedicated_blocks = 10\n        free_calls = []\n        timings = {\n            0: (10, 20, 30),\n            2: (1, 2, 3),\n        }\n\n        @classmethod\n        def free_slot(cls, block_id):\n            cls.free_calls.append((\"canonical\", block_id))\n\n        @classmethod\n        def free_slot_profiled(cls, block_id):\n            cls.free_calls.append((\"profiled\", block_id))\n            return cls.timings[block_id]\n\n    return Loader\n\n\ndef _block(block_id, ref_cnt):\n    return SimpleNamespace(block_id=block_id, ref_cnt=ref_cnt)\n\n\ndef test_disabled_callback_preserves_timer_free_cleanup_path():\n    loader = _loader_class()\n    namespace = _decorator_namespace(loader, _fail_clock)\n\n    namespace[\"reset_kv_free_profile\"](enabled=False)\n    namespace[\"on_blocks_freed_v1\"]([\n        _block(4, 1),\n        _block(10, 1),\n        _block(12, 1),\n    ])\n\n    assert loader.free_calls == [(\"canonical\", 0), (\"canonical\", 2)]\n    assert namespace[\"kv_free_profile_checkpoint\"]() == 0\n    assert namespace[\"kv_free_profile_records_since\"](0) == ()\n\n\ndef test_enabled_callback_records_counts_phases_and_step_checkpoints():\n    loader = _loader_class()\n    namespace = _decorator_namespace(\n        loader, SequenceClock(100, 220, 1000, 1080))\n    reset = namespace[\"reset_kv_free_profile\"]\n    records_since = namespace[\"kv_free_profile_records_since\"]\n\n    reset(enabled=True)\n    namespace[\"on_blocks_freed_v1\"]([\n        _block(4, 1),\n        _block(10, 1),\n        _block(12, 2),\n    ])\n    checkpoint = namespace[\"kv_free_profile_checkpoint\"]()\n\n    first = records_since(0)\n    assert len(first) == 1\n    assert first[0] == {\n        \"started_ns\": 100,\n        \"elapsed_ns\": 120,\n        \"input_blocks\": 3,\n        \"offload_blocks\": 2,\n        \"final_ref_offload_blocks\": 1,\n        \"slot_manager_ns\": 11,\n        \"stream_sync_ns\": 22,\n        \"compressor_ns\": 33,\n        \"kv_comp_enabled\": True,\n    }\n    assert loader.free_calls == [(\"profiled\", 0), (\"profiled\", 2)]\n\n    loader.use_kv_comp = False\n    namespace[\"on_blocks_freed_v1\"]([_block(11, 1)])\n    second = records_since(checkpoint)\n    assert len(second) == 1\n    assert second[0][\"elapsed_ns\"] == 80\n    assert second[0][\"input_blocks\"] == 1\n    assert second[0][\"offload_blocks\"] == 0\n    assert second[0][\"kv_comp_enabled\"] is False\n\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(-1)\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(3)\n\n    reset(enabled=False)\n    assert records_since(0) == ()\n\n\ndef _free_slot_policy(clock, method_name):\n    tree = ast.parse(KV_SOURCE.read_text())\n    kv_class = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef) and node.name == \"KVMixin\"\n    )\n    method = next(\n        node for node in kv_class.body\n        if isinstance(node, ast.FunctionDef) and node.name == method_name\n    )\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=[method],\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {\"_time\": SimpleNamespace(perf_counter_ns=clock)}\n    exec(compile(module, str(KV_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"]\n\n\nclass FakeOffloadSystem:\n    def __init__(self, trace):\n        self.trace = trace\n\n    def free_block(self, layer_id, block_id):\n        self.trace.append((\"slot\", layer_id, block_id))\n\n\nclass FakeStream:\n    def __init__(self, name, trace):\n        self.name = name\n        self.trace = trace\n\n    def synchronize(self):\n        self.trace.append((\"sync\", self.name))\n\n\nclass FakeCompressor:\n    def __init__(self, trace, *, metadata_only=False):\n        self.trace = trace\n        self._kv_free_metadata_only = metadata_only\n        self.batch_decomp_stream = FakeStream(\"decomp\", trace)\n        self.load_kv_stream = FakeStream(\"load\", trace)\n        self.comp_stream = FakeStream(\"comp\", trace)\n\n    def free_persistent_block(self, layer_id, block_id):\n        self.trace.append((\"compressor\", layer_id, block_id))\n\n\ndef _configure_policy(\n    policy,\n    trace,\n    *,\n    offload_system=True,\n    compressor=True,\n    metadata_only=False,\n    use_kv_comp=True,\n):\n    policy.n_layers = 2\n    if offload_system:\n        policy.kv_offload_system = FakeOffloadSystem(trace)\n    policy.use_kv_comp = use_kv_comp\n    if compressor:\n        policy._kv_compressor_ref = FakeCompressor(\n            trace, metadata_only=metadata_only)\n\n\ndef test_free_slot_timing_splits_slot_sync_and_compressor_work():\n    policy = _free_slot_policy(\n        SequenceClock(100, 130, 200, 260, 300, 390),\n        \"free_slot_profiled\",\n    )\n    trace = []\n    _configure_policy(policy, trace)\n\n    timing = policy.free_slot_profiled(7)\n\n    assert timing == (30, 60, 90)\n    assert trace == [\n        (\"slot\", 0, 7),\n        (\"slot\", 1, 7),\n        (\"sync\", \"decomp\"),\n        (\"sync\", \"load\"),\n        (\"sync\", \"comp\"),\n        (\"compressor\", 0, 7),\n        (\"compressor\", 1, 7),\n    ]\n\n\ndef test_free_slot_canonical_path_does_not_read_clock():\n    policy = _free_slot_policy(_fail_clock, \"free_slot\")\n    trace = []\n    _configure_policy(policy, trace)\n\n    assert policy.free_slot(9) is None\n    assert trace == [\n        (\"slot\", 0, 9),\n        (\"slot\", 1, 9),\n        (\"sync\", \"decomp\"),\n        (\"sync\", \"load\"),\n        (\"sync\", \"comp\"),\n        (\"compressor\", 0, 9),\n        (\"compressor\", 1, 9),\n    ]\n\n    policy.n_layers = None\n    assert policy.free_slot(9) is None\n    profiled_policy = _free_slot_policy(_fail_clock, \"free_slot_profiled\")\n    profiled_policy.n_layers = None\n    assert profiled_policy.free_slot_profiled(9) == (0, 0, 0)\n\n\ndef test_metadata_only_compressor_reports_zero_stream_sync_time():\n    policy = _free_slot_policy(\n        SequenceClock(100, 130, 300, 390),\n        \"free_slot_profiled\",\n    )\n    trace = []\n    _configure_policy(policy, trace, metadata_only=True)\n\n    assert policy.free_slot_profiled(7) == (30, 0, 90)\n    assert not any(item[0] == \"sync\" for item in trace)\n\n\n@pytest.mark.parametrize(\n    (\"offload_system\", \"compressor\", \"metadata_only\", \"use_kv_comp\"),\n    [\n        (True, True, False, True),\n        (True, True, True, True),\n        (False, True, False, True),\n        (True, False, False, True),\n        (True, True, False, False),\n    ],\n)\ndef test_profiled_free_slot_stays_in_lockstep_with_canonical_cleanup(\n    offload_system,\n    compressor,\n    metadata_only,\n    use_kv_comp,\n):\n    canonical = _free_slot_policy(_fail_clock, \"free_slot\")\n    profiled = _free_slot_policy(\n        SequenceClock(*range(20)), \"free_slot_profiled\")\n    canonical_trace = []\n    profiled_trace = []\n    options = {\n        \"offload_system\": offload_system,\n        \"compressor\": compressor,\n        \"metadata_only\": metadata_only,\n        \"use_kv_comp\": use_kv_comp,\n    }\n    _configure_policy(canonical, canonical_trace, **options)\n    _configure_policy(profiled, profiled_trace, **options)\n\n    canonical.free_slot(13)\n    profiled.free_slot_profiled(13)\n\n    assert profiled_trace == canonical_trace\n\n\ndef test_step_aggregation_handles_multiple_and_zero_callbacks():\n    namespace = _offline_metrics_namespace()\n    build = namespace[\"build_kv_free_step_metrics\"]\n    format_row = namespace[\"format_kv_free_breakdown_row\"]\n    columns = namespace[\"KV_FREE_BREAKDOWN_COLUMNS\"]\n    step = {\n        \"phase\": 9,\n        \"decode_step\": 4,\n        \"active_before\": 3,\n        \"active_after\": 1,\n        \"finished_reqs\": 2,\n        \"step_latency_ms\": 10.0,\n    }\n    records = (\n        {\n            \"elapsed_ns\": 1_000_000,\n            \"input_blocks\": 10,\n            \"offload_blocks\": 8,\n            \"final_ref_offload_blocks\": 8,\n            \"slot_manager_ns\": 200_000,\n            \"stream_sync_ns\": 100_000,\n            \"compressor_ns\": 300_000,\n        }