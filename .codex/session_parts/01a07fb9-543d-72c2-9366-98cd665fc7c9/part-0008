ile: {_HUGEPAGE_NR_PATH}\\n\"\n        f\"Reserve hugepages first, e.g.:\\n\"\n        f\"  echo 16 | sudo tee {_HUGEPAGE_NR_PATH}\\n\"\n        f\"  mkdir -p /mnt/hugepages\\n\"\n        f\"  sudo mount -t hugetlbfs -o pagesize=16G none /mnt/hugepages\")\n\nimport random\nimport sys\nimport time\n\nimport numpy as np\nimport torch\nimport torch.multiprocessing as mp\n\nfrom tiered_serve.immigrant_model_loader import ImmigrantModelLoader  # noqa: F401\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\nfrom tiered_serve.module_block import resolve_ts_config\n\nfrom vllm import EngineArgs, LLMEngine, SamplingParams\nfrom vllm.utils.argparse_utils import FlexibleArgumentParser\n\nfrom _offline_staged_correctness import (\n    SemanticPromptError,\n    dump_generated_tokens,\n    load_semantic_prompt,\n    validate_semantic_answers,\n    verify_llama_31_70b_runtime_state,\n)\n\n\ndef calc_prefill_phases(batch, input_seq_len, max_num_batched_tokens):\n    \"\"\"Simulate V1 chunked-prefill scheduler to find which phase each\n    request completes its prefill.  V1 processes partial prefill chunks\n    within the token budget, so requests may complete earlier than a\n    naive whole-prefill-only simulation predicts.\n\n    Returns a list of length *batch* where entry *i* is the phase in which\n    request *i* produces its first decode token.\"\"\"\n    prefill_phases = [None] * batch\n    decode_count = 0\n    partials = []          # [(req_index, remaining_tokens)]\n    next_req = 0\n    phase = 0\n\n    while next_req < batch or partials:\n        budget = max_num_batched_tokens\n\n        # 1. Running decode requests consume 1 token each.\n        budget -= decode_count\n\n        # 2. Continue partially-prefilled requests (they are in \"running\"\n        #    and their remaining prompt tokens count toward the budget).\n        new_partials = []\n        for req_idx, remaining in partials:\n            if budget <= 0:\n                new_partials.append((req_idx, remaining))\n                continue\n            consume = min(remaining, budget)\n            budget -= consume\n            remaining -= consume\n            if remaining == 0:\n                prefill_phases[req_idx] = phase\n                decode_count += 1\n            else:\n                new_partials.append((req_idx, remaining))\n        partials = new_partials\n\n        # 3. Schedule new waiting requests with remaining budget.\n        while next_req < batch and budget > 0:\n            consume = min(input_seq_len, budget)\n            budget -= consume\n            remaining = input_seq_len - consume\n            if remaining == 0:\n                prefill_phases[next_req] = phase\n                decode_count += 1\n            else:\n                partials.append((next_req, remaining))\n            next_req += 1\n\n        phase += 1\n\n    return prefill_phases\n\n   630\t        _DECODE_CAPTURE_REQS)\n   631\t    # gpu_memory_utilization flows through EngineArgs.from_cli_args via the\n   632\t    # native vLLM --gpu-memory-utilization flag (add_cli_args above).\n   633\t\n   634\t    # --- HBM limit: allocate a dummy tensor to reduce visible free memory ---\n   635\t    _hbm_ballast = None\n   636\t    if args.hbm_limit is not None:\n   637\t        _free, _total = torch.cuda.mem_get_info()\n   638\t        _target = int(args.hbm_limit * 1024**3)\n   639\t        _waste = _free - _target\n   640\t        if _waste > 0:\n   641\t            _hbm_ballast = torch.empty(_waste, dtype=torch.uint8, device='cuda:0')\n   642\t            _new_free, _ = torch.cuda.mem_get_info()\n   643\t            logger.info(\"HBM limit: %.2f GiB target, allocated %.2f GiB \"\n   644\t                        \"ballast (free: %.2f -> %.2f GiB)\",\n   645\t                        args.hbm_limit, _waste / 1024**3,\n   646\t                        _free / 1024**3, _new_free / 1024**3)\n   647\t            # Adjust gpu_memory_utilization so vLLM startup check passes: