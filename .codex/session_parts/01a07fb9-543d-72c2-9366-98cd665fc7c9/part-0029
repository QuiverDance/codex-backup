space[\"kv_free_profile_checkpoint\"]() == 0\n    assert namespace[\"kv_free_profile_records_since\"](0) == ()\n\n\ndef test_enabled_callback_records_counts_phases_and_step_checkpoints():\n    loader = _loader_class()\n    namespace = _decorator_namespace(\n        loader, SequenceClock(100, 220, 1000, 1080))\n    reset = namespace[\"reset_kv_free_profile\"]\n    records_since = namespace[\"kv_free_profile_records_since\"]\n\n    reset(enabled=True)\n    namespace[\"on_blocks_freed_v1\"]([\n        _block(4, 1),\n        _block(10, 1),\n        _block(12, 2),\n    ])\n    checkpoint = namespace[\"kv_free_profile_checkpoint\"]()\n\n    first = records_since(0)\n    assert len(first) == 1\n    assert first[0] == {\n        \"started_ns\": 100,\n        \"elapsed_ns\": 120,\n        \"input_blocks\": 3,\n        \"offload_blocks\": 1,\n        \"final_ref_offload_blocks\": 1,\n        \"slot_manager_ns\": 10,\n        \"stream_sync_ns\": 20,\n        \"compressor_ns\": 30,\n        \"kv_comp_enabled\": True,\n    }\n    assert loader.free_calls == [(\"profiled\", (0,))]\n\n    loader.use_kv_comp = False\n    namespace[\"on_blocks_freed_v1\"]([_block(11, 1)])\n    second = records_since(checkpoint)\n    assert len(second) == 1\n    assert second[0][\"elapsed_ns\"] == 80\n    assert second[0][\"input_blocks\"] == 1\n    assert second[0][\"offload_blocks\"] == 0\n    assert second[0][\"kv_comp_enabled\"] is False\n\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(-1)\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(3)\n\n    reset(enabled=False)\n    assert records_since(0) == ()\n\n\ndef test_callback_retires_a_repeated_block_once_at_its_final_release():\n    loader = _loader_class()\n    namespace = _decorator_namespace(loader, _fail_clock)\n    shared = _block(12, 2)\n\n    namespace[\"reset_kv_free_profile\"](enabled=False)\n    namespace[\"on_blocks_freed