{"timestamp":"2026-09-08T08:24:26.287Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0801e-53af-7152-b58b-b14f76bdd1eb","call_id":"call_LIqYsTLPuD9jUJ2DvApssfqk","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"CPU-only checks for the opt-in request-free KV timing path.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nimport pytest\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nDECORATOR_SOURCE = REPO_ROOT / \"tiered_serve\" / \"vllm_block_decorator.py\"\nKV_SOURCE = REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"kv.py\"\n\n\nclass SequenceClock:\n    def __init__(self, *values):\n        self._values = iter(values)\n\n    def __call__(self):\n        return next(self._values)\n\n\ndef _fail_clock():\n    raise AssertionError(\"canonical KV-free path must not read the clock\")\n\n\ndef _decorator_namespace(loader, clock):\n    tree = ast.parse(DECORATOR_SOURCE.read_text())\n    function_names = {\n        \"_offload_local_ids\",\n        \"final_reference_blocks\",\n        \"reset_kv_free_profile\",\n        \"kv_free_profile_checkpoint\",\n        \"kv_free_profile_records_since\",\n        \"on_blocks_freed_v1\",\n    }\n    body = []\n    for node in tree.body:\n        if isinstance(node, ast.Assign) and any(\n            isinstance(target, ast.Name)\n            and target.id in {\n                \"_kv_free_profile_enabled\",\n                \"_kv_free_profile_records\",\n            }\n            for target in node.targets\n        ):\n            body.append(node)\n        elif isinstance(node, ast.FunctionDef) and node.name in function_names:\n            body.append(node)\n    module = ast.fix_missing_locations(ast.Module(body=body, type_ignores=[]))\n    namespace = {\n        \"DualMemoryLoader\": loader,\n        \"perf_counter_ns\": clock,\n    }\n    exec(compile(module, str(DECORATOR_SOURCE), \"exec\"), namespace)\n    return namespace\n\n\ndef _offline_metrics_namespace():\n    source = REPO_ROOT / \"offline_offload_kvweight.py\"\n    tree = ast.parse(source.read_text())\n    names = {\n        \"aggregate_kv_free_records\",\n        \"build_kv_free_step_metrics\",\n        \"format_kv_free_breakdown_row\",\n    }\n    body = [\n        node for node in tree.body\n        if (\n            isinstance(node, ast.Assign)\n            and any(isinstance(target, ast.Name)\n                    and target.id == \"KV_FREE_BREAKDOWN_COLUMNS\"\n                    for target in node.targets)\n        ) or (\n            isinstance(node, ast.FunctionDef) and node.name in names\n        )\n    ]\n    module = ast.fix_missing_locations(ast.Module(body=body, type_ignores=[]))\n    namespace = {}\n    exec(compile(module, str(source), \"exec\"), namespace)\n    return namespace\n\n\ndef _loader_class():\n    class Loader:\n        use_kv_comp = True\n        num_dedicated_blocks = 10\n        free_calls = []\n\n        @classmethod\n        def retire_offloaded_blocks(cls, block_ids):\n            cls.free_calls.append((\"canonical\", tuple(block_ids)))\n\n        @classmethod\n        def retire_offloaded_blocks_profiled(cls, block_ids):\n            cls.free_calls.append((\"profiled\", tuple(block_ids)))\n            return 10, 20, 30\n\n    return Loader\n\n\ndef _block(block_id, ref_cnt, *, is_null=False):\n    return SimpleNamespace(\n        block_id=block_id, ref_cnt=ref_cnt, is_null=is_null)\n\n\ndef test_disabled_callback_preserves_timer_free_cleanup_path():\n    loader = _loader_class()\n    namespace = _decorator_namespace(loader, _fail_clock)\n\n    namespace[\"reset_kv_free_profile\"](enabled=False)\n    namespace[\"on_blocks_freed_v1\"]([\n        _block(4, 1),\n        _block(10, 1),\n        _block(12, 1),\n    ])\n\n    assert loader.free_calls == [(\"canonical\", (0, 2))]\n    assert namespace[\"kv_free_profile_checkpoint\"]() == 0\n    assert namespace[\"kv_free_profile_records_since\"](0) == ()\n\n\ndef test_enabled_callback_records_counts_phases_and_step_checkpoints():\n    loader = _loader_class()\n    namespace = _decorator_namespace(\n        loader, SequenceClock(100, 220, 1000, 1080))\n    reset = namespace[\"reset_kv_free_profile\"]\n    records_since = namespace[\"kv_free_profile_records_since\"]\n\n    reset(enabled=True)\n    namespace[\"on_blocks_freed_v1\"]([\n        _block(4, 1),\n        _block(10, 1),\n        _block(12, 2),\n    ])\n    checkpoint = namespace[\"kv_free_profile_checkpoint\"]()\n\n    first = records_since(0)\n    assert len(first) == 1\n    assert first[0] == {\n        \"started_ns\": 100,\n        \"elapsed_ns\": 120,\n        \"input_blocks\": 3,\n        \"offload_blocks\": 1,\n        \"final_ref_offload_blocks\": 1,\n        \"slot_manager_ns\": 10,\n        \"stream_sync_ns\": 20,\n        \"compressor_ns\": 30,\n        \"kv_comp_enabled\": True,\n    }\n    assert loader.free_calls == [(\"profiled\", (0,))]\n\n    loader.use_kv_comp = False\n    namespace[\"on_blocks_freed_v1\"]([_block(11, 1)])\n    second = records_since(checkpoint)\n    assert len(second) == 1\n    assert second[0][\"elapsed_ns\"] == 80\n    assert second[0][\"input_blocks\"] == 1\n    assert second[0][\"offload_blocks\"] == 0\n    assert second[0][\"kv_comp_enabled\"] is False\n\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(-1)\n    with pytest.raises(ValueError, match=\"invalid KV-free profile checkpoint\"):\n        records_since(3)\n\n    reset(enabled=False)\n    assert records_since(0) == ()\n\n\ndef test_callback_retires_a_repeated_block_once_at_its_final_release():\n    loader = _loader_class()\n    namespace = _decorator_namespace(loader, _fail_clock)\n    shared = _block(12, 2)\n\n    namespace[\"reset_kv_free_profile\"](enabled=False)\n    namespace[\"on_blocks_freed_v1\"]([shared,