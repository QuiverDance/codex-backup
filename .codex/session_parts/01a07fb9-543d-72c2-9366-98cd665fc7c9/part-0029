de.name == \"KVMixin\"\n    )\n    method_names = {\n        \"free_slot\",\n        \"free_slot_profiled\",\n        \"retire_offloaded_blocks\",\n        \"retire_offloaded_blocks_profiled\",\n    }\n    methods = [\n        node for node in kv_class.body\n        if isinstance(node, ast.FunctionDef) and node.name in method_names\n    ]\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=methods,\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n    namespace = {\"_time\": SimpleNamespace(perf_counter_ns=clock)}\n    exec(compile(module, str(KV_SOURCE), \"exec\"), namespace)\n    return namespace[\"Policy\"]\n\n\nclass FakeOffloadSystem:\n    def __init__(self, trace):\n        self.trace = trace\n\n    def free_block(self, layer_id, block_id):\n        self.trace.append((\"slot\", layer_id, block_id))\n\n\nclass FakeStream:\n    def __init__(self, name, trace):\n        self.name = name\n        self.trace = trace\n\n    def synchronize(self):\n        self.trace.append((\"sync\", self.name))\n\n\nclass FakeCompressor:\n    def __init__(self, trace, *, metadata_only=False):\n        self.trace = trace\n        self._kv_free_metadata_only = metadata_only\n        self.batch_decomp_stream = FakeStream(\"decomp\", trace)\n        self.load_kv_stream = FakeStream(\"load\", trace)\n        self.comp_stream = FakeStream(\"comp\", trace)\n\n    def free_persistent_block(self, layer_id, block_id):\n        self.trace.append((\"compressor\", layer_id, block_id))\n\n\nclass FakeBatchCompressor(FakeCompressor):\n    def free_persistent_blocks(self, block_ids):\n        self.trace.append((\"compressor-batch\", tuple(block_ids)))\n\n\ndef _configure_policy(\n    policy,\n    trace,\n    *,\n    offload_system=True,\n    compressor=True,\n    batch_compressor=False,\n    metadata_only=False,\n    use_kv_comp=True,\n):\n    policy.n_layers = 2\n    if offload_system:\n        policy.kv_offload_system = FakeOffloadSystem(trace)\n    policy.use_kv_comp = use_kv_comp\n    if compressor:\n        compressor_type = (\n            FakeBatchCompressor if batch_compressor else FakeCompressor)\n        policy._kv_compressor_ref = compressor_type(\n            trace, metadata_only=metadata_only)\n\n\ndef test_retirement_batches_cd3_metadata_and_preserves_generic_cleanup():\n    policy = _retirement_policy(_fail_clock)\n    trace = []\n    _configure_policy(\n        policy, trace, metadata_only=True, batch_compressor=True)\n\n    policy.retire_offloaded_blocks([7, 9, 7])\n\n    assert trace == [\n        (\"slot\", 0, 7),\n        (\"slot\", 1, 7),\n        (\"slot\", 0, 9),\n        (\"slot\", 1, 9),\n        (\"compressor-batch\", (7, 9)),\n    ]\n\n\ndef test_profiled_batch_retirement_times_each_storage_owner_once():\n    policy = _retirement_policy(\n        SequenceClock(100, 130, 300, 390))\n    trace = []\n    _configure_policy(\n        policy, trace, metadata_only=True, batch_compressor=True)\n\n    timing = policy.retire_offloaded_blocks_profiled([7, 9])\n\n    assert timing == (30, 0, 90)\n    assert trace[-1] == (\"compressor-batch\", (7, 9))\n\n\ndef test_nonbatch_codec_retains_exact_scalar_cleanup_order():\n    policy = _retirement_policy(_fail_clock)\n    trace = []\n    _configure_policy(policy, trace, metadata_only=False)\n\n    policy.retire_offloaded_blocks([7, 9])\n\n    assert trace == [\n        (\"slot\", 0, 7),\n        (\"slot\", 1, 7),\n        (\"sync\", \"decomp\"),\n        (\"sync\", \"load\"),\n        (\"sync\", \"comp\"),\n        (\"compressor\", 0, 7),\n        (\"compressor\", 1, 7),\n        (\"slot\", 0, 9),\n        (\"slot\", 1, 9),\n        (\"sync\", \"decomp\"),\n        (\"sync\", \"load\"),\n        (\"sync\", \"comp\"),\n        (\"compressor\", 0, 9),\n        (\"compressor\", 1, 9),\n    ]\n\n\n@pytest.mark.parametrize(\"batch_compressor\", [False, True])\ndef test_profiled_re