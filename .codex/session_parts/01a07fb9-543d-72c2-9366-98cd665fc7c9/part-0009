                          \"Computed from \"\n                             \"the CUDA events recorded by --collect-time \"\n                             \"(implies --collect-time; both set \"\n                             \"TIERED_SERVE_COLLECT_TIME=1). This mode is \"\n                             \"instrumented and not suitable for canonical \"\n                             \"throughput/latency comparisons.\")\n    parser.add_argument(\n        \"--reduce-kv-footprint\",\n        action=\"store_true\",\n        help=\"Keep only block 0 on GPU (vLLM CUDA graph always references \"\n             \"block 0 via zero-initialized graph_block_tables). \"\n             \"Sets TIERED_SERVE_REDUCE_KV_FOOTPRINT=1 to minimize \"\n             \"dedicated KV memory on GPU.\")\n    parser.add_argument(\n        \"--no-offload-kv\",\n        action=\"store_true\",\n        help=\"Keep the entire KV cache resident in GPU HBM: no LPDDR \"\n             \"offload and no KV compression (weights are still offloaded). \"\n             \"Unlike --reduce-kv-footprint there is no per-step \"\n             \"secondary<->primary self-copy. Sets \"\n             \"TIERED_SERVE_NO_OFFLOAD_KV=1.\")\n    parser.add_argument(\n        \"--randomize-kv-block-ids\",\n        action=\"store_true\",\n        help=\"Offline-only serving-fragmentation simulation. Make vLLM's \"\n             \"BlockPool select physical offloadable KV blocks from a seeded \"\n             \"random order at allocation time. HBM-dedicated blocks keep \"\n             \"their normal first-priority allocation.\")\n    parser.add_argument(\n        \"--kv-block-random-seed\",\n        type=int,\n        default=0,\n        help=\"Seed for vLLM's randomized KV block allocator (default: 0).\")\n    parser.add_argument(\n        \"--kv-block-random-group-size\",\n        type=int,\n        default=1,\n    os.environ[\"TIERED_SERVE_ATS_DECOMP_OFFLOAD\"] = (\n        \"1\" if args.ats_decomp_offload else \"0\")\n    if args.mantexp_split_kv:\n        # mantexp split-KV implies KV compression is on with the\n        # 'mantexp' backend (sm in HBM, exp ANS-compressed in LPDDR).\n        if args.kv_comp and args.kv_comp != \"mantexp\":\n            print(\n                f\"WARNING: --mantexp-split-kv overrides \"\n                f\"--kv-comp={args.kv_comp} -> mantexp\",\n                file=sys.stderr)\n        args.kv_comp = \"mantexp\"\n        os.environ[\"TIERED_SERVE_MANTEXP_SPLIT\"] = \"1\"\n        os.environ[\"TIERED_SERVE_MANTEXP_SPLIT_KV\"] = \"1\"\n\n    os.environ[\"TIERED_SERVE_USE_KV_COMP\"] = \"1\" if args.kv_comp else \"0\"\n    if args.kv_comp:\n        os.environ[\"TIERED_SERVE_KV_COMP_BACKEND\"] = args.kv_comp\n        # Match serving: P4Flat partial tails stay in HBM and are compressed\n        # once, when their 16-token block becomes complete.  An explicit 0\n        # keeps the legacy per-step partial compression path for A/B runs.\n        if args.kv_comp in (\"p4flat\", \"p4flatcpu\", \"chunk_delta3\"):\n            os.environ.setdefault(\n                \"TIERED_SERVE_KV_FULL_BLOCK_ONLY\", \"1\")\n        if args.kv_comp == \"zipserv\":\n            # Keep the offline runner identical to the serving launcher: an\n            # inherited gpu_direct setting must not bypass ZipServ CPU encode.\n            os.environ[\"TIERED_SERVE_KV_COMP_PRODUCER\"] = \\\n                \"cpu_after_raw_swap\"\n        # P4Flat/UBLB own the tight 25,600-byte default and their encoders\n        # publish is_raw=2 for an over-stride block.  An explicit\n        # TIERED_SERVE_KV_BLOB_STRIDE (0 selects raw-safe) still overrides it.\n    # Unified timing flag: COLLECT_TIME enables both event collection and the\n    # aggregated breakdown summary.  --collect-time and --time-breakdown both\n    # just turn it on.\n    collect_time = args.collect_time or args.time_breakdown\n    os.environ[\"TIERED_SERVE_COLLECT_TIME\"] = \"1\" if collect_time else \"0\"\n\n    engine_type = \"ts\"\n    if weight_comp_requested:\n        engine_type += \"_wc\"\n    if args.kv_comp:\n        engine_type += \"_kvc\"\n    if collect_time:\n        engine_type += \"_time\"\n    if args.time_breakdown:\n        engine_type += \"_brk\"\n\n    os.environ[\n        \"TIERED_SERVE_ENGINE_ID\"] = f\"{engine_type}_{model_id}\"\n\n    logger = logging.getLogger(\"vllm\")\n    logger.setLevel(log_level)\n    # NOTE: vLLM already attaches a formatted StreamHandler (the\n    # \"INFO <date> [file:line] ...\" console line) to the \"vllm\" logger at\n    # import time.  Adding a second, plain StreamHandler here printed every\n    # record twice on the console (once formatted, once bare).  The\n    # FileHandler below is the only extra sink we need.\n\n    def handle_unhandled_exception(exc_type, exc_value, exc_traceback):\n        logger.critical(\"Unhandled exception\",\n                        exc_info=(exc_type, exc_value, exc_traceback))\n\n    sys.excepthook = handle_unhandled_exception\n\n    run_datetime = datetime.now().strftime('%Y%m%d_%H%M%S')\n    folder_path = (\n        f\"./logs/offline/{model_id}/{ts_config_name}/\"\n        f\"{run_datetime}\"\n    )\n    os.makedirs(folder_path, exist_ok=True)\n    log_file_name = f\"{folder_path}/PCIe_{'_'.join(str(b) for b in batches)}.log\"\n    file_handler = logging.FileHandler(log_file_name)\n    logger.addHandler(file_handler)\n\n    logger.info(\n        \"##########################################################################\"\n    )\n    logger.info(f\"##### Offload KVWeight\")\n    logger.info(f\"##### {model_id} {args.model}\")\n    logger.info(f\"##### Input Seq Len: {input_seq_len} Gen Phase: {gen_phase}\")\n    logger.info(\n        \"##### Required scheduler policy: prefix_caching=False \"\n        \"chunked_prefill=True prefill_chunk=%d\",\n        args.prefill_chunk,\n    )\n    if args.prompt_file is not None:\n        logger.info(\n            \"##### Semantic prompt: %s (%d tokens), expect=%r\",\n            args.prompt_file, input_seq_len, args.expect_text)\n    logger.info(f\"##### BATCH SIZES: {batches}\")\n    if args.weight_comp:\n        logger.info(f\"##### Using Weight Compression\")\n    if args.fused_mm:\n        logger.info(\"##### Using Fused MM\")\n    if args.kv_comp:\n        logger.info(\n            \"raw_bytes=%d compressed_bytes=%d ratio=%.12g \"\n            \"exception_count=%d\",\n            args.weight_comp, _weight_tensor_count, _weight_raw_bytes,\n            _weight_compressed_bytes,\n            _weight_raw_bytes / _weight_compressed_bytes,\n            _weight_exception_count)\n\n    # Engine initialisation consumes a config-dependent amount of global RNG\n    # state.  Use a dedicated generator so raw-KV and KV-comp runs receive the\n    # same prompts and correctness dumps are directly comparable.\n    if semantic_prompt is not None:\n        input_data = [list(semantic_prompt.token_ids) for _ in range(max_batch)]\n    else:\n        input_generator = torch.Generator(device=\"cpu\")\n        input_generator.manual_seed(0)\n        input_data = torch.randint(\n            32000, [max_batch, input_seq_len], dtype=torch.long,\n            generator=input_generator).tolist()\n\n    req_id = 0\n    nsys_cap_env = os.getenv(\"TIERED_SERVE_NSYS_CAP\")\n    nsys_cap = (tuple(int(x) for x in nsys_cap_env.split(\":\"))\n                if nsys_cap_env else None)\n    cuda_profiler = None\n    if nsys_cap is not None:\n        import torch.cuda.profiler as cuda_profiler\n    dump_gen_prefix = os.getenv(\"TIERED_SERVE_DUMP_GEN\")\n\n    def run_batches(\n        tag: str,\n        cfg_path: str,\n        artifact_key: str | None = None,\n    ):\n        nonlocal req_id\n        cfg_stem = artifact_key or Path(cfg_path).stem\n        nokv_suffix = \"_nokv\" if args.reduce_kv_footprint else \"\"\n        csv_name = (\n            f\"{datetime.now().strftime('%Y%m%d_%H%M%S')}_\"\n            f\"{cfg_stem}{nokv_suffix}.csv\"\n        )\n        csv_path = os.path.join(folder_path, csv_name)\n        config_dump_prefix = (\n            f\"{dump_gen_prefix}.{artifact_key}\"\n            if dump_gen_prefix and artifact_key else dump_gen_prefix\n        )\n        breakdown_name = (\n            f\"breakdown.{artifact_key}.csv\"\n            if artifact_key else \"breakdown.csv\"\n        )\n        csv_file = open(csv_path, \"w\")\n        csv_file.write(\n            \"Batch TTFT(P50) TTFT(P90) TTFT(P95) TTFT(P99) \"\n            \"TPOT(P50) TPOT(P90) TPOT(P95) TPOT(P99)\\n\"\n        )\n        csv_file.flush()\n        logger.info(f\"CSV: {csv_path}\")\n        for batch in batches:\n            logger.info(f\"##### BATCH SIZE: {batch} START ({tag})\")\n            ttfts = []\n            tpots = []\n            decode_step_latencies = []\n            # Drained once below to log a single averaged prefill- and\n            # decode-phase [Breakdown] line for this batch (the per-step\n            # lines are suppressed in dual_memory_loader.calc_times).\n            if args.time_breakdown:\n                DualMemoryLoader.prefill_breakdowns.clear()\n                DualMemoryLoader.decode_breakdowns.clear()\n            engine.collective_rpc(\"ts_reset_kv_phases\")\n\n            # Preserve the historical synchronised finish policy unless\n            # the benchmark explicitly asks for an exact per-request\n            # generation length.\n            if args.chunked_prefill and not args.fixed_generation_length:\n                pp = calc_prefill_phases(\n                    batch, input_seq_len,\n                    engine_args.max_num_batched_tokens)\n                last_pp = max(pp)\n                end_phase = last_pp + gen_phase\n                gen_phases = [end_phase - p for p in pp]\n            else:\n                gen_phases = [gen_phase] * batch\n\n            submit_times = {}\n            token_times = {}\n            token_counts = {}\n            for idx in range(batch):\n                request_id = str(req_id)\n                num_tokens = gen_phases[idx]\n                submit_times[request_id] = time.perf_counter()\n                token_times[request_id] = []\n                token_counts[request_id] = 0\n                engine.add_request(\n                    request_id,\n                    {\"prompt_token_ids\": input_data[idx]},\n                    SamplingParams(\n                        temperature=0.0,\n                        min_tokens=num_tokens,\n                        max_tokens=num_tokens,\n                        ignore_eos=True,\n                    ),\n                )\n                req_id += 1\n\n            phase = 0\n            gen_tokens = {}   # req_id -> generated token_ids (correctness dump)\n            while engine.has_unfinished_requests():\n                engine.collective_rpc(\"ts_set_phase\", args=(phase,))\n\n                if nsys_cap is not None:\n                    _cb, _cs, _cn = nsys_cap\n                    if batch == _cb and phase == _cs:\n                        torch.cuda.synchronize()\n                        cuda_profiler.start()\n                    elif batch == _cb and phase == _cs + _cn:\n                        torch.cuda.synchronize()\n                        cuda_profiler.stop()\n\n                t0 = time.perf_counter()\n                request_outputs = engine.step()\n                step_done = time.perf_counter()\n                latency = (step_done - t0) * 1000  # ms\n                all_had_first_token = all(token_times[r]\n                                          for r in token_times)\n\n                for output in request_outputs:\n                    if output.outputs and output.outputs[0].token_ids:\n                        request_id = output.request_id\n                        ids = list(output.outputs[0].token_ids)\n                        previous_count = token_counts.get(request_id, 0)\n                        new_count = len(ids)\n                        if new_count > previous_count:\n                            if previous_count == 0:\n                                ttfts.append(\n                                    (step_done - submit_times[request_id])\n                                    * 1000)\n                            token_times[request_id].extend(\n                                [step_done] * (new_count - previous_count))\n                            token_counts[request_id] = new_count\n                        gen_tokens[request_id] = ids\n\n                # Preserve step latency as a separate diagnostic domain.  It is\n                # deliberately not called TPOT: one batched engine.step is not\n                # one per-request inter-token latency.\n                if all_had_first_token:\n                    decode_step_latencies.append(latency)\n\n                phase += 1\n            dump_generated_tokens(\n                config_dump_prefix, batch, gen_tokens, logger)\n            if semantic_prompt is not None:\n                validate_semantic_answers(\n                    semantic_prompt,\n                    gen_tokens,\n                    expected_count=batch,\n                    expected_text=args.expect_text,\n                    logger=logger,\n                )\n\n            # One TPOT sample per request.  Warmup is applied in the request's\n            # inter-token domain, not by discarding arbitrary batch steps.\n            for request_id, stamps in token_times.items():\n                n_intervals = len(stamps) - 1\n                dropped = min(args.warmup, n_intervals)\n                kept = n_intervals - dropped\n                if kept > 0:\n                    tpots.append(\n                        (stamps[-1] - stamps[dropped]) * 1000 / kept)\n            if args.warmup > 0 and tpots:\n                logger.info(\n                    \"TPOT warmup: excluded first %d inter-token interval(s) \"\n                    \"per request (%d request samples)\",\n                    args.warmup, len(tpots))\n            if decode_step_latencies:\n                logger.info(\n                    \"DecodeStepLatency(ms) Mean: %.2f Median: %.2f \"\n                    \"(batch-step domain, %d samples)\",\n                    np.mean(decode_step_latencies),\n                    np.median(decode_step_latencies),\n                    len(decode_step_latencies))\n            print(f\"### BATCH {batch} ###\")\n            if ttfts:\n                print(f\"TTFT  Median: {np.median(ttfts):.2f}  \"\n                      f\"P90: {np.percentile(ttfts, 90):.2f}  \"\n                      f\"P95: {np.percentile(ttfts, 95):.2f}  \"\n                      f\"P99: {np.percentile(ttfts, 99):.2f}\")\n            else:\n                print(\"TTFT  (no data)\")\n            if tpots:\n                print(f\"TPOT  Mean: {np.mean(tpots):.2f}  \"\n                      f\"Median: {np.median(tpots):.2f}  \"\n                      f\"P90: {np.percentile(tpots, 90):.2f}  \"\n                      f\"P95: {np.percentile(tpots, 95):.2f}  \"\n                      f\"P99: {np.percentile(tpots, 99):.2f}\")\n            else:\n                print(\"TPOT  (no data)\")\n            print(\"##########\")\n            # Per-phase breakdown for this batch: averaged over the steps\n            # accumulated in calc_times (the per-step console line is\n            # suppressed there).  Decode drops the same warmup steps as TPOT\n            # so the two are comparable; prefill has no warmup to drop.\n            if args.time_breakdown:\n                def _avg_breakdown(raw, drop_warmup):\n                    brks = list(raw)\n                    if drop_warmup and args.warmup > 0 and len(brks) > args.warmup:\n                        brks = brks[args.warmup:]\n                    return brks\n\n                def _log_breakdown(prefix, raw, drop_warmup):\n                    brks = _avg_breakdown(raw, drop_warmup)\n                    if not brks:\n                        return\n                    n_brk = len(brks)\n                    metric_keys = (\n                        \"gpu_fwd_ms\", \"compute_ms\", \"dense_compute_ms\",\n                        \"fused_weight_compute_ms\", \"productive_compute_ms\",\n                        \"exec_residual_ms\",\n                        \"wdecomp_ms\", \"kvdecomp_ms\", \"wload_ms\",\n                        \"kvload_ms\", \"stall_ms\", \"exposed_load_ms\",\n                        \"unclassified_ms\", \"compute_markers\",\n                        \"compute_markers_expected\", \"window_clip_count\",\n                        \"window_drop_count\", \"fused_override_markers\",\n                        \"fused_kernel_markers\", \"fused_fallback_markers\",\n                        \"raw_prefill_dense_markers\")\n                    avg = {}\n                    for key in metric_keys:\n                        values = [b.get(key) for b in brks]\n                        avg[key] = (None if any(v is None for v in values)\n                                    else sum(values) / n_brk)\n\n                    def _fmt(value):\n                        return \"NA\" if value is None else f\"{value:.4f}\"\n\n                    logger.info(\n                        \"%s [Breakdown] \"\n                        \"GPUFwd: %s | Compute: %s WDecomp: %s \"\n                        \"KVDecomp: %s WLoad: %s KVLoad: %s Stall: %s \"\n                        \"DenseCompute: %s FusedWeightCompute: %s \"\n                        \"ProductiveCompute: %s ExecResidual: %s \"\n                        \"ExposedLoad: %s Unclassified: %s \"\n                        \"ComputeMarkers: %.1f/%.1f WindowClip: %.1f \"\n                        \"WindowDrop: %.1f FusedRoutes: %.1f/%.1f/%.1f \"\n                        \"RawPrefillDense: %.1f Instrumented: 1\",\n                        prefix, _fmt(avg[\"gpu_fwd_ms\"]),\n                        _fmt(avg[\"compute_ms\"]), _fmt(avg[\"wdecomp_ms\"]),\n                        _fmt(avg[\"kvdecomp_ms\"]), _fmt(avg[\"wload_ms\"]),\n                        _fmt(avg[\"kvload_ms\"]), _fmt(avg[\"stall_ms\"]),\n                        _fmt(avg[\"dense_compute_ms\"]),\n                        _fmt(avg[\"fused_weight_compute_ms\"]),\n                        _fmt(avg[\"productive_compute_ms\"]),\n                        _fmt(avg[\"exec_residual_ms\"]),\n                        _fmt(avg[\"exposed_load_ms\"]),\n                        _fmt(avg[\"unclassified_ms\"]),\n                        avg[\"compute_markers\"],\n                        avg[\"compute_markers_expected\"],\n                        avg[\"window_clip_count\"],\n                        avg[\"window_drop_count\"],\n                        avg[\"fused_kernel_markers\"],\n                        avg[\"fused_fallback_markers\"],\n                        avg[\"fused_override_markers\"],\n                        avg[\"raw_prefill_dense_markers\"])\n                    # Live decode-only breakdown CSV beside the log (space-\n                    # separated, like the TTFT/TPOT CSV). Multi-config runs\n                    # get one file per config. Under --time-breakdown H2D is\n                    # serialised, so wload+kvload is the engine-busy total.\n                    if prefix == \"D\":\n                        bd_path = os.path.join(folder_path, breakdown_name)\n                        _hdr = not os.path.exists(bd_path)\n                        with open(bd_path, \"a\") as _bf:\n                            if _hdr:\n                                _bf.write(\n                                    \"batch gpu_fwd compute dense_compute \"\n                                    \"fused_weight_compute productive_compute \"\n                                    \"exec_residual \"\n                                    \"wdecomp kvdecomp wload kvload stall \"\n                                    \"exposed_load unclassified compute_markers \"\n                                    \"compute_markers_expected window_clip_count \"\n                                    \"window_drop_count fused_kernel_markers \"\n                                    \"fused_fallback_markers \"\n                                    \"fused_override_markers \"\n                                    \"raw_prefill_dense_markers instrumented\\n\")\n                            _bf.write(\n                                f\"{batch} {_fmt(avg['gpu_fwd_ms'])} \"\n                                f\"{_fmt(avg['compute_ms'])} \"\n                                f\"{_fmt(avg['dense_compute_ms'])} \"\n                                f\"{_fmt(avg['fused_weight_compute_ms'])} \"\n                                f\"{_fmt(avg['productive_compute_ms'])} \"\n                                f\"{_fmt(avg['exec_residual_ms'])} \"\n                                f\"{_fmt(avg['wdecomp_ms'])} \"\n                                f\"{_fmt(avg['kvdecomp_ms'])} \"\n                                f\"{_fmt(avg['wload_ms'])} \"\n                                f\"{_fmt(avg['kvload_ms'])} \"\n                                f\"{_fmt(avg['stall_ms'])} \"\n                                f\"{_fmt(avg['exposed_load_ms'])} \"\n                                f\"{_fmt(avg['unclassified_ms'])} \"\n                                f\"{avg['compute_markers']:.1f} \"\n                                f\"{avg['compute_markers_expected']:.1f} \"\n                                f\"{avg['window_clip_count']:.1f} \"\n                                f\"{avg['window_drop_count']:.1f} \"\n                                f\"{avg['fused_kernel_markers']:.1f} \"\n                                f\"{avg['fused_fallback_markers']:.1f} \"\n                                f\"{avg['fused_override_markers']:.1f} \"\n                                f\"{avg['raw_prefill_dense_markers']:.1f} 1\\n\")\n\n                _log_breakdown(\"P\", DualMemoryLoader.prefill_breakdowns, False)\n                _log_breakdown(\"D\", DualMemoryLoader.decode_breakdowns, True)\n\n                # Decode-only per-component stall / load, batch-averaged.\n                dbrks = [b for b in _avg_breakdown(\n                    DualMemoryLoader.decode_breakdowns, True)\n                    if \"comp_stall\" in b]\n                if dbrks:\n                    n_d = len(dbrks)\n                    cs = [sum(b[\"comp_stall\"][i] for b in dbrks) / n_d\n                          for i in range(4)]\n                    attn = sum(b[\"attn_barrier_wait\"] for b in dbrks) / n_d\n                    wstall = sum(b[\"weight_stall\"] for b in dbrks) / n_d\n                    stall_values = [b.get(\"stall_ms\") for b in dbrks]\n                    pipeline_stall = (\n                        float(\"nan\")\n                        if any(v is None for v in stall_values)\n                        else sum(stall_values) / n_d)\n                    cl = [sum(b[\"comp_load\"][i] for b in dbrks) / n_d\n                          for i in range(4)]\n                    kvl = sum(b[\"kv_load_ms\"] for b in dbrks) / n_d\n                    logger.info(\n                        \"  BarrierWait(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                        \"down=%.2f attn=%.2f | weight=%.2f direct=%.2f \"\n                        \"pipeline_stall=%.2f\",\n                        cs[0], cs[1], cs[2], cs[3], attn, wstall,\n                        wstall + attn, pipeline_stall)\n                    logger.info(\n                        \"  ComponentLoad(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                        \"down=%.2f kv=%.2f | total=%.2f  \"\n                        \"(copy-engine; bottleneck=slowest)\",\n                        cl[0], cl[1], cl[2], cl[3], kvl, sum(cl) + kvl)\n                    if any(\"kv_cpu_join_ms\" in b for b in dbrks):\n                        join_ms = sum(\n                            b.get(\"kv_cpu_join_ms\", 0.0) for b in dbrks) / n_d\n                        wait_ms = sum(\n                            b.get(\"kv_cpu_worker_wait_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        publish_ms = sum(\n                            b.get(\"kv_cpu_publish_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        calls = sum(\n                            b.get(\"kv_cpu_join_calls\", 0)\n                            for b in dbrks) / n_d\n                        blocks = sum(\n                            b.get(\"kv_cpu_join_blocks\", 0)\n                            for b in dbrks) / n_d\n                        max_ms = sum(\n                            b.get(\"kv_cpu_join_max_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        logger.info(\n                            \"  KVCPUJoin(ms) total=%.3f worker_wait=%.3f \"\n                            \"publish=%.3f max_layer=%.3f calls=%.1f \"\n                            \"blocks=%.1f\",\n                            join_ms, wait_ms, publish_ms, max_ms, calls,\n                            blocks)\n                        fast_commit_ms = sum(\n                            b.get(\"kv_cpu_fast_commit_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        fast_finalize_ms = sum(\n                            b.get(\"kv_cpu_fast_finalize_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        legacy_get_ms = sum(\n                            b.get(\"kv_cpu_legacy_get_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        legacy_finalize_ms = sum(\n                            b.get(\"kv_cpu_legacy_finalize_ms\", 0.0)\n                            for b in dbrks) / n_d\n                        fast_candidates = sum(\n                            b.get(\"kv_cpu_fast_candidates\", 0)\n                            for b in dbrks) / n_d\n                        fast_hits = sum(\n                            b.get(\"kv_cpu_fast_hits\", 0)\n                            for b in dbrks) / n_d\n                        fast_fallbacks = sum(\n                            b.get(\"kv_cpu_fast_fallbacks\", 0)\n                            for b in dbrks) / n_d\n                        raw_blocks = sum(\n                            b.get(\"kv_cpu_raw_blocks\", 0)\n                            for b in dbrks) / n_d\n                        logger.info(\n                            \"  KVCPUJoinDetail(ms) commit=%.3f fast_finalize=%.3f \"\n                            \"legacy_get=%.3f legacy_finalize=%.3f | \"\n                            \"candidate=%.1f hit=%.1f fallback=%.1f raw=%.1f\",\n                            fast_commit_ms, fast_finalize_ms, legacy_get_ms,\n                            legacy_finalize_ms, fast_candidates, fast_hits,\n                            fast_fallbacks, raw_blocks)\n            if ttfts and tpots:\n                csv_file.write(f\"{batch} {np.percentile(ttfts, 50):.4f} {np.percentile(ttfts, 90):.4f} \"\n                               f\"{np.percentile(ttfts, 95):.4f} {np.percentile(ttfts, 99):.4f} \"\n                               f\"{np.percentile(tpots, 50):.4f} {np.percentile(tpots, 90):.4f} \"\n                               f\"{np.percentile(tpots, 95):.4f} {np.percentile(tpots, 99):.4f}\\n\")\n            else:\n                csv_file.write(f\"{batch} NA NA NA NA NA NA NA NA\\n\")\n            csv_file.flush()\n        csv_file.close()\n        logger.info(f\"CSV saved: {csv_path}\")\n\n    run_batches(\n        model_id,\n        args.ts_configs[0],\n        artifact_key=config_artifact_keys[0],\n    )\n\n    for cfg_path, artifact_key in zip(\n        args.ts_configs[1:], config_artifact_keys[1:]\n    ):\n        logger.info(f\"### Reconfiguring: {cfg_path}\")\n        engine.collective_rpc(\"ts_reconfigure\", args=(cfg_path,))\n\n        # CUDA graphs bake in GPU memory addresses at capture time.\n        # After reconfiguration, module parameters point to different buffers,\n        # so old graphs must be disc