{"timestamp":"2026-09-08T06:56:09.769Z","ordinal":498,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07fcd-8229-7f93-a6c6-d2c74bb7b38c","call_id":"call_CHBWGyzilaB3mT9sM9PKaUrE","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"import os\nfrom time import perf_counter_ns\n\nfrom tiered_serve.dual_memory_loader import DualMemoryLoader\n\n\n_kv_free_profile_enabled = False\n_kv_free_profile_records = []\n\n\ndef reset_kv_free_profile(*, enabled: bool) -> None:\n    \"\"\"Reset request-free timing and enable it for one benchmark batch.\n\n    The offline benchmark runs EngineCore in-process, so the scheduler callback\n    and benchmark driver share this module state.  Keeping the profiler here\n    avoids adding diagnostic state to the serving/runtime data model.\n    \"\"\"\n    global _kv_free_profile_enabled\n    _kv_free_profile_enabled = bool(enabled)\n    _kv_free_profile_records.clear()\n\n\ndef kv_free_profile_checkpoint() -> int:\n    \"\"\"Return a cursor that can be used to read records from one engine step.\"\"\"\n    return len(_kv_free_profile_records)\n\n\ndef kv_free_profile_records_since(checkpoint: int):\n    \"\"\"Return immutable request-free records appended after *checkpoint*.\"\"\"\n    if checkpoint < 0 or checkpoint > len(_kv_free_profile_records):\n        raise ValueError(f\"invalid KV-free profile checkpoint: {checkpoint}\")\n    return tuple(_kv_free_profile_records[checkpoint:])\n\n\ndef _should_zero_kv_on_alloc() -> bool:\n    value = os.getenv(\"TIERED_SERVE_ZERO_KV_ON_ALLOC\")\n    if value is not None:\n        return value == \"1\"\n    return getattr(DualMemoryLoader, \"use_kv_comp\", False)\n\n\ndef _contiguous_ranges(block_ids):\n    if not block_ids:\n        return []\n\n    sorted_block_ids = sorted(set(block_ids))\n    ranges = []\n    start = sorted_block_ids[0]\n    end = start + 1\n    for block_id in sorted_block_ids[1:]:\n        if block_id == end:\n            end += 1\n        else:\n            ranges.append((start, end))\n            start = block_id\n            end = block_id + 1\n    ranges.append((start, end))\n    return ranges\n\n\ndef _zero_allocated_offloadable_blocks(blocks):\n    if not _should_zero_kv_on_alloc():\n        return\n    if DualMemoryLoader.num_dedicated_blocks is None:\n        return\n\n    local_block_ids = []\n    for block in blocks:\n        if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n            local_block_ids.append(block.block_id -\n                                   DualMemoryLoader.num_dedicated_blocks)\n    if not local_block_ids:\n        return\n\n    seen_primary_ptrs = set()\n    for kv_cache in DualMemoryLoader.kv_caches:\n        primary_kv = kv_cache.primary_kv\n        if primary_kv is None:\n            continue\n        primary_ptr = primary_kv.data_ptr()\n        if primary_ptr in seen_primary_ptrs:\n            continue\n        seen_primary_ptrs.add(primary_ptr)\n        num_primary_blocks = primary_kv.shape[1]\n        valid_block_ids = [\n            block_id for block_id in local_block_ids\n            if block_id < num_primary_blocks\n        ]\n        for start, end in _contiguous_ranges(valid_block_ids):\n            primary_kv[:, start:end].zero_()\n\n\ndef on_blocks_allocated_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_allocated.\n    Note: unload_target tracking is handled by on_tail_block in core.py,\n    which covers both fresh blocks and existing tail blocks.\"\"\"\n    _zero_allocated_offloadable_blocks(blocks)\n\n\ndef on_blocks_freed_v1(blocks):\n    \"\"\"Callback for v1 BlockPool.on_blocks_freed.\n    Handles KV compression cleanup for freed blocks.\"\"\"\n    use_kv_comp = DualMemoryLoader.use_kv_comp\n\n    # Preserve the canonical path exactly when diagnostics are disabled: no\n    # clock reads, counters, allocations, or additional per-block branches.\n    if not _kv_free_profile_enabled:\n        if not use_kv_comp:\n            return\n        for block in blocks:\n            if block.block_id >= DualMemoryLoader.num_dedicated_blocks:\n                DualMemoryLoader.free_slot(\n                    block.block_id - DualMemoryLoader.num_dedicated_blocks\n                )\n        return\n\n    started_ns = perf_counter_ns()\n    offload_blocks = 0\n    final_ref_offload_blocks = 0\n    slot_manager_ns = 0\n    stream_sync_ns = 0\n    compressor_ns = 0\n\n    if use_kv_comp:\n        for block in blocks:\n            if block.block_id < DualMemoryLoader.num_dedicated_blocks:\n                continue\n            offload_blocks += 1\n            # BlockPool invokes this callback before decrementing ref_cnt.  Do\n            # not change the existing cleanup semantics during diagnosis; the\n            # count verifies the prefix-caching-off experiment assumption.\n            if block.ref_cnt <= 1:\n                final_ref_offload_blocks += 1\n            phase_ns = DualMemoryLoader.free_slot(\n                block.block_id - DualMemoryLoader.num_dedicated_blocks,\n                collect_timing=True,\n            )\n            slot_manager_ns += phase_ns[0]\n            stream_sync_ns += phase_ns[1]\n            compressor_ns += phase_ns[2]\n\n    elapsed_ns = perf_counter_ns() - started_ns\n    _kv_free_profile_records.append({\n        \"started_ns\": started_ns,\n        \"elapsed_ns\": elapsed_ns,\n        \"input_blocks\": len(blocks),\n        \"offload_blocks\": offload_blocks,\n        \"final_ref_offload_blocks\": final_ref_offload_blocks,\n        \"slot_manager_ns\": slot_manager_ns,\n        \"stream_sync_ns\": stream_sync_ns,\n        \"compressor_ns\": compressor_ns,\n        \"kv_comp_enabled\": bool(use_kv_comp),\n    })\nimport torch\nfrom tiered_serve.dual_memory_loader.base import *  # noqa: F401,F403\n\nimport time as _time\n\n\n_ENV_KV_DRAIN_OFFLOAD = os.getenv(\"TIERED_SERVE_KV_DRAIN_OFFLOAD\", \"0\")\n_ENV_KV_CPU_PROFILE = os.getenv(\"TIERED_SERVE_KV_CPU_PROFILE\", \"0\") == \"1\"\n_ENV_KV_DETAILED_NVTX = (\n    os.getenv(\"TIERED_SERVE_KV_DETAILED_NVTX\", \"0\") == \"1\")\n\nclass KVMixin:\n\n    @classmethod\n    def record_tail_write(cls, write) -> None:\n        \"\"\"Record one canonical scheduler block occupancy transition.\n\n        EngineCore calls this before the worker prepares its input table.  The\n        feature-disabled path is an intentional no-op so the legacy unload\n        callback can share the same metadata contract.\n        \"\"\"\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is None:\n            raise RuntimeError(\n                \"full-block KV write arrived before tail residency setup\")\n        manager.record_write(\n            request_id=write.request_id,\n            block_id=write.block_id,\n            block_index=write.block_index,\n            pre_valid=write.pre_valid,\n            post_valid=write.post_valid,\n            block_size=write.block_size,\n        )\n\n    @classmethod\n    def free_tail_block(cls, block_id: int) -> None:\n        if not getattr(cls, \"kv_full_block_only\", False):\n            return\n        manager = getattr(cls, \"tail_manager\", None)\n        if manager is not None:\n            manager.free_block(block_id)\n\n    def configure_tail_residency(\n        self,\n        canonical_dedicated: int,\n        tail_slots: int,\n        physical_buffer_offset: int,\n    ) -> None:\n        \"\"\"Install the fixed request-tail pool after KV tensors are allocated.\"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        if tail_slots != self.batch_size:\n            raise RuntimeError(\n                \"tail_slots must equal max_num_reqs: \"\n                f\"slots={tail_slots}, max_num_reqs={self.batch_size}\")\n        if physical_buffer_offset != canonical_dedicated + tail_slots:\n            raise RuntimeError(\n                \"invalid tail physical namespace: \"\n                f\"offset={physical_buffer_offset}, D={canonical_dedicated}, \"\n                f\"S={tail_slots}\")\n        from tiered_serve.kv_tail_residency import KVTailResidencyManager\n\n        manager = KVTailResidencyManager(\n            max_num_reqs=tail_slots, block_size=16)\n        DualMemoryLoader.tail_manager = manager\n        self.tail_manager = manager\n        self.num_tail_slots = int(tail_slots)\n        self.kv_physical_block_offset = int(physical_buffer_offset)\n        self.tail_step_plan = None\n        self.tail_rollover_local_ids = []\n        self.tail_rollover_slots = []\n        self.tail_resident_local_ids = []\n        self.tail_completed_local_ids = []\n        self.tail_lp_skip_local_ids = []\n        self._tail_steps = 0\n        self._tail_resident_block_steps = 0\n        self._tail_completed_full_blocks = 0\n        self._tail_rollover_blocks = 0\n        self._tail_rollover_d2d_l0_blocks = 0\n        self._tail_verified_full_unload_blocks = 0\n        self._tail_partial_d2h_blocks = 0\n        self._tail_logged_first_rollover_plan = False\n        self._tail_logged_first_rollover_d2d = False\n        self._tail_logged_first_rollover_unload = False\n        logger.info(\n            \"[kv-full-block] tail residency configured: max_num_reqs=%d \"\n            \"D=%d S=%d physical_buffer_offset=%d\",\n            self.batch_size, canonical_dedicated, tail_slots,\n            physical_buffer_offset)\n\n    def prepare_tail_step(self, input_batch) -> None:\n        \"\"\"Apply this step's resident routes to the worker CPU block table.\n\n        The table permanently stores physical ids. New canonical offloadable\n        ids are shifted by BlockTable.append_row(); here we only patch the\n        current request tail to D+slot and restore a completing block to its\n        normal shared-buffer route b+S.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return\n        manager = self.tail_manager\n        plan = manager.snapshot_plan()\n        self.tail_step_plan = plan\n\n        table = input_batch.block_table[0]\n        table_np = table.block_table.np\n        d = int(self.num_dedicated_blocks)\n        s = int(self.num_tail_slots)\n        from tiered_serve.kv_tail_residency import (\n            apply_plan_to_physical_block_table,\n            lp_load_skip_local_ids,\n        )\n        apply_plan_to_physical_block_table(\n            plan,\n            table_np,\n            input_batch.req_id_to_index,\n            canonical_dedicated=d,\n            tail_slots=s,\n        )\n\n        # Canonical offload ids become primary/secondary-local by subtracting\n        # D. Rollover source rows are physical tail rows D+slot.\n        self.tail_rollover_local_ids = [\n            rollover.old_block_id - d for rollover in plan.rollovers\n        ]\n        self.tail_rollover_slots = [\n            rollover.slot for rollover in plan.rollovers\n        ]\n        self.tail_resident_local_ids = sorted(\n            block_id - d for block_id in plan.resident_after)\n        self.tail_completed_local_ids = sorted(\n            block_id - d for block_id in plan.completed_full_ids)\n        # Every offloadable block completed by this step is either:\n        #   * a fresh block (pre_valid=0), overwritten in all 16 positions; or\n        #   * a resident rollover, whose prefix is staged tail->shared.\n        # Neither has prior LP data to load. Post-step partials stay in their\n        # request-private tail rows, so they are excluded for the same reason.\n        self.tail_lp_skip_local_ids = list(\n            lp_load_skip_local_ids(plan, d))\n        self._tail_steps += 1\n        self._tail_resident_block_steps += len(plan.resident_after)\n        self._tail_completed_full_blocks += len(plan.completed_full_ids)\n        self._tail_rollover_blocks += len(plan.rollovers)\n        if (\n            plan.rollovers\n            and not self._tail_logged_first_rollover_plan\n        ):\n            self._tail_logged_first_rollover_plan = True\n            logger.info(\n                \"[kv-full-block] first rollover planned: step=%d \"\n                \"rollovers=%d completed=%d resident_after=%d\",\n                self._tail_steps, len(plan.rollovers),\n                len(plan.completed_full_ids), len(plan.resident_after))\n\n    def _stage_tail_rollovers(\n        self,\n        layer_id: int,\n        stream: torch.cuda.Stream,\n    ) -> bool:\n        \"\"\"Copy completing partial prefixes from tail HBM to shared primary.\n\n        The completing block is routed to the normal shared buffer for the\n        current forward, while a new partial (if any) may reuse the same tail\n        slot. Copying the complete row is safe: attention overwrites every\n        position from pre_valid through token 16 before the block is unloaded.\n        \"\"\"\n        if not DualMemoryLoader.kv_full_block_only:\n            return False\n        dst_ids = self.tail_rollover_local_ids\n        if not dst_ids:\n            return False\n\n        _np = DualMemoryLoader.kv_decode_n_parity or 1\n        stream.wait_event(\n            self.kv_unload_done[(layer_id - max(1, _np)) % self.n_layers])\n\n        d = int(self.num_dedicated_blocks)\n        src_ids = [d + slot for slot in self.tail_rollover_slots]\n        from tiered_serve.kv_cache import _get_zipserv\n        _get_zipserv().batch_kv_memcpy_indexed(\n            DualMemoryLoader.primary_k_caches[layer_id],\n            DualMemoryLoader.primary_v_caches[layer_id],\n            DualMemoryLoader.tail_k_caches[layer_id],\n            DualMemoryLoader.tail_v_caches[layer_id],\n            dst_ids,\n            src_ids,\n            stream.cuda_stream,\n        )\n        if layer_id == 0:\n            self._tail_rollover_d2d_l0_blocks += len(dst_ids)\n            if not