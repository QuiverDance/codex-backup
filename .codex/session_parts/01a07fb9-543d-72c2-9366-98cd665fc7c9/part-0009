"\"Return the stream that actually materializes this layer's KV.\n\n        KVCOMP decode may intentionally put compressed-blob H2D on the weight\n        stream. A prefill-bearing batch uses raw secondary KV by default and\n        carries a same-parity unload dependency; keep that dependency on the\n        dedicated raw stream so it cannot stall frozen-weight lookahead.\n\n        Non-KVCOMP keeps the legacy ``load_kv_stream`` selection, including the\n        explicit ``TIERED_SERVE_RAW_KV_ALIAS`` opt-in.\n        \"\"\"\n        if (self._prefill_uses_dedicated_raw_kv_stream()\n                and not self._uses_compressed_kv_load(layer_id)):\n            return self.raw_load_kv_stream\n        return self.load_kv_stream\n\n    @classmethod\n    def free_slot(cls, block_id: int, *, collect_timing: bool = False):\n        n_layers = getattr(cls, \"n_layers\", None)\n        if n_layers is None:\n            return (0, 0, 0) if collect_timing else None\n\n        # Do not put profiler branches or clock reads in the canonical serving\n        # path.  The diagnostic path below intentionally duplicates this short\n        # sequence so breakdown instrumentation has zero hot-path cost when off.\n        if not collect_timing:\n            if hasattr(cls, \"kv_offload_system\"):\n                for layer_id in range(n_layers):\n                    cls.kv_offload_system.free_block(layer_id, block_id)\n            # Clean up persistent compressed KV metadata\n            if (cls.use_kv_comp\n                    and hasattr(cls, '_kv_compressor_ref')\n                    and cls._kv_compressor_ref is not None):\n                kc = cls._kv_compressor_ref\n                # P4Flat and CD3 use free lists and never move or overwrite their\n                # host payload rows on free. Synchronizing all three streams for\n                # every released block only drains the serving pipeline. Legacy\n                # compacting codecs retain the safety barrier.\n                if not getattr(kc, '_kv_free_metadata_only', False):\n                    for _s in (getattr(kc, 'batch_decomp_stream', None),\n                               getattr(kc, 'load_kv_stream', None),\n                               getattr(kc, 'comp_stream', None)):\n                        if _s is not None:\n                            _s.synchronize()\n                for layer_id in range(n_layers):\n                    kc.free_persistent_block(layer_id, block_id)\n            return None\n\n        slot_manager_started_ns = _time.perf_counter_ns()\n        if hasattr(cls, \"kv_offload_system\"):\n            for layer_id in range(n_layers):\n                cls.kv_offload_system.free_block(layer_id, block_id)\n        slot_manager_ns = _time.perf_counter_ns() - slot_manager_started_ns\n\n        stream_sync_ns = 0\n        compressor_ns = 0\n        # Clean up persistent compressed KV metadata\n        if (cls.use_kv_comp\n                and hasattr(cls, '_kv_compressor_ref')\n                and cls._kv_compressor_ref is not None):\n            kc = cls._kv_compressor_ref\n            # P4Flat and CD3 use free lists and never move or overwrite their\n            # host payload rows on free. Synchronizing all three streams for\n            # every released block only drains the serving pipeline. Legacy\n            # compacting codecs retain the safety barrier.\n            if not getattr(kc, '_kv_free_metadata_only', False):\n                stream_sync_started_ns = _time.perf_counter_ns()\n                for _s in (getattr(kc, 'batch_decomp_stream', None),\n                           getattr(kc, 'load_kv_stream', None),\n                           getattr(kc, 'comp_stream', None)):\n                    if _s is not None:\n                        _s.synchronize()\n                stream_sync_ns = (\n                    _time.perf_counter_ns() - stream_sync_started_ns)\n            compressor_started_ns = _time.perf_counter_ns()\n            for layer_id in range(n_layers):\n                kc.free_persistent_block(layer_id, block_id)\n            compressor_ns = _time.perf_counter_ns() - compressor_started_ns\n\n        return slot_manager_ns, stream_sync_ns, compressor_ns\n\n    # @log_sparse(stack_depth=5)\n    def load_kv(self, layer_id: int, force=False, non_blocking=True):\n\n        def get_ptr_tensor(tensor_list):\n            \"\"\"\n            텐서 리스트로부터 각 텐서의 데이터 포인터를 담은 텐서를 생성합니다.\n            \"\"\"\n            return torch.tensor([t.data_ptr() for t in tensor_list],\n                                dtype=torch.int64,\n                                device=tensor_list[0].device)\n\n        if self.is_graph_warming_up:\n            return\n\n        load_kv_stream = self._kv_load_stream_for(layer_id)\n\n        if DualMemoryLoader.use_kv_comp:\n            kv_sys = DualMemoryLoader.kv_offload_system\n\n            # Legacy prefill route: raw secondary KV. The benchmark's opt-in\n            # compressed-prefill mode falls through to the persistent decode\n            # branch below and filters fresh prompt blocks by validity.\n            if (\n                self.batch_has_prefill\n                and not self.kv_comp_prefill_load\n            ):\n                # 1. Waits for previous KV unloading complete\n\n                # 2. Load from Uncomped KV\n                # torch.cuda.nvtx.mark(\n                #     f\"BEGIN load_kv().load_uncompressed() Prefill LayerID: {layer_id} n_buffer_ids: {len(self.np_active_kv_buffer_ids)}\"\n                # )\n                self.begin_memcpy_kv_events[layer_id].record(\n                    load_kv_stream)\n                DualMemoryLoader.kv_offload_scheduler.schedule_load_uncompressed(\n                    kv_sys, layer_id, self.active_kv_buffer_ids,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07fc5-c30a-7611-af7a-ae6f55b3e535","create_time":1788850569.769743}}}
