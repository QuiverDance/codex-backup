{"timestamp":"2026-09-08T06:56:45.072Z","ordinal":524,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07fce-0c10-7ed1-a805-f37839cb9f17","call_id":"call_L9F092nwVma5VbTBO8fXfUS0","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"CPU-only checks for phase-specific KV H2D stream routing.\n\nThe production dual-memory-loader package builds CUDA extensions at import\ntime.  These tests extract the small policy methods from their source AST so\nthe routing matrix can be validated without a GPU or extension build.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nfrom pathlib import Path\n\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nKV_SOURCE = REPO_ROOT / \"tiered_serve\" / \"dual_memory_loader\" / \"kv.py\"\nWRAPPER_SOURCE = REPO_ROOT / \"tiered_serve\" / \"v1_cuda_graph_wrapper.py\"\n\n\ndef _class_method(source: Path, class_name: str, method_name: str) -> ast.AST:\n    tree = ast.parse(source.read_text())\n    cls = next(\n        node for node in tree.body\n        if isinstance(node, ast.ClassDef) and node.name == class_name\n    )\n    return next(\n        node for node in cls.body\n        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))\n        and node.name == method_name\n    )\n\n\ndef _policy_class():\n    methods = [\n        _class_method(KV_SOURCE, \"KVMixin\", \"_uses_compressed_kv_load\"),\n        _class_method(\n            KV_SOURCE,\n            \"KVMixin\",\n            \"_prefill_uses_dedicated_raw_kv_stream\",\n        ),\n        _class_method(KV_SOURCE, \"KVMixin\", \"_kv_load_stream_for\"),\n    ]\n    policy = ast.ClassDef(\n        name=\"Policy\",\n        bases=[],\n        keywords=[],\n        body=methods,\n        decorator_list=[],\n    )\n    module = ast.fix_missing_locations(ast.Module(body=[policy], type_ignores=[]))\n\n    class LoaderState:\n        use_kv_comp = True\n\n    namespace = {\