xec = len(self.begin_exec_events)  # n_layers + 1\n            for i in range(n_exec):\n                begin_time = init_event.elapsed_time(\n                    self.begin_exec_events[i])\n                end_time = init_event.elapsed_time(\n                    self.end_exec_events[i])\n                if begin_time >= -0.01 and end_time > begin_time + 0.001:\n                    valid_exec_set.add(i)\n\n            for i in range(self.n_layers):\n                if i not in valid_exec_set:\n                    continue\n                wait_ms = self._v1_kv_wait_begin_events[i].elapsed_time(\n                    self._v1_kv_wait_end_events[i])\n                if wait_ms > 0.001:\n                    attn_barrier_wait += wait_ms\n\n            # ── Per-component stall (the \"where\") ──\n            # Each projection GEMM waits for its own weight at the in-graph\n            # ``wait_frozen_weight`` op (timed by _v1_wwait_*); attention waits\n            # for KV at the _v1_kv_wait op.  ALL of these waits live on\n            # cur_stream and run sequentially, so the per-component sums\n            # partition the step's stall with no double-counting.  Filter by\n            # absolute timestamp (begin inside this step's window) to drop\n            # stale events from frozen/resident layers that did not wait.\n            comp_stall = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_stall_by_layer = {}\n            wwb = getattr(self, \"_v1_wwait_begin_events\", None)\n            wwe = getattr(self, \"_v1_wwait_end_events\", None)\n            if wwb and wwe:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = L * 4 + c\n                        try:\n                            b = init_event.elapsed_time(wwb[j])\n                            e = init_event.elapsed_time(wwe[j])\n                        except RuntimeError:\n                            continue\n                        b = max(0.0, b)\n                        e = min(total_time, e)\n                        if b < total_time and e - b > 0.001:\n                            comp_stall[c] += e - b\n                            comp_stall_by_layer.setdefault(\n                                L, [0.0, 0.0, 0.0, 0.0])[c] = e - b\n            weight_stall = sum(comp_stall)\n\n            # pure exec = exec intervals minus ALL barrier waits inside them\n            # (attention KV wait + per-component in-graph weight waits).\n            exec_time = max(0.0, llm_time - attn_barrier_wait - weight_stall)\n            weight_barrier_wait = max(0.0, total_time - llm_time)\n            total_stall_time = total_time - exec_time\n\n            # Per-component stall breakdown — where cur_stream IDLES (compute\n            # side).  In a load-bound pipeline this lands on whichever barrier\n            # sits at the per-layer load-slot end (usually attn), which is the\n            # OBSERVATION point, not the cause.\n            # Under time_breakdown the per-step line is suppressed; the driver\n            # (offline_offload_kvweight.py) prints one batch-averaged line from\n            # the barrier-wait/comp_load values stashed into decode_breakdowns.\n            if not self.time_breakdown:\n                logger.info(\n                    \"  BarrierWait(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                    \"down=%.2f attn=%.2f | weight=%.2f direct=%.2f\",\n                    comp_stall[0], comp_stall[1], comp_stall[2], comp_stall[3],\n                    attn_barrier_wait, weight_stall,\n                    weight_stall + attn_barrier_wait)\n\n            # ── Per-component LOAD time (the copy-engine critical path) ──\n            # The CAUSE of the stall: in a load-bound pipeline the bottleneck\n            # is the H2D copy engine, and the stall is driven by whichever\n            # component's load takes longest.  Measure per-component H2D\n            # duration (begin→end memcpy), summed over the layers that load\n            # this step.  The largest component IS where the stall lives.\n            comp_load = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\n            comp_to_slot = {\"qkv\": 0, \"o\": 1, \"gate_up\": 2, \"down\": 3}\n            bmw = getattr(self, \"begin_memcpy_weight_events\", None)\n            emw = getattr(self, \"end_memcpy_weight_events\", None)\n            if bmw and emw:\n                for L in range(self.n_layers):\n                    if L not in valid_exec_set:\n                        continue\n                    for c in range(4):\n                        j = 4 * L + c\n                        if j >= len(emw):\n                            continue\n                        try:\n                            b = init_event.elapsed_time(bmw[j])\n                            e = init_event.elapsed_time(emw[j])\n                        except RuntimeError:\n                            continue\n                        b = max(0.0, b)\n                        e = min(total_time, e)\n                        if b < total_time and e - b > 0.001:\n                            comp_load[c] += e - b\n                            comp_load[c] += e - b\n            # Frozen_split compressed-exp / aux H2D is timed through a\n            # per-(layer, tensor_name) cache, not begin_memcpy_weight_events.\n            # WLoad already folds these intervals into the total; mirror that\n            # attribution here so ComponentLoad does not report zero weight\n            # load in frozen_split/fused-mm decode runs.\n            fs_begin = getattr(\n                self, \"_frozen_split_h2d_begin_events_cache\", None)\n            fs_end = getattr(\n                self, \"_frozen_split_h2d_end_timing_events_cache\", None)\n            if fs_begin and fs_end:\n                for k_ev, b_ev in fs_begin.items():\n                    e_ev = fs_end.get(k_ev)\n                    if e_ev is None:\n                        continue\n                    try:\n                        b = init_event.elapsed_time(b_ev)\n                        e = init_event.elapsed_time(e_ev)\n                    except RuntimeError:\n                        continue\n                    b = max(0.0, b)\n                    e = min(total_time, e)\n                    if b >= total_time or e - b <= 0.001:\n                        continue\n                    try:\n                        _layer_id, name = k_ev\n                    except (TypeError, ValueError):\n                        continue\n                    comp = getattr(self, \"tensor_to_component\", {}).get(name)\n                    c = comp_to_slot.get(comp)\n                    if c is not None:\n                        comp_load[c] += e - b\n            # Keep ComponentLoad on the same canonical definition as KVLoad:\n            # compressed KV uses the tight blob-H2D events, while raw KV uses\n            # copy-engine union minus WLoad.  The broad begin/end_memcpy_kv\n            # bracket includes queue waits and badly inflates raw KV here.\n            kv_load_ms = kv_load_time\n            if not self.time_breakdown:\n                logger.info(\n                    \"  ComponentLoad(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                    \"down=%.2f kv=%.2f | total=%.2f  \"\n                    \"(copy-engine; bottleneck=slowest)\",\n                    comp_load[0], comp_load[1], comp_load[2], comp_load[3],\n                    kv_load_ms, sum(comp_load) + kv_load_ms)\n\n            # Per-layer breakdown (DEBUG level)\n            for cur_id in range(min(\n                    self.n_layers,\n                    len(self.begin_exec_events) - 1)):\n                attn_wait = self._v1_kv_wait_begin_events[\n                    cur_id].elapsed_time(\n                        self._v1_kv_wait_end_events[cur_id])\n                wcw = comp_stall_by_layer.get(cur_id)\n                if attn_wait > 0.01 or wcw:\n                    wstr = (\"\" if not wcw else\n                            \" W[qkv=%.2f o=%.2f gu=%.2f dn=%.2f]\" % tuple(wcw))\n                    logger.debug(\n                        f\"  Layer {cur_id}: attn={attn_wait:.2f}ms{wstr}\")\n        else:\n            # Prefill: use overlap-based stall calculation\n            if not use_weight_comp:\n                exec_times = llm_intervals\n                exec_time = llm_time\n            else:\n                exec_times = self._calc_exec_times(llm_intervals,\n                                                   weight_decomp_intervals)\n                exec_time = sum((e - b) for b, e in exec_times)\n\n            weight_barrier_wait = self._calc_stalls(\n                init_event, exec_times, weight_memcpy_times)\n            attn_barrier_wait = self._calc_stalls(\n                init_event, exec_times, kv_memcpy_times)\n            total_stall_time = total_time - exec_time\n\n        prefix = \"P\" if self.batch_has_prefill else \"D\"\n        msg = (f\"{prefix} Total: {total_time:.4f} Exec: {exec_time:.4f} \"\n               f\"Stall: {total_stall_time:.4f} \"\n               f\"(WeightBarrier: {weight_barrier_wait:.4f} \"\n               f\"AttnBarrier: {attn_barrier_wait:.4f})\")\n        if weight_load_time > 0.001:\n            msg += f\" WeightH2D: {weight_load_time:.4f}\"\n        if weight_decomp_time > 0.001:\n            msg += f\" WeightDecomp: {weight_decomp_time:.4f}\"\n        if kv_load_time > 0.001:\n            msg += f\" KVH2D: {kv_load_time:.4f}\"\n        if kv_comp_time > 0.001:\n            msg += f\" KVComp: {kv_comp_time:.4f}\"\n        if kv_decomp_time > 0.001:\n            msg += f\" KVDecomp: {kv_decomp_time:.4f}\"\n        if overlap_time > 0.001:\n            msg += f\" DecompOverlap: {overlap_time:.4f}\"\n        # The legacy \"{P,D} Total: ...\" console line is intentionally not\n        # logged (redundant with the [Breakdown] line below); the full\n        # string is still written to the time-log file and nvtx trace.\n        if self._time_log_file is not None:\n            self._time_log_file.write(msg + \"\\n\")\n            self._time_log_file.flush()\n        torch.cuda.nvtx.mark(msg)\n\n        # ── Per-stream breakdown: LLM / WDecomp / KVDecomp / WLoad /\n        #    KVLoad / Stall ──\n        # Each metric is the wall-clock union of the recorded CUDA\n        # events on that stream (events overlap across streams, so we\n        # de-dupe via _calc_exec_times rather than summing).\n        #\n        # Notes on what this CAN'T see:\n        # 1) frozen_compressed layers don't H2D during decode (the\n        #    compressed bytes already live in HBM).  frozen_split\n        #    layers DO H2D the compressed-exp/aux LPDDR buffers every\n        #    decode step on load_weight_stream; those are captured via\n        #    _frozen_split_h2d_(begin|end_timing)_events_cache below.\n        # 2) When TIERED_SERVE_ATS_DECOMP_FROZEN=1 or\n        #    TIERED_SERVE_ATS_DECOMP_OFFLOAD=1, the H2D copy is fused\n        #    into the decomp kernel (LPDDR is read directly via\n        #    host-mapped UVA), so those H2D bytes don't surface as a\n        #    separate event — they are folded into the WDecomp time\n        #    instead.\n        # 3) GPUFwd here is GPU-forward wall time only (begin_forward\n        #    → end_forward).  Python-loop TPOT additionally includes\n        #    scheduler / sampling / output assembly on CPU.  See the\n        #    [Step] StepLatency log emitted by\n        #    offline_offload_kvweight.py for the perf_counter step time.\n        if self.time_breakdown:\n            # ── Subtract in-graph cur_stream waits from LLM intervals ──\n            # Two distinct barriers block cur_stream INSIDE the\n            # [begin_exec, end_exec] window — during either, cur_stream is\n            # stalled, NOT running GEMM/attention:\n            #   1. KV-barrier wait: the wrapper's `_after_replay` does\n            #      `cur_stream.wait_event(exec_attn_barriers[graph_idx])`\n            #      (see v1_cuda_graph_wrapper.py) before eager attention.\n            #      Timed by `_v1_kv_wait_*`.\n            #   2. In-graph weight-ready wait: the FX-injected\n            #      `wait_frozen_weight` op blocks each projection GEMM until\n            #      its weight H2D/decomp lands (see graph_wait_ops.py).\n            #      Timed per (layer, component) by `_v1_wwait_*`.\n            # Counting either as LLM busy inflates ComputeUnion and hides\n            # stall.  The legacy \"Exec\" line subtracts BOTH (via\n            # attn_barrier_wait + weight_stall), so LLM here must subtract\n            # both too — otherwise the breakdown LLM reads high by the\n            # weight-wait time.  Subtract the union of all wait sub-intervals\n            # so LLM reflects actual compute on cur_stream and the stall calc\n            # treats wait time as compute-idle.\n            wait_intervals: List[Tuple[float, float]] = []\n            for wbe, wee in (\n                    (getattr(self, '_v1_kv_wait_begin_events', None),\n                     getattr(self, '_v1_kv_wait_end_events', None)),\n                    (getattr(self, '_v1_wwait_begin_events', None),\n                     getattr(self, '_v1_wwait_end_events', None))):\n                if not wbe or not wee:\n                    continue\n                wait_intervals.extend(self._calc_intervals(\n                    init_event, wbe, wee, total_time))\n            # KV and weight waits all live on cur_stream and run sequentially,\n            # so they are already non-overlapping — a sort is enough to meet\n            # _subtract_intervals' \"sorted AND non-overlapping\" precondition\n            # (no union-merge needed).  Likewise llm_intervals: the per-kernel\n            # exec intervals don't overlap (single cur_stream), so subtract\n            # directly without unioning first.\n            wait_intervals.sort(key=lambda x: x[0])\n            # Compute = exec minus cur_stream waits; decomp is carved out\n            # further down (once its intervals are built).  llm_brk is\n            # computed there, NOT here.\n            exec_residual_intervals = self._subtract_intervals(\n                llm_intervals, wait_intervals)\n\n            # Frozen weight decomp uses a separate event pair\n            # (begin_frozen_decomp_events /\n            #  end_frozen_decomp_timing_events) keyed by\n            # (comp_key, layer_id), distinct from the sync-only\n            # frozen_decomp_events used for cross-stream waits and from\n            # the per-layer begin/end_decomp_events used by the native\n            # offload path.  The same pool also times fused-override fallback\n            # decompression, including on non-frozen layers.\n            frozen_decomp_intervals = []\n            if (use_weight_comp\n                    and hasattr(self, \"begin_frozen_decomp_events\")\n                    and hasattr(self, \"end_frozen_decomp_timing_events\")):\n                frozen_decomp_begin = []\n                frozen_decomp_end = []\n                for comp_key in (\"qkv\", \"o\", \"gate_up\", \"down\"):\n                    begin_list = self.begin_frozen_decomp_events.get(\n                        comp_key, [])\n                    end_list = self.end_frozen_decomp_timing_events.get(\n                        comp_key, [])\n                    # These pools are also bound to fused overrides on\n                    # offload_compressed (non-frozen) layers.  Such a cell can\n                    # take the runtime decompress+linear fallback and records\n                    # its WDecomp here, not in begin/end_decomp_events.\n                    for layer_id in range(self.n_layers):\n                        if (layer_id >= len(begin_list)\n                                or layer_id >= len(end_list)):\n                            continue\n                        frozen_decomp_begin.append(begin_list[layer_id])\n                        frozen_decomp_end.append(end_list[layer_id])\n                frozen_decomp_intervals = self._calc_intervals(\n                    init_event, frozen_decomp_begin, frozen_decomp_end,\n                                f\"{avg['raw_prefill_dense_markers']:.1f} 1\\n\")\n\n                _log_breakdown(\"P\", DualMemoryLoader.prefill_breakdowns, False)\n                _log_breakdown(\"D\", DualMemoryLoader.decode_breakdowns, True)\n\n                # Decode-only per-component stall / load, batch-averaged.\n                dbrks = [b for b in _avg_breakdown(\n                    DualMemoryLoader.decode_breakdowns, True)\n                    if \"comp_stall\" in b]\n                if dbrks:\n                    n_d = len(dbrks)\n                    cs = [sum(b[\"comp_stall\"][i] for b in dbrks) / n_d\n                          for i in range(4)]\n                    attn = sum(b[\"attn_barrier_wait\"] for b in dbrks) / n_d\n                    wstall = sum(b[\"weight_stall\"] for b in dbrks) / n_d\n                    stall_values = [b.get(\"stall_ms\") for b in dbrks]\n                    pipeline_stall = (\n                        float(\"nan\")\n                        if any(v is None for v in stall_values)\n                        else sum(stall_values) / n_d)\n                    cl = [sum(b[\"comp_load\"][i] for b in dbrks) / n_d\n                          for i in range(4)]\n                    kvl = sum(b[\"kv_load_ms\"] for b in dbrks) / n_d\n                    logger.info(\n                        \"  BarrierWait(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                        \"down=%.2f attn=%.2f | weight=%.2f direct=%.2f \"\n                        \"pipeline_stall=%.2f\",\n                        cs[0], cs[1], cs[2], cs[3], attn, wstall,\n                        wstall + attn, pipeline_stall)\n                    logger.info(\n                        \"  ComponentLoad(ms) qkv=%.2f o=%.2f gate_up=%.2f \"\n                        \"down=%.2f kv=%.2f | total=%.2f  \"\n                        \"(copy-engine; bottleneck=slowest)\",\n                        cl[0], cl[1], cl[2], cl[3], kvl, sum(cl) + kvl)\n                    if any(\"kv_cpu_join_ms\" in b for b in dbrks):\n                        join_ms = sum(\n            {k: False for k in (\"qkv\", \"o\", \"gate_up\", \"down\")}\n            for _ in range(self.n_layers)\n        ]\n\n        # --- Determine which modes are needed across all layers ---\n        any_needs_frozen_comp = False\n        any_needs_frozen_split = False\n        any_needs_offload_comp = False\n        for idx in range(self.n_layers):\n            is_frozen = self.torch_model.decoder_blocks[idx].is_frozen\n            for comp_key in COMP_KEYS:\n                mode = self._effective_mode(\n                    self.layer_weight_comp[idx].get(comp_key, \"offload\"),\n                    is_frozen)\n                if mode == \"frozen_compressed\":\n                    any_needs_frozen_comp = True\n                elif mode == \"frozen_split\":\n                    any_needs_frozen_split = True\n                elif mode == \"offload_compressed\":\n                    any_needs_offload_comp = True\n\n        if (any_needs_frozen_comp or any_needs_frozen_split\n                or any_needs_offload_comp):\n            self._ensure_weight_compressor_lazy()\n\n        # Unified decomp pool: frozen_compressed / frozen_split share the\n        # ``_temp_buffers`` pool with streamed weights via raw-index parity\n        # (idx % n_weight_buffers; FROZEN_DECOMP_PARITY is forced equal to\n        # n_weight_buffers below).  n_weight_buffers=2 (double-buffer) is the\n        # default AND the practical minimum: a piecewise CUDA graph piece spans\n        # two adjacent layers' weights (L(K-1) O+MLP + L(K) QKV), so P>=2 keeps\n        # both alive across graph K's replay.\n        #\n        #