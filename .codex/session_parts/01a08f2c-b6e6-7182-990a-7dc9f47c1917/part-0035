in valid_exec_set:\\n                    continue\\n                wait_ms = self._v1_kv_wait_begin_events[i].elapsed_time(\\n                    self._v1_kv_wait_end_events[i])\\n                if wait_ms > 0.001:\\n                    attn_barrier_wait += wait_ms\\n\\n            # ── Per-component stall (the \\\"where\\\") ──\\n            # Each projection GEMM waits for its own weight at the in-graph\\n            # ``wait_frozen_weight`` op (timed by _v1_wwait_*); attention waits\\n            # for KV at the _v1_kv_wait op.  ALL of these waits live on\\n            # cur_stream and run sequentially, so the per-component sums\\n            # partition the step's stall with no double-counting.  Filter by\\n            # absolute timestamp (begin inside this step's window) to drop\\n            # stale events from frozen/resident layers that did not wait.\\n            comp_stall = [0.0, 0.0, 0.0, 0.0]   # qkv, o, gate_up, down\\n            comp_stall_by_layer = {}\\n            wwb = getattr(self, \\\"_v1_wwait_begin_events\\\", None)\\n            wwe = getattr(self, \\\"_v1_wwait_end_events\\\", None)\\n            if wwb and wwe:\\n                for L in range(self.n_layers):\\n                    if L not in valid_exec_set:\\n                        continue\\n                    for c in range(4):\\n                        j = L * 4 + c\\n                        try:\\n                            b = init_event.elapsed_time(wwb[j])\\n                            e = init_event.elapsed_time(wwe[j])\\n                        except RuntimeError:\\n                            continue\\n                        b = max(0.0, b)\\n                        e = min(total_time, e)\\n                        if b < total_time and e - b > 0.001:\\n                            comp_stall[c] += e - b\\n                            comp_stall_by_layer.setdefault(\\n                                L, [0.0, 0.0, 0.0, 0.0])[c] = e - b\\n            weight_stall = sum(comp_