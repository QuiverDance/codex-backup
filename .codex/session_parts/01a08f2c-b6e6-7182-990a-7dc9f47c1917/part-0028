_release_csr_plan(self, plan: _DecodePlan | None) -> None:\\n        if plan is None:\\n            return\\n        for arena in plan.host_owners:\\n            self._free_csr_host_arenas.setdefault(arena.numel(), []).append(arena)\\n        if plan.h2d_done is not None:\\n            self._free_csr_h2d_events.append(plan.h2d_done)\\n            plan.h2d_done = None\\n        plan.h2d_submitted = False\\n        plan.host_owners.clear()\\n        # Drop aliases before an arena is filled for a new generation.\\n        plan.host_offsets = ()\\n        plan.host_entries = ()\\n        plan.host_word_counts = ()\\n        plan.block_ids_cpu = None\\n        plan.block_ids_tensor = None\\n\\n    def _reclaim_csr_plans(self) -> None:\\n        pending = []\\n        for plan in self._retired_csr_plans:\\n            if plan.h2d_submitted and not plan.h2d_done.query():\\n                pending.append(plan)\\n            else:\\n                self._release_csr_plan(plan)\\n        self._retired_csr_plans = pending\\n\\n    def _retire_decode_plan(self, plan: _DecodePlan | None) -> None:\\n        if plan is None:\\n            return\\n        if not plan.h2d_submitted:\\n            self._release_csr_plan(plan)\\n            return\\n        try:\\n            h2d_done = plan.h2d_done.query()\\n        except Exception:\\n            # A readiness-query failure cannot make request retirement\\n            # partially commit across layers.  Conservatively retain the\\n            # pinned aliases and finish detaching logical ownership; the next\\n            # reclamation/join query will surface a persistent CUDA error.\\n            self._retired_csr_plans.append(plan)\\n            return\\n        if h2d_done:\\n            self._release_csr_plan(plan)\\n        else:\\n            self._retired_csr_plans.append(plan)\\n\\n    def _invalidate_decode_plan(self, layer_id: int) -> None:\\n        self._decode_generation[layer_id] = (\\n            self._decode_generation.get(layer_id, 0) + 1)\\n        self._decode_filtered.pop(layer_id, None)\\n        self._retire_decode_plan(self._decode_plans.pop(layer_id, None))\\n\\n    def prepare_active_set(self, active_block_ids, active_array=None) -> None:\\n        \\\"\\\"\\\"Publish the canonical active set once for the upcoming forward.\\n\\n        ``torch_hooks.before_model_forward`` already materializes a sorted\\n        int64 NumPy array and its corresponding Python list once per step.\\n        Holding both references lets every layer replace an O(N) content\\n        comparison with an identity + integer-version check.  Direct users\\n        that do not call this method continue through the original defensive\\n}\\n\\nvoid prepare_chunk_delta3_kv_decode(\\n    torch::Tensor block_ids,\\n    torch::Tensor slot_table,\\n    torch::Tensor sorted_block_ids_host,\\n    torch::Tensor host_k_body,\\n    torch::Tensor host_v_body,\\n    torch::Tensor host_k_offsets,\\n    torch::Tensor host_v_offsets,\\n    torch::Tensor host_k_entries,\\n    torch::Tensor host_v_entries,\\n    torch::Tensor host_k_word_counts,\\n    torch::Tensor host_v_word_counts,\\n    torch::Tensor gpu_k_body,\\n    torch::Tensor gpu_v_body,\\n    torch::Tensor gpu_k_offsets,\\n    torch::Tensor gpu_v_offsets,\\n    torch::Tensor gpu_block_ids,\\n    torch::Tensor gpu_k_entries,\\n    torch::Tensor gpu_v_entries,\\n    bool offsets_are_compact,\\n    int64_t active_slots,\\n    int64_t stream_handle, py::object profile,\\n    int64_t begin_event, int64_t end_event)\\n{\\n    using Clock = std::chrono::steady_clock;\\n    const bool profiling = !profile.is_none();\\n    const auto started = profiling ? Clock::now() : Clock::time_point{};\\n    TORCH_CHECK(stream_handle != 0, \\\"CUDA stream handle must be nonzero\\\");\\n    TORCH_CHECK(\\n        block_ids.device().is_cpu()\\n            && block_ids.scalar_type() == at::kLong\\n            && block_ids.is_contiguous(),\\n        \\\"block_ids must be contiguous CPU int64\\\");\\n    TORCH_CHECK(\\n        slot_table.device().is_cpu()\\n            && slot_table.scalar_type() == at::kInt\\n            && slot_table.is_contiguous(),\\n        \\\"slot_table must be contiguous CPU int32\\\");\\n    TORCH_CHECK(\\n        sorted_block_ids_host.device().is_cpu()\\n            && sorted_block_ids_host.scalar_type() == at::kLong\\n            && sorted_block_ids_host.is_contiguous()\\n            && sorted_block_ids_host.is_pinned(),\\n        \\\"sorted block-ID staging must be pinned CPU int64\\\");\\n    TORCH_CHECK(active_slots >= 0, \\\"active_slots must be non-negative\\\");\\n\\n    const int64_t n = block_ids.numel();\\n    TORCH_CHECK(\\n        sorted_block_ids_host.numel() >= n,\\n        \\\"sorted block-ID staging is too small\\\");\\n    if (n == 0) {\\n        return;\\n    }\\n\\n    struct Route {\\n        int32_t slot;\\n        int64_t block_id;\\n    };\\n    struct Span {\\n        int64_t dst_row;\\n        int32_t src_slot;\\n        int64_t count;\\n    };\\n    struct Workspace {\\n        std::vector<Route> routes;\\n        std::vector<Route> sort_scratch;\\n        std::vector<Span> spans;\\n        std::vector<void*> destinations;\\n        std::vector<void*> sources;\\n        std::vector<size_t> sizes;\\n        std::vector<size_t> attribute_indices;\\n    };\\n    // These are CPU descriptors, not DMA payloads. CUDA consumes the lists\\n    // during API submission; each submitting thread can reuse its own storage\\n    // after return, including while another thread submits with the GIL released.\\n    thread_local Workspace workspace;\\n    auto& routes = workspace.routes;\\n    routes.resize(static_cast<size_t>(n));\\n    uint32_t max_slot = 0;\\n    const auto* ids = block_ids.data_ptr<int64_t>();\\n    const auto* slots = slot_table.data_ptr<int32_t>();\\n    const int64_t slot_table_size = slot_table.numel();\\n    for (int64_t index = 0; index < n; ++index) {\\n        const int64_t block_id = ids[index];\\n        TORCH_CHECK(\\n            block_id >= 0 && block_id < slot_table_size,\\n            \\\"block ID out of range: \\\", block_id);\\n        const int32_t slot = slots[block_id];\\n        TORCH_CHECK(\\n            slot >= 0 && slot < active_slots,\\n            \\\"missing or invalid CD3 slot for block \\\", block_id,\\n            \\\" (slot=\\\", slot, \\\", active_slots=\\\", active_slots, \\\")\\\");\\n        routes[static_cast<size_t>(index)] = {slot, block_id};\\n        max_slot = std::max(max_slot, static_cast<uint32_t>(slot));\\n    }\\n    const auto sort_started = profiling ? Clock::now() : Clock::time_point{};\\n    const bool ordered = std::is_sorted(\\n        routes.begin(), routes.end(),\\n        [](const Route& lhs, const Route& rhs) { return lhs.slot < rhs.slot; });\\n    if (!ordered) {\\n        // Slots are validated nonnegative int32 keys. Stable byte-wise radix\\n        // sorting is linear in the active count, even when the set changes\\n        // every step. No workload-specific block-count threshold is needed.\\n        auto& scratch = workspace.sort_scratch;\\n        scratch.resize(routes.size());\\n        for (unsigned shift = 0; shift < 32 && (max_slot >> shift); shift += 8) {\\n            size_t positions[256] = {};\\n            for (const auto& route : routes) {\\n                ++positions[(static_cast<uint32_t>(route.slot) >> shift) & 255];\\n            }\\n            size_t offset = 0;\\n            for (auto& position : positions) {\\n                const size_t count = position;\\n                position = offset;\\n                offset += count;\\n            }\\n            for (const auto& route : routes) {\\n                const auto key = (static_cast<uint32_t>(route.slot) >> shift) & 255;\\n                scratch[positions[key]++] = route;\\n            }\\n            routes.swap(scratch);\\n        }\\n    }\\n    const auto sort_done = profiling ? Clock::now() : Clock::time_point{};\\n    auto* sorted_ids = sorted_block_ids_host.data_ptr<int64_t>();\\n    for (int64_t index = 0; index < n; ++index) {\\n        if (index > 0) {\\n            TORCH_CHECK(\\n                routes[static_cast<size_t>(index - 1)].slot\\n                    != routes[static_cast<size_t>(index)].slot,\\n                \\\"duplicate persistent CD3 slot \\\",\\n                routes[static_cast<size_t>(index)].slot);\\n        }\\n        if (sorted_ids != ids || !ordered) {\\n            sorted_ids[index] = routes[static_cast<size_t>(index)].block_id;\\n        }\\n    }\\n\\n    struct RowPool {\\n        char* gpu;\\n        char* host;\\n        size_t bytes_per_row;\\n        int64_t host_rows;\\n    };\\n    std::vector<torch::Tensor> gpu_rows = {gpu_k_body, gpu_v_body};\\n    std::vector<torch::Tensor> host_rows = {host_k_body, host_v_body};\\n    if (!offsets_are_compact) {\\n        gpu_rows.push_back(gpu_k_offsets);\\n        gpu_rows.push_back(gpu_v_offsets);\\n        host_rows.push_back(host_k_offsets);\\n        host_rows.push_back(host_v_offsets);\\n    }\\n    std::vector<RowPool> row_pools;\\n    row_pools.reserve(gpu_rows.size());\\n    for (size_t index = 0; index < gpu_rows.size(); ++index) {\\n        const auto& gpu = gpu_rows[index];\\n        const auto& host = host_rows[index];\\n        TORCH_CHECK(\\n            gpu.is_cuda() && host.device().is_cpu() && host.is_pinned(),\\n            \\\"CD3 row copies must be pinned CPU to CUDA\\\");\\n        TORCH_CHECK(\\n            gpu.dim() >= 1 && host.dim() >= 1\\n                && gpu.scalar_type() == host.scalar_type(),\\n            \\\"incompatible CD3 row tensors\\\");\\n        const size_t gpu_row_bytes =\\n            static_cast<size_t>(gpu.stride(0)) * gpu.element_size();\\n        const size_t host_row_bytes =\\n            static_cast<size_t>(host.stride(0)) * host.element_size();\\n        TORCH_CHECK(\\n            gpu_row_bytes == host_row_bytes,\\n            \\\"CD3 row strides differ\\\");\\n        TORCH_CHECK(gpu.size(0) >= n, \\\"GPU CD3 row staging is too small\\\");\\n        row_pools.push_back({\\n            static_cast<char*>(gpu.data_ptr()),\\n            static_cast<char*>(host.data_ptr()),\\n            host_row_bytes,\\n            host.size(0)});\\n    }\\n\\n    auto& spans = workspace.spans;\\n    spans.clear();\\n    int64_t dst_row = 0;\\n    int32_t src_slot = routes.front().slot;\\n    int64_t count = 1;\\n    for (int64_t index = 1; index < n; ++index) {\\n        if (routes[static_cast<size_t>(index)].slot == src_slot + count) {\\n            ++count;\\n        } else {\\n            spans.push_back({dst_row, src_slot, count});\\n            dst_row = index;\\n            src_slot = routes[static_cast<size_t>(index)].slot;\\n            count = 1;\\n        }\\n    }\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":\"595 release feedback & discussion - Page 19 - Linux - NVIDIA Developer Forums (https://forums.developer.nvidia.com/t/595-release-feedback-discussion/362561?page=19)\\nciteturn4search0 [wordlim: 200] Published: 4 months ago; Crawled: 4 months ago;   * Indiana Jones and the Great Circle - HDR mode is reported as “not supported by hardware” since 595.45.04 BETA. ...     Segmentation fault         (core dumped) vkcube --gpu_number 1 --wsi xcb\\nNVIDIA Developer Forums\\n\\n# 595 release feedback & discussion\\n\\nGraphics / Linux Linux\\n\\nechoa April 28, 2026, 4:46pm 372\\n\\nThey have a habit of not listing a large number of changes or fixes so likely not and we will have to test.\\n\\nwierzbiniak95 April 28, 2026, 6:48pm 373\\n\\nUpdate on driver 595.71.05 to my previous bug report:\\n\\n  * The Witcher 3: Wild Hunt still crashes - the issue appears to be triggered by enable Ray Tracing since the 590.44.01 branch.\\n  * Indiana Jones and the Great Circle - HDR mode is reported as “not supported by hardware” since 595.45.04 BETA.\\n\\nRTX 5080, Ryzen 9800X3D, Fedora 44, Proton Experimental.\\n\\nNothing changed.\\n\\nechoa April 28, 2026, 7:25pm 374\\n\\nForever Winter still freezes when drones are shot when running the 595 driver. Looks like the XID109 errors are going to continue for some time yet on UE5 games.\\n\\nBlueGoliath April 28, 2026, 10:02pm 375\\n\\nList of issues that still affect the 595 driver:\\n\\n  * Random black screens when playing intensive games, sometimes resulting in a partial GPU driver crash. It is sometimes possible to switch to a TTY, but attempting to switch back to a graphical session will crash the driver for good.\\n  * Desktop memory usage is excessively high(over 2GB sometimes).\\n  * A large amount of GPU Memory is unaccounted for in `nvidia-smi` / NVML.\\n  * Applications crash when VRAM is full(maybe fixed?).\\n  * Shared RAM under Linux seems broken. It’s almost like there is an incredibly small amount(256MB) and once that’s gone things start crashing.\\n  * DLSS3 / DLSS4 / Smooth Motion is broken. It causes massive input lag and micro stuttering.\\n  * Gnome-shell / GDM can freeze on login from a fresh boot. Switching to a TTY and relogging in works around this.\\n  * Ray Tracing is broken on a lot of games, resulting in an XID 109 or some other error.\\n  * Some games show DLSS upscaling options but no frame generation(Portal 2: RTX). Maybe a Proton issue?\\n  * Dragging the HDR slider under Gnome can cause a driver crash(maybe fixed?).\\n  * DX12 games have a massive performance penalty.\\n  * VRR causes backlight strobing/flickering.\\n  * Shader cache doesn’t save properly, forcing it to be computing again.\\n  * Video decoding from a GTX 960 using Sunshine/Moonlight causes blocky artifacts.\\n  * HDR is broken.\\n  * Performance limiters are broken on Blackwell.\\n  * PRAGMATA and other games have graphical glitches(maybe fixed?).\\n  * Using a secondary dedicated GPU often fails with `[drm:__nv_drm_gem_nvkms_prime_dup [nvidia_drm]] *ERROR* [nvidia-drm] [GPU ID 0x00000c00] Failed to import NVKMS memory to GEM object` . This error can happen regardless of whether you use `dxvk.deviceFilter` or in-game display adapter settings. Other times games start but run at 5 FPS.\\n  * Display sometimes fails to wakeup from sleep unless switched to TTY.\\n\\nEdit: flagged by trolls.\\n\\nWagnerFS April 29, 2026, 2:09am 376\\n\\nI had a run on the new driver coming from 590.48.1 to latest (595.58.03) exclusively for Death Stranding 2 as the new driver fixed a couple bugs for that game.\\n\\nOn the other hand, I started getting lower performances, which I didn’t come to report though, but mainly this one when I was playing Sonic Frontiers (like the LODs were flipped):\\n\\nkodatarule April 29, 2026, 7:48am 377\\n\\nA little update on the sharpness setting - I have now tried multiple live usb(endeavouros/cachyos/zorin) and in all it doesn’t work.\\nNvidia driver on endeavour/cachy was 590 - it takes the value doesn’t prompt error no visual change\\nnvidia driver on zorin was 580 - it takes the value doesn’t prompt error still no visual change and this is under x11 at that.\\n\\nnvidia driver 595 on my install on two different devices desktop and laptop - still no error or issue with environment variable but again no visual change.\\n\\nXpander April 29, 2026, 8:22am 379\\n\\n__GL_SHARPEN_ENABLE=1 works without issue here on MATE (x11) with the 595.58.03 drivers and RTX 3080. Arch Linux with cachyos 7.0 kernel.\\ntested with games running vkd3d-proton with proton experimental, as well as glxgears and vkcube.\\n\\ngame called Witchfire as an example\\n\\nwithout sharpening:\\n\\nR2Nw3CK2560×1440 347 KB\\n\\nwith __GL_SHARPEN_ENABLE=1\\n\\nb9uF5712560×1440 443 KB\\n\\nkodatarule April 29, 2026, 9:06am 380\\n\\nIt appears to be working first image is CS2 at 4K with FSR Ultra quality no sharpness:\\n\\nFSRultraquality1920×1080 560 KB\\n\\nThe second is with `__GL_SHARPEN_ENABLE=1 __GL_SHARPEN_VALUE=50 __GL_SHARPEN_IGNORE_FILM_GRAIN=30 %command%`\\n\\nthelatestenv1920×1080 597 KB\\n\\nBlackEye April 29, 2026, 9:07pm 381\\n\\nYou’ve posted this list multiple times now. Has anything changed, or are you engaging with any of the responses you’ve gotten?\\nA list without context is very unhelpful.\\nIt would be nice, if you could at least link to topics related to the issues that you listed.\\n\\ndylan51 April 30, 2026, 2:13am 382\\n\\nImage SyberHexen:\\n\\n> `NVRM: Xid (PCI:0000:01:00): 109, pid=19030, name=GameThread, channel 0x00000005, errorString CTX SWITCH TIMEOUT`\\n\\nWas having this error reliably in Elden Ring but it appears entirely resolved with default proton, max settings and max raytracing in new driver version 595.71.05\\n\\nv19930312 April 30, 2026, 11:03am 383\\n\\nI think I’ve reported this one a while ago but received no answer and it’s still a problem on 595.71.05, so here it is again: applications fail to start on the iGPU when running in dGPU MUX mode. For example:\\n    \\n    `> vkcube --gpu_number 1\\n    Selected WSI platform: wayland\\n    Selected GPU 1: AMD Radeon 680M (RADV REMBRANDT), type: IntegratedGpu\\n    [destroyed object]: error 7: importing the supplied dmabufs failed\\n    (hangs without anything opening)\\n    \\n    > vkcube --gpu_number 1 --wsi xcb\\n    Selected GPU 1: AMD Radeon 680M (RADV REMBRANDT), type: IntegratedGpu\\n    Segmentation fault         (core dumped) vkcube --gpu_number 1 --wsi xcb\\n    `\\n\\nnvidia-bug-report.log.gz (897.7 KB)\\n\\nthesourcehim April 30, 2026, 11:13am 384\\n\\nSpecific to AMD iGPU? Just tested on Intel, works fine.\\n\\nv19930312 April 30, 2026, 11:23am 385\\n\\nCould be - I don’t have a laptop with an intel iGPU/nvidia dGPU combo to test myself. Please note the “dGPU MUX mode” part - everything is okay when I’m using the iGPU as the primary GPU (aka the typical PRIME setup), but the issue arises when the dGPU is set as the primary one.\\n\\nxliedxfunx April 30, 2026, 12:01pm 386\\n\\n595.71.05 Ray Tracing option causing Wuthering Waves freeze/crash at 80% loading.\\nIt’s not the new driver’s fault since I have the same issue with my laptop by using the 595.58.03 driver.\\nSo something is maybe broken in the v3.3 patch of the game for the linux users. (I’m using cachyos but it happens on other distros as well)\\n\\nWhen disabling raytracing manually in the INI file\\nEngine.ini localized in the\\n/home/<username>/.local/share/Steam/steamapps/common/Wuthering Waves/Client/Saved/Config/WindowsNoEditor/\\nby changing the r.RayTracing.LoadConfig value from 1 to 0, the game can run :\\n    \\n    `[/Script/Engine.RendererSettings]\\n    r.RayTracing.LoadConfig=0\\n    `\\n\\nluke2135 April 30, 2026, 5:43pm 387\\n\\nJust wanted to leave a feedback that 595 driver made Starfield unplayable on Linux Mint. I can start the game, I can walk up to a Ship Technician NPC and talk to him but when I try to enter ship builder the game freezes. It worked fine with driver 590.\\n\\nwierzbiniak95 April 30, 2026, 7:13pm 388\\n\\nIt looks like version 595.71.05 introduces two new regressions that don’t occur in earlier versions.\\n\\nImage\\n\\nGraphical corruption after suspend/resume with NVIDIA Xid 13 (595.71.05) Linux\\n\\n> After resuming from S3 suspend on Fedora 44 KDE Plasma 6.6.4 Wayland, the desktop starts showing severe graphical corruption nvidia-bug-report: Apr 30 17:47:20 fedorapc systemd[1]: Starting nvidia-suspend.service - NVIDIA system suspend actions... Apr 30 17:47:20 fedorapc suspend[11245]: nvidia-suspend.service Apr 30 17:47:20 fedorapc logger[11245]: <13>Apr 30 17:47:20 suspend: nvidia-suspend.service Apr 30 17:47:21 fedorapc systemd[1]: nvidia-suspend.service: Deactivated successfully. Apr 30 …\\n\\nImage\\n\\nxHCI resume failure on TU116 USB 3.1 controller with 595.71.05 — Bluetooth devices lost after suspend and reboot Linux\\n\\n> After updating to NVIDIA driver 595.71.05, the TU116 USB 3.1 Host Controller (10de:1aec at 0000:01:00.2) fails to resume from suspend. This causes all USB devices on that controller (in my case Bluetooth via onboard xHCI) to stop working after resume. Error from journalctl: xhci_hcd 0000:01:00.2: xHC error in resume, USBSTS 0x401, Reinit Symptoms: Bluetooth mouse (Logitech MX Master 3S) does not reconnect after suspend xHCI controller on the NVIDIA GPU card fails to reinitialize on resume …\\n\\nReverting to 595.58.03 resolves both issues.\\n\\nnvidia.sandbank247 May 1, 2026, 3:02am 389\\n\\nUnfortunately seeing freezing with 595.71.05 and CTX SWITCH TIMEOUT errors with Starfield’s CreationKit.\\n    \\n    `NVRM: Xid (PCI:0000:01:00): 109, pid=44101, name=CreationKit.exe, channel 0x00000023, errorString CTX SWITCH TIMEOUT, Info 0x1fc02f\\n    `\\n\\nUseRR May 1, 2026, 1:38pm 390\\n\\nThe problem is also tracked on version 595.71.05 on Debian 13\\nnvidia-bug-report.log.gz (660.4 KB)\\n\\nhurikhan77 May 1, 2026, 1:38pm 391\\n\\nWhile I understand that this list has some usefulness to have an overview of the current state of the driver, I don’t think it’s worth posting this on every minor update.\\n\\nEspecially because:\\n\\n  * You didn’t add the exact version number this list applies to. So why repeat on every minor bump?\\n  * You didn’t provide reference links for each claim which could otherwise help users understand the problem better and find a work-around.\\n  * You didn’t break it up into categories (e.g., model-specific, gaming, desktop), instead the order seems quite random.\\n  * If you would track reference links, it would be easier to know if something is “maybe fixed”, or “fixed”, or “not fixed”\\n  * A section showing what has been fixed since the previous post of this message would be helpful, and if that section is empty, simply don’t post it.\\n  * Many claims simply state a fact without giving a clue of the “why” (e.g. DX12 performance).\\n  * Many claims state brokenness without giving a context of when (e.g., HDR is not broken for me).\\n  * I think wording like “often” or “a lot” should be avoided, it is subjective.\\n\\nSome points in the list could benefit from more precise wording:\\n\\nNVIDIA drivers (and that’s probably true for every dedicated GPU) don’t have a concept of shared memory. While we know what is meant, I think a technically correct statement is still important to not misguide users who want to inspect or try to fix the problem. Technically, there’s always dedicated device memory, and host memory. This even reflects in the Vulkan API. The driver has always been able to use host memory (what is probably meant by users when writing “shared memory”).\\n\\nWhat’s true instead is that the NVIDIA driver doesn’t support eviction to the extent which is needed to transparently swap allocations between host and device memory. And that eviction is also meant when some people write “shared memory” (blurring the line of what is supported, and what isn’t, see above).\\n\\nSo the term is mixing two completely distinct concepts (accessing host memory, and evicting device memory), which in combination allow swapping between host and device memory (which is the third meaning that “shared memory” probably addresses).\\n\\nSo please, track these functions individually. “shared memory” is just the wrong term. I think what most people refer to as “shared memory” is actually a combination of host memory access and eviction behavior.\\n\\nImproving these points may increase a positive reception of this list, and reduce the “troll flagging”.\\n\\nI’m not asking to stop posting this - I think it could actually be very valuable if structured a bit more like a tracked issue list rather than a static list of complaints.\\n\\nHTH.\\n\\n* * *\\n\\nGiving an abstract/simplified example, I thought of something like this:\\n    \\n    `Driver: 595.71.05\\n    \\n    Model-specific:\\n    - Secondary GPU issues (multi-GPU setups) – [link]\\n    - VRR flickering on certain displays – [link]\\n    \\n    Desktop:\\n    - Gnome-shell / GDM freeze on login – [link], workaround: switch to TTY and relog\