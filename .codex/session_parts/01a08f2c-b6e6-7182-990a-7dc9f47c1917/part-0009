       compressor.warmup_kv_buffers(\n            block_shape, max_n_blocks=8, n_layers=1,\n            max_gpu_blocks=8, max_gpu_decomp_blocks=8,\n        )\n        if split_h2d:\n            compressor.load_kv_stream = torch.cuda.Stream()\n            compressor._kv_split_min_bytes = 0\n        generator = torch.Generator().manual_seed(321)\n        host_k = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n        host_v = torch.randn(\n            8, *block_shape, generator=generator, dtype=torch.float32\n        ).to(torch.bfloat16).contiguous()\n\n        # Seed one completed row, then retire it in the same callback batch as\n        # a row owned by the next writer.  Because that writer may rebuild the\n        # whole layer CSR, both physical slots must stay quarantined.\n        compressor.compress_batch_async_from_host(0, [7], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        compressor.compress_batch_async_from_host(\n            0, [3, 1, 6], host_k, host_v)\n        retired_slots = {\n            int(compressor._kv_slot_np[0][block_id])\n            for block_id in (1, 7)\n        }\n        compressor.free_persistent_blocks([7, 1, 7])\n        assert compressor._deferred_slot_frees[0] == retired_slots\n        compressor._kv_slot_allocator[0].validate_occupied(\n            np.asarray(sorted(retired_slots), dtype=np.int64))\n        assert compressor._kv_slot_np[0][1] == -1\n        assert compressor._kv_slot_np[0][7] == -1\n\n        compressor.wait_compress_async(0, block_shape)\n        assert compressor._persistent_valid[0][3]\n        assert not compressor._persistent_valid[0][1]\n        assert compressor._persistent_valid[0][6]\n        assert not compressor._persistent_valid[0][7]\n        assert 0 not in compressor._deferred_slot_frees\n        for slot in retired_slots:\n            with pytest.raises(RuntimeError):\n                compressor._kv_slot_allocator[0].validate_occupied(\n                    np.asarray([slot], dtype=np.int64))\n\n        k_cache = torch.zeros(\n            8, *block_shape, dtype=torch.bfloat16, device=\"cuda\")\n        v_cache = torch.zeros_like(k_cache)\n        prepared = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared, torch.tensor(prepared).numpy())\n        initial_active_version = compressor._prepared_active_version\n        compressor.decompress_batch(\n            0, prepared, output_buffers=(k_cache, v_cache))\n        torch.cuda.synchronize()\n        plan = compressor._decode_plans[0]\n        if profile_enabled:\n            kv_cpu_profile.collect_loads()\n            record = kv_cpu_profile._loads[-1]\n            assert record[\"wire_bytes\"] == plan.staged_bytes\n            assert record[\"raw_bytes\"] == 2 * host_k[0].numel() * 4\n            assert record[\"native_prepare_cpu_ms\"] >= record[\"native_sort_cpu_ms\"] >= 0\n            assert record[\"gpu_complete\"] == 1\n            assert record[\"h2d_window_ms\"] >= 0\n            assert record[\"decode_window_ms\"] >= 0\n            assert (record[\"ring_wait_ms\"] is not None) == split_h2d\n        assert plan.storage_rows == 2\n        assert not plan.offsets_are_compact\n        # One retained pinned owner stages the output block ids. Exception\n        # entries themselves still reference persistent CSR directly.\n        assert len(plan.host_owners) == 1\n        assert plan.host_owners[0].tolist() == [3, 6]\n        source_ptrs = {source.data_ptr() for source in plan.host_entries}\n        assert compressor._persistent_csr[0][\"k\"].entries.data_ptr() \\\n            in source_ptrs\n        assert compressor._persistent_csr[0][\"v\"].entries.data_ptr() \\\n            in source_ptrs\n        assert plan.staged_bytes < 3 * compressor._body_stride * 2\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\n        assert torch.count_nonzero(k_cache[1]).item() == 0\n        assert torch.count_nonzero(v_cache[1]).item() == 0\n\n        # Cached plans must restore the same bytes through the ordered-ID path.\n        compressor.decompress_batch(0, prepared, (k_cache, v_cache))\n        torch.cuda.synchronize()\n        assert compressor._decode_plans[0] is plan\n        _assert_bit_exact(k_cache[[3, 6]].cpu(), host_k[[3, 6]])\n        _assert_bit_exact(v_cache[[3, 6]].cpu(), host_v[[3, 6]])\n\n        # A newly materialized list with identical content keeps the version;\n        # the held identity still proves that per-layer fast-path calls belong\n        # to the currently prepared step.\n        prepared_same = [1, 3, 6]\n        compressor.prepare_active_set(\n            prepared_same, torch.tensor(prepared_same).numpy())\n        assert compressor._prepared_active_version == initial_active_version\n        assert compressor._prepared_active_list is prepared_same\n\n        # Reuse one active-list object to populate the dense decode-plan cache,\n        # then mutate persistent slot state.  Generation invalidation must not\n        # replay stale block/slot device metadata.\n        active = [3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        compressor.decompress_batch(\n            0, active, output_buffers=(k_cache, v_cache))\n        compressor.compress_batch_async_from_host(\n            0, [2], host_k, host_v)\n        compressor.wait_compress_async(0, block_shape)\n        assert int(compressor._kv_slot_np[0][2]) in retired_slots\n        active = [2, 3, 6]\n        compressor.prepare_active_set(active, torch.tensor(active).numpy())\n        assert compressor._prepared_active_version == initial_active_version + 2\n        k_cache.zero_()\n        v_cache.zero_()\n        compressor.decompress_batch(\n            0