{"timestamp":"2026-09-11T07:14:00.718Z","ordinal":1175,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a08f2c-b6e6-7182-990a-7dc9f47c1917","turn_id":"01a08f50-c3b0-7c61-8795-ab3b0d340eb3","item":{"type":"CommandExecution","id":"exec-87409f9a-b772-41b2-a73c-828fd7062020","process_id":"21667","command":["/bin/bash","-lc","docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,225p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"540,643p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"798,945p\" tiered_serve/chunk_delta3_kv_compressor.py'"],"cwd":"file:///home/ubuntu","parsed_cmd":[{"type":"unknown","cmd":"docker exec tiered-serve bash -lc 'cd /root/projects/tiered-serve && sed -n \"1,225p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"540,643p\" tiered_serve/chunk_delta3_kv_compressor.py && sed -n \"798,945p\" tiered_serve/chunk_delta3_kv_compressor.py'"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"ChunkDelta3 backend for persistent offloaded KV blocks.\n\nEach host slot keeps a fixed CD3 body and bounded CPU-encode scratch.  CPU\nencode workers append the exact Packed20 words to persistent CSR storage, so\nthe per-forward decode plan only references already-packed pinned memory.\nRecords whose exact compressed representation is not smaller than raw BF16\nare restored from authoritative secondary KV.\n\"\"\"\nfrom __future__ import annotations\n\nimport ctypes\nimport glob\nimport logging\nimport os\nimport queue\nimport threading\nimport time as _time\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, Tuple\n\nimport numpy as np\nimport torch\n\nfrom tiered_serve import kv_cpu_profile\nfrom tiered_serve.compressor_base import TensorCompressor\nfrom tiered_serve.dietgpu_kv_compressor import DietGPUKVCompressor\nfrom tiered_serve.compression.core.chunk_delta3 import (\n    _HAS_CHUNK_DELTA3,\n    _cd3_ext,\n)\n\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass _PersistentCSRState:\n    entries: torch.Tensor\n    offsets: torch.Tensor\n    word_counts: np.ndarray\n    used_words: int\n    garbage_words: int\n    max_words: int\n    gpu_words: int\n\n\n@dataclass\nclass _DecodePlan:\n    layer_id: int\n    block_ids: np.ndarray\n    block_ids_tensor: torch.Tensor | None\n    block_ids_cpu: torch.Tensor | None\n    generation: int\n    slots_gpu: torch.Tensor\n    host_bodies: Tuple[torch.Tensor, torch.Tensor]\n    host_offsets: Tuple[torch.Tensor, ...]\n    host_entries: Tuple[torch.Tensor, ...]\n    offsets_are_compact: bool\n    storage_rows: int\n    entry_words: Tuple[int, int]\n    staged_bytes: int\n    h2d_done: torch.cuda.Event | None\n    host_owners: list[torch.Tensor] = field(default_factory=list)\n    h2d_submitted: bool = False\n    profile_active_entry_bytes: int | None = None\n\n\ndef _align_up(value: int, alignment: int) -> int:\n    return (value + alignment - 1) // alignment * alignment\n\n\ndef _factor_64(numel: int) -> Tuple[int, int]:\n    \"\"\"Choose a compact 64-aligned 2-D view for one KV block.\"\"\"\n    if numel <= 0 or numel % 4096:\n        raise ValueError(\n            f\"ChunkDelta3 KV block_numel={numel} must be a multiple of 4096\")\n    root = int(numel ** 0.5)\n    for k in range((root // 64) * 64, 63, -64):\n        if numel % k == 0 and (numel // k) % 64 == 0:\n            return numel // k, k\n    return numel // 64, 64\n\n\nclass _ChunkDelta3KVStorage(DietGPUKVCompressor):\n    \"\"\"Persistent CD3 KV storage and batched GPU decode implementation.\"\"\"\n\n    def __init__(self, comp_stream: torch.cuda.Stream):\n        required = (\n            \"decompress_chunk_delta3_batched_csr_pair_stream\",\n            \"pack_host_chunk_delta3_entries_csr\",\n            \"prepare_chunk_delta3_kv_decode\",\n            \"KVSlotAllocator\",\n            \"retire_kv_csr_slots\",\n            \"prepare_host_chunk_delta3_csr_append\",\n            \"append_host_chunk_delta3_csr\",\n        )\n        if (not _HAS_CHUNK_DELTA3\n                or any(not hasattr(_cd3_ext, name) for name in required)):\n            raise RuntimeError(\n                \"ChunkDelta3 requires the CSR KV decoder and native slot allocator\")\n        # DietGPU's persistent-slot helpers are codec agnostic, but its\n        # constructor allocates an unrelated ANS workspace.  Initialise only\n        # the common TensorCompressor and bookkeeping used by those helpers.\n        TensorCompressor.__init__(self, comp_stream=comp_stream)\n        self.comp_stream = comp_stream\n        self.batch_decomp_stream = torch.cuda.Stream(priority=0)\n        self.load_kv_stream = None\n        self._kv_split_h2d_enabled = (\n            os.getenv(\"TIERED_SERVE_KV_NO_SPLIT\", \"0\") != \"1\")\n        # Two-stream event/ring overhead dominates small copies. Decide from\n        # the bytes actually staged, not the requested-row count: a sparse\n        # active set can have few rows but a much larger metadata payload.\n        split_min_bytes = os.getenv(\n            \"TIERED_SERVE_KV_CD3_SPLIT_MIN_BYTES\")\n        self._kv_split_min_bytes = (\n            None if split_min_bytes is None\n            else max(0, int(split_min_bytes)))\n        self._dec_blob_ring_idx = 0\n        self._gpu_decomp_pool_ring = []\n        self._dec_blob_consumed = []\n        self._tb = False\n\n        self._compressed_kv = {}\n        self._persistent_valid = {}\n        self._persistent_valid_np = {}\n        self._kv_slot = {}\n        self._kv_slot_np = {}\n        self._kv_slot_block = {}\n        self._kv_slot_allocator = {}\n        self._kv_free_metadata_only = True\n        self._pending_compress = {}\n        self._host_pools: Dict[int, Dict[str, Dict[str, torch.Tensor]]] = {}\n        self._host_num_exceptions_np = {}\n        self._gpu_decomp_pool: Dict[str, Dict[str, torch.Tensor]] = {}\n        self._kv_pools_ready = False\n\n        self._block_shape = ()\n        self._block_numel = 0\n        self._M_b = 0\n        self._K_b = 0\n        self._tiles_per_block = 0\n        self._code_bytes = 0\n        self._base_bytes = 0\n        self._entry_capacity = 0\n        self._packed_capacity = 0\n        self._body_stride = 0\n        self._body_layout = {}\n        self._max_n_blocks = 0\n        self._max_gpu_decomp_blocks = 0\n        self._n_layers = 0\n        self._identity_slots_gpu = None\n        self._block_ids_gpu_ring = []\n        self._decode_generation = {}\n        self._decode_filtered = {}\n        self._decode_plans = {}\n        self._persistent_csr = {}\n        self._csr_append_scratch = {}\n        self._host_encode_outputs = {}\n        self._csr_initial_words_per_slot = max(1, int(os.getenv(\n            \"TIERED_SERVE_KV_CD3_CSR_INITIAL_WORDS_PER_SLOT\", \"128\")))\n        self._free_csr_host_arenas = {}\n        self._free_csr_h2d_events = []\n        self._retired_csr_plans = []\n        self._secondary_fallback_possible = {}\n        # The loader computes one canonical active KV set per forward and then\n        # passes the same Python list to every layer.  Compare that set once at\n        # the step boundary instead of running np.array_equal in every layer's\n        # decompress_batch call.  The held list reference makes the identity\n        # check generation-safe (CPython cannot recycle its id while held).\n        self._prepared_active_list = None\n        self._prepared_active_candidates = None\n        self._prepared_active_version = 0\n\n    @staticmethod\n    def compute_per_block_compressed_bytes(block_elements: int) -> int:\n        from tiered_serve.kv_codec_spec import compressed_block_bytes\n\n        result = compressed_block_bytes(\"chunk_delta3\", block_elements)\n        assert result is not None\n        return result\n\n    def _build_body_layout(self) -> None:\n        layout = {}\n        offset = 0\n        for name, width, dtype, alignment in (\n            (\"codes\", self._code_bytes, torch.uint8, 1),\n            (\"sign_mantissa\", self._block_numel, torch.uint8, 1),\n            (\"thread_bases\", self._base_bytes, torch.uint8, 1),\n            (\"tile_exception_offsets\", self._tiles_per_block + 1,\n             torch.int32, 4),\n        ):\n            offset = _align_up(offset, alignment)\n            nbytes = width * torch.empty((), dtype=dtype).element_size()\n            layout[name] = (offset, nbytes, width, dtype)\n            offset += nbytes\n        self._body_stride = _align_up(offset, 128)\n        self._body_layout = layout\n\n    def _alloc_host_tensor(self, shape, dtype, huge_page_allocator):\n        if huge_page_allocator is not None:\n            numel = 1\n            for size in shape:\n                numel *= size\n            # A configured serving allocator has already budgeted the CD3 KV\n            # pool.  Falling through to weight pages or a large pinned tensor\n            # hides planner errors and can OOM the host much later in warmup.\n            return huge_page_allocator.allocate(\n                (numel,), (1,), dtype, page_type=\"kv\").view(shape)\n        return torch.empty(shape, dtype=dtype, device=\"cpu\").pin_memory()\n\n    def _host_pool(self, rows: int, huge_page_allocator=None\n                   ) -> Dict[str, torch.Tensor]:\n        specs = {\n            \"codes\": ((rows, self._code_bytes), torch.uint8),\n            \"sign_mantissa\": ((rows, self._block_numel), torch.uint8),\n            \"thread_bases\": ((rows, self._base_bytes), torch.uint8),\n            \"tile_exception_offsets\": (\n                (rows, self._tiles_per_block + 1), torch.int32),\n            \"entries20x3\": ((rows, self._packed_capacity), torch.int64),\n            \"num_exceptions\": ((rows,), torch.int32),\n        }\n        body = self._alloc_host_tensor(\n            (rows, self._body_stride), torch.uint8, huge_page_allocator)\n        pool = {\"body\": body}\n        for name, (offset, nbytes, width, d