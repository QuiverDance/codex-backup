       first_plan = compressor._decode_plans[0]\\n        first_event = first_plan.h2d_done\\n        first_arena = first_plan.host_owners[0].data_ptr()\\n        compressor.compress_batch_async_from_host(0, ids, *sources)\\n        compressor.wait_compress_async(0, shape)\\n        assert compressor._csr_append_scratch[0] is workspace\\n        for side in ('k', 'v'):\\n            state = compressor._persistent_csr[0][side]\\n            assert state is not first_states[side]  # append garbage compacted\\n            assert state.garbage_words == 0\\n            assert state.used_words == int(state.word_counts.sum())\\n        compressor.prepare_active_set(ids, np.asarray(ids))\\n        compressor.decompress_batch(0, ids, caches)\\n        torch.cuda.synchronize()\\n        reused_plan = compressor._decode_plans[0]\\n        assert reused_plan.h2d_done is first_event\\n        assert reused_plan.host_owners[0].data_ptr() == first_arena\\n        assert first_plan.block_ids_cpu is None\\n        assert first_plan.block_ids_tensor is None\\n        assert reused_plan.block_ids_tensor is reused_plan.block_ids_cpu\\n        for source, cache in zip(sources, caches):\\n            _assert_bit_exact(cache[ids].cpu(), source[ids])\\n    finally:\\n        compressor.stop_kv_compress_workers()\\n\\n\\ndef test_kv_routes_sparse_high_slots_and_capacity_buffers():\\n    from tiered_serve.compression.core.chunk_delta3 import _cd3_ext\\n\\n    # Exercise multiple radix bytes, fragmented slots and an oversized GPU\\n    # destination. Exact round-trip of the codec is covered by the tests above.\\n    rows, count, capacity = 65537, 5, 8\\n    host_body = torch.arange(rows, dtype=torch.int64).pin_memory().view(torch.uint8).reshape(rows, 8)\\n    host_offsets = torch.zeros(rows, dtype=torch.int64, pin_memory=True)\\n    host_entries = torch.empty(1, dtype=torch.int64, pin_memory=True)[:0]\\n    block_ids = torch.arange(count, dtype=torch.int64)\\n    slots = torch.tensor([65536, 