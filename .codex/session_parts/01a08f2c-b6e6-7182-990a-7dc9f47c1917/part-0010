ze()\\n        plan = compressor._decode_plans[0]\\n        if profile_enabled:\\n            kv_cpu_profile.collect_loads()\\n            record = kv_cpu_profile._loads[-1]\\n            assert record[\\\"wire_bytes\\\"] == plan.staged_bytes\\n            assert record[\\\"raw_bytes\\\"] == 2 * host_k[0].numel() * 4\\n            assert record[\\\"native_prepare_cpu_ms\\\"] >= record[\\\"native_sort_cpu_ms\\\"] >= 0\\n            assert record[\\\"gpu_complete\\\"] == 1\\n            assert record[\\\"h2d_window_ms\\\"] >= 0\\n            assert record[\\\"decode_window_ms\\\"] >= 0\\n            assert (record[\\\"ring_wait_ms\\\"] is not None) == split_h2d\\n        assert plan.storage_rows == 2\\n        assert not plan.offsets_are_compact\\n        # One retained pinned owner stages the output block ids. Exception\\n        # entries themselves still reference persistent CSR directly.\\n        assert len(plan.host_owners) == 1\\n        assert plan.host_owners[0].tolist() == [3, 6]\\n        source_ptrs = {source.data_ptr() for source in plan.host_entries}\\n        assert compressor._persistent_csr[0][\\\"k\\\"].entries.data_ptr() \\\\\\n            in source_ptrs\\n        assert compressor._persistent_csr[0][\\\"v\\\"].entries.data_ptr() \\\\\\n            in source_ptrs\\n        assert plan.staged_bytes < 3 * compressor._body_stride * 2\\n        _assert_bit_exact(k_cache[3].cpu(), host_k[3])\\n        _assert_bit_exact(k_cache[6].cpu(), host_k[6])\\n        _assert_bit_exact(v_cache[3].cpu(), host_v[3])\\n        _assert_bit_exact(v_cache[6].cpu(), host_v[6])\\n        assert torch.count_nonzero(k_cache[1]).item() == 0\\n        assert torch.count_nonzero(v_cache[1]).item() == 0\\n\\n        # Cached plans must restore the same bytes through the ordered-ID path.\\n        compressor.decompress_batch(0, prepared, (k_cache, v_cache))\\n        torch.cuda.synchronize()\\n        assert compressor._decode_plans[0] is plan\\n        _assert_bit_exact(k_cache[